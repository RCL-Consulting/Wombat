<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wombat.Application\Wombat.Application.csproj" />
    <ProjectReference Include="..\..\src\Wombat.Domain\Wombat.Domain.csproj" />
    <ProjectReference Include="..\..\src\Wombat.Infrastructure\Wombat.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- T102: one seed helper for the Identity rows a nominee is judged against. -->
    <Compile Include="../Shared/NomineeSeed.cs" Link="TestSupport/NomineeSeed.cs" />
    <!-- T131: the evidence a STAR stored directly by a test rests on (D38). -->
    <Compile Include="../Shared/StarEvidence.cs" Link="TestSupport/StarEvidence.cs" />
    <!-- T142: a user directory that answers the display-name lookup and counts the calls. -->
    <Compile Include="../Shared/FakeUserDirectory.cs" Link="TestSupport/FakeUserDirectory.cs" />
    <!-- T245: what an institution has adopted, which a speciality panel of anyone but an Administrator needs. -->
    <Compile Include="../Shared/AdoptionSeed.cs" Link="TestSupport/AdoptionSeed.cs" />
  </ItemGroup>
</Project>

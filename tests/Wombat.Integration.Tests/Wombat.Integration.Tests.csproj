<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- T205: reads the MSF respondent page as a browser would. Already pinned for Wombat.Web.Tests (bunit). -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wombat.Api\Wombat.Api.csproj" />
    <ProjectReference Include="..\..\src\Wombat.Infrastructure\Wombat.Infrastructure.csproj" />
    <!-- T205: the web app hosted whole, for the MSF respondent page. Aliased: its Program and the Api's are both public. -->
    <ProjectReference Include="..\..\src\Wombat.Web\Wombat.Web.csproj" Aliases="WombatWeb" />
  </ItemGroup>

  <ItemGroup>
    <!-- T102: one seed helper for the Identity rows a nominee is judged against. -->
    <Compile Include="../Shared/NomineeSeed.cs" Link="TestSupport/NomineeSeed.cs" />
    <!-- T131: the evidence a STAR stored directly by a test rests on (D38). -->
    <Compile Include="../Shared/StarEvidence.cs" Link="TestSupport/StarEvidence.cs" />
    <!-- T142: a user directory that answers the display-name lookup and counts the calls. -->
    <Compile Include="../Shared/FakeUserDirectory.cs" Link="TestSupport/FakeUserDirectory.cs" />
  </ItemGroup>
</Project>

@using Wombat.Web.Navigation
@using Wombat.Web.Security
@inject IHttpContextAccessor HttpContextAccessor
@inject ActingRoleSwitchResults SwitchResults

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2c3e50" />
    <ResourcePreloader />
    @* First-party CSS and JS go through @Assets, which resolves each to its content-hashed URL
       (app.<hash>.css) from the static-assets manifest. MapStaticAssets serves that URL with a
       year-long immutable cache, and a changed file gets a new URL, so a deploy can never pair a
       new page with a stylesheet or script the browser cached from the old one. A bare path
       ("/app.css") is served by UseStaticFiles with no Cache-Control, and browsers cache it
       heuristically for hours or days (T175). Icons and the manifest keep bare paths. *@
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Wombat.Web.styles.css"]" />
    @* ImportMap renders an inline <script type="importmap">, so it needs the request's
       CSP nonce — see SecurityHeadersMiddleware. *@
    <ImportMap nonce="@CspNonce" />
    @* Interactive, like Routes: every page after the first renders in the circuit, and only an
       outlet in the same circuit can take its PageTitle. A static outlet is rendered once, so
       the tab kept the first page's title (T180). It still prerenders, so a full load arrives
       titled. On a page excluded from interactive routing, and for a visitor who has not signed in,
       both are static (PageRenderMode). *@
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes @rendermode="PageRenderMode" Acting="_acting" SwitchResult="_switchResult" />
    </CascadingAuthenticationState>
    <ReconnectModal />
    <script src="@Assets["wombat.js"]"></script>
    <script src="@Assets["js/dialog.js"]"></script>
    <script src="@Assets["js/file-download.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private ActingRole _acting = ActingRole.None;
    private ActingRoleSwitchResult? _switchResult;

    /// <summary>
    /// The acting role, resolved once, here, from the sign-in cookie's claims, and the word a switch left for this page,
    /// taken once (T335, flow 01; review S22(a)). App renders only in the request, never in a circuit, so this is the one
    /// place that reads the request for them. Both go to <c>Routes</c> as parameters, which an interactive root carries
    /// into its circuit, and Routes cascades them, fixed; nothing in a circuit reads the HTTP context for them.
    /// </summary>
    protected override void OnInitialized()
    {
        if (HttpContextAccessor.HttpContext is { } context)
        {
            _acting = ActingRoleResolver.Resolve(context.User);
            _switchResult = SwitchResults.Take(context);
        }
    }

    private string? CspNonce =>
        HttpContextAccessor.HttpContext?.Items[SecurityHeadersMiddleware.NonceItemKey] as string;

    /// <summary>
    /// Interactive server for a signed-in user's every page, except those marked <c>[ExcludeFromInteractiveRouting]</c>.
    /// Those pages, and every page for a visitor who has not signed in, render as static server-side HTML with plain
    /// forms and no circuit. (T205, T181, T265)
    /// </summary>
    /// <remarks>
    /// <para>
    /// Three pages are excluded. The MSF respondent's (<c>/msf/respond</c>): a stranger holding an emailed link, not
    /// signed in. Static, its every request, the submit included, is an HTTP request, so the link's rate limit applies
    /// to it; over a circuit the submit would be a SignalR message the limiter never sees. It works without WebSockets
    /// or script, for a signed-in user too. And the export check (<c>/portfolio/verify</c>, T265), open to anyone holding
    /// a portfolio PDF: its Verify is a GET form whose check is made as the page renders, the same signed in or not. And the
    /// error page (<c>/Error</c>, T321; T335, flow 01), rendered once inside the request that failed, so the reference it
    /// shows is that request's: its circuit, when it had one, re-rendered it with no request and lost it.
    /// </para>
    /// <para>
    /// A visitor who has not signed in gets no interactive root because the circuit is not theirs to have. The Blazor
    /// hub is under the fallback policy, which requires a signed-in user, and it stays there: inside a circuit,
    /// navigation never reaches an endpoint, so a page that relies on the fallback policy rather than
    /// <c>[Authorize]</c> would render to anyone holding an anonymous circuit. Given an interactive root anyway,
    /// <c>blazor.web.js</c> asked for a circuit on every sign-in page and logged the refusal: until T181 as a JSON
    /// parse error, the fallback policy having answered <c>/_blazor/initializers</c> with the sign-in page's HTML;
    /// with that endpoint opened, as a failed negotiation. Every page such a visitor reaches is <c>[AllowAnonymous]</c>,
    /// and none ever had a circuit, so static takes nothing from them. What such a page may rely on is in DESIGN.md
    /// (§ Account / auth page). A circuit whose sign-in ends (SessionRevalidatingAuthenticationStateProvider) is left at
    /// once by a full page load (EndedSessionExit, the T279 review), so an anonymous circuit is never kept either.
    /// </para>
    /// <para>
    /// "Signed in" is the test the hub's fallback policy makes (<c>DenyAnonymousAuthorizationRequirement</c>: any
    /// identity authenticated), not the primary identity's, so a page is interactive exactly when the hub will take
    /// its circuit.
    /// </para>
    /// </remarks>
    private IComponentRenderMode? PageRenderMode =>
        HttpContextAccessor.HttpContext is { } context
        && (!context.User.Identities.Any(identity => identity.IsAuthenticated) || !context.AcceptsInteractiveRouting())
            ? null
            : InteractiveServer;
}

@using Wombat.Web.Security
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2c3e50" />
    <ResourcePreloader />
    @* First-party CSS and JS go through @Assets, which resolves each to its content-hashed URL
       (app.<hash>.css) from the static-assets manifest. MapStaticAssets serves that URL with a
       year-long immutable cache, and a changed file gets a new URL, so a deploy can never pair a
       new page with a stylesheet or script the browser cached from the old one. A bare path
       ("/app.css") is served by UseStaticFiles with no Cache-Control, and browsers cache it
       heuristically for hours or days (T175). Icons and the manifest keep bare paths. *@
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Wombat.Web.styles.css"]" />
    @* ImportMap renders an inline <script type="importmap">, so it needs the request's
       CSP nonce — see SecurityHeadersMiddleware. *@
    <ImportMap nonce="@CspNonce" />
    @* Interactive, like Routes: every page after the first renders in the circuit, and only an
       outlet in the same circuit can take its PageTitle. A static outlet is rendered once, so
       the tab kept the first page's title (T180). It still prerenders, so a full load arrives
       titled. *@
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes @rendermode="InteractiveServer" />
    </CascadingAuthenticationState>
    <ReconnectModal />
    <script src="@Assets["wombat.js"]"></script>
    <script src="@Assets["js/dialog.js"]"></script>
    <script src="@Assets["js/file-download.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private string? CspNonce =>
        HttpContextAccessor.HttpContext?.Items[SecurityHeadersMiddleware.NonceItemKey] as string;
}

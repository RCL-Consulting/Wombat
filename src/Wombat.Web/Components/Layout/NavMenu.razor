@*
  The navigation (T335, flow 01; DESIGN.md § The NavMenu): the acting role's head and switch, then that role's links,
  then the personal links under a rule. It reads no database: the acting role and the menu are cascaded (App resolved the
  role from the sign-in cookie's claims, MainLayout built the menu from them), and the page shown is Routes' RouteData.

  - The head says "Acting as" and the role's label, which wraps and is never cut. Two roles: one "Switch to …" link.
    Three or more: a native <details> "Change role" listing each other role. No script, so it works on a static page.
    Every switch is ActingRoleSwitch.Url(role), with no return address, so it lands on the new role's Home, and a full
    page load (data-enhance-nav="false"): enhanced navigation would patch a static page in place and start no circuit.
    No role, no head (D8).
  - A group's heading is not a link and not a heading element: the page's h1 is the first heading. It names its list.
  - At most one item is lit (NavOwners): a list lights itself, a page under it lights its owner for the acting role. The
    item is lit by the page drawn: a page that draws Page not found in its own place tells PageDrawn through its header,
    and lights nothing (T358, build review D1).
*@
@implements IDisposable
@inject IJSRuntime JS

<nav class="nav-panel" aria-label="Main">
  @if (Acting?.Role is { } role)
  {
    <div class="role-head">
      <p class="role-now"><span class="role-now-label">Acting as</span> <span class="role-now-name">@WombatRoleLabels.For(role)</span></p>

      @if (Acting.OtherRoles is [var other])
      {
        <a class="role-switch" href="@ActingRoleSwitch.Url(other)" data-enhance-nav="false">
          <Icon Name="arrow-left-right" />
          <span>Switch to @WombatRoleLabels.For(other)</span>
        </a>
      }
      else if (Acting.OtherRoles.Count > 1)
      {
        <details class="role-change">
          <summary class="role-switch">
            <Icon Name="arrow-left-right" />
            <span>Change role</span>
          </summary>
          <ul class="role-options">
            @foreach (var option in Acting.OtherRoles)
            {
              <li>
                <a class="role-option" href="@ActingRoleSwitch.Url(option)" data-enhance-nav="false">Switch to @WombatRoleLabels.For(option)</a>
              </li>
            }
          </ul>
        </details>
      }
    </div>
  }

  @if (Menu is not null)
  {
    <div class="nav-list">
      @for (var index = 0; index < Menu.Groups.Count; index++)
      {
        var group = Menu.Groups[index];
        if (group.Heading is { } heading)
        {
          var id = $"nav-group-{index}";
          <p class="nav-group-heading" id="@id">@heading</p>
          <ul class="nav-items" aria-labelledby="@id">
            @foreach (var item in group.Items)
            {
              <li><NavItemLink Item="item" Current="CurrentOf(item)" /></li>
            }
          </ul>
        }
        else
        {
          <ul class="nav-items">
            @foreach (var item in group.Items)
            {
              <li><NavItemLink Item="item" Current="CurrentOf(item)" /></li>
            }
          </ul>
        }
      }

      <ul class="nav-items nav-personal">
        @foreach (var item in Menu.Personal)
        {
          <li><NavItemLink Item="item" Current="CurrentOf(item)" /></li>
        }
      </ul>
    </div>
  }
</nav>

@code {
  private (NavItem? Item, NavCurrent Current) _lit;
  private NavItem? _revealed;

  /// <summary>The acting role, as App resolved it and Routes cascades it.</summary>
  [CascadingParameter] public ActingRole? Acting { get; set; }

  /// <summary>This person's navigation, as MainLayout built it from the acting role and the claims.</summary>
  [CascadingParameter] public NavMenuModel? Menu { get; set; }

  /// <summary>The page shown, as Routes cascades it: which item is lit.</summary>
  [CascadingParameter] public RouteData? Route { get; set; }

  /// <summary>The page drawn in the routed page's place, if one is (T358, build review D1).</summary>
  [CascadingParameter] public PageDrawn? Drawn { get; set; }

  private PageDrawn? _listening;

  protected override void OnParametersSet()
  {
    if (!ReferenceEquals(_listening, Drawn))
    {
      if (_listening is not null)
      {
        _listening.Changed -= OnDrawnChanged;
      }

      _listening = Drawn;
      if (_listening is not null)
      {
        _listening.Changed += OnDrawnChanged;
      }
    }

    Light();
  }

  private void Light() => _lit = NavOwners.Lit(Drawn is null ? Route?.PageType : Drawn.On(Route), Acting?.Role, Menu);

  // Told by the page's header, which renders after the menu: light again, and draw. Raised on the renderer's own thread,
  // in the header's OnParametersSet, so the render is queued in the same batch.
  private void OnDrawnChanged()
  {
    Light();
    StateHasChanged();
  }

  public void Dispose()
  {
    if (_listening is not null)
    {
      _listening.Changed -= OnDrawnChanged;
    }
  }

  /// <summary>
  /// The lit item scrolled into the list's view (R2-Sidebar-Scroll): the circuit's first render replaces the prerendered
  /// list, scrolled to its top, and a link on a page can light an item below the list's fold. wombat.js does the same for
  /// a static page as it loads.
  /// </summary>
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_lit.Item is null || (!firstRender && _lit.Item == _revealed))
    {
      return;
    }

    _revealed = _lit.Item;
    try
    {
      await JS.InvokeVoidAsync("wombat.revealCurrentNavItem");
    }
    catch (Exception exception) when (exception is JSDisconnectedException or JSException or OperationCanceledException)
    {
      // Scrolling is decoration (the review of the t335 branch). The circuit went as it rendered, the script failed, or
      // the call was cancelled as the circuit wound down: the menu stands as it is, and an unhandled failure here would
      // end the circuit.
    }
  }

  private NavCurrent CurrentOf(NavItem item) => _lit.Item == item ? _lit.Current : NavCurrent.None;
}

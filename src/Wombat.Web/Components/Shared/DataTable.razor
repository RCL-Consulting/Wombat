@typeparam TItem

@if (Items.Count == 0)
{
  @if (Empty is not null)
  {
    @Empty
  }
}
else
{
  <div class="table-container shadow">
    @* Stack (T342, flow 03, A8): below 641px each row is a block, its header row visually hidden but still read. The
       roles are explicit, as display: grid on a row drops a table's semantics in some browsers; the caller's rows
       carry role="row", role="columnheader" and role="cell". *@
    <table class="clinic-table @ExtraClasses" role="@(Stacks ? "table" : null)">
      @if (!string.IsNullOrWhiteSpace(Caption))
      {
        <caption>@Caption</caption>
      }
      <thead role="@(Stacks ? "rowgroup" : null)">
        @HeaderRow
      </thead>
      <tbody role="@(Stacks ? "rowgroup" : null)">
        @foreach (var item in Items)
        {
          @Row(item)
        }
      </tbody>
    </table>
  </div>
}

@code {
  [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = [];
  [Parameter, EditorRequired] public RenderFragment HeaderRow { get; set; } = default!;
  [Parameter, EditorRequired] public RenderFragment<TItem> Row { get; set; } = default!;
  [Parameter] public RenderFragment? Empty { get; set; }
  [Parameter] public string? Caption { get; set; }

  /// <summary>
  /// A class of the page's own on the table, after the system's: the data-rights tables' <c>data-rights-table</c>, whose
  /// row header reads as a cell (T387, flow 14, M5).
  /// </summary>
  [Parameter] public string? Class { get; set; }

  /// <summary>The stacked table below 641px (<c>.clinic-table--stack</c>, DESIGN.md § Table system; T342).</summary>
  [Parameter] public bool Stack { get; set; }

  /// <summary>
  /// The stacked table from 900px down (<c>.clinic-table--stack .clinic-table--stack-wide</c>; T373, flow 11, S16), as
  /// flows 06, 08 and 10 hand-wrote theirs: for a list too wide for the main column beside the sidebar. It implies
  /// <see cref="Stack" />, and the same explicit roles. A row that needs a note under it (the invitations list's Delivery
  /// explanation) writes a second <c>&lt;tr&gt;</c> from its Row fragment.
  /// </summary>
  [Parameter] public bool StackWide { get; set; }

  private bool Stacks => Stack || StackWide;

  // After clinic-table, which stays literal in the markup so the stylesheet scans read it (NarrowLayoutTests).
  private string? ExtraClasses => string.Join(" ", new[] { StackClass, Class }.Where(part => !string.IsNullOrWhiteSpace(part))) is { Length: > 0 } extra
    ? extra
    : null;

  private string? StackClass => StackWide
    ? "clinic-table--stack clinic-table--stack-wide"
    : Stack ? "clinic-table--stack" : null;
}

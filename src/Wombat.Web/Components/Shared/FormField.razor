<div class="form-group @(FullWidth ? "full-width" : string.Empty)">
  <label for="@InputId">
    @Label
    @if (Required)
    {
      <span aria-hidden="true">*</span>
      <span class="visually-hidden">required</span>
    }
  </label>

  @ChildContent

  @if (!string.IsNullOrWhiteSpace(HelpText))
  {
    @* The input is the caller's, so the caller links it: aria-describedby="@FieldHelp.DescribedBy(...)" (T193). *@
    <small class="page-subtitle" id="@FieldHelp.Id(InputId)">@HelpText</small>
  }

  @if (ValidationContent is not null)
  {
    @ValidationContent
  }
</div>

@code {
  [Parameter, EditorRequired] public string Label { get; set; } = default!;
  [Parameter, EditorRequired] public string InputId { get; set; } = default!;

  /// <summary>
  /// Text under the input, rendered with the id <see cref="FieldHelp.Id" />. The input in <see cref="ChildContent" /> must
  /// name it: <c>aria-describedby="@FieldHelp.DescribedBy(inputId, helpText)"</c>.
  /// </summary>
  [Parameter] public string? HelpText { get; set; }

  [Parameter] public bool Required { get; set; }
  [Parameter] public bool FullWidth { get; set; }
  [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
  [Parameter] public RenderFragment? ValidationContent { get; set; }
}

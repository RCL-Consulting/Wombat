@implements IAsyncDisposable
@inject IJSRuntime JS

@*
  Two modes.

  - The action mode (every caller before T339): Confirm runs OnConfirm in the circuit, and the dialog stays open, its
    button keeping the focus, until the action answers.
  - The form mode (T339, flow 02, C7): FormAction set. The dialog holds a real <form method="post"> with its antiforgery
    token, HiddenFields and the caller's FormContent (a password field, a refusal), and its confirm button is a submit.
    The browser posts it to an endpoint, which can issue the sign-in cookie again, as nothing in a circuit can. My
    account's Remove of an institutional sign-in is the first.

  Either way the native <dialog> is opened modal, so Escape closes it. The browser returns the focus to the control that
  opened it, except where a clicked button never took it (Safari, Firefox on macOS): so the dialog's script records the
  opener (document.activeElement, else ReturnFocusId) and focuses it when Cancel or Escape closes the dialog (T366, D6). In the form mode the first element the caller marks autofocus takes the focus on open (the refusal, else the
  password), else Cancel, which carries autofocus itself; OnClosed tells the caller the dialog has closed, however it was
  closed, so a caller that opened it without a press (a refusal reopening it as the page loads) can put the focus back.

  The action mode may carry a field (T366, flow 09, M5): FieldContent, drawn after the body and outside the id that
  describes the dialog (D9); InitialFocusId names its element that takes the first focus in place of the safe button
  (the register's revocation reason), and OnConfirmClosesWhen, run in OnConfirm's place, keeps the dialog open when it
  answers false, so the caller shows its refusal under the field, with what was typed kept. Unset, the dialog behaves as
  before.
*@
<dialog @ref="_dialog" class="dialog-scrim dialog-card @(IsFormMode ? "dialog-card--form" : null)"
        aria-labelledby="@TitleId" aria-describedby="@BodyId" @onclose="ClosedAsync">
  @if (IsFormMode)
  {
    @* data-submit-once (wombat.js): a second press while the post is on its way sends nothing. Cancel is not a submit,
       so it never marks the form sent. *@
    <form class="dialog-form" method="post" action="@FormAction" data-submit-once>
      <AntiforgeryToken />
      @if (HiddenFields is not null)
      {
        @foreach (var field in HiddenFields)
        {
          <input type="hidden" name="@field.Key" value="@field.Value" />
        }
      }
      <h2 id="@TitleId">@Title</h2>
      <p id="@BodyId">@Body</p>
      @FormContent
      <div class="dialog-actions">
        <button type="button" class="btn btn-outline" autofocus @onclick="CancelAsync">@CancelLabel</button>
        <button type="submit" class="btn @(DangerAction ? "btn-danger" : "btn-primary")">@ConfirmLabel</button>
      </div>
    </form>
  }
  else
  {
    <div class="form-container">
      <h2 id="@TitleId">@Title</h2>
      @if (BodyContent is not null)
      {
        @* T361 (flow 07): a body of more than one sentence, the committee review's lists, under the one id that describes
           the dialog. *@
        <div id="@BodyId" class="dialog-body">@BodyContent</div>
      }
      else
      {
        <p id="@BodyId">@Body</p>
      }
      @if (FieldContent is not null)
      {
        @* T366, D9: the field after the description, so its label and counter are read once, as the field's. *@
        <div class="dialog-body">@FieldContent</div>
      }
      <FormActions>
        @* While the confirmed action runs, the dialog stays open and the confirm button keeps the focus: it is not disabled,
           a second press sends nothing, and aria-disabled says so (DESIGN.md § Button system, T234 review). Cancel would
           race it, so Cancel is disabled. *@
        <button type="button" class="btn btn-outline" disabled="@_confirming" @onclick="CancelAsync">@CancelLabel</button>
        <button type="button" class="btn @(DangerAction ? "btn-danger" : "btn-primary")"
                aria-disabled="@InFlight.AriaDisabled(_confirming)" @onclick="ConfirmAsync">@ConfirmLabel</button>
      </FormActions>
    </div>
  }
</dialog>

@code {
  private readonly string _id = $"confirm-{Guid.NewGuid():N}";
  private ElementReference _dialog;

  // The confirmed action has been sent and has not answered.
  private bool _confirming;

  [Parameter] public string Title { get; set; } = "Confirm";
  [Parameter] public string Body { get; set; } = string.Empty;

  /// <summary>
  /// The action mode's body when it is more than one sentence (T361, flow 07): the committee review's Start, Record and
  /// Ratify dialogs list what they freeze, fix and issue. Given, it is drawn in place of <see cref="Body" />, under the id
  /// that describes the dialog.
  /// </summary>
  [Parameter] public RenderFragment? BodyContent { get; set; }

  /// <summary>
  /// The action mode's field, after the body and outside the id that describes the dialog (T366, D9): the register's
  /// revocation reason, its refusal and its counter, which the field's own label and <c>aria-describedby</c> name.
  /// </summary>
  [Parameter] public RenderFragment? FieldContent { get; set; }
  [Parameter] public string ConfirmLabel { get; set; } = "Confirm";

  /// <summary>
  /// The safe button's words: "Keep the request", "Keep the draft" (T342, flow 03, A5). "Cancel" by default, so every
  /// other dialog reads as it did.
  /// </summary>
  [Parameter] public string CancelLabel { get; set; } = "Cancel";
  [Parameter] public bool DangerAction { get; set; }
  [Parameter] public EventCallback OnConfirm { get; set; }
  [Parameter] public EventCallback OnCancel { get; set; }

  /// <summary>
  /// Where the form mode's form posts (T339, C7). Set, the dialog is a form the browser posts, and
  /// <see cref="OnConfirm" /> is not called.
  /// </summary>
  [Parameter] public string? FormAction { get; set; }

  /// <summary>The form mode's hidden fields, by name: what the endpoint is to act on (a provider's key).</summary>
  [Parameter] public IReadOnlyDictionary<string, string>? HiddenFields { get; set; }

  /// <summary>The form mode's fields and messages, between the body and the buttons: a password field, a refusal.</summary>
  [Parameter] public RenderFragment? FormContent { get; set; }

  /// <summary>The dialog has closed, by Cancel, by Escape or by the caller.</summary>
  [Parameter] public EventCallback OnClosed { get; set; }

  /// <summary>
  /// The action mode's first focus (T366, M5): the id of an element in <see cref="FieldContent" />, the register's
  /// revocation reason, which takes the focus once the dialog is open, in place of the safe button. It is focused after
  /// the dialog's next render (R5). Null keeps the native dialog's own first focus.
  /// </summary>
  [Parameter] public string? InitialFocusId { get; set; }

  /// <summary>
  /// The action mode's confirm, when a refusal must keep the dialog open (T366, M4, M5, F3): run in place of
  /// <see cref="OnConfirm" />, and the dialog closes only when it answers true. A caller that refuses answers false and
  /// shows its refusal under the field (<see cref="FieldContent" />), with what was typed kept; it re-renders itself
  /// (the dialog re-renders its body). While it runs the confirm button is held as <see cref="OnConfirm" /> holds it.
  /// Null keeps today's confirm: <see cref="OnConfirm" />, then close.
  /// </summary>
  [Parameter] public Func<Task<bool>>? OnConfirmClosesWhen { get; set; }

  /// <summary>
  /// The control that opened the dialog, by id, for a browser that does not focus a clicked button (Safari, Firefox on
  /// macOS): the dialog records <c>document.activeElement</c> when it opens, else this element, and gives it the focus
  /// back when Cancel or Escape closes it (T366, D6). Null records the active element alone.
  /// </summary>
  [Parameter] public string? ReturnFocusId { get; set; }

  /// <summary>The dialog's heading's id, which the dialog is named by.</summary>
  public string TitleId => $"{_id}-title";

  /// <summary>The dialog's body's id, which the dialog is described by.</summary>
  public string BodyId => $"{_id}-body";

  private bool IsFormMode => !string.IsNullOrEmpty(FormAction);

  // The first focus waits for the render after ShowAsync, so the field the caller's body draws is there (T366, R5).
  private bool _focusInitial;

  public async ValueTask ShowAsync()
  {
    // The script records who opened the dialog, to give the focus back on Cancel or Escape (T366, D6).
    await JS.InvokeVoidAsync("wombatDialog.showModal", _dialog, ReturnFocusId);
    if (!IsFormMode && !string.IsNullOrEmpty(InitialFocusId))
    {
      // After the native dialog has put the focus on its first control, so the field wins (T366, M5); and after the
      // dialog has rendered again, since the caller may have changed its body in the same handler (R5).
      _focusInitial = true;
      await InvokeAsync(StateHasChanged);
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusInitial && !string.IsNullOrEmpty(InitialFocusId))
    {
      _focusInitial = false;
      await PageFocus.FocusByIdAsync(JS, InitialFocusId);
    }
  }

  /// <summary>Closes the dialog; the focus is the caller's to place (its result, a field).</summary>
  public ValueTask CloseAsync() => CloseAsync(returnFocus: false);

  private ValueTask CloseAsync(bool returnFocus)
    => JS.InvokeVoidAsync("wombatDialog.close", _dialog, returnFocus);

  private async Task ConfirmAsync()
  {
    if (_confirming)
    {
      return;
    }

    _confirming = true;
    var closes = true;
    try
    {
      if (OnConfirmClosesWhen is not null)
      {
        closes = await OnConfirmClosesWhen();
      }
      else
      {
        await OnConfirm.InvokeAsync();
      }
    }
    finally
    {
      _confirming = false;
    }

    if (closes)
    {
      await CloseAsync();
    }
  }

  private async Task CancelAsync()
  {
    if (_confirming)
    {
      return;
    }

    await OnCancel.InvokeAsync();
    await CloseAsync(returnFocus: true);
  }

  private Task ClosedAsync() => OnClosed.InvokeAsync();

  public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}

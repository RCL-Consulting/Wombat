@* The trail, above the header, on a page under a list or outside the acting role's navigation (T335, flow 01; D5). *@
@if (_trail is not null)
{
  <Breadcrumbs Items="_trail" />
}

<div class="header-container">
  <div>
    @* An icon before the heading, on the system pages (T335, flow 01: "PageHeader with icon"): aria-hidden, so the
       heading is named by its words alone. *@
    <h1 class="@(Icon is null ? null : "page-title-with-icon")">@if (Icon is not null){<Icon Name="@Icon" Size="24" Class="@IconClass" />}@if (TitleContent is not null){@TitleContent}else{@Title}</h1>
    @if (SubtitleContent is not null)
    {
      <p class="page-subtitle">@SubtitleContent</p>
    }
    else if (!string.IsNullOrWhiteSpace(Subtitle))
    {
      <p class="page-subtitle">@Subtitle</p>
    }
  </div>

  @if (Actions is not null)
  {
    <div class="actions-cell">
      @Actions
    </div>
  }
</div>

@* A switch of the acting role says what it did under the header of the page it landed on, once (T335, flow 01). *@
<ActingRoleSwitchAlert />

@code {
  private IReadOnlyList<Crumb>? _trail;

  [Parameter, EditorRequired] public string Title { get; set; } = default!;

  /// <summary>
  /// A heading that holds more than its words: an EPA page's "PAED-012 — …" with its "(no longer in use)" mark in a muted
  /// span and an institution's own EPA's badge (T355, C5). Given, it is drawn in the h1 in place of <see cref="Title" />,
  /// which still names the crumb and must read as the h1 does, mark included, since the tab is the same words.
  /// </summary>
  [Parameter] public RenderFragment? TitleContent { get; set; }
  [Parameter] public string? Subtitle { get; set; }

  /// <summary>
  /// A subtitle that holds more than words: Log an activity's "Mini-CEX (Paediatrics) · Choose another type", whose last
  /// part is a link (T342, flow 03). Given, it is drawn in place of <see cref="Subtitle" />.
  /// </summary>
  [Parameter] public RenderFragment? SubtitleContent { get; set; }
  [Parameter] public RenderFragment? Actions { get; set; }

  /// <summary>
  /// The crumbs between the list the page is under and the page itself, where the owner table names one: the College,
  /// on the Administrator's trail to a College's specialities (R2-Rules § 3).
  /// </summary>
  [Parameter] public IReadOnlyList<Crumb>? Trail { get; set; }

  /// <summary>The words of the page's own crumb, when they are not its title.</summary>
  [Parameter] public string? CurrentCrumb { get; set; }

  /// <summary>
  /// The page this header heads, when it is not the page the address routes to: Access denied, drawn in place of the page
  /// that refused (D6), whose trail is its own (none), not the refused page's.
  /// </summary>
  [Parameter] public Type? Page { get; set; }

  /// <summary>The page shown, as Routes cascades it.</summary>
  [CascadingParameter] public RouteData? Route { get; set; }

  /// <summary>The acting role, as App resolved it and Routes cascades it.</summary>
  [CascadingParameter] public ActingRole? Acting { get; set; }

  /// <summary>The person's navigation, as MainLayout cascades it; none outside the signed-in shell.</summary>
  [CascadingParameter] public NavMenuModel? Menu { get; set; }

  protected override void OnParametersSet()
  {
    var before = NavOwners.TrailTo(Page ?? Route?.PageType, Acting?.Role, Menu);
    _trail = before is null ? null : [.. before, .. Trail ?? [], new Crumb(CurrentCrumb ?? Title)];
  }

  /// <summary>A Lucide icon drawn before the heading, or none (the system pages, T335).</summary>
  [Parameter] public string? Icon { get; set; }

  /// <summary>The icon's colour: "info" (the action blue, the default), "warning" or "danger".</summary>
  [Parameter] public string IconTone { get; set; } = "info";

  private string IconClass => IconTone switch
  {
    "danger" => "page-title-icon page-title-icon--danger",
    "warning" => "page-title-icon page-title-icon--warning",
    _ => "page-title-icon"
  };
}

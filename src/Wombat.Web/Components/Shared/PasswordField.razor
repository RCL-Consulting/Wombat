@*
  A password field: its label, its input, and its Show toggle beside it (T339, flow 02; R3-SI-Toggle; the round 2 review's
  A3-A5, B6, B7 and E9). It replaced PasswordToggleButton, which toggled the field over JS interop from a circuit, so on a
  static page (sign in, link, register, change password) it did nothing at all.

  The toggle is a .btn-outline 8px to the right of the input, never inside it, named "Show" and the field's label exactly
  ("Show confirm new password"), with aria-pressed and aria-controls. Pressed, it keeps the word "Show" (E9): the fill and
  the eye-off icon say it is on, and aria-pressed says so to a reader. Which icon shows is the stylesheet's, from
  aria-pressed, so both ways of driving it change only aria-pressed and the input's type.

  Static (no circuit), the button is rendered hidden with data-password-toggle, and wombat.js shows it and drives it: one
  delegated listener, so a page with script blocked has a plain password field and no dead button. Interactive, the
  button toggles through @onclick. On a submit and on a page restored from the back-forward cache wombat.js turns every
  field back to a password, so a shown password is never posted as text into the browser's form history or left on
  screen.

  ChildContent follows the field inside its group: a field's message, the password rules.
*@

<div class="form-group">
  <label for="@Id">@Label</label>
  <div class="password-field">
    <input id="@Id" name="@Name" class="form-control" type="@(_shown ? "text" : "password")" autocomplete="@Autocomplete"
           required="@Required" autofocus="@Autofocus" aria-invalid="@(Invalid ? "true" : null)"
           aria-describedby="@(string.IsNullOrWhiteSpace(DescribedBy) ? null : DescribedBy)"
           value="@Value" @attributes="InputHandler" />
    @if (Interactive)
    {
      <button type="button" class="btn btn-outline password-toggle" aria-controls="@Id" aria-pressed="@(_shown ? "true" : "false")"
              aria-label="@ToggleName" @onclick="Toggle">
        <Icon Name="eye" Class="password-toggle-eye" />
        <Icon Name="eye-off" Class="password-toggle-eye-off" />
        Show
      </button>
    }
    else
    {
      <button type="button" class="btn btn-outline password-toggle" aria-controls="@Id" aria-pressed="false"
              aria-label="@ToggleName" data-password-toggle hidden>
        <Icon Name="eye" Class="password-toggle-eye" />
        <Icon Name="eye-off" Class="password-toggle-eye-off" />
        Show
      </button>
    }
  </div>
  @ChildContent
</div>

@code {
  private bool _shown;

  /// <summary>The field's label, which the toggle's name repeats after "Show", lower-cased.</summary>
  [Parameter, EditorRequired] public string Label { get; set; } = default!;

  /// <summary>The input's id, which the label and the toggle name.</summary>
  [Parameter, EditorRequired] public string Id { get; set; } = default!;

  /// <summary>The input's name, for a form the browser posts.</summary>
  [Parameter] public string? Name { get; set; }

  /// <summary><c>current-password</c> or <c>new-password</c>, so a password manager fills or offers the right one.</summary>
  [Parameter] public string? Autocomplete { get; set; }

  [Parameter] public bool Required { get; set; }

  [Parameter] public bool Autofocus { get; set; }

  /// <summary>Marks the input refused (<c>aria-invalid</c>); its message is in <see cref="ChildContent" />.</summary>
  [Parameter] public bool Invalid { get; set; }

  /// <summary>The ids the input names with <c>aria-describedby</c>, space-separated; none when blank.</summary>
  [Parameter] public string? DescribedBy { get; set; }

  /// <summary>The value, for an interactive page that binds it (the administrator's reset card); a posted form leaves it null.</summary>
  [Parameter] public string? Value { get; set; }

  [Parameter] public EventCallback<string> ValueChanged { get; set; }

  /// <summary>What follows the field inside its group: its message, the password rules.</summary>
  [Parameter] public RenderFragment? ChildContent { get; set; }

  /// <summary>"Show" and the label as the field has it, lower-cased: "Show confirm new password" (C5).</summary>
  public string ToggleName => $"Show {Label.ToLowerInvariant()}";

  // A static render, or an interactive page's prerender, has no circuit to take the click, so wombat.js drives it.
  private bool Interactive => RendererInfo.IsInteractive;

  private void Toggle() => _shown = !_shown;

  // Only a bound field takes its input (the step F review): a field nothing binds (the Remove dialog's password, which the
  // browser posts) would otherwise send each keystroke of a password over the circuit and render the field again.
  private IReadOnlyDictionary<string, object>? InputHandler => ValueChanged.HasDelegate
    ? new Dictionary<string, object> { ["oninput"] = EventCallback.Factory.Create<ChangeEventArgs>(this, OnInputAsync) }
    : null;

  private Task OnInputAsync(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
}

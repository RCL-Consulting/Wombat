@using Microsoft.Extensions.Options
@using Wombat.Web.Security
@inject IOptions<IdentityOptions> IdentityOptions

@*
  The password rules, under a new-password field before anything is typed (T339, flow 02, C2 and E11): one heading, then
  one sentence a rule, in the one order every refusal lists them in (PasswordRuleMessages). On change password, register
  and the administrator's reset card. The field names it with aria-describedby by its Id.
*@
<div id="@Id" class="password-rules">
  <p>@PasswordRuleMessages.Heading</p>
  <ul>
    @foreach (var rule in PasswordRuleMessages.All(IdentityOptions.Value.Password))
    {
      <li>@rule</li>
    }
  </ul>
</div>

@code {
  /// <summary>The list's id, which the new-password field names.</summary>
  [Parameter, EditorRequired] public string Id { get; set; } = default!;
}

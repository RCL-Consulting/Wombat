@*
  The activity page's About card (T342, flow 03; R3-C-Activity, C13): who, what EPA, when, and what it credits, as a
  .details-list. It also holds what the old summary card carried: the form's version, only where a move's reason names
  it (T107), and the credit warnings (T108 credited nothing, T109 across scales, the paused EPA of D48) as
  .field-warning under Credit. Standing page content, so no warning carries a role (T193). The rows are
  ActivityPageModel.About's.
*@
<section class="@($"detail-card activity-about {Class}".TrimEnd())" aria-labelledby="activity-about-title@(IdSuffix)">
  <h2 id="activity-about-title@(IdSuffix)" class="activity-card-title">About</h2>
  <dl class="details-list">
    @foreach (var row in Rows)
    {
      <div>
        <dt>@row.Label</dt>
        <dd id="@(row.Id is null ? null : row.Id + IdSuffix)">
          @row.Value
          @if (row.Marker is { } marker)
          {
            @(" ")<span class="muted">@marker</span>
          }
          @if (row.Warnings is { Count: > 0 } warnings)
          {
            @foreach (var warning in warnings)
            {
              <p class="field-warning">@warning</p>
            }
          }
        </dd>
      </div>
    }
  </dl>
</section>

@code {
  [Parameter, EditorRequired] public IReadOnlyList<ActivityAboutRow> Rows { get; set; } = [];

  /// <summary>
  /// The card's rendering class: <c>only-wide</c> or <c>only-narrow</c> where the page draws About twice, first for 641px
  /// and up and under the bar on a phone, for a reader with a section to fill (T350; round 1, E3; round 2, E2).
  /// </summary>
  [Parameter] public string? Class { get; set; }

  /// <summary>Appended to every id the card carries: <c>-narrow</c> on the phone's copy, so no id is on the page twice.</summary>
  [Parameter] public string IdSuffix { get; set; } = string.Empty;
}

@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Nodes
@using Wombat.Application.Features.Activities.Services
@using Wombat.Domain.Activities.Schema
@inject IActivityReferenceDataService ReferenceDataService
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (!string.IsNullOrWhiteSpace(_loadError))
{
  <Alert Kind="danger">@_loadError</Alert>
}
else if (_schema is not null)
{
  <div class="form-container">
    @foreach (var formSection in _schema.Sections)
    {
      if (!IsVisible(formSection.ShowIf))
      {
        continue;
      }

      <fieldset class="detail-card detail-card--compact mb-3">
        <legend>@formSection.Title</legend>

        <div class="form-grid">
          @foreach (var field in formSection.Fields)
          {
            if (!IsVisible(field.ShowIf))
            {
              continue;
            }

            <FormField Label="@field.Label" InputId="@field.Key" HelpText="@field.HelpText" Required="@field.Required">
              @switch (field.Type)
              {
                case FieldType.Text:
                case FieldType.Signature:
                case FieldType.ProcedureRef:
                  <input id="@field.Key" class="form-control" value="@GetString(field.Key)" disabled="@IsFieldLocked(field.Key)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())" />
                  break;
                case FieldType.LongText:
                  <textarea id="@field.Key" class="form-control" rows="4" disabled="@IsFieldLocked(field.Key)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())">@GetString(field.Key)</textarea>
                  break;
                case FieldType.Number:
                case FieldType.Likert:
                case FieldType.Rating:
                  <input id="@field.Key" class="form-control" type="number" value="@GetString(field.Key)" disabled="@IsFieldLocked(field.Key)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())" />
                  break;
                case FieldType.Date:
                  <input id="@field.Key" class="form-control" type="date" value="@GetString(field.Key)" disabled="@IsFieldLocked(field.Key)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())" />
                  break;
                case FieldType.Choice:
                case FieldType.Epa:
                case FieldType.User:
                  <select id="@field.Key" class="form-select" disabled="@IsFieldLocked(field.Key)" @onchange="args => UpdateValue(field.Key, args.Value?.ToString())">
                    <option value="">Select…</option>
                    @foreach (var option in GetOptions(field))
                    {
                      <option value="@option.Value" selected="@string.Equals(GetString(field.Key), option.Value, StringComparison.Ordinal)">@option.Label</option>
                    }
                  </select>
                  break;
                case FieldType.Scale:
                  var scaleOptions = GetOptions(field);
                  if (scaleOptions.Count > 0)
                  {
                    <select id="@field.Key" class="form-select" disabled="@IsFieldLocked(field.Key)" @onchange="args => UpdateValue(field.Key, args.Value?.ToString())">
                      <option value="">Select…</option>
                      @foreach (var option in scaleOptions)
                      {
                        <option value="@option.Value" selected="@string.Equals(GetString(field.Key), option.Value, StringComparison.Ordinal)">@option.Label</option>
                      }
                    </select>
                  }
                  else
                  {
                    <input id="@field.Key" class="form-control" type="number" value="@GetString(field.Key)" disabled="@IsFieldLocked(field.Key)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())" />
                  }
                  break;
                case FieldType.MultiChoice:
                  <div class="full-width">
                    @foreach (var option in GetOptions(field))
                    {
                      <div class="form-check">
                        <input
                          id="@($"{field.Key}-{option.Value}")"
                          class="form-check-input"
                          type="checkbox"
                          checked="@GetMultiChoiceValues(field.Key).Contains(option.Value, StringComparer.Ordinal)"
                          disabled="@IsFieldLocked(field.Key)"
                          @onchange="args => ToggleMultiChoice(field.Key, option.Value, args.Value is bool checkedValue && checkedValue)" />
                        <label for="@($"{field.Key}-{option.Value}")">@option.Label</label>
                      </div>
                    }
                  </div>
                  break;
                case FieldType.File:
                  <div class="detail-card detail-card--empty-compact">
                    File uploads are represented in the schema, but storage wiring lands in a later pass.
                  </div>
                  break;
                default:
                  <div class="detail-card detail-card--empty-compact">
                    Unsupported field type: @field.Type
                  </div>
                  break;
              }
            </FormField>
          }
        </div>
      </fieldset>
    }
  </div>
}

@code {
  [Parameter, EditorRequired] public string SchemaJson { get; set; } = default!;
  [Parameter] public string DataJson { get; set; } = "{}";
  [Parameter] public bool ReadOnly { get; set; }

  /// <summary>
  /// The trainee this activity is ABOUT, when one is known. Credit follows the subject, not the
  /// viewer: on the detail page the principal is usually the assessor, and on the builder preview
  /// there is no subject at all. Null leaves every picker at its claims-based default (T108).
  /// </summary>
  [Parameter] public string? SubjectUserId { get; set; }

  /// <summary>
  /// The credit rules of the version this form is rendering — the PINNED version for an existing
  /// activity, the published-or-draft rules on the creation page.
  /// </summary>
  /// <remarks>
  /// Carried as raw DSL for the same reason <see cref="SchemaJson" /> and the workflow JSON are: it
  /// is what tells the renderer WHICH EPA field the credit engine will actually read. The field key
  /// is not the contract — <c>epa_field</c> is a free-form string in the credit rules and nothing
  /// validates it against the schema — so "the EPA that will be credited" can only be answered by
  /// intersecting the two. A reflective note declares an epa field and an empty <c>counts_for</c>;
  /// an MSF form credits a fixed curriculum item and never reads its epa field. Neither is narrowed.
  /// </remarks>
  [Parameter] public string? CreditRulesJson { get; set; }

  /// <summary>
  /// The field keys this actor may write, as resolved server-side by the field-permission
  /// evaluator (T070). <c>null</c> means "no per-field restriction" and keeps the pre-T070
  /// behaviour exactly: every field follows <see cref="ReadOnly" /> alone. An empty set locks
  /// every field, which is what keeps non-bound users read-only on the detail page.
  /// </summary>
  [Parameter] public IReadOnlySet<string>? EditableFieldKeys { get; set; }

  [Parameter] public EventCallback<string> DataJsonChanged { get; set; }

  private FormSchema? _schema;
  private JsonObject _data = [];
  private string? _loadError;
  private string? _loadedOptionsKey;

  // Schema field keys the pinned credit rules actually read as the EPA to credit. Empty for every
  // activity type that credits nothing, and for one that credits a fixed curriculum item.
  private IReadOnlySet<string> _creditedEpaFieldKeys = new HashSet<string>(StringComparer.Ordinal);

  private readonly Dictionary<string, IReadOnlyList<ActivityCatalogueOption>> _catalogueOptionsByField = [];

  protected override async Task OnParametersSetAsync()
  {
    try
    {
      _data = JsonNode.Parse(string.IsNullOrWhiteSpace(DataJson) ? "{}" : DataJson)?.AsObject() ?? [];

      // Schema parsing and reference-option loading depend only on the schema, not the data.
      // Reloading them on every value change would re-query the DB on each edit and can trigger
      // concurrent DbContext use when edits arrive in quick succession. Claim the schema before the
      // await so a re-entrant OnParametersSetAsync (fired by a rapid edit) skips the reload.
      // The reload key is the schema PLUS everything else the option lists now depend on. Keying it
      // on the schema alone would serve one subject's creditable EPAs to the next (T108).
      var optionsKey = string.Join('\u001f', SchemaJson, SubjectUserId ?? string.Empty, CreditRulesJson ?? string.Empty);
      if (!string.Equals(_loadedOptionsKey, optionsKey, StringComparison.Ordinal))
      {
        _schema = FormSchemaParser.Parse(SchemaJson);
        _loadedOptionsKey = optionsKey;
        _creditedEpaFieldKeys = ResolveCreditedEpaFieldKeys();
        await LoadOptionsAsync();
      }

      _loadError = null;
    }
    catch (Exception exception)
    {
      _loadError = exception.Message;
      _schema = null;
      _data = [];
      _catalogueOptionsByField.Clear();
      _creditedEpaFieldKeys = new HashSet<string>(StringComparer.Ordinal);
      _loadedOptionsKey = null;
    }
  }

  /// <summary>
  /// A field is locked when the whole form is read-only, or when a writable set was supplied and
  /// does not name it. The <c>disabled</c> attribute is only a hint to the browser — the guards in
  /// <see cref="UpdateValue" /> and <see cref="ToggleMultiChoice" /> call this too, so a forged
  /// event on a locked field changes nothing.
  /// </summary>
  private bool IsFieldLocked(string key)
    => ReadOnly || (EditableFieldKeys is not null && !EditableFieldKeys.Contains(key));

  private string GetString(string key)
  {
    if (!_data.TryGetPropertyValue(key, out var value) || value is null)
    {
      return string.Empty;
    }

    return value switch
    {
      JsonValue jsonValue => jsonValue.TryGetValue<string>(out var stringValue) ? stringValue ?? string.Empty : jsonValue.ToJsonString(),
      JsonArray jsonArray => string.Join(", ", jsonArray.Select(item => item?.GetValue<string>() ?? string.Empty)),
      _ => value.ToJsonString()
    };
  }

  private IReadOnlyList<string> GetMultiChoiceValues(string key)
  {
    if (!_data.TryGetPropertyValue(key, out var value) || value is not JsonArray array)
    {
      return [];
    }

    return array.Select(item => item?.GetValue<string>() ?? string.Empty)
      .Where(item => !string.IsNullOrWhiteSpace(item))
      .ToArray();
  }

  private IReadOnlyList<ActivityCatalogueOption> GetOptions(Wombat.Domain.Activities.Schema.FormField field)
  {
    if (field.Options.Count > 0)
    {
      return field.Options
        .Select(option => new ActivityCatalogueOption(option, option))
        .ToArray();
    }

    return _catalogueOptionsByField.TryGetValue(field.Key, out var options)
      ? options
      : [];
  }

  private bool IsVisible(VisibilityCondition? condition)
  {
    if (condition is null)
    {
      return true;
    }

    var value = GetString(condition.Field);
    var hasValue = !string.IsNullOrWhiteSpace(value);
    var target = condition.Value ?? string.Empty;

    return condition.Operator switch
    {
      "equals" => string.Equals(value, target, StringComparison.Ordinal),
      "not equals" or "not_equals" => !string.Equals(value, target, StringComparison.Ordinal),
      "is set" or "is_set" => hasValue,
      "is not set" or "is_not_set" => !hasValue,
      "greater than" or "greater_than" => CompareNumeric(value, target) > 0,
      "less than" or "less_than" => CompareNumeric(value, target) < 0,
      _ => true
    };
  }

  private async Task UpdateValue(string key, string? value)
  {
    if (IsFieldLocked(key))
    {
      return;
    }

    if (string.IsNullOrWhiteSpace(value))
    {
      _data.Remove(key);
    }
    else
    {
      _data[key] = value;
    }

    await DataJsonChanged.InvokeAsync(_data.ToJsonString());
  }

  private async Task ToggleMultiChoice(string key, string option, bool selected)
  {
    if (IsFieldLocked(key))
    {
      return;
    }

    var values = GetMultiChoiceValues(key).ToHashSet(StringComparer.Ordinal);
    if (selected)
    {
      values.Add(option);
    }
    else
    {
      values.Remove(option);
    }

    _data[key] = new JsonArray(values.Select(value => JsonValue.Create(value)).ToArray());
    await DataJsonChanged.InvokeAsync(_data.ToJsonString());
  }

  private async Task LoadOptionsAsync()
  {
    _catalogueOptionsByField.Clear();

    if (_schema is null)
    {
      return;
    }

    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    var principal = authState.User;

    foreach (var field in _schema.Sections.SelectMany(section => section.Fields))
    {
      IReadOnlyList<ActivityCatalogueOption>? options = field.Type switch
      {
        FieldType.Epa => await ReferenceDataService.GetEpaOptionsAsync(
          principal,
          new EpaOptionScope(
            SubjectUserId,
            _creditedEpaFieldKeys.Contains(field.Key),
            GetString(field.Key))),
        FieldType.User => await ReferenceDataService.GetAssessorOptionsAsync(principal),
        FieldType.Scale => await ReferenceDataService.GetEntrustmentScaleLevelOptionsAsync(field.ScaleKey),
        _ when !string.IsNullOrWhiteSpace(field.CatalogueKey)
          => await ReferenceDataService.GetCatalogueOptionsAsync(field.CatalogueKey),
        _ => null
      };

      if (options is not null)
      {
        _catalogueOptionsByField[field.Key] = options;
      }
    }
  }

  /// <summary>
  /// Which schema field keys the credit rules name as the EPA to credit.
  /// </summary>
  /// <remarks>
  /// Only <c>curriculum_item_match.epa_field</c> counts. A directive matching a fixed
  /// <c>curriculum_item_id</c> or a <c>curriculum_item_field</c> never reads an EPA, so an epa field
  /// alongside it is contextual metadata and narrowing it would hide choices that change nothing.
  /// Unparseable rules are not this method's error to surface — fall back to no narrowing.
  /// </remarks>
  private IReadOnlySet<string> ResolveCreditedEpaFieldKeys()
    => CreditRuleFields.ResolveCreditedEpaFieldKeys(CreditRulesJson);

  private static int CompareNumeric(string left, string right)
  {
    if (!decimal.TryParse(left, NumberStyles.Number, CultureInfo.InvariantCulture, out var leftValue) ||
        !decimal.TryParse(right, NumberStyles.Number, CultureInfo.InvariantCulture, out var rightValue))
    {
      return 0;
    }

    return leftValue.CompareTo(rightValue);
  }
}

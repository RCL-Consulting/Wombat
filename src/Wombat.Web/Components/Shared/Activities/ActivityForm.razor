@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Nodes
@using Wombat.Application.Features.Activities.Services
@using Wombat.Domain.Activities
@using Wombat.Domain.Activities.Schema
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (!string.IsNullOrWhiteSpace(_loadError))
{
  <Alert Kind="danger">@_loadError</Alert>
}
else if (_schema is not null)
{
  <div class="form-container">
    @foreach (var formSection in _schema.Sections)
    {
      if (!IsVisible(formSection.ShowIf))
      {
        continue;
      }

      <fieldset class="detail-card detail-card--compact mb-3">
        <legend>@formSection.Title</legend>

        <div class="form-grid">
          @foreach (var field in formSection.Fields)
          {
            if (!IsVisible(field.ShowIf))
            {
              continue;
            }

            if (!IsSingleControl(field.Type))
            {
              // A multi-choice field is several controls, and a file field (not wired: a seed holds a document as a link, D34) or an unsupported type
              // is none, so none has one control for a <label for> to name. Each is a fieldset named by its legend
              // instead (DESIGN.md § Form system, T177), its help text announced with the group.
              var helpId = string.IsNullOrWhiteSpace(field.HelpText) ? null : $"{field.Key}-help";

              <fieldset class="form-group @(field.Type == FieldType.MultiChoice ? "full-width" : null)" aria-describedby="@helpId">
                <legend>
                  @field.Label
                  @if (field.Required)
                  {
                    <span aria-hidden="true">*</span>
                    <span class="visually-hidden">required</span>
                  }
                </legend>

                @if (field.Type == FieldType.MultiChoice)
                {
                  <div class="check-grid">
                    @foreach (var option in GetOptions(field))
                    {
                      <div class="form-check">
                        <input
                          id="@($"{field.Key}-{option.Value}")"
                          class="form-check-input"
                          type="checkbox"
                          checked="@GetMultiChoiceValues(field.Key).Contains(option.Value, StringComparer.Ordinal)"
                          disabled="@IsFieldLocked(field.Key)"
                          @onchange="args => ToggleMultiChoice(field.Key, option.Value, args.Value is bool checkedValue && checkedValue)" />
                        <label for="@($"{field.Key}-{option.Value}")">@option.Label</label>
                      </div>
                    }
                  </div>
                }
                else if (field.Type == FieldType.File)
                {
                  <div class="detail-card detail-card--empty-compact">
                    File uploads are represented in the schema, but storage wiring lands in a later pass.
                  </div>
                }
                else
                {
                  <div class="detail-card detail-card--empty-compact">
                    Unsupported field type: @field.Type
                  </div>
                }

                @if (helpId is not null)
                {
                  <small id="@helpId" class="page-subtitle">@field.HelpText</small>
                }
              </fieldset>

              continue;
            }

            <FormField Label="@field.Label" InputId="@field.Key" HelpText="@field.HelpText" Required="@field.Required">
              <ChildContent>
              @switch (field.Type)
              {
                case FieldType.Text:
                case FieldType.Signature:
                case FieldType.ProcedureRef:
                  <input id="@field.Key" class="form-control" value="@GetString(field.Key)" disabled="@IsFieldLocked(field.Key)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())" />
                  break;
                case FieldType.LongText:
                  <textarea id="@field.Key" class="form-control" rows="4" disabled="@IsFieldLocked(field.Key)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())">@GetString(field.Key)</textarea>
                  break;
                case FieldType.Number:
                case FieldType.Likert:
                case FieldType.Rating:
                  <input id="@field.Key" class="form-control" type="number" value="@GetString(field.Key)" disabled="@IsFieldLocked(field.Key)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())" />
                  break;
                case FieldType.Date:
                  <input id="@field.Key" class="form-control" type="date" value="@GetString(field.Key)" disabled="@IsFieldLocked(field.Key)" aria-describedby="@(WarnsOfLateFiling(field.Key) ? LateFilingWarningId(field.Key) : null)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())" />
                  break;
                case FieldType.Choice:
                case FieldType.Epa:
                case FieldType.User:
                  <select id="@field.Key" class="form-select" disabled="@IsFieldLocked(field.Key)" @onchange="args => UpdateValue(field.Key, args.Value?.ToString())">
                    <option value="">Select…</option>
                    @foreach (var option in GetOptions(field))
                    {
                      <option value="@option.Value" selected="@string.Equals(GetString(field.Key), option.Value, StringComparison.Ordinal)">@option.Label</option>
                    }
                  </select>
                  break;
                case FieldType.Scale:
                  var scaleOptions = GetOptions(field);
                  if (scaleOptions.Count > 0)
                  {
                    <select id="@field.Key" class="form-select" disabled="@IsFieldLocked(field.Key)" @onchange="args => UpdateValue(field.Key, args.Value?.ToString())">
                      <option value="">Select…</option>
                      @foreach (var option in scaleOptions)
                      {
                        <option value="@option.Value" selected="@string.Equals(GetString(field.Key), option.Value, StringComparison.Ordinal)">@option.Label</option>
                      }
                    </select>
                  }
                  else
                  {
                    <input id="@field.Key" class="form-control" type="number" value="@GetString(field.Key)" disabled="@IsFieldLocked(field.Key)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())" />
                  }
                  break;
              }
              </ChildContent>
              <ValidationContent>
                @if (WarnsOfLateFiling(field.Key))
                {
                  @* T160, D15. A soft warning, never a refusal: the date the author types is the one T119 protects, and a
                     registrar refused for filing late types today's date instead. The live region is always present, so a
                     screen reader hears the warning when it appears as the date is typed. *@
                  <div id="@LateFilingWarningId(field.Key)" role="status">
                    @if (LateFilingDaysAfter(field.Key) is int daysLate)
                    {
                      <p class="field-warning">
                        This encounter was @daysLate days ago. It can still be filed, but a filing more than
                        @EncounterDatePolicy.LateFilingDays days after the encounter is recorded as late.
                      </p>
                    }
                  </div>
                }
              </ValidationContent>
            </FormField>
          }
        </div>
      </fieldset>
    }
  </div>
}

@code {
  [Parameter, EditorRequired] public string SchemaJson { get; set; } = default!;
  [Parameter] public string DataJson { get; set; } = "{}";
  [Parameter] public bool ReadOnly { get; set; }

  /// <summary>
  /// The trainee this activity is ABOUT, when one is known. Credit follows the subject, not the
  /// viewer: on the detail page the principal is usually the assessor, and on the builder preview
  /// there is no subject at all. Null leaves the EPA picker at its claims-based default (T108), and
  /// offers nobody in a user field (T102): who may be named depends on whom the activity is about.
  /// </summary>
  [Parameter] public string? SubjectUserId { get; set; }

  /// <summary>
  /// The credit rules of the version this form is rendering — the PINNED version for an existing
  /// activity, the published-or-draft rules on the creation page.
  /// </summary>
  /// <remarks>
  /// Carried as raw DSL for the same reason <see cref="SchemaJson" /> and the workflow JSON are: it
  /// is what tells the renderer WHICH EPA field the credit engine will actually read. The field key
  /// is not the contract — <c>epa_field</c> is a free-form string in the credit rules and nothing
  /// validates it against the schema — so "the EPA that will be credited" can only be answered by
  /// intersecting the two. A reflective note declares an epa field and an empty <c>counts_for</c>;
  /// an MSF form credits a fixed curriculum item and never reads its epa field. Neither is narrowed. A College
  /// instrument that credits nothing (<see cref="WbaToolKey" /> set, an empty <c>counts_for</c>) narrows the field its
  /// schema names as its evidence EPA instead, because the write path holds that EPA to the instrument's list (T154).
  /// </remarks>
  [Parameter] public string? CreditRulesJson { get; set; }

  /// <summary>
  /// Which College-named instrument the activity type is, as its <c>WbaToolKey</c> (T122). Null means "not a
  /// recognised instrument", which narrows nothing (D21).
  /// </summary>
  /// <remarks>
  /// The type row's CURRENT key, which is the one the write path checks at submit, so the EPA picker offers only
  /// what submitting will accept. Passed on every EPA field; the service reads it only on a narrowed field (the one the
  /// credit engine reads, or an unrated instrument's evidence EPA). It also decides whether an unrated type's evidence
  /// EPA is narrowed at all: only an instrument is held to a list (D21).
  /// </remarks>
  [Parameter] public string? WbaToolKey { get; set; }

  /// <summary>
  /// The field keys this actor may write, as resolved server-side by the field-permission
  /// evaluator (T070). <c>null</c> means "no per-field restriction" and keeps the pre-T070
  /// behaviour exactly: every field follows <see cref="ReadOnly" /> alone. An empty set locks
  /// every field, which is what keeps non-bound users read-only on the detail page.
  /// </summary>
  [Parameter] public IReadOnlySet<string>? EditableFieldKeys { get; set; }

  /// <summary>
  /// True when the form renders an activity that exists (T102). Its <c>user</c> fields then offer the people of
  /// <see cref="ActivityInstitutionId" />, the institution stamped on it; on the create page (false) the institution is
  /// resolved from <see cref="SubjectUserId" /> the way the create will stamp it. Either way it is the institution the
  /// write path judges a nominee against.
  /// </summary>
  [Parameter] public bool IsExistingActivity { get; set; }

  /// <summary>The existing activity's stamped institution. Null lists nobody, as the write path accepts nobody.</summary>
  [Parameter] public int? ActivityInstitutionId { get; set; }

  /// <summary>
  /// The activity's data as STORED, on a page showing one that exists; null on the create page and the builder preview.
  /// </summary>
  /// <remarks>
  /// A <c>user</c> field labels only a value stored on the activity (T102). <see cref="DataJson" /> is the working copy,
  /// which a caller can fill with anyone's id by editing the page, and looking that id up would hand back the name and
  /// email of a person the record never named.
  /// </remarks>
  [Parameter] public string? StoredDataJson { get; set; }

  /// <summary>
  /// The South African date this form would be filed on, when what is typed here can still be the filing; null
  /// otherwise (T160, D15).
  /// </summary>
  /// <remarks>
  /// While it is set, the encounter date field (the schema's <c>observation_date_field</c>) warns, without refusing, as
  /// soon as the date typed is more than <see cref="EncounterDatePolicy.LateFilingDays" /> days before it: the lateness
  /// the filing's history row will record. The create page passes today; an activity's page passes today only to its
  /// author while it is still in its initial state; the builder preview passes nothing. A parameter rather than a clock
  /// read here, so the page decides whether this is a filing and a test can fix the day. Whether the type can file late
  /// at all is this form's to decide, from <see cref="CreditRulesJson" />: only a type that can credit records lateness,
  /// so only its form warns (<see cref="FilingLateness.WarnsFor" />).
  /// </remarks>
  [Parameter] public DateOnly? FiledOn { get; set; }

  [Parameter] public EventCallback<string> DataJsonChanged { get; set; }

  private FormSchema? _schema;
  private JsonObject _data = [];
  private string? _loadError;
  private string? _loadedOptionsKey;

  // Schema field keys whose EPA picker is narrowed to what the write path accepts: the fields the pinned credit rules
  // read as the EPA to credit, or a College instrument's evidence EPA when it credits nothing (T154). Empty for a type
  // that is no instrument and credits nothing, and for one that credits a fixed curriculum item.
  private IReadOnlySet<string> _narrowedEpaFieldKeys = new HashSet<string>(StringComparer.Ordinal);

  // Whether the pinned credit rules can credit, so a filing of this form can be late (T160). Asked once per load, with the
  // rules, rather than on every render of every field.
  private bool _canFileLate;

  private readonly Dictionary<string, IReadOnlyList<ActivityCatalogueOption>> _catalogueOptionsByField = [];

  // Which load owns the option lists. A newer load supersedes an older one still awaiting its queries.
  private int _loadVersion;

  protected override async Task OnParametersSetAsync()
  {
    try
    {
      _data = JsonNode.Parse(string.IsNullOrWhiteSpace(DataJson) ? "{}" : DataJson)?.AsObject() ?? [];

      // Schema parsing and reference-option loading depend only on the schema, not the data.
      // Reloading them on every value change would re-query the DB on each edit and can trigger
      // concurrent DbContext use when edits arrive in quick succession. Claim the schema before the
      // await so a re-entrant OnParametersSetAsync (fired by a rapid edit) skips the reload.
      // The reload key is the schema PLUS everything else the option lists now depend on. Keying it
      // on the schema alone would serve one subject's creditable EPAs to the next (T108), and leaving
      // the tool out would serve one instrument's permitted EPAs to another with the same form (T122).
      // T102 adds the nominee scope, and which fields are locked: a locked user field loads only its stored person's
      // label, so a field that becomes editable must reload to get its list.
      var optionsKey = string.Join(
        '\u001f',
        SchemaJson,
        SubjectUserId ?? string.Empty,
        CreditRulesJson ?? string.Empty,
        WbaToolKey ?? string.Empty,
        IsExistingActivity ? "existing" : "new",
        ActivityInstitutionId?.ToString(CultureInfo.InvariantCulture) ?? string.Empty,
        ReadOnly ? "read-only" : "writable",
        EditableFieldKeys is null ? "*" : string.Join(',', EditableFieldKeys.Order(StringComparer.Ordinal)),
        StoredDataJson ?? string.Empty);
      if (!string.Equals(_loadedOptionsKey, optionsKey, StringComparison.Ordinal))
      {
        _schema = FormSchemaParser.Parse(SchemaJson);
        _loadedOptionsKey = optionsKey;
        _narrowedEpaFieldKeys = ResolveNarrowedEpaFieldKeys(_schema);
        _canFileLate = FilingLateness.WarnsFor(CreditRulesJson);
        await LoadOptionsAsync();
      }

      _loadError = null;
    }
    catch (Exception exception)
    {
      _loadError = exception.Message;
      _schema = null;
      _data = [];
      _catalogueOptionsByField.Clear();
      _narrowedEpaFieldKeys = new HashSet<string>(StringComparer.Ordinal);
      _canFileLate = false;
      _loadedOptionsKey = null;
    }
  }

  /// <summary>
  /// A field is locked when the whole form is read-only, or when a writable set was supplied and
  /// does not name it. The <c>disabled</c> attribute is only a hint to the browser — the guards in
  /// <see cref="UpdateValue" /> and <see cref="ToggleMultiChoice" /> call this too, so a forged
  /// event on a locked field changes nothing.
  /// </summary>
  private bool IsFieldLocked(string key)
    => ReadOnly || (EditableFieldKeys is not null && !EditableFieldKeys.Contains(key));

  /// <summary>
  /// The field types rendered as exactly one control with the field's key as its id, which is what
  /// <c>FormField</c>'s <c>&lt;label for&gt;</c> names. Every other type renders as a fieldset named by its
  /// legend (T177). The list and the markup's switch must agree both ways. A type listed here with no case leaves
  /// a label naming nothing, and a type with a case left off the list shows "Unsupported field type" in its place.
  /// <c>ActivityFormLabelTests</c> renders every <see cref="FieldType" /> and pins which ones are groups, so either
  /// drift fails it.
  /// </summary>
  private static bool IsSingleControl(FieldType type)
    => type is FieldType.Text or FieldType.Signature or FieldType.ProcedureRef
      or FieldType.LongText
      or FieldType.Number or FieldType.Likert or FieldType.Rating
      or FieldType.Date
      or FieldType.Choice or FieldType.Epa or FieldType.User
      or FieldType.Scale;

  /// <summary>
  /// Whether this field is the encounter date of a form that may be the filing, of a type that can credit, and the actor
  /// can type in it (T160). A type that credits nothing records no lateness, so warning that its filing "is recorded as
  /// late" would be untrue. A locked date is not being typed, and on this page nobody could act on the warning.
  /// </summary>
  private bool WarnsOfLateFiling(string key)
    => FiledOn is not null &&
       _canFileLate &&
       _schema is not null &&
       string.Equals(_schema.ObservationDateField, key, StringComparison.Ordinal) &&
       !IsFieldLocked(key);

  private static string LateFilingWarningId(string key) => $"{key}-late-filing";

  /// <summary>
  /// How many days before <see cref="FiledOn" /> the typed encounter date is, when that makes the filing late (T160, D15);
  /// otherwise null. The same policy the server applies to the filing's history row (<see cref="EncounterDatePolicy" />).
  /// A date after the filing day is the server's to refuse, not a late filing.
  /// </summary>
  private int? LateFilingDaysAfter(string key)
  {
    if (FiledOn is not DateOnly filedOn ||
        !DateOnly.TryParse(GetString(key), CultureInfo.InvariantCulture, DateTimeStyles.None, out var encounteredOn))
    {
      return null;
    }

    var days = EncounterDatePolicy.DaysAfterEncounter(encounteredOn, filedOn);
    return EncounterDatePolicy.IsLateFiling(days) ? days : null;
  }

  private string GetString(string key)
  {
    if (!_data.TryGetPropertyValue(key, out var value) || value is null)
    {
      return string.Empty;
    }

    return value switch
    {
      JsonValue jsonValue => jsonValue.TryGetValue<string>(out var stringValue) ? stringValue ?? string.Empty : jsonValue.ToJsonString(),
      JsonArray jsonArray => string.Join(", ", jsonArray.Select(item => item?.GetValue<string>() ?? string.Empty)),
      _ => value.ToJsonString()
    };
  }

  private IReadOnlyList<string> GetMultiChoiceValues(string key)
  {
    if (!_data.TryGetPropertyValue(key, out var value) || value is not JsonArray array)
    {
      return [];
    }

    return array.Select(item => item?.GetValue<string>() ?? string.Empty)
      .Where(item => !string.IsNullOrWhiteSpace(item))
      .ToArray();
  }

  private IReadOnlyList<ActivityCatalogueOption> GetOptions(Wombat.Domain.Activities.Schema.FormField field)
  {
    // A user field's people and an EPA field's EPAs come from the server's own lists, which are what the write path
    // checks against, never from inline options a schema might carry (T102, T122): those would offer values that
    // submitting refuses, and hide the stored-value fallback.
    if (field.Type is FieldType.User or FieldType.Epa)
    {
      var loaded = _catalogueOptionsByField.TryGetValue(field.Key, out var directoryOptions);
      IReadOnlyList<ActivityCatalogueOption> listed = loaded ? directoryOptions! : [];

      // A person picked on this page but not on the list (refused, then the list reloaded without them) is still what
      // the next action would send, so the select must show it, and choosing "Select…" must be a real change. Labelled
      // here, never looked up: the working copy may hold anyone's id (T102). Only once the list has loaded: before
      // that, "not listed" means "not known yet", and a valid stored nominee would read as unavailable.
      var working = GetString(field.Key);
      if (field.Type == FieldType.User &&
          loaded &&
          !IsFieldLocked(field.Key) &&
          !string.IsNullOrEmpty(working) &&
          !listed.Any(option => string.Equals(option.Value, working, StringComparison.Ordinal)))
      {
        return [.. listed, new ActivityCatalogueOption(working, "Not available (choose someone else)")];
      }

      return listed;
    }

    // The value is what the control posts and the activity stores; the label is what the reader sees. A schema's key
    // (`admission_notes`) is never shown as though it were words (T191).
    if (field.Options.Count > 0)
    {
      return field.Options
        .Select(option => new ActivityCatalogueOption(option.Value, option.Label))
        .ToArray();
    }

    return _catalogueOptionsByField.TryGetValue(field.Key, out var options)
      ? options
      : [];
  }

  private bool IsVisible(VisibilityCondition? condition)
  {
    if (condition is null)
    {
      return true;
    }

    var value = GetString(condition.Field);
    var hasValue = !string.IsNullOrWhiteSpace(value);
    var target = condition.Value ?? string.Empty;

    return condition.Operator switch
    {
      "equals" => string.Equals(value, target, StringComparison.Ordinal),
      "not equals" or "not_equals" => !string.Equals(value, target, StringComparison.Ordinal),
      "is set" or "is_set" => hasValue,
      "is not set" or "is_not_set" => !hasValue,
      "greater than" or "greater_than" => CompareNumeric(value, target) > 0,
      "less than" or "less_than" => CompareNumeric(value, target) < 0,
      _ => true
    };
  }

  private async Task UpdateValue(string key, string? value)
  {
    if (IsFieldLocked(key))
    {
      return;
    }

    if (string.IsNullOrWhiteSpace(value))
    {
      _data.Remove(key);
    }
    else
    {
      _data[key] = value;
    }

    await DataJsonChanged.InvokeAsync(_data.ToJsonString());
  }

  private async Task ToggleMultiChoice(string key, string option, bool selected)
  {
    if (IsFieldLocked(key))
    {
      return;
    }

    var values = GetMultiChoiceValues(key).ToHashSet(StringComparer.Ordinal);
    if (selected)
    {
      values.Add(option);
    }
    else
    {
      values.Remove(option);
    }

    _data[key] = new JsonArray(values.Select(value => JsonValue.Create(value)).ToArray());
    await DataJsonChanged.InvokeAsync(_data.ToJsonString());
  }

  private async Task LoadOptionsAsync()
  {
    var version = ++_loadVersion;

    if (_schema is null)
    {
      _catalogueOptionsByField.Clear();
      return;
    }

    var schema = _schema;
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    var principal = authState.User;

    // Each load gets its own scope, and so its own DbContext (T102). The circuit's context is shared by everything on
    // the page, and a keyed remount after a refused action can start a load while another instance's is still awaiting;
    // two queries on one context throw. Results are swapped in only if no newer load has started meanwhile.
    await using var scope = ScopeFactory.CreateAsyncScope();
    var referenceData = scope.ServiceProvider.GetRequiredService<IActivityReferenceDataService>();

    var loaded = new Dictionary<string, IReadOnlyList<ActivityCatalogueOption>>(StringComparer.Ordinal);
    foreach (var field in schema.Sections.SelectMany(section => section.Fields))
    {
      IReadOnlyList<ActivityCatalogueOption>? options = field.Type switch
      {
        FieldType.Epa => await referenceData.GetEpaOptionsAsync(
          principal,
          new EpaOptionScope(
            SubjectUserId,
            _narrowedEpaFieldKeys.Contains(field.Key),
            GetString(field.Key),
            WbaToolKey)),
        FieldType.User => await LoadNomineeOptionsAsync(referenceData, schema, field),
        FieldType.Scale => await referenceData.GetEntrustmentScaleLevelOptionsAsync(field.ScaleKey),
        _ when !string.IsNullOrWhiteSpace(field.CatalogueKey)
          => await referenceData.GetCatalogueOptionsAsync(field.CatalogueKey),
        _ => null
      };

      if (options is not null)
      {
        loaded[field.Key] = options;
      }
    }

    if (version != _loadVersion)
    {
      return;
    }

    _catalogueOptionsByField.Clear();
    foreach (var (key, options) in loaded)
    {
      _catalogueOptionsByField[key] = options;
    }
  }

  /// <summary>
  /// A <c>user</c> field's options (T102): the nominee directory's list when the field can be written, and only the
  /// stored person when it cannot. A reader is shown who was named, never everyone who could have been. Only a value
  /// stored on the activity is ever looked up; see <see cref="StoredDataJson" />.
  /// </summary>
  private async Task<IReadOnlyList<ActivityCatalogueOption>> LoadNomineeOptionsAsync(
    IActivityReferenceDataService referenceData,
    FormSchema schema,
    Wombat.Domain.Activities.Schema.FormField field)
  {
    var stored = StoredValueOf(field.Key);

    if (IsFieldLocked(field.Key))
    {
      if (stored is null)
      {
        return [];
      }

      var option = await referenceData.GetUserOptionAsync(stored);
      return [option ?? new ActivityCatalogueOption(stored, "Unknown person")];
    }

    return await referenceData.GetNomineeOptionsAsync(new NomineeOptionScope(
      SubjectUserId,
      ActorFieldRules.RequiredRolesForUserField(schema, field.Key),
      IsExistingActivity,
      ActivityInstitutionId,
      stored));
  }

  /// <summary>The field's value as stored on the activity, or null. A JSON string only, as the actor grammar reads it.</summary>
  private string? StoredValueOf(string key)
  {
    if (string.IsNullOrWhiteSpace(StoredDataJson))
    {
      return null;
    }

    try
    {
      var stored = JsonNode.Parse(StoredDataJson) as JsonObject;
      return stored is not null &&
             stored.TryGetPropertyValue(key, out var value) &&
             value is JsonValue jsonValue &&
             jsonValue.TryGetValue<string>(out var text) &&
             !string.IsNullOrEmpty(text)
        ? text
        : null;
    }
    catch (JsonException)
    {
      return null;
    }
  }

  /// <summary>
  /// Which schema field keys the credit rules name as the EPA to credit, or, for a College instrument that credits
  /// nothing, the schema's evidence EPA (T154): the targets the write path's tool gate judges.
  /// </summary>
  /// <remarks>
  /// Only <c>curriculum_item_match.epa_field</c> counts among the credit rules. A directive matching a fixed
  /// <c>curriculum_item_id</c> never reads an EPA, and one matching a <c>curriculum_item_field</c> reads
  /// its epa field only as a fallback when the item field holds no id, so an epa field alongside either is
  /// left un-narrowed: narrowing it would usually hide choices that change nothing. The write path's tool
  /// gate follows the engine exactly and is the authority in that fallback case (T122). Unparseable rules
  /// are not this method's error to surface — fall back to no narrowing.
  /// </remarks>
  private IReadOnlySet<string> ResolveNarrowedEpaFieldKeys(FormSchema schema)
    => CreditRuleFields.ResolveNarrowedEpaFieldKeys(CreditRulesJson, schema.EvidenceEpaField, WbaToolKey);

  private static int CompareNumeric(string left, string right)
  {
    if (!decimal.TryParse(left, NumberStyles.Number, CultureInfo.InvariantCulture, out var leftValue) ||
        !decimal.TryParse(right, NumberStyles.Number, CultureInfo.InvariantCulture, out var rightValue))
    {
      return 0;
    }

    return leftValue.CompareTo(rightValue);
  }
}

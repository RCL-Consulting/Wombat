@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Nodes
@using Wombat.Application.Features.Activities.Services
@using Wombat.Domain.Activities
@using Wombat.Domain.Activities.Schema
@using Wombat.Domain.Activities.Workflow
@using Wombat.Domain.Identity
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

@* The activity form (T342, flow 03; DESIGN.md § Form system). The schema's sections in its own order (E6: the College's
   seeds are never reordered), each a card one deep, named by its heading. A section the reader may write is a form; one
   they may not write is not: filled, its values are read-outs; not filled yet, it is a locked section, a dashed frame
   whose head row says who fills it in (C14), with no inputs in it. *@
@if (!string.IsNullOrWhiteSpace(_loadError))
{
  <Alert Kind="danger">@_loadError</Alert>
}
else if (_schema is not null)
{
  var sections = VisibleSections().ToList();
  var anyNotOpen = sections.Any(section => section.Kind != SectionKind.Open);

  <div class="activity-form">
    @if (sections.Any(section => section.Kind == SectionKind.Open && section.Fields.Any(field => field.Required && !IsFieldLocked(field.Key))))
    {
      @* Above the first section, so it is read before the first mark it explains (A15). *@
      <p class="field-help"><span class="required-mark">*</span> marks a field you must fill in.</p>
    }

    @foreach (var section in sections)
    {
      var headingId = ActivityFieldIds.Section(section.Section.Key);

      if (section.Kind == SectionKind.Locked)
      {
        <section class="detail-card form-section form-section--locked" aria-labelledby="@headingId">
          <div class="form-section-lockhead">
            @SectionHeading(headingId, section.Section.Title)
            @if (LockedOwnerLine(section.Section) is { } ownerLine)
            {
              <p class="form-section-owner"><Icon Name="lock" />@ownerLine</p>
            }
          </div>
          <div class="form-section-lockbody">
            @foreach (var field in section.Fields.Where(field => field.Type == FieldType.Scale))
            {
              if (RungsFor(field) is { Count: > 0 } rungs)
              {
                <RungRow Label="@field.Label" Rungs="rungs" Pending="true" />
              }
            }
            <p class="form-section-empty">@(LockedSectionsClosed || OwnerOf(section.Section).Kind == SectionOwnerKind.Author ? "Not filled in." : "Not filled in yet.")</p>
            @foreach (var field in section.Fields.Where(field => IsRefused(field.Key)))
            {
              <p id="@ActivityFieldIds.Input(field.Key)" class="validation-message" tabindex="-1">@RefusalLineFor(field)</p>
            }
          </div>
        </section>
      }
      else if (section.Kind == SectionKind.Filled)
      {
        var attribution = SectionAttributions?.GetValueOrDefault(section.Section.Key);

        <section class="@(FoldFilledSections ? "detail-card form-section only-wide" : "detail-card form-section")" aria-labelledby="@headingId">
          <div class="form-section-head">
            @SectionHeading(headingId, section.Section.Title)
            @if (!string.IsNullOrEmpty(attribution))
            {
              <p class="form-section-owner">@attribution</p>
            }
          </div>
          <dl class="details-list details-list--stacked">
            @foreach (var field in section.Fields)
            {
              <div id="@ActivityFieldIds.Input(field.Key)" tabindex="-1">
                <dt>@field.Label</dt>
                @ReadoutValue(field, string.Empty)
              </div>
            }
          </dl>
        </section>

        @if (FoldFilledSections)
        {
          @* The request fold (T350; round 1, E3; round 2, E2): for a reader with a section to fill, a filled section is
             drawn twice, the card above for 641 px and up and this fold below it, shut, toggled by CSS with no script.
             Its summary is the title, who filled it in and Show (Hide while open), with no gist; its body the same
             read-outs. Every id in it is suffixed -narrow, so neither copy's ids name the other's parts. A refusal naming
             one of its fields opens it, so on a phone the refusal line is on the screen (the build review's A4, G1). *@
          <details class="detail-card form-section section-fold only-narrow" open="@section.Fields.Any(field => IsRefused(field.Key))">
            <summary>
              <div class="section-fold-head">
                @SectionHeading(headingId + NarrowSuffix, section.Section.Title)
                <span class="section-fold-show"><span class="fold-show">Show</span><span class="fold-hide">Hide</span></span>
              </div>
              @if (!string.IsNullOrEmpty(attribution))
              {
                <span class="section-fold-owner">@attribution</span>
              }
            </summary>
            <div class="section-fold-body">
              <dl class="details-list details-list--stacked">
                @foreach (var field in section.Fields)
                {
                  <div id="@(ActivityFieldIds.Input(field.Key) + NarrowSuffix)">
                    <dt>@field.Label</dt>
                    @ReadoutValue(field, NarrowSuffix)
                  </div>
                }
              </dl>
            </div>
          </details>
        }
      }
      else
      {
        <section class="detail-card form-section" aria-labelledby="@headingId">
          <div class="form-section-head">
            @SectionHeading(headingId, section.Section.Title)
            @if (anyNotOpen)
            {
              <p class="form-section-owner">You fill this in</p>
            }
          </div>

          <div class="form-grid">
            @foreach (var field in section.Fields)
            {
              if (IsFieldLocked(field.Key))
              {
                @* A field the reader may read but not change, among the ones they may: text, not a disabled control
                   (DESIGN.md § Form system, T302). *@
                <dl id="@ActivityFieldIds.Input(field.Key)" tabindex="-1" class="form-group @(IsWide(field.Type) ? "full-width" : null)">
                  <dt>@field.Label</dt>
                  @ReadoutValue(field, string.Empty)
                </dl>
                continue;
              }

              if (UsesRungPicker(field))
              {
                <RatedLevelPicker FieldKey="@field.Key"
                                  Label="@field.Label"
                                  Rungs="Rungs!"
                                  Value="@GetString(field.Key)"
                                  Required="@field.Required"
                                  HelpText="@field.HelpText"
                                  DescribedBy="@DescribedBy(field)"
                                  Message="@FieldMessageFor(field.Key)"
                                  Invalid="@IsMarkedInvalid(field.Key)"
                                  OnChoose="value => UpdateValue(field.Key, value)" />
                continue;
              }

              if (!IsSingleControl(field.Type))
              {
                // A multi-choice field is several controls, and a file field (not wired: a seed holds a document as a link, D34) or an unsupported type
                // is none, so none has one control for a <label for> to name. Each is a fieldset named by its legend
                // instead (DESIGN.md § Form system, T177), its help text announced with the group, and the refusal that named
                // it (T263). Its checkboxes are not marked: a native one takes no border, and the refusal says it. The
                // fieldset carries the input id, so a refusal summary's link lands on it (C8), and tabindex="-1", so the
                // link can give it the focus (T342, A2). So do a read-out and a locked section's refusal line.
                var helpId = string.IsNullOrWhiteSpace(field.HelpText) ? null : FieldHelp.Id(field.Key);

                <fieldset id="@ActivityFieldIds.Input(field.Key)" tabindex="-1" class="form-group @(field.Type == FieldType.MultiChoice ? "full-width" : null)" aria-describedby="@DescribedBy(field)">
                  <legend>
                    @field.Label
                    @if (field.Required)
                    {
                      <span class="required-mark" aria-hidden="true">*</span>
                      <span class="visually-hidden">required</span>
                    }
                  </legend>

                  @if (field.Type == FieldType.MultiChoice)
                  {
                    <div class="check-grid">
                      @foreach (var option in GetOptions(field))
                      {
                        <div class="form-check">
                          <input
                            id="@($"{field.Key}-{option.Value}")"
                            class="form-check-input"
                            type="checkbox"
                            checked="@GetMultiChoiceValues(field.Key).Contains(option.Value, StringComparer.Ordinal)"
                            @onchange="args => ToggleMultiChoice(field.Key, option.Value, args.Value is bool checkedValue && checkedValue)" />
                          <label for="@($"{field.Key}-{option.Value}")">@option.Label</label>
                        </div>
                      }
                    </div>
                  }
                  else if (field.Type == FieldType.File)
                  {
                    <div class="detail-card detail-card--empty-compact">
                      File uploads are represented in the schema, but storage wiring lands in a later pass.
                    </div>
                  }
                  else
                  {
                    <div class="detail-card detail-card--empty-compact">
                      Unsupported field type: @field.Type
                    </div>
                  }

                  @if (helpId is not null)
                  {
                    <small id="@helpId" class="page-subtitle">@field.HelpText</small>
                  }
                  @if (FieldMessageFor(field.Key) is { } groupMessage)
                  {
                    <p id="@ActivityFieldIds.Message(field.Key)" class="validation-message">@groupMessage</p>
                  }
                </fieldset>

                continue;
              }

              var inputId = ActivityFieldIds.Input(field.Key);

              <div class="form-group @(IsWide(field.Type) ? "full-width" : null)">
                @* The mark is seen; aria-required says it to a screen reader, on the control itself (T342, flow 03). *@
                <label for="@inputId">@field.Label@if (field.Required){<span class="required-mark" aria-hidden="true"> *</span>}</label>
                @switch (field.Type)
                {
                  case FieldType.Text:
                  case FieldType.Signature:
                  case FieldType.ProcedureRef:
                    <input id="@inputId" class="@ControlClass("form-control", field.Key)" value="@GetString(field.Key)" aria-required="@AriaRequired(field)" aria-describedby="@DescribedBy(field)" aria-invalid="@AriaInvalid(field.Key)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())" />
                    break;
                  case FieldType.LongText:
                    <textarea id="@inputId" class="@ControlClass("form-control", field.Key)" rows="4" aria-required="@AriaRequired(field)" aria-describedby="@DescribedBy(field)" aria-invalid="@AriaInvalid(field.Key)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())">@GetString(field.Key)</textarea>
                    break;
                  case FieldType.Number:
                  case FieldType.Likert:
                  case FieldType.Rating:
                    <input id="@inputId" class="@ControlClass("form-control", field.Key)" type="number" value="@GetString(field.Key)" aria-required="@AriaRequired(field)" aria-describedby="@DescribedBy(field)" aria-invalid="@AriaInvalid(field.Key)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())" />
                    break;
                  case FieldType.Date:
                    @* On change, not on every keystroke: the encounter date's notices are shown once a date has been
                       entered, not while a year is half typed (Spec § 1, "Hint"). *@
                    <input id="@inputId" class="@ControlClass("form-control", field.Key)" type="date" value="@GetString(field.Key)" aria-required="@AriaRequired(field)" aria-describedby="@DescribedBy(field)" aria-invalid="@AriaInvalid(field.Key)" @onchange="args => ChangeDate(field.Key, args.Value?.ToString())" />
                    break;
                  case FieldType.Choice:
                  case FieldType.Epa:
                  case FieldType.User:
                    @* A native select, each option's full text (T323): nothing is cut off, and the chosen one is printed
                       in full under it. *@
                    <select id="@inputId" class="@ControlClass("form-select", field.Key)" aria-required="@AriaRequired(field)" aria-describedby="@DescribedBy(field)" aria-invalid="@AriaInvalid(field.Key)" @onchange="args => UpdateValue(field.Key, args.Value?.ToString())">
                      <option value="">Select…</option>
                      @foreach (var option in GetOptions(field))
                      {
                        <option value="@option.Value" selected="@string.Equals(GetString(field.Key), option.Value, StringComparison.Ordinal)">@option.Label</option>
                      }
                    </select>
                    break;
                  case FieldType.Scale:
                    @* Every scale field but the rated level field whose ladder loaded keeps the select (T350, E3): the
                       demo types carry up to six scale fields, and only the rated field's ladder is read. *@
                    var scaleOptions = GetOptions(field);
                    if (scaleOptions.Count > 0)
                    {
                      <select id="@inputId" class="@ControlClass("form-select", field.Key)" aria-required="@AriaRequired(field)" aria-describedby="@DescribedBy(field)" aria-invalid="@AriaInvalid(field.Key)" @onchange="args => UpdateValue(field.Key, args.Value?.ToString())">
                        <option value="">Select…</option>
                        @foreach (var option in scaleOptions)
                        {
                          <option value="@option.Value" selected="@string.Equals(GetString(field.Key), option.Value, StringComparison.Ordinal)">@option.Label</option>
                        }
                      </select>
                    }
                    else
                    {
                      <input id="@inputId" class="@ControlClass("form-control", field.Key)" type="number" value="@GetString(field.Key)" aria-required="@AriaRequired(field)" aria-describedby="@DescribedBy(field)" aria-invalid="@AriaInvalid(field.Key)" @oninput="args => UpdateValue(field.Key, args.Value?.ToString())" />
                    }
                    break;
                }

                @if (field.Type is FieldType.Epa or FieldType.User && ChosenLabel(field) is { } readback)
                {
                  @* The select says the same to a screen reader; this is for the eye, where a long option is cut off. *@
                  <p class="field-readback" aria-hidden="true">@readback</p>
                }

                @if (!string.IsNullOrWhiteSpace(field.HelpText))
                {
                  <p id="@FieldHelp.Id(field.Key)" class="field-help">@field.HelpText</p>
                }

                @if (FieldMessageFor(field.Key) is { } message)
                {
                  <p id="@ActivityFieldIds.Message(field.Key)" class="validation-message">@message</p>
                }

                @if (NoticesFilingDate(field.Key))
                {
                  @* T160, D15. The lateness is a soft warning, never a refusal: the date the author types is the one T119
                     protects, and a registrar refused for filing late types today's date instead. The live region is always
                     present, so a screen reader hears what appears in it once a date is entered (A3).
                     T192, C9: a date before the programme started is not late but refused, so it says that instead, as a
                     predicted refusal: the field's own validation message, and the control marked invalid. It is worded
                     for its reader (C12). T263: a date the server has refused is not called fileable either, even where the
                     page could not predict it: the summary names it and the input is marked, so the warning stays away
                     until the date is changed, and so does the predicted refusal, which would repeat the server's. Both wait for a date to be entered, or show at once on a form that opens
                     with one (File it again, a draft; Spec § 1). *@
                  <div id="@ActivityFieldIds.FilingNotice(field.Key)" role="status">
                    @if (_dateEntered && !IsRefused(field.Key) && BeforeProgrammeStart(field.Key) is DateOnly startedOn)
                    {
                      <p class="validation-message">@ProgrammeStartWording.Hint(ReaderIsSubject, startedOn)</p>
                    }
                    else if (_dateEntered && !IsRefused(field.Key) && LateFilingDaysAfter(field.Key) is int daysLate)
                    {
                      <p class="field-warning">
                        This encounter was @daysLate days ago. It can still be filed, but a filing more than
                        @EncounterDatePolicy.LateFilingDays days after the encounter is recorded as late.
                      </p>
                    }
                  </div>
                }
              </div>
            }
          </div>
        </section>
      }
    }
  </div>
}

@code {
  [Parameter, EditorRequired] public string SchemaJson { get; set; } = default!;
  [Parameter] public string DataJson { get; set; } = "{}";
  [Parameter] public bool ReadOnly { get; set; }

  /// <summary>
  /// The trainee this activity is ABOUT, when one is known. Credit follows the subject, not the
  /// viewer: on the detail page the principal is usually the assessor, and on the builder preview
  /// there is no subject at all. Null leaves the EPA picker at its claims-based default (T108), and
  /// offers nobody in a user field (T102): who may be named depends on whom the activity is about.
  /// </summary>
  [Parameter] public string? SubjectUserId { get; set; }

  /// <summary>
  /// The credit rules of the version this form is rendering — the PINNED version for an existing
  /// activity, the published-or-draft rules on the creation page.
  /// </summary>
  /// <remarks>
  /// Carried as raw DSL for the same reason <see cref="SchemaJson" /> and the workflow JSON are: it
  /// is what tells the renderer WHICH EPA field the credit engine will actually read. The field key
  /// is not the contract — <c>epa_field</c> is a free-form string in the credit rules and nothing
  /// validates it against the schema — so "the EPA that will be credited" can only be answered by
  /// intersecting the two. A reflective note declares an epa field and an empty <c>counts_for</c>;
  /// an MSF form credits a fixed curriculum item and never reads its epa field. Neither is narrowed. A College
  /// instrument that credits nothing (<see cref="WbaToolKey" /> set, an empty <c>counts_for</c>) narrows the field its
  /// schema names as its evidence EPA instead, because the write path holds that EPA to the instrument's list (T154).
  /// </remarks>
  [Parameter] public string? CreditRulesJson { get; set; }

  /// <summary>
  /// Which College-named instrument the activity type is, as its <c>WbaToolKey</c> (T122). Null means "not a
  /// recognised instrument", which narrows nothing (D21).
  /// </summary>
  /// <remarks>
  /// The type row's CURRENT key, which is the one the write path checks at submit, so the EPA picker offers only
  /// what submitting will accept. Passed on every EPA field; the service reads it only on a narrowed field (the one the
  /// credit engine reads, or an unrated instrument's evidence EPA). It also decides whether an unrated type's evidence
  /// EPA is narrowed at all: only an instrument is held to a list (D21).
  /// </remarks>
  [Parameter] public string? WbaToolKey { get; set; }

  /// <summary>
  /// The field keys this actor may write, as resolved server-side by the field-permission
  /// evaluator (T070). <c>null</c> means "no per-field restriction" and keeps the pre-T070
  /// behaviour exactly: every field follows <see cref="ReadOnly" /> alone. An empty set locks
  /// every field, which is what keeps non-bound users read-only on the detail page.
  /// </summary>
  /// <remarks>
  /// A field the actor may not write has no control (T342, flow 03): among writable fields it is a read-out; a section
  /// with none the actor may write is read-outs when it holds anything, and a locked section when it holds nothing.
  /// </remarks>
  [Parameter] public IReadOnlySet<string>? EditableFieldKeys { get; set; }

  /// <summary>
  /// True when the form renders an activity that exists (T102). Its <c>user</c> fields then offer the people of
  /// <see cref="ActivityInstitutionId" />, the institution stamped on it; on the create page (false) the institution is
  /// resolved from <see cref="SubjectUserId" /> the way the create will stamp it. Either way it is the institution the
  /// write path judges a nominee against.
  /// </summary>
  [Parameter] public bool IsExistingActivity { get; set; }

  /// <summary>The existing activity's stamped institution. Null lists nobody, as the write path accepts nobody.</summary>
  [Parameter] public int? ActivityInstitutionId { get; set; }

  /// <summary>
  /// The activity's data as STORED, on a page showing one that exists; null on the create page and the builder preview.
  /// </summary>
  /// <remarks>
  /// A <c>user</c> field labels only a value stored on the activity (T102). <see cref="DataJson" /> is the working copy,
  /// which a caller can fill with anyone's id by editing the page, and looking that id up would hand back the name and
  /// email of a person the record never named.
  /// </remarks>
  [Parameter] public string? StoredDataJson { get; set; }

  /// <summary>
  /// The South African date this form would be filed on, when what is typed here can still be the filing; null
  /// otherwise (T160, D15).
  /// </summary>
  /// <remarks>
  /// While it is set, the encounter date field (the schema's <c>observation_date_field</c>) warns, without refusing, once
  /// a date more than <see cref="EncounterDatePolicy.LateFilingDays" /> days before it has been entered, or at once when
  /// the form opens with one (T342: File it again, a draft): the lateness the filing's history row will record. The
  /// create page passes today; an activity's page passes today only to its author while it is still in its initial
  /// state; the builder preview passes nothing. A parameter rather than a clock read here, so the page decides whether
  /// this is a filing and a test can fix the day. Whether the type can file late at all is this form's to decide, from
  /// <see cref="CreditRulesJson" />: only a type that can credit records lateness, so only its form warns
  /// (<see cref="FilingLateness.WarnsFor" />).
  /// </remarks>
  [Parameter] public DateOnly? FiledOn { get; set; }

  /// <summary>
  /// The day the subject's programme started, as the write path bounds the encounter date by; null when the page does
  /// not know it (T192).
  /// </summary>
  /// <remarks>
  /// Read only where <see cref="FiledOn" /> is: while the encounter date of a form that may be the filing is typed, on a
  /// type that can credit. There the server refuses a date before this day (<c>EncounterDateGate</c>), whether the date
  /// was just typed or is being handed on unchanged, so the form says so in place of the lateness warning, as a predicted
  /// refusal (C9): the field's validation message and the invalid marks. The page passes what the server reads
  /// (<c>GetProgrammeStartForTraineeQuery</c>, resolved once, as <see cref="FiledOn" /> is), and the server stays the rule.
  /// Null shows no hint and leaves the lateness warning as it was.
  /// </remarks>
  [Parameter] public DateOnly? ProgrammeStartsOn { get; set; }

  /// <summary>
  /// Whether the reader is the activity's subject (T342, C12): the programme hint then says "your programme", and to
  /// anyone else "the trainee's programme", as the server's refusal does (<see cref="ProgrammeStartWording" />).
  /// </summary>
  [Parameter] public bool ReaderIsSubject { get; set; }

  /// <summary>
  /// The fields the server's last refusal of this form named, by schema key (T263): <c>ActivityFieldsRefusedException</c>'s
  /// <c>FieldKeys</c>. Null or empty when nothing was refused.
  /// </summary>
  /// <remarks>
  /// Each is marked as <see cref="PredictsRefusal" /> marks the encounter date, with <c>.input-validation-error</c> and
  /// <c>aria-invalid="true"</c>, shows its own part of <see cref="RefusalMessage" /> under it, and names
  /// <see cref="RefusalId" /> after its help and its message. A field whose value is changed since drops its marks and
  /// its message at once, and the form's hints come back (T342, Spec § 3); a new set from the page marks afresh. A locked
  /// field the refusal names is marked too: which field stopped the move is worth showing to someone who cannot fill it
  /// in. A key this form does not render (hidden by <c>show_if</c>, or not in the schema) marks nothing. A refused
  /// encounter date shows no lateness warning while it is marked: "It can still be filed" beside the refusal would
  /// contradict it (DESIGN.md § Alerts).
  /// </remarks>
  [Parameter] public IReadOnlyCollection<string>? RefusedFieldKeys { get; set; }

  /// <summary>
  /// The refusal <see cref="RefusedFieldKeys" /> came from, as the server words it ("Date observed: The date cannot be
  /// after today (2026-09-29)."), so each refused field shows its own part under its control (T342, C8;
  /// <see cref="FieldRefusals.Split" />). Null marks the fields without a message.
  /// </summary>
  [Parameter] public string? RefusalMessage { get; set; }

  /// <summary>
  /// The id of the summary that shows the refusal <see cref="RefusedFieldKeys" /> came from (<c>refusal-summary</c>).
  /// Each refused control names it with <c>aria-describedby</c>, so the refusal is read with the field and not only
  /// announced once (DESIGN.md § Alerts).
  /// </summary>
  [Parameter] public string? RefusalId { get; set; }

  /// <summary>
  /// The person who fills in a locked section (T342, C14): "Fatima Khumalo fills this in". Null names nobody: "The
  /// assessor you name fills this in" (the hand-off field's label in place of "assessor" where
  /// <see cref="HandOffFieldKey" /> is given).
  /// </summary>
  [Parameter] public string? LockedOwnerName { get; set; }

  /// <summary>
  /// A closed record (declined, cancelled): a locked section then reads "Fatima Khumalo was to fill this in." (C11).
  /// </summary>
  [Parameter] public bool LockedSectionsClosed { get; set; }

  /// <summary>
  /// The entrustment ladder for the read-only rung row, with each rung's descriptor (T342, B12;
  /// <c>IActivityReferenceDataService.GetEntrustmentScaleRungsAsync</c>). Null shows the ladder the scale field's own
  /// options give, without descriptors.
  /// </summary>
  [Parameter] public IReadOnlyList<Wombat.Application.Features.Epas.EntrustmentRung>? Rungs { get; set; }

  /// <summary>
  /// The line a filled section's head carries, by section key: "Filled in by David Naidoo, 2026-09-29" (T342, Spec § 2).
  /// A section with no entry carries none.
  /// </summary>
  [Parameter] public IReadOnlyDictionary<string, string>? SectionAttributions { get; set; }

  /// <summary>
  /// The <c>user</c> field whose person the page's primary move hands the activity to (<c>MoveHandOff</c>), or null. Its
  /// label names the owner of a locked section while nobody is named ("The assessor you name fills this in"), and the
  /// name it holds is reported through <see cref="HandOffNameChanged" />.
  /// </summary>
  [Parameter] public string? HandOffFieldKey { get; set; }

  /// <summary>
  /// The name of the person <see cref="HandOffFieldKey" /> names now, from the picker's own options, whenever it changes
  /// (T342, B2): null while nobody is named, or the one named is no longer on the list. Log an activity puts it on its
  /// button ("Submit to Fatima Khumalo") and its check line without a round trip.
  /// </summary>
  [Parameter] public EventCallback<string?> HandOffNameChanged { get; set; }

  [Parameter] public EventCallback<string> DataJsonChanged { get; set; }

  /// <summary>
  /// The level of each section's heading: 2 on the activity pages, under their h1; the builder's live preview, under its
  /// own h3, passes 4 (T342; the build review's G8).
  /// </summary>
  [Parameter] public int SectionHeadingLevel { get; set; } = 2;

  /// <summary>
  /// The reader has a section to fill (T350; round 1, E3; round 2, E2): each filled read-only section is then also drawn
  /// as the phone's fold, shown below 641 px in place of its card. The activity page passes it for such a reader only;
  /// every other reader, Log an activity and the builder's preview keep the sections as they are.
  /// </summary>
  [Parameter] public bool FoldFilledSections { get; set; }

  // What every id in a fold's copy ends with, so the twin that is away names nothing of the one in view (E2).
  private const string NarrowSuffix = "-narrow";

  private FormSchema? _schema;
  private JsonObject _data = [];
  private string? _loadError;
  private string? _loadedOptionsKey;

  // Schema field keys whose EPA picker is narrowed to what the write path accepts: the fields the pinned credit rules
  // read as the EPA to credit, or a College instrument's evidence EPA when it credits nothing (T154). Empty for a type
  // that is no instrument and credits nothing, and for one that credits a fixed curriculum item.
  private IReadOnlySet<string> _narrowedEpaFieldKeys = new HashSet<string>(StringComparer.Ordinal);

  // Whether the pinned credit rules can credit, so a filing of this form can be late (T160) and its encounter date is held
  // to the programme start (T192). Asked once per load, with the rules, rather than on every render of every field.
  private bool _canCredit;

  // Whether an encounter date has been entered here, or the form opened with one: its notices wait for it (Spec § 1).
  private bool _dateEntered;
  private bool _openedWithData;

  // The refusal as last given, and the fields changed since: a changed field drops its marks at once (Spec § 3).
  private IReadOnlyCollection<string>? _refusedFor;
  private string? _refusalMessageFor;
  private readonly HashSet<string> _changedSinceRefusal = new(StringComparer.Ordinal);
  private IReadOnlyDictionary<string, RefusalLine> _refusalLines = new Dictionary<string, RefusalLine>(StringComparer.Ordinal);

  // What HandOffNameChanged last said, so it speaks only on a change.
  private string? _reportedHandOffName;
  private bool _handOffReported;

  private readonly Dictionary<string, IReadOnlyList<ActivityCatalogueOption>> _catalogueOptionsByField = [];

  // Which load owns the option lists. A newer load supersedes an older one still awaiting its queries.
  private int _loadVersion;

  private enum SectionKind
  {
    Open,
    Filled,
    Locked
  }

  private sealed record VisibleSection(FormSection Section, IReadOnlyList<Wombat.Domain.Activities.Schema.FormField> Fields, SectionKind Kind);

  protected override async Task OnParametersSetAsync()
  {
    try
    {
      _data = JsonNode.Parse(string.IsNullOrWhiteSpace(DataJson) ? "{}" : DataJson)?.AsObject() ?? [];

      // Schema parsing and reference-option loading depend only on the schema, not the data.
      // Reloading them on every value change would re-query the DB on each edit and can trigger
      // concurrent DbContext use when edits arrive in quick succession. Claim the schema before the
      // await so a re-entrant OnParametersSetAsync (fired by a rapid edit) skips the reload.
      // The reload key is the schema PLUS everything else the option lists now depend on. Keying it
      // on the schema alone would serve one subject's creditable EPAs to the next (T108), and leaving
      // the tool out would serve one instrument's permitted EPAs to another with the same form (T122).
      // T102 adds the nominee scope, and which fields are locked: a locked user field loads only its stored person's
      // label, so a field that becomes editable must reload to get its list.
      var optionsKey = string.Join(
        '\u001f',
        SchemaJson,
        SubjectUserId ?? string.Empty,
        CreditRulesJson ?? string.Empty,
        WbaToolKey ?? string.Empty,
        IsExistingActivity ? "existing" : "new",
        ActivityInstitutionId?.ToString(CultureInfo.InvariantCulture) ?? string.Empty,
        ReadOnly ? "read-only" : "writable",
        EditableFieldKeys is null ? "*" : string.Join(',', EditableFieldKeys.Order(StringComparer.Ordinal)),
        StoredDataJson ?? string.Empty);
      if (!string.Equals(_loadedOptionsKey, optionsKey, StringComparison.Ordinal))
      {
        _schema = FormSchemaParser.Parse(SchemaJson);
        _loadedOptionsKey = optionsKey;
        _narrowedEpaFieldKeys = ResolveNarrowedEpaFieldKeys(_schema);
        _canCredit = FilingLateness.WarnsFor(CreditRulesJson);
        if (!_openedWithData)
        {
          // A form that opens with an encounter date shows its notices at once (File it again, a draft).
          _openedWithData = true;
          _dateEntered = _schema.ObservationDateField is { } dateKey && !string.IsNullOrWhiteSpace(GetString(dateKey));
        }

        await LoadOptionsAsync();
      }

      TakeRefusal();
      _loadError = null;
    }
    catch (Exception exception)
    {
      _loadError = exception.Message;
      _schema = null;
      _data = [];
      _catalogueOptionsByField.Clear();
      _narrowedEpaFieldKeys = new HashSet<string>(StringComparer.Ordinal);
      _canCredit = false;
      _loadedOptionsKey = null;
    }

    await ReportHandOffNameAsync();
  }

  // A new refusal from the page marks its fields afresh, and splits its words one field a line.
  private void TakeRefusal()
  {
    if (ReferenceEquals(_refusedFor, RefusedFieldKeys) &&
        string.Equals(_refusalMessageFor, RefusalMessage, StringComparison.Ordinal))
    {
      return;
    }

    _refusedFor = RefusedFieldKeys;
    _refusalMessageFor = RefusalMessage;
    _changedSinceRefusal.Clear();
    _refusalLines = FieldRefusals.Split(RefusalMessage, RefusedFieldKeys, LabelOf)
      .Where(line => line.FieldKey is not null)
      .GroupBy(line => line.FieldKey!, StringComparer.Ordinal)
      .ToDictionary(group => group.Key, group => group.First(), StringComparer.Ordinal);
  }

  private string? LabelOf(string key)
    => _schema?.Sections.SelectMany(section => section.Fields)
      .FirstOrDefault(field => string.Equals(field.Key, key, StringComparison.Ordinal))?.Label;

  /// <summary>
  /// A field is locked when the whole form is read-only, or when a writable set was supplied and
  /// does not name it. A locked field has no control (T342), and the guards in <see cref="UpdateValue" /> and
  /// <see cref="ToggleMultiChoice" /> call this too, so a forged event on a locked field changes nothing.
  /// </summary>
  private bool IsFieldLocked(string key)
    => ReadOnly || (EditableFieldKeys is not null && !EditableFieldKeys.Contains(key));

  /// <summary>
  /// The field types rendered as exactly one control whose id is <see cref="ActivityFieldIds.Input" />, which the
  /// <c>&lt;label for&gt;</c> names. Every other type renders as a fieldset named by its legend (T177). The list and the
  /// markup's switch must agree both ways. A type listed here with no case leaves a label naming nothing, and a type with
  /// a case left off the list shows "Unsupported field type" in its place. <c>ActivityFormLabelTests</c> renders every
  /// <see cref="FieldType" /> and pins which ones are groups, so either drift fails it.
  /// </summary>
  private static bool IsSingleControl(FieldType type)
    => type is FieldType.Text or FieldType.Signature or FieldType.ProcedureRef
      or FieldType.LongText
      or FieldType.Number or FieldType.Likert or FieldType.Rating
      or FieldType.Date
      or FieldType.Choice or FieldType.Epa or FieldType.User
      or FieldType.Scale;

  // The fields that take the grid's whole row: running text and the EPA, whose options are long (the boards).
  private static bool IsWide(FieldType type)
    => type is FieldType.Text or FieldType.Signature or FieldType.ProcedureRef or FieldType.LongText or FieldType.Epa
      or FieldType.MultiChoice;

  /// <summary>
  /// The schema's sections the reader sees, in the schema's order, each with its visible fields and what it is to the
  /// reader: open (they may write a field of it), filled (they may write none, and it holds a value) or locked (they may
  /// write none, and it holds nothing yet).
  /// </summary>
  private IEnumerable<VisibleSection> VisibleSections()
  {
    foreach (var section in _schema!.Sections)
    {
      if (!IsVisible(section.ShowIf))
      {
        continue;
      }

      var fields = section.Fields.Where(field => IsVisible(field.ShowIf)).ToList();
      var kind = fields.Any(field => !IsFieldLocked(field.Key))
        ? SectionKind.Open
        : fields.Any(HasValue)
          ? SectionKind.Filled
          : SectionKind.Locked;
      yield return new VisibleSection(section, fields, kind);
    }
  }

  private bool HasValue(Wombat.Domain.Activities.Schema.FormField field)
    => field.Type == FieldType.MultiChoice
      ? GetMultiChoiceValues(field.Key).Count > 0
      : !string.IsNullOrWhiteSpace(GetString(field.Key));

  /// <summary>
  /// The owner line of a section nobody has filled in yet (C11, C14), from the section's own <c>editable_by</c>, which
  /// falls back to <c>subject|creator</c> as <c>FieldPermissionEvaluator</c> reads it (T342; the build review's G2):
  /// <list type="bullet">
  ///   <item>the author's own section: no owner line (the body says "Not filled in.");</item>
  ///   <item>a <c>field:</c> owner: the person the field names ("Fatima Khumalo fills this in"), or, while nobody is named,
  ///   the field by its label ("The assessor you name fills this in");</item>
  ///   <item>a <c>role:</c> owner: the role by its label ("A coordinator fills this in"), since nobody is named.</item>
  /// </list>
  /// A closed record says who was to ("... was to fill this in.").
  /// </summary>
  private string? LockedOwnerLine(FormSection section)
  {
    var owner = OwnerOf(section);
    switch (owner.Kind)
    {
      case SectionOwnerKind.Field:
      {
        var name = FieldOwnerName(owner.Key!);
        var who = name ?? $"The {FieldNoun(owner.Key!)}";
        return LockedSectionsClosed
          ? $"{who} was to fill this in."
          : name is null ? $"{who} you name fills this in" : $"{who} fills this in";
      }

      case SectionOwnerKind.Role:
      {
        var role = ActivityPageModel.Article(WombatRoleLabels.For(owner.Key!).ToLowerInvariant());
        var who = char.ToUpperInvariant(role[0]) + role[1..];
        return LockedSectionsClosed ? $"{who} was to fill this in." : $"{who} fills this in";
      }

      default:
        return null;
    }
  }

  private static readonly ActorRule AuthorRule = ActorRuleParser.Parse("subject|creator");

  private enum SectionOwnerKind
  {
    Author,
    Field,
    Role
  }

  private readonly record struct SectionOwner(SectionOwnerKind Kind, string? Key);

  // Who a section's rule names, for its owner line: a field's person first, then a role, else its author. A rule that
  // names the author among others (subject|field:assessor_user_id) is owned by the other: the line is for a section its
  // reader cannot fill in.
  private static SectionOwner OwnerOf(FormSection section) => OwnerOf(section.EditableBy ?? AuthorRule);

  private static SectionOwner OwnerOf(ActorRule rule)
  {
    var terms = Terms(rule).ToList();
    if (terms.OfType<FieldUserActorRule>().FirstOrDefault() is { } field)
    {
      return new SectionOwner(SectionOwnerKind.Field, field.Field);
    }

    return terms.OfType<NamedRoleActorRule>().FirstOrDefault() is { } role
      ? new SectionOwner(SectionOwnerKind.Role, role.Role)
      : new SectionOwner(SectionOwnerKind.Author, null);
  }

  private static IEnumerable<ActorRule> Terms(ActorRule rule)
    => rule is CombinedActorRule combined ? combined.Rules.SelectMany(Terms) : [rule];

  // The person a field names: the page's name for its hand-off field (the one it resolved, and knows is still offered,
  // D1), else the field's own option for the value it holds; null while nobody on the list is named.
  private string? FieldOwnerName(string fieldKey)
  {
    var isHandOff = HandOffFieldKey is null || string.Equals(HandOffFieldKey, fieldKey, StringComparison.Ordinal);
    if (isHandOff && !string.IsNullOrWhiteSpace(LockedOwnerName))
    {
      return LockedOwnerName;
    }

    if (HandOffFieldKey is not null && isHandOff)
    {
      return null;
    }

    var field = _schema?.Sections.SelectMany(section => section.Fields)
      .FirstOrDefault(candidate => string.Equals(candidate.Key, fieldKey, StringComparison.Ordinal));
    return field is null ? null : NomineeNames.NameOf(GetString(fieldKey), GetOptions(field));
  }

  private string FieldNoun(string fieldKey)
    => LabelOf(fieldKey) is { Length: > 0 } label ? label.Trim().ToLowerInvariant() : FilingWords.DefaultNoun;

  // A section's heading, at the level the host gives: h2 on the activity pages, lower under the builder's own headings
  // (T342; the build review's G8).
  private RenderFragment SectionHeading(string id, string title) => __builder =>
  {
    __builder.OpenElement(0, $"h{Math.Clamp(SectionHeadingLevel, 2, 6)}");
    __builder.AddAttribute(1, "id", id);
    __builder.AddContent(2, title);
    __builder.CloseElement();
  };

  /// <summary>
  /// A read-out's value, as the reader sees it: an option's label, never the id it stores (T191, T199). The fold's copy
  /// passes <see cref="NarrowSuffix" />, so its refusal line's id is its own (T350, E2).
  /// </summary>
  private RenderFragment ReadoutValue(Wombat.Domain.Activities.Schema.FormField field, string idSuffix) => __builder =>
  {
    if (field.Type == FieldType.Scale && HasValue(field) && RungsFor(field) is { Count: > 0 } rungs)
    {
      <dd><RungRow Label="@field.Label" Rungs="rungs" Value="@GetString(field.Key)" /></dd>
    }
    else if (ReadoutText(field) is { Length: > 0 } text)
    {
      <dd class="form-readout-value">@text</dd>
    }
    else
    {
      <dd class="text-muted">Not filled in.</dd>
    }

    // A read-out has no control to mark, so a refusal that named it is said under its value (T263: which field stopped
    // the move is worth showing to someone who cannot fill it in): its own words when the page gave them, or a pointer
    // to the refusal that did.
    if (IsRefused(field.Key))
    {
      <dd id="@(ActivityFieldIds.Message(field.Key) + idSuffix)" class="validation-message">@(FieldMessageFor(field.Key) ?? "Named in the refusal above.")</dd>
    }
  };

  private string ReadoutText(Wombat.Domain.Activities.Schema.FormField field)
  {
    if (field.Type == FieldType.MultiChoice)
    {
      var options = GetOptions(field);
      return string.Join(", ", GetMultiChoiceValues(field.Key).Select(value =>
        options.FirstOrDefault(option => string.Equals(option.Value, value, StringComparison.Ordinal))?.Label ?? value));
    }

    // A person is read out as the record names them: the stored value where the page gave one, never a working copy it
    // could not have changed (T102: only a stored id is ever looked up).
    var stored = field.Type == FieldType.User && StoredDataJson is not null
      ? StoredValueOf(field.Key) ?? string.Empty
      : GetString(field.Key);
    if (string.IsNullOrWhiteSpace(stored))
    {
      return string.Empty;
    }

    if (field.Type is FieldType.Choice or FieldType.Epa or FieldType.User or FieldType.Scale ||
        !string.IsNullOrWhiteSpace(field.CatalogueKey))
    {
      var label = GetOptions(field).FirstOrDefault(option => string.Equals(option.Value, stored, StringComparison.Ordinal))?.Label;
      if (field.Type == FieldType.User)
      {
        // A person is read by name, not the directory's "Fatima Khumalo (fatima@kgk)" (T350, note 15; round 1, E4): the
        // address tells two people apart while picking, and is not what a reader of who was named needs.
        return label is null ? "Unknown person" : NomineeNames.NameOfLabel(label);
      }

      return label ?? stored;
    }

    return stored;
  }

  /// <summary>The label of the option chosen in a select, for the read-back under it (T323).</summary>
  private string? ChosenLabel(Wombat.Domain.Activities.Schema.FormField field)
  {
    var value = GetString(field.Key);
    return string.IsNullOrEmpty(value)
      ? null
      : GetOptions(field).FirstOrDefault(option => string.Equals(option.Value, value, StringComparison.Ordinal))?.Label;
  }

  /// <summary>
  /// Whether the field is chosen on the rung picker (T350; Q5; round 2, E3): the schema's rated level field, which the
  /// reader may write, when the page's ladder for it loaded. Any other scale field, or a ladder that failed, keeps the
  /// select. The builder's preview and Log an activity pass no ladder, so they keep it too.
  /// </summary>
  private bool UsesRungPicker(Wombat.Domain.Activities.Schema.FormField field)
    => field.Type == FieldType.Scale &&
       Rungs is { Count: > 0 } &&
       !IsFieldLocked(field.Key) &&
       string.Equals(_schema?.RatedLevelField, field.Key, StringComparison.Ordinal);

  /// <summary>
  /// The scale field's ladder: the page's rungs, with descriptors, for the rated field and any field on the rated field's
  /// scale (the page reads the rated field's ladder alone; the build review's G5); else the field's own options.
  /// </summary>
  private IReadOnlyList<Wombat.Application.Features.Epas.EntrustmentRung> RungsFor(Wombat.Domain.Activities.Schema.FormField field)
  {
    if (Rungs is { Count: > 0 } && IsOnTheRatedScale(field))
    {
      return Rungs;
    }

    return GetOptions(field)
      .Select(option => int.TryParse(option.Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var order)
        ? new Wombat.Application.Features.Epas.EntrustmentRung(order, option.Label, null)
        : null)
      .OfType<Wombat.Application.Features.Epas.EntrustmentRung>()
      .ToList();
  }

  private bool IsOnTheRatedScale(Wombat.Domain.Activities.Schema.FormField field)
  {
    if (_schema?.RatedLevelField is not { } ratedKey)
    {
      return false;
    }

    if (string.Equals(field.Key, ratedKey, StringComparison.Ordinal))
    {
      return true;
    }

    var ratedScale = _schema.Sections.SelectMany(section => section.Fields)
      .FirstOrDefault(candidate => string.Equals(candidate.Key, ratedKey, StringComparison.Ordinal))?.ScaleKey;
    return !string.IsNullOrWhiteSpace(ratedScale) && string.Equals(field.ScaleKey, ratedScale, StringComparison.Ordinal);
  }

  /// <summary>
  /// Whether this field is the encounter date of a form that may be the filing, of a type that can credit, and the actor
  /// can type in it (T160), so it carries a notice of whether the date can be filed as typed. A type that credits nothing
  /// records no lateness and is not held to the programme start, so warning that its filing "is recorded as late", or
  /// that its date will not be accepted, would be untrue. A locked date is not being typed, and on this page nobody could
  /// act on the notice.
  /// </summary>
  private bool NoticesFilingDate(string key)
    => FiledOn is not null &&
       _canCredit &&
       _schema is not null &&
       string.Equals(_schema.ObservationDateField, key, StringComparison.Ordinal) &&
       !IsFieldLocked(key);

  /// <summary>
  /// <see cref="ProgrammeStartsOn" /> when the typed encounter date is before it, which the server refuses (T192);
  /// otherwise null. Asked first, so a date before the programme is never also called late: the lateness warning says it
  /// "can still be filed", and it cannot.
  /// </summary>
  private DateOnly? BeforeProgrammeStart(string key)
    => ProgrammeStartsOn is DateOnly startedOn &&
       DateOnly.TryParse(GetString(key), CultureInfo.InvariantCulture, DateTimeStyles.None, out var encounteredOn) &&
       encounteredOn < startedOn
      ? startedOn
      : null;

  /// <summary>
  /// Whether the field shows the programme-start hint, a refusal the server will confirm (C9): the input is then marked
  /// invalid (<c>aria-invalid</c>, <c>.input-validation-error</c>) as well as described by the hint, so a screen reader
  /// hears that the value is wrong and not only that there is a note beside it.
  /// </summary>
  private bool PredictsRefusal(string key) => NoticesFilingDate(key) && _dateEntered && BeforeProgrammeStart(key) is not null;

  /// <summary>Whether the server's last refusal of this form named the field, and it has not been changed since (T263).</summary>
  private bool IsRefused(string key) => RefusedFieldKeys?.Contains(key) == true && !_changedSinceRefusal.Contains(key);

  /// <summary>The field's own part of the refusal, shown under its control, while it is marked.</summary>
  private string? FieldMessageFor(string key)
    => IsRefused(key) && _refusalLines.TryGetValue(key, out var line) ? line.FieldMessage : null;

  // A locked section's line for a field the refusal named, with its label, since the field has no control to sit under.
  private string RefusalLineFor(Wombat.Domain.Activities.Schema.FormField field)
    => _refusalLines.TryGetValue(field.Key, out var line) ? line.Text : field.Label;

  /// <summary>
  /// Whether the control is marked invalid: the page predicts the server will refuse what is typed (T192), or the server
  /// has refused it (T263). One marking for both, so a date that is both is marked once.
  /// </summary>
  private bool IsMarkedInvalid(string key) => PredictsRefusal(key) || IsRefused(key);

  /// <summary>The control's class, with <c>.input-validation-error</c> while it is marked invalid (DESIGN.md § Form system).</summary>
  private string ControlClass(string baseClass, string key)
    => IsMarkedInvalid(key) ? $"{baseClass} input-validation-error" : baseClass;

  /// <summary><c>aria-invalid</c> while the control is marked invalid; left off otherwise, never "false".</summary>
  private string? AriaInvalid(string key) => IsMarkedInvalid(key) ? "true" : null;

  /// <summary><c>aria-required</c> on a required field's control, which the visible mark is hidden from (T342).</summary>
  private static string? AriaRequired(Wombat.Domain.Activities.Schema.FormField field) => field.Required ? "true" : null;

  /// <summary>The refusal summary's id, for a field it named; null for any other field, or when the page gave no id.</summary>
  private string? RefusalIdFor(string key)
    => IsRefused(key) && !string.IsNullOrWhiteSpace(RefusalId) ? RefusalId : null;

  /// <summary>
  /// What a field's control names with <c>aria-describedby</c> (T193): its help text, then its own refusal message while
  /// it has one (T342, Spec § 1), then the filing-date notice's live region while the field has one (T160, T192), then
  /// the summary of a refusal that named the field (T263). Null when none is there, so no control names an element that
  /// does not exist.
  /// </summary>
  private string? DescribedBy(Wombat.Domain.Activities.Schema.FormField field)
    => FieldHelp.DescribedBy(
      field.Key,
      field.HelpText,
      FieldMessageFor(field.Key) is null ? null : ActivityFieldIds.Message(field.Key),
      NoticesFilingDate(field.Key) ? ActivityFieldIds.FilingNotice(field.Key) : null,
      RefusalIdFor(field.Key));

  /// <summary>
  /// How many days before <see cref="FiledOn" /> the typed encounter date is, when that makes the filing late (T160, D15);
  /// otherwise null. The same policy the server applies to the filing's history row (<see cref="EncounterDatePolicy" />).
  /// A date after the filing day is the server's to refuse, not a late filing.
  /// </summary>
  private int? LateFilingDaysAfter(string key)
  {
    if (FiledOn is not DateOnly filedOn ||
        !DateOnly.TryParse(GetString(key), CultureInfo.InvariantCulture, DateTimeStyles.None, out var encounteredOn))
    {
      return null;
    }

    var days = EncounterDatePolicy.DaysAfterEncounter(encounteredOn, filedOn);
    return EncounterDatePolicy.IsLateFiling(days) ? days : null;
  }

  private string GetString(string key)
  {
    if (!_data.TryGetPropertyValue(key, out var value) || value is null)
    {
      return string.Empty;
    }

    return value switch
    {
      JsonValue jsonValue => jsonValue.TryGetValue<string>(out var stringValue) ? stringValue ?? string.Empty : jsonValue.ToJsonString(),
      JsonArray jsonArray => string.Join(", ", jsonArray.Select(item => item?.GetValue<string>() ?? string.Empty)),
      _ => value.ToJsonString()
    };
  }

  private IReadOnlyList<string> GetMultiChoiceValues(string key)
  {
    if (!_data.TryGetPropertyValue(key, out var value) || value is not JsonArray array)
    {
      return [];
    }

    return array.Select(item => item?.GetValue<string>() ?? string.Empty)
      .Where(item => !string.IsNullOrWhiteSpace(item))
      .ToArray();
  }

  private IReadOnlyList<ActivityCatalogueOption> GetOptions(Wombat.Domain.Activities.Schema.FormField field)
  {
    // A user field's people and an EPA field's EPAs come from the server's own lists, which are what the write path
    // checks against, never from inline options a schema might carry (T102, T122): those would offer values that
    // submitting refuses, and hide the stored-value fallback.
    if (field.Type is FieldType.User or FieldType.Epa)
    {
      var loaded = _catalogueOptionsByField.TryGetValue(field.Key, out var directoryOptions);
      IReadOnlyList<ActivityCatalogueOption> listed = loaded ? directoryOptions! : [];

      // A person picked on this page but not on the list (refused, then the list reloaded without them) is still what
      // the next action would send, so the select must show it, and choosing "Select…" must be a real change. Labelled
      // here, never looked up: the working copy may hold anyone's id (T102). Only once the list has loaded: before
      // that, "not listed" means "not known yet", and a valid stored nominee would read as unavailable.
      var working = GetString(field.Key);
      if (field.Type == FieldType.User &&
          loaded &&
          !IsFieldLocked(field.Key) &&
          !string.IsNullOrEmpty(working) &&
          !listed.Any(option => string.Equals(option.Value, working, StringComparison.Ordinal)))
      {
        return [.. listed, new ActivityCatalogueOption(working, NomineeNames.NotAvailableLabel)];
      }

      return listed;
    }

    // The value is what the control posts and the activity stores; the label is what the reader sees. A schema's key
    // (`admission_notes`) is never shown as though it were words (T191).
    if (field.Options.Count > 0)
    {
      return field.Options
        .Select(option => new ActivityCatalogueOption(option.Value, option.Label))
        .ToArray();
    }

    return _catalogueOptionsByField.TryGetValue(field.Key, out var options)
      ? options
      : [];
  }

  private bool IsVisible(VisibilityCondition? condition)
  {
    if (condition is null)
    {
      return true;
    }

    var value = GetString(condition.Field);
    var hasValue = !string.IsNullOrWhiteSpace(value);
    var target = condition.Value ?? string.Empty;

    return condition.Operator switch
    {
      "equals" => string.Equals(value, target, StringComparison.Ordinal),
      "not equals" or "not_equals" => !string.Equals(value, target, StringComparison.Ordinal),
      "is set" or "is_set" => hasValue,
      "is not set" or "is_not_set" => !hasValue,
      "greater than" or "greater_than" => CompareNumeric(value, target) > 0,
      "less than" or "less_than" => CompareNumeric(value, target) < 0,
      _ => true
    };
  }

  // A date is entered on change; the encounter date's notices show from then on (Spec § 1).
  private async Task ChangeDate(string key, string? value)
  {
    if (_schema is not null && string.Equals(_schema.ObservationDateField, key, StringComparison.Ordinal))
    {
      _dateEntered = true;
    }

    await UpdateValue(key, value);
  }

  // Internal, with ToggleMultiChoice, so a test can send the forged event no locked field renders a control for (G9).
  internal async Task UpdateValue(string key, string? value)
  {
    if (IsFieldLocked(key))
    {
      return;
    }

    if (string.IsNullOrWhiteSpace(value))
    {
      _data.Remove(key);
    }
    else
    {
      _data[key] = value;
    }

    _changedSinceRefusal.Add(key);
    await DataJsonChanged.InvokeAsync(_data.ToJsonString());
    await ReportHandOffNameAsync();
  }

  internal async Task ToggleMultiChoice(string key, string option, bool selected)
  {
    if (IsFieldLocked(key))
    {
      return;
    }

    var values = GetMultiChoiceValues(key).ToHashSet(StringComparer.Ordinal);
    if (selected)
    {
      values.Add(option);
    }
    else
    {
      values.Remove(option);
    }

    _data[key] = new JsonArray(values.Select(value => JsonValue.Create(value)).ToArray());
    _changedSinceRefusal.Add(key);
    await DataJsonChanged.InvokeAsync(_data.ToJsonString());
  }

  // Tells the page whom the hand-off field names now, once and on each change (T342, B2).
  private async Task ReportHandOffNameAsync()
  {
    if (!HandOffNameChanged.HasDelegate || _schema is null)
    {
      return;
    }

    var field = HandOffFieldKey is null
      ? null
      : _schema.Sections.SelectMany(section => section.Fields)
        .FirstOrDefault(candidate => string.Equals(candidate.Key, HandOffFieldKey, StringComparison.Ordinal));
    var name = field is null ? null : NomineeNames.NameOf(GetString(field.Key), GetOptions(field));

    if (_handOffReported && string.Equals(name, _reportedHandOffName, StringComparison.Ordinal))
    {
      return;
    }

    _handOffReported = true;
    _reportedHandOffName = name;
    await HandOffNameChanged.InvokeAsync(name);
  }

  private async Task LoadOptionsAsync()
  {
    var version = ++_loadVersion;

    if (_schema is null)
    {
      _catalogueOptionsByField.Clear();
      return;
    }

    var schema = _schema;
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    var principal = authState.User;

    // Each load gets its own scope, and so its own DbContext (T102). The circuit's context is shared by everything on
    // the page, and a keyed remount after a refused action can start a load while another instance's is still awaiting;
    // two queries on one context throw. Results are swapped in only if no newer load has started meanwhile.
    await using var scope = ScopeFactory.CreateAsyncScope();
    var referenceData = scope.ServiceProvider.GetRequiredService<IActivityReferenceDataService>();

    var loaded = new Dictionary<string, IReadOnlyList<ActivityCatalogueOption>>(StringComparer.Ordinal);
    foreach (var field in schema.Sections.SelectMany(section => section.Fields))
    {
      IReadOnlyList<ActivityCatalogueOption>? options = field.Type switch
      {
        FieldType.Epa => await referenceData.GetEpaOptionsAsync(
          principal,
          new EpaOptionScope(
            SubjectUserId,
            _narrowedEpaFieldKeys.Contains(field.Key),
            GetString(field.Key),
            WbaToolKey)),
        FieldType.User => await LoadNomineeOptionsAsync(referenceData, schema, field),
        FieldType.Scale => await referenceData.GetEntrustmentScaleLevelOptionsAsync(field.ScaleKey),
        _ when !string.IsNullOrWhiteSpace(field.CatalogueKey)
          => await referenceData.GetCatalogueOptionsAsync(field.CatalogueKey),
        _ => null
      };

      if (options is not null)
      {
        loaded[field.Key] = options;
      }
    }

    if (version != _loadVersion)
    {
      return;
    }

    _catalogueOptionsByField.Clear();
    foreach (var (key, options) in loaded)
    {
      _catalogueOptionsByField[key] = options;
    }
  }

  /// <summary>
  /// A <c>user</c> field's options (T102): the nominee directory's list when the field can be written, and only the
  /// stored person when it cannot. A reader is shown who was named, never everyone who could have been. Only a value
  /// stored on the activity is ever looked up; see <see cref="StoredDataJson" />.
  /// </summary>
  private async Task<IReadOnlyList<ActivityCatalogueOption>> LoadNomineeOptionsAsync(
    IActivityReferenceDataService referenceData,
    FormSchema schema,
    Wombat.Domain.Activities.Schema.FormField field)
  {
    var stored = StoredValueOf(field.Key);

    if (IsFieldLocked(field.Key))
    {
      if (stored is null)
      {
        return [];
      }

      var option = await referenceData.GetUserOptionAsync(stored);
      return [option ?? new ActivityCatalogueOption(stored, "Unknown person")];
    }

    return await referenceData.GetNomineeOptionsAsync(new NomineeOptionScope(
      SubjectUserId,
      ActorFieldRules.RequiredRolesForUserField(schema, field.Key),
      IsExistingActivity,
      ActivityInstitutionId,
      stored));
  }

  /// <summary>The field's value as stored on the activity, or null. A JSON string only, as the actor grammar reads it.</summary>
  private string? StoredValueOf(string key)
  {
    if (string.IsNullOrWhiteSpace(StoredDataJson))
    {
      return null;
    }

    try
    {
      var stored = JsonNode.Parse(StoredDataJson) as JsonObject;
      return stored is not null &&
             stored.TryGetPropertyValue(key, out var value) &&
             value is JsonValue jsonValue &&
             jsonValue.TryGetValue<string>(out var text) &&
             !string.IsNullOrEmpty(text)
        ? text
        : null;
    }
    catch (JsonException)
    {
      return null;
    }
  }

  /// <summary>
  /// Which schema field keys the credit rules name as the EPA to credit, or, for a College instrument that credits
  /// nothing, the schema's evidence EPA (T154): the targets the write path's tool gate judges.
  /// </summary>
  /// <remarks>
  /// Only <c>curriculum_item_match.epa_field</c> counts among the credit rules. A directive matching a fixed
  /// <c>curriculum_item_id</c> never reads an EPA, and one matching a <c>curriculum_item_field</c> reads
  /// its epa field only as a fallback when the item field holds no id, so an epa field alongside either is
  /// left un-narrowed: narrowing it would usually hide choices that change nothing. The write path's tool
  /// gate follows the engine exactly and is the authority in that fallback case (T122). Unparseable rules
  /// are not this method's error to surface — fall back to no narrowing.
  /// </remarks>
  private IReadOnlySet<string> ResolveNarrowedEpaFieldKeys(FormSchema schema)
    => CreditRuleFields.ResolveNarrowedEpaFieldKeys(CreditRulesJson, schema.EvidenceEpaField, WbaToolKey);

  private static int CompareNumeric(string left, string right)
  {
    if (!decimal.TryParse(left, NumberStyles.Number, CultureInfo.InvariantCulture, out var leftValue) ||
        !decimal.TryParse(right, NumberStyles.Number, CultureInfo.InvariantCulture, out var rightValue))
    {
      return 0;
    }

    return leftValue.CompareTo(rightValue);
  }
}

@using Wombat.Application.Features.Curricula.Quota
@*
  One EPA's rating trajectory, in its new form (T355, flow 05; Q5, E1, E2, R4; notes 10, 11, 13; R3-C-Trajectory). The one
  rendering of GetEpaTrajectoryForTraineeQuery's EpaTrajectoryDto, for the trainee's EPA page and the committee's review
  page alike, so the chart is drawn and said one way on both.

  - A card, id "trajectory-<EpaId>" (the committee's standing panel links an EPA's name to its heading, R4), headed at the level
    its page gives (h2 on the EPA page, one below the section's on the committee page, note 10), the summary under it in
    TrajectoryWords' words, then the key.
  - Two drawings in the markup, 900px and 326px, never scaled (Q5): a container query on .trajectory-figure, the card's
    width and not the viewport, shows one (E1). The figure is a named, focusable scroll region, the floor for a card
    narrower than 326px (the committee's nested card at 390).
  - The table, always visible, says everything the drawing does: each rating, oldest first, its encounter as the row's
    header (note 11), its rating, how it stood against the minimum of the training year it was observed in (computed live
    with the comparer credit uses, E2), its activity linked by the name My activities gives it, and its assessor. The SVG
    is named for what it adds to the table.
  - Multi-source feedback is never plotted (D8, D36): where the page has MSF beside the EPA it says so under the table.
*@
<section class="detail-card trajectory-card" id="@CardId" aria-labelledby="@HeadingId">
  <div class="trajectory-head">
    @Heading
    @if (Trajectory.Points.Count > 0)
    {
      <p>@TrajectoryWords.Summary(Trajectory, ReviewWindow, SubjectName)</p>
    }
  </div>

  @if (Trajectory.Points.Count == 0)
  {
    <p class="card-empty">@TrajectoryWords.NoRating</p>
  }
  else
  {
    <ul class="trajectory-key" aria-label="@TrajectoryWords.Key">
      @if (TrajectoryWords.KeyBelow(Trajectory) is { } below)
      {
        <li><span class="trajectory-key-swatch trajectory-key-swatch--below" aria-hidden="true"></span>@below</li>
      }
      @if (TrajectoryWords.KeyExit(Trajectory) is { } exit)
      {
        <li><span class="trajectory-key-swatch trajectory-key-swatch--exit" aria-hidden="true"></span>@exit</li>
      }
      <li><span class="trajectory-key-swatch trajectory-key-swatch--dot" aria-hidden="true"></span>@TrajectoryWords.KeyRating</li>
      @if (HasOtherScale)
      {
        <li><span class="trajectory-key-swatch trajectory-key-swatch--hollow" aria-hidden="true"></span>@TrajectoryWords.KeyOtherScale</li>
      }
    </ul>

    <div class="trajectory-figure" role="region" aria-label="@TrajectoryWords.RegionName(Trajectory.EpaCode)" tabindex="0">
      @Drawing(_wide, "trajectory-chart--wide")
      @Drawing(_narrow, "trajectory-chart--narrow")
    </div>

    <div class="table-container">
      <table class="clinic-table clinic-table--stack trajectory-table" role="table">
        <caption>The ratings, oldest first</caption>
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col" role="columnheader">Encounter</th>
            <th scope="col" role="columnheader">Rating</th>
            <th scope="col" role="columnheader">Against the minimum then</th>
            <th scope="col" role="columnheader">Activity</th>
            <th scope="col" role="columnheader">Assessor</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          @foreach (var point in OldestFirst)
          {
            <tr role="row">
              <th scope="row" role="rowheader">@EncounterDate.Label(point.ObservedOn, point.ObservedOnDeclared)</th>
              <td role="cell" data-label="Rating">@TrajectoryWords.RatingCell(point)</td>
              <td role="cell" data-label="Against the minimum then">@TrajectoryWords.AgainstMinimum(point)</td>
              <td role="cell"><a class="activity-link activity-block-link" href="/activities/@point.ActivityId">@ActivityNameOf(point)</a></td>
              <td role="cell" data-label="Assessor">@AssessorOf(point)</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }

  @if (MsfBeside)
  {
    <p class="trajectory-msf">@TrajectoryWords.NotPlotted</p>
  }
</section>

@code {
  private TrajectoryDrawing _wide = default!;
  private TrajectoryDrawing _narrow = default!;

  /// <summary>One EPA's ratings, with the window they were read over and the minimum's steps (T355, C10).</summary>
  [Parameter, EditorRequired] public EpaTrajectoryDto Trajectory { get; set; } = default!;

  /// <summary>The heading's level (note 10): 2 on the EPA page; one below its section's on the committee page.</summary>
  [Parameter] public int HeadingLevel { get; set; } = 2;

  /// <summary>
  /// The heading's words, "Rating trajectory" on the EPA page (whose h1 already names the EPA), with "(no longer in use)"
  /// after it for a paused EPA (C5). Null names the EPA itself, "Code — Title", as the committee page lists one per EPA.
  /// </summary>
  [Parameter] public string? Title { get; set; }

  /// <summary>
  /// Today, for the "Today" rule, drawn only where it falls inside the window. Null draws none: the committee page reads a
  /// review's window, not today's (decision D2).
  /// </summary>
  [Parameter] public DateOnly? Today { get; set; }

  /// <summary>Whether the window is a committee review's (D2): the summary names it, "in the review window, … to …".</summary>
  [Parameter] public bool ReviewWindow { get; set; }

  /// <summary>The trainee, named in the summary on the committee's page (4.15); null on their own.</summary>
  [Parameter] public string? SubjectName { get; set; }

  /// <summary>Whether the page has multi-source feedback beside this EPA, so the card says it is not plotted (D8, D36).</summary>
  [Parameter] public bool MsfBeside { get; set; }

  /// <summary>The card's id, which the committee's standing panel links an EPA's name to (R4).</summary>
  public string CardId => $"trajectory-{Trajectory.EpaId}";

  private string HeadingId => $"trajectory-{Trajectory.EpaId}-h";

  private IReadOnlyList<TrajectoryPointDto> OldestFirst
    => Trajectory.Points.OrderBy(point => point.ObservedOn).ThenBy(point => point.ActivityId).ToList();

  private bool HasOtherScale => Trajectory.Points.Any(_wide.IsOffLadder);

  protected override void OnParametersSet()
  {
    _wide = new TrajectoryDrawing(Trajectory, TrajectoryFrame.Wide, Today);
    _narrow = new TrajectoryDrawing(Trajectory, TrajectoryFrame.Narrow, Today);
  }

  // The activity's row name; the handler run without a user store leaves it empty, and the type's evidence stands in.
  private static string ActivityNameOf(TrajectoryPointDto point)
    => string.IsNullOrWhiteSpace(point.ActivityName) ? point.Source : point.ActivityName;

  private static string AssessorOf(TrajectoryPointDto point)
    => string.IsNullOrWhiteSpace(point.AssessorName) ? point.AssessorUserId : point.AssessorName;

  /// <summary>The heading at its level, the EPA's name or the page's title with the paused mark (C5, C13).</summary>
  private RenderFragment Heading => __builder =>
  {
    var level = Math.Clamp(HeadingLevel, 2, 6);
    __builder.OpenElement(0, $"h{level}");
    __builder.AddAttribute(1, "id", HeadingId);
    if (Title is not null)
    {
      __builder.AddAttribute(2, "class", "epa-section-title");
      __builder.AddContent(3, Title);
      if (!Trajectory.EpaInForce)
      {
        __builder.AddContent(4, " ");
        __builder.OpenElement(5, "span");
        __builder.AddAttribute(6, "class", "paused-mark");
        __builder.AddContent(7, EpaOptionLabel.NoLongerInUse);
        __builder.CloseElement();
      }
    }
    else
    {
      __builder.OpenComponent<EpaLabel>(8);
      __builder.AddComponentParameter(9, nameof(EpaLabel.Code), Trajectory.EpaCode);
      __builder.AddComponentParameter(10, nameof(EpaLabel.Title), Trajectory.EpaTitle);
      __builder.AddComponentParameter(11, nameof(EpaLabel.InForce), Trajectory.EpaInForce);
      __builder.CloseComponent();
    }

    __builder.CloseElement();
  };

  /// <summary>One of the two drawings (Q5): the same marks, at its own fixed size.</summary>
  private RenderFragment Drawing(TrajectoryDrawing d, string size) => __builder =>
  {
    <svg class="trajectory-chart trajectory-chart--sized @size" width="@d.Width" height="@d.Height"
         viewBox="0 0 @d.Width @d.Height" role="img" aria-label="@TrajectoryWords.SvgName(Trajectory.Points.Count)">
      @foreach (var band in d.Bands)
      {
        <rect class="trajectory-chart-band" x="@band.Xs" y="@d.BandTop" width="@band.Widths" height="@(d.AxisY - d.BandTop)"></rect>
      }
      @foreach (var label in d.SemesterLabels)
      {
        @label.Svg("trajectory-chart-band-label")
      }
      @if (d.BelowShading is not null)
      {
        <path class="trajectory-chart-below" d="@d.BelowShading"></path>
      }
      <path class="trajectory-chart-rung" d="@d.RungLines"></path>
      <line class="trajectory-chart-lane" x1="@d.Left" x2="@d.Right" y1="@d.LaneLineY" y2="@d.LaneLineY"></line>
      @foreach (var label in d.RungLabels)
      {
        @label.Svg("trajectory-chart-y-label", "end")
      }
      @d.LaneLabel.Svg("trajectory-chart-note", "end")
      @if (d.MinimumLine is not null)
      {
        <path class="trajectory-chart-minimum" d="@d.MinimumLine"></path>
      }
      @if (d.ExitY is { } exitY && d.ExitLabel is { } exitLabel)
      {
        <line class="trajectory-chart-exit" x1="@d.Left" x2="@d.Right" y1="@TrajectoryDrawing.Fmt(exitY)" y2="@TrajectoryDrawing.Fmt(exitY)"></line>
        @exitLabel.Svg("trajectory-chart-line-label")
      }
      @if (d.MinimumLabel is { } minimumLabel)
      {
        @minimumLabel.Svg("trajectory-chart-minimum-label")
      }
      <line class="trajectory-chart-axis" x1="@d.Left" x2="@d.Right" y1="@d.AxisY" y2="@d.AxisY"></line>
      <path class="trajectory-chart-axis" d="@d.MonthTicks"></path>
      @foreach (var label in d.MonthLabels)
      {
        @label.Svg("trajectory-chart-x-label", "middle")
      }
      @if (d.TodayX is { } todayX)
      {
        <line class="trajectory-chart-today" x1="@TrajectoryDrawing.Fmt(todayX)" x2="@TrajectoryDrawing.Fmt(todayX)" y1="@d.Top" y2="@d.AxisY"></line>
        @(new TrajectoryDrawing.Label(todayX + 4, d.AxisY - 6, "Today").Svg("trajectory-chart-note"))
      }
      @if (d.Line is not null)
      {
        <path class="trajectory-chart-line" d="@d.Line"></path>
      }
      @if (d.Hollow is not null)
      {
        <path class="trajectory-chart-hollow" d="@d.Hollow"></path>
      }
      @if (d.Dots is not null)
      {
        <path class="trajectory-chart-dots" d="@d.Dots"></path>
      }
    </svg>
  };
}

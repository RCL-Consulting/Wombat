@using System.Globalization

@if (Points.Count == 0)
{
  <p class="muted">No observations to plot.</p>
}
else
{
  <svg class="trajectory-chart"
       viewBox="0 0 @Width @Height"
       role="img"
       aria-label="@AriaLabel"
       preserveAspectRatio="xMidYMid meet">
    <g class="trajectory-chart-grid">
      @foreach (var tick in AxisTicks)
      {
        var y = YScale(tick.Order);
        <line x1="@Fmt(PlotLeftPx)" y1="@Fmt(y)"
              x2="@Fmt(Width - RightMargin)" y2="@Fmt(y)" />
        @RenderYAxisLabel(y, tick.AxisText)
      }
    </g>

    <line class="trajectory-chart-axis"
          x1="@Fmt(PlotLeftPx)" y1="@Fmt(PlotTopPx)"
          x2="@Fmt(PlotLeftPx)" y2="@Fmt(PlotBottomPx)" />
    <line class="trajectory-chart-axis"
          x1="@Fmt(PlotLeftPx)" y1="@Fmt(PlotBottomPx)"
          x2="@Fmt(Width - RightMargin)" y2="@Fmt(PlotBottomPx)" />

    @if (OnLadderPoints.Count > 1)
    {
      <polyline class="trajectory-chart-line"
                points="@BuildPolylinePoints()" />
    }

    @foreach (var point in Points)
    {
      var cx = XScale(point.Date);
      var cy = YScale(point.Rating);
      var offLadder = IsOffLadder(point);
      <circle class="trajectory-chart-dot@(offLadder ? " is-off-scale" : string.Empty)"
              cx="@Fmt(cx)"
              cy="@Fmt(cy)"
              r="4">
        <title>@point.Date.ToString("yyyy-MM-dd") · @RungTextOf(point)@(string.IsNullOrWhiteSpace(point.Label) ? string.Empty : $" · {point.Label}")@(offLadder ? " · not a rung on this scale" : string.Empty)</title>
      </circle>
    }

    @RenderXAxisLabel(PlotLeftPx, EarliestDate.ToString("yyyy-MM-dd"), "start")
    @RenderXAxisLabel(Width - RightMargin, LatestDate.ToString("yyyy-MM-dd"), "end")
  </svg>

  @* Text/tabular equivalent of the chart for screen readers (WCAG 1.1.1). Visually hidden;
     the SVG above carries role="img" + aria-label, this table carries the underlying data. *@
  <table class="visually-hidden">
    <caption>@AriaLabel</caption>
    <thead>
      <tr>
        <th scope="col">Date</th>
        <th scope="col">Rating</th>
        <th scope="col">Evidence type</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var point in Points.OrderBy(p => p.Date).ThenBy(p => p.Sequence))
      {
        <tr>
          <td>@point.Date.ToString("yyyy-MM-dd")</td>
          <td>@RungTextOf(point)@(IsOffLadder(point) ? " (not a rung on this scale)" : string.Empty)</td>
          <td>@(string.IsNullOrWhiteSpace(point.Label) ? "—" : point.Label)</td>
        </tr>
      }
    </tbody>
  </table>
}

@code {
  [Parameter, EditorRequired] public IReadOnlyList<ChartPoint> Points { get; set; } = Array.Empty<ChartPoint>();
  [Parameter] public string AriaLabel { get; set; } = "Rating trajectory";
  [Parameter] public int Width { get; set; } = 600;
  [Parameter] public int Height { get; set; } = 200;
  [Parameter] public int MinRating { get; set; } = 1;

  /// <summary>
  /// Top of the Y axis. Leave unset to derive it from the data.
  /// </summary>
  /// <remarks>
  /// This used to default to a hard 5, which silently plotted any higher rung off the top of
  /// the chart. Entrustment scales are data — the paediatric v11.1 ladder has six rungs — so
  /// the default now grows to fit, while still showing the familiar 1–5 axis for a five-rung
  /// scale so existing charts are unchanged.
  /// </remarks>
  [Parameter] public int? MaxRating { get; set; }

  /// <summary>
  /// The rungs of the ladder these ratings are recorded on, in order, resolved server-side from the
  /// trainee's pinned curriculum item. Leave empty to draw the numeric axis this chart drew before T123.
  /// </summary>
  /// <remarks>
  /// <para>
  /// A rating is an ordinal on a specific ladder and means nothing without it. Growing the axis to fit
  /// the DATA — which is what this component did — is not the same as fitting the SCALE: a six-rung
  /// trainee whose ratings all sit at 3 saw a 1–5 axis, a ladder with its top two rungs missing, until
  /// somebody earned a 6 and the axis changed shape underneath them.
  /// </para>
  /// <para>
  /// When supplied, this WINS over <see cref="MinRating" /> and <see cref="MaxRating" />. Those remain
  /// the manual override for a caller that has no scale to hand; a caller that has one should not also
  /// be second-guessing its extent.
  /// </para>
  /// </remarks>
  [Parameter] public IReadOnlyList<Rung> Rungs { get; set; } = Array.Empty<Rung>();

  private const int DefaultMaxRating = 5;

  /// <summary>
  /// Axis labels are clipped to the 40px left margin, so a long rung name would overwrite the plot.
  /// Four characters covers every CPSA rung ("1", "3a", "3b") and falls back to the ordinal for the
  /// word ladders ("Indirect supervision"). The full label is in the tooltip and the screen-reader
  /// table unconditionally, so the accessible copy is never poorer than the picture. (T123 D29)
  /// </summary>
  private const int MaxAxisLabelChars = 4;

  private bool HasRungs => Rungs.Count > 0;

  private int EffectiveMinRating => HasRungs ? Rungs.Min(rung => rung.Order) : MinRating;

  private int EffectiveMaxRating =>
    HasRungs
      ? Rungs.Max(rung => rung.Order)
      : MaxRating ?? (Points.Count == 0
        ? DefaultMaxRating
        : Math.Max(DefaultMaxRating, Points.Max(point => point.Rating)));

  /// <summary>
  /// The y-axis gridlines. From the rungs when there are any — they need not be contiguous — otherwise
  /// one per integer, which is what the numeric axis always was.
  /// </summary>
  private IReadOnlyList<(int Order, string AxisText)> AxisTicks
  {
    get
    {
      if (HasRungs)
      {
        return Rungs
          .OrderBy(rung => rung.Order)
          .Select(rung => (
            rung.Order,
            rung.Label.Length <= MaxAxisLabelChars
              ? rung.Label
              : rung.Order.ToString(CultureInfo.InvariantCulture)))
          .ToArray();
      }

      var ticks = new List<(int, string)>();
      for (var value = EffectiveMinRating; value <= EffectiveMaxRating; value++)
      {
        ticks.Add((value, value.ToString(CultureInfo.InvariantCulture)));
      }

      return ticks;
    }
  }

  /// <summary>
  /// A plotted rating that is not a rung on the axis ladder. It was recorded against something else —
  /// the trainee did not create that situation and erasing the point would hide evidence they legitimately
  /// collected — so it is kept, drawn hollow, and left out of the line that implies a trend. (T123 D30)
  /// </summary>
  private bool IsOffLadder(ChartPoint point) =>
    HasRungs && !Rungs.Any(rung => rung.Order == point.Rating);

  private IReadOnlyList<ChartPoint> OnLadderPoints =>
    Points.Where(point => !IsOffLadder(point)).ToArray();

  private string RungTextOf(ChartPoint point)
  {
    var rung = HasRungs ? Rungs.FirstOrDefault(r => r.Order == point.Rating) : null;
    return rung is null ? $"Rating {point.Rating}" : $"Rung {rung.Label}";
  }

  private const int LeftMargin = 40;
  private const int RightMargin = 12;
  private const int TopMargin = 12;
  private const int BottomMargin = 28;

  private double PlotLeftPx => LeftMargin;
  private double PlotTopPx => TopMargin;
  private double PlotBottomPx => Height - BottomMargin;

  private DateOnly EarliestDate => Points.Min(point => point.Date);
  private DateOnly LatestDate => Points.Max(point => point.Date);

  private double XScale(DateOnly date)
  {
    var plotWidth = Width - LeftMargin - RightMargin;
    var totalDays = LatestDate.DayNumber - EarliestDate.DayNumber;
    if (totalDays <= 0)
    {
      return LeftMargin + plotWidth / 2.0;
    }

    var offsetDays = date.DayNumber - EarliestDate.DayNumber;
    return LeftMargin + plotWidth * ((double)offsetDays / totalDays);
  }

  private double YScale(double rating)
  {
    var plotHeight = PlotBottomPx - PlotTopPx;
    var range = EffectiveMaxRating - EffectiveMinRating;
    if (range <= 0)
    {
      return PlotTopPx + plotHeight / 2.0;
    }

    var normalized = (rating - EffectiveMinRating) / range;
    return PlotBottomPx - plotHeight * normalized;
  }

  private string BuildPolylinePoints()
  {
    var ordered = OnLadderPoints
      .OrderBy(point => point.Date)
      .ThenBy(point => point.Sequence)
      .ToArray();
    return string.Join(" ", ordered.Select(point =>
      FormattableString.Invariant($"{XScale(point.Date):0.##},{YScale(point.Rating):0.##}")));
  }

  private static string Fmt(double value)
    => value.ToString("0.##", CultureInfo.InvariantCulture);

  // The content is an EntrustmentLevel.Label an administrator can type, not the int this used to
  // interpolate, so it is encoded exactly as RenderXAxisLabel already encodes its dates.
  private MarkupString RenderYAxisLabel(double y, string content)
    => new(FormattableString.Invariant(
      $"<text class=\"trajectory-chart-y-label\" x=\"{PlotLeftPx - 6:0.##}\" y=\"{y + 4:0.##}\" text-anchor=\"end\">{System.Net.WebUtility.HtmlEncode(content)}</text>"));

  private MarkupString RenderXAxisLabel(double x, string content, string anchor)
    => new(FormattableString.Invariant(
      $"<text class=\"trajectory-chart-x-label\" x=\"{x:0.##}\" y=\"{PlotBottomPx + 18:0.##}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(content)}</text>"));

  /// <summary>
  /// One plotted observation. <c>Label</c> is the EVIDENCE SOURCE ("Direct observation"), which is what
  /// the screen-reader table's third column is headed — it is not, and never was, a rung label.
  /// </summary>
  public sealed record ChartPoint(DateOnly Date, int Rating, int Sequence = 0, string? Label = null);

  /// <summary>One rung of the ladder the axis is drawn from. Order is the position; Label is the name.</summary>
  public sealed record Rung(int Order, string Label);
}

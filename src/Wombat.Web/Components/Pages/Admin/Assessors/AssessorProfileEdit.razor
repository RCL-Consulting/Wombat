@page "/admin/assessors/edit"
@attribute [Authorize(Policy = "AdministratorOrInstitutionalAdmin")]
@using Wombat.Web.Components.Pages.Admin.Users
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ILogger<AssessorProfileEdit> Logger

@*
  The old assessor form's route, kept only so an old link or bookmark lands somewhere (T376, flow 12, S10). Its ?id= is
  a profile id: the page follows it, in the caller's scope, to the person's page with Assessor training open
  (PeopleLinks.UserTraining), replacing this address in the history. An id that names no profile, one whose person is
  outside the caller's scope, a missing id and a malformed one all read as the user page's "User unavailable"
  (UserPageWords, T194's one answer), so a stale link reads the same wherever it lands. Until T376 this was a form that
  asked an institution and a speciality and rewrote the person's whole scope (M1); training is recorded on the user page
  now (Q2).
*@
@* "User", UserPageWords.Heading (a test holds them equal): the title is literal, as every page's is. *@
<PageTitle>User · Wombat</PageTitle>

<PageHeader Title="User" />

@if (_traineeNote is not null)
{
  <div class="user-page">
    <Alert Kind="info" Role="" Id="assessor-edit-trainee-note">@_traineeNote</Alert>
  </div>
}
else
{
  <div class="user-page" aria-busy="@(_loading ? "true" : null)">
    <StatePanel IsLoading="_loading" LoadError="@_loadError" OnRetry="ResolveAsync" IsEmpty="true"
                EmptyTitle="@UserPageWords.UnavailableTitle" EmptyBody="@UserPageWords.UnavailableBody">
      <EmptyActions>
        <a class="btn btn-outline btn-sm" href="@PeopleLinks.Users">@UserPageWords.GoToUsers<Icon Name="arrow-right" /></a>
      </EmptyActions>
      <ChildContent />
    </StatePanel>
  </div>
}

@code {
  /// <summary>The profile id, as the old list linked it. Read as text, so a malformed one is "User unavailable", not a fault.</summary>
  [SupplyParameterFromQuery(Name = "id")]
  public string? Id { get; set; }

  private string? _traineeNote;
  private bool _loading = true;
  private string? _loadError;

  /// <summary>A failed read (T329): a fixed sentence; the failure to the log.</summary>
  private const string LoadFailed = "Could not load this person. Nothing has changed. Try again, or come back in a few minutes.";

  protected override async Task OnParametersSetAsync()
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    _traineeNote = UserAdministrationRules.TraineeNoteOnUserPages(authState.User);
    if (_traineeNote is not null)
    {
      _loading = false;
      return;
    }

    await ResolveAsync();
  }

  private async Task ResolveAsync()
  {
    _loading = true;
    _loadError = null;
    string? userId = null;
    try
    {
      if (int.TryParse(Id, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var profileId)
          && profileId > 0)
      {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        userId = await Sender.Send(new GetAssessorProfileOwnerQuery(profileId, user));
      }
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogError(exception, "The assessor profile's person could not be read.");
      _loadError = LoadFailed;
    }

    if (userId is not null)
    {
      // S10: the person's page, its training open; no history entry for this address. Outside the catch: a static render
      // redirects by throwing, and the page stays loading rather than say "User unavailable" for a moment.
      Navigation.NavigateTo(PeopleLinks.UserTraining(userId), replace: true);
      return;
    }

    _loading = false;
  }
}

@page "/admin/specialities/{SpecialityId:int}/sub-specialities"
@attribute [Authorize(Policy = "AdministratorOrCollegeAdmin")]
@inject IScopedSender Sender
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<SubSpecialitiesList> Logger

<PageTitle>@Heading · Wombat</PageTitle>

@*
  A speciality's old Sub-specialities list (T394, flow 16, Q1, T291 item 2): its sub-specialities are rows of its section
  on the College's tree now, so this address sends there (CatalogueLinks.CollegeTreeAt, replacing itself in the history).
  A speciality the caller cannot open, or that does not exist, is Speciality unavailable (Q7, N2), never an empty list.
*@
<PageHeader Title="@Heading" />

<div class="user-page sub-speciality-page" aria-busy="@(_loading ? "true" : null)">
  <StatePanel IsLoading="_loading" LoadError="@_loadError" OnRetry="LoadAsync">
    <LoadingContent>
      <p class="loading-line" role="status">@CollegeTreeWords.LoadingTree</p>
    </LoadingContent>
    <ChildContent>
      @if (_unavailable)
      {
        <div class="detail-card detail-card--empty">
          <div class="state-panel-copy">@CollegeTreeWords.SpecialityUnavailableBody</div>
          <div class="form-actions">
            <a class="btn btn-primary" href="@GoTo.Href">@GoTo.Label</a>
          </div>
        </div>
      }
    </ChildContent>
  </StatePanel>
</div>

@code {
  [Parameter]
  public int SpecialityId { get; set; }

  private bool _unavailable;
  private bool _loading = true;
  private string? _loadError;

  /// <summary>The acting role, as App resolved it and Routes cascades it.</summary>
  [CascadingParameter] public ActingRole? Acting { get; set; }

  private bool UnderColleges => NavOwners.OwnerFor(typeof(SubSpecialitiesList), Acting?.Role) == NavItems.Colleges;

  /// <summary>The h1 and the tab: the tree's while it sends there, or the Unavailable page's own (Q7).</summary>
  private string Heading => _unavailable ? CollegeTreeWords.SpecialityUnavailableHeading : CollegeTreeWords.TreeHeading;

  private (string Label, string Href) GoTo => UnderColleges
    ? (CollegeTreeWords.GoToColleges, CatalogueLinks.Colleges)
    : (CollegeTreeWords.GoToSpecialities, CatalogueLinks.Specialities);

  protected override Task OnParametersSetAsync() => LoadAsync();

  private async Task LoadAsync()
  {
    _loading = true;
    _loadError = null;
    _unavailable = false;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var speciality = await Sender.Send(new GetSpecialityByIdQuery(SpecialityId, authState.User));
      if (speciality is not null)
      {
        Navigation.NavigateTo(CatalogueLinks.CollegeTreeAt(speciality.CollegeId, speciality.Id), replace: true);
        return;
      }

      _unavailable = true;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      // T329, T393: never the exception's text.
      Logger.LogError(exception, "The speciality {SpecialityId} could not be read.", SpecialityId);
      _loadError = CollegeTreeWords.TreeLoadFailed;
    }
    finally
    {
      _loading = false;
    }
  }
}

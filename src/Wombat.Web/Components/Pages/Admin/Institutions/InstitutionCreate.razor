@page "/admin/institutions/new"
@attribute [Authorize(Policy = "Administrator")]
@inject IScopedSender Sender
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ILogger<InstitutionCreate> Logger
@using Wombat.Web.Components.Pages.Admin.Invitations

<PageTitle>Create institution · Wombat</PageTitle>

@*
  T400 (flow 18, lane A; boards R3-I07–I10; T378). Creating an institution is the Administrator's alone, as the command is
  (T376, S12: an Institutional admin's /admin/institutions/new is Access denied).

  - The subtitle says what a save does (T12); no Back: the trail and Cancel are the ways back.
  - Name and Short code are starred and aria-required, never required, and carry no maxlength (S6, K14): the page refuses
    in its own words. Each field has its help under it (T12).
  - The page checks before anything is sent; each refusal sits under its field, first in its aria-describedby, and the
    first refused field takes the focus (T378). A name or short code another institution holds comes back from the
    command as a field-tied refusal and lands under its field the same way (R3-I09), naming no institution. Anything else
    is the fixed sentence in the result, logged (T23, T329), never the exception's text.
  - Save lands on the new record by CatalogueLinks.InstitutionCreated, which writes "‹name› created." (K13).
*@
<PageHeader Title="Create institution" Subtitle="@InstitutionWords.CreateSubtitle" />

<div class="record-page">
  <ActionResult @ref="_result">
    @if (_failed)
    {
      var (lead, rest) = InstitutionWords.SplitFirstSentence(InstitutionEdit.SaveFailed);
      <Alert Kind="danger"><strong>@lead</strong> @rest</Alert>
    }
  </ActionResult>

  @* novalidate: the browser stays quiet and the page refuses in its own words under each field (T324). *@
  <EditForm Model="_model" OnSubmit="SaveAsync" FormName="institution-create" class="form-container" novalidate>
    <p class="field-help">@InvitationText.RequiredMarkLine</p>

    <div class="form-grid">
      <div class="form-group">
        <label for="@InstitutionEdit.NameId">Name<span class="required-mark" aria-hidden="true"> *</span><span class="visually-hidden"> required</span></label>
        <input id="@InstitutionEdit.NameId" type="text" class="@InputClass(InstitutionEdit.NameId)" aria-required="true" autocomplete="off"
               aria-invalid="@Invalid(InstitutionEdit.NameId)" aria-describedby="@DescribedBy(InstitutionEdit.NameId)"
               @bind="_model.Name" @bind:after="() => ClearField(InstitutionEdit.NameId)" />
        @FieldMessage(InstitutionEdit.NameId)
        <p class="field-help" id="@FieldHelp.Id(InstitutionEdit.NameId)">@InstitutionWords.NameHelp</p>
      </div>

      <div class="form-group">
        <label for="@InstitutionEdit.ShortCodeId">Short code<span class="required-mark" aria-hidden="true"> *</span><span class="visually-hidden"> required</span></label>
        <input id="@InstitutionEdit.ShortCodeId" type="text" class="@InputClass(InstitutionEdit.ShortCodeId)" aria-required="true" autocomplete="off"
               aria-invalid="@Invalid(InstitutionEdit.ShortCodeId)" aria-describedby="@DescribedBy(InstitutionEdit.ShortCodeId)"
               @bind="_model.ShortCode" @bind:after="() => ClearField(InstitutionEdit.ShortCodeId)" />
        @FieldMessage(InstitutionEdit.ShortCodeId)
        <p class="field-help" id="@FieldHelp.Id(InstitutionEdit.ShortCodeId)">@InstitutionWords.ShortCodeHelp</p>
      </div>

      <div class="form-group">
        <label for="@InstitutionEdit.EmailId">Contact email</label>
        <input id="@InstitutionEdit.EmailId" type="email" class="@InputClass(InstitutionEdit.EmailId)" autocomplete="off" spellcheck="false"
               aria-invalid="@Invalid(InstitutionEdit.EmailId)" aria-describedby="@DescribedBy(InstitutionEdit.EmailId)"
               @bind="_model.ContactEmail" @bind:after="() => ClearField(InstitutionEdit.EmailId)" />
        @FieldMessage(InstitutionEdit.EmailId)
        <p class="field-help" id="@FieldHelp.Id(InstitutionEdit.EmailId)">@InstitutionWords.ContactEmailHelp</p>
      </div>
    </div>

    <FormActions>
      <a class="btn btn-outline" href="@CatalogueLinks.Institutions">@InstitutionWords.Cancel</a>
      @* Not disabled while its own save runs (T234): it has the focus. A second press sends nothing. *@
      <button type="submit" class="btn btn-primary" aria-disabled="@InFlight.AriaDisabled(_saving)">@(_saving ? InstitutionWords.Saving : InstitutionWords.Save)</button>
    </FormActions>
  </EditForm>
</div>

@code {

  private readonly InstitutionFields _model = new();
  private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.Ordinal);
  private string? _focusFieldId;
  private bool _failed;
  private bool _focusResult;
  private bool _saving;
  private ActionResult? _result;

  /// <summary>The result region, which a failure focuses. A test matches a focus call to it.</summary>
  internal ElementReference ResultRegion => _result?.Element ?? default;

  private async Task SaveAsync()
  {
    if (_saving)
    {
      return;
    }

    _failed = false;
    _fieldErrors.Clear();
    if (_model.Check(_fieldErrors) is { } firstInvalid)
    {
      _focusFieldId = firstInvalid;
      return;
    }

    _saving = true;
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var created = await Sender.Send(new CreateInstitutionCommand(
        _model.Name, _model.ShortCode, InstitutionFields.EmptyToNull(_model.ContactEmail), authState.User));
      Navigation.NavigateTo(CatalogueLinks.InstitutionCreated(created.Id));
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      if (InstitutionFields.FieldOf(exception, _fieldErrors) is { } refused)
      {
        _focusFieldId = refused;
      }
      else
      {
        // T23, T329: anything that is no refusal of a field is the fixed sentence, the failure logged.
        Logger.LogError(exception, "An institution could not be created.");
        _failed = true;
        _focusResult = true;
      }
    }
    finally
    {
      _saving = false;
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusResult && _result is not null)
    {
      _focusResult = false;
      await _result.Element.FocusAsync();
    }

    if (_focusFieldId is { } fieldId)
    {
      _focusFieldId = null;
      await PageFocus.FocusByIdAsync(JS, fieldId);
    }
  }

  private void ClearField(string fieldId) => _fieldErrors.Remove(fieldId);

  private RenderFragment FieldMessage(string fieldId) => __builder =>
  {
    if (_fieldErrors.TryGetValue(fieldId, out var message))
    {
      <p id="@InstitutionFields.MessageId(fieldId)" class="validation-message">@message</p>
    }
  };

  /// <summary>The refusal first, then the field's help (T378).</summary>
  private string DescribedBy(string fieldId) => _fieldErrors.ContainsKey(fieldId)
    ? $"{InstitutionFields.MessageId(fieldId)} {FieldHelp.Id(fieldId)}"
    : FieldHelp.Id(fieldId);

  private string? Invalid(string fieldId) => _fieldErrors.ContainsKey(fieldId) ? "true" : null;

  private string InputClass(string fieldId) => _fieldErrors.ContainsKey(fieldId) ? "form-control input-validation-error" : "form-control";
}

@page "/admin/colleges/{CollegeId:int}/specialities/new"
@page "/admin/colleges/{CollegeId:int}/specialities/{Id:int}"
@attribute [Authorize(Policy = "AdministratorOrCollegeAdmin")]
@inject IScopedSender Sender
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(IsNew ? "Create Speciality" : "Edit Speciality")</PageTitle>

<PageHeader Title="@(IsNew ? "Create speciality" : "Edit speciality")" Subtitle="@(_college is null ? "Scope this speciality under the current college." : $"College: {_college.Name} ({_college.ShortCode})")">
  <Actions>
    <a class="btn btn-outline btn-sm" href="@($"/admin/colleges/{CollegeId}/specialities")">Back to specialities</a>
    @if (!IsNew && Id.HasValue)
    {
      <a class="btn btn-outline btn-sm" href="@($"/admin/specialities/{Id.Value}/sub-specialities")">Manage sub-specialities</a>
    }
  </Actions>
</PageHeader>

@* What a Save or a Deactivate did. It takes the focus once either is done (T234; DESIGN.md § Button system). A refusal
   leaves the focus where it was: it is an alert, read at once. *@
<ActionResult @ref="_result">
  @if (!string.IsNullOrWhiteSpace(_statusMessage))
  {
    <Alert Kind="success">@_statusMessage</Alert>
  }

  @if (!string.IsNullOrWhiteSpace(_errorMessage))
  {
    <Alert Kind="danger">@_errorMessage</Alert>
  }
</ActionResult>

<StatePanel IsLoading="_loading" IsEmpty="false" EmptyTitle="" EmptyBody="">
  <div class="form-container">
    <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="speciality-edit">
      <DataAnnotationsValidator />
      <ValidationSummary class="validation-summary-errors" />

      <div class="form-grid">
        <FormField Label="Name" InputId="speciality-name" Required="true">
          <InputText id="speciality-name" class="form-control" @bind-Value="_model.Name" />
          <ValidationMessage For="() => _model.Name" />
        </FormField>

        <FormField Label="Description" InputId="speciality-description" FullWidth="true">
          <InputTextArea id="speciality-description" class="form-control" @bind-Value="_model.Description" />
          <ValidationMessage For="() => _model.Description" />
        </FormField>

        @if (!IsNew)
        {
          <FormField Label="Status" InputId="speciality-active">
            <div class="form-check">
              <InputCheckbox id="speciality-active" class="form-check-input" @bind-Value="_model.IsActive" />
              <label for="speciality-active">Active</label>
            </div>
          </FormField>
        }
      </div>

      <FormActions>
        <a class="btn btn-outline" href="@($"/admin/colleges/{CollegeId}/specialities")">Cancel</a>
        @* Neither is disabled while its own action runs (T234): the one pressed has the focus, and a browser drops the focus
           of a button it disables, to the page. A second press sends nothing. *@
        @if (!IsNew)
        {
          <button type="button" class="btn btn-danger" @onclick="DeactivateAsync" disabled="@_saving" aria-disabled="@InFlight.AriaDisabled(_deactivating)">Deactivate</button>
        }
        <button type="submit" class="btn btn-primary" disabled="@_deactivating" aria-disabled="@InFlight.AriaDisabled(_saving)">@(_saving ? "Saving..." : "Save")</button>
      </FormActions>
    </EditForm>
  </div>
</StatePanel>

@code {
  [Parameter]
  public int CollegeId { get; set; }

  [Parameter]
  public int? Id { get; set; }

  private CollegeDto? _college;
  private SpecialityFormModel _model = new();
  private string? _errorMessage;
  private string? _statusMessage;
  private bool _loading;
  private bool _saving;
  private bool _deactivating;
  private ActionResult? _result;

  /// <summary>A save or a deactivation has been sent and has not answered, so nothing else may be sent. (T234)</summary>
  private bool Busy => _saving || _deactivating;

  private bool IsNew => !Id.HasValue;

  protected override async Task OnParametersSetAsync()
  {
    _loading = true;
    _errorMessage = null;
    _statusMessage = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _college = await Sender.Send(new GetCollegeByIdQuery(CollegeId, authState.User));

      if (_college is null)
      {
        Navigation.NavigateTo("/not-found");
        return;
      }

      if (IsNew)
      {
        _model = new SpecialityFormModel { IsActive = true };
        return;
      }

      var speciality = await Sender.Send(new GetSpecialityByIdQuery(Id!.Value, authState.User));

      if (speciality is null || speciality.CollegeId != CollegeId)
      {
        Navigation.NavigateTo("/not-found");
        return;
      }

      _model = new SpecialityFormModel
      {
        Name = speciality.Name,
        Description = speciality.Description,
        IsActive = speciality.IsActive
      };
    }
    catch (Exception exception)
    {
      _errorMessage = exception.Message;
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task SaveAsync()
  {
    if (Busy)
    {
      return;
    }

    _saving = true;
    _errorMessage = null;
    _statusMessage = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      SpecialityDto speciality;

      if (IsNew)
      {
        speciality = await Sender.Send(new CreateSpecialityCommand(CollegeId, _model.Name, EmptyToNull(_model.Description), authState.User));
        Navigation.NavigateTo($"/admin/colleges/{CollegeId}/specialities/{speciality.Id}", forceLoad: true);
        return;
      }

      speciality = await Sender.Send(new UpdateSpecialityCommand(Id!.Value, CollegeId, _model.Name, EmptyToNull(_model.Description), _model.IsActive, authState.User));
      _model.IsActive = speciality.IsActive;
      _statusMessage = "Speciality saved.";
      _result?.FocusAfterRender();
    }
    catch (Exception exception)
    {
      _errorMessage = exception.Message;
    }
    finally
    {
      _saving = false;
    }
  }

  private async Task DeactivateAsync()
  {
    if (Busy)
    {
      return;
    }

    _deactivating = true;
    _errorMessage = null;
    _statusMessage = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await Sender.Send(new DeactivateSpecialityCommand(Id!.Value, authState.User));
      _model.IsActive = false;
      _statusMessage = "Speciality deactivated.";
      _result?.FocusAfterRender();
    }
    catch (Exception exception)
    {
      _errorMessage = exception.Message;
    }
    finally
    {
      _deactivating = false;
    }
  }

  private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

  private sealed class SpecialityFormModel
  {
    [Required]
    [StringLength(200)]
    public string Name { get; set; } = string.Empty;

    [StringLength(2000)]
    public string? Description { get; set; }

    public bool IsActive { get; set; } = true;
  }
}

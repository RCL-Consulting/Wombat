@page "/admin/trainees"
@attribute [Authorize(Policy = "AdministratorOrInstitutionalAdmin")]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Trainees · Wombat</PageTitle>

<PageHeader Title="Trainees" Subtitle="Admit pending trainees into a curriculum and maintain active trainee profiles." />

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
  <Alert Kind="danger">@_errorMessage</Alert>
}

<StatePanel IsLoading="_loading" IsEmpty="false" EmptyTitle="" EmptyBody="">
  <div class="details-grid">
    <section class="detail-card">
      <h3>Pending admission</h3>
      @if (_pendingTrainees.Count == 0)
      {
        <div class="detail-card detail-card--empty-compact">No pending trainees found.</div>
      }
      else
      {
        var pendingNames = RowNames.Distinct(
          _pendingTrainees, row => row.UserId, row => $"{row.FirstName} {row.LastName}", row => $" ({row.Email})");
        <DataTable TItem="PendingTraineeDto" Items="_pendingTrainees" Caption="Pending trainees">
          <HeaderRow>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Institution</th>
              <th><span class="visually-hidden">Actions</span></th>
            </tr>
          </HeaderRow>
          <Row Context="trainee">
            <tr>
              <td>@($"{trainee.FirstName} {trainee.LastName}")</td>
              <td>@trainee.Email</td>
              <td>@GetInstitutionName(trainee.InstitutionId)</td>
              @* T239: each row's action is named by the trainee, and their email where two share a name. *@
              <td><a class="btn btn-primary btn-sm" href="@($"/admin/trainees/edit?userId={Uri.EscapeDataString(trainee.UserId)}")" aria-label="@($"Admit to curriculum: {pendingNames[trainee.UserId]}")">Admit to curriculum</a></td>
            </tr>
          </Row>
        </DataTable>
      }
    </section>

    <section class="detail-card">
      <h3>Active profiles</h3>
      @if (_activeTrainees.Count == 0)
      {
        <div class="detail-card detail-card--empty-compact">No active trainee profiles found.</div>
      }
      else
      {
        var activeNames = ProfileNames(_activeTrainees);
        <DataTable TItem="TraineeProfileDto" Items="_activeTrainees" Caption="Active trainee profiles">
          <HeaderRow>
            <tr>
              <th>Name</th>
              <th>Curriculum</th>
              <th>Sub-speciality</th>
              <th>Expected completion</th>
              <th><span class="visually-hidden">Actions</span></th>
            </tr>
          </HeaderRow>
          <Row Context="trainee">
            <tr>
              <td>@($"{trainee.FirstName} {trainee.LastName}")</td>
              <td>@($"{trainee.CurriculumName} ({trainee.CurriculumVersion})")</td>
              <td>@trainee.SubSpecialityName</td>
              <td>@trainee.ExpectedCompletionDate.ToString("yyyy-MM-dd")</td>
              <td><a class="btn btn-outline btn-sm" href="@($"/admin/trainees/edit?id={trainee.Id}")" aria-label="@($"Edit {activeNames[trainee.Id]}")">Edit</a></td>
            </tr>
          </Row>
        </DataTable>
      }
    </section>

    @if (_closedTrainees.Count > 0)
    {
      <section class="detail-card">
        <h3>Completed &amp; closed profiles</h3>
        @{ var closedNames = ProfileNames(_closedTrainees); }
        <DataTable TItem="TraineeProfileDto" Items="_closedTrainees" Caption="Completed and closed trainee profiles">
          <HeaderRow>
            <tr>
              <th>Name</th>
              <th>Curriculum</th>
              <th>Sub-speciality</th>
              <th>Outcome</th>
              <th><span class="visually-hidden">Actions</span></th>
            </tr>
          </HeaderRow>
          <Row Context="trainee">
            <tr>
              <td>@($"{trainee.FirstName} {trainee.LastName}")</td>
              <td>@($"{trainee.CurriculumName} ({trainee.CurriculumVersion})")</td>
              <td>@trainee.SubSpecialityName</td>
              <td>@(trainee.CompletedOn.HasValue ? $"Completed {trainee.CompletedOn.Value:yyyy-MM-dd}" : trainee.DeactivatedOn.HasValue ? $"Withdrawn {trainee.DeactivatedOn.Value:yyyy-MM-dd}" : "Withdrawn")</td>
              <td><a class="btn btn-outline btn-sm" href="@($"/admin/trainees/edit?id={trainee.Id}")" aria-label="@($"Edit {closedNames[trainee.Id]}")">Edit</a></td>
            </tr>
          </Row>
        </DataTable>
      </section>
    }
  </div>
</StatePanel>

@code {
  // T239: a profile's Edit is named by its trainee, then by their email where two trainees share a name, then by the
  // curriculum where one trainee has two profiles on the list.
  private static IReadOnlyDictionary<int, string> ProfileNames(IEnumerable<TraineeProfileDto> profiles)
    => RowNames.Distinct(
      profiles,
      profile => profile.Id,
      profile => $"{profile.FirstName} {profile.LastName}",
      profile => $" ({profile.Email})",
      profile => $", {profile.CurriculumName} ({profile.CurriculumVersion})");

  private IReadOnlyList<PendingTraineeDto> _pendingTrainees = [];
  private IReadOnlyList<TraineeProfileDto> _trainees = [];
  private IReadOnlyList<InstitutionDto> _institutions = [];

  private IReadOnlyList<TraineeProfileDto> _activeTrainees => _trainees.Where(trainee => trainee.IsActive).ToList();
  private IReadOnlyList<TraineeProfileDto> _closedTrainees => _trainees.Where(trainee => !trainee.IsActive).ToList();
  private bool _loading = true;
  private string? _errorMessage;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _institutions = await Sender.Send(new GetInstitutionsListQuery(authState.User));
      _pendingTrainees = await Sender.Send(new ListPendingTraineesQuery(authState.User));
      _trainees = await Sender.Send(new ListTraineesForSpecialityQuery(authState.User));
    }
    catch (Exception exception)
    {
      _errorMessage = exception.Message;
    }
    finally
    {
      _loading = false;
    }
  }

  private string GetInstitutionName(int? institutionId)
    => _institutions.FirstOrDefault(entity => entity.Id == institutionId)?.Name ?? "Unscoped";
}

@page "/admin/trainees/edit"
@attribute [Authorize(Policy = "AdministratorOrInstitutionalAdmin")]
@using System.Security.Claims
@using MediatR
@using Wombat.Application.Features.Curricula.Quota
@inject IScopedSender Sender
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TimeProvider Clock

<PageTitle>Trainee profile · Wombat</PageTitle>

<PageHeader Title="Trainee profile" Subtitle="@Subtitle">
  <Actions>
    <a class="btn btn-outline btn-sm" href="/admin/trainees">Back to trainees</a>
  </Actions>
</PageHeader>

@* Every action's result lands here. After Deactivate or Mark complete answers, the region takes the focus (DESIGN.md
   § Button system): on success both buttons are gone, and the dialog that sent it has closed. A refusal of either keeps
   its id, which the last-day field names, so the refusal is read with the field it is usually about (T209 review).
   After Save profile, it takes the focus once the save is done (T234): "Trainee profile saved." arriving on its own is
   often not read. A refused save leaves the focus where it was: the refusal is an alert, read at once. *@
<div @ref="_result" class="action-result" tabindex="-1">
  @if (!string.IsNullOrWhiteSpace(_errorMessage))
  {
    <Alert Id="@(_endRefused ? EndRefusalId : null)" Kind="danger">@_errorMessage</Alert>
  }

  @if (!string.IsNullOrWhiteSpace(_statusMessage))
  {
    <Alert Kind="success">@_statusMessage</Alert>
  }
</div>

<StatePanel IsLoading="_loading" IsEmpty="@(_model is null)" EmptyTitle="Profile unavailable" EmptyBody="The trainee profile could not be loaded." LoadError="@(null)">
  @if (_model is not null)
  {
    <div class="details-grid">
      <aside class="detail-card">
        <h3>Trainee summary</h3>
        <p><strong>Email:</strong> @_model.Email</p>
        <p><strong>Name:</strong> @_model.FullName</p>
        <p><strong>Status:</strong> @(_model.IsActive ? "Active" : (_model.CompletedOn.HasValue ? "Completed" : "Inactive"))</p>
        @if (_model.CompletedOn.HasValue)
        {
          <p><strong>Completed:</strong> @_model.CompletedOn.Value.ToString("yyyy-MM-dd")</p>
        }
        @if (_model.DeactivatedOn.HasValue)
        {
          <p><strong>Left the programme:</strong> @_model.DeactivatedOn.Value.ToString("yyyy-MM-dd")</p>
        }
      </aside>

      <section class="detail-card">
        <h3>Profile details</h3>
        @if (_model.IsEnded)
        {
          @* T305: Mark complete archives the profile, and a withdrawal ends it as surely, so an ended profile is read, not
             edited: no inputs and no Save profile, which the command would refuse. The header keeps Back to trainees. *@
          <p class="muted">This programme has ended, so its record is archived and cannot be changed.</p>
          <dl class="details-list">
            @* The stored values, not the form's: an edit left unsaved before Mark complete or Deactivate was never saved. *@
            <div><dt>Curriculum</dt><dd>@_model.CurriculumLabel</dd></div>
            <div><dt>Programme start date</dt><dd>@_model.StoredProgrammeStartDate.ToString("yyyy-MM-dd")</dd></div>
            <div><dt>Expected completion date</dt><dd>@(_model.StoredExpectedCompletionDate?.ToString("yyyy-MM-dd") ?? "Not set")</dd></div>
          </dl>
        }
        else
        {
          <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="trainee-profile">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary-errors" />

            <div class="form-grid form-grid--wide">
              @if (_curricula.Count == 0)
              {
                @* An admission into nothing: the institution has no active adoption, or an Administrator is admitting a
                   registrar with no institution. An empty select would only fail validation (fix pass). *@
                <p id="curriculum-id-none" class="muted">@NothingAdopted</p>
              }
              else
              {
                <FormField Label="Curriculum" InputId="curriculum-id" Required="true">
                  <InputSelect id="curriculum-id" class="form-select" @bind-Value="_model.CurriculumId">
                    @foreach (var curriculum in _curricula)
                    {
                      <option value="@curriculum.Id">@($"{curriculum.Name} ({curriculum.Version})")</option>
                    }
                  </InputSelect>
                </FormField>
              }

              <FormField Label="Programme start date" InputId="programme-start-date" Required="true">
                <InputDate id="programme-start-date" class="form-control" @bind-Value="_model.ProgrammeStartDate" />
              </FormField>

              <FormField Label="Expected completion date" InputId="expected-completion-date" HelpText="Leave this empty to derive it from the curriculum window.">
                <InputDate id="expected-completion-date" class="form-control" aria-describedby="@FieldHelp.Id("expected-completion-date")" @bind-Value="_model.ExpectedCompletionDate" />
              </FormField>
            </div>

            @if (!_isAdmission && _model.IsActive)
            {
              @* T209, D49: both ways out of the programme record its last day, and the quota reads it: the period it falls in
                 holds no target unless it is in that period's last month. The buttons name the help, because each one acts
                 on the date above it. *@
              <div class="form-grid form-grid--wide">
                <FormField Label="Last day in the programme" InputId="programme-end-date" HelpText="@EndDateHelp">
                  <InputDate id="programme-end-date" class="form-control"
                             aria-describedby="@FieldHelp.DescribedBy("programme-end-date", EndDateHelp, _endRefused ? EndRefusalId : null)"
                             @bind-Value="_model.EndDate" />
                </FormField>
              </div>
            }

            <FormActions>
              <a class="btn btn-outline" href="/admin/trainees">Cancel</a>
              @if (!_isAdmission && _model.IsActive)
              {
                @* Each asks first, naming the day (DESIGN.md § Button system): neither can be undone, and the day each records
                   cannot be changed afterwards. The red button is only in the dialog's footer. *@
                <button type="button" class="btn btn-outline" disabled="@Busy" aria-describedby="@FieldHelp.Id("programme-end-date")" @onclick="() => AskAsync(_confirmDeactivate)">Deactivate</button>
                <button type="button" class="btn btn-outline" disabled="@Busy" aria-describedby="@FieldHelp.Id("programme-end-date")" @onclick="() => AskAsync(_confirmComplete)">Mark complete</button>
              }
              @* Not disabled while its own save runs (T234): it has the focus, and a browser drops the focus of a button it
                 disables, to the page. A second press sends nothing (SaveAsync). *@
              <button type="submit" class="btn btn-primary" disabled="@(_ending || _curricula.Count == 0)" aria-disabled="@InFlight.AriaDisabled(_saving)">@(_saving ? "Saving..." : (_isAdmission ? "Admit trainee" : "Save profile"))</button>
            </FormActions>
          </EditForm>
        }
      </section>
    </div>
  }
</StatePanel>

<ConfirmDialog @ref="_confirmDeactivate"
               Title="Deactivate this trainee profile?"
               Body="@DeactivateBody"
               ConfirmLabel="Deactivate"
               DangerAction="true"
               OnConfirm="DeactivateAsync" />

<ConfirmDialog @ref="_confirmComplete"
               Title="Mark this programme complete?"
               Body="@CompleteBody"
               ConfirmLabel="Mark complete"
               DangerAction="false"
               OnConfirm="CompleteAsync" />

@code {
  [SupplyParameterFromQuery(Name = "id")]
  public int? Id { get; set; }

  [SupplyParameterFromQuery(Name = "userId")]
  public string? UserId { get; set; }

  private const string EndDateHelp =
    "Mark complete records it as the graduation day, archives the profile and removes the Trainee role. Deactivate " +
    "records it as the day the trainee left without completing. It cannot be after today, and it cannot be changed " +
    "afterwards. Either way, the period it falls in holds no target unless it is in that period's last month, and " +
    "encounters observed after it count towards nothing in this programme, even those already counted.";

  /// <summary>The id of the refusal alert, which the last-day field names after Deactivate or Mark complete is refused.</summary>
  private const string EndRefusalId = "programme-end-refusal";

  /// <summary>
  /// The curricula the picker offers: exactly what the command accepts (T304). A profile's pinned version and the
  /// institution's active adoption for the discipline; at admission, the institution's active adoptions alone.
  /// </summary>
  private IReadOnlyList<CurriculumChoiceDto> _curricula = [];
  private ConfirmDialog? _confirmDeactivate;
  private ConfirmDialog? _confirmComplete;
  private ElementReference _result;

  /// <summary>The region holding an action's result, which takes the focus once an end action has answered. For its tests.</summary>
  internal ElementReference ResultRegion => _result;

  /// <summary>
  /// Today on the South African calendar: the field's default, and the latest last day either action accepts. The server
  /// refuses a later one; the field carries no <c>max</c>, because it sits in the profile form and the browser would then
  /// refuse Save profile over a date Save does not send.
  /// </summary>
  private DateOnly _today;

  /// <summary>Deactivate or Mark complete was refused, so the last-day field names the refusal.</summary>
  private bool _endRefused;

  /// <summary>An end action has answered, or a save is done, and its result takes the focus after the next render.</summary>
  private bool _focusResult;
  private TraineeProfileFormModel? _model;
  private bool _loading = true;

  /// <summary>A save (or an admission) has been sent and has not yet answered.</summary>
  private bool _saving;

  /// <summary>Deactivate or Mark complete has been sent and has not yet answered.</summary>
  private bool _ending;

  /// <summary>Something has been sent and has not answered, so nothing else may be sent. (T234)</summary>
  private bool Busy => _saving || _ending;
  private bool _isAdmission;
  private string? _errorMessage;
  private string? _statusMessage;

  protected override async Task OnParametersSetAsync()
  {
    _loading = true;
    _errorMessage = null;
    _statusMessage = null;
    _endRefused = false;
    _today = QuotaCalendar.Today(Clock);

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

      if (Id.HasValue)
      {
        var profile = await Sender.Send(new GetTraineeProfileByIdQuery(Id.Value, authState.User));
        _isAdmission = false;

        // An ended profile is read, not edited (T305), so it needs no picker.
        _curricula = profile.IsEnded ? [] : await Sender.Send(new GetTraineeCurriculumChoicesQuery(profile.Id, authState.User));
        _model = new TraineeProfileFormModel
        {
          Id = profile.Id,
          UserId = profile.UserId,
          Email = profile.Email,
          FullName = $"{profile.FirstName} {profile.LastName}",
          CurriculumId = profile.CurriculumId,
          CurriculumLabel = $"{profile.CurriculumName} ({profile.CurriculumVersion})",
          StoredProgrammeStartDate = profile.ProgrammeStartDate,
          StoredExpectedCompletionDate = profile.ExpectedCompletionDate,
          ProgrammeStartDate = profile.ProgrammeStartDate,
          ExpectedCompletionDate = profile.ExpectedCompletionDate,
          IsActive = profile.IsActive,
          CompletedOn = profile.CompletedOn,
          DeactivatedOn = profile.DeactivatedOn,
          EndDate = _today
        };
      }
      else if (!string.IsNullOrWhiteSpace(UserId))
      {
        _isAdmission = true;
        _curricula = await Sender.Send(new GetAdmissionCurriculumChoicesQuery(UserId, authState.User));
        var pendingUsers = await Sender.Send(new ListPendingTraineesQuery(authState.User));
        var pendingUser = pendingUsers.FirstOrDefault(entity => entity.UserId == UserId)
          ?? throw new InvalidOperationException("The pending trainee could not be found.");

        var defaultCurriculum = ResolveDefaultCurriculum(pendingUser);

        _model = new TraineeProfileFormModel
        {
          UserId = pendingUser.UserId,
          Email = pendingUser.Email,
          FullName = $"{pendingUser.FirstName} {pendingUser.LastName}",
          CurriculumId = defaultCurriculum?.Id ?? _curricula.FirstOrDefault()?.Id ?? 0,
          ProgrammeStartDate = _today
        };
      }
      else
      {
        throw new InvalidOperationException("A trainee profile id or user id is required.");
      }
    }
    catch (Exception exception)
    {
      _errorMessage = exception.Message;
    }
    finally
    {
      _loading = false;
    }
  }

  private CurriculumChoiceDto? ResolveDefaultCurriculum(PendingTraineeDto pendingUser)
  {
    if (pendingUser.SubSpecialityIds.Count > 0)
    {
      return _curricula.FirstOrDefault(entity => pendingUser.SubSpecialityIds.Contains(entity.SubSpecialityId));
    }

    if (pendingUser.SpecialityIds.Count > 0)
    {
      return _curricula.FirstOrDefault(entity => pendingUser.SpecialityIds.Contains(entity.SpecialityId));
    }

    return _curricula.FirstOrDefault();
  }

  private const string NothingAdopted =
    "This institution has adopted no curriculum yet, so no trainee can be admitted. Adopt one under Curriculum adoptions, " +
    "then admit the trainee.";

  private string Subtitle => _isAdmission
    ? "Admit a pending trainee into a curriculum."
    : _model?.IsEnded == true
      ? "The record of a programme that has ended."
      : "Update curriculum and completion details for this trainee.";

  private async Task SaveAsync()
  {
    if (_model is null || Busy)
    {
      return;
    }

    _saving = true;
    _errorMessage = null;
    _statusMessage = null;
    _endRefused = false;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      if (_isAdmission)
      {
        var result = await Sender.Send(new AdmitTraineeCommand(
          _model.UserId,
          _model.CurriculumId,
          _model.ProgrammeStartDate,
          _model.ExpectedCompletionDate,
          authState.User));

        NavigationManager.NavigateTo($"/admin/trainees/edit?id={result.Id}", forceLoad: false);
        return;
      }

      var saved = await Sender.Send(new UpdateTraineeProfileCommand(
        _model.Id,
        _model.CurriculumId,
        _model.ProgrammeStartDate,
        _model.ExpectedCompletionDate,
        authState.User));

      // A move, or a change of programme start, says what its replay checked (T304).
      _statusMessage = saved.Message;

      // The form reads the profile as saved: an expected completion left empty is the one the server derived. After a
      // move the pinned version has changed, and with it what the picker may offer, so it is asked again.
      _model.CurriculumId = saved.Profile.CurriculumId;
      _model.CurriculumLabel = $"{saved.Profile.CurriculumName} ({saved.Profile.CurriculumVersion})";
      _model.ProgrammeStartDate = saved.Profile.ProgrammeStartDate;
      _model.ExpectedCompletionDate = saved.Profile.ExpectedCompletionDate;
      _model.StoredProgrammeStartDate = saved.Profile.ProgrammeStartDate;
      _model.StoredExpectedCompletionDate = saved.Profile.ExpectedCompletionDate;
      _curricula = await Sender.Send(new GetTraineeCurriculumChoicesQuery(_model.Id, authState.User));
      _focusResult = true;
    }
    catch (Exception exception)
    {
      _errorMessage = exception.Message;
    }
    finally
    {
      _saving = false;
    }
  }

  // Each names what the day does that cannot be undone (T281 review, DESIGN.md § Button system): encounters observed after
  // it stop counting, including any already counted, and neither the day nor the profile can be changed back.
  private const string AfterTheDay =
    " Encounters observed after that day will count towards nothing in this programme, including any already counted.";

  private string DeactivateBody => _model is null
    ? string.Empty
    : $"Deactivate {_model.FullName}'s profile, with {_model.EndDate:yyyy-MM-dd} as their last day in the programme?" +
      AfterTheDay + " The day cannot be changed afterwards, and a deactivated profile cannot be made active again.";

  private string CompleteBody => _model is null
    ? string.Empty
    : $"Record {_model.EndDate:yyyy-MM-dd} as {_model.FullName}'s graduation day? The profile is archived, the Trainee " +
      "role is removed and a graduation email is sent." + AfterTheDay +
      " The day cannot be changed afterwards, and this cannot be undone.";

  private async Task AskAsync(ConfirmDialog? dialog)
  {
    if (Busy || dialog is null)
    {
      return;
    }

    await dialog.ShowAsync();
  }

  private Task DeactivateAsync() => EndAsync(
    (id, day, principal) => new DeactivateTraineeProfileCommand(id, day, principal),
    day =>
    {
      _model!.DeactivatedOn = day;
      return $"Trainee profile deactivated. Their last day in the programme is recorded as {day:yyyy-MM-dd}.";
    });

  private Task CompleteAsync() => EndAsync(
    (id, day, principal) => new CompleteTraineeProfileCommand(id, day, principal),
    day =>
    {
      _model!.CompletedOn = day;
      return "Trainee marked complete. The Trainee role has been removed and a graduation email sent.";
    });

  /// <remarks>
  /// Sent at most once at a time: the flag is set before the first await, so a second confirm that reaches the circuit
  /// before the re-render does nothing. The result takes the focus in <see cref="OnAfterRenderAsync" />, done or refused.
  /// </remarks>
  private async Task EndAsync(Func<int, DateOnly, ClaimsPrincipal, IRequest> command, Func<DateOnly, string> ended)
  {
    if (_model is null || _model.Id <= 0 || Busy)
    {
      return;
    }

    _ending = true;
    _errorMessage = null;
    _statusMessage = null;
    _endRefused = false;
    var day = _model.EndDate;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await Sender.Send(command(_model.Id, day, authState.User));
      _model.IsActive = false;
      _statusMessage = ended(day);
    }
    catch (Exception exception)
    {
      _errorMessage = exception.Message;
      _endRefused = true;
    }
    finally
    {
      _ending = false;
      _focusResult = true;
    }
  }

  /// <remarks>
  /// The result takes the focus here, once the browser has acknowledged the render that follows the action. By then the
  /// dialog is closed: ConfirmDialog asks the browser to close it as soon as the action returns, and while a modal dialog
  /// is open nothing outside it can take the focus (DESIGN.md § Button system, T206).
  /// </remarks>
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusResult)
    {
      _focusResult = false;
      await _result.FocusAsync();
    }
  }

  private sealed class TraineeProfileFormModel
  {
    public int Id { get; set; }
    public string UserId { get; set; } = string.Empty;
    public string Email { get; set; } = string.Empty;
    public string FullName { get; set; } = string.Empty;

    [Required]
    [Range(1, int.MaxValue)]
    public int CurriculumId { get; set; }

    /// <summary>The curriculum as the read-only details list names it: its name and version, as stored.</summary>
    public string CurriculumLabel { get; set; } = string.Empty;

    /// <summary>The programme start as stored, which the read-only details list shows: the field may hold an unsaved edit.</summary>
    public DateOnly StoredProgrammeStartDate { get; set; }

    /// <summary>The expected completion as stored.</summary>
    public DateOnly? StoredExpectedCompletionDate { get; set; }

    [Required]
    public DateOnly ProgrammeStartDate { get; set; }

    public DateOnly? ExpectedCompletionDate { get; set; }
    public bool IsActive { get; set; } = true;
    public DateOnly? CompletedOn { get; set; }
    public DateOnly? DeactivatedOn { get; set; }

    /// <summary>
    /// Ended and archived, so read-only (T305): <c>TraineeProfile.IsEnded</c>, an inactive profile. Read from
    /// <see cref="IsActive" />, which loads from the profile and which the end actions clear when they answer.
    /// </summary>
    public bool IsEnded => !IsActive;

    /// <summary>
    /// The last day in the programme, which Mark complete and Deactivate each record (T209). Set to today on the South
    /// African calendar when the page loads, not the server's local date.
    /// </summary>
    public DateOnly EndDate { get; set; }
  }
}

@page "/admin/trainees/edit"
@attribute [Authorize(Policy = "AdministratorOrInstitutionalAdmin")]
@using System.Security.Claims
@using MediatR
@using Wombat.Application.Features.Curricula.Quota
@inject IScopedSender Sender
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TimeProvider Clock
@inject IJSRuntime JS
@inject ILogger<TraineeProfileEdit> Logger

<PageTitle>@Title · Wombat</PageTitle>

@*
  A trainee's programme (T379, flow 13; boards P01–P25): "‹name›'s programme", in flow 12's column of sections (.user-page).
  A running programme: the summary (Status, Email), Profile details with Save profile, and End this programme, where the
  last day is checked when Mark complete… or Deactivate… is pressed, before any dialog (Q21, S19), and each dialog names the
  day, the address and what the end would take back (M2, F8). An ended one: the outcome first, the details read-only (T305)
  and the account it belongs to now (F5). Every action's result shows where its focus goes (A5), one at a time. Until T379
  the page was "Trainee profile", printed its read's exception (T329), and offered Back to trainees.
*@
<PageHeader Title="@Title" Subtitle="@Subtitle" Actions="@HeaderActions" />

@if (_traineeNote is not null)
{
  @* T278, T290: the note, asked before any read; standing content, no role. *@
  <div class="user-page">
    <Alert Kind="info" Role="" Id="trainee-profile-trainee-note">@_traineeNote</Alert>
  </div>
}
else
{
  <div class="user-page" aria-busy="@(_loading ? "true" : null)">
    <StatePanel IsLoading="_loading" LoadError="@_loadError" OnRetry="RetryAsync" FocusAfterRetry="FocusHeadingAsync">
      <LoadingContent>
        <p class="loading-line" role="status">@TraineeProfileWords.Loading</p>
        @for (var card = 0; card < 3; card++)
        {
          <div class="detail-card" aria-hidden="true">
            <div class="skeleton skel-title"></div>
            <div class="skeleton skel-line"></div>
            <div class="skeleton skel-line skel-short"></div>
          </div>
        }
      </LoadingContent>
      <ChildContent>
        @if (_profile is not { } profile)
        {
          @* S4, P12, P13: one page for an unknown id and another institution's, so the id space discloses nothing. *@
          <div class="detail-card detail-card--empty">
            <div class="state-panel-copy">@TraineeProfileWords.UnavailableBody</div>
            <div class="form-actions">
              <a class="btn btn-primary" href="@PortfolioLinks.Trainees"><Icon Name="arrow-right" />@TraineeProfileWords.GoToTrainees</a>
            </div>
          </div>
        }
        else
        {
          @Result(Place.Top)
          @Summary(profile)
          @Details(profile)
          @if (profile.IsActive)
          {
            @EndSection(profile)
          }
          else
          {
            @AccountSection(profile)
          }
        }
      </ChildContent>
    </StatePanel>
  </div>
}

@* P03, P17, P19, P20: Mark complete's confirm is the primary (Q24); the dialog opens on Cancel. *@
<ConfirmDialog @ref="_confirmComplete"
               Title="@(_profile is null ? TraineeProfileWords.CompleteConfirm : TraineeProfileWords.CompleteTitle(_profile.FullName))"
               BodyContent="@CompleteBody"
               ConfirmLabel="@TraineeProfileWords.CompleteConfirm"
               DangerAction="false"
               ReturnFocusId="@CompleteTriggerId"
               OnConfirm="CompleteAsync" />

@* P09, P16: Deactivate's confirm is the filled danger button, only here (Q24). *@
<ConfirmDialog @ref="_confirmDeactivate"
               Title="@(_profile is null ? TraineeProfileWords.DeactivateConfirm : TraineeProfileWords.DeactivateTitle(_profile.FullName))"
               BodyContent="@DeactivateBody"
               ConfirmLabel="@TraineeProfileWords.DeactivateConfirm"
               DangerAction="true"
               ReturnFocusId="@DeactivateTriggerId"
               OnConfirm="DeactivateAsync" />

@code {
  [SupplyParameterFromQuery(Name = "id")]
  public int? Id { get; set; }

  [SupplyParameterFromQuery(Name = "userId")]
  public string? UserId { get; set; }

  /// <summary>The last-day field's id; its refusal is <see cref="EndRefusalId" />, its help <c>FieldHelp.Id</c>'s.</summary>
  internal const string EndDateId = "programme-end-date";

  /// <summary>The refusal under the last day, found on the press (Q21) or the command's own at confirm (P07).</summary>
  internal const string EndRefusalId = "programme-end-refusal";

  internal const string CompleteTriggerId = "end-mark-complete";
  internal const string DeactivateTriggerId = "end-deactivate";
  internal const string CompleteNoteId = "end-mc-note";
  internal const string DeactivateNoteId = "end-dc-note";

  private TraineeProfileDto? _profile;
  private TraineeProfileFormModel? _model;
  private string? _traineeNote;
  private bool _loading = true;
  private string? _loadError;

  /// <summary>
  /// The curricula the picker offers: exactly what the command accepts (T304): a profile's pinned version and the
  /// institution's active adoption for the discipline. Admission is Admit ‹name›'s (T373).
  /// </summary>
  private IReadOnlyList<CurriculumChoiceDto> _curricula = [];

  /// <summary>
  /// Today on the South African calendar when the page was read: the last day's default only. The press reads its own
  /// today (B2). Never the server's date (T325).
  /// </summary>
  private DateOnly _today;

  /// <summary>
  /// The last day as typed, kept as typed through a refusal (S19). Nullable, so an emptied field reaches the press check
  /// (S3, P23) rather than the browser's own refusal.
  /// </summary>
  private DateOnly? _endDate;

  /// <summary>The refusal under the last day, or null.</summary>
  private string? _endRefusal;
  private bool _focusEndDate;

  /// <summary>What the dialog that is open says the end would take back (M2), for the day it names.</summary>
  private TakeBackForecastDto? _forecast;

  /// <summary>The day the open dialog names: what was typed when its trigger was pressed.</summary>
  private DateOnly _askedDay;

  private ConfirmDialog? _confirmDeactivate;
  private ConfirmDialog? _confirmComplete;

  // One result on the page at a time (A5): where it shows, and what it says.
  private enum Place { None, Top, Details, End }
  private Place _resultPlace;
  private string? _resultLead;
  private string? _resultRest;
  private bool _resultRefused;

  // A new region for every result, so each takes the focus as it is drawn (ActionResult's FocusOnLoad).
  private int _resultKey;

  /// <summary>A save has been sent and has not yet answered (T234).</summary>
  private bool _saving;

  /// <summary>An end, or the forecast its dialog reads, has been sent and has not yet answered.</summary>
  private bool _ending;

  /// <summary>The old admission address has been sent on to Admit (T373).</summary>
  private bool _redirected;

  private bool Busy => _saving || _ending;

  private string Title => _traineeNote is not null || _loading || _loadError is not null
    ? TraineeProfileWords.Heading
    : _profile is null ? TraineeProfileWords.UnavailableTitle : PortfolioWords.ProgrammeOf(_profile.FullName);

  private string? Subtitle => _profile is null || _loading || _loadError is not null || _traineeNote is not null
    ? null
    : _profile.IsActive ? TraineeProfileWords.ActiveSubtitle : TraineeProfileWords.EndedSubtitle;

  /// <summary>F1: "Export ‹name›'s portfolio" in the header's actions, only where the export would not be refused.</summary>
  private RenderFragment? HeaderActions => _profile is { MayExport: true, IsErased: false } && !_loading && _loadError is null
    ? ExportAction
    : null;

  private RenderFragment ExportAction => __builder =>
  {
    if (_profile is { } profile)
    {
      <ExportPortfolioAction TraineeUserId="@profile.UserId" TraineeName="@profile.FullName" MayExport="profile.MayExport" />
    }
  };

  protected override async Task OnParametersSetAsync()
  {
    // T373 (flow 11): admission is Admit ‹name›'s, a page of its own. The old address lands there, outside the read's
    // catch (a redirect while prerendering is an exception the framework answers).
    if (!Id.HasValue && !string.IsNullOrWhiteSpace(UserId))
    {
      if (!_redirected)
      {
        _redirected = true;
        NavigationManager.NavigateTo(OnboardingLinks.Admit(UserId), replace: true);
      }

      return;
    }

    _today = QuotaCalendar.Today(Clock);
    ClearResult();
    _fieldErrors.Clear();
    _endRefusal = null;
    await LoadAsync();
  }

  private async Task LoadAsync()
  {
    _loading = true;
    _loadError = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

      // Asked before anything is read, as the handlers refuse before they look anything up (T278, T290).
      _traineeNote = TraineeAdministrationRules.TraineeNoteOnTraineePages(authState.User);
      if (_traineeNote is not null)
      {
        _profile = null;
        return;
      }

      // No id at all reads as an unknown one: the page's own not-found state (T373).
      var profile = Id is { } id ? await Sender.Send(new GetTraineeProfileByIdQuery(id, authState.User)) : null;

      // An ended profile is read, not edited (T305), so it needs no picker.
      _curricula = profile is { IsActive: true }
        ? await Sender.Send(new GetTraineeCurriculumChoicesQuery(profile.Id, authState.User))
        : [];
      Show(profile);
      _endDate = _today;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      // T329, S4: the failure to the log, fixed words on the page.
      Logger.LogError(exception, "The trainee profile {ProfileId} could not be read.", Id);
      _profile = null;
      _model = null;
      _loadError = TraineeProfileWords.LoadFailed;
    }
    finally
    {
      _loading = false;
    }
  }

  private void Show(TraineeProfileDto? profile)
  {
    _profile = profile;
    _model = profile is null
      ? null
      : new TraineeProfileFormModel
      {
        CurriculumId = profile.CurriculumId,
        ProgrammeStartDate = profile.ProgrammeStartDate,
        ExpectedCompletionDate = profile.ExpectedCompletionDate
      };
  }

  private Task RetryAsync() => LoadAsync();

  private ValueTask FocusHeadingAsync() => PageFocus.FocusHeadingAsync(JS);

  // ─── Results ───────────────────────────────────────────────────────────

  private void ClearResult()
  {
    _resultPlace = Place.None;
    _resultLead = null;
    _resultRest = null;
    _resultRefused = false;
  }

  private void ShowResult(Place place, string lead, string? rest = null, bool refused = false)
  {
    _resultPlace = place;
    _resultLead = lead;
    _resultRest = rest;
    _resultRefused = refused;
    _resultKey++;
  }

  private RenderFragment Result(Place place) => __builder =>
  {
    if (_resultPlace == place && _resultLead is not null)
    {
      <ActionResult @key="_resultKey" FocusOnLoad="true">
        @if (_resultRefused)
        {
          @* A refusal in the handler's words is one sentence or more, none bold; a failure's fixed words bold the first (P06). *@
          <Alert Kind="danger">
            @if (_resultRest is null)
            {
              @_resultLead
            }
            else
            {
              <strong>@_resultLead</strong>@(" " + _resultRest)
            }
          </Alert>
        }
        else
        {
          @* A result bolds only its first sentence (BRIEF § 11, flow 11). *@
          <Alert Kind="success"><strong>@_resultLead</strong>@(_resultRest is null ? null : " " + _resultRest)</Alert>
        }
      </ActionResult>
    }
  };

  // ─── The summary (N6, F10) ─────────────────────────────────────────────

  private RenderFragment Summary(TraineeProfileDto profile) => __builder =>
  {
    @* T6: no "Name:" row, no visible heading: the h1 names the trainee. *@
    <dl class="detail-list" aria-label="@TraineeProfileWords.SummaryName">
      <dt>Status</dt>
      <dd>
        @if (profile.IsActive)
        {
          @TraineeProfileWords.Active
        }
        else if (profile.CompletedOn is { } completed)
        {
          <span class="badge @BadgeFor.ProgrammeOutcome(true)">@TraineeProfileWords.Completed</span>@(" " + TraineeProfileWords.Iso(completed))
        }
        else
        {
          <span class="badge @BadgeFor.ProgrammeOutcome(false)">@TraineeProfileWords.Inactive</span>
          @if (profile.DeactivatedOn is { } left)
          {
            @(" " + TraineeProfileWords.LeftTheProgramme(left))
          }
        }
      </dd>
      @if (!profile.IsErased)
      {
        <dt>Email</dt>
        <dd>@Address(profile.Email)</dd>
      }
    </dl>
  };

  /// <summary>An address with a break after its @ (flow 11's M7), in markup, never in a stored string.</summary>
  private static RenderFragment Address(string email) => __builder =>
  {
    var at = email.IndexOf('@', StringComparison.Ordinal);
    if (at < 0)
    {
      @email
    }
    else
    {
      @(email[..(at + 1)])<wbr />@(email[(at + 1)..])
    }
  };

  // ─── Profile details ───────────────────────────────────────────────────

  private RenderFragment Details(TraineeProfileDto profile) => __builder =>
  {
    <section class="detail-card user-section" aria-labelledby="profile-details-heading">
      <h2 id="profile-details-heading">@TraineeProfileWords.DetailsHeading</h2>
      @if (profile.IsEnded || _model is null)
      {
        @* T305: an ended profile is read, not edited. The stored values, never an unsaved edit. *@
        <p>@TraineeProfileWords.EndedLine</p>
        <dl class="detail-list">
          <dt>Curriculum</dt>
          <dd class="readonly-value">@($"{profile.CurriculumName} ({profile.CurriculumVersion})")</dd>
          <dt>Programme start date</dt>
          <dd class="readonly-value">@TraineeProfileWords.Iso(profile.ProgrammeStartDate)</dd>
          <dt>Expected completion date</dt>
          <dd class="readonly-value">@TraineeProfileWords.Iso(profile.ExpectedCompletionDate)</dd>
        </dl>
      }
      else
      {
        @Result(Place.Details)
        @* novalidate, no summary (P4): the page's own checks, each refusal under its field, marked, described by it and the
           first one focused, as End this programme's last day and every flow 13 form. *@
        <EditForm Model="_model" OnSubmit="SaveAsync" FormName="trainee-profile" novalidate>

          <div class="form-grid">
            @if (_curricula.Count == 0)
            {
              @* The institution has no active adoption: an empty select would only fail validation. *@
              <p id="curriculum-id-none" class="muted">@NothingAdopted</p>
            }
            else
            {
              <FormField Label="Curriculum" InputId="@CurriculumId" Required="true">
                <ChildContent>
                  <select id="@CurriculumId" class="@InputClass(CurriculumId, "form-select")" aria-required="true"
                          aria-invalid="@Invalid(CurriculumId)" aria-describedby="@RefusalIdIf(CurriculumId)"
                          @bind="_model.CurriculumId" @bind:after="() => ClearField(CurriculumId)">
                    @foreach (var curriculum in _curricula)
                    {
                      <option value="@curriculum.Id">@($"{curriculum.Name} ({curriculum.Version})")</option>
                    }
                  </select>
                </ChildContent>
                <ValidationContent>@FieldRefusal(CurriculumId)</ValidationContent>
              </FormField>
            }

            <FormField Label="Programme start date" InputId="@StartId" Required="true">
              <ChildContent>
                <input id="@StartId" type="date" class="@InputClass(StartId, "form-control")" aria-required="true"
                       aria-invalid="@Invalid(StartId)" aria-describedby="@RefusalIdIf(StartId)"
                       @bind="_model.ProgrammeStartDate" @bind:format="yyyy-MM-dd" @bind:after="() => ClearField(StartId)" />
              </ChildContent>
              <ValidationContent>@FieldRefusal(StartId)</ValidationContent>
            </FormField>

            <FormField Label="Expected completion date" InputId="expected-completion-date" HelpText="@TraineeProfileWords.CompletionHelp">
              <input id="expected-completion-date" type="date" class="form-control" aria-describedby="@FieldHelp.Id("expected-completion-date")"
                     @bind="_model.ExpectedCompletionDate" @bind:format="yyyy-MM-dd" />
            </FormField>
          </div>

          <FormActions>
            <a class="btn btn-outline" href="@PortfolioLinks.Trainees">Cancel</a>
            @* Never natively disabled (T234): it has the focus while its save runs, and a second press sends nothing. *@
            <button type="submit" class="btn btn-primary"
                    aria-disabled="@InFlight.AriaDisabled(_saving || _ending || _curricula.Count == 0)">@(_saving ? "Saving..." : "Save profile")</button>
          </FormActions>
        </EditForm>
      }
    </section>
  };

  private const string NothingAdopted =
    "This institution has adopted no curriculum yet, so no trainee can be admitted. Adopt one under Curriculum adoptions, " +
    "then admit the trainee.";

  private async Task SaveAsync()
  {
    if (_profile is null || _model is null || Busy || _curricula.Count == 0)
    {
      return;
    }

    ClearResult();
    _endRefusal = null;
    _fieldErrors.Clear();
    if (_model.CurriculumId is not > 0)
    {
      _fieldErrors[CurriculumId] = AdmissionText.ChooseCurriculumRefusal;
    }

    if (_model.ProgrammeStartDate is null)
    {
      _fieldErrors[StartId] = AdmissionText.StartRequired;
    }

    if (_fieldErrors.Count > 0)
    {
      _focusField = _fieldErrors.ContainsKey(CurriculumId) ? CurriculumId : StartId;
      return;
    }

    _saving = true;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var saved = await Sender.Send(new UpdateTraineeProfileCommand(
        _profile.Id,
        _model.CurriculumId!.Value,
        _model.ProgrammeStartDate!.Value,
        _model.ExpectedCompletionDate,
        authState.User));

      // A move, or a change of programme start, says what its replay checked (T304). Its first sentence bold.
      var (lead, rest) = FirstSentence(saved.Message);
      ShowResult(Place.Details, lead, rest);

      // The form reads the profile as saved: an expected completion left empty is the one the server derived. After a
      // move the pinned version has changed, and with it what the picker may offer, so it is asked again.
      _profile = _profile with
      {
        CurriculumId = saved.Profile.CurriculumId,
        CurriculumName = saved.Profile.CurriculumName,
        CurriculumVersion = saved.Profile.CurriculumVersion,
        ProgrammeStartDate = saved.Profile.ProgrammeStartDate,
        ExpectedCompletionDate = saved.Profile.ExpectedCompletionDate
      };
      _model.CurriculumId = saved.Profile.CurriculumId;
      _model.ProgrammeStartDate = saved.Profile.ProgrammeStartDate;
      _model.ExpectedCompletionDate = saved.Profile.ExpectedCompletionDate;
      _curricula = await Sender.Send(new GetTraineeCurriculumChoicesQuery(_profile.Id, authState.User));
    }
    catch (Exception exception) when (exception is FluentValidation.ValidationException or UnauthorizedAccessException or InvalidOperationException)
    {
      // The handler's own refusal, in its words.
      ShowResult(Place.Details, RefusalText.Of(exception), refused: true);
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogError(exception, "The trainee profile {ProfileId} could not be saved.", _profile.Id);
      ShowResult(Place.Details, TraineeProfileWords.SaveFailedLead, TraineeProfileWords.SaveFailedRest, refused: true);
    }
    finally
    {
      _saving = false;
    }
  }

  private const string CurriculumId = "curriculum-id";
  private const string StartId = "programme-start-date";

  /// <summary>The details form's refusals by field id (P4); the first one takes the focus.</summary>
  private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.Ordinal);
  private string? _focusField;

  private RenderFragment FieldRefusal(string fieldId) => __builder =>
  {
    if (_fieldErrors.TryGetValue(fieldId, out var message))
    {
      <p id="@RefusalId(fieldId)" class="validation-message">@message</p>
    }
  };

  private static string RefusalId(string fieldId) => $"{fieldId}-error";

  private string? RefusalIdIf(string fieldId) => _fieldErrors.ContainsKey(fieldId) ? RefusalId(fieldId) : null;

  private string? Invalid(string fieldId) => _fieldErrors.ContainsKey(fieldId) ? "true" : null;

  private string InputClass(string fieldId, string baseClass)
    => _fieldErrors.ContainsKey(fieldId) ? $"{baseClass} input-validation-error" : baseClass;

  private void ClearField(string fieldId) => _fieldErrors.Remove(fieldId);

  private static (string Lead, string? Tail) FirstSentence(string message)
  {
    var stop = message.IndexOf(". ", StringComparison.Ordinal);
    return stop < 0 ? (message, null) : (message[..(stop + 1)], message[(stop + 2)..]);
  }

  // ─── End this programme ────────────────────────────────────────────────

  private RenderFragment EndSection(TraineeProfileDto profile) => __builder =>
  {
    var describedBy = _endRefusal is null
      ? FieldHelp.Id(EndDateId)
      : $"{EndRefusalId} {FieldHelp.Id(EndDateId)}";
    @* A2: the section itself, no form element: the triggers are buttons that ask first. N14: the h2 takes no tabindex. *@
    <section class="detail-card user-section" aria-labelledby="end-heading">
      <h2 id="end-heading">@TraineeProfileWords.EndHeading</h2>
      @Result(Place.End)
      @if (profile.LastRatifiedDecision is { } decision)
      {
        @* Q13: read, gating nothing. *@
        <p>@TraineeProfileWords.LastDecision(decision)</p>
      }
      <div class="form-group">
        <label for="@EndDateId">
          @TraineeProfileWords.LastDayLabel
          <span aria-hidden="true">*</span>
          <span class="visually-hidden">required</span>
        </label>
        <input id="@EndDateId" type="date" class="form-control @(_endRefusal is null ? null : "input-validation-error")"
               aria-required="true" aria-describedby="@describedBy" aria-invalid="@(_endRefusal is null ? null : "true")"
               @bind="_endDate" @bind:format="yyyy-MM-dd" />
        @if (_endRefusal is not null)
        {
          @* S19: beside its field, read at once, the typed day kept. *@
          <div class="validation-message" id="@EndRefusalId" role="alert">@_endRefusal</div>
        }
        <p class="field-help" id="@FieldHelp.Id(EndDateId)">@TraineeProfileWords.LastDayHelp</p>
      </div>
      <ul class="role-rows">
        <li class="role-row">
          <span class="role-row-note" id="@CompleteNoteId">@TraineeProfileWords.GraduationNote(profile.FullName)</span>
          <button type="button" id="@CompleteTriggerId" class="btn btn-outline btn-sm" aria-haspopup="dialog"
                  aria-describedby="@CompleteNoteId" aria-disabled="@InFlight.AriaDisabled(Busy)"
                  @onclick="() => AskAsync(_confirmComplete)">@TraineeProfileWords.MarkCompleteTrigger</button>
        </li>
        <li class="role-row">
          <span class="role-row-note" id="@DeactivateNoteId">@TraineeProfileWords.WithdrawalNote</span>
          <button type="button" id="@DeactivateTriggerId" class="btn btn-outline btn-sm" aria-haspopup="dialog"
                  aria-describedby="@DeactivateNoteId" aria-disabled="@InFlight.AriaDisabled(Busy)"
                  @onclick="() => AskAsync(_confirmDeactivate)">@TraineeProfileWords.DeactivateTrigger</button>
        </li>
      </ul>
    </section>
  };

  /// <summary>
  /// Q21, S3, S19: the day is checked first, by the rule both ends are held to (<c>TraineeProfile.EndDayRefusal</c>); a
  /// refusal stays under the field with the focus in it, and no dialog opens. Otherwise the dialog opens with what the end
  /// would take back for that day (M2), read now.
  /// </summary>
  private async Task AskAsync(ConfirmDialog? dialog)
  {
    if (Busy || dialog is null || _profile is null)
    {
      return;
    }

    ClearResult();
    // The South African today at the press, as the command reads it (B2): a page left open past midnight is not held to
    // the day it was opened on.
    _endRefusal = TraineeProfileWords.LastDayRefusal(_endDate, _profile.ProgrammeStartDate, QuotaCalendar.Today(Clock));
    if (_endRefusal is not null)
    {
      _focusEndDate = true;
      return;
    }

    _askedDay = _endDate!.Value;
    _ending = true;
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _forecast = await Sender.Send(new GetTakeBackForecastQuery(_profile.Id, _askedDay, authState.User));
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      // A forecast only: the dialog still says that encounters after the day stop counting, without the count.
      Logger.LogWarning(exception, "The take-back forecast for trainee profile {ProfileId} could not be read.", _profile.Id);
      _forecast = null;
    }
    finally
    {
      _ending = false;
    }

    await dialog.ShowAsync();
  }

  private RenderFragment CompleteBody => __builder =>
  {
    if (_profile is { } profile)
    {
      <p>
        @if (string.IsNullOrWhiteSpace(profile.Email))
        {
          @TraineeProfileWords.CompleteRecordNoAddress(profile.FullName, _askedDay)
        }
        else
        {
          @* F8, S12: the address the email goes to. *@
          @TraineeProfileWords.CompleteRecord(profile.FullName, _askedDay)@Address(profile.Email)@(".")
        }
      </p>
      <p>@TraineeProfileWords.CompleteAfter(profile.FullName, _askedDay, _forecast)</p>
      <p>@TraineeProfileWords.CompleteCannotUndo</p>
    }
  };

  private RenderFragment DeactivateBody => __builder =>
  {
    if (_profile is { } profile)
    {
      <p>@TraineeProfileWords.DeactivateRecord(profile.FullName, _askedDay)</p>
      <p>@TraineeProfileWords.DeactivateAfter(_askedDay, _forecast)</p>
      <p>@TraineeProfileWords.DeactivateCannotUndo</p>
    }
  };

  private Task CompleteAsync() => EndAsync(
    (id, day, principal) => new CompleteTraineeProfileCommand(id, day, principal),
    (_, taken) => (TraineeProfileWords.CompletedLead, Join(TraineeProfileWords.CompletedRest, TraineeProfileWords.TakenBack(taken))));

  private Task DeactivateAsync() => EndAsync(
    (id, day, principal) => new DeactivateTraineeProfileCommand(id, day, principal),
    (day, taken) => (TraineeProfileWords.DeactivatedLead, Join(TraineeProfileWords.DeactivatedRest(day), TraineeProfileWords.TakenBack(taken))));

  private static string Join(string first, string? second) => second is null ? first : $"{first} {second}";

  /// <remarks>
  /// Sent at most once at a time: the flag is set before the first await. Done, the result shows at the ended record's top
  /// (P05, P11), built from what the command took back (F2), and the record is read again for its account; refused by the
  /// command (P07), its words under the field with the focus in it; failed otherwise (P06), fixed words at the section's
  /// top, logged. The focus moves after the render that follows, once the dialog has closed (T206).
  /// </remarks>
  private async Task EndAsync(
    Func<int, DateOnly, ClaimsPrincipal, IRequest<ProgrammeEndResult>> command,
    Func<DateOnly, int, (string Lead, string Tail)> ended)
  {
    if (_profile is null || Busy)
    {
      return;
    }

    _ending = true;
    ClearResult();
    _endRefusal = null;
    var day = _askedDay;
    var profileId = _profile.Id;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var result = await Sender.Send(command(profileId, day, authState.User));
      var (lead, rest) = ended(day, result.TakenBack);

      try
      {
        // The record as it now stands: its end, and the account it belongs to (F5).
        var reread = await Sender.Send(new GetTraineeProfileByIdQuery(profileId, authState.User));
        Show(reread ?? _profile with { IsActive = false });
      }
      catch (Exception exception) when (exception is not OperationCanceledException)
      {
        Logger.LogError(exception, "The trainee profile {ProfileId} could not be read after its end.", profileId);
        Show(_profile with { IsActive = false });
      }

      ShowResult(Place.Top, lead, rest);
    }
    catch (Exception exception) when (exception is UnauthorizedAccessException or InvalidOperationException or FluentValidation.ValidationException)
    {
      // P07: the command's own check, behind the press-time one, in the same place.
      _endRefusal = RefusalText.Of(exception);
      _focusEndDate = true;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogError(exception, "The programme of trainee profile {ProfileId} could not be ended.", profileId);
      ShowResult(Place.End, TraineeProfileWords.EndFailedLead, TraineeProfileWords.EndFailedRest, refused: true);
    }
    finally
    {
      _ending = false;
    }
  }

  // ─── The account (F5, S5) ──────────────────────────────────────────────

  private RenderFragment AccountSection(TraineeProfileDto profile) => __builder =>
  {
    @* Nothing for an erased person, who has no account. *@
    if (profile.IsErased || profile.Account is not { } account)
    {
      return;
    }

    <section class="detail-card user-section" aria-labelledby="account-heading">
      <h2 id="account-heading">@TraineeProfileWords.AccountHeading</h2>
      @if (TraineeProfileWords.AccountSentence(profile.FullName, account) is { } sentence)
      {
        <p>@sentence</p>
      }
      <p class="account-open"><a href="@PeopleLinks.User(profile.UserId)">@TraineeProfileWords.OpenUserPage(profile.FullName)</a></p>
    </section>
  };

  /// <remarks>
  /// The refusal under the last day takes the focus into the field once it is drawn (S19); after a confirm, once the dialog
  /// has closed, as every result does (T206). Results take their own focus (ActionResult's FocusOnLoad).
  /// </remarks>
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusEndDate)
    {
      _focusEndDate = false;
      await PageFocus.FocusByIdAsync(JS, EndDateId);
    }

    if (_focusField is { } field)
    {
      _focusField = null;
      await PageFocus.FocusByIdAsync(JS, field);
    }
  }

  private sealed class TraineeProfileFormModel
  {
    // Nullable, so a cleared field reaches the page's own check (P4) rather than a parse error in a summary.
    public int? CurriculumId { get; set; }

    public DateOnly? ProgrammeStartDate { get; set; }

    public DateOnly? ExpectedCompletionDate { get; set; }
  }
}

@page "/admin/epas/new"
@page "/admin/epas/{Id:int}"
@attribute [Authorize(Policy = "NationalCatalogueAccess")]
@inject IScopedSender Sender
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(IsNew ? "Create EPA" : "Edit EPA")</PageTitle>

<PageHeader Title="@(IsNew ? "Create EPA" : "Edit EPA")" Subtitle="Define the EPA code, scope, and descriptive guidance." >
  <Actions>
    <a class="btn btn-outline btn-sm" href="/admin/epas">Back to EPAs</a>
  </Actions>
</PageHeader>

@* What a save or a deactivation did. It takes the focus once a Save or a deactivation is done (T234; DESIGN.md § Button
   system): "EPA saved.", or what reactivating credited, arriving on its own is often not read, and the Deactivate
   button that deactivated the EPA is gone (T196 review). A refused Save leaves the focus where it was, on Save or the
   field Enter was pressed in, and a refused deactivation leaves Deactivate, to which the dialog hands the focus back:
   the refusal is an alert, read at once. *@
<div @ref="_result" class="action-result" tabindex="-1">
  @if (!string.IsNullOrWhiteSpace(_statusMessage))
  {
    <Alert Kind="success">@_statusMessage</Alert>
  }

  @if (!string.IsNullOrWhiteSpace(_errorMessage))
  {
    <Alert Kind="danger">@_errorMessage</Alert>
  }
</div>

<StatePanel IsLoading="_loading" IsEmpty="false" EmptyTitle="" EmptyBody="">
  <div class="form-container">
    <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="epa-edit">
      <DataAnnotationsValidator />
      <ValidationSummary class="validation-summary-errors" />

      <div class="form-grid form-grid--wide">
        <FormField Label="Sub-speciality" InputId="epa-sub-speciality" Required="true">
          <InputSelect id="epa-sub-speciality" class="form-select" TValue="int" @bind-Value="_model.SubSpecialityId">
            @foreach (var option in SubSpecialityOptions)
            {
              <option value="@option.Id">@option.Label</option>
            }
          </InputSelect>
        </FormField>

        <FormField Label="Code" InputId="epa-code" Required="true">
          <InputText id="epa-code" class="form-control" @bind-Value="_model.Code" />
          <ValidationMessage For="() => _model.Code" />
        </FormField>

        <FormField Label="Title" InputId="epa-title" Required="true" FullWidth="true">
          <InputText id="epa-title" class="form-control" @bind-Value="_model.Title" />
          <ValidationMessage For="() => _model.Title" />
        </FormField>

        <FormField Label="Description" InputId="epa-description" FullWidth="true">
          <InputTextArea id="epa-description" class="form-control" @bind-Value="_model.Description" />
          <ValidationMessage For="() => _model.Description" />
        </FormField>

        <FormField Label="Required knowledge and skills" InputId="epa-rks" FullWidth="true">
          <InputTextArea id="epa-rks" class="form-control" @bind-Value="_model.RequiredKnowledgeSkills" />
          <ValidationMessage For="() => _model.RequiredKnowledgeSkills" />
        </FormField>

        <FormField Label="Category" InputId="epa-category" Required="true">
          <InputSelect id="epa-category" class="form-select" @bind-Value="_model.Category">
            @foreach (var category in Enum.GetValues<EpaCategory>())
            {
              <option value="@category">@category</option>
            }
          </InputSelect>
        </FormField>

        @if (!IsNew)
        {
          @* T158. The help text is the checkbox's description, not only text beside it (T193: FormField gives it the id). *@
          <FormField Label="Status" InputId="epa-active" HelpText="@ActiveHelpText">
            <div class="form-check">
              <InputCheckbox id="epa-active" class="form-check-input" @bind-Value="_model.IsActive" aria-describedby="@FieldHelp.Id("epa-active")" />
              <label for="epa-active">Active</label>
            </div>
          </FormField>
        }
      </div>

      <FormActions>
        <a class="btn btn-outline" href="/admin/epas">Cancel</a>
        @* T196. Deactivate is offered only on an EPA that is active as stored; an inactive one is reactivated by ticking
           Active and saving. *@
        @if (!IsNew && _storedIsActive)
        {
          <button type="button" class="btn btn-outline" @onclick="AskDeactivateAsync" disabled="@Busy">Deactivate</button>
        }
        @* Not disabled while its own save runs (T234): it has the focus then, and a browser drops the focus of a button
           it disables, to the page. A second press sends nothing (SaveAsync). *@
        <button type="submit" class="btn btn-primary" disabled="@_deactivating" aria-disabled="@InFlight.AriaDisabled(_saving)">@(_saving ? "Saving..." : "Save")</button>
      </FormActions>
    </EditForm>
  </div>
</StatePanel>

@* A destructive action opens a ConfirmDialog first (DESIGN.md § Button system). Since T158 deactivating an EPA takes
   its items off every progress page and pauses their credit, in every institution that has adopted the curriculum.
   Two actions deactivate, the Deactivate button and saving with Active unticked (T196), and both open this dialog. *@
<ConfirmDialog @ref="_confirmDeactivate"
               Title="Deactivate this EPA?"
               Body="It can no longer be chosen for a new activity, and it stops being a target on every progress page and dashboard, for every institution that uses it. The progress it has earned is kept. An activity completed against it while it is inactive counts towards nothing until it is reactivated. You can reactivate it on this page."
               ConfirmLabel="Deactivate"
               DangerAction="true"
               OnConfirm="ConfirmDeactivationAsync"
               OnCancel="CancelDeactivation" />

@code {
  [Parameter]
  public int? Id { get; set; }

  private readonly EpaFormModel _model = new();
  private ConfirmDialog? _confirmDeactivate;
  private ElementReference _result;

  // A save or a deactivation is done: its result takes the focus after the next render.
  private bool _focusResult;

  internal ElementReference ResultRegion => _result;
  private IReadOnlyList<InstitutionDto> _institutions = [];
  private IReadOnlyList<SpecialityDto> _specialities = [];
  private IReadOnlyList<SubSpecialityDto> _subSpecialities = [];
  private string? _errorMessage;
  private string? _statusMessage;
  private bool _loading;

  /// <summary>A save has been sent and has not yet answered.</summary>
  private bool _saving;

  /// <summary>A deactivation through the Deactivate button has been sent and has not yet answered.</summary>
  private bool _deactivating;

  /// <summary>Something has been sent and has not answered, so nothing else may be sent.</summary>
  private bool Busy => _saving || _deactivating;

  // What the database says, as against the checkbox, which the user can untick without saving.
  private bool _storedIsActive = true;

  // Whether the open dialog was opened by Save (with Active unticked) rather than by the Deactivate button: confirming
  // it then saves every edit on the form, not only the deactivation.
  private bool _saveOnConfirm;

  private bool IsNew => !Id.HasValue;

  private const string ActiveHelpText =
    "An inactive EPA cannot be chosen for a new activity and is not a target on any progress page or dashboard. " +
    "Evidence already recorded against it is kept, and so is the progress it earned while it was active. An activity " +
    "completed against it while it is inactive counts towards nothing until the EPA is reactivated, and reactivating " +
    "it credits those activities.";

  private IEnumerable<LookupOption> SubSpecialityOptions =>
    from subSpeciality in _subSpecialities
    join speciality in _specialities on subSpeciality.SpecialityId equals speciality.Id
    select new LookupOption(subSpeciality.Id, $"{speciality.Name} / {subSpeciality.Name}");

  protected override async Task OnParametersSetAsync()
  {
    _loading = true;
    _errorMessage = null;
    _statusMessage = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _institutions = await Sender.Send(new GetInstitutionsListQuery(authState.User));
      _specialities = await Sender.Send(new GetSpecialitiesListQuery(authState.User));
      _subSpecialities = await Sender.Send(new GetSubSpecialitiesListQuery(authState.User));

      if (IsNew)
      {
        _model.SubSpecialityId = _subSpecialities.FirstOrDefault()?.Id ?? 0;
        _model.IsActive = true;
        return;
      }

      var epa = await Sender.Send(new GetEpaByIdQuery(Id!.Value, authState.User));

      if (epa is null)
      {
        Navigation.NavigateTo("/not-found");
        return;
      }

      _model.SubSpecialityId = epa.SubSpecialityId;
      _model.Code = epa.Code;
      _model.Title = epa.Title;
      _model.Description = epa.Description;
      _model.RequiredKnowledgeSkills = epa.RequiredKnowledgeSkills;
      _model.Category = epa.Category;
      _model.IsActive = epa.IsActive;
      _storedIsActive = epa.IsActive;
    }
    catch (Exception exception)
    {
      _errorMessage = exception.Message;
    }
    finally
    {
      _loading = false;
    }
  }

  /// <summary>
  /// Save, unless it would deactivate the EPA: unticking Active and saving is the same action as the Deactivate button, so
  /// it asks the same question first (T196), and the dialog's confirm saves.
  /// </summary>
  /// <remarks>
  /// A press while something is in flight sends nothing (T234). Save is not disabled while its own save runs, so a second
  /// Enter or click reaches here, and the flag, set before the first await, turns it away.
  /// </remarks>
  private async Task SaveAsync()
  {
    if (Busy)
    {
      return;
    }

    if (!IsNew && _storedIsActive && !_model.IsActive && _confirmDeactivate is not null)
    {
      _saveOnConfirm = true;
      await _confirmDeactivate.ShowAsync();
      return;
    }

    await SaveCoreAsync();
  }

  /// <remarks>
  /// A save that is done moves the focus to its result (T234): a plain Save, a reactivating one, and one that deactivates
  /// through the dialog, whose close comes first. Until T234 Save was disabled while it ran, and the focus fell to the
  /// page body. A created EPA leaves for its own page, and the focus with it.
  /// </remarks>
  private async Task SaveCoreAsync()
  {
    _saving = true;
    _errorMessage = null;
    _statusMessage = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

      if (IsNew)
      {
        var created = await Sender.Send(new CreateEpaCommand(_model.SubSpecialityId, _model.Code, _model.Title, EmptyToNull(_model.Description), EmptyToNull(_model.RequiredKnowledgeSkills), _model.Category, authState.User));
        Navigation.NavigateTo($"/admin/epas/{created.Id}", forceLoad: true);
        return;
      }

      var wasActive = _storedIsActive;
      var result = await Sender.Send(new UpdateEpaCommand(Id!.Value, _model.SubSpecialityId, _model.Code, _model.Title, EmptyToNull(_model.Description), EmptyToNull(_model.RequiredKnowledgeSkills), _model.Category, _model.IsActive, authState.User));
      _model.IsActive = result.Epa.IsActive;
      _storedIsActive = result.Epa.IsActive;
      _statusMessage = (wasActive, result.Epa.IsActive) switch
      {
        (false, true) => ReactivatedMessage(result.CompletionsCredited),
        (true, false) => "EPA saved and deactivated.",
        _ => "EPA saved."
      };
      _focusResult = true;
    }
    catch (Exception exception)
    {
      _errorMessage = exception.Message;
    }
    finally
    {
      _saving = false;
    }
  }

  /// <summary>What reactivating credited: the activities completed against the EPA while it was inactive (T196, D48).</summary>
  private static string ReactivatedMessage(int completionsCredited) => completionsCredited switch
  {
    0 => "EPA reactivated. No activity was completed against it while it was inactive, so no progress changed.",
    1 => "EPA reactivated. 1 activity completed against it while it was inactive now counts towards progress.",
    _ => $"EPA reactivated. {completionsCredited} activities completed against it while it was inactive now count towards progress."
  };

  private async Task AskDeactivateAsync()
  {
    if (Busy)
    {
      return;
    }

    _saveOnConfirm = false;
    if (_confirmDeactivate is not null)
    {
      await _confirmDeactivate.ShowAsync();
    }
  }

  private async Task ConfirmDeactivationAsync()
  {
    if (Busy)
    {
      return;
    }

    if (_saveOnConfirm)
    {
      _saveOnConfirm = false;
      await SaveCoreAsync();
      return;
    }

    await DeactivateAsync();
  }

  // Cancelling leaves Active unticked on the form, unsaved; Save asks again.
  private void CancelDeactivation() => _saveOnConfirm = false;

  private async Task DeactivateAsync()
  {
    _deactivating = true;
    _errorMessage = null;
    _statusMessage = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await Sender.Send(new DeactivateEpaCommand(Id!.Value, authState.User));
      _model.IsActive = false;
      _storedIsActive = false;
      _statusMessage = "EPA deactivated.";
      _focusResult = true;
    }
    catch (Exception exception)
    {
      _errorMessage = exception.Message;
    }
    finally
    {
      _deactivating = false;
    }
  }

  /// <remarks>
  /// After a save or a deactivation is done, the focus moves once the browser has acknowledged the render that follows
  /// it. By then any dialog that sent it is closed: ConfirmDialog asks the browser to close it as soon as the action
  /// returns, and while a modal dialog is open nothing outside it can take the focus (as on the MSF campaign pages, T206
  /// review). A refused deactivation leaves the button, and the dialog hands the focus back to it.
  /// </remarks>
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusResult)
    {
      _focusResult = false;
      await _result.FocusAsync();
    }
  }

  private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

  private sealed class EpaFormModel
  {
    [Range(1, int.MaxValue)]
    public int SubSpecialityId { get; set; }

    [Required]
    [StringLength(64)]
    public string Code { get; set; } = string.Empty;

    [Required]
    [StringLength(200)]
    public string Title { get; set; } = string.Empty;

    [StringLength(4000)]
    public string? Description { get; set; }

    [StringLength(8000)]
    public string? RequiredKnowledgeSkills { get; set; }

    public EpaCategory Category { get; set; } = EpaCategory.Core;

    public bool IsActive { get; set; } = true;
  }

  private sealed record LookupOption(int Id, string Label);
}

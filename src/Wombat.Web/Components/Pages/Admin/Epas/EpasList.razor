@page "/admin/epas"
@attribute [Authorize(Policy = "NationalCatalogueAccess")]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ILogger<EpasList> Logger

<PageTitle>EPAs · Wombat</PageTitle>

@*
  The EPA list (T392, flow 15, lane C; boards R2-C01–C03, R3-C09, C15–C17). The EPAs the caller reads, by the list's rule
  (GetEpaListQuery): an Institutional admin's are the national EPAs of the disciplines the institution has adopted and the
  institution's own; a College admin's, the College's; the Administrator's, every one.

  - Whose is what, in words (Q3, F8): an own EPA is marked under its title in .muted .text-sm; a row the caller may not
    change says "Set by the College." in its actions cell (M1), and Edit is offered only where its "may change" says so
    (T291 item 1; the query reads UpdateEpa's rule, S4). Each title is a link to its page: the form, or the national EPA's
    record (Q2).
  - Create EPA, with its plus (round-3-check decision 4), only when it can be completed (Q12, S4); else, with nothing to
    list, Q12's empty state and Go to Curricula (R2-C01).
  - The Administrator's list pages at 20 (P5), the pager only past one page; a page turn focuses the h1.
  - Loading and a failed read (S7, S19, T329): fixed words, Try again, the exception logged.
*@
<PageHeader Title="EPAs" Subtitle="@(_list is null ? null : EpaWords.ListSubtitle(_list))">
  <Actions>
    @if (_list is { MayCreate: true })
    {
      <a class="btn btn-primary" href="@CatalogueLinks.NewEpa">
        <Icon Name="plus" />
        @EpaWords.CreateEpa
      </a>
    }
  </Actions>
</PageHeader>

<div class="people-page epas-page" aria-busy="@(_loading ? "true" : null)">
  <StatePanel IsLoading="_loading" LoadError="@_loadError" OnRetry="RetryAsync" FocusAfterRetry="FocusPageHeadingAsync"
              IsEmpty="@(_list is { Epas.Count: 0 })" EmptyTitle="@EpaWords.EmptyTitle"
              EmptyBody="@(_list is { MayCreate: false } ? EpaWords.EmptyBodyNothingAdopted : EpaWords.EmptyBodyMayCreate)"
              EmptyActions="@(_list is { MayCreate: false } ? GoToCurricula : null)">
    <LoadingContent>
      <p class="loading-line" role="status">@EpaWords.LoadingList</p>
      @for (var card = 0; card < 2; card++)
      {
        <div class="detail-card" aria-hidden="true">
          <div class="skeleton skel-title"></div>
          <div class="skeleton skel-line"></div>
          <div class="skeleton skel-line"></div>
          <div class="skeleton skel-line skel-short"></div>
        </div>
      }
    </LoadingContent>
    <ChildContent>
      @if (_list is { } list)
      {
        @Epas(list)
      }
    </ChildContent>
  </StatePanel>
</div>

@code {
  private static readonly RenderFragment GoToCurricula =
    @<a class="btn btn-primary" href="@CatalogueLinks.Curricula">@EpaWords.GoToCurricula</a>;

  private RenderFragment Epas(EpaListDto list) => __builder =>
  {
    var rows = list.Epas.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    @* T239: each Edit is named by its EPA as every EPA surface writes it, "PAED-001 — Title"; where two rows would read
       the same (an institution's own EPA may share another's code), by whose it is, then its discipline, then its
       College, and numbered as the last resort. *@
    var rowNames = RowNames.Distinct(
      list.Epas, row => row.Id, EpaWords.Label,
      row => EpaWords.OwnerMark(row) is { } mark ? $" ({mark})" : string.Empty,
      row => $" ({row.DisciplineName})",
      row => $" ({row.CollegeName})");
    <DataTable TItem="EpaDto" Items="rows" StackWide="true" Caption="@EpaWords.Caption(list.Reader)">
      <HeaderRow>
        <tr role="row">
          <th scope="col" role="columnheader" class="col-wrap col-wrap--wide">EPA</th>
          <th scope="col" role="columnheader" class="col-wrap">College</th>
          <th scope="col" role="columnheader" class="col-wrap">Sub-speciality</th>
          <th scope="col" role="columnheader">Status</th>
          <th scope="col" role="columnheader"><span class="visually-hidden">Actions</span></th>
        </tr>
      </HeaderRow>
      <Row Context="epa">
        <tr role="row">
          <th scope="row" role="rowheader" class="col-wrap col-wrap--wide">
            <a href="@CatalogueLinks.Epa(epa.Id)">@EpaWords.Label(epa)</a>
            @if (EpaWords.OwnerMark(epa) is { } mark)
            {
              <div class="muted text-sm">@mark</div>
            }
          </th>
          <td role="cell" class="col-wrap" data-label="College">@epa.CollegeName</td>
          <td role="cell" class="col-wrap" data-label="Sub-speciality">@epa.DisciplineName</td>
          <td role="cell" data-label="Status">@EpaWords.Status(epa.IsActive)</td>
          @* Every row says something here: Edit where it may be changed, else why not (M1, T211). *@
          <td role="cell">
            <div class="actions-cell">
              @if (epa.MayChange)
              {
                <a class="btn btn-outline btn-sm" href="@CatalogueLinks.Epa(epa.Id)" aria-label="@($"{EpaWords.Edit} {rowNames[epa.Id]}")">@EpaWords.Edit</a>
              }
              else
              {
                <span class="muted">@EpaWords.SetByTheCollege</span>
              }
            </div>
          </td>
        </tr>
      </Row>
    </DataTable>
    @if (list.Epas.Count > _pageSize)
    {
      <PagerControls Page="_page" PageSize="_pageSize" TotalCount="list.Epas.Count"
                     Label="@EpaWords.PagerLabel" PageSizeLabel="@EpaWords.PageSizeLabel"
                     OnPageChanged="TurnPageAsync" OnPageSizeChanged="ChangePageSizeAsync" />
    }
  };

  private EpaListDto? _list;
  private bool _loading = true;
  private string? _loadError;
  private int _page = 1;
  private int _pageSize = 20;
  private bool _focusHeading;

  protected override Task OnInitializedAsync() => LoadAsync();

  private async Task LoadAsync()
  {
    _loading = true;
    _loadError = null;
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _list = await Sender.Send(new GetEpaListQuery(authState.User));
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      // T329: never the exception's text on the page; the cause goes to the log.
      Logger.LogError(exception, "The EPA list could not be read.");
      _list = null;
      _loadError = EpaWords.ListLoadFailed;
    }
    finally
    {
      _loading = false;
    }
  }

  private Task RetryAsync() => LoadAsync();

  // P5, as flow 04's C10 f: after a page turn the list's heading, the page's h1 (its only one), takes the focus.
  private Task TurnPageAsync(int page)
  {
    _page = page;
    _focusHeading = true;
    return Task.CompletedTask;
  }

  // A change of size leaves the focus on the select (flow 04's build review A1).
  private Task ChangePageSizeAsync(int pageSize)
  {
    _pageSize = pageSize;
    _page = 1;
    return Task.CompletedTask;
  }

  // S7: once a Try again has read, the h1 takes the focus.
  private ValueTask FocusPageHeadingAsync() => PageFocus.FocusHeadingAsync(JS);

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusHeading)
    {
      _focusHeading = false;
      await PageFocus.FocusHeadingAsync(JS);
    }
  }
}

@page "/admin/data-rights"
@attribute [Authorize(Roles = "Administrator,Coordinator")]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Data rights requests · Wombat</PageTitle>

<PageHeader Title="Data rights requests" Subtitle="Review and act on data subject rights requests.">
  <Actions>
    <button class="btn btn-outline" @onclick="ApplyFilters">
      <Icon Name="search" />
      Apply filters
    </button>
  </Actions>
</PageHeader>

@* The list page's filter (DESIGN.md § Table system): a search-container of labelled search fields. Until T266 it was a
   filter-bar, -row and -field, none of which app.css defines. *@
<div class="search-container shadow">
  <div class="search-grid">
    <div class="search-field">
      <label for="data-rights-type">Type</label>
      <select id="data-rights-type" class="form-select" @bind="_filterType">
        <option value="">All</option>
        @foreach (var type in Enum.GetValues<DataRightsRequestType>())
        {
          <option value="@type">@type</option>
        }
      </select>
    </div>
    <div class="search-field">
      <label for="data-rights-status">Status</label>
      <select id="data-rights-status" class="form-select" @bind="_filterStatus">
        <option value="">All</option>
        @foreach (var status in Enum.GetValues<DataRightsRequestStatus>())
        {
          <option value="@status">@status</option>
        }
      </select>
    </div>
  </div>
</div>

<StatePanel IsLoading="@(_result is null && string.IsNullOrWhiteSpace(_errorMessage))" LoadError="@_errorMessage" IsEmpty="@(_result?.Items.Count == 0)" EmptyTitle="No requests" EmptyBody="No data rights requests match the current filters.">
  @if (_result is not null)
  {
    <DataTable TItem="DataRightsRequestSummaryDto" Items="_result.Items" Caption="Data rights requests">
      <HeaderRow>
        <tr>
          <th>Date</th>
          <th>Requester</th>
          <th>Type</th>
          <th>Status</th>
          <th><span class="visually-hidden">Actions</span></th>
        </tr>
      </HeaderRow>
      <Row Context="req">
        <tr>
          <td><code>@req.RequestedOn.ToString("yyyy-MM-dd HH:mm")</code></td>
          <td>@req.RequesterDisplayName</td>
          @* A request's type is not a state, so it is not a badge (DESIGN.md § Badges): the words say it, as on the
             requester's own page. *@
          <td>@req.Type</td>
          <td><span class="badge @BadgeFor.DataRightsRequest(req.Status)">@req.Status</span></td>
          <td>
            @* T239: named by its row: the request's type, who made it, and when. *@
            <a class="btn btn-outline btn-sm" href="/admin/data-rights/@req.Id"
               aria-label="@($"Review the {req.Type} request from {req.RequesterDisplayName}, {req.RequestedOn.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)}")">Review</a>
          </td>
        </tr>
      </Row>
    </DataTable>

    @* The pager's own classes (DESIGN.md § Pager). The page size is fixed here, so it is not PagerControls, which offers
       one. *@
    <div class="pager">
      <span class="pager-info">
        Showing @((_page - 1) * _pageSize + 1)–@(Math.Min(_page * _pageSize, _result.TotalCount)) of @_result.TotalCount
      </span>
      <div class="pager-actions">
        <button class="btn btn-outline btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)">← Previous</button>
        <span class="text-sm">Page @_page</span>
        <button class="btn btn-outline btn-sm" @onclick="NextPage" disabled="@(_page * _pageSize >= _result.TotalCount)">Next →</button>
      </div>
    </div>
  }
</StatePanel>

@code {
  private PagedDataRightsResult? _result;
  private string? _errorMessage;
  private int _page = 1;
  private const int _pageSize = 25;

  private string _filterType = "";
  private string _filterStatus = "";

  protected override async Task OnInitializedAsync()
  {
    await LoadAsync();
  }

  private async Task ApplyFilters()
  {
    _page = 1;
    await LoadAsync();
  }

  private async Task LoadAsync()
  {
    _result = null;
    _errorMessage = null;

    try
    {
      DataRightsRequestType? type = Enum.TryParse<DataRightsRequestType>(_filterType, out var t) ? t : null;
      DataRightsRequestStatus? status = Enum.TryParse<DataRightsRequestStatus>(_filterStatus, out var s) ? s : null;

      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

      _result = await Sender.Send(new Wombat.Application.Features.DataRights.Queries.ListDataRightsRequestsQuery(
        Type: type,
        Status: status,
        RequesterUserId: null,
        Principal: authState.User,
        Page: _page,
        PageSize: _pageSize));
    }
    catch (Exception ex)
    {
      _errorMessage = ex.Message;
    }
  }

  private async Task PreviousPage()
  {
    if (_page > 1) { _page--; await LoadAsync(); }
  }

  private async Task NextPage()
  {
    _page++;
    await LoadAsync();
  }

}

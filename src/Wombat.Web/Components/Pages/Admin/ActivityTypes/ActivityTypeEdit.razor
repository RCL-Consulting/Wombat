@page "/admin/activity-types/new"
@page "/admin/activity-types/{ActivityTypeId:int}"
@* T300: the College writes its disciplines' types (T091), so the builder admits a CollegeAdmin beside an Administrator
   and an InstitutionalAdmin. What each may change there is the editor's CanWrite, the rule the commands refuse by. *@
@attribute [Authorize(Policy = "NationalCatalogueAccess")]
@using Wombat.Domain.Activities
@using Wombat.Domain.Activities.Schema
@using Wombat.Domain.Identity

@*
  The activity type builder (T398, flow 17, lane C; boards R3-B07, C01–C23, D01–D05, E01–E17 and the standing round 2
  boards). The code is ActivityTypeEdit.razor.cs; the words ActivityTypeEditWords and ActivityTypeWords (§ 0).

  - The tabs pattern (Q1, T280): a writer's five tabs (Details, Form, Workflow, Credit, Publish), a reader's four. A new
    type opens on Details, an existing one on Form; a save keeps the tab, and Publish lands on the tab it was pressed from
    (Q20). A tab with refusals carries its count in its name, "Form 1 problem" (M2).
  - One result region under the header, above the tabs at every width (S7): a result stays there until the next save,
    publish or discard; a tab press is none of them (E02b).
  - No Back to list: the trail is the way back (flow 16's Q9).
*@
<PageTitle>@Heading · Wombat</PageTitle>

<PageHeader Title="@Heading" SubtitleContent="@(IsUnavailable ? null : HeaderSubtitle)" Actions="@(HasHeaderActions ? HeaderActions : null)" />

<div class="user-page activity-type-page" aria-busy="@(_loading ? "true" : null)">
  <StatePanel IsLoading="_loading" LoadError="@_loadError" OnRetry="RetryAsync" FocusAfterRetry="FocusHeadingAsync">
    <LoadingContent>
      <p class="loading-line" role="status">@ActivityTypeEditWords.LoadingLine</p>
      <div class="detail-card" aria-hidden="true">
        <div class="skeleton skel-title"></div>
        <div class="skeleton skel-line"></div>
        <div class="skeleton skel-line"></div>
        <div class="skeleton skel-line skel-short"></div>
      </div>
    </LoadingContent>
    <ChildContent>
      @if (IsUnavailable)
      {
        @* R2-B09: an id that names no type, or one the caller may not read, in the page's own place; never forbidden. *@
        <div class="detail-card detail-card--empty">
          <div class="state-panel-copy">@ActivityTypeWords.Unavailable.Body</div>
          <div class="form-actions">
            <a class="btn btn-primary" href="@CatalogueLinks.ActivityTypes">@ActivityTypeWords.Unavailable.GoTo</a>
          </div>
        </div>
      }
      else if (_editor is not null && IsNewRoute && !_editor.CanWrite)
      {
        @* T300, R2-C08-new: a caller admitted to the builder with no scope to create in (a College with no discipline). *@
        <Alert Kind="info" Role="" Id="activity-type-no-scope">@ActivityTypeEditWords.NoScopeNotice</Alert>
      }
      else if (_editor is not null)
      {
        @Builder()
      }
    </ChildContent>
  </StatePanel>
</div>

@* The three questions are a writer's, and Discard's also the scope's on a system-managed type that holds a draft (F1): a
   reader is offered none of their triggers. *@
@if (CanWrite || _discardOffered)
{
  @* Q14: Discard draft… asks; its body by whether a version is published (R3-E07, R2-E09). *@
  <ConfirmDialog @ref="_discardDialog"
                 Title="@ActivityTypeEditWords.DiscardTitle(StoredName)"
                 ConfirmLabel="@ActivityTypeEditWords.DiscardConfirm"
                 DangerAction="true"
                 ReturnFocusId="@DiscardButtonId"
                 OnConfirm="ConfirmDiscardAsync">
    <BodyContent>
      <p>@ActivityTypeEditWords.DiscardBody(_editor?.PublishedVersion ?? 0)</p>
    </BodyContent>
  </ConfirmDialog>
}

@if (CanWrite)
{

  @* Q15, Q17: Active newly unticked on a published type asks first, at Save draft and at Publish (R3-E11, E16). *@
  <ConfirmDialog @ref="_deactivateDialog"
                 Title="@ActivityTypeEditWords.DeactivateTitle(TypedName)"
                 ConfirmLabel="@ActivityTypeEditWords.DeactivateConfirm"
                 DangerAction="true"
                 ReturnFocusId="@(_deactivateFor == PublishAction ? _publishTrigger : SaveButtonId)"
                 OnConfirm="ConfirmDeactivateAsync">
    <BodyContent>
      <p>@ActivityTypeEditWords.DeactivateBody</p>
      <p>@ActivityTypeEditWords.DeactivateReactivate</p>
    </BodyContent>
  </ConfirmDialog>

  @* Q16, S7: Publish asks only on warnings, from the saved draft; its confirm a primary, not a danger (R3-E05). *@
  <ConfirmDialog @ref="_publishDialog"
                 Title="@ActivityTypeEditWords.PublishTitle(NextVersion, StoredName)"
                 ConfirmLabel="@ActivityTypeEditWords.PublishVersion(NextVersion)"
                 DangerAction="false"
                 ReturnFocusId="@_publishTrigger"
                 OnConfirm="ConfirmPublishAsync"
                 OnCancel="PublishQuestionClosedAsync"
                 OnClosed="PublishQuestionClosedAsync">
    <BodyContent>
      <p>@ActivityTypeEditWords.PublishBody(NextVersion)</p>
      <ul>
        @foreach (var warning in _pendingPublish?.Warnings ?? [])
        {
          <li>@warning</li>
        }
      </ul>
      <p>@ActivityTypeEditWords.PinnedLine(_editor?.PublishedVersion ?? 0, _pendingPublish?.Removed ?? [])</p>
    </BodyContent>
  </ConfirmDialog>
}

@code {
  /// <summary>The h1, the tab and the crumb (build-lanes § How's titles, T21): the stored name, never the typed one.</summary>
  private string Heading => IsUnavailable
    ? "Activity type unavailable"
    : IsNewRoute ? "New activity type" : _editor is null ? "Activity type" : _editor.CanWrite ? $"Edit {_editor.Name}" : _editor.Name;

  private RenderFragment HeaderSubtitle => __builder =>
  {
    <text>@ActivityTypeEditWords.Subtitle</text>
    if (OwnerLineText is { } owner)
    {
      @* The owner line under the subtitle (Q12, R3-C07): whose type, in words, then its scope. *@
      <span class="builder-owner-line">@owner</span>
    }
  };

  private RenderFragment HeaderActions => __builder =>
  {
    @* While one of these runs the others are disabled, and the one pressed is not (T234): it has the focus, and a browser
       drops the focus of a button it disables. A second press sends nothing. Save draft and Publish ask Q15's question
       first while Active is newly unticked on a published type (Q15, Q17), so they say they open a dialog. *@
    @if (CanWrite)
    {
      <button type="button" id="@SaveButtonId" class="btn btn-primary" disabled="@OtherInFlight(SaveAction)"
              aria-disabled="@InFlight.AriaDisabled(Running(SaveAction))" aria-haspopup="@(WouldDeactivate ? "dialog" : null)"
              @onclick="SaveDraftAsync">@ActivityTypeEditWords.SaveDraft</button>
      @* S5: with no draft Publish is unavailable, not disabled: aria-disabled with its reason beside it, and inert. *@
      <button type="button" id="@PublishButtonId" class="btn btn-success" disabled="@OtherInFlight(PublishAction)"
              aria-disabled="@(CanPublish ? InFlight.AriaDisabled(Running(PublishAction)) : "true")"
              aria-describedby="@(CanPublish ? null : PublishReasonId)"
              aria-haspopup="@(CanPublish && WouldDeactivate ? "dialog" : null)"
              @onclick="() => PublishAsync(PublishButtonId)">@ActivityTypeEditWords.Publish</button>
      @if (!CanPublish)
      {
        <p class="muted text-sm" id="@PublishReasonId">@ActivityTypeEditWords.PublishReason</p>
      }
    }
    @* F1: on a system-managed type that holds a draft, Discard draft… is the one action, to whoever its scope admits. *@
    @if (CanDiscard)
    {
      <button type="button" id="@DiscardButtonId" class="btn btn-outline" aria-haspopup="dialog" disabled="@OtherInFlight(DiscardAction)"
              aria-disabled="@InFlight.AriaDisabled(Running(DiscardAction))"
              @onclick="AskDiscardAsync">@ActivityTypeEditWords.DiscardDraftTrigger</button>
    }
  };

  private RenderFragment Builder() => __builder =>
  {
    var editor = _editor!;

    @* What a save, a publish or a discard did, or why nothing was saved (S7: above the tabs at every width). *@
    <ActionResult @ref="_result">
      @if (_refusal is not null)
      {
        <RefusalSummary @ref="_summary" Title="@_refusal.Title" Text="@ActivityTypeEditWords.EverythingKept" Lines="@_summaryLines" LineAction="GoToLineAsync" />
      }
      @if (_status is { } status)
      {
        <Alert Kind="success"><strong>@status.Lead</strong>@if (status.Tail is not null){@(" ")@status.Tail}</Alert>
      }
      @if (_failure is { } failure)
      {
        <Alert Kind="danger"><strong>@failure.Lead</strong> @failure.Tail</Alert>
      }
      @if (_guard is not null)
      {
        <Alert Kind="danger">@_guard</Alert>
      }
    </ActionResult>

    @if (!editor.CanWrite)
    {
      @* Standing content, there on every visit, so no role (DESIGN.md § Alerts): whose type it is (T300's words), or, on a
         system-managed type, the release that writes it (Q9, T22). *@
      <Alert Kind="info" Role="" Id="activity-type-read-only">@ReaderNotice</Alert>
    }

    @* No aria-label: a role-less dl is mostly ignored by assistive technology, and "Versions" is a heading on the Publish
       tab and a reader's Details already (the fix pass, pages review N3). *@
    <dl class="detail-list builder-strip">
      <dt>@ActivityTypeEditWords.PublishedTerm</dt>
      <dd>@PublishedText</dd>
      <dt>@ActivityTypeEditWords.DraftTerm</dt>
      <dd>@DraftText</dd>
    </dl>
    @if (CanWrite && editor.IsSeedOwned && editor.HasDraft)
    {
      <p class="muted">@ActivityTypeEditWords.SeedDraftNote</p>
    }

    @* The tabs pattern (Q1, T280; R3-0-spec's S2): a roving tabindex, aria-controls on the selected tab only, Left, Right,
       Home and End move the focus (the key read in C#; wombat.js keeps them from scrolling the page), Enter or Space
       selects. No tab carries an aria-label or aria-describedby: its count is part of its name (M2, N20). *@
    <div class="tab-bar" role="tablist" aria-label="@ActivityTypeEditWords.TabsLabel">
      @foreach (var tab in Tabs)
      {
        var selected = tab == _tab;
        var count = _refusal?.CountOn(tab) ?? 0;
        <button type="button" role="tab" id="@TabId(tab)" class="tab-bar-tab" aria-selected="@(selected ? "true" : "false")"
                tabindex="@(selected ? "0" : "-1")" aria-controls="@(selected ? PanelId(tab) : null)"
                @onclick="() => SelectTab(tab)" @onkeydown="args => OnTabKeyDownAsync(args, tab)">@TabName(tab)@if (count > 0){@(" ")<span class="badge @BadgeFor.State(BadgeState.Declined)">@count<span>@ActivityTypeEditWords.ProblemWord(count)</span></span>}</button>
      }
    </div>

    @switch (_tab)
    {
      case BuilderTab.Details:
        @DetailsPanel(editor)
        break;
      case BuilderTab.Form:
        @FormPanel(editor)
        break;
      case BuilderTab.Workflow:
        @WorkflowPanel(editor)
        break;
      case BuilderTab.Credit:
        @CreditPanel(editor)
        break;
      default:
        @PublishPanel(editor)
        break;
    }
  };

  // ---- Details ----

  private RenderFragment DetailsPanel(ActivityTypeEditorDto editor) => __builder =>
  {
    @if (!editor.CanWrite)
    {
      @* A reader's Details: what is stored, as text, and the versions (T1, R2-B03). No control, so the panel takes the
         focus itself (N21). *@
      <section class="detail-card user-section" role="tabpanel" id="@PanelId(BuilderTab.Details)" aria-labelledby="@TabId(BuilderTab.Details)" tabindex="0">
        <h2>@ActivityTypeEditWords.DetailsHeading</h2>
        <dl class="detail-list">
          <dt>@ActivityTypeEditWords.KeyLabel</dt>
          <dd><code>@editor.Key</code></dd>
          <dt>@ActivityTypeEditWords.NameLabel</dt>
          <dd>@editor.Name</dd>
          <dt>@ActivityTypeEditWords.SetByTerm</dt>
          <dd>@OwnerLineText</dd>
          <dt>@ActivityTypeEditWords.ToolLabel</dt>
          <dd>@WbaToolText</dd>
          <dt>@ActivityTypeEditWords.DescriptionLabel</dt>
          <dd>@(string.IsNullOrWhiteSpace(editor.Description) ? ActivityTypeEditWords.None : editor.Description)</dd>
          <dt>@ActivityTypeEditWords.StatusTerm</dt>
          <dd>@ActivityTypeEditWords.Status(editor.IsActive)</dd>
        </dl>
        <VersionsTable Versions="@editor.Versions" HeadingLevel="2" />
      </section>
      return;
    }

    <section class="detail-card user-section" role="tabpanel" id="@PanelId(BuilderTab.Details)" aria-labelledby="@TabId(BuilderTab.Details)">
      <h2>@ActivityTypeEditWords.DetailsHeading</h2>
      <p class="muted">@ActivityTypeEditWords.DetailsLine</p>
      <p class="muted">@RequiredMark.Line</p>
      <div class="form-grid">
        @if (IsPublished)
        {
          @* A published key never changes ("Published activity type keys cannot be changed." is a guard no page reaches). *@
          <dl class="form-group">
            <dt>@ActivityTypeEditWords.KeyLabel</dt>
            <dd><code>@_key</code></dd>
            <dd class="muted text-sm">@ActivityTypeEditWords.KeyFixed(editor.PublishedVersion)</dd>
          </dl>
        }
        else
        {
          <FormField Label="@ActivityTypeEditWords.KeyLabel" InputId="@KeyInputId" Required="true" HelpText="@ActivityTypeEditWords.KeyHelp">
            <input id="@KeyInputId" class="form-control font-mono" aria-required="true" autocomplete="off"
                   aria-invalid="@Invalid(DetailsRefusal(KeyInputId) is not null)"
                   aria-describedby="@FieldRefusal.DescribedBy(KeyInputId, DetailsRefusal(KeyInputId) is not null, ActivityTypeEditWords.KeyHelp)"
                   @bind="_key" />
            @AtPlace(KeyInputId, DetailsRefusal(KeyInputId))
          </FormField>
        }

        <FormField Label="@ActivityTypeEditWords.NameLabel" InputId="@NameInputId" Required="true">
          <input id="@NameInputId" class="form-control" aria-required="true" autocomplete="off"
                 aria-invalid="@Invalid(DetailsRefusal(NameInputId) is not null)"
                 aria-describedby="@FieldRefusal.DescribedBy(NameInputId, DetailsRefusal(NameInputId) is not null, null)"
                 @bind="_name" />
          @AtPlace(NameInputId, DetailsRefusal(NameInputId))
        </FormField>

        @ScopeControls(editor)

        @* T122. Which College-named instrument this form is. Each curriculum item's tool list then decides which EPAs it
           may be filed against; "Not a WBA instrument" leaves it unrestricted (D21). A stored key the vocabulary no longer
           holds is still listed, so it can be seen and withdrawn. *@
        <FormField Label="@ActivityTypeEditWords.ToolLabel" InputId="type-wba-tool" HelpText="@ActivityTypeEditWords.ToolHelp">
          <select id="type-wba-tool" class="form-select" aria-describedby="@FieldHelp.Id("type-wba-tool")" @bind="_wbaToolKey">
            <option value="">@ActivityTypeEditWords.NotAnInstrument</option>
            @foreach (var tool in WbaToolOptions)
            {
              <option value="@tool.Key">@tool.Name</option>
            }
          </select>
        </FormField>

        <FormField Label="@ActivityTypeEditWords.DescriptionLabel" InputId="@DescriptionInputId" FullWidth="true">
          <textarea id="@DescriptionInputId" class="form-control" rows="3" maxlength="@ActivityTypeEditWords.DescriptionLimit"
                    aria-invalid="@Invalid(DetailsRefusal(DescriptionInputId) is not null)"
                    aria-describedby="@(DetailsRefusal(DescriptionInputId) is not null ? $"{FieldRefusal.Id(DescriptionInputId)} {DescriptionCounterId}" : DescriptionCounterId)"
                    @bind="_description" @bind:event="oninput"></textarea>
          <p class="field-help" id="@DescriptionCounterId">@ActivityTypeEditWords.DescriptionCounter(_description?.Length ?? 0)</p>
          @AtPlace(DescriptionInputId, DetailsRefusal(DescriptionInputId))
        </FormField>

        <div class="form-group">
          <div class="form-check">
            <input id="@ActiveInputId" class="form-check-input" type="checkbox" aria-describedby="@FieldHelp.Id(ActiveInputId)" @bind="_isActive" />
            <label for="@ActiveInputId">@ActivityTypeEditWords.ActiveLabel</label>
          </div>
          <p class="field-help" id="@FieldHelp.Id(ActiveInputId)">@ActivityTypeEditWords.ActiveHelp</p>
        </div>
      </div>
    </section>
  };

  /// <summary>
  /// Scope (T300, M1, R3-C01–C07): a read-out where one scope at one target is offered, "The one scope you can write in.";
  /// else a required radio group of exactly the scopes the caller may write in, and the target under it: none for
  /// Global, a read-out for one, a required select for several.
  /// </summary>
  private RenderFragment ScopeControls(ActivityTypeEditorDto editor) => __builder =>
  {
    var choices = editor.WritableScopes;
    var chosen = choices.FirstOrDefault(choice => choice.Scope == _scope);
    if (choices.Count == 1 && (chosen?.Targets.Count ?? 0) <= 1)
    {
      <dl class="form-group">
        <dt>@ActivityTypeEditWords.ScopeLabel</dt>
        <dd>@ScopeAndTarget</dd>
        <dd class="muted text-sm">@ActivityTypeEditWords.OneScope</dd>
      </dl>
      return;
    }

    if (choices.Count > 1)
    {
      <fieldset class="form-group choice-group" role="radiogroup" aria-required="true">
        <legend>@ActivityTypeEditWords.ScopeLabel<span class="required-mark" aria-hidden="true"> *</span><span class="visually-hidden">required</span></legend>
        @foreach (var choice in choices)
        {
          var id = $"type-scope-{choice.Scope.ToString().ToLowerInvariant()}";
          <div class="form-check">
            <input class="form-check-input" type="radio" name="type-scope" id="@id" value="@choice.Scope"
                   checked="@(choice.Scope == _scope)" @onchange="() => ChooseScope(choice)" />
            <label for="@id">@ActivityTypeEditWords.ScopeName(choice.Scope)</label>
          </div>
        }
      </fieldset>
    }
    else
    {
      <dl class="form-group">
        <dt>@ActivityTypeEditWords.ScopeLabel</dt>
        <dd>@ActivityTypeEditWords.ScopeName(_scope)</dd>
      </dl>
    }

    @if (_scope == ActivityScope.Global)
    {
      <dl class="form-group">
        <dt>@ActivityTypeEditWords.TargetLabel</dt>
        <dd>@ActivityTypeEditWords.GlobalTarget</dd>
      </dl>
    }
    else if ((chosen?.Targets.Count ?? 0) == 1)
    {
      <dl class="form-group">
        <dt>@ActivityTypeEditWords.ScopeName(_scope)</dt>
        <dd>@chosen!.Targets[0].Name</dd>
      </dl>
    }
    else if (chosen is not null)
    {
      <FormField Label="@ActivityTypeEditWords.ScopeName(_scope)" InputId="type-scope-id" Required="true">
        <select id="type-scope-id" class="form-select" aria-required="true" @bind="_scopeIdText">
          @foreach (var target in chosen.Targets)
          {
            <option value="@target.Id">@target.Name</option>
          }
        </select>
      </FormField>
    }
  };

  // ---- Form ----

  private RenderFragment FormPanel(ActivityTypeEditorDto editor) => __builder =>
  {
    var writer = editor.CanWrite;
    var sectionNames = SectionNames();
    var fieldNames = FieldNames();
    var folds = TotalFields > ActivityTypeEditWords.FoldAbove;

    @* The card is the tabpanel and the builder's size container (T266, C2); it holds the Show choice, so no tabindex (N21). *@
    <div class="form-container" role="tabpanel" id="@PanelId(BuilderTab.Form)" aria-labelledby="@TabId(BuilderTab.Form)">
      @* C2, Q5: where the columns stack, the CSS-only choice of the editor or the preview; hidden where both stand. *@
      <fieldset class="form-group choice-group">
        <legend>@ActivityTypeEditWords.ShowLegend</legend>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="builder-show" id="show-form" checked />
          <label for="show-form">@(writer ? ActivityTypeEditWords.ShowFormWriter : ActivityTypeEditWords.ShowFormReader)</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="builder-show" id="show-preview" />
          <label for="show-preview">@ActivityTypeEditWords.ShowPreview</label>
        </div>
      </fieldset>

      <div class="builder-two-col">
        <div>
          @FormSettings(writer)

          <h2>@ActivityTypeEditWords.SectionsHeading</h2>
          @if (writer)
          {
            <button type="button" id="@AddSectionId" class="btn btn-outline btn-sm" @onclick="AddSection">@ActivityTypeEditWords.AddSection</button>
          }
          <div class="form-outline">
            @for (var sectionIndex = 0; sectionIndex < _builderSchema.Sections.Count; sectionIndex++)
            {
              var s = sectionIndex;
              var section = _builderSchema.Sections[s];
              var sectionName = sectionNames[s];
              var sectionOpen = ReferenceEquals(_openSection, section);
              var folded = folds && _folded.Contains(section);
              var sectionRefusal = _refusal is not null && _refusal.Sections.TryGetValue(section, out var sectionWords) ? sectionWords : null;
              <section class="outline-section" aria-labelledby="@SectionDomId(s)" @key="section">
                <div class="outline-section-head @(sectionOpen ? "is-editing" : null) @(sectionRefusal is not null && !sectionOpen ? "is-refused" : null)">
                  <h3 id="@SectionDomId(s)">@sectionName</h3>
                  <p class="field-row-meta"><code>@section.Key</code></p>
                  @if (sectionRefusal is not null)
                  {
                    <p class="validation-message" id="@($"{SectionDomId(s)}-refusal")">@sectionRefusal</p>
                  }
                  <div class="actions-cell">
                    @if (writer)
                    {
                      <button type="button" id="@SectionButtonId(s, "edit")" class="btn btn-outline btn-sm"
                              aria-label="@(sectionOpen ? ActivityTypeEditWords.DoneWithSection(sectionName) : ActivityTypeEditWords.EditSection(sectionName))"
                              aria-expanded="@(sectionOpen ? "true" : "false")" aria-controls="@(sectionOpen ? SectionEditorId(s) : null)"
                              @onclick="() => ToggleSection(section)">@(sectionOpen ? ActivityTypeEditWords.Done : ActivityTypeEditWords.Edit)</button>
                      <button type="button" id="@SectionButtonId(s, "up")" class="btn btn-outline btn-sm" aria-label="@ActivityTypeEditWords.MoveSectionUp(sectionName)"
                              disabled="@(s == 0)" @onclick="() => MoveSection(section, -1)">@ActivityTypeEditWords.Up</button>
                      <button type="button" id="@SectionButtonId(s, "down")" class="btn btn-outline btn-sm" aria-label="@ActivityTypeEditWords.MoveSectionDown(sectionName)"
                              disabled="@(s == _builderSchema.Sections.Count - 1)" @onclick="() => MoveSection(section, 1)">@ActivityTypeEditWords.Down</button>
                      @* Q8: Delete is an outline button that asks nothing; nothing is saved until Save draft. *@
                      <button type="button" id="@SectionButtonId(s, "delete")" class="btn btn-outline btn-sm" aria-label="@ActivityTypeEditWords.DeleteSection(sectionName)"
                              @onclick="() => DeleteSection(section)">@ActivityTypeEditWords.Delete</button>
                    }
                    else
                    {
                      <button type="button" id="@SectionButtonId(s, "edit")" class="btn btn-outline btn-sm"
                              aria-label="@(sectionOpen ? ActivityTypeEditWords.CloseSection(sectionName) : ActivityTypeEditWords.ViewSection(sectionName))"
                              aria-expanded="@(sectionOpen ? "true" : "false")" aria-controls="@(sectionOpen ? SectionEditorId(s) : null)"
                              @onclick="() => ToggleSection(section)">@(sectionOpen ? ActivityTypeEditWords.Close : ActivityTypeEditWords.View)</button>
                    }
                    @if (folds)
                    {
                      @* T23, M2(b), S17: above 20 fields each section can fold; every section starts open. No aria-expanded:
                         the button's words say which way it goes. *@
                      <button type="button" id="@SectionButtonId(s, "fold")" class="btn btn-outline btn-sm"
                              aria-label="@(folded ? ActivityTypeEditWords.ShowFieldsOf(sectionName) : ActivityTypeEditWords.HideFieldsOf(sectionName))"
                              aria-controls="@FieldsListId(s)" @onclick="() => ToggleFold(section)">@(folded ? ActivityTypeEditWords.ShowFields : ActivityTypeEditWords.HideFields)</button>
                    }
                  </div>
                </div>

                @if (sectionOpen)
                {
                  @SectionEditor(s, section, sectionName, writer)
                }

                @if (folded)
                {
                  <ul class="list-unstyled" id="@FieldsListId(s)" hidden></ul>
                }
                else
                {
                  <ul class="list-unstyled" id="@FieldsListId(s)">
                    @if (section.Fields.Count == 0)
                    {
                      <li class="field-row"><p class="muted">@ActivityTypeEditWords.NoFieldsYet</p></li>
                    }
                    @for (var fieldIndex = 0; fieldIndex < section.Fields.Count; fieldIndex++)
                    {
                      var f = fieldIndex;
                      var field = section.Fields[f];
                      var fieldName = fieldNames[field];
                      var open = ReferenceEquals(_openField, field);
                      var fieldRefusal = _refusal is not null && _refusal.Fields.TryGetValue(field, out var fieldWords) ? fieldWords : null;
                      <li class="field-row @(open ? "is-editing" : null) @(fieldRefusal is not null && !open ? "is-refused" : null)" id="@RowId(s, f)" @key="field">
                        <p class="field-row-label">@fieldName</p>
                        <p class="field-row-meta">@ActivityTypeEditWords.FieldTypeLabel(field.Type)@if (field.Type == FieldType.User){@(" · ")@ActivityTypeEditWords.NamesA(NullIfEmpty(field.NomineeRole))} · <code>@field.Key</code>@if (field.Required){@(" · ")@ActivityTypeEditWords.Required}</p>
                        @if (fieldRefusal is not null && !open)
                        {
                          <p class="validation-message" id="@($"{RowId(s, f)}-refusal")">@fieldRefusal</p>
                        }
                        <div class="actions-cell">
                          @if (writer)
                          {
                            <button type="button" id="@FieldButtonId(s, f, "edit")" class="btn btn-outline btn-sm"
                                    aria-label="@(open ? ActivityTypeEditWords.DoneWithField(fieldName) : ActivityTypeEditWords.EditField(fieldName))"
                                    aria-expanded="@(open ? "true" : "false")" aria-controls="@(open ? FieldEditorId(s, f) : null)"
                                    @onclick="() => ToggleField(section, field)">@(open ? ActivityTypeEditWords.Done : ActivityTypeEditWords.Edit)</button>
                            <button type="button" id="@FieldButtonId(s, f, "up")" class="btn btn-outline btn-sm" aria-label="@ActivityTypeEditWords.MoveFieldUp(fieldName)"
                                    disabled="@(f == 0)" @onclick="() => MoveField(section, field, -1)">@ActivityTypeEditWords.Up</button>
                            <button type="button" id="@FieldButtonId(s, f, "down")" class="btn btn-outline btn-sm" aria-label="@ActivityTypeEditWords.MoveFieldDown(fieldName)"
                                    disabled="@(f == section.Fields.Count - 1)" @onclick="() => MoveField(section, field, 1)">@ActivityTypeEditWords.Down</button>
                            <button type="button" id="@FieldButtonId(s, f, "delete")" class="btn btn-outline btn-sm" aria-label="@ActivityTypeEditWords.DeleteField(fieldName)"
                                    @onclick="() => DeleteField(section, field)">@ActivityTypeEditWords.Delete</button>
                          }
                          else
                          {
                            <button type="button" id="@FieldButtonId(s, f, "edit")" class="btn btn-outline btn-sm"
                                    aria-label="@(open ? ActivityTypeEditWords.CloseField(fieldName) : ActivityTypeEditWords.ViewField(fieldName))"
                                    aria-expanded="@(open ? "true" : "false")" aria-controls="@(open ? FieldEditorId(s, f) : null)"
                                    @onclick="() => ToggleField(section, field)">@(open ? ActivityTypeEditWords.Close : ActivityTypeEditWords.View)</button>
                          }
                        </div>
                      </li>
                      @if (open)
                      {
                        @FieldEditor(s, f, field, fieldName, writer, fieldRefusal)
                      }
                    }
                  </ul>
                  @if (writer)
                  {
                    @* T239 review: every section's Add field reads the same, so each is named for its section. *@
                    <button type="button" id="@AddFieldId(s)" class="btn btn-outline btn-sm" aria-label="@ActivityTypeEditWords.AddFieldTo(sectionName)"
                            @onclick="() => AddField(section)">@ActivityTypeEditWords.AddField</button>
                  }
                }
              </section>
            }
          </div>
        </div>

        <div>
          <h2>@ActivityTypeEditWords.LivePreview</h2>
          @* S8: the preview's sections under this h2, and the type's own EPAs, since the preview has no registrar. *@
          <ActivityForm SchemaJson="@PreviewSchemaJson" DataJson="@_previewDataJson" DataJsonChanged="OnPreviewChanged"
                        SectionHeadingLevel="3" EpaOptions="@editor.PreviewEpaOptions" />
          @foreach (var role in PreviewNomineeRoles)
          {
            <p class="muted text-sm">@ActivityTypeEditWords.PersonLine(role)</p>
          }
        </div>
      </div>
    </div>
  };

  /// <summary>
  /// The form settings by label with the key after (T19, T324, R3-C17); T133's dropped setting kept (Q18): between a
  /// field's delete and the save the select still shows the setting's key.
  /// </summary>
  private RenderFragment FormSettings(bool writer) => __builder =>
  {
    <h2>@ActivityTypeEditWords.FormSettingsHeading</h2>
    <p class="muted">@ActivityTypeEditWords.FormSettingsHelp</p>
    @if (!writer)
    {
      <dl class="detail-list">
        <dt>@ActivityTypeEditWords.EncounterDateLabel</dt>
        <dd>@SettingText(_builderSchema.ObservationDateField, ActivityTypeEditWords.NoEncounterDate)</dd>
        <dt>@ActivityTypeEditWords.RatingLabel</dt>
        <dd>@SettingText(_builderSchema.RatedLevelField, ActivityTypeEditWords.NoRating)</dd>
        <dt>@ActivityTypeEditWords.EpaFieldLabel</dt>
        <dd>@SettingText(_builderSchema.EvidenceEpaField, ActivityTypeEditWords.NoEpaField)</dd>
      </dl>
      return;
    }

    <div class="form-grid">
      <FormField Label="@ActivityTypeEditWords.EncounterDateLabel" InputId="observation-date-field">
        <select id="observation-date-field" class="form-select" value="@(_builderSchema.ObservationDateField ?? string.Empty)" @onchange="OnObservationDateFieldChanged">
          <option value="">@ActivityTypeEditWords.NoEncounterDate</option>
          @foreach (var key in EligibleFieldKeys(FieldType.Date))
          {
            <option value="@key" selected="@(key == _builderSchema.ObservationDateField)">@SettingOption(key)</option>
          }
        </select>
      </FormField>
      <FormField Label="@ActivityTypeEditWords.RatingLabel" InputId="rated-level-field">
        <select id="rated-level-field" class="form-select" value="@(_builderSchema.RatedLevelField ?? string.Empty)" @onchange="OnRatedLevelFieldChanged">
          <option value="">@ActivityTypeEditWords.NoRating</option>
          @foreach (var key in EligibleFieldKeys(FieldType.Scale))
          {
            <option value="@key" selected="@(key == _builderSchema.RatedLevelField)">@SettingOption(key)</option>
          }
        </select>
      </FormField>
      @* T137. Which EPA an activity is evidence for: it is stamped on every activity and shown on every list. Credit that
         reads an EPA field must read this one, and a save says so if it does not. *@
      <FormField Label="@ActivityTypeEditWords.EpaFieldLabel" InputId="evidence-epa-field" HelpText="@ActivityTypeEditWords.EpaFieldHelp">
        <select id="evidence-epa-field" class="form-select" aria-describedby="@FieldHelp.Id("evidence-epa-field")"
                value="@(_builderSchema.EvidenceEpaField ?? string.Empty)" @onchange="OnEvidenceEpaFieldChanged">
          <option value="">@ActivityTypeEditWords.NoEpaField</option>
          @foreach (var key in EligibleFieldKeys(FieldType.Epa))
          {
            <option value="@key" selected="@(key == _builderSchema.EvidenceEpaField)">@SettingOption(key)</option>
          }
        </select>
      </FormField>
    </div>
  };

  /// <summary>A section's editor in place, under its head (Q4, R3-C10): a group, since it is no list item.</summary>
  private RenderFragment SectionEditor(int s, BuilderSectionModel section, string sectionName, bool writer) => __builder =>
  {
    <div class="field-editor-inplace" id="@SectionEditorId(s)" role="group" aria-labelledby="@($"{SectionEditorId(s)}-h")">
      <h4 id="@($"{SectionEditorId(s)}-h")">@ActivityTypeEditWords.SectionHeading(sectionName)</h4>
      @if (writer)
      {
        @* The section's refusal is worded in its head (sec-N-refusal); its key, where the summary's line lands, is marked
           and described by it, as a field's key is (the fix pass, pages review S2). *@
        var sectionRefused = _refusal is not null && _refusal.Sections.ContainsKey(section);
        <p class="muted">@RequiredMark.Line</p>
        <div class="form-grid">
          <FormField Label="@ActivityTypeEditWords.SectionKeyLabel" InputId="section-key" Required="true">
            <input id="section-key" class="form-control font-mono" aria-required="true" autocomplete="off"
                   aria-invalid="@Invalid(sectionRefused)"
                   aria-describedby="@(sectionRefused ? $"{SectionDomId(s)}-refusal" : null)"
                   @bind="section.Key" />
          </FormField>
          <FormField Label="@ActivityTypeEditWords.TitleLabel" InputId="section-title" Required="true">
            <input id="section-title" class="form-control" aria-required="true" autocomplete="off" @bind="section.Title" />
          </FormField>
        </div>
      }
      else
      {
        <dl class="detail-list">
          <dt>@ActivityTypeEditWords.SectionKeyLabel</dt>
          <dd><code>@section.Key</code></dd>
          <dt>@ActivityTypeEditWords.TitleLabel</dt>
          <dd>@section.Title</dd>
        </dl>
      }
    </div>
  };

  /// <summary>
  /// A field's editor in place, directly after its row (Q4, R3-C11): an li with no role (round 3 check: the editor li), its
  /// h4 naming it. A reader's is its settings as text (R2-B02).
  /// </summary>
  private RenderFragment FieldEditor(int s, int f, BuilderFieldModel field, string fieldName, bool writer, string? refusal) => __builder =>
  {
    <li class="field-editor-inplace" id="@FieldEditorId(s, f)">
      <h4>@ActivityTypeEditWords.FieldHeading(fieldName)</h4>
      @if (!writer)
      {
        <dl class="detail-list">
          <dt>@ActivityTypeEditWords.FieldKeyLabel</dt>
          <dd><code>@field.Key</code></dd>
          <dt>@ActivityTypeEditWords.LabelLabel</dt>
          <dd>@field.Label</dd>
          <dt>@ActivityTypeEditWords.TypeLabel</dt>
          <dd>@ActivityTypeEditWords.FieldTypeLabel(field.Type)</dd>
          <dt>@ActivityTypeEditWords.HelpTextLabel</dt>
          <dd>@(string.IsNullOrWhiteSpace(field.HelpText) ? ActivityTypeEditWords.None : field.HelpText)</dd>
          @if (field.Type == FieldType.User)
          {
            <dt>@ActivityTypeEditWords.NamesALabel</dt>
            <dd>@(string.IsNullOrWhiteSpace(field.NomineeRole) ? ActivityTypeEditWords.DefaultRole : WombatRoleLabels.For(field.NomineeRole))</dd>
          }
          else
          {
            var optionLines = OptionLines(field.OptionsText);
            <dt>@ActivityTypeEditWords.OptionsLabel</dt>
            @if (optionLines.Count == 0)
            {
              <dd>@ActivityTypeEditWords.None</dd>
            }
            else
            {
              <dd>
                <ul class="list-unstyled">
                  @foreach (var line in optionLines)
                  {
                    <li>@line</li>
                  }
                </ul>
              </dd>
            }
            <dt>@ActivityTypeEditWords.CatalogueKeyLabel</dt>
            <dd>@(string.IsNullOrWhiteSpace(field.CatalogueKey) ? ActivityTypeEditWords.None : field.CatalogueKey)</dd>
          }
          @if (field.Type == FieldType.Scale)
          {
            <dt>@ActivityTypeEditWords.ScaleLabel</dt>
            <dd>@ScaleText(field.ScaleKey)</dd>
          }
          <dt>@ActivityTypeEditWords.Required</dt>
          <dd>@(field.Required ? ActivityTypeEditWords.Yes : ActivityTypeEditWords.No)</dd>
        </dl>
      }
      else
      {
      <p class="muted">@RequiredMark.Line</p>
      <div class="form-grid">
        <FormField Label="@ActivityTypeEditWords.FieldKeyLabel" InputId="field-key" Required="true">
          <input id="field-key" class="form-control font-mono" aria-required="true" autocomplete="off"
                 aria-invalid="@Invalid(refusal is not null)"
                 aria-describedby="@FieldRefusal.DescribedBy("field-key", refusal is not null, null)"
                 @bind="field.Key" />
          @AtPlace("field-key", refusal)
        </FormField>
        <FormField Label="@ActivityTypeEditWords.LabelLabel" InputId="field-label" Required="true">
          <input id="field-label" class="form-control" aria-required="true" autocomplete="off" @bind="field.Label" />
        </FormField>
        <FormField Label="@ActivityTypeEditWords.TypeLabel" InputId="field-type" Required="true">
          <select id="field-type" class="form-select" aria-required="true" @bind="field.Type">
            @foreach (var fieldType in SupportedFieldTypes)
            {
              <option value="@fieldType">@ActivityTypeEditWords.FieldTypeLabel(fieldType)</option>
            }
          </select>
        </FormField>
        <FormField Label="@ActivityTypeEditWords.HelpTextLabel" InputId="field-help">
          <input id="field-help" class="form-control" autocomplete="off" @bind="field.HelpText" />
        </FormField>
        @if (field.Type == FieldType.User)
        {
          @* A User field offers the people of the trainee's institution who hold this role; the server checks the same
             (T102). It has no options of its own. Roles by their labels (T324). *@
          <FormField Label="@ActivityTypeEditWords.NamesALabel" InputId="field-role" HelpText="@ActivityTypeEditWords.NamesAHelp">
            <select id="field-role" class="form-select" aria-describedby="@FieldHelp.Id("field-role")" @bind="field.NomineeRole">
              <option value="">@ActivityTypeEditWords.DefaultRole</option>
              @foreach (var role in NomineeRoleChoices(field.NomineeRole))
              {
                <option value="@role">@WombatRoleLabels.For(role)</option>
              }
            </select>
          </FormField>
        }
        else
        {
          @* One option per line, a comma part of it. "value | Label" shows the label and stores the value (T191). A Choice's
             options are starred (M1). *@
          <FormField Label="@ActivityTypeEditWords.OptionsLabel" InputId="field-options" Required="@OptionsRequired(field.Type)" HelpText="@ActivityTypeEditWords.OptionsHelp">
            <textarea id="field-options" class="form-control" rows="4" aria-required="@(OptionsRequired(field.Type) ? "true" : null)"
                      aria-describedby="@FieldHelp.Id("field-options")" @bind="field.OptionsText"></textarea>
          </FormField>
          <FormField Label="@ActivityTypeEditWords.CatalogueKeyLabel" InputId="field-catalogue">
            <input id="field-catalogue" class="form-control" autocomplete="off" @bind="field.CatalogueKey" />
          </FormField>
        }
        @if (field.Type == FieldType.Scale)
        {
          @* T271 item 2: a seed key resolves to its scale's name, so the stored key is shown as its scale. *@
          <FormField Label="@ActivityTypeEditWords.ScaleLabel" InputId="field-scale" HelpText="@ActivityTypeEditWords.ScaleHelp">
            <select id="field-scale" class="form-select" aria-describedby="@FieldHelp.Id("field-scale")" @bind="field.ScaleKey">
              <option value="">@ActivityTypeEditWords.ScaleNone</option>
              @foreach (var scale in ScaleChoices(field.ScaleKey))
              {
                <option value="@scale.Value">@scale.Name</option>
              }
            </select>
          </FormField>
        }
        <div class="form-group">
          <div class="form-check">
            <input id="field-required" class="form-check-input" type="checkbox" @bind="field.Required" />
            <label for="field-required">@ActivityTypeEditWords.Required</label>
          </div>
        </div>
      </div>
      }
    </li>
  };

  // ---- Workflow and Credit ----

  private RenderFragment WorkflowPanel(ActivityTypeEditorDto editor) => __builder =>
  {
    @* Q2: the read in words above the JSON for a writer; a reader's whole view, with no control, so the panel takes the
       focus itself (N21). *@
    <section class="detail-card user-section" role="tabpanel" id="@PanelId(BuilderTab.Workflow)" aria-labelledby="@TabId(BuilderTab.Workflow)"
             tabindex="@(editor.CanWrite ? null : "0")">
      <h2>@ActivityTypeEditWords.WorkflowHeading</h2>
      @if (editor.WorkflowRead is { } read)
      {
        <WorkflowReadout Read="@read" HeadingLevel="3" />
      }
      @if (editor.CanWrite)
      {
        @JsonEditor(WorkflowJsonId, ActivityTypeEditWords.WorkflowJsonLabel, _workflowJson, value => _workflowJson = value,
          _refusal?.WorkflowRefused == true, _refusal?.WorkflowWords)
      }
    </section>
  };

  private RenderFragment CreditPanel(ActivityTypeEditorDto editor) => __builder =>
  {
    <section class="detail-card user-section" role="tabpanel" id="@PanelId(BuilderTab.Credit)" aria-labelledby="@TabId(BuilderTab.Credit)"
             tabindex="@(editor.CanWrite ? null : "0")">
      <h2>@ActivityTypeEditWords.CreditHeading</h2>
      @if (editor.CreditRead is { } read)
      {
        <CreditReadout Read="@read" HeadingLevel="3" />
      }
      @if (editor.CanWrite)
      {
        @JsonEditor(CreditJsonId, ActivityTypeEditWords.CreditJsonLabel, _creditRulesJson, value => _creditRulesJson = value,
          _refusal?.CreditRefused == true, _refusal?.CreditWords)
      }
    </section>
  };

  /// <summary>
  /// A JSON editor (Q2, Q13, N15): the text as typed until a save, then as saved, laid out by Wombat. A refusal's words
  /// under it, first in its description (R3-D01, D04).
  /// </summary>
  private RenderFragment JsonEditor(string id, string label, string value, Action<string> set, bool refused, string? words) => __builder =>
  {
    var describedBy = string.Join(' ', new[] { words is null ? null : FieldRefusal.Id(id), FieldHelp.Id(id) }.Where(part => part is not null));
    <div class="form-group">
      <label for="@id">@label</label>
      <textarea id="@id" class="form-control font-mono" rows="@JsonRows(value)" spellcheck="false"
                aria-invalid="@Invalid(refused)" aria-describedby="@describedBy"
                value="@value" @onchange="args => set(args.Value?.ToString() ?? string.Empty)"></textarea>
      @if (words is not null)
      {
        <p class="validation-message" id="@FieldRefusal.Id(id)">@words</p>
      }
      <p class="field-help" id="@FieldHelp.Id(id)">@ActivityTypeEditWords.JsonHelp</p>
    </div>
  };

  // ---- Publish ----

  private RenderFragment PublishPanel(ActivityTypeEditorDto editor) => __builder =>
  {
    <section class="detail-card user-section" role="tabpanel" id="@PanelId(BuilderTab.Publish)" aria-labelledby="@TabId(BuilderTab.Publish)">
      <h2>@ActivityTypeEditWords.PublishHeading</h2>
      @if (!CanPublish)
      {
        <p>@(IsPublished ? ActivityTypeEditWords.NoDraftPublished(editor.PublishedVersion) : ActivityTypeEditWords.NothingPublished)</p>
      }
      else
      {
        @if (HasUnsavedEdits)
        {
          @* S6: what publishing changes is read from the saved draft; while edits are unsaved, it says so first. *@
          <p class="muted">@ActivityTypeEditWords.SaveToSee</p>
        }
        @if (!IsPublished)
        {
          @* C5.1, R3-E01: a first publish has nothing to compare; it says what is published. *@
          <h3>@ActivityTypeEditWords.WhatYouArePublishing</h3>
          <dl class="detail-list">
            @if (SavedFormSummary is { } form)
            {
              <dt>@ActivityTypeEditWords.FormTerm</dt>
              <dd>@form</dd>
            }
            @if (SavedWorkflowSummary is { } workflow)
            {
              <dt>@ActivityTypeEditWords.WorkflowTerm</dt>
              <dd>@workflow</dd>
            }
            @if (editor.CreditRead is { } credit)
            {
              <dt>@ActivityTypeEditWords.CreditTerm</dt>
              <dd>@ActivityTypeEditWords.CreditSummary(credit.CreditsNothing, credit.Sentences.Count)</dd>
            }
          </dl>
          <p>@ActivityTypeEditWords.NothingToCompare</p>
        }
        else
        {
          var warnings = SavedWarnings;
          <h3>@ActivityTypeEditWords.WhatPublishingChanges</h3>
          @if (warnings.Count == 0)
          {
            <p>@ActivityTypeEditWords.NothingChanges</p>
          }
          else
          {
            <ul>
              @foreach (var warning in warnings)
              {
                <li>@warning</li>
              }
            </ul>
            <p>@ActivityTypeEditWords.PinnedLine(editor.PublishedVersion, SavedRemovedLabels)</p>
          }
        }
        @if (editor.IsSeedOwned)
        {
          <p>@ActivityTypeEditWords.SeedPublishNote</p>
        }
      }

      <VersionsTable Versions="@editor.Versions" HeadingLevel="3" />

      <div class="form-actions">
        <button type="button" id="@PublishTabButtonId" class="btn btn-success" disabled="@OtherInFlight(PublishAction)"
                aria-disabled="@(CanPublish ? InFlight.AriaDisabled(Running(PublishAction)) : "true")"
                aria-describedby="@(CanPublish ? null : PublishTabReasonId)"
                aria-haspopup="@(CanPublish && WouldDeactivate ? "dialog" : null)"
                @onclick="() => PublishAsync(PublishTabButtonId)">@ActivityTypeEditWords.PublishVersion(NextVersion)</button>
      </div>
      @if (!CanPublish)
      {
        <p class="muted text-sm" id="@PublishTabReasonId">@ActivityTypeEditWords.PublishReason</p>
      }
    </section>
  };

  /// <summary>A refusal's words under its control, named by <see cref="FieldRefusal.Id" />.</summary>
  private static RenderFragment AtPlace(string inputId, string? words) => __builder =>
  {
    if (words is not null)
    {
      <p class="validation-message" id="@FieldRefusal.Id(inputId)">@words</p>
    }
  };
}

@page "/admin/activity-types/new"
@page "/admin/activity-types/{ActivityTypeId:int}"
@* T300: the College writes its disciplines' types (T091), so the builder admits a CollegeAdmin beside an Administrator
   and an InstitutionalAdmin. What each may change there is the editor's CanWrite, the rule the commands refuse by. *@
@attribute [Authorize(Policy = "NationalCatalogueAccess")]
@using Wombat.Domain.Activities
@using Wombat.Application.Features.Activities.Services
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IActivityReferenceDataService ReferenceData
@inject NavigationManager Navigation

<PageTitle>@DocumentTitle</PageTitle>

<PageHeader Title="@PageTitleText" Subtitle="@PageSubtitle">
  <Actions>
    <a class="btn btn-outline" href="/admin/activity-types">Back to list</a>
    @* T300: offered only where the caller may write the type (the editor's CanWrite, ActivityTypeAdminScope, the rule the
       commands refuse by), and not before the editor has loaded or after it failed to: a Save draft there sent a create
       with an empty key and workflow (the T295 sweep). *@
    @if (CanWrite)
    {
      @* While one of these runs the others are disabled, and the one pressed is not (T234): it has the focus, and a
         browser drops the focus of a button it disables, to the page. A second press sends nothing. *@
      <button type="button" class="btn btn-primary" disabled="@OtherInFlight(SaveAction)" aria-disabled="@InFlight.AriaDisabled(Running(SaveAction))" @onclick="SaveDraftAsync">Save draft</button>
      @if ((_editor?.Id ?? 0) > 0 && _editor?.HasDraft == true)
      {
        <button type="button" class="btn btn-outline" disabled="@OtherInFlight(DiscardAction)" aria-disabled="@InFlight.AriaDisabled(Running(DiscardAction))" @onclick="DiscardDraftAsync">Discard draft</button>
      }
      <button type="button" class="btn btn-success" disabled="@(OtherInFlight(PublishAction) || !CanPublish)" aria-disabled="@InFlight.AriaDisabled(Running(PublishAction))" title="@(CanPublish ? null : "Save a draft to publish.")" @onclick="PublishAsync">Publish</button>
    }
  </Actions>
</PageHeader>

@* What Save draft, Discard draft or Publish did. It takes the focus once the action is done (T234; DESIGN.md § Button
   system): a discard or a publish leaves no draft, which takes Discard draft away and disables Publish, and a status
   arriving on its own is often not read. A refusal leaves the focus where it was: it is an alert, read at once. *@
<ActionResult @ref="_result">
  @if (!string.IsNullOrWhiteSpace(_status))
  {
    <Alert Kind="success">@_status</Alert>
  }

  @if (!string.IsNullOrWhiteSpace(_actionError))
  {
    <Alert Kind="danger">@_actionError</Alert>
  }
</ActionResult>

@if (CanWrite && _publishWarnings.Count > 0)
{
  <Alert Kind="warning">
    <strong>Publish warnings:</strong>
    <ul>
      @foreach (var warning in _publishWarnings)
      {
        <li>@warning</li>
      }
    </ul>
  </Alert>
}

<StatePanel IsLoading="_loading" LoadError="@_loadError" IsEmpty="@(!_loading && _editor is null)" EmptyTitle="Editor unavailable" EmptyBody="The activity type editor could not be loaded.">
  @if (_editor is not null && IsNewRoute && !_editor.CanWrite)
  {
    @* T300: a caller admitted to the builder with no scope to create in (a College with no discipline yet). *@
    <Alert Kind="info" Role="" Id="activity-type-no-scope">
      You have no scope to create an activity type in. An institution's administrators create their institution's types,
      and a College's administrators the types of its specialities and sub-specialities.
    </Alert>
  }
  else if (_editor is not null)
  {
    @if (!_editor.CanWrite)
    {
      @* T300: standing content, there on every visit, so no role (DESIGN.md § Alerts). Whose type it is, and that the
         caller reads it here and changes nothing: the page offers no save, discard, publish or edit. *@
      <Alert Kind="info" Role="" Id="activity-type-read-only">@ReadOnlyNotice</Alert>
    }

    <div class="form-container">
      <div class="tab-bar mb-3">
        @foreach (var tab in Tabs)
        {
          <button type="button" class="tab-bar-tab @(_activeTab == tab.Key ? "is-active" : string.Empty)" @onclick="() => _activeTab = tab.Key">@tab.Label</button>
        }
      </div>

      @if (_activeTab == "metadata" && !_editor.CanWrite)
      {
        @* T300: what is stored, as text (DESIGN.md § Form system, T302). The standing alert says who sets it. *@
        <div class="form-grid">
          <dl class="form-group">
            <dt>Key</dt>
            <dd><code>@_key</code></dd>
          </dl>
          <dl class="form-group">
            <dt>Name</dt>
            <dd>@_name</dd>
          </dl>
          <dl class="form-group">
            <dt>Scope</dt>
            <dd>@StoredScopeText</dd>
          </dl>
          <dl class="form-group">
            <dt>This tool is</dt>
            <dd>@WbaToolText</dd>
          </dl>
          <dl class="form-group full-width">
            <dt>Description</dt>
            <dd>@(string.IsNullOrWhiteSpace(_description) ? "None" : _description)</dd>
          </dl>
          <dl class="form-group">
            <dt>Status</dt>
            <dd>@(_isActive ? "Active" : "Inactive")</dd>
          </dl>
        </div>
      }
      else if (_activeTab == "metadata")
      {
        <div class="form-grid">
          <FormField Label="Key" InputId="type-key" Required="true">
            <input id="type-key" class="form-control" @bind="_key" disabled="@IsPublished" />
          </FormField>
          <FormField Label="Name" InputId="type-name" Required="true">
            <input id="type-name" class="form-control" @bind="_name" />
          </FormField>
          @* T300: exactly the scopes and targets the caller may save in (the editor's WritableScopes, the rule the save
             refuses by; DESIGN.md: a picker offers exactly what the command it feeds accepts). Before T300 it offered every
             scope, and a new type started Global, which the save refuses from anyone but an Administrator. *@
          <FormField Label="Scope" InputId="type-scope" Required="true">
            <select id="type-scope" class="form-select" value="@_scope" @onchange="OnScopeChanged">
              @foreach (var choice in _editor.WritableScopes)
              {
                <option value="@choice.Scope">@ScopeLabel(choice.Scope)</option>
              }
            </select>
          </FormField>
          @if (_scope != ActivityScope.Global)
          {
            <FormField Label="@ScopeLabel(_scope)" InputId="type-scope-id" Required="true">
              <select id="type-scope-id" class="form-select" @bind="_scopeIdText">
                @foreach (var target in ScopeTargets)
                {
                  <option value="@target.Id">@target.Name</option>
                }
              </select>
            </FormField>
          }
          @* T122. Which College-named instrument this form is. Each curriculum item's tool list then decides which
             EPAs it may be filed against; "Not a WBA instrument" leaves it unrestricted (D21). A stored key the
             vocabulary no longer holds is still listed, so it can be seen and withdrawn. *@
          <FormField Label="This tool is" InputId="type-wba-tool"
                     HelpText="Choosing an instrument lets each curriculum item's tool list decide which EPAs this form can be filed against. 'Not a WBA instrument' leaves it unrestricted. Takes effect when you save the draft, not when you publish, and discarding the draft does not undo it. On a seeded type, publish or discard that draft afterwards, or seed updates stop reaching the type.">
            <select id="type-wba-tool" class="form-select" aria-describedby="@FieldHelp.Id("type-wba-tool")" @bind="_wbaToolKey">
              <option value="">Not a WBA instrument</option>
              @foreach (var tool in WbaToolOptions)
              {
                <option value="@tool.Key">@tool.Name</option>
              }
            </select>
          </FormField>
          <FormField Label="Description" InputId="type-description" FullWidth="true">
            <textarea id="type-description" class="form-control" rows="4" @bind="_description"></textarea>
          </FormField>
          <div class="form-check">
            <input id="type-is-active" class="form-check-input" type="checkbox" @bind="_isActive" />
            <label for="type-is-active">Active</label>
          </div>
        </div>
      }
      else if (_activeTab == "form")
      {
        @* T133. The two root pointers. Before this they were unsettable by any route -- the Form tab
           is a structured builder with no raw schema editor, so an operator could neither declare
           them nor clear one whose field they had deleted. *@
        <div class="detail-card">
          <div class="header-container">
            <div>
              <h3>Form settings</h3>
              <p class="page-subtitle">Which field carries the encounter date, which carries the entrustment rating, and which names the EPA.</p>
            </div>
          </div>
          @if (!_editor.CanWrite)
          {
            <div class="form-grid">
              <dl class="form-group">
                <dt>Encounter date field</dt>
                <dd>@(_builderSchema.ObservationDateField ?? "None — this form has no single encounter date")</dd>
              </dl>
              <dl class="form-group">
                <dt>Entrustment rating field</dt>
                <dd>@(_builderSchema.RatedLevelField ?? "None — this form asserts no entrustment level")</dd>
              </dl>
              <dl class="form-group">
                <dt>EPA field</dt>
                <dd>@(_builderSchema.EvidenceEpaField ?? "None — this form is about no single EPA")</dd>
              </dl>
            </div>
          }
          else
          {
            <div class="form-grid">
              <FormField Label="Encounter date field" InputId="observation-date-field">
                <select id="observation-date-field" class="form-select"
                        value="@(_builderSchema.ObservationDateField ?? string.Empty)"
                        @onchange="OnObservationDateFieldChanged">
                  <option value="">None — this form has no single encounter date</option>
                  @foreach (var key in EligibleFieldKeys(FieldType.Date))
                  {
                    <option value="@key" selected="@(key == _builderSchema.ObservationDateField)">@key</option>
                  }
                </select>
              </FormField>
              <FormField Label="Entrustment rating field" InputId="rated-level-field">
                <select id="rated-level-field" class="form-select"
                        value="@(_builderSchema.RatedLevelField ?? string.Empty)"
                        @onchange="OnRatedLevelFieldChanged">
                  <option value="">None — this form asserts no entrustment level</option>
                  @foreach (var key in EligibleFieldKeys(FieldType.Scale))
                  {
                    <option value="@key" selected="@(key == _builderSchema.RatedLevelField)">@key</option>
                  }
                </select>
              </FormField>
              @* T137. Which EPA an activity is evidence for: it is stamped on every activity and shown on every list.
                 Credit that reads an EPA field must read this one, and a save says so if it does not. *@
              <FormField Label="EPA field" InputId="evidence-epa-field"
                         HelpText="The field naming the EPA this activity is evidence for. It is shown on activity lists, and credit rules that match on an EPA field must use this one.">
                <select id="evidence-epa-field" class="form-select" aria-describedby="@FieldHelp.Id("evidence-epa-field")"
                        value="@(_builderSchema.EvidenceEpaField ?? string.Empty)"
                        @onchange="OnEvidenceEpaFieldChanged">
                  <option value="">None — this form is about no single EPA</option>
                  @foreach (var key in EligibleFieldKeys(FieldType.Epa))
                  {
                    <option value="@key" selected="@(key == _builderSchema.EvidenceEpaField)">@key</option>
                  }
                </select>
              </FormField>
            </div>
          }
        </div>

        <div class="builder-two-col">
          <div class="detail-card">
            <div class="header-container">
              <div>
                <h3>Sections</h3>
                <p class="page-subtitle">@(_editor.CanWrite ? "Build the schema visually and keep the preview in sync." : "The form's sections and fields. View one to read its settings.")</p>
              </div>
              @if (_editor.CanWrite)
              {
                <div class="actions-cell">
                  <button type="button" class="btn btn-outline btn-sm" @onclick="AddSection">Add section</button>
                </div>
              }
            </div>

            @if (_builderSchema.Sections.Count == 0)
            {
              <div class="detail-card detail-card--empty">No sections yet.</div>
            }
            else
            {
              var sectionNames = SectionNames();
              var fieldNames = FieldNames();
              @for (var sectionIndex = 0; sectionIndex < _builderSchema.Sections.Count; sectionIndex++)
              {
                var capturedSectionIndex = sectionIndex;
                var formSection = _builderSchema.Sections[capturedSectionIndex];
                <div class="detail-card detail-card--compact mb-3">
                  <div class="header-container">
                    <div>
                      <h4>@formSection.Title</h4>
                      <p class="page-subtitle"><code>@formSection.Key</code></p>
                    </div>
                    <div class="actions-cell">
                      @{ var sectionName = sectionNames[capturedSectionIndex]; }
                      @if (_editor.CanWrite)
                      {
                        <button type="button" class="btn btn-outline btn-sm" aria-label="@($"Edit section {sectionName}")" @onclick="() => SelectSection(capturedSectionIndex)">Edit</button>
                        <button type="button" class="btn btn-outline btn-sm" aria-label="@($"Move section {sectionName} up")" disabled="@(capturedSectionIndex == 0)" @onclick="() => MoveSection(capturedSectionIndex, -1)">Up</button>
                        <button type="button" class="btn btn-outline btn-sm" aria-label="@($"Move section {sectionName} down")" disabled="@(capturedSectionIndex == _builderSchema.Sections.Count - 1)" @onclick="() => MoveSection(capturedSectionIndex, 1)">Down</button>
                        <button type="button" class="btn btn-danger btn-sm" aria-label="@($"Delete section {sectionName}")" @onclick="() => DeleteSection(capturedSectionIndex)">Delete</button>
                      }
                      else
                      {
                        @* T300: a reader still opens a section and a field, to read them (Step 1.25 reads a field's scale). *@
                        <button type="button" class="btn btn-outline btn-sm" aria-label="@($"View section {sectionName}")" @onclick="() => SelectSection(capturedSectionIndex)">View</button>
                      }
                    </div>
                  </div>

                  @foreach (var field in formSection.Fields.Select((value, index) => (value, index)))
                  {
                    var capturedFieldIndex = field.index;
                    <div class="detail-card detail-card--interactive detail-card--compact mb-3">
                      <div class="header-container">
                        <div>
                          <h5>@field.value.Label</h5>
                          <p class="page-subtitle"><code>@field.value.Key</code> · @field.value.Type</p>
                        </div>
                        <div class="actions-cell">
                          @{ var fieldName = fieldNames[field.value]; }
                          @if (_editor.CanWrite)
                          {
                            <button type="button" class="btn btn-outline btn-sm" aria-label="@($"Edit field {fieldName}")" @onclick="() => SelectField(capturedSectionIndex, capturedFieldIndex)">Edit</button>
                            <button type="button" class="btn btn-outline btn-sm" aria-label="@($"Move field {fieldName} up")" disabled="@(capturedFieldIndex == 0)" @onclick="() => MoveField(capturedSectionIndex, capturedFieldIndex, -1)">Up</button>
                            <button type="button" class="btn btn-outline btn-sm" aria-label="@($"Move field {fieldName} down")" disabled="@(capturedFieldIndex == formSection.Fields.Count - 1)" @onclick="() => MoveField(capturedSectionIndex, capturedFieldIndex, 1)">Down</button>
                            <button type="button" class="btn btn-danger btn-sm" aria-label="@($"Delete field {fieldName}")" @onclick="() => DeleteField(capturedSectionIndex, capturedFieldIndex)">Delete</button>
                          }
                          else
                          {
                            <button type="button" class="btn btn-outline btn-sm" aria-label="@($"View field {fieldName}")" @onclick="() => SelectField(capturedSectionIndex, capturedFieldIndex)">View</button>
                          }
                        </div>
                      </div>
                    </div>
                  }

                  @if (_editor.CanWrite)
                  {
                    @* T239 review: every section's Add field read the same. *@
                    <button type="button" class="btn btn-outline btn-sm" aria-label="@($"Add field to section {sectionNames[capturedSectionIndex]}")"
                            @onclick="() => AddField(capturedSectionIndex)">Add field</button>
                  }
                </div>
              }
            }

            @if (_selectedSectionIndex >= 0 && !_editor.CanWrite)
            {
              @* T300: a reader's section and field are text, not controls (DESIGN.md § Form system, T302). *@
              var readSection = _builderSchema.Sections[_selectedSectionIndex];
              <div class="detail-card" id="section-details">
                <h4>Section details</h4>
                <div class="form-grid">
                  <dl class="form-group">
                    <dt>Section key</dt>
                    <dd><code>@readSection.Key</code></dd>
                  </dl>
                  <dl class="form-group">
                    <dt>Title</dt>
                    <dd>@readSection.Title</dd>
                  </dl>
                </div>
              </div>

              @if (_selectedFieldIndex >= 0)
              {
                var readField = readSection.Fields[_selectedFieldIndex];
                <div class="detail-card" id="field-details">
                  <h4>Field details</h4>
                  <div class="form-grid">
                    <dl class="form-group">
                      <dt>Field key</dt>
                      <dd><code>@readField.Key</code></dd>
                    </dl>
                    <dl class="form-group">
                      <dt>Label</dt>
                      <dd>@readField.Label</dd>
                    </dl>
                    <dl class="form-group">
                      <dt>Type</dt>
                      <dd>@FieldTypeLabel(readField.Type)</dd>
                    </dl>
                    <dl class="form-group">
                      <dt>Help text</dt>
                      <dd>@(string.IsNullOrWhiteSpace(readField.HelpText) ? "None" : readField.HelpText)</dd>
                    </dl>
                    @if (readField.Type == FieldType.User)
                    {
                      <dl class="form-group">
                        <dt>Names a</dt>
                        <dd>@(string.IsNullOrWhiteSpace(readField.NomineeRole) ? "Assessor (default)" : readField.NomineeRole)</dd>
                      </dl>
                    }
                    else
                    {
                      var optionLines = OptionLines(readField.OptionsText);
                      <dl class="form-group full-width">
                        <dt>Options</dt>
                        @if (optionLines.Count == 0)
                        {
                          <dd>None</dd>
                        }
                        else
                        {
                          <dd>
                            <ul class="list-unstyled">
                              @foreach (var line in optionLines)
                              {
                                <li>@line</li>
                              }
                            </ul>
                          </dd>
                        }
                      </dl>
                      <dl class="form-group">
                        <dt>Catalogue key</dt>
                        <dd>@(string.IsNullOrWhiteSpace(readField.CatalogueKey) ? "None" : readField.CatalogueKey)</dd>
                      </dl>
                    }
                    @if (readField.Type == FieldType.Scale)
                    {
                      <dl class="form-group">
                        <dt>Entrustment scale</dt>
                        <dd>@ScaleText(readField.ScaleKey)</dd>
                      </dl>
                    }
                    <dl class="form-group">
                      <dt>Required</dt>
                      <dd>@(readField.Required ? "Yes" : "No")</dd>
                    </dl>
                  </div>
                </div>
              }
            }
            else if (_selectedSectionIndex >= 0)
            {
              var selectedSection = _builderSchema.Sections[_selectedSectionIndex];
              <div class="detail-card">
                <h4>Section editor</h4>
                <div class="form-grid">
                  <FormField Label="Section key" InputId="section-key" Required="true">
                    <input id="section-key" class="form-control" @bind="selectedSection.Key" />
                  </FormField>
                  <FormField Label="Title" InputId="section-title" Required="true">
                    <input id="section-title" class="form-control" @bind="selectedSection.Title" />
                  </FormField>
                </div>
              </div>
            }

            @if (_editor.CanWrite && _selectedSectionIndex >= 0 && _selectedFieldIndex >= 0)
            {
              var selectedField = _builderSchema.Sections[_selectedSectionIndex].Fields[_selectedFieldIndex];
              <div class="detail-card">
                <h4>Field editor</h4>
                <div class="form-grid">
                  <FormField Label="Field key" InputId="field-key" Required="true">
                    <input id="field-key" class="form-control" @bind="selectedField.Key" />
                  </FormField>
                  <FormField Label="Label" InputId="field-label" Required="true">
                    <input id="field-label" class="form-control" @bind="selectedField.Label" />
                  </FormField>
                  <FormField Label="Type" InputId="field-type" Required="true">
                    <select id="field-type" class="form-select" @bind="selectedField.Type">
                      @foreach (var fieldType in SupportedFieldTypes)
                      {
                        <option value="@fieldType">@FieldTypeLabel(fieldType)</option>
                      }
                    </select>
                  </FormField>
                  <FormField Label="Help text" InputId="field-help">
                    <input id="field-help" class="form-control" @bind="selectedField.HelpText" />
                  </FormField>
                  @if (selectedField.Type == FieldType.User)
                  {
                    @* A User field offers the people of the trainee's institution who hold this role; the server checks
                       the same (T102). It has no options of its own. *@
                    <FormField Label="Names a" InputId="field-role" HelpText="Who this field may name: someone at the trainee's institution holding this role.">
                      <select id="field-role" class="form-select" aria-describedby="@FieldHelp.Id("field-role")" @bind="selectedField.NomineeRole">
                        <option value="">Assessor (default)</option>
                        @foreach (var role in NomineeRoleChoices(selectedField.NomineeRole))
                        {
                          <option value="@role">@role</option>
                        }
                      </select>
                    </FormField>
                  }
                  else
                  {
                    @* One option per line, a comma part of it. "value | Label" shows the label and stores the value
                       (T191); a bare line is its own label. The help text says so, since nothing else on the page does. *@
                    <FormField Label="Options" InputId="field-options" FullWidth="true"
                               HelpText="One option per line; a comma is part of the option. Write value | Label to show a label: the form shows the label, and the activity stores the value.">
                      <textarea id="field-options" class="form-control" rows="4" aria-describedby="@FieldHelp.Id("field-options")" @bind="selectedField.OptionsText"></textarea>
                    </FormField>
                    <FormField Label="Catalogue key" InputId="field-catalogue">
                      <input id="field-catalogue" class="form-control" @bind="selectedField.CatalogueKey" />
                    </FormField>
                  }
                  @if (selectedField.Type == FieldType.Scale)
                  {
                    <FormField Label="Entrustment scale" InputId="field-scale" HelpText="Levels of the chosen scale render as the rating dropdown at runtime.">
                      <select id="field-scale" class="form-select" aria-describedby="@FieldHelp.Id("field-scale")" @bind="selectedField.ScaleKey">
                        <option value="">Select…</option>
                        @foreach (var scale in _entrustmentScales)
                        {
                          <option value="@scale.Value">@scale.Label</option>
                        }
                      </select>
                    </FormField>
                  }
                  <div class="form-check">
                    <input id="field-required" class="form-check-input" type="checkbox" @bind="selectedField.Required" />
                    <label for="field-required">Required</label>
                  </div>
                </div>
              </div>
            }
          </div>

          <div class="detail-card">
            <h3>Live preview</h3>
            <ActivityForm SchemaJson="@CurrentDraftSchemaJson" DataJson="@_previewDataJson" DataJsonChanged="OnPreviewChanged" />
          </div>
        </div>
      }
      else if (_activeTab == "workflow" && !_editor.CanWrite)
      {
        <dl class="form-group">
          <dt>Workflow JSON</dt>
          <dd><pre class="code-block">@_workflowJson</pre></dd>
        </dl>
      }
      else if (_activeTab == "workflow")
      {
        <FormField Label="Workflow JSON" InputId="workflow-json" FullWidth="true">
          <textarea id="workflow-json" class="form-control font-mono" rows="18" @bind="_workflowJson"></textarea>
        </FormField>
      }
      else if (!_editor.CanWrite)
      {
        <dl class="form-group">
          <dt>Credit rules JSON</dt>
          <dd><pre class="code-block">@_creditRulesJson</pre></dd>
        </dl>
      }
      else
      {
        <FormField Label="Credit rules JSON" InputId="credit-json" FullWidth="true">
          <textarea id="credit-json" class="form-control font-mono" rows="18" @bind="_creditRulesJson"></textarea>
        </FormField>
      }
    </div>
  }
</StatePanel>

@code {
  [Parameter] public int? ActivityTypeId { get; set; }

  private static readonly (string Key, string Label)[] Tabs =
  [
    ("metadata", "Metadata"),
    ("form", "Form"),
    ("workflow", "Workflow"),
    ("credit", "Credit")
  ];

  private static readonly FieldType[] SupportedFieldTypes =
  [
    FieldType.Text,
    FieldType.LongText,
    FieldType.Number,
    FieldType.Date,
    FieldType.Choice,
    FieldType.MultiChoice,
    FieldType.Scale,
    FieldType.User,
    FieldType.Epa,
    FieldType.Likert,
    FieldType.ProcedureRef,
    FieldType.File,
    FieldType.Signature
  ];

  private ActivityTypeEditorDto? _editor;
  private BuilderSchemaModel _builderSchema = new();

  // T239: each section's and field's buttons are named by what they act on, "Move section Assessment up" (DESIGN.md
  // § Table system, the scale editor's "Move level 3 up"); every one read "Edit", "Up", "Down" and "Delete". A section is
  // named by its title and a field by its label, or by its key while it has none, and by its key as well where another
  // section or field reads the same.
  private IReadOnlyDictionary<int, string> SectionNames()
    => RowNames.Distinct(
      Enumerable.Range(0, _builderSchema.Sections.Count),
      index => index,
      index => TitleOrKey(_builderSchema.Sections[index].Title, _builderSchema.Sections[index].Key),
      index => $" ({_builderSchema.Sections[index].Key})");

  private IReadOnlyDictionary<BuilderFieldModel, string> FieldNames()
    => RowNames.Distinct(
      _builderSchema.Sections.SelectMany(section => section.Fields),
      field => field,
      field => TitleOrKey(field.Label, field.Key),
      field => $" ({field.Key})");

  private static string TitleOrKey(string title, string key) => string.IsNullOrWhiteSpace(title) ? key : title.Trim();
  private IReadOnlyList<ActivityCatalogueOption> _entrustmentScales = [];
  private bool _loading = true;
  private ActionResult? _result;

  /// <summary>The header action that has been sent and has not yet answered, or null. (T234)</summary>
  private string? _inFlight;

  private const string SaveAction = "save";
  private const string DiscardAction = "discard";
  private const string PublishAction = "publish";

  private bool OtherInFlight(string action) => _inFlight is not null && _inFlight != action;

  private bool Running(string action) => _inFlight == action;
  private string? _loadError;
  private string? _actionError;
  private string? _status;
  private string _activeTab = "form";
  private string _key = string.Empty;
  private string _name = string.Empty;
  private string? _description;
  private ActivityScope _scope;
  private string _scopeIdText = string.Empty;
  private bool _isActive = true;
  private string _wbaToolKey = string.Empty;
  private IReadOnlyList<WbaToolDto> _wbaTools = [];
  private string _workflowJson = string.Empty;
  private string _creditRulesJson = string.Empty;
  private string _previewDataJson = "{}";
  private readonly List<string> _publishWarnings = [];
  private int _selectedSectionIndex = -1;
  private int _selectedFieldIndex = -1;

  private bool IsPublished => (_editor?.PublishedVersion ?? 0) > 0;
  private bool CanPublish => (_editor?.Id ?? 0) > 0 && _editor?.HasDraft == true;
  private string CurrentDraftSchemaJson => _builderSchema.ToJson();

  /// <summary>
  /// Whether the caller may save, discard and publish what the page shows (T300): the editor's <c>CanWrite</c>, the rule
  /// the commands refuse by (<c>ActivityTypeAdminScope</c>). False until the editor has loaded, and after it failed to.
  /// </summary>
  private bool CanWrite => _editor?.CanWrite == true;

  /// <summary>The page's own address says whether it is a new type, never a missing editor (the T295 sweep).</summary>
  private bool IsNewRoute => ActivityTypeId is null;

  private string PageTitleText => IsNewRoute
    ? "New activity type"
    : _editor is null
      ? "Activity type"
      : _editor.CanWrite ? $"Edit {_name}" : _editor.Name;

  private string DocumentTitle => IsNewRoute
    ? "New activity type"
    : string.IsNullOrWhiteSpace(_editor?.Name) ? "Activity type" : _editor.Name;

  private string PageSubtitle => CanWrite
    ? "Build the form, workflow, and credit definition for this activity type."
    : "The form, workflow, and credit definition of this activity type.";

  /// <summary>
  /// Whose type a reader is looking at, and that they read it here and change nothing (T300). A Speciality or
  /// SubSpeciality type is its College's (T091), a Global one the Administrator's, an Institution one its institution's.
  /// </summary>
  private string ReadOnlyNotice
  {
    get
    {
      var target = _editor?.ScopeTargetName;
      var whose = _editor?.Scope switch
      {
        ActivityScope.Speciality or ActivityScope.SubSpeciality => target is null
          ? "Set by the College."
          : $"Set by the College that owns {target}.",
        ActivityScope.Institution => target is null ? "Set by its institution." : $"Set by {target}.",
        _ => "Set by a global administrator."
      };

      return $"{whose} You can read this activity type here, but not change it.";
    }
  }

  private static string ScopeLabel(ActivityScope scope) => scope switch
  {
    ActivityScope.Global => "Global",
    ActivityScope.Institution => "Institution",
    ActivityScope.Speciality => "Speciality",
    ActivityScope.SubSpeciality => "Sub-speciality",
    _ => scope.ToString()
  };

  /// <summary>The stored scope, and its target by name, as a reader sees it: "Speciality · Paediatrics".</summary>
  private string StoredScopeText
  {
    get
    {
      if (_editor is null)
      {
        return string.Empty;
      }

      var target = _editor.ScopeTargetName ?? (_editor.ScopeId is int id ? $"#{id}" : null);
      return target is null ? ScopeLabel(_editor.Scope) : $"{ScopeLabel(_editor.Scope)} · {target}";
    }
  }

  private string WbaToolText => string.IsNullOrEmpty(_wbaToolKey)
    ? "Not a WBA instrument"
    : _wbaTools.FirstOrDefault(tool => tool.Key == _wbaToolKey)?.Name ?? $"{_wbaToolKey} (not a known instrument)";

  private string ScaleText(string? scaleKey) => string.IsNullOrWhiteSpace(scaleKey)
    ? "None"
    : _entrustmentScales.FirstOrDefault(scale => scale.Value == scaleKey)?.Label ?? scaleKey;

  private static IReadOnlyList<string> OptionLines(string? optionsText) => (optionsText ?? string.Empty)
    .Split('\n')
    .Select(line => line.Trim())
    .Where(line => line.Length > 0)
    .ToList();

  /// <summary>The targets the caller may save a type at in the chosen scope (the editor's WritableScopes, T300).</summary>
  private IReadOnlyList<ActivityTypeScopeTargetDto> ScopeTargets
    => _editor?.WritableScopes.FirstOrDefault(choice => choice.Scope == _scope)?.Targets ?? [];

  /// <summary>
  /// A scope the picker offers, and a target the caller may save at in it: the type's own where it is stored in this
  /// scope, else the scope's first. Never none, so a save is never sent without a target (T300).
  /// </summary>
  private void OnScopeChanged(ChangeEventArgs args)
  {
    var choice = _editor?.WritableScopes.FirstOrDefault(offered => offered.Scope.ToString() == args.Value?.ToString());
    if (choice is null)
    {
      return;
    }

    _scope = choice.Scope;
    var stored = choice.Scope == _editor!.Scope ? choice.Targets.FirstOrDefault(target => target.Id == _editor.ScopeId) : null;
    _scopeIdText = (stored ?? choice.Targets.FirstOrDefault())?.Id.ToString() ?? string.Empty;
  }

  /// <summary>
  /// The field keys eligible to be a root pointer: those of the type the parser demands. (T133)
  /// </summary>
  /// <remarks>
  /// The current pointer is included even when its field has been deleted, so the select shows what
  /// is set rather than silently reading as "None" — the operator has to be able to SEE an orphaned
  /// pointer in order to clear it. `ToJson` drops it on save either way, and `GetPublishWarnings`
  /// says so.
  /// </remarks>
  private IReadOnlyList<string> EligibleFieldKeys(FieldType fieldType)
  {
    var keys = _builderSchema.Sections
      .SelectMany(section => section.Fields)
      .Where(field => field.Type == fieldType && !string.IsNullOrWhiteSpace(field.Key))
      .Select(field => field.Key.Trim())
      .Distinct(StringComparer.Ordinal)
      .ToList();

    var current = fieldType switch
    {
      FieldType.Date => _builderSchema.ObservationDateField,
      FieldType.Scale => _builderSchema.RatedLevelField,
      FieldType.Epa => _builderSchema.EvidenceEpaField,
      _ => null
    };

    if (!string.IsNullOrWhiteSpace(current) && !keys.Contains(current, StringComparer.Ordinal))
    {
      keys.Insert(0, current);
    }

    return keys;
  }

  private void OnObservationDateFieldChanged(ChangeEventArgs args)
  {
    _builderSchema.ObservationDateField = NullIfEmpty(args.Value?.ToString());
    RefreshWarnings();
  }

  private void OnRatedLevelFieldChanged(ChangeEventArgs args)
  {
    _builderSchema.RatedLevelField = NullIfEmpty(args.Value?.ToString());
    RefreshWarnings();
  }

  private void OnEvidenceEpaFieldChanged(ChangeEventArgs args)
  {
    _builderSchema.EvidenceEpaField = NullIfEmpty(args.Value?.ToString());
    RefreshWarnings();
  }

  /// <summary>The vocabulary, plus the stored key when the vocabulary no longer holds it (T122).</summary>
  private IEnumerable<WbaToolDto> WbaToolOptions =>
    string.IsNullOrEmpty(_wbaToolKey) || _wbaTools.Any(tool => tool.Key == _wbaToolKey)
      ? _wbaTools
      : _wbaTools.Append(new WbaToolDto(_wbaToolKey, $"{_wbaToolKey} (not a known instrument)", null));

  private static string? NullIfEmpty(string? value) =>
    string.IsNullOrWhiteSpace(value) ? null : value.Trim();

  protected override async Task OnParametersSetAsync()
  {
    // T300: the editor of the address before this one is not this address's; until this one loads, the page offers
    // nothing to save (the T295 sweep: a Save draft while loading sent a create).
    _editor = null;
    _loading = true;
    _loadError = null;
    _actionError = null;
    _status = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var editor = await Sender.Send(new Wombat.Application.Features.Activities.Queries.GetActivityTypeEditor.GetActivityTypeEditorQuery(ActivityTypeId, authState.User));
      _entrustmentScales = await ReferenceData.GetEntrustmentScaleOptionsAsync();
      _wbaTools = await Sender.Send(new GetWbaToolsQuery());

      // Held back until everything has loaded, so a failed load leaves no editor, and so no Save draft (T300).
      _editor = editor;
      LoadEditorState(editor);
      RefreshWarnings();
    }
    catch (Exception exception)
    {
      _loadError = RefusalText.Of(exception);
    }
    finally
    {
      _loading = false;
    }
  }

  private void LoadEditorState(ActivityTypeEditorDto editor)
  {
    _key = editor.Key;
    _name = editor.Name;
    _description = editor.Description;
    _scope = editor.Scope;
    _scopeIdText = editor.ScopeId?.ToString() ?? string.Empty;
    _isActive = editor.IsActive;
    _wbaToolKey = editor.WbaToolKey ?? string.Empty;
    _builderSchema = BuilderSchemaModel.Parse(editor.DraftSchemaJson);
    _workflowJson = editor.DraftWorkflowJson;
    _creditRulesJson = editor.DraftCreditRulesJson;
    _previewDataJson = "{}";
    _selectedSectionIndex = _builderSchema.Sections.Count > 0 ? 0 : -1;
    _selectedFieldIndex = _selectedSectionIndex >= 0 && _builderSchema.Sections[0].Fields.Count > 0 ? 0 : -1;
  }

  /// <remarks>
  /// Sent at most once at a time (T234): the flag is set before the first await, so a second press does nothing. A save
  /// that is done moves the focus to its result, unless it created the type: the page then moves to the type's own
  /// address, which reads it again.
  /// </remarks>
  private async Task SaveDraftAsync()
  {
    // Not offered where the caller may not write (T300); the command refuses it all the same.
    if (_inFlight is not null || !CanWrite)
    {
      return;
    }

    _inFlight = SaveAction;
    try
    {
      if (await SaveDraftCoreAsync())
      {
        _result?.FocusAfterRender();
      }
    }
    finally
    {
      _inFlight = null;
    }
  }

  /// <summary>Saves the draft. Returns whether it was saved on a type that already existed, so the page stays.</summary>
  private async Task<bool> SaveDraftCoreAsync()
  {
    _actionError = null;
    _status = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var actorUserId = await GetCurrentUserIdAsync();
      var wasNew = (_editor?.Id ?? 0) == 0;
      _editor = await Sender.Send(new Wombat.Application.Features.Activities.Commands.SaveActivityTypeDraft.SaveActivityTypeDraftCommand(
        _editor?.Id,
        _key,
        _name,
        _description,
        _scope,
        ParseNullableInt(_scopeIdText),
        _isActive,
        NullIfEmpty(_wbaToolKey),
        CurrentDraftSchemaJson,
        _workflowJson,
        _creditRulesJson,
        BuilderSchemaModel.BuildDisplayFieldsJson(_builderSchema),
        actorUserId,
        authState.User));

      _status = "Draft saved.";
      RefreshWarnings();

      if (wasNew && _editor.Id > 0)
      {
        Navigation.NavigateTo($"/admin/activity-types/{_editor.Id}", forceLoad: false);
        return false;
      }

      return true;
    }
    catch (Exception exception)
    {
      _actionError = RefusalText.Of(exception);
      return false;
    }
  }

  private async Task PublishAsync()
  {
    if (_inFlight is not null || !CanWrite)
    {
      return;
    }

    _inFlight = PublishAction;
    try
    {
      if (_editor is null || _editor.Id <= 0)
      {
        await SaveDraftCoreAsync();
      }

      if (_editor is null || _editor.Id <= 0)
      {
        return;
      }

      await PublishCoreAsync(_editor.Id);
    }
    finally
    {
      _inFlight = null;
    }
  }

  private async Task PublishCoreAsync(int activityTypeId)
  {
    _actionError = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var actorUserId = await GetCurrentUserIdAsync();
      _editor = await Sender.Send(new Wombat.Application.Features.Activities.Commands.PublishActivityTypeDraft.PublishActivityTypeDraftCommand(
        activityTypeId,
        actorUserId,
        authState.User));
      _status = $"Published version {_editor.PublishedVersion}.";
      RefreshWarnings();
      _result?.FocusAfterRender();
    }
    catch (Exception exception)
    {
      _actionError = RefusalText.Of(exception);
    }
  }

  private async Task DiscardDraftAsync()
  {
    if (_editor is null || _editor.Id <= 0 || _inFlight is not null || !CanWrite)
    {
      return;
    }

    _inFlight = DiscardAction;
    _actionError = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _editor = await Sender.Send(new Wombat.Application.Features.Activities.Commands.DiscardActivityTypeDraft.DiscardActivityTypeDraftCommand(_editor.Id, authState.User));
      LoadEditorState(_editor);
      _status = "Draft discarded.";
      RefreshWarnings();
      _result?.FocusAfterRender();
    }
    catch (Exception exception)
    {
      _actionError = RefusalText.Of(exception);
    }
    finally
    {
      _inFlight = null;
    }
  }

  private void AddSection()
  {
    var fieldKey = _builderSchema.NextFieldKey();
    _builderSchema.Sections.Add(new BuilderSectionModel
    {
      Key = _builderSchema.NextSectionKey(),
      Title = $"Section {_builderSchema.Sections.Count + 1}",
      Fields =
      [
        new BuilderFieldModel
        {
          Key = fieldKey,
          Label = "New field"
        }
      ]
    });
    SelectSection(_builderSchema.Sections.Count - 1);
    SelectField(_builderSchema.Sections.Count - 1, 0);
    RefreshWarnings();
  }

  private void SelectSection(int sectionIndex)
  {
    _selectedSectionIndex = sectionIndex;
    _selectedFieldIndex = _builderSchema.Sections[sectionIndex].Fields.Count > 0 ? 0 : -1;
  }

  private void AddField(int sectionIndex)
  {
    var section = _builderSchema.Sections[sectionIndex];
    section.Fields.Add(new BuilderFieldModel
    {
      Key = _builderSchema.NextFieldKey(),
      Label = "New field"
    });
    SelectField(sectionIndex, section.Fields.Count - 1);
    RefreshWarnings();
  }

  /// <summary>
  /// The roles a User field may name, plus a stored value outside them so the select never shows a different role from
  /// the one the schema holds (as the tool picker keeps an unknown key, T122). The parser refuses such a value at save.
  /// </summary>
  private static IEnumerable<string> NomineeRoleChoices(string? current)
  {
    var choices = WombatRoles.Nominable.Where(role => role != WombatRoles.Assessor).ToList();
    if (!string.IsNullOrWhiteSpace(current) &&
        !string.Equals(current, WombatRoles.Assessor, StringComparison.Ordinal) &&
        !choices.Contains(current, StringComparer.Ordinal))
    {
      choices.Add(current);
    }

    return string.Equals(current, WombatRoles.Assessor, StringComparison.Ordinal)
      ? choices.Prepend(WombatRoles.Assessor)
      : choices;
  }

  private void SelectField(int sectionIndex, int fieldIndex)
  {
    _selectedSectionIndex = sectionIndex;
    _selectedFieldIndex = fieldIndex;
  }

  private void MoveSection(int sectionIndex, int delta)
  {
    var targetIndex = sectionIndex + delta;
    if (targetIndex < 0 || targetIndex >= _builderSchema.Sections.Count)
    {
      return;
    }

    (_builderSchema.Sections[sectionIndex], _builderSchema.Sections[targetIndex]) = (_builderSchema.Sections[targetIndex], _builderSchema.Sections[sectionIndex]);
    _selectedSectionIndex = targetIndex;
    RefreshWarnings();
  }

  private void DeleteSection(int sectionIndex)
  {
    _builderSchema.Sections.RemoveAt(sectionIndex);
    _selectedSectionIndex = _builderSchema.Sections.Count > 0 ? Math.Min(sectionIndex, _builderSchema.Sections.Count - 1) : -1;
    _selectedFieldIndex = _selectedSectionIndex >= 0 && _builderSchema.Sections[_selectedSectionIndex].Fields.Count > 0 ? 0 : -1;
    RefreshWarnings();
  }

  private void MoveField(int sectionIndex, int fieldIndex, int delta)
  {
    var fields = _builderSchema.Sections[sectionIndex].Fields;
    var targetIndex = fieldIndex + delta;
    if (targetIndex < 0 || targetIndex >= fields.Count)
    {
      return;
    }

    (fields[fieldIndex], fields[targetIndex]) = (fields[targetIndex], fields[fieldIndex]);
    _selectedFieldIndex = targetIndex;
    RefreshWarnings();
  }

  private void DeleteField(int sectionIndex, int fieldIndex)
  {
    var fields = _builderSchema.Sections[sectionIndex].Fields;
    fields.RemoveAt(fieldIndex);
    _selectedFieldIndex = fields.Count > 0 ? Math.Min(fieldIndex, fields.Count - 1) : -1;
    RefreshWarnings();
  }

  private Task OnPreviewChanged(string dataJson)
  {
    _previewDataJson = dataJson;
    return Task.CompletedTask;
  }

  private void RefreshWarnings()
  {
    _publishWarnings.Clear();

    try
    {
      _publishWarnings.AddRange(BuilderSchemaModel.GetPublishWarnings(_editor?.PublishedSchemaJson, CurrentDraftSchemaJson));
    }
    catch
    {
      // The draft may be temporarily invalid while the admin is typing.
    }
  }

  private async Task<string> GetCurrentUserIdAsync()
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    return authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
      ?? throw new InvalidOperationException("The current user identifier is missing.");
  }

  private static int? ParseNullableInt(string? value)
    => int.TryParse(value, out var parsed) ? parsed : null;

  private static string FieldTypeLabel(FieldType fieldType)
    => fieldType switch
    {
      FieldType.LongText => "Long text",
      FieldType.MultiChoice => "Multi-choice",
      FieldType.Scale => "Scale",
      FieldType.User => "User",
      FieldType.Epa => "EPA",
      FieldType.ProcedureRef => "Procedure reference",
      _ => fieldType.ToString()
    };
}

@page "/admin/activity-types"
@* T300: the College writes its disciplines' types (T091), so the list admits a CollegeAdmin beside an Administrator and
   an InstitutionalAdmin. Each row says what the caller may do with it. *@
@attribute [Authorize(Policy = "NationalCatalogueAccess")]
@using Wombat.Domain.Activities
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Activity Types</PageTitle>

<PageHeader Title="Activity types" Subtitle="Manage draft and published activity-type definitions.">
  <Actions>
    @* T300: offered only to a caller with a scope to create a type in (ActivityTypeAdminListDto.CanCreate). *@
    @if (_canCreate)
    {
      <a class="btn btn-primary" href="/admin/activity-types/new">New activity type</a>
    }
  </Actions>
</PageHeader>

<div class="search-container shadow mb-3">
  <div class="search-grid">
    <div class="search-field">
      <label for="activity-type-filter">Search</label>
      <input id="activity-type-filter" class="search-input" @bind="_search" @bind:event="oninput" />
    </div>
  </div>
</div>

@{ var rowNames = RowNames.Distinct(FilteredItems, type => type.Id, type => type.Name, type => $" ({type.Key})"); }
<StatePanel IsLoading="_loading" LoadError="@_error" IsEmpty="@(!_loading && FilteredItems.Count == 0)" EmptyTitle="No activity types" EmptyBody="@(_canCreate ? "Create the first activity type to start the builder." : "No activity type is open to you yet.")">
  <DataTable Items="FilteredItems" Caption="Configured activity types">
    <HeaderRow>
      <tr>
        <th>Name</th>
        <th>Key</th>
        <th>Scope</th>
        <th>Published</th>
        <th>Draft</th>
        <th>Status</th>
        <th><span class="visually-hidden">Actions</span></th>
      </tr>
    </HeaderRow>
    <Row Context="item">
      <tr>
        <td>@item.Name</td>
        <td><code>@item.Key</code></td>
        <td>@FormatScope(item)</td>
        <td>v@(item.PublishedVersion)</td>
        <td>@(item.HasDraft ? "Draft saved" : "None")</td>
        <td>@(item.IsActive ? "Active" : "Inactive")</td>
        <td>
          @* T239: named by its row, the type's name, and its key where two types share a name. T300: Edit where the caller
             may write the type (CanWrite, the rule the commands refuse by), View where they may only read it; both open
             the builder, which is read-only to a reader. *@
          <div class="actions-cell">
            @if (item.CanWrite)
            {
              <a class="btn btn-outline btn-sm" href="@($"/admin/activity-types/{item.Id}")" aria-label="@($"Edit {rowNames[item.Id]}")">Edit</a>
            }
            else
            {
              <a class="btn btn-outline btn-sm" href="@($"/admin/activity-types/{item.Id}")" aria-label="@($"View {rowNames[item.Id]}")">View</a>
            }
          </div>
        </td>
      </tr>
    </Row>
    <Empty>
      <div class="detail-card detail-card--empty">
        No activity types match the current filter.
      </div>
    </Empty>
  </DataTable>
</StatePanel>

@code {
  private readonly List<ActivityTypeAdminListItemDto> _items = [];
  private bool _loading = true;
  private bool _canCreate;
  private string? _error;
  private string? _search;

  private IReadOnlyList<ActivityTypeAdminListItemDto> FilteredItems =>
    _items
      .Where(item =>
        string.IsNullOrWhiteSpace(_search) ||
        item.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        item.Key.Contains(_search, StringComparison.OrdinalIgnoreCase))
      .ToList();

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var list = await Sender.Send(new Wombat.Application.Features.Activities.Queries.ListActivityTypesAdmin.ListActivityTypesAdminQuery(authState.User));
      _items.AddRange(list.Items);
      _canCreate = list.CanCreate;
    }
    catch (Exception exception)
    {
      _error = RefusalText.Of(exception);
    }
    finally
    {
      _loading = false;
    }
  }

  /// <summary>
  /// The scope and its target as the query names it, as the editor reads a stored scope: "Speciality · Paediatrics",
  /// "Sub-speciality · Paediatrics / Neonatology", "Institution · Kalafong". The page resolves no names of its own: it
  /// did, from the caller's own institutions and disciplines, so every other College's row read "Speciality · #1" (T291
  /// item 5). Only a target that no longer exists still reads by its id.
  /// </summary>
  private static string FormatScope(ActivityTypeAdminListItemDto item)
  {
    var scope = item.Scope switch
    {
      ActivityScope.Global => "Global",
      ActivityScope.Institution => "Institution",
      ActivityScope.Speciality => "Speciality",
      ActivityScope.SubSpeciality => "Sub-speciality",
      _ => item.Scope.ToString()
    };

    var target = item.ScopeTargetName ?? (item.ScopeId is int id ? $"#{id}" : null);
    return target is null ? scope : $"{scope} · {target}";
  }
}

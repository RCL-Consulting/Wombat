@page "/admin/jobs"
@attribute [Authorize(Policy = "Administrator")]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Scheduled jobs</PageTitle>

<PageHeader Title="Scheduled jobs" Subtitle="View and manage background jobs. Toggle jobs on or off, trigger manual runs, and view run history.">
  <Actions>
    <a class="btn btn-outline" href="/admin/jobs/runs">
      <Icon Name="clock" />
      Run history
    </a>
  </Actions>
</PageHeader>

<StatePanel IsLoading="@(_jobs is null && string.IsNullOrWhiteSpace(_errorMessage))" LoadError="@_errorMessage" IsEmpty="@(_jobs?.Count == 0)" EmptyTitle="No jobs registered" EmptyBody="No scheduled jobs have been registered in the system.">
  @if (_jobs is not null)
  {
    <DataTable TItem="Wombat.Application.Features.Scheduling.ScheduledJobDto" Items="_jobs" Caption="Scheduled jobs">
      <HeaderRow>
        <tr>
          <th>Job</th>
          <th>Schedule</th>
          <th>Last run</th>
          <th>Status</th>
          <th>Next run</th>
          <th>Enabled</th>
          <th><span class="visually-hidden">Actions</span></th>
        </tr>
      </HeaderRow>
      <Row Context="job">
        <tr>
          <td>
            <strong>@job.Key</strong>
            <div class="text-muted text-sm">@job.Description</div>
          </td>
          <td><code>@job.CronExpression</code></td>
          <td>@(job.LastRunAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
          <td>
            @if (job.LastRunStatus is not null)
            {
              <span class="badge @StatusBadgeClass(job.LastRunStatus)">@job.LastRunStatus</span>
            }
            else
            {
              <span>—</span>
            }
          </td>
          <td>@(job.NextRunAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
          <td>
            @* While a row's action runs the other buttons are disabled, and the one pressed is not (T234): it has the
               focus, and a browser drops the focus of a button it disables, to the page. A second press sends nothing. *@
            @* T239: each named by its job, whose key is unique: "Disable msf-campaign-auto-close", and in the next cell
               "Run now: msf-campaign-auto-close". *@
            <button class="btn btn-outline btn-sm" @onclick="() => ToggleAsync(job)" disabled="@OtherInFlight(ToggleAction(job))"
                    aria-label="@($"{(job.IsEnabled ? "Disable" : "Enable")} {job.Key}")"
                    aria-disabled="@InFlight.AriaDisabled(Running(ToggleAction(job)))">
              @(job.IsEnabled ? "Disable" : "Enable")
            </button>
          </td>
          <td>
            <div class="actions-cell">
              <button class="btn btn-outline btn-sm" @onclick="() => RunNowAsync(job)" disabled="@(OtherInFlight(RunAction(job)) || !job.IsEnabled)"
                      aria-label="@($"Run now: {job.Key}")"
                      aria-disabled="@InFlight.AriaDisabled(Running(RunAction(job)))">
                Run now
              </button>
            </div>
          </td>
        </tr>
      </Row>
    </DataTable>
  }
</StatePanel>

@* What Enable, Disable or Run now did. It takes the focus once the action is done (T234; DESIGN.md § Button system): a
   status arriving on its own is often not read. A refusal leaves the focus on the button: it is an alert, read at once. *@
<ActionResult @ref="_result">
  @if (!string.IsNullOrWhiteSpace(_actionMessage))
  {
    <Alert Kind="@(_actionSuccess ? "success" : "danger")">@_actionMessage</Alert>
  }
</ActionResult>

@code {
  private IReadOnlyList<Wombat.Application.Features.Scheduling.ScheduledJobDto>? _jobs;
  private string? _errorMessage;
  private ActionResult? _result;

  /// <summary>The row action that has been sent and has not yet answered, or null. (T234)</summary>
  private string? _inFlight;

  private static string ToggleAction(Wombat.Application.Features.Scheduling.ScheduledJobDto job) => $"toggle:{job.Key}";

  private static string RunAction(Wombat.Application.Features.Scheduling.ScheduledJobDto job) => $"run:{job.Key}";

  private bool OtherInFlight(string action) => _inFlight is not null && _inFlight != action;

  private bool Running(string action) => _inFlight == action;
  private string? _actionMessage;
  private bool _actionSuccess;

  protected override async Task OnInitializedAsync()
  {
    await LoadJobsAsync();
  }

  private async Task LoadJobsAsync()
  {
    try
    {
      _jobs = await Sender.Send(new Wombat.Application.Features.Scheduling.Queries.GetScheduledJobStatus.GetScheduledJobStatusQuery());
    }
    catch (Exception ex)
    {
      _errorMessage = ex.Message;
    }
  }

  private async Task ToggleAsync(Wombat.Application.Features.Scheduling.ScheduledJobDto job)
  {
    if (_inFlight is not null)
    {
      return;
    }

    _inFlight = ToggleAction(job);
    _actionMessage = null;

    try
    {
      if (job.IsEnabled)
      {
        await Sender.Send(new Wombat.Application.Features.Scheduling.Commands.DisableScheduledJob.DisableScheduledJobCommand(job.Key));
        _actionMessage = $"Job '{job.Key}' disabled.";
      }
      else
      {
        await Sender.Send(new Wombat.Application.Features.Scheduling.Commands.EnableScheduledJob.EnableScheduledJobCommand(job.Key));
        _actionMessage = $"Job '{job.Key}' enabled.";
      }
      _actionSuccess = true;
      await LoadJobsAsync();
      _result?.FocusAfterRender();
    }
    catch (Exception ex)
    {
      _actionMessage = ex.Message;
      _actionSuccess = false;
    }
    finally
    {
      _inFlight = null;
    }
  }

  private async Task RunNowAsync(Wombat.Application.Features.Scheduling.ScheduledJobDto job)
  {
    if (_inFlight is not null)
    {
      return;
    }

    _inFlight = RunAction(job);
    _actionMessage = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "unknown";
      await Sender.Send(new Wombat.Application.Features.Scheduling.Commands.RunScheduledJobNow.RunScheduledJobNowCommand(job.Key, userId));
      _actionMessage = $"Job '{job.Key}' dispatched.";
      _actionSuccess = true;
      await LoadJobsAsync();
      _result?.FocusAfterRender();
    }
    catch (Exception ex)
    {
      _actionMessage = ex.Message;
      _actionSuccess = false;
    }
    finally
    {
      _inFlight = null;
    }
  }

  private static string StatusBadgeClass(string status) => status switch
  {
    "Succeeded" => "badge-success",
    "Failed" => "badge-danger",
    "Running" => "badge-warning",
    _ => ""
  };
}

@page "/admin/jobs/runs"
@attribute [Authorize(Policy = "Administrator")]
@using Wombat.Application.Features.Scheduling
@using Wombat.Application.Features.Scheduling.Queries.GetScheduledJobRuns
@inject IScopedSender Sender
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<ScheduledJobRunsList> Logger

<PageTitle>Run history · Wombat</PageTitle>

@*
  Run history (T400, flow 18, lane B; boards R3-R01–R09, R2-R03, R08, R10, R11). Until T400 "Job run history", with
  Back to jobs, a free-text key filtered per keystroke, UTC days, the server's clock, a user id for Triggered by and the
  error cut at 80 characters.

  - The filters (T1): Job a select of the jobs' keys, "All jobs" first (it cannot miss); Status; From and To as South
    African days (K7); Show, then Clear filters once a filter is applied, in .filter-actions (T328). Nothing filters until
    Show, which goes to the page's own address with what was chosen (T18), so Home's and a failed run's "Its runs" open
    the same rows; the page reads the address whenever it changes. The filters stay drawn over the loading and the load
    error; Show waits for the first read (R2-R10).
  - h2 "Runs" (N1), which a page turn focuses; the count line, which Show focuses and which is no live region (N2).
  - The table: StackWide, in the 1024px stack through .job-runs-page (§ 0, C1); Job the row header (S7); Started in SAST
    to the second, never breaking (one .nowrap, T400's replay); Duration, "—" while it runs; Status, a failed run's
    error whole under its badge (T1); Ran by the person's name, or "Scheduler" (M3).
  - PagerControls at 50 (M2), in its own order. No match: what was asked, and "Clear the filters", which focuses Job; no
    runs at all: "No job has run yet", with no count line and no pager (R2-R08).
  - A failed read in fixed words with Try again, which focuses the h1 once it reads (S3, T329).
*@
<PageHeader Title="Run history" Subtitle="@JobWords.RunsSubtitle" />

<div class="people-page job-runs-page" aria-busy="@(_loading ? "true" : null)">
  <form class="search-container people-filter" role="search" aria-label="@JobWords.FilterName" novalidate @onsubmit="ShowAsync">
    <div class="search-grid">
      <div class="search-field">
        <label for="@JobFieldId">@JobWords.JobLabel</label>
        <select id="@JobFieldId" class="form-select" @bind="_formJob">
          <option value="">@JobWords.AllJobs</option>
          @* Each option keyed by its job (T400's replay): before the first read the list is "All jobs" and the address's job;
             the read then puts the stored keys before it. Unkeyed, the diff rewrote the selected second option's value to
             the first stored key, and the browser kept that option selected: the select showed activity-draft-nudge while
             the list was the address's job's. Keyed, the address's option is the same element after the read, still chosen. *@
          @foreach (var key in JobKeys)
          {
            <option @key="key" value="@key">@key</option>
          }
        </select>
      </div>
      <div class="search-field">
        <label for="runs-status">@JobWords.StatusLabel</label>
        <select id="runs-status" class="form-select" @bind="_formStatus">
          <option value="">@JobWords.AllStatuses</option>
          @foreach (var status in JobWords.Statuses)
          {
            <option value="@status">@JobWords.Status(status)</option>
          }
        </select>
      </div>
      <div class="search-field">
        <label for="runs-from">@JobWords.FromLabel</label>
        <input id="runs-from" type="date" class="form-control" @bind="_formFrom" />
      </div>
      <div class="search-field">
        <label for="runs-to">@JobWords.ToLabel</label>
        <input id="runs-to" type="date" class="form-control" @bind="_formTo" />
      </div>
    </div>
    <div class="filter-actions">
      <button type="submit" class="btn btn-primary" aria-disabled="@(_page is null ? "true" : null)">@JobWords.Show</button>
      @if (_applied.IsFiltered)
      {
        <button type="button" class="btn btn-outline" @onclick="ClearAsync">@JobWords.ClearFilters</button>
      }
    </div>
  </form>

  <h2 id="@HeadingId" class="list-section-title" tabindex="-1">@JobWords.RunsHeading</h2>

  <StatePanel @ref="_panel" IsLoading="_loading" LoadError="@_loadError" OnRetry="RetryAsync" FocusAfterRetry="FocusPageHeadingAsync">
    <LoadingContent>
      <p class="loading-line" role="status">@JobWords.RunsLoading</p>
      <div class="detail-card" aria-hidden="true">
        <div class="skeleton skel-title"></div>
        <div class="skeleton skel-line"></div>
        <div class="skeleton skel-line"></div>
        <div class="skeleton skel-line"></div>
        <div class="skeleton skel-line skel-short"></div>
      </div>
    </LoadingContent>
    <ChildContent>
      @if (_page is { } page)
      {
        @if (page.AllRunsCount == 0)
        {
          @* A new install (R2-R08): no count line, no table, no pager. *@
          <div class="detail-card detail-card--empty">
            <div class="state-panel-title">@JobWords.NoneTitle</div>
            <div class="state-panel-copy">@JobWords.NoneBody</div>
          </div>
        }
        else
        {
          <p id="@CountLineId" tabindex="-1">@JobWords.CountLine(page.TotalCount)</p>
          @if (page.Items.Count == 0)
          {
            @* No match is not empty (T17, R2-R03): the filters are kept, and one press clears them. *@
            <div class="detail-card detail-card--empty">
              <div class="state-panel-title">@JobWords.NoMatchTitle</div>
              <div class="state-panel-copy">@JobWords.NoMatchBody(page.AllRunsCount)</div>
              <div class="form-actions">
                <button type="button" class="btn btn-primary" @onclick="ClearAsync">@JobWords.ClearTheFilters</button>
              </div>
            </div>
          }
          else
          {
            <DataTable TItem="ScheduledJobRunDto" Items="page.Items" StackWide="true" Caption="@JobWords.RunsCaption">
              <HeaderRow>
                <tr role="row">
                  <th scope="col" role="columnheader">Job</th>
                  <th scope="col" role="columnheader">Started</th>
                  <th scope="col" role="columnheader" class="col-fit--wide">Duration</th>
                  <th scope="col" role="columnheader">Status</th>
                  <th scope="col" role="columnheader">Ran by</th>
                </tr>
              </HeaderRow>
              <Row Context="run">
                <tr role="row" @key="run.Id">
                  <th scope="row" role="rowheader">@run.Key</th>
                  @* A time here never breaks: the day and the hour are one unit (T400's replay; DESIGN.md § Table system). *@
                  <td role="cell" data-label="Started"><span class="nowrap">@JobWords.Day(run.StartedAt) @JobWords.ClockToSecond(run.StartedAt)</span></td>
                  <td role="cell" data-label="Duration" class="col-fit--wide">@JobWords.Duration(run.StartedAt, run.FinishedAt)</td>
                  <td role="cell" data-label="Status">
                    <span class="badge @BadgeFor.JobRun(run.Status)">@JobWords.Status(run.Status)</span>
                    @if (!string.IsNullOrWhiteSpace(run.ErrorMessage))
                    {
                      @* The error whole, wrapping under its badge (T1, R3-R07): never cut at 80 with a tooltip. *@
                      <br /><span class="text-sm">@run.ErrorMessage</span>
                    }
                  </td>
                  <td role="cell" data-label="Ran by">@JobWords.RanBy(run.RanBy)</td>
                </tr>
              </Row>
            </DataTable>
            <PagerControls Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount"
                           OnPageChanged="TurnPageAsync" OnPageSizeChanged="ChangePageSizeAsync" />
          }
        }
      }
    </ChildContent>
  </StatePanel>
</div>

@code {
  private const string JobFieldId = "runs-job";
  private const string HeadingId = "runs-heading";
  private const string CountLineId = "runs-count";

  [SupplyParameterFromQuery(Name = JobLinks.JobParameter)] public string? Job { get; set; }

  [SupplyParameterFromQuery(Name = JobLinks.StatusParameter)] public string? Status { get; set; }

  [SupplyParameterFromQuery(Name = RunHistoryAddress.FromParameter)] public string? From { get; set; }

  [SupplyParameterFromQuery(Name = RunHistoryAddress.ToParameter)] public string? To { get; set; }

  [SupplyParameterFromQuery(Name = RunHistoryAddress.PageParameter)] public int? PageNumber { get; set; }

  [SupplyParameterFromQuery(Name = RunHistoryAddress.SizeParameter)] public int? Size { get; set; }

  private ScheduledJobRunsPageDto? _page;
  private bool _loading = true;
  private string? _loadError;
  private StatePanel? _panel;
  private bool _loadedOnce;
  private RunHistoryAddress _applied = RunHistoryAddress.None;

  // The form's fields: what is being chosen, which changes nothing until Show.
  private string _formJob = string.Empty;
  private string _formStatus = string.Empty;
  private DateOnly? _formFrom;
  private DateOnly? _formTo;

  // What takes the focus once the read the page's own action started has drawn: the count line after Show, the heading
  // after a page turn, Job after a clear; none for a change of page size, which leaves it on the select.
  private string? _focusOnArrival;
  private string? _focusId;

  // The keys the select offers: the stored jobs' (the read's), and the one the address names, so it is shown selected.
  private IEnumerable<string> JobKeys
    => (_page?.JobKeys ?? []).Concat(_applied.Job is { } job && _page?.JobKeys.Contains(job) != true ? [job] : []);

  protected override async Task OnParametersSetAsync()
  {
    // The address is what was asked: the form shows it, and the list answers it (T18).
    _applied = RunHistoryAddress.From(Job, Status, From, To, PageNumber, Size);
    _formJob = _applied.Job ?? string.Empty;
    _formStatus = _applied.Status ?? string.Empty;
    _formFrom = _applied.FromDay;
    _formTo = _applied.ToDay;

    _focusId = _focusOnArrival;
    _focusOnArrival = null;
    await LoadAsync(showLoading: !_loadedOnce);
    _loadedOnce = true;
  }

  /// <summary>
  /// Reads the page the address asks for. The first read and Try again's show the loading state; Show, Clear and a page
  /// turn answer in place, the filters and the table staying until the answer comes.
  /// </summary>
  private async Task LoadAsync(bool showLoading)
  {
    if (showLoading)
    {
      _loading = true;
    }

    _loadError = null;
    try
    {
      _page = await Sender.Send(new GetScheduledJobRunsQuery(
        _applied.Job, _applied.Status, _applied.FromDay, _applied.ToDay, _applied.Page, _applied.PageSize));
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      // T329: never the exception's text on the page; the cause goes to the log.
      Logger.LogError(exception, "The run history could not be read.");
      _page = null;
      _loadError = JobWords.RunsLoadFailed;
      _focusId = null;
    }
    finally
    {
      _loading = false;
    }
  }

  /// <summary>Show: the page's own address with the values chosen, from the first page; the count line takes the focus.</summary>
  private Task ShowAsync()
  {
    // Show waits for the first read (R2-R10): aria-disabled, a press sends nothing.
    if (_page is null)
    {
      return Task.CompletedTask;
    }

    var target = _applied with
    {
      Job = Blank(_formJob),
      Status = Blank(_formStatus),
      FromDay = _formFrom,
      ToDay = _formTo,
      Page = 1
    };
    return GoAsync(target, CountLineId);
  }

  /// <summary>Clear filters and Clear the filters: every filter reset, from the first page; Job takes the focus.</summary>
  private Task ClearAsync() => GoAsync(RunHistoryAddress.None with { PageSize = _applied.PageSize }, JobFieldId);

  // After a page turn the list's heading takes the focus (N1, T264).
  private Task TurnPageAsync(int page) => GoAsync(_applied with { Page = page }, HeadingId);

  // A change of size reads the first page at that size; the focus stays on the select (T350 build review, A1).
  private Task ChangePageSizeAsync(int size) => GoAsync(_applied with { Page = 1, PageSize = size }, null);

  private async Task GoAsync(RunHistoryAddress target, string? focusId)
  {
    var address = target.Address();
    var here = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
    if (string.Equals(here, address, StringComparison.Ordinal))
    {
      // Navigating to the address shown would change no parameter: read again in place.
      _applied = target;
      _focusId = focusId;
      await LoadAsync(showLoading: false);
      if (_loadError is not null)
      {
        _panel?.FocusFailureAfterRender();
      }

      return;
    }

    _focusOnArrival = focusId;
    Navigation.NavigateTo(address);
  }

  private async Task RetryAsync()
  {
    _loading = true;
    StateHasChanged();
    await LoadAsync(showLoading: true);
  }

  // After Try again has read, the h1 takes the focus (S3).
  private ValueTask FocusPageHeadingAsync() => PageFocus.FocusHeadingAsync(JS);

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusId is { } id && !_loading && _page is not null && _loadError is null)
    {
      _focusId = null;
      // The no-runs state draws no count line; its heading is then the answer.
      await PageFocus.FocusByIdAsync(JS, id == CountLineId && _page.AllRunsCount == 0 ? HeadingId : id);
    }
  }

  private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;
}

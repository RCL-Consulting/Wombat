@page "/admin/colleges/new"
@page "/admin/colleges/{Id:int}"
@attribute [Authorize(Policy = "Administrator")]
@inject IScopedSender Sender
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ILogger<CollegeEdit> Logger

<PageTitle>@Heading · Wombat</PageTitle>

@*
  A College's record (T394, flow 16, lane B; boards R3-B03–B12, B17b, R2-B13, B14b, B15b). The Administrator's alone.

  - Titled by the College's name, "CNSA · Active" under it (S11, S15); "Create college" new; "College" while it is read or
    when its read failed (T7). No Back to colleges: the trail is the way back (Q9).
  - An unknown id is "College unavailable" in the page's own place (Q7), never Page not found.
  - Refusals under their fields, in the label's words, each once, no summary (T324): the page's own required and length
    checks, then the command's FieldRefusalException (a taken name or short code naming its holder, S10). Any other failure
    is the fixed sentence in the result region (T272, T393), the exception logged.
  - A create arrives here by ?created (S13): the page writes "College created." itself, focuses it, then replaces its
    address without the token. A save stays on the record with "College saved.".
  - Deactivate… (on a College stored active) and Save with Active unticked both open one dialog (D56, N20); no count in it
    (Q15). Ticking Active back and saving reactivates; there is no Reactivate button.
*@
<PageHeader Title="@Heading" Subtitle="@Subtitle" CurrentCrumb="@Heading" />

<div class="user-page college-page" aria-busy="@(_loading ? "true" : null)">
  <StatePanel IsLoading="_loading" LoadError="@_loadError" OnRetry="LoadAsync" FocusAfterRetry="FocusHeadingAsync">
    <LoadingContent>
      <p class="loading-line" role="status">@CollegeWords.LoadingCollege</p>
      <div class="detail-card" aria-hidden="true">
        <div class="skeleton skel-title"></div>
        <div class="skeleton skel-line"></div>
        <div class="skeleton skel-line skel-short"></div>
      </div>
    </LoadingContent>
    <ChildContent>
      @if (IsUnavailable)
      {
        <div class="detail-card detail-card--empty">
          <div class="state-panel-copy">@CollegeWords.UnavailableBody</div>
          <div class="form-actions">
            <a class="btn btn-primary" href="@CatalogueLinks.Colleges">@CollegeWords.GoToColleges</a>
          </div>
        </div>
      }
      else if (IsNew || _college is not null)
      {
        @Form()
      }
    </ChildContent>
  </StatePanel>
</div>

<ConfirmDialog @ref="_confirmDeactivate"
               Title="@CollegeWords.DeactivateTitle(_college?.Name ?? string.Empty)"
               ConfirmLabel="@CollegeWords.DeactivateConfirm"
               DangerAction="true"
               ReturnFocusId="@(_saveOnConfirm ? SaveId : DeactivateTriggerId)"
               OnConfirm="ConfirmDeactivationAsync"
               OnCancel="CancelDeactivation">
  <BodyContent>
    <p>@CollegeWords.DeactivateBody</p>
    <p>@CollegeWords.DeactivateReactivateLine</p>
  </BodyContent>
</ConfirmDialog>

@code {
  [Parameter]
  public int? Id { get; set; }

  private const string NameId = "college-name";
  private const string ShortCodeId = "college-short-code";
  private const string DescriptionId = "college-description";
  private const string ActiveId = "college-active";
  private const string DeactivateTriggerId = "college-deactivate";
  private const string SaveId = "college-save";

  /// <summary>The command's property each control answers for, in the form's order, so a refusal lands under its field.</summary>
  private static readonly IReadOnlyDictionary<string, string> InputOf = new Dictionary<string, string>(StringComparer.Ordinal)
  {
    [nameof(UpdateCollegeCommand.Name)] = NameId,
    [nameof(UpdateCollegeCommand.ShortCode)] = ShortCodeId,
    [nameof(UpdateCollegeCommand.Description)] = DescriptionId,
  };

  private readonly CollegeFormModel _model = new();
  private EditContext _editContext = default!;
  private ValidationMessageStore _messages = default!;
  private ConfirmDialog? _confirmDeactivate;
  private ActionResult? _result;

  private CollegeDto? _college;
  private bool _loading;
  private string? _loadError;
  private bool _read;
  private int? _readId;

  private string? _statusMessage;
  private string? _errorMessage;
  private readonly Dictionary<string, string> _refusals = new(StringComparer.Ordinal);
  private bool _focusResult;
  private string? _focusField;
  private bool _stripToken;

  private bool _saving;
  private bool _deactivating;
  private bool Busy => _saving || _deactivating;

  // Whether the open dialog was opened by Save (Active unticked): its confirm then saves every edit, not only the flag.
  private bool _saveOnConfirm;

  private bool IsNew => !Id.HasValue;

  private bool IsUnavailable => !IsNew && !_loading && _loadError is null && _read && _college is null;

  /// <summary>The h1, the tab and the crumb (S11, T7).</summary>
  private string Heading => IsNew ? CollegeWords.CreateCollege
    : IsUnavailable ? CollegeWords.UnavailableHeading
    : _college is { } college ? CollegeWords.Heading(college)
    : CollegeWords.RecordHeadingWhileUnread;

  private string? Subtitle => IsNew ? CollegeWords.CreateSubtitle
    : _college is { } college ? CollegeWords.RecordSubtitle(college.ShortCode, college.IsActive)
    : null;

  /// <summary>Active's help: what an inactive College changes, or, stored inactive, the inactive line (R3-B11a).</summary>
  private string ActiveHelp => _college is { IsActive: false } ? CollegeWords.InactiveLine : CollegeWords.ActiveHelp;

  /// <summary>Save asks the deactivation's question while it would deactivate (N20).</summary>
  private bool SaveWouldDeactivate => !IsNew && _college is { IsActive: true } && !_model.IsActive;

  /// <summary>The result region, which a done save or deactivation focuses. A test matches a focus call to it.</summary>
  internal ElementReference ResultRegion => _result?.Element ?? default;

  protected override void OnInitialized()
  {
    // The record is read before anything is offered (R2-B14b).
    _loading = !IsNew;
    _editContext = new EditContext(_model);
    _messages = new ValidationMessageStore(_editContext);
  }

  private RenderFragment Form() => __builder =>
  {
    @* What a save or a deactivation did, or a failure that is no field's (R3-B12). It takes the focus once the action is
       done (T234). A refusal under a field leaves it empty, the focus on the field. *@
    <ActionResult @ref="_result">
      @if (!string.IsNullOrWhiteSpace(_statusMessage))
      {
        <Alert Kind="success">@_statusMessage</Alert>
      }
      @if (!string.IsNullOrWhiteSpace(_errorMessage))
      {
        <Alert Kind="danger">@_errorMessage</Alert>
      }
    </ActionResult>

    <div class="form-container">
      @* novalidate: the browser stays quiet and the page refuses in its own words under each field (T324). *@
      <EditForm EditContext="_editContext" OnSubmit="SaveAsync" FormName="college-edit" novalidate>
        <p class="field-help">@RequiredMark.Line</p>

        <div class="form-grid">
          <FormField Label="@CollegeWords.NameLabel" InputId="@NameId" Required="true" FullWidth="true">
            <InputText id="@NameId" class="form-control" @bind-Value="_model.Name" aria-required="true" autocomplete="off"
                       aria-describedby="@DescribedBy(nameof(UpdateCollegeCommand.Name))" />
            @Refusal(nameof(UpdateCollegeCommand.Name))
          </FormField>

          <FormField Label="@CollegeWords.ShortCodeLabel" InputId="@ShortCodeId" Required="true" FullWidth="true">
            <InputText id="@ShortCodeId" class="form-control" @bind-Value="_model.ShortCode" aria-required="true" autocomplete="off"
                       aria-describedby="@DescribedBy(nameof(UpdateCollegeCommand.ShortCode))" />
            @Refusal(nameof(UpdateCollegeCommand.ShortCode))
          </FormField>

          <FormField Label="@CollegeWords.DescriptionLabel" InputId="@DescriptionId" FullWidth="true">
            <InputTextArea id="@DescriptionId" class="form-control" rows="4" @bind-Value="_model.Description"
                           aria-describedby="@DescribedBy(nameof(UpdateCollegeCommand.Description))" />
            @Refusal(nameof(UpdateCollegeCommand.Description))
          </FormField>

          @if (!IsNew)
          {
            @* D56: the help is the checkbox's description. A legend names the group, so the box's own name is its label,
               "Active", as on a speciality (T394 fix pass, pages S5). *@
            <fieldset class="form-group full-width">
              <legend>@CollegeWords.StatusLabel</legend>
              <div class="form-check">
                <InputCheckbox id="@ActiveId" class="form-check-input" @bind-Value="_model.IsActive" aria-describedby="@FieldHelp.Id(ActiveId)" />
                <label for="@ActiveId">@CollegeWords.ActiveLabel</label>
              </div>
              <p class="page-subtitle" id="@FieldHelp.Id(ActiveId)">@ActiveHelp</p>
            </fieldset>
          }
        </div>

        <FormActions>
          <a class="btn btn-outline" href="@CatalogueLinks.Colleges">@CollegeWords.Cancel</a>
          @* D56, T264: offered only on a College active as stored; it opens its dialog, so it says so. *@
          @if (!IsNew && _college is { IsActive: true })
          {
            <button type="button" id="@DeactivateTriggerId" class="btn btn-outline" aria-haspopup="dialog"
                    @onclick="AskDeactivateAsync" disabled="@Busy">@CollegeWords.DeactivateTrigger</button>
          }
          @* Not disabled while its own save runs (T234): it has the focus then, and a browser drops the focus of a button
             it disables, to the page. A second press sends nothing (SaveAsync). *@
          <button type="submit" id="@SaveId" class="btn btn-primary" disabled="@_deactivating" aria-disabled="@InFlight.AriaDisabled(_saving)"
                  aria-haspopup="@(SaveWouldDeactivate ? "dialog" : null)">@SubmitLabel</button>
        </FormActions>
      </EditForm>
    </div>
  };

  private string SubmitLabel => IsNew
    ? (_saving ? CollegeWords.Creating : CollegeWords.CreateCollege)
    : (_saving ? CollegeWords.Saving : CollegeWords.Save);

  /// <summary>A refusal under its field: <c>div.validation-message role="alert"</c>, named first by the control.</summary>
  private RenderFragment Refusal(string field) => __builder =>
  {
    if (_refusals.TryGetValue(field, out var message))
    {
      <div class="validation-message" role="alert" id="@FieldRefusal.Id(InputOf[field])">@message</div>
    }
  };

  private string? DescribedBy(string field) => FieldRefusal.DescribedBy(InputOf[field], _refusals.ContainsKey(field), null);

  // Read again when the id changes (a create arrives at its new College), never when only the query changes: the token's
  // own replace must not read the page again.
  protected override async Task OnParametersSetAsync()
  {
    if (_read && _readId == Id)
    {
      return;
    }

    _readId = Id;
    if (IsNew)
    {
      _read = true;
      _college = null;
      _model.Name = string.Empty;
      _model.ShortCode = string.Empty;
      _model.Description = null;
      _model.IsActive = true;
      return;
    }

    await LoadAsync();
  }

  private async Task LoadAsync()
  {
    _loading = true;
    _loadError = null;
    _statusMessage = null;
    _errorMessage = null;
    ClearRefusals();

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _college = await Sender.Send(new GetCollegeByIdQuery(Id!.Value, authState.User));
      if (_college is { } college)
      {
        Fill(college);

        // S13: a create arrives by ?created. A College the caller cannot open writes nothing.
        if (CatalogueLinks.HasToken(Navigation.Uri, CatalogueLinks.CreatedToken))
        {
          _statusMessage = CollegeWords.Created;
          _focusResult = true;
          _stripToken = true;
        }
      }
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      // T329, R2-B15b: the page's own read failed, which is not Unavailable. Never the exception's text.
      Logger.LogError(exception, "The College {CollegeId} could not be read.", Id);
      _college = null;
      _loadError = CollegeWords.CollegeLoadFailed;
    }
    finally
    {
      _loading = false;
      _read = true;
    }
  }

  private void Fill(CollegeDto college)
  {
    _model.Name = college.Name;
    _model.ShortCode = college.ShortCode;
    _model.Description = college.Description;
    _model.IsActive = college.IsActive;
  }

  private ValueTask FocusHeadingAsync() => PageFocus.FocusHeadingAsync(JS);

  /// <summary>
  /// Save, unless it would deactivate the College: unticking Active and saving is Deactivate…, so it asks the same question
  /// first (D56), and the dialog's confirm saves. The page's own checks come first, each under its field (T324).
  /// </summary>
  private async Task SaveAsync()
  {
    if (Busy)
    {
      return;
    }

    ClearRefusals();
    _statusMessage = null;
    _errorMessage = null;
    Check(string.IsNullOrWhiteSpace(_model.Name), nameof(UpdateCollegeCommand.Name), CollegeWords.NameRequired);
    Check(_model.Name.Trim().Length > 200, nameof(UpdateCollegeCommand.Name), CollegeWords.NameTooLong);
    Check(string.IsNullOrWhiteSpace(_model.ShortCode), nameof(UpdateCollegeCommand.ShortCode), CollegeWords.ShortCodeRequired);
    Check(_model.ShortCode.Trim().Length > 32, nameof(UpdateCollegeCommand.ShortCode), CollegeWords.ShortCodeTooLong);
    Check((_model.Description?.Trim().Length ?? 0) > 1000, nameof(UpdateCollegeCommand.Description), CollegeWords.DescriptionTooLong);
    if (_refusals.Count > 0)
    {
      FocusFirstRefusal();
      return;
    }

    if (SaveWouldDeactivate && _confirmDeactivate is not null)
    {
      _saveOnConfirm = true;
      await _confirmDeactivate.ShowAsync(SaveId);
      return;
    }

    await SaveCoreAsync();
  }

  private void Check(bool refused, string field, string message)
  {
    if (refused && !_refusals.ContainsKey(field))
    {
      Refuse(field, message);
    }
  }

  private void Refuse(string field, string message)
  {
    _refusals[field] = message;
    _messages.Add(_editContext.Field(field), message);
    _editContext.NotifyValidationStateChanged();
  }

  private void ClearRefusals()
  {
    if (_refusals.Count == 0)
    {
      return;
    }

    _refusals.Clear();
    _messages.Clear();
    _editContext.NotifyValidationStateChanged();
  }

  private void FocusFirstRefusal()
    => _focusField = InputOf.Keys.FirstOrDefault(_refusals.ContainsKey) is { } field ? InputOf[field] : null;

  private async Task SaveCoreAsync()
  {
    _saving = true;
    _errorMessage = null;
    _statusMessage = null;
    ClearRefusals();

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

      if (IsNew)
      {
        var created = await Sender.Send(new CreateCollegeCommand(_model.Name, _model.ShortCode, EmptyToNull(_model.Description), authState.User));
        Navigation.NavigateTo(CatalogueLinks.CollegeCreated(created.Id));
        return;
      }

      var wasActive = _college!.IsActive;
      var saved = await Sender.Send(new UpdateCollegeCommand(Id!.Value, _model.Name, _model.ShortCode, EmptyToNull(_model.Description), _model.IsActive, authState.User));
      _college = saved;
      Fill(saved);
      _statusMessage = (wasActive, saved.IsActive) switch
      {
        (true, false) => CollegeWords.Deactivated(saved.Name),
        (false, true) => CollegeWords.Reactivated(saved.Name),
        _ => CollegeWords.Saved
      };
      _focusResult = true;
    }
    catch (Exception exception) when (FieldRefusal.Of(exception) is { } refusal && InputOf.ContainsKey(refusal.Field))
    {
      // S10: a taken name or short code, under its field, naming its holder; what was typed is kept.
      Refuse(refusal.Field, refusal.Message);
      FocusFirstRefusal();
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      // T272, R3-B12: never "already exists" for a failure that is not a duplicate, never the exception's text.
      Logger.LogError(exception, "The College {CollegeId} could not be saved.", Id);
      _errorMessage = IsNew ? CollegeWords.CreateFailed : CollegeWords.SaveFailed;
      _focusResult = true;
    }
    finally
    {
      _saving = false;
    }
  }

  private async Task AskDeactivateAsync()
  {
    if (Busy)
    {
      return;
    }

    _saveOnConfirm = false;
    if (_confirmDeactivate is not null)
    {
      await _confirmDeactivate.ShowAsync(DeactivateTriggerId);
    }
  }

  private async Task ConfirmDeactivationAsync()
  {
    if (Busy)
    {
      return;
    }

    if (_saveOnConfirm)
    {
      _saveOnConfirm = false;
      await SaveCoreAsync();
      return;
    }

    await DeactivateAsync();
  }

  // Cancel leaves Active unticked on the form, unsaved; Save asks again (R3-B10).
  private void CancelDeactivation() => _saveOnConfirm = false;

  private async Task DeactivateAsync()
  {
    _deactivating = true;
    _errorMessage = null;
    _statusMessage = null;
    ClearRefusals();

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await Sender.Send(new DeactivateCollegeCommand(Id!.Value, authState.User));
      _college = _college! with { IsActive = false };
      _model.IsActive = false;
      _statusMessage = CollegeWords.Deactivated(_college.Name);
      _focusResult = true;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogError(exception, "The College {CollegeId} could not be deactivated.", Id);
      _errorMessage = CollegeWords.DeactivateFailed;
      _focusResult = true;
    }
    finally
    {
      _deactivating = false;
    }
  }

  /// <remarks>
  /// The focus moves once the browser has the render that shows the result, after any dialog that sent it has closed
  /// (T206 review). A ?created arrival's result is focused the same way, and only then is the token taken out (S13).
  /// </remarks>
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusResult && _result is not null)
    {
      _focusResult = false;
      await _result.Element.FocusAsync();
    }

    if (_focusField is { } field)
    {
      _focusField = null;
      await PageFocus.FocusByIdAsync(JS, field);
    }

    if (_stripToken)
    {
      _stripToken = false;
      Navigation.NavigateTo(CatalogueLinks.WithoutTokens(Navigation.Uri), replace: true);
    }
  }

  private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

  private sealed class CollegeFormModel
  {
    public string Name { get; set; } = string.Empty;

    public string ShortCode { get; set; } = string.Empty;

    public string? Description { get; set; }

    public bool IsActive { get; set; } = true;
  }
}

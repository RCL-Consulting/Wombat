@page "/admin/invitations"
@attribute [Authorize(Policy = "AdministratorOrInstitutionalAdmin")]
@implements IDisposable
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOptions<Wombat.Application.Common.Options.WombatOptions> WombatOptionsAccessor
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<InvitationsList> Logger
@using Microsoft.Extensions.Options

<PageTitle>Invitations · Wombat</PageTitle>

@*
  T373 (flow 11, boards R3-L01–L17): the list is the page. Invite a person is a page of its own (Q1), the header's action,
  shown once the list has loaded (L15) and never with the T290 note (L17). Two sections, each an h2 with its count:
  Active invitations, then Expired, not used (Q9) when it has rows. Each a stack-wide table (S16) whose row header is the
  address, breaking only after its @ (check rule 1: no .col-wrap there). A row not delivered carries a note row under it
  (tr.has-note, then td.history-note.history-note--warning), which its Resend names.
*@
<PageHeader Title="Invitations" Subtitle="@InvitationText.ListSubtitle" Actions="@HeaderAction" />

<div class="inv-page">
  @* Someone who holds Trainee beside a role that administers users issues, resends and revokes no invitation (T290), as
     they administer no user (T278): nothing is read for them, and the note says why (M1). *@
  @if (_traineeNote is not null)
  {
    <Alert Kind="info" Id="invitations-trainee-note">@_traineeNote</Alert>
  }
  else
  {
    @* What a resend or a revoke did, and the link a resend made (L07, L10). It takes the focus once either is done (T234;
       DESIGN.md § Button system). The link is cleared at the start of every action on this page (M5). *@
    <ActionResult @ref="_result" Id="invitations-result">
      @if (_resent is { } resent)
      {
        <OneTimeLink Email="@resent.Email" Link="@resent.Link" Rest="@InvitationText.ResentRest"
                     Help="@InvitationText.ResentLinkHelp(resent.ExpiresOn)">
          <Lead>A new invitation link is being emailed to @InvitationText.Address(resent.Email).</Lead>
        </OneTimeLink>
      }
      @if (_revoked is { } revoked)
      {
        <Alert Kind="success">
          <div class="alert-row">
            <p class="alert-row-text"><strong>Invitation revoked.</strong> The link sent to @InvitationText.Address(revoked.Email) no longer works: nobody can register from it.</p>
            <a class="btn btn-outline btn-sm" href="@OnboardingLinks.InviteFrom(revoked.Id)" @onclick="ClearLink"><Icon Name="user-plus" />Invite another address as @InvitationText.RoleWithScope(revoked.TargetRole, ScopeLine(revoked))</a>
          </div>
        </Alert>
      }
      @if (_refusal is not null)
      {
        <Alert Kind="danger">@_refusal</Alert>
      }
    </ActionResult>

    @* A Try again that loads hands the focus to Active invitations' heading (T373 fix pass, P2). *@
    <StatePanel IsLoading="_loading" LoadError="@_loadError" OnRetry="LoadAsync" FocusAfterRetry="FocusActiveAsync">
      <LoadingContent>
        <p class="loading-line" role="status">@InvitationText.LoadingList</p>
        <div class="detail-card" aria-hidden="true">
          <div class="skeleton skel-title"></div>
          <div class="skeleton skel-line"></div>
          <div class="skeleton skel-line"></div>
          <div class="skeleton skel-line skel-short"></div>
        </div>
      </LoadingContent>
      <ChildContent>
        @Active()
        @if (_expired.Count > 0)
        {
          @Expired()
        }
      </ChildContent>
    </StatePanel>
  }
</div>

<ConfirmDialog @ref="_revokeDialog"
               Title="@InvitationText.RevokeTitle"
               CancelLabel="@InvitationText.RevokeKeep"
               ConfirmLabel="@InvitationText.RevokeConfirm"
               DangerAction="true"
               OnConfirm="RevokeAsync">
  <BodyContent>
    @if (_revoking is { } revoking)
    {
      var scope = ScopeLine(revoking);
      <p>Revoke the @WombatRoleLabels.For(revoking.TargetRole) invitation to <strong>@InvitationText.Address(revoking.Email)</strong>@(scope is null ? null : $" ({scope})")?</p>
      <ul class="dialog-list">
        <li>@InvitationText.RevokeStopsTheLink</li>
        <li>@InvitationText.RevokeLeavesTheList</li>
      </ul>
      <p>@InvitationText.RevokeCannotBeUndone</p>
    }
  </BodyContent>
</ConfirmDialog>

@code {
  private RenderFragment Active() => __builder =>
  {
    <section class="list-section" aria-labelledby="active-invitations-heading">
      <h2 id="active-invitations-heading" class="list-section-title">
        Active invitations
        @if (_invitations.Count > 0)
        {
          <span class="inv-count">@InvitationText.ActiveCount(_invitations.Count)</span>
        }
      </h2>
      @if (_invitations.Count == 0)
      {
        <div class="detail-card detail-card--empty">
          <p class="state-panel-title">No active invitations</p>
          <p class="state-panel-copy">Issue an invitation to create the first onboarding link.</p>
        </div>
      }
      else
      {
        var rowNames = RowNames.Distinct(
          _invitations,
          row => row.Id,
          row => $"the {WombatRoleLabels.For(row.TargetRole)} invitation to {row.Email}",
          row => $", issued {Wombat.Web.Components.Shared.Activities.ActivityMoments.When(row.IssuedOn)}",
          row => $", invitation {row.Id}");
        <DataTable TItem="ActiveInvitationDto" Items="_invitations" StackWide="true" Caption="@ActiveCaption">
          <HeaderRow>
            <tr role="row">
              <th scope="col" role="columnheader">Invitee</th>
              <th scope="col" role="columnheader">Role and scope</th>
              <th scope="col" role="columnheader">Issued</th>
              <th scope="col" role="columnheader">Last day</th>
              <th scope="col" role="columnheader" class="col-wrap">Delivery</th>
              <th scope="col" role="columnheader" class="col-actions"><span class="visually-hidden">Actions</span></th>
            </tr>
          </HeaderRow>
          <Row Context="invitation">
            @{
              var offersResend = InvitationText.OffersResend(invitation);
              var issued = InvitationText.IssuedParts(invitation.IssuedOn);
              var scope = ScopeLine(invitation);
            }
            <tr role="row" class="@(offersResend ? "has-note" : null)" @key="invitation.Id">
              <th scope="row" role="rowheader">@InvitationText.Address(invitation.Email)</th>
              <td role="cell" data-label="Role and scope">
                <span class="person-cell">@WombatRoleLabels.For(invitation.TargetRole)@if (scope is not null){@(" ")<span>@scope</span>}</span>
              </td>
              <td role="cell" data-label="Issued" class="inv-when">@issued.Date<span>@issued.Time</span></td>
              <td role="cell" data-label="Last day" class="inv-when">@InvitationText.Iso(invitation.ExpiresOn)</td>
              <td role="cell" data-label="Delivery" class="col-wrap">
                <span id="@DeliveryId(invitation.Id)" class="@InvitationText.DeliveryClass(invitation.Delivery)"><Icon Name="@InvitationText.DeliveryIcon(invitation.Delivery)" />@InvitationText.Delivery(invitation)</span>
              </td>
              <td role="cell" class="col-actions">
                <div class="actions-cell">
                  @* T283: only on an invitation whose mail was not delivered; it emails a new link and retires the old one,
                     which its note says (L09). The one pressed stays enabled while it runs (T234 review). *@
                  @if (offersResend)
                  {
                    <button type="button" class="btn btn-sm btn-outline" aria-label="@($"Resend {rowNames[invitation.Id]}")"
                            aria-describedby="@NoteId(invitation.Id)"
                            disabled="@(_resendingId is not null && _resendingId != invitation.Id)"
                            aria-disabled="@InFlight.AriaDisabled(_resendingId == invitation.Id)"
                            @onclick="() => ResendAsync(invitation.Id)"><Icon Name="refresh-cw" />Resend</button>
                  }
                  @* T264: Revoke confirms; a row action is an outline button, the red one is the dialog's. *@
                  <button type="button" class="btn btn-sm btn-outline" aria-label="@($"Revoke {rowNames[invitation.Id]}")"
                          disabled="@(_resendingId is not null)"
                          @onclick="() => OpenRevokeAsync(invitation)">Revoke…</button>
                </div>
              </td>
            </tr>
            @if (offersResend)
            {
              <tr role="row">
                <td role="cell" colspan="6" class="history-note history-note--warning"><p id="@NoteId(invitation.Id)">@InvitationText.Note(invitation)</p></td>
              </tr>
            }
          </Row>
        </DataTable>
      }
    </section>
  };

  private RenderFragment Expired() => __builder =>
  {
    <section class="list-section" aria-labelledby="expired-invitations-heading">
      <h2 id="expired-invitations-heading" class="list-section-title">Expired, not used <span class="inv-count">@InvitationText.ExpiredCount(_expired.Count)</span></h2>
      <DataTable TItem="ExpiredInvitationDto" Items="_expired" StackWide="true" Caption="@InvitationText.ExpiredCaption">
        <HeaderRow>
          <tr role="row">
            <th scope="col" role="columnheader">Invitee</th>
            <th scope="col" role="columnheader">Role and scope</th>
            <th scope="col" role="columnheader">Issued</th>
            <th scope="col" role="columnheader">Last day</th>
            <th scope="col" role="columnheader" class="col-actions"><span class="visually-hidden">Actions</span></th>
          </tr>
        </HeaderRow>
        <Row Context="invitation">
          @{
            var issued = InvitationText.IssuedParts(invitation.IssuedOn);
            var scope = ScopeLine(invitation);
          }
          <tr role="row" @key="invitation.Id">
            <th scope="row" role="rowheader">@InvitationText.Address(invitation.Email)</th>
            <td role="cell" data-label="Role and scope">
              <span class="person-cell">@WombatRoleLabels.For(invitation.TargetRole)@if (scope is not null){@(" ")<span>@scope</span>}</span>
            </td>
            <td role="cell" data-label="Issued" class="inv-when">@issued.Date<span>@issued.Time</span></td>
            <td role="cell" data-label="Last day" class="inv-when">@InvitationText.Iso(invitation.ExpiresOn)</td>
            <td role="cell" class="col-actions">
              <div class="actions-cell">
                <a class="btn btn-sm btn-outline" href="@OnboardingLinks.InviteFrom(invitation.Id)" @onclick="ClearLink"
                   aria-label="@($"Invite again {invitation.Email} as {InvitationText.RoleWithScope(invitation.TargetRole, scope)}")"><Icon Name="user-plus" />Invite again</a>
              </div>
            </td>
          </tr>
        </Row>
      </DataTable>
    </section>
  };

  private RenderFragment InviteAction => __builder =>
  {
    <a class="btn btn-primary" href="@OnboardingLinks.InviteAPerson" @onclick="ClearLink"><Icon Name="user-plus" />Invite a person</a>
  };

  /// <summary>The header's action: once the list has loaded (L15), never with the T290 note (L17) or a failed read (L16).</summary>
  private RenderFragment? HeaderAction => _traineeNote is null && !_loading && _loadError is null ? InviteAction : null;

  /// <summary>A link a resend made, while it is shown (M5): cleared at the start of the next action, never restored.</summary>
  private sealed record ShownLink(string Email, string Link, DateOnly ExpiresOn);

  private string? _traineeNote;
  private bool _isAdministrator;
  private IReadOnlyList<ActiveInvitationDto> _invitations = [];
  private IReadOnlyList<ExpiredInvitationDto> _expired = [];
  private bool _loading = true;
  private string? _loadError;

  private ShownLink? _resent;
  private ActiveInvitationDto? _revoked;
  private string? _refusal;
  private ActionResult? _result;

  private ConfirmDialog? _revokeDialog;
  private ActiveInvitationDto? _revoking;

  /// <summary>The invitation whose resend has been sent and has not answered, or null. (T283)</summary>
  private int? _resendingId;


  private string ActiveCaption => _isAdministrator || _invitations.Count == 0
    ? InvitationText.ActiveCaptionEverywhere
    : InvitationText.ActiveCaptionAt(_invitations[0].InstitutionName);

  /// <summary>The id of a row's Delivery word.</summary>
  private static string DeliveryId(int invitationId) => $"invitation-delivery-{invitationId}";

  /// <summary>The id of a row's note, which its Resend names with <c>aria-describedby</c> (L09).</summary>
  private static string NoteId(int invitationId) => $"invitation-note-{invitationId}";

  private string? ScopeLine(ActiveInvitationDto row)
    => InvitationText.ScopeLine(row.TargetRole, row.InstitutionName, row.CollegeName, row.SpecialityName, row.SubSpecialityName, _isAdministrator);

  private string? ScopeLine(ExpiredInvitationDto row)
    => InvitationText.ScopeLine(row.TargetRole, row.InstitutionName, row.CollegeName, row.SpecialityName, row.SubSpecialityName, _isAdministrator);

  protected override async Task OnInitializedAsync()
  {
    // M5: a navigation clears the link too, whatever started it.
    Navigation.LocationChanged += OnLocationChanged;

    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    // Asked before anything is read (M1), so the note says nothing about what there is.
    _traineeNote = UserAdministrationRules.TraineeNoteOnUserPages(authState.User);
    if (_traineeNote is not null)
    {
      _loading = false;
      return;
    }

    _isAdministrator = authState.User.IsAdministrator();
    await LoadAsync();
  }

  /// <summary>Reads both lists; a failure is logged and said in fixed words, with Try again (L16, T329).</summary>
  private ValueTask FocusActiveAsync() => PageFocus.FocusByIdAsync(JS, "active-invitations-heading");

  private async Task LoadAsync()
  {
    _loading = true;
    _loadError = null;
    try
    {
      await ReadAsync();
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogError(exception, "The invitations could not be read.");
      _loadError = InvitationText.ListLoadFailed;
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task ReadAsync()
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    _invitations = await Sender.Send(new ListActiveInvitationsQuery(authState.User));
    _expired = await Sender.Send(new ListExpiredUnusedInvitationsQuery(authState.User));
  }

  /// <summary>M5: the start of every action clears the link and what the last one said.</summary>
  private void ClearLink()
  {
    _resent = null;
    _revoked = null;
    _refusal = null;
  }

  private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
  {
    if (_resent is null)
    {
      return;
    }

    _resent = null;
    _ = InvokeAsync(StateHasChanged);
  }

  /// <summary>
  /// Emails a new link for an invitation whose mail was not delivered, and shows it once (T283; L10). The list is read again
  /// whatever the answer, since a refusal is likeliest because the invitation changed elsewhere (resent, used, revoked, or
  /// delivered after all). The result takes the focus once the resend is done, and after a refusal that leaves the row no
  /// Resend; a refusal that leaves it keeps the focus on it, for the retry.
  /// </summary>
  private async Task ResendAsync(int invitationId)
  {
    if (_resendingId is not null)
    {
      return;
    }

    ClearLink();
    _resendingId = invitationId;
    var resent = false;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var email = _invitations.FirstOrDefault(row => row.Id == invitationId)?.Email;

      try
      {
        var issued = await Sender.Send(new ResendInvitationCommand(invitationId, authState.User));
        _resent = new ShownLink(
          email ?? string.Empty,
          InvitationLinks.RegistrationUrl(WombatOptionsAccessor.Value, issued.Token),
          issued.ExpiresOn);
        resent = true;
      }
      catch (Exception exception) when (exception is not OperationCanceledException)
      {
        _refusal = RefusalOf(exception, "resent", invitationId);
      }

      await ReadAsync();
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogError(exception, "The invitations could not be read again after a resend.");
      _refusal ??= InvitationText.ActionFailed;
    }
    finally
    {
      _resendingId = null;
    }

    if (resent || !_invitations.Any(row => row.Id == invitationId && InvitationText.OffersResend(row)))
    {
      _result?.FocusAfterRender();
    }
  }

  /// <summary>Revoke… (T264): confirms first; the link a resend made is cleared as the dialog opens (M5).</summary>
  private async Task OpenRevokeAsync(ActiveInvitationDto invitation)
  {
    ClearLink();
    _revoking = invitation;
    if (_revokeDialog is not null)
    {
      await _revokeDialog.ShowAsync();
    }
  }

  /// <summary>
  /// The dialog's Revoke invitation: the result (L07) names the address and offers to invite another as the same role and
  /// scope; the list is read again. A refusal is shown in the result in its own words, anything else in fixed words, logged.
  /// Either takes the focus once the dialog has closed.
  /// </summary>
  private async Task RevokeAsync()
  {
    if (_revoking is not { } revoking)
    {
      return;
    }

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await Sender.Send(new RevokeInvitationCommand(revoking.Id, authState.User));
      _revoked = revoking;
      await ReadAsync();
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      _refusal = RefusalOf(exception, "revoked", revoking.Id);
    }

    _result?.FocusAfterRender();
  }

  /// <summary>A refusal's own words (S9); anything else logged and said in fixed words, never the exception's (T329).</summary>
  private string RefusalOf(Exception exception, string action, int invitationId)
  {
    if (InvitationIssueRefusals.IsRefusal(exception))
    {
      return RefusalText.Of(exception);
    }

    Logger.LogError(exception, "Invitation {InvitationId} could not be {Action}.", invitationId, action);
    return InvitationText.ActionFailed;
  }

  public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}

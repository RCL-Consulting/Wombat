@page "/admin/curricula"
@attribute [Authorize(Policy = "NationalCatalogueAccess")]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService

<PageTitle>Curricula</PageTitle>

<PageHeader Title="Curricula" Subtitle="Manage curriculum versions and the sub-speciality they apply to.">
  <Actions>
    @* T211. Offered to those the create page admits, so no one is sent to a page that turns them away. *@
    @if (_canCreate)
    {
      <a class="btn btn-primary" href="/admin/curricula/new">
        <Icon Name="plus" />
        Create curriculum
      </a>
    }
  </Actions>
</PageHeader>

<StatePanel IsLoading="@(_curricula is null)" LoadError="@_errorMessage" IsEmpty="@(_curricula?.Count == 0)" EmptyTitle="No curricula yet" EmptyBody="@EmptyBody">
  @if (_curricula is not null)
  {
    <DataTable TItem="CurriculumDto" Items="_curricula" Caption="Curricula">
      <HeaderRow>
        <tr>
          <th>Name</th>
          <th>Version</th>
          <th>College</th>
          <th>Speciality</th>
          <th>Sub-speciality</th>
          <th>Effective</th>
          <th>Items</th>
          <th>Status</th>
          <th></th>
        </tr>
      </HeaderRow>
      <Row Context="curriculum">
        <tr>
          <td>@curriculum.Name</td>
          <td>@curriculum.Version</td>
          <td>@curriculum.CollegeName</td>
          <td>@curriculum.SpecialityName</td>
          <td>@curriculum.SubSpecialityName</td>
          <td>@curriculum.EffectiveFrom.ToString("yyyy-MM-dd")</td>
          @* The items the caller reads: the College's, and their own institution's (T211). *@
          <td>@curriculum.Items.Count</td>
          <td>@(curriculum.IsActive ? "Active" : "Inactive")</td>
          <td>
            @* T211. Every row is a curriculum the caller can open (the list and the read share one rule), so Items is
               always offered. Edit changes the curriculum's details and clones it, which only its College can do. *@
            <div class="actions-cell">
              @if (curriculum.CanEditCurriculum)
              {
                <a class="btn btn-outline btn-sm" href="@($"/admin/curricula/{curriculum.Id}")">Edit</a>
              }
              <a class="btn btn-outline btn-sm" href="@($"/admin/curricula/{curriculum.Id}/items")">Items</a>
            </div>
          </td>
        </tr>
      </Row>
    </DataTable>
  }
</StatePanel>

@code {
  /// <summary>The policy of the curriculum create and edit page, <c>CurriculumEdit</c>.</summary>
  private const string CreatePagePolicy = "AdministratorOrCollegeAdmin";

  private IReadOnlyList<CurriculumDto>? _curricula;
  private bool _canCreate;
  private string? _errorMessage;

  private string EmptyBody => _canCreate
    ? "Create a curriculum before admitting trainees or building progress rules."
    : "Your institution has not adopted a curriculum yet. Adopt one on the Curriculum Adoptions page before admitting trainees.";

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _canCreate = (await AuthorizationService.AuthorizeAsync(authState.User, CreatePagePolicy)).Succeeded;
      _curricula = await Sender.Send(new GetCurriculaListQuery(authState.User));
    }
    catch (Exception exception)
    {
      _errorMessage = exception.Message;
      _curricula = [];
    }
  }
}

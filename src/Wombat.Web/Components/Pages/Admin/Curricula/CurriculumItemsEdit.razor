@page "/admin/curricula/{Id:int}/items"
@attribute [Authorize(Policy = "NationalCatalogueAccess")]
@inject IScopedSender Sender
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ILogger<CurriculumItemsEdit> Logger
@using Words = CurriculumItemsWords

<PageTitle>@Heading · Wombat</PageTitle>

@*
  A curriculum's items (T392, flow 15, lane B; Q14, T10; boards R3-B01–B03, B06–B08, B10, B11, B13, B14, B17–B21, B23 and
  R2-B16). The list is the page: the standing notice, "Items (n)" with the add link where the caller may add and an EPA is
  left to add, and the six-column table (decision 1). Adding and editing an item is a page of its own for every caller
  (CurriculumItemPage, F3, T323), which comes back here with a one-shot token (F1): ?added and ?saved write their result at
  the top, focused; ?back focuses the row's Edit (or View); a stale or foreign id writes and focuses nothing; the address is
  then replaced without it. Remove… asks first (T3), its result at the top, focused (T11). No Back links (T5). An id the
  caller cannot open is the page's own Unavailable (Q19).
*@
<PageHeader Title="@Heading" Subtitle="@Subtitle" />

<div class="people-page curriculum-items-page" aria-busy="@(_loading ? "true" : null)">
  <StatePanel IsLoading="_loading" LoadError="@_loadError" OnRetry="RetryAsync" FocusAfterRetry="FocusHeadingAsync">
    <LoadingContent>
      <p class="loading-line" role="status">@Words.ListLoading</p>
      <div class="detail-card" aria-hidden="true">
        <div class="skeleton skel-title"></div>
        <div class="skeleton skel-line"></div>
        <div class="skeleton skel-line"></div>
        <div class="skeleton skel-line"></div>
        <div class="skeleton skel-line skel-short"></div>
      </div>
    </LoadingContent>
    <ChildContent>
      @if (_curriculum is { } curriculum)
      {
        @* One result a page, at its top (BRIEF § 6 A5): ?added, ?saved, a Remove's, or a Remove's refusal. *@
        <ActionResult @ref="_result">@if (_message is { } message)
          {<Alert Kind="@(_refused ? "danger" : "success")" Role="@(_refused ? "alert" : "status")"><strong>@message</strong></Alert>}</ActionResult>

        @* Standing notices: page content, no live region (N4). *@
        <Alert Kind="warning" Role="">@(curriculum.CanEditCurriculum ? Words.CollegeNotice : Words.InstitutionNotice)</Alert>

        @* T158. The list shows every item as a record, so an item whose EPA is inactive is here, and says it is not in force. *@
        @if (InactiveEpaCodes is { Count: > 0 } inactive)
        {
          <Alert Kind="info" Role="">@Words.PausedNotice(inactive)</Alert>
        }

        <div class="form-section-head">
          <h2 id="curriculum-items-heading">@Words.ItemsHeading(curriculum.Items.Count)</h2>
          @if (curriculum.MayAddItem && _addEpas.Count > 0)
          {
            <a class="btn btn-primary" href="@CatalogueLinks.NewItem(Id)">@Words.AddAction(curriculum.CanEditCurriculum)</a>
          }
        </div>

        @if (AddLine(curriculum) is { } line)
        {
          <p class="muted">@line</p>
        }

        @if (Words.NewVersionLine(curriculum.Institution) is { } elsewhere && !curriculum.CanEditCurriculum)
        {
          <p class="muted">@elsewhere</p>
        }

        <DataTable TItem="CurriculumItemDto" Items="curriculum.Items" StackWide="true" Class="clinic-table--compact"
                   Caption="@Words.Caption(curriculum)">
          <HeaderRow>
            <tr role="row">
              <th scope="col" role="columnheader" class="col-wrap col-wrap--wide">EPA</th>
              @* T131: the decision cadence and body share the target's cell, as they share Annexure B's row. *@
              <th scope="col" role="columnheader" class="col-wrap">Target and decision</th>
              @* The scale is the minimum's second line: a rung is read on its ladder. *@
              <th scope="col" role="columnheader" class="col-wrap">Minimum level</th>
              <th scope="col" role="columnheader">Minimum by training year</th>
              @* Decision 1: the window and weight are the item's page's. Six columns still need about 690px, so the
                 table stacks to 1024px (app.css, the replay's A.7.10). *@
              <th scope="col" role="columnheader" class="col-wrap col-wrap--wide">Tools</th>
              <th scope="col" role="columnheader"><span class="visually-hidden">Actions</span></th>
            </tr>
          </HeaderRow>
          <Row Context="item">
            <tr role="row">
              <th scope="row" role="rowheader" class="col-wrap">
                @Words.Label(item)@if (!item.EpaIsActive)
                {@(" ")<span class="muted">@Words.NotInForce</span>}
                @if (item.IsLocal)
                {
                  <div class="muted text-sm">@Words.OwnerText(item)</div>
                }
              </th>
              <td role="cell" data-label="Target and decision" class="col-wrap">
                @Words.TargetText(item)
                <div class="muted text-sm">@Words.DecisionText(item)</div>
              </td>
              <td role="cell" data-label="Minimum level" class="col-wrap">
                @Words.RungText(_scales, item.ScaleId, item.MinimumLevelOrder)
                <div class="muted text-sm">@(item.ScaleName ?? Words.NotPinned)</div>
              </td>
              <td role="cell" data-label="Minimum by training year">@Words.YearsText(_scales, item)</td>
              <td role="cell" data-label="Tools" class="col-wrap">@Words.ToolsText(_tools, item.PermittedToolKeys)</td>
              <td role="cell">
                <div class="actions-cell">
                  @if (item.CanEdit)
                  {
                    @* Each named by its item (T222, T239); Remove… opens the page's one dialog (T3, N6). *@
                    <a id="@OpenId(item)" class="btn btn-sm btn-outline" href="@CatalogueLinks.Item(Id, item.Id)"
                       aria-label="@($"Edit {Names[item.Id]}")">Edit</a>
                    <button type="button" id="@RemoveId(item)" class="btn btn-sm btn-outline" aria-haspopup="dialog"
                            aria-label="@($"Remove {Names[item.Id]}")" @onclick="() => AskRemoveAsync(item)">Remove…</button>
                  }
                  else
                  {
                    @* P2: a row the caller may not change opens its record, and says why it offers no Edit (M1). *@
                    <a id="@OpenId(item)" class="btn btn-sm btn-outline" href="@CatalogueLinks.Item(Id, item.Id)"
                       aria-label="@($"{Words.View} {Names[item.Id]}")">@Words.View</a>
                    <span class="muted">@(item.IsLocal ? Words.AnotherInstitutionsItem : Words.SetByTheCollege)</span>
                  }
                </div>
              </td>
            </tr>
          </Row>
        </DataTable>
      }
      else if (_unavailable)
      {
        @* Q19 (R2-B16): no id shown, the route's own place, Curricula lit. *@
        <div class="detail-card detail-card--empty">
          <div class="state-panel-copy">@Words.CurriculumUnavailableBody</div>
          <div class="form-actions">
            <a class="btn btn-primary" href="@CatalogueLinks.Curricula">@Words.GoToCurricula</a>
          </div>
        </div>
      }
    </ChildContent>
  </StatePanel>
</div>

@* Remove asks first (DESIGN.md § Button system; T222, T3): one dialog for the page, naming the item it was opened from.
   Removing an item deletes its settings and every trainee's tally toward it (CurriculumItemProgress cascades). *@
<ConfirmDialog @ref="_confirmRemove"
               Title="@(_pendingRemove is { } pending && _curriculum is { } shown ? Words.RemoveTitle(Names[pending.Id], shown) : Words.RemoveConfirm)"
               Body="@(_pendingRemove is { } item && _curriculum is { } on ? Words.RemoveBody(item, on) : string.Empty)"
               ConfirmLabel="@Words.RemoveConfirm"
               DangerAction="true"
               ReturnFocusId="@(_pendingRemove is { } opener ? RemoveId(opener) : null)"
               OnConfirm="RemoveItemAsync"
               OnCancel="CancelRemove" />

@code {
  [Parameter]
  public int Id { get; set; }

  private CurriculumDto? _curriculum;
  private bool _loading = true;
  private string? _loadError;
  private bool _unavailable;

  // The Add picker's answer (T195, T222): whether an EPA is left to add, which ListCurriculumItemEpaOptionsQuery decides
  // as the Add command does; asked only where the caller may add (MayAddItem, F6).
  private IReadOnlyList<EpaDto> _addEpas = [];
  private IReadOnlyList<EntrustmentScaleDto> _scales = [];
  private IReadOnlyList<WbaToolDto> _tools = [];

  // The page's one result, its kind, and where the focus goes once it is drawn.
  private ActionResult? _result;
  private string? _message;
  private bool _refused;
  private bool _focusResult;
  private string? _focusId;
  private bool _stripTokens;

  // Remove asks first; the item the open dialog asks about, or null.
  private ConfirmDialog? _confirmRemove;
  private CurriculumItemDto? _pendingRemove;
  private bool _removing;

  // What the page last read: it reads again only for another curriculum or a new token (F1), so the replace that strips a
  // token does not read it again and lose the result it wrote.
  private int? _readId;

  /// <summary>The h1, the tab and the crumb: the curriculum by name once read; T7's words while read or failed.</summary>
  private string Heading => _unavailable ? Words.CurriculumUnavailable
    : _curriculum is { } curriculum ? Words.ListTitle(curriculum)
    : Words.ListPageName;

  private string? Subtitle => _curriculum is { } curriculum ? Words.Subtitle(curriculum) : null;

  /// <summary>
  /// Each row's name, as its actions say it (T222, T239): its EPA, and whose own item it is where the row names its owner
  /// (the Administrator reads two institutions' own items on one EPA, T223); never two alike.
  /// </summary>
  private IReadOnlyDictionary<int, string> Names
    => RowNames.Distinct(_curriculum?.Items ?? [], item => item.Id,
      item => item.OwningInstitutionName is { Length: > 0 } owner ? $"{item.EpaCode} ({owner}'s own item)" : item.EpaCode);

  private static string OpenId(CurriculumItemDto item) => $"item-{item.Id}-open";

  private static string RemoveId(CurriculumItemDto item) => $"item-{item.Id}-remove";

  /// <summary>The codes of the EPAs whose items this curriculum holds but are not in force (T158), in the table's order.</summary>
  private IReadOnlyList<string> InactiveEpaCodes
    => _curriculum?.Items.Where(item => !item.EpaIsActive).Select(item => item.EpaCode).ToList() ?? [];

  /// <summary>
  /// The line under "Items (n)": the built empty line where the caller may add and no EPA is left (T222); F6's on a version
  /// the institution has superseded (S12); none where the add link is offered, or to a caller who adds nothing here.
  /// </summary>
  private string? AddLine(CurriculumDto curriculum)
    => curriculum.MayAddItem
      ? _addEpas.Count == 0 ? Words.NothingToAdd(curriculum) : null
      : curriculum.Institution is { IsActiveAdoption: false } ? Words.Superseded : null;

  protected override async Task OnParametersSetAsync()
  {
    if (_readId == Id && !HasToken(Navigation.Uri))
    {
      return;
    }

    await LoadAsync(readTokens: true);
  }

  private static bool HasToken(string uri)
    => CatalogueLinks.HasToken(uri, CatalogueLinks.AddedToken)
       || CatalogueLinks.HasToken(uri, CatalogueLinks.SavedToken)
       || CatalogueLinks.HasToken(uri, CatalogueLinks.BackToken);

  private async Task LoadAsync(bool readTokens)
  {
    _readId = Id;
    _loading = true;
    _loadError = null;
    _unavailable = false;
    ClearResult();
    try
    {
      var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
      _curriculum = await Sender.Send(new GetCurriculumByIdQuery(Id, user));
      if (_curriculum is null)
      {
        _unavailable = true;
        return;
      }

      _scales = await Sender.Send(new GetEntrustmentScalesListQuery());
      _tools = await Sender.Send(new GetWbaToolsQuery());
      _addEpas = await ReadAddPickerAsync(_curriculum, user);
      if (readTokens)
      {
        ReadTokens(_curriculum);
      }
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      // T329: fixed words on the page, the failure to the log; no notice and no table under it (S7).
      Logger.LogError(exception, "The items of curriculum {CurriculumId} could not be loaded.", Id);
      _curriculum = null;
      _loadError = Words.ListLoadFailed;
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task<IReadOnlyList<EpaDto>> ReadAddPickerAsync(CurriculumDto curriculum, System.Security.Claims.ClaimsPrincipal user)
    => curriculum.MayAddItem ? await Sender.Send(new ListCurriculumItemEpaOptionsQuery(Id, null, user)) : [];

  /// <summary>
  /// F1: the token's item, read again in this caller's scope. ?added and ?saved write their result, focused; ?back focuses
  /// the row's Edit (or View); an id the curriculum does not hold for the caller writes and focuses nothing. Any token is
  /// then stripped from the address, so a reload says nothing.
  /// </summary>
  private void ReadTokens(CurriculumDto curriculum)
  {
    var uri = Navigation.Uri;
    if (!HasToken(uri))
    {
      return;
    }

    _stripTokens = true;
    bool Holds(int? itemId) => itemId is int id && curriculum.Items.Any(item => item.Id == id);

    if (Holds(CatalogueLinks.TokenId(uri, CatalogueLinks.AddedToken)))
    {
      Show(Words.Added, refused: false);
    }
    else if (Holds(CatalogueLinks.TokenId(uri, CatalogueLinks.SavedToken)))
    {
      Show(Words.Saved, refused: false);
    }
    else if (CatalogueLinks.TokenId(uri, CatalogueLinks.BackToken) is int back && Holds(back))
    {
      _focusId = OpenId(curriculum.Items.First(item => item.Id == back));
    }
  }

  private Task RetryAsync() => LoadAsync(readTokens: true);

  // S7: once a Try again has read, the h1 takes the focus.
  private ValueTask FocusHeadingAsync() => PageFocus.FocusHeadingAsync(JS);

  private void Show(string message, bool refused)
  {
    _message = message;
    _refused = refused;
    _focusResult = true;
  }

  private void ClearResult()
  {
    _message = null;
    _refused = false;
    _focusResult = false;
    _focusId = null;
  }

  private async Task AskRemoveAsync(CurriculumItemDto item)
  {
    if (_removing)
    {
      return;
    }

    ClearResult();
    _pendingRemove = item;
    StateHasChanged();
    if (_confirmRemove is not null)
    {
      await _confirmRemove.ShowAsync();
    }
  }

  private void CancelRemove() => _pendingRemove = null;

  /// <summary>
  /// Sent at most once at a time (T206, T234): the flag is set before the first await. The result, or the refusal in the
  /// command's words (an ended programme's record holds the item, T312) or fixed words (T329), at the list's top, focused
  /// once the dialog has closed (T11). The curriculum is read again either way, with its state for the institution.
  /// </summary>
  private async Task RemoveItemAsync()
  {
    if (_pendingRemove is not { } item || _removing || _curriculum is not { } before)
    {
      return;
    }

    _removing = true;
    var name = Names[item.Id];
    var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
    try
    {
      var after = await Sender.Send(new RemoveCurriculumItemCommand(Id, item.Id, user));
      // The command's curriculum carries no state for the institution (build-contracts § 0); kept until the read below.
      _curriculum = after with { Institution = before.Institution, MayAddItem = before.MayAddItem };
      Show(Words.Removed(name), refused: false);
    }
    catch (CurriculumItemOnEndedRecordsException refusal)
    {
      Show(RemoveCurriculumItemCommandHandler.EndedRecordsHoldTheItem(refusal.Records), refused: true);
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogError(exception, "Removing item {ItemId} from curriculum {CurriculumId} failed.", item.Id, Id);
      Show(Words.RemoveFailed(name), refused: true);
    }
    finally
    {
      _pendingRemove = null;
    }

    try
    {
      // Its EPA is free again, so the add link may come back (R3-B14); a refusal may come from a page out of date.
      if (await Sender.Send(new GetCurriculumByIdQuery(Id, user)) is { } reread)
      {
        _curriculum = reread;
      }

      _addEpas = await ReadAddPickerAsync(_curriculum, user);
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogError(exception, "The items of curriculum {CurriculumId} could not be read again.", Id);
    }
    finally
    {
      _removing = false;
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_loading)
    {
      return;
    }

    if (_focusResult && _result is not null)
    {
      _focusResult = false;
      await _result.Element.FocusAsync();
    }

    if (_focusId is { } id)
    {
      _focusId = null;
      await PageFocus.FocusByIdAsync(JS, id);
    }

    if (_stripTokens)
    {
      _stripTokens = false;
      Navigation.NavigateTo(CatalogueLinks.WithoutTokens(Navigation.Uri), replace: true);
    }
  }
}

@page "/admin/curricula/{Id:int}/items"
@attribute [Authorize(Policy = "NationalCatalogueAccess")]
@inject IScopedSender Sender
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@using System.Globalization
@using Wombat.Domain.Curricula
@using Wombat.Application.Features.Curricula.Quota

<PageTitle>Curriculum Items</PageTitle>

<PageHeader Title="Curriculum items" Subtitle="@(_curriculum is null ? "Manage EPA requirements for the selected curriculum." : $"{_curriculum.Name} ({_curriculum.Version})")">
  <Actions>
    <a class="btn btn-outline btn-sm" href="/admin/curricula">Back to curricula</a>
    @* T211. The curriculum's own page edits its details and clones it, which only its College can do. *@
    @if (_curriculum is { CanEditCurriculum: true })
    {
      <a class="btn btn-outline btn-sm" href="@($"/admin/curricula/{Id}")">Back to curriculum</a>
    }
  </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
  <Alert Kind="success">@_statusMessage</Alert>
}

@if (!string.IsNullOrWhiteSpace(_actionError))
{
  <Alert Kind="danger">@_actionError</Alert>
}

<StatePanel IsLoading="_loading" IsEmpty="@(_curriculum is null)" EmptyTitle="Curriculum not found" EmptyBody="The selected curriculum could not be loaded." LoadError="@_loadError">
  @if (_curriculum is not null)
  {
    @if (_curriculum.CanEditCurriculum)
    {
      <Alert Kind="warning" Role="">
        A target and its period are read live. Changing one changes what every trainee on this curriculum is measured
        against, in every institution that has adopted it, including periods that have already closed. A tool list is
        checked when an activity is filed and submitted, and never takes back credit already earned.
      </Alert>
    }
    else
    {
      @* T211. An institution opens a curriculum it has adopted, or one holding items of its own: the College's items are
         here to read, and its own to keep. The missing buttons alone would not say which is which, or why. *@
      <Alert Kind="warning" Role="">
        The College sets this curriculum's national items, so they are read only here. Your institution's own items apply
        only to its trainees, and you can add, edit and remove them. A target and its period are read live: changing one
        changes what every trainee of your institution on this curriculum is measured against, including periods that
        have already closed. A tool list is checked when an activity is filed and submitted, and never takes back credit
        already earned.
      </Alert>
    }

    @* T158. The editor lists every item as a record, so an item whose EPA is inactive is still here. It must say that
       the item is not in force, or an admin sees a target that no trainee sees and nothing tells them why. *@
    @if (InactiveEpaCodes is { Count: > 0 } inactive)
    {
      <Alert Kind="info">
        @(inactive.Count == 1
          ? $"{inactive[0]} is inactive, so its item is not in force: no trainee can file against it, it takes no credit, and no progress page or dashboard shows it."
          : $"{string.Join(", ", inactive)} are inactive, so their items are not in force: no trainee can file against them, they take no credit, and no progress page or dashboard shows them.")
        Reactivating an EPA on its own page brings its item back.
      </Alert>
    }

    <div class="detail-card">
      <h3>Existing items</h3>
      <div class="table-container shadow">
        @* Compact (T176): at the default padding, nine columns need 1018px, and the container has 907px at 1280px.
           The EPA and Tools columns give way first when the table is short of room (T198): they wrap, breaking a long
           word if they must, down to a floor, and only then does the table scroll. Their longest words,
           "neurodevelopmental" and "observation,", had set its narrowest width and left it 33px to spare at 1280px
           (T176); the floors leave 113. No word breaks at 1280px, but "neurodevelopmental" does just below it, where
           the table used to fit. DESIGN.md § Table system has the measurements. *@
        <table class="clinic-table clinic-table--compact">
          <thead>
            <tr>
              <th class="col-wrap col-wrap--wide">EPA</th>
              @* T131: the decision cadence and body share the target's cell, as they share Annexure B's row, rather than
                 take a tenth column (T176). *@
              <th>Target and decision</th>
              <th>Scale</th>
              <th>Minimum level</th>
              <th>Minimum by training year</th>
              <th>Completion window (months)</th>
              <th>Weight</th>
              <th class="col-wrap">Tools</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in _curriculum.Items)
            {
              var editing = _editingItemId == item.Id;
              var stages = StageMinimaDraft.Parse(item.MinimumLevelByStageJson);
              @* An item open for editing keeps its read-only row, so what is stored stays in view above what is being
                 changed; only its actions cell changes. *@
              <tr class="@(editing ? "is-editing" : null)">
                <td class="col-wrap">
                  @item.EpaCode - @item.EpaTitle
                  @if (!item.EpaIsActive)
                  {
                    <span class="muted">(inactive: not in force)</span>
                  }
                  @if (item.IsLocal)
                  {
                    <div class="muted text-sm">The institution's own item</div>
                  }
                </td>
                <td>
                  @TargetText(item)
                  <div class="muted text-sm">@DecisionText(item)</div>
                </td>
                <td>@(item.ScaleName ?? "Not pinned")</td>
                <td>@RungText(item.ScaleId, item.MinimumLevelOrder)</td>
                <td>
                  @if (stages.Unreadable is not null)
                  {
                    <span class="font-mono">@stages.Unreadable</span>
                  }
                  else if (stages.Rows.Count == 0 && stages.Kept.Count == 0)
                  {
                    <span>—</span>
                  }
                  else
                  {
                    <ul class="list-unstyled">
                      @foreach (var row in stages.Rows)
                      {
                        <li>Year @row.Year: @(row.Level is int level ? RungText(item.ScaleId, level) : "—")</li>
                      }
                      @foreach (var entry in stages.Kept)
                      {
                        <li class="font-mono">@entry.Name: @entry.RawValue</li>
                      }
                    </ul>
                  }
                </td>
                <td>@item.WindowMonths</td>
                <td>@(item.Weight?.ToString("0.##") ?? "—")</td>
                <td class="col-wrap">@ToolsText(item.PermittedToolKeys)</td>
                <td>
                  @if (editing)
                  {
                    <span class="muted">Editing below</span>
                  }
                  else if (!item.CanEdit)
                  {
                    @* T211. Edit and Remove are offered only where the Update and Remove commands would accept them
                       (CurriculumItemDto.CanEdit). The one item a caller reads and cannot change is a national item read
                       by an institution. *@
                    <span class="muted">@(item.IsLocal ? "Another institution's item" : "Set by the College")</span>
                  }
                  else
                  {
                    <div class="actions-cell">
                      <button class="btn btn-sm btn-outline" @onclick="() => BeginEditAsync(item)">Edit</button>
                      <button class="btn btn-sm btn-danger" @onclick="() => RemoveItemAsync(item.Id)">Remove</button>
                    </div>
                  }
                </td>
              </tr>
              @if (editing)
              {
                @* Every control of the edit is in this one row, spanning the table (T176). In the item's own columns a
                   select was squeezed to a fragment of its label ("CPSA", "Cho…"). This row is as wide as the table, so
                   Save is only in view if the table fits its container: hence the compact padding above. T122 put the
                   tool list here, T125 the year-by-year minima, and T136 the refusal of a save, beside the item rather
                   than in the alert at the top of the page. *@
                <tr class="is-editing">
                  <td colspan="9">
                    <fieldset>
                      <legend>Edit @item.EpaCode</legend>
                      <div class="form-grid form-grid--wide">
                        <FormField Label="EPA" InputId="edit-epa" Required="true" FullWidth="true" HelpText="@EpaHelp">
                          <ChildContent>
                            <InputSelect id="edit-epa" class="form-select" TValue="int" @bind-Value="_editModel.EpaId"
                                         aria-describedby="@FieldHelp.DescribedBy("edit-epa", EpaHelp, EditEpaOffered ? null : "edit-epa-refused")">
                              @foreach (var epa in _editEpas)
                              {
                                <option value="@epa.Id">@EpaOptionText(epa)</option>
                              }
                            </InputSelect>
                          </ChildContent>
                          <ValidationContent>
                            @* T195. A stored EPA the item cannot name is not among the options, so the select shows none
                               selected, and Save is refused for an EPA the operator cannot see. Say so before they press it.
                               Under the help, as the select names them (T193). *@
                            @if (!EditEpaOffered)
                            {
                              <div id="edit-epa-refused" class="validation-message">@item.EpaCode is not one of the EPAs this item can name, so none is selected. Choose one before saving.</div>
                            }
                          </ValidationContent>
                        </FormField>

                        <FormField Label="Target" InputId="edit-count" HelpText="@TargetHelp">
                          <InputNumber id="edit-count" aria-describedby="@FieldHelp.Id("edit-count")" class="form-control" @bind-Value="_editModel.RequiredCount" />
                        </FormField>

                        <FormField Label="Per" InputId="edit-period" HelpText="@PeriodHelp">
                          <InputSelect id="edit-period" aria-describedby="@FieldHelp.Id("edit-period")" class="form-select" TValue="QuotaPeriod" @bind-Value="_editModel.QuotaPeriod">
                            <option value="@QuotaPeriod.Semester">Semester (@QuotaText.SemesterSplit(DateTime.UtcNow.Year))</option>
                            <option value="@QuotaPeriod.AcademicYear">Academic year (@QuotaText.AcademicYearMonths(DateTime.UtcNow.Year))</option>
                          </InputSelect>
                        </FormField>

                        <FormField Label="Decision cadence" InputId="edit-decision-cadence" HelpText="@DecisionCadenceHelp">
                          <InputSelect id="edit-decision-cadence" aria-describedby="@FieldHelp.Id("edit-decision-cadence")" class="form-select" TValue="QuotaPeriod?"
                                       @bind-Value="_editModel.DecisionCadence" @bind-Value:after="() => OnDecisionCadenceChanged(_editModel)">
                            <option value="">No published cadence</option>
                            <option value="@QuotaPeriod.Semester">Each semester</option>
                            <option value="@QuotaPeriod.AcademicYear">Each academic year</option>
                          </InputSelect>
                        </FormField>

                        <FormField Label="Decided by" InputId="edit-decision-body" HelpText="@DecisionBodyHelp">
                          <InputSelect id="edit-decision-body" aria-describedby="@FieldHelp.Id("edit-decision-body")" class="form-select" TValue="string" @bind-Value="_editModel.DecisionBodyKey">
                            <option value="">The trainee's general panel</option>
                            @foreach (var body in _decisionBodies)
                            {
                              <option value="@body.Key">@body.Name</option>
                            }
                          </InputSelect>
                        </FormField>

                        <FormField Label="Opportunistic" InputId="edit-decision-opportunistic" HelpText="@DecisionOpportunisticHelp">
                          <div class="form-check">
                            <input id="edit-decision-opportunistic" aria-describedby="@FieldHelp.Id("edit-decision-opportunistic")" class="form-check-input" type="checkbox"
                                   checked="@_editModel.DecisionIsOpportunistic" disabled="@(_editModel.DecisionCadence is null)"
                                   @onchange="args => _editModel.DecisionIsOpportunistic = args.Value is true" />
                            <label for="edit-decision-opportunistic">Decided as rotation or opportunity allows</label>
                          </div>
                        </FormField>

                        <FormField Label="Entrustment scale" InputId="edit-scale" HelpText="@ScaleHelp">
                          <InputSelect id="edit-scale" class="form-select" TValue="int?" aria-describedby="@FieldHelp.Id("edit-scale")"
                                       @bind-Value="_editModel.ScaleId" @bind-Value:after="() => OnScaleChanged(_editModel)">
                            <option value="">Not pinned</option>
                            @foreach (var scale in _scales)
                            {
                              <option value="@scale.Id">@scale.Name</option>
                            }
                          </InputSelect>
                        </FormField>

                        <FormField Label="Minimum level" InputId="edit-minimum" Required="true">
                          <RungPicker Id="edit-minimum" Scale="ScaleOf(_editModel.ScaleId)" @bind-Value="_editModel.MinimumLevelOrder" />
                        </FormField>

                        <div class="full-width">
                          <StageMinimaEditor Draft="_editModel.StageMinima" IdPrefix="edit" Scale="ScaleOf(_editModel.ScaleId)" OnChanged="StateHasChanged" />
                        </div>

                        <FormField Label="Completion window (months)" InputId="edit-window" HelpText="@WindowHelp">
                          <InputNumber id="edit-window" aria-describedby="@FieldHelp.Id("edit-window")" class="form-control" @bind-Value="_editModel.WindowMonths" />
                        </FormField>

                        <FormField Label="Weight" InputId="edit-weight">
                          <InputNumber id="edit-weight" class="form-control" @bind-Value="_editModel.Weight" />
                        </FormField>

                        <fieldset class="full-width" aria-describedby="edit-tools-help">
                          <legend>Tools</legend>
                          <p id="edit-tools-help" class="muted">@ToolsHelp</p>
                          <div class="check-grid">
                            @foreach (var tool in ToolOptions(_editModel))
                            {
                              <div class="form-check">
                                <input id="@($"edit-tool-{tool.Key}")" class="form-check-input" type="checkbox"
                                       checked="@_editModel.PermittedToolKeys.Contains(tool.Key)"
                                       @onchange="args => ToggleTool(_editModel, tool.Key, args)" />
                                <label for="@($"edit-tool-{tool.Key}")">@tool.Name</label>
                              </div>
                            }
                          </div>
                        </fieldset>
                      </div>

                      @* The refusal sits just above the button that was pressed, which is where the operator is looking. *@
                      @if (!string.IsNullOrWhiteSpace(_rowError))
                      {
                        <Alert Kind="danger" Role="alert">@_rowError</Alert>
                      }

                      <FormActions>
                        @* The live region is always there and only its content comes and goes: a screen reader announces
                           a change to a region it already knows, not reliably one that arrives already filled. It sits
                           beside Save, which points at it, so the reason Save is off is read with it and seen with it. *@
                        <span id="edit-minima-status" class="muted" role="status">@(MinimaComplete(_editModel) ? null : IncompleteText(_editModel, "Saving"))</span>
                        <button type="button" class="btn btn-outline" @onclick="CancelEdit">Cancel</button>
                        <button type="button" class="btn btn-primary" disabled="@(_saving || !MinimaComplete(_editModel))"
                                aria-describedby="edit-minima-status" @onclick="SaveItemAsync">Save</button>
                      </FormActions>
                    </fieldset>
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="form-container mt-3">
      @* T211. An institution adds an item of its own; the College, or an Administrator, a national one. The Add command
         makes a national item exactly where the caller writes the College's (CurriculumItemEpas.OwnerOfNewItem), which
         is what CanEditCurriculum says, so the heading names the kind of item the form will make. *@
      <h3>@(_curriculum.CanEditCurriculum ? "Add item" : "Add your institution's own item")</h3>
      <EditForm Model="_addModel" OnValidSubmit="AddItemAsync" FormName="curriculum-item">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary-errors" />

        @if (!string.IsNullOrWhiteSpace(_addError))
        {
          <Alert Kind="danger" Role="alert">@_addError</Alert>
        }

        <div class="form-grid form-grid--wide">
          @* Full width here and in the edit row: v11.1's EPA titles run to over a hundred characters. *@
          <FormField Label="EPA" InputId="curriculum-item-epa" Required="true" FullWidth="true" HelpText="@EpaHelp">
            <InputSelect id="curriculum-item-epa" class="form-select" TValue="int" aria-describedby="@FieldHelp.Id("curriculum-item-epa")" @bind-Value="_addModel.EpaId">
              @foreach (var epa in _addEpas)
              {
                <option value="@epa.Id">@EpaOptionText(epa)</option>
              }
            </InputSelect>
          </FormField>

          <FormField Label="Target" InputId="curriculum-item-count" HelpText="@TargetHelp">
            <InputNumber id="curriculum-item-count" aria-describedby="@FieldHelp.Id("curriculum-item-count")" class="form-control" @bind-Value="_addModel.RequiredCount" />
          </FormField>

          <FormField Label="Per" InputId="curriculum-item-period" HelpText="@PeriodHelp">
            <InputSelect id="curriculum-item-period" aria-describedby="@FieldHelp.Id("curriculum-item-period")" class="form-select" TValue="QuotaPeriod" @bind-Value="_addModel.QuotaPeriod">
              <option value="@QuotaPeriod.Semester">Semester (@QuotaText.SemesterSplit(DateTime.UtcNow.Year))</option>
              <option value="@QuotaPeriod.AcademicYear">Academic year (@QuotaText.AcademicYearMonths(DateTime.UtcNow.Year))</option>
            </InputSelect>
          </FormField>

          <FormField Label="Decision cadence" InputId="curriculum-item-decision-cadence" HelpText="@DecisionCadenceHelp">
            <InputSelect id="curriculum-item-decision-cadence" aria-describedby="@FieldHelp.Id("curriculum-item-decision-cadence")" class="form-select" TValue="QuotaPeriod?"
                         @bind-Value="_addModel.DecisionCadence" @bind-Value:after="() => OnDecisionCadenceChanged(_addModel)">
              <option value="">No published cadence</option>
              <option value="@QuotaPeriod.Semester">Each semester</option>
              <option value="@QuotaPeriod.AcademicYear">Each academic year</option>
            </InputSelect>
          </FormField>

          <FormField Label="Decided by" InputId="curriculum-item-decision-body" HelpText="@DecisionBodyHelp">
            <InputSelect id="curriculum-item-decision-body" aria-describedby="@FieldHelp.Id("curriculum-item-decision-body")" class="form-select" TValue="string" @bind-Value="_addModel.DecisionBodyKey">
              <option value="">The trainee's general panel</option>
              @foreach (var body in _decisionBodies)
              {
                <option value="@body.Key">@body.Name</option>
              }
            </InputSelect>
          </FormField>

          <FormField Label="Opportunistic" InputId="curriculum-item-decision-opportunistic" HelpText="@DecisionOpportunisticHelp">
            <div class="form-check">
              <input id="curriculum-item-decision-opportunistic" aria-describedby="@FieldHelp.Id("curriculum-item-decision-opportunistic")" class="form-check-input" type="checkbox"
                     checked="@_addModel.DecisionIsOpportunistic" disabled="@(_addModel.DecisionCadence is null)"
                     @onchange="args => _addModel.DecisionIsOpportunistic = args.Value is true" />
              <label for="curriculum-item-decision-opportunistic">Decided as rotation or opportunity allows</label>
            </div>
          </FormField>

          @{ var addScaleReason = AddScaleReason(); }
          <FormField Label="Entrustment scale" InputId="curriculum-item-scale" HelpText="@ScaleHelp">
            <InputSelect id="curriculum-item-scale" class="form-select" TValue="int?"
                         aria-describedby="@FieldHelp.DescribedBy("curriculum-item-scale", ScaleHelp, addScaleReason is null ? null : AddScaleReasonId)"
                         @bind-Value="_addModel.ScaleId" @bind-Value:after="() => OnScaleChanged(_addModel)">
              <option value="">Not pinned</option>
              @foreach (var scale in _scales)
              {
                <option value="@scale.Id">@scale.Name</option>
              }
            </InputSelect>
            @if (addScaleReason is not null)
            {
              <small id="@AddScaleReasonId" class="muted">Suggested because @addScaleReason.</small>
            }
          </FormField>

          <FormField Label="Minimum level" InputId="curriculum-item-level" Required="true">
            <RungPicker Id="curriculum-item-level" Scale="ScaleOf(_addModel.ScaleId)" @bind-Value="_addModel.MinimumLevelOrder" />
          </FormField>

          <div class="full-width">
            <StageMinimaEditor Draft="_addModel.StageMinima" IdPrefix="add" Scale="ScaleOf(_addModel.ScaleId)" OnChanged="StateHasChanged" />
          </div>

          <FormField Label="Completion window (months)" InputId="curriculum-item-window" HelpText="@WindowHelp">
            <InputNumber id="curriculum-item-window" aria-describedby="@FieldHelp.Id("curriculum-item-window")" class="form-control" @bind-Value="_addModel.WindowMonths" />
          </FormField>

          <FormField Label="Weight" InputId="curriculum-item-weight">
            <InputNumber id="curriculum-item-weight" class="form-control" @bind-Value="_addModel.Weight" />
          </FormField>

          @* T122. A fieldset, not a FormField: a group of checkboxes has no single input for a label to point at. *@
          <fieldset class="full-width" aria-describedby="add-tools-help">
            <legend>Tools</legend>
            <p id="add-tools-help" class="muted">@ToolsHelp</p>
            <div class="check-grid">
              @foreach (var tool in ToolOptions(_addModel))
              {
                <div class="form-check">
                  <input id="@($"add-tool-{tool.Key}")" class="form-check-input" type="checkbox"
                         checked="@_addModel.PermittedToolKeys.Contains(tool.Key)"
                         @onchange="args => ToggleTool(_addModel, tool.Key, args)" />
                  <label for="@($"add-tool-{tool.Key}")">@tool.Name</label>
                </div>
              }
            </div>
          </fieldset>
        </div>

        <FormActions>
          @* Always rendered, filled only when adding is off; see the edit row's status for why. *@
          <span id="add-minima-status" class="muted" role="status">@(MinimaComplete(_addModel) ? null : IncompleteText(_addModel, "Adding"))</span>
          <button type="submit" class="btn btn-primary" disabled="@(_saving || !MinimaComplete(_addModel))"
                  aria-describedby="add-minima-status">Add item</button>
        </FormActions>
      </EditForm>
    </div>
  }
</StatePanel>

@code {
  [Parameter]
  public int Id { get; set; }

  private CurriculumDto? _curriculum;
  // What each EPA picker offers (T195): the Add form's for an item the caller would own, the edit row's for the item
  // being edited, whose owner is stored. Each is ListCurriculumItemEpaOptionsQuery's answer, the rule the command it
  // feeds enforces, so the page filters neither.
  private IReadOnlyList<EpaDto> _addEpas = [];
  private IReadOnlyList<EpaDto> _editEpas = [];

  /// <summary>
  /// Whether the edit row's EPA is one its picker offers. Only the stored EPA can be missing from it: anything chosen was
  /// chosen from the list.
  /// </summary>
  private bool EditEpaOffered => _editEpas.Any(epa => epa.Id == _editModel.EpaId);

  private IReadOnlyList<EntrustmentScaleDto> _scales = [];
  private IReadOnlyList<WbaToolDto> _tools = [];
  private IReadOnlyList<DecisionBodyDto> _decisionBodies = [];
  // Two models, not one (T122). The inline edit row and the Add form used to bind the same instance, so opening a row
  // for editing silently filled the Add form with that row's values; with a tool list in both, the two checkbox
  // groups would also have toggled each other.
  private readonly CurriculumItemFormModel _addModel = new();
  private readonly CurriculumItemFormModel _editModel = new();
  private int? _editingItemId;
  private string? _loadError;
  // Where a refusal is shown is where the operator is looking (T136): a Remove's at the top, a Save's beside the row
  // being edited, an Add's inside the Add form at the foot of the page.
  private string? _actionError;
  private string? _rowError;
  private string? _addError;
  private string? _statusMessage;
  private bool _loading;
  private bool _saving;

  // One help text per field, printed by the edit form and the Add form alike (T176): the two are the same fields, in the
  // same order, with the same help, and CurriculumItemsEditLayoutTests holds them to it. The scale's matters most while
  // editing, which is when a change of ladder clears the minima already stored.
  private const string EpaHelp = "Lists only the EPAs this item can name: the national EPAs of this curriculum's sub-speciality and, for an item an institution added, that institution's own local EPAs.";
  private const string TargetHelp = "Credited encounters required in each period below. This is the published frequency, not a total for the whole programme.";
  private const string PeriodHelp = "A semester target applies to each semester on its own. A surplus in one semester does not carry into the next.";
  private const string ScaleHelp = "The ladder the minima are picked on. Changing it clears them, because the same number is a different rung on another ladder; changing back brings back what was picked on this one. Leave unpinned if you are not certain: a wrong scale makes assessments on another ladder stop counting toward the minimum.";
  private const string WindowHelp = "Only used to suggest a trainee's expected completion date. It is not the target period, and credit does not check it.";
  private const string DecisionCadenceHelp = "How often a committee takes the entrustment decision on this EPA (Annexure B). Separate from the target: an EPA observed each semester may be decided once a year. With no cadence the EPA is never due, but a committee can still decide it.";
  private const string DecisionBodyHelp = "The committee the College names to decide this EPA instead of the trainee's general panel, such as the neonatal CCC for paediatric EPAs 4 and 5.";
  private const string DecisionOpportunisticHelp = "For an EPA the College has decided as rotation or opportunity allows, such as paediatric EPAs 8, 9 and 13: its decision is never overdue. Needs a decision cadence.";
  private const string AddScaleReasonId = "curriculum-item-scale-reason";
  private const string ToolsHelp = "The instruments that may be used as evidence for this EPA. None ticked means any instrument. Checked when an activity is filed and submitted; it never takes back credit already earned.";

  protected override async Task OnParametersSetAsync()
  {
    _loading = true;
    _loadError = null;
    _actionError = null;
    _statusMessage = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _curriculum = await Sender.Send(new GetCurriculumByIdQuery(Id, authState.User));
      if (_curriculum is null)
      {
        Navigation.NavigateTo("/not-found");
        return;
      }

      _addEpas = await Sender.Send(new ListCurriculumItemEpaOptionsQuery(Id, null, authState.User));
      _scales = await Sender.Send(new GetEntrustmentScalesListQuery());
      _tools = await Sender.Send(new GetWbaToolsQuery());
      _decisionBodies = await Sender.Send(new GetDecisionBodiesQuery());
      ResetItemModel();
    }
    catch (Exception exception)
    {
      _loadError = exception.Message;
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task AddItemAsync()
  {
    // The button is off until every minimum is picked; this is the same rule for a submit that did not come from it.
    if (!MinimaComplete(_addModel))
    {
      return;
    }

    _addError = null;
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    _addError = await RunAsync(() => Sender.Send(new AddCurriculumItemCommand(Id, _addModel.EpaId, _addModel.RequiredCount, _addModel.QuotaPeriod, _addModel.MinimumLevelOrder!.Value, _addModel.WindowMonths, _addModel.Weight, _addModel.StageMinima.ToJson(), _addModel.PermittedToolKeys.ToList(), _addModel.DecisionCadence, NullIfBlank(_addModel.DecisionBodyKey), _addModel.DecisionIsOpportunistic, authState.User, _addModel.ScaleId)), "Curriculum item added.");
    if (_addError is not null)
    {
      return;
    }

    ResetItemModel();
  }

  private async Task BeginEditAsync(CurriculumItemDto item)
  {
    // The edit row's picker is the item's own (T195): the item's owner decides which local EPAs it may name. A caller
    // the Update command would refuse is told so at the top, and the row does not open on a form they could not save.
    _actionError = null;
    _statusMessage = null;
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _editEpas = await Sender.Send(new ListCurriculumItemEpaOptionsQuery(Id, item.Id, authState.User));
    }
    catch (Exception exception)
    {
      _actionError = exception.Message;
      return;
    }

    _editingItemId = item.Id;
    _rowError = null;
    _editModel.EpaId = item.EpaId;
    _editModel.RequiredCount = item.RequiredCount;
    _editModel.QuotaPeriod = item.QuotaPeriod;
    // Copied as they are, null included, so saving an item unchanged keeps its decision (T131). A null cadence is not
    // the zero value: it stays "no published cadence".
    _editModel.DecisionCadence = item.DecisionCadence;
    _editModel.DecisionBodyKey = item.DecisionBodyKey;
    _editModel.DecisionIsOpportunistic = item.DecisionIsOpportunistic;
    _editModel.MinimumLevelOrder = item.MinimumLevelOrder;
    _editModel.WindowMonths = item.WindowMonths;
    _editModel.Weight = item.Weight;
    // Parsed into rows, with anything the editor cannot render kept verbatim, so an unchanged save writes back what
    // is stored (T125).
    _editModel.StageMinima = StageMinimaDraft.Parse(item.MinimumLevelByStageJson);
    _editModel.StartOn(item.ScaleId);
    // Copied, so saving an item unchanged keeps its list (T122). A key the vocabulary no longer holds is kept too,
    // and shown as its own checkbox by ToolOptions, so it can be seen and unticked.
    _editModel.PermittedToolKeys = item.PermittedToolKeys.ToHashSet(StringComparer.Ordinal);
  }

  private void CancelEdit()
  {
    _editingItemId = null;
    _rowError = null;
  }

  private async Task SaveItemAsync()
  {
    if (!_editingItemId.HasValue || !MinimaComplete(_editModel))
    {
      return;
    }

    _rowError = null;
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    // Only leave edit mode when the command actually succeeded. Closing the row on a refusal would throw away
    // everything the operator picked while showing them an error about it.
    _rowError = await RunAsync(() => Sender.Send(new UpdateCurriculumItemCommand(Id, _editingItemId.Value, _editModel.EpaId, _editModel.RequiredCount, _editModel.QuotaPeriod, _editModel.MinimumLevelOrder!.Value, _editModel.WindowMonths, _editModel.Weight, _editModel.StageMinima.ToJson(), _editModel.PermittedToolKeys.ToList(), _editModel.DecisionCadence, NullIfBlank(_editModel.DecisionBodyKey), _editModel.DecisionIsOpportunistic, authState.User, _editModel.ScaleId)), "Curriculum item saved.");
    if (_rowError is not null)
    {
      return;
    }

    _editingItemId = null;
  }

  private async Task RemoveItemAsync(int itemId)
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    _actionError = await RunAsync(() => Sender.Send(new RemoveCurriculumItemCommand(Id, itemId, authState.User)), "Curriculum item removed.");
  }

  /// <summary>Runs a command and reloads the curriculum from its result. Returns the refusal, or null on success.</summary>
  private async Task<string?> RunAsync(Func<Task<CurriculumDto>> action, string successMessage)
  {
    _saving = true;
    _actionError = null;
    _statusMessage = null;

    try
    {
      _curriculum = await action();
      _statusMessage = successMessage;
      return null;
    }
    catch (Exception exception)
    {
      return exception.Message;
    }
    finally
    {
      _saving = false;
    }
  }

  private void ResetItemModel()
  {
    _addModel.EpaId = _addEpas.FirstOrDefault()?.Id ?? 0;
    _addModel.RequiredCount = 1;
    _addModel.QuotaPeriod = QuotaPeriod.AcademicYear;
    // No decision cadence until one is chosen (T131): every EPA due each academic year is not a default anybody chose.
    _addModel.DecisionCadence = null;
    _addModel.DecisionBodyKey = null;
    _addModel.DecisionIsOpportunistic = false;
    // Empty, not a number: "4" was 3b on the v11.1 ladder, and a default is a minimum nobody chose (T125).
    _addModel.MinimumLevelOrder = null;
    _addModel.WindowMonths = 12;
    _addModel.Weight = null;
    _addModel.StageMinima = StageMinimaDraft.Parse(null);
    _addModel.StartOn(SuggestedScale().ScaleId);
    _addModel.PermittedToolKeys = new HashSet<string>(StringComparer.Ordinal);
  }

  /// <summary>
  /// Why the Add form is on the ladder it shows, while that is still the suggestion; null once the operator has picked
  /// another, or once the items have changed so that it no longer is.
  /// </summary>
  /// <remarks>Worked out as the page renders, so an Update or a Remove that changes the siblings cannot leave a stale reason.</remarks>
  private string? AddScaleReason()
  {
    if (_addModel.ScaleChanged)
    {
      return null;
    }

    var (scaleId, reason) = SuggestedScale();
    return scaleId == _addModel.ScaleId ? reason : null;
  }

  /// <summary>
  /// The ladder a new item starts on: the one every existing item shares, else the sub-speciality's default, else none.
  /// </summary>
  /// <remarks>
  /// A suggestion the operator sees and can change, never a pin made behind their back: the minima are empty until
  /// they pick each one as a rung on it, and the page says where the suggestion came from.
  /// </remarks>
  private (int? ScaleId, string? Reason) SuggestedScale()
  {
    var pins = _curriculum?.Items.Select(item => item.ScaleId).Distinct().ToList() ?? [];
    if (pins is [int shared] && ScaleOf(shared) is not null)
    {
      return (shared, "every item on this curriculum is pinned to it");
    }

    if (_curriculum?.SubSpecialityDefaultScaleId is int fallback && ScaleOf(fallback) is not null)
    {
      return (fallback, $"it is the default scale of {_curriculum.SubSpecialityName}");
    }

    return (null, null);
  }

  /// <summary>
  /// With no cadence an EPA is never due, so "as opportunity allows" says nothing; the box is cleared and disabled rather
  /// than left ticked for the command validator to refuse (T131).
  /// </summary>
  private static void OnDecisionCadenceChanged(CurriculumItemFormModel model)
  {
    if (model.DecisionCadence is null)
    {
      model.DecisionIsOpportunistic = false;
    }
  }

  private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

  /// <summary>A scale change: the minima on screen go with the ladder they were picked on (T125). See <see cref="CurriculumItemFormModel.MoveToScale" />.</summary>
  private static void OnScaleChanged(CurriculumItemFormModel model) => model.MoveToScale();

  private EntrustmentScaleDto? ScaleOf(int? scaleId)
    => scaleId is int id ? _scales.FirstOrDefault(scale => scale.Id == id) : null;

  /// <summary>
  /// Whether the item may be sent: every minimum, flat and by year, a rung on its ladder (or, unpinned, a level 1–20),
  /// and nothing stored under the year-by-year minima that the command validator would refuse.
  /// </summary>
  private bool MinimaComplete(CurriculumItemFormModel model)
    => RungsPicked(model) && !model.StageMinima.HasUnrenderedEntries;

  private bool RungsPicked(CurriculumItemFormModel model)
  {
    var scale = ScaleOf(model.ScaleId);
    return RungPicker.Accepts(scale, model.MinimumLevelOrder)
      && model.StageMinima.Rows.All(row => RungPicker.Accepts(scale, row.Level));
  }

  /// <param name="action">What is off, as the button the operator is looking at does it: "Saving", "Adding".</param>
  private string IncompleteText(CurriculumItemFormModel model, string action)
  {
    if (RungsPicked(model))
    {
      return $"{action} is off until each stored entry under Minimum by training year that is not a year and a rung is removed.";
    }

    var scale = ScaleOf(model.ScaleId);
    if (model.ScaleChanged && model.ClearedByScaleChange)
    {
      return scale is null
        ? "The item is no longer pinned, so the minima picked on the previous ladder have been cleared. Type each one again as a level from 1 to 20."
        : $"The scale is now {scale.Name}, so the minima picked on the previous ladder have been cleared: the same number is a different rung on another ladder. Choose each one again on {scale.Name}.";
    }

    return scale is null
      ? $"{action} is off until every minimum is a level from 1 to 20."
      : $"{action} is off until every minimum is a rung on {scale.Name}.";
  }

  /// <summary>
  /// The rung as the College prints it, resolved from the loaded ladders (T125, T100). The ordinal when the item is
  /// unpinned; the ordinal, marked, when it is pinned and the value is not a rung on its ladder, as the edit picker
  /// marks it: on a ladder whose rungs are named "1" to "5", a bare 6 would read as a real rung.
  /// </summary>
  private string RungText(int? scaleId, int order)
  {
    var ordinal = order.ToString(CultureInfo.InvariantCulture);
    var scale = ScaleOf(scaleId);
    if (scale is null)
    {
      return ordinal;
    }

    return scale.Levels.FirstOrDefault(level => level.Order == order)?.Label ?? $"{ordinal} (not a rung on {scale.Name})";
  }

  /// <summary>The vocabulary, plus any stored key it no longer holds, shown by its raw key (T122).</summary>
  private IEnumerable<WbaToolDto> ToolOptions(CurriculumItemFormModel model)
    => _tools.Concat(model.PermittedToolKeys
      .Where(key => _tools.All(tool => tool.Key != key))
      .Order(StringComparer.Ordinal)
      .Select(key => new WbaToolDto(key, key, null)));

  private static void ToggleTool(CurriculumItemFormModel model, string toolKey, ChangeEventArgs args)
  {
    if (args.Value is true)
    {
      model.PermittedToolKeys.Add(toolKey);
    }
    else
    {
      model.PermittedToolKeys.Remove(toolKey);
    }
  }

  private string ToolsText(IEnumerable<string> toolKeys)
  {
    var names = toolKeys
      .Select(key => _tools.FirstOrDefault(tool => tool.Key == key)?.Name ?? key)
      .Order(StringComparer.OrdinalIgnoreCase)
      .ToList();
    return names.Count == 0 ? "Any instrument" : string.Join(", ", names);
  }

  /// <summary>The codes of the EPAs whose items this curriculum holds but are not in force (T158), in display order.</summary>
  private IReadOnlyList<string> InactiveEpaCodes
    => _curriculum?.Items.Where(item => !item.EpaIsActive).Select(item => item.EpaCode).ToList() ?? [];

  // An inactive EPA can still be picked (an item may be prepared before its EPA is reactivated), but it says so: its
  // item would not be in force (T158).
  private static string EpaOptionText(EpaDto epa)
    => epa.IsActive ? $"{epa.Code} - {epa.Title}" : $"{epa.Code} - {epa.Title} (inactive)";

  /// <summary>The item's entrustment decision, as the target's second line (T131).</summary>
  private static string DecisionText(CurriculumItemDto item)
  {
    var cadence = item.DecisionCadence switch
    {
      QuotaPeriod.Semester => "Decided each semester",
      QuotaPeriod.AcademicYear => "Decided each academic year",
      _ => "No decision cadence"
    };
    var opportunity = item.DecisionIsOpportunistic ? ", as opportunity allows" : string.Empty;
    var body = item.DecisionBodyName is { } name ? $", by the {name}" : string.Empty;
    return $"{cadence}{opportunity}{body}";
  }

  private static string TargetText(CurriculumItemDto item)
    => item.QuotaPeriod == QuotaPeriod.Semester
      ? $"{item.RequiredCount} per semester"
      : $"{item.RequiredCount} per academic year";

  private sealed class CurriculumItemFormModel
  {
    [Range(1, int.MaxValue)]
    public int EpaId { get; set; }

    [Range(1, int.MaxValue)]
    public int RequiredCount { get; set; }

    /// <summary>The window RequiredCount is a target for (T130). Copied from the item on edit, so saving unchanged keeps it.</summary>
    public QuotaPeriod QuotaPeriod { get; set; }

    /// <summary>How often the EPA is decided, or null for no published cadence (T131). Nullable, so nothing defaults it.</summary>
    public QuotaPeriod? DecisionCadence { get; set; }

    /// <summary>The deciding body's key; null or blank for the general panel (T131).</summary>
    public string? DecisionBodyKey { get; set; }

    /// <summary>Whether the EPA is decided as opportunity allows (T131). Only with a cadence.</summary>
    public bool DecisionIsOpportunistic { get; set; }

    /// <summary>The flat minimum's ordinal; null until one is picked, and again after a scale change (T125).</summary>
    public int? MinimumLevelOrder { get; set; }

    [Range(1, int.MaxValue)]
    public int WindowMonths { get; set; }

    public double? Weight { get; set; }

    /// <summary>The minimum by training year, as rows (T125). Serialised to the JSON the command takes on save.</summary>
    public StageMinimaDraft StageMinima { get; set; } = StageMinimaDraft.Parse(null);

    /// <summary>Null means unpinned, which compares ordinals exactly as Wombat did before T109.</summary>
    public int? ScaleId { get; set; }

    /// <summary>Whether the scale differs from the one this edit (or this Add form) started on.</summary>
    public bool ScaleChanged => ScaleId != _startingScaleId;

    /// <summary>Whether the latest scale change emptied a minimum that had been picked, so the page can say why.</summary>
    public bool ClearedByScaleChange { get; private set; }

    /// <summary>The instruments ticked. Empty means any instrument (T122, D21), and is sent as such.</summary>
    public HashSet<string> PermittedToolKeys { get; set; } = new(StringComparer.Ordinal);

    private int? _startingScaleId;

    // The ladder the minima on screen were picked on. ScaleId has already moved when MoveToScale runs, so this is how
    // it knows which ladder it is leaving.
    private int? _ladder;

    // What was picked on each ladder left during this edit, keyed by scale id (0 for unpinned; ids start at 1).
    private readonly Dictionary<int, LadderPicks> _picksByLadder = [];

    /// <summary>Starts an edit, or a fresh Add form, on <paramref name="scaleId" />, with the minima already set.</summary>
    public void StartOn(int? scaleId)
    {
      ScaleId = scaleId;
      _startingScaleId = scaleId;
      _ladder = scaleId;
      _picksByLadder.Clear();
      ClearedByScaleChange = false;
    }

    /// <summary>
    /// Called after <see cref="ScaleId" /> changes. Every minimum, flat and by year, is emptied (T125): an ordinal is
    /// a different rung on each ladder, so carrying one across, or clamping it, would store a minimum nobody chose.
    /// </summary>
    /// <remarks>
    /// What was picked on the ladder being left is put aside and comes back if the operator returns to that ladder, so
    /// nothing ever crosses ladders but nothing is lost to a round trip either. On Windows each arrow key on a closed
    /// select is a change, so Down then Up would otherwise wipe an item's whole year curve while landing back on the
    /// ladder it was picked on.
    /// </remarks>
    public void MoveToScale()
    {
      if (ScaleId == _ladder)
      {
        return;
      }

      ClearedByScaleChange = MinimumLevelOrder is not null || StageMinima.Rows.Any(row => row.Level is not null);
      _picksByLadder[_ladder ?? 0] = new LadderPicks(
        MinimumLevelOrder, StageMinima.Rows.ToDictionary(row => row.Year, row => row.Level));

      MinimumLevelOrder = null;
      StageMinima.ClearLevels();
      if (_picksByLadder.TryGetValue(ScaleId ?? 0, out var picks))
      {
        MinimumLevelOrder = picks.Minimum;
        foreach (var row in StageMinima.Rows)
        {
          row.Level = picks.Years.GetValueOrDefault(row.Year);
        }
      }

      _ladder = ScaleId;
    }

    private sealed record LadderPicks(int? Minimum, IReadOnlyDictionary<int, int?> Years);
  }
}

@page "/admin/entrustment-decisions"
@attribute [Authorize(Roles = "Administrator,InstitutionalAdmin,SpecialityAdmin,SubSpecialityAdmin")]
@rendermode InteractiveServer
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>Entrustment decisions · Wombat</PageTitle>

<PageHeader Title="Entrustment decisions" Subtitle="Issued Statements of Awarded Responsibility across the programme." />

@if (!string.IsNullOrWhiteSpace(_status))
{
  <Alert Kind="success">@_status</Alert>
}

@if (!string.IsNullOrWhiteSpace(_error))
{
  <Alert Kind="danger">@_error</Alert>
}

@* The list page's filter (DESIGN.md § Table system): a search-container, whose bottom margin keeps it off the table. It was
   a detail-card, which has none, and the table touched it (T226 review). *@
<section class="search-container shadow">
  <div class="search-grid">
    <FormField Label="Trainee" InputId="filter-trainee">
      <input id="filter-trainee" class="form-control" @bind="_traineeFilter" @bind:event="oninput" placeholder="Filter by name" />
    </FormField>
    <FormField Label="Status" InputId="filter-status">
      <InputSelect id="filter-status" class="form-select" @bind-Value="_statusFilter">
        <option value="">All</option>
        @foreach (var status in Enum.GetValues<EntrustmentDecisionStatus>())
        {
          <option value="@status">@status</option>
        }
      </InputSelect>
    </FormField>
  </div>
  <FormActions>
    <button type="button" class="btn btn-primary" @onclick="LoadAsync">Apply filters</button>
  </FormActions>
</section>

@* The list page's three states are StatePanel's (DESIGN.md § Alerts, validation, empty states): skeletons while the list
   is read, its danger alert when the read fails, and its empty card. Until T266 the page said "Loading…" as text, and a
   failed read left it there, under the error. *@
<StatePanel IsLoading="@(_decisions is null && _loadError is null)" LoadError="@_loadError"
            IsEmpty="@(_decisions is { Count: 0 })"
            EmptyTitle="No entrustment decisions" EmptyBody="No entrustment decisions match the current filter.">
  @{ var decisionNames = DecisionNames(_decisions!); }
  @* A list table (DESIGN.md § Table system): a clinic-table in its container, which scrolls sideways on a narrow screen
     rather than widen the page. Until T226 it was a table class app.css does not define: the table was unstyled and, at
     390px, 133px wider than the screen. *@
  <div class="table-container shadow">
    <table class="clinic-table">
      <thead>
        <tr>
          <th>Trainee</th>
          <th>EPA</th>
          <th>Level</th>
          @* A date on one line: at 1280px "2026-07-02" broke at its hyphen (T226 review). *@
          <th class="col-fit">Issued</th>
          <th class="col-fit">Expires</th>
          <th>Status</th>
          <th><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var decision in _decisions!)
        {
          <tr>
            <td>@decision.TraineeName</td>
            @* A STAR on an EPA deactivated since says the EPA is no longer in use (T255). *@
            <td><EpaLabel Code="@decision.EpaCode" Title="@decision.EpaTitle" InForce="@decision.EpaInForce" /></td>
            <td>@decision.AuthorisedLevelLabel</td>
            <td class="col-fit">@decision.IssuedOn.ToString("yyyy-MM-dd")</td>
            <td class="col-fit">@(decision.ExpiresOn?.ToString("yyyy-MM-dd") ?? "—")</td>
            <td><span class="badge @BadgeFor.EntrustmentDecision(decision.Status)">@decision.Status</span></td>
            <td>
              <div class="actions-cell">
                @* T239: each named by the decision it acts on: whose, which EPA, and when it was issued. *@
                <button type="button" class="btn btn-sm btn-outline" aria-label="@($"Download the certificate of {decisionNames[decision.Id]}")"
                        @onclick="() => DownloadAsync(decision.Id)">Download</button>
                @if (decision.Status == EntrustmentDecisionStatus.Active)
                {
                  <button type="button" class="btn btn-sm btn-danger" aria-label="@($"Revoke {decisionNames[decision.Id]}")"
                          @onclick="() => OpenRevokeDialog(decision)">Revoke</button>
                }
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</StatePanel>

@if (_revokingDecision is not null)
{
  <section class="detail-card mt-3">
    <h3>Revoke entrustment decision</h3>
    <p>
      You are about to revoke the entrustment decision for
      <strong><EpaLabel Code="@_revokingDecision.EpaCode" Title="@_revokingDecision.EpaTitle" InForce="@_revokingDecision.EpaInForce" /></strong>
      held by <strong>@_revokingDecision.TraineeName</strong>.
      Revocation is immediate and irreversible. The trainee is notified.
    </p>
    <FormField Label="Revocation reason" InputId="revoke-reason" Required="true">
      <InputTextArea id="revoke-reason" class="form-control" @bind-Value="_revokeReason" />
    </FormField>
    <FormActions>
      <button type="button" class="btn btn-danger" @onclick="ConfirmRevokeAsync" disabled="@string.IsNullOrWhiteSpace(_revokeReason)">Confirm revocation</button>
      <button type="button" class="btn btn-outline" @onclick="CancelRevoke">Cancel</button>
    </FormActions>
  </section>
}

@code {
  /// <summary>
  /// Each decision as its row's actions name it (T239): "Thandi Nkosi's PAED-003 decision, issued 2026-07-02". A decision
  /// revoked or superseded and its re-issue can share all three, so a name two rows share adds each one's status and then
  /// its level, as the Status and Level columns say them (T239 review), and rows still alike are numbered.
  /// </summary>
  private static IReadOnlyDictionary<int, string> DecisionNames(IEnumerable<EntrustmentDecisionDto> decisions)
    => RowNames.Distinct(
      decisions,
      decision => decision.Id,
      decision => $"{decision.TraineeName}'s {decision.EpaCode} decision, issued " +
                  decision.IssuedOn.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
      decision => $", {decision.Status}",
      decision => $", level {decision.AuthorisedLevelLabel}");

  private IReadOnlyList<EntrustmentDecisionDto>? _decisions;

  // A failed read of the list, which StatePanel shows in the list's place.
  private string? _loadError;

  // A refused download or revocation, shown above the filter while the list stays in view.
  private string? _error;
  private string? _status;
  private string _traineeFilter = string.Empty;
  private EntrustmentDecisionStatus? _statusFilter;
  private EntrustmentDecisionDto? _revokingDecision;
  private string _revokeReason = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    await LoadAsync();
  }

  private async Task LoadAsync()
  {
    try
    {
      _error = null;
      _loadError = null;
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var trainee = string.IsNullOrWhiteSpace(_traineeFilter) ? null : _traineeFilter.Trim();
      _decisions = await Sender.Send(new ListEntrustmentDecisionsForAdminQuery(trainee, _statusFilter, authState.User));
    }
    catch (Exception exception)
    {
      // In its own words, never a validator's log line (DESIGN.md § Alerts, T213).
      _loadError = RefusalText.Of(exception);
    }
  }

  private async Task DownloadAsync(int decisionId)
  {
    try
    {
      _error = null;
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var result = await Sender.Send(new DownloadEntrustmentCertificateCommand(decisionId, authState.User));
      if (result is null)
      {
        _error = "The certificate could not be found among the decisions you oversee.";
        return;
      }

      await JS.InvokeVoidAsync("wombatFileDownload", result.FileName, result.PdfBytes);
    }
    catch (Exception exception)
    {
      _error = RefusalText.Of(exception);
    }
  }

  private void OpenRevokeDialog(EntrustmentDecisionDto decision)
  {
    _revokingDecision = decision;
    _revokeReason = string.Empty;
    _status = null;
    _error = null;
  }

  private void CancelRevoke()
  {
    _revokingDecision = null;
    _revokeReason = string.Empty;
  }

  private async Task ConfirmRevokeAsync()
  {
    if (_revokingDecision is null || string.IsNullOrWhiteSpace(_revokeReason))
    {
      return;
    }

    try
    {
      _error = null;
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await Sender.Send(new RevokeEntrustmentDecisionCommand(_revokingDecision.Id, _revokeReason.Trim(), authState.User));
      _status = $"Entrustment decision for {_revokingDecision.EpaCode} revoked.";
      _revokingDecision = null;
      _revokeReason = string.Empty;
      await LoadAsync();
    }
    catch (Exception exception)
    {
      _error = RefusalText.Of(exception);
    }
  }
}

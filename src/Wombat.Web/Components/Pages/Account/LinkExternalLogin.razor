@page "/account/link-external"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@using System.Security.Claims
@using Wombat.Web.Security
@inject SignInManager<WombatIdentityUser> SignInManager

@*
  Link your institutional sign-in (T339, flow 02; R3-LK-*, R2-LK-*). Static: the visitor is part way through an
  institutional sign-in and not signed in. Three states: live, the password asked for; refused, the same with the refusal
  in the slot above Password; and expired, when the sign-in in progress has gone, with no field, only the way back.

  A refused link reloads this page with its code in the query, and the page says it in words of its own, never the
  query's text (LinkExternalOutcome, T285). The refusal takes the focus itself (tabindex -1, autofocus), as the sign-in
  page's does (C6), and Password names it; with no refusal, Password takes the focus.
*@

@if (_loaded && _email is null)
{
  <PageTitle>Institutional sign-in expired · Wombat</PageTitle>

  <div class="account-form-container">
    <h1>Institutional sign-in expired</h1>
    <p>Your institutional sign-in has expired. Start again from the sign-in page.</p>
    <FormActions>
      <a href="@SignInOutcome.PagePath" class="btn btn-outline"><Icon Name="arrow-left" />Back to sign in</a>
    </FormActions>
  </div>
}
else
{
  <PageTitle>@(Refusal is not null ? "Error: Link your institutional sign-in" : "Link your institutional sign-in") · Wombat</PageTitle>

  <div class="account-form-container">
    <h1>Link your institutional sign-in</h1>
    <p>
      A Wombat account with the email <strong class="account-email">@_email</strong> already exists. Enter your current
      password to link your institutional sign-in.
    </p>

    <form method="post" action="/account/link-external/submit">
      <AntiforgeryToken />
      @* The account and the institutional login are read from the sign-in in progress, not from this form (T149). *@
      <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
      @if (Refusal is not null)
      {
        <Alert Kind="danger" Id="@ErrorId" tabindex="-1" autofocus>@Refusal</Alert>
      }
      <PasswordField Label="Password" Id="link-password" Name="Password" Autocomplete="current-password" Required="true"
                     Autofocus="@(Refusal is null)" DescribedBy="@(Refusal is null ? null : ErrorId)" />
      <FormActions>
        <a href="@SignInOutcome.PagePath" class="btn btn-outline">Cancel</a>
        <button type="submit" class="btn btn-primary">Link and sign in</button>
      </FormActions>
    </form>
  </div>
}

@code {
  [SupplyParameterFromQuery(Name = "returnUrl")]
  public string? ReturnUrl { get; set; }

  /// <summary>The code of the refusal that sent the browser back here (<see cref="LinkExternalOutcome" />), never its words.</summary>
  [SupplyParameterFromQuery(Name = "error")]
  public string? Error { get; set; }

  /// <summary>The refusal's id, which Password names.</summary>
  public const string ErrorId = "link-error";

  private string? Refusal => LinkExternalOutcome.Describe(Error);

  private bool _loaded;

  // The address the identity provider asserted, from the external cookie: the account the submit will actually link.
  // Before T149 it came from the query string, so a crafted link could show one address while another was linked.
  private string? _email;

  protected override async Task OnInitializedAsync()
  {
    var loginInfo = await SignInManager.GetExternalLoginInfoAsync();
    _email = loginInfo?.Principal.FindFirstValue(ClaimTypes.Email) ?? loginInfo?.Principal.FindFirstValue("email");
    _loaded = true;
  }
}

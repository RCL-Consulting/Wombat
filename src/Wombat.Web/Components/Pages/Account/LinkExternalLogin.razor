@page "/account/link-external"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@using System.Security.Claims
@using Wombat.Web.Security
@inject SignInManager<WombatIdentityUser> SignInManager

<PageTitle>Link your account - Wombat</PageTitle>

<div class="account-form-container shadow">
  <h2>Link your account</h2>

  @if (_loaded && _email is null)
  {
    <Alert Kind="danger">Your institutional sign-in has expired. Start again from the sign-in page.</Alert>
    <FormActions>
      <a href="/account/login" class="btn btn-primary">Back to sign in</a>
    </FormActions>
  }
  else
  {
    <p class="page-subtitle">
      A Wombat account with the email <strong>@_email</strong> already exists.
      Enter your current password to link your institutional sign-in.
    </p>

    @* A refused link reloads this page with its code in the query, and the page says it in words of its own, never the
       query's text (LinkExternalOutcome, T285). Focus goes straight to the password, so the password names the refusal:
       an alert already there when the page loads is not reliably announced (T193). *@
    @if (Refusal is not null)
    {
      <Alert Kind="danger" Id="@ErrorId">@Refusal</Alert>
    }

    <form method="post" action="/account/link-external/submit">
      <AntiforgeryToken />
      @* The account and the institutional login are read from the sign-in in progress, not from this form (T149). *@
      <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
      <div class="mb-3 password-wrapper">
        <label for="link-password">Password</label>
        <input id="link-password" class="form-control" type="password" name="Password" autocomplete="current-password" required autofocus aria-describedby="@ErrorReference" />
        <PasswordToggleButton For="link-password" />
      </div>
      <FormActions>
        <button type="submit" class="btn btn-primary">Link &amp; sign in</button>
        <a href="/account/login" class="btn btn-outline">Cancel</a>
      </FormActions>
    </form>
  }
</div>

@code {
  [SupplyParameterFromQuery(Name = "returnUrl")]
  public string? ReturnUrl { get; set; }

  /// <summary>The code of the refusal that sent the browser back here (<see cref="LinkExternalOutcome" />), never its words.</summary>
  [SupplyParameterFromQuery(Name = "error")]
  public string? Error { get; set; }

  private const string ErrorId = "link-error";

  private string? Refusal => LinkExternalOutcome.Describe(Error);

  private string? ErrorReference => Refusal is null ? null : ErrorId;

  private bool _loaded;

  // The address the identity provider asserted, from the external cookie: the account the submit will actually link.
  // Before T149 it came from the query string, so a crafted link could show one address while another was linked.
  private string? _email;

  protected override async Task OnInitializedAsync()
  {
    var loginInfo = await SignInManager.GetExternalLoginInfoAsync();
    _email = loginInfo?.Principal.FindFirstValue(ClaimTypes.Email) ?? loginInfo?.Principal.FindFirstValue("email");
    _loaded = true;
  }
}

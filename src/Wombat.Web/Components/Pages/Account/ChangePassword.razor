@page "/account/change-password"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using System.Security.Claims
@using Microsoft.Extensions.Options
@using Wombat.Web.Security
@inject IdentityErrorDescriber ErrorDescriber
@inject IOptions<IdentityOptions> IdentityOptions
@inject IScopedSender Sender
@inject ILogger<ChangePassword> Logger

@*
  Change password (T339, flow 02; R3-CP-*). The form posts to an endpoint (ChangePasswordOutcome.SubmitPath, Program.cs),
  as sign-in and register do, and never changes the password in a circuit (T265): changing a password changes the
  account's security stamp, which the sign-in cookie carries, so the endpoint issues the cookie again in the same request.
  A change goes to My account, which says "Password updated."; a refusal comes back here with a code for each reason; the
  fifth wrong current password signs the session out (E2).

  Static, in the shell ([ExcludeFromInteractiveRouting]; App.razor): nothing here needs a circuit now that the Show
  toggles are wombat.js's (PasswordField), and a static page is one full load, so what the endpoint sent back is on the
  page as it arrives. Until T339 it stayed interactive for its Show buttons, which toggled over JS interop. Reaching it
  from an interactive page is a full load, so with nothing to report the focus is at the top of the page.

  One column: the six rules under New password before anything is typed (C2), which the field names until a refusal is
  shown (A15); a refusal in the card above its action row, focused as the page loads, and the field it concerns marked,
  naming its own message and the refusal. The fields are always empty. An account that signs in only through its
  institution has no password to change, so it sees why, and the way back, in place of the form (C9): on the first visit,
  not only after a post the endpoint refused.
*@

<PageTitle>@(Refusal.Any ? "Error: Change password" : "Change password") · Wombat</PageTitle>

@if (_institutionalOnly)
{
  <PageHeader Title="Change password" />

  <div class="change-password">
    <Alert Kind="info" Role="status">@ChangePasswordOutcome.InstitutionalSignInMessage</Alert>
    <a class="btn btn-outline" href="@ProfileOutcome.PagePath">Back to My account</a>
  </div>
}
else
{
  <PageHeader Title="Change password" Subtitle="Choose a new password for signing in to Wombat." />

  <div class="change-password">
    <div class="form-container">
      @* data-submit-once (wombat.js): a second press while the post is on its way sends nothing. *@
      <form method="post" action="@ChangePasswordOutcome.SubmitPath" data-submit-once>
        <AntiforgeryToken />

        <PasswordField Label="Current password" Id="current-password" Name="CurrentPassword" Autocomplete="current-password"
                       Required="true" Invalid="@CurrentRefused" DescribedBy="@(CurrentRefused ? $"{CurrentMessageId} {RefusalId}" : null)">
          @if (CurrentRefused)
          {
            <div class="validation-message" id="@CurrentMessageId">@ErrorDescriber.PasswordMismatch().Description</div>
          }
        </PasswordField>

        <PasswordField Label="New password" Id="new-password" Name="NewPassword" Autocomplete="new-password" Required="true"
                       Invalid="@NewRefused" DescribedBy="@NewDescribedBy">
          @if (NewRefused)
          {
            <div class="validation-message" id="@NewMessageId">@PasswordRuleMessages.FieldMessage</div>
          }
          <PasswordRules Id="@RulesId" />
        </PasswordField>

        <PasswordField Label="Confirm new password" Id="confirm-password" Name="ConfirmPassword" Autocomplete="new-password"
                       Required="true" Invalid="@ConfirmRefused" DescribedBy="@(ConfirmRefused ? $"{ConfirmMessageId} {RefusalId}" : null)">
          @if (ConfirmRefused)
          {
            <div class="validation-message" id="@ConfirmMessageId">@ChangePasswordOutcome.ConfirmationMismatchMessage</div>
          }
        </PasswordField>

        @if (Refusal.Any)
        {
          <Alert Kind="danger" Id="@RefusalId" tabindex="-1" autofocus>
            @if (Refusal.Headline is not null)
            {
              <strong>@Refusal.Headline</strong>
            }
            @RefusalWords
            @if (Refusal.BrokenRules.Count > 0)
            {
              <ul class="password-rules-broken">
                @foreach (var rule in Refusal.BrokenRules)
                {
                  <li>@rule</li>
                }
              </ul>
            }
          </Alert>
        }

        <FormActions>
          <a class="btn btn-outline" href="@ProfileOutcome.PagePath">Cancel</a>
          <button type="submit" class="btn btn-primary">Change password</button>
        </FormActions>
      </form>
    </div>
  </div>
}

@code {
  /// <summary>The refusal's id, which the field it concerns names.</summary>
  public const string RefusalId = "change-password-error";

  /// <summary>The six rules' id, which New password names until a refusal is shown.</summary>
  public const string RulesId = "new-password-rules";

  private const string CurrentMessageId = "current-password-message";
  private const string NewMessageId = "new-password-message";
  private const string ConfirmMessageId = "confirm-password-message";

  /// <summary>The endpoint's refusal codes, when it refused.</summary>
  [SupplyParameterFromQuery(Name = "error")]
  public string[]? Error { get; set; }

  /// <summary>How long a lock the account had already has left, in whole minutes (ChangePasswordOutcome.AccountLocked).</summary>
  [SupplyParameterFromQuery(Name = ChangePasswordOutcome.MinutesParameter)]
  public string? Minutes { get; set; }

  [CascadingParameter]
  private Task<AuthenticationState>? AuthenticationState { get; set; }

  private PasswordRefusal Refusal { get; set; } = PasswordRefusal.None;

  private bool _institutionalOnly;

  private bool CurrentRefused => Sent(nameof(IdentityErrorDescriber.PasswordMismatch));

  private bool ConfirmRefused => Sent(ChangePasswordOutcome.ConfirmationMismatch);

  private bool NewRefused => Refusal.BrokenRules.Count > 0;

  // The rules until a refusal is shown (A15): then the field names its own message, when a rule was broken, and the
  // refusal, which lists the rules broken; the list under it says them all again.
  private string? NewDescribedBy => !Refusal.Any
    ? RulesId
    : NewRefused ? $"{NewMessageId} {RefusalId}" : null;

  protected override async Task OnInitializedAsync()
  {
    var codes = Error ?? [];
    Refusal = ChangePasswordOutcome.Refusal(codes, ErrorDescriber, IdentityOptions.Value.Password,
      ChangePasswordOutcome.LockedFor(Minutes, IdentityOptions.Value.Lockout.DefaultLockoutTimeSpan));

    // The endpoint's own refusal for an account with no password, or the account as it is now: either way, no form.
    _institutionalOnly = codes.Contains(ChangePasswordOutcome.InstitutionalSignIn, StringComparer.Ordinal)
                         || !await HasLocalPasswordAsync();
    if (_institutionalOnly)
    {
      Refusal = PasswordRefusal.None;
    }
  }

  /// <summary>
  /// Whether the account has a password of its own, read as My account reads it. A fault reads as yes, so the form is
  /// offered, and the endpoint, which checks the account itself, refuses a change it cannot make.
  /// </summary>
  private async Task<bool> HasLocalPasswordAsync()
  {
    var user = AuthenticationState is null ? null : (await AuthenticationState).User;
    if (user?.FindFirstValue(ClaimTypes.NameIdentifier) is null)
    {
      return true;
    }

    try
    {
      return (await Sender.Send(new GetCurrentUserProfileQuery(user))).HasLocalPassword;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogError(exception, "Change password could not read whether the account has a password.");
      return true;
    }
  }

  private bool Sent(string code) => Error?.Contains(code, StringComparer.Ordinal) == true;

  // What follows the headline, a space after it (Razor drops whitespace between elements): the reasons, then the rules'
  // heading when a rule was broken, whose list follows.
  private string RefusalWords
    => (Refusal.Headline is null ? string.Empty : " ")
       + string.Join(" ", Refusal.Sentences.Concat(Refusal.BrokenRules.Count > 0 ? [PasswordRuleMessages.Heading] : Array.Empty<string>()));
}

@page "/account/change-password"
@attribute [Authorize]
@using Microsoft.Extensions.Options
@using Wombat.Web.Security
@inject IdentityErrorDescriber ErrorDescriber
@inject IOptions<IdentityOptions> IdentityOptions

@*
  The form posts to an endpoint (ChangePasswordOutcome.SubmitPath, Program.cs), as sign-in and register do, and never
  changes the password in this page's circuit (T265). Changing a password changes the account's security stamp, which
  the sign-in cookie carries, so the endpoint issues the cookie again in the same request, then sends the browser back
  here with what happened: ?status=updated, or ?error= and a code for each refusal. Until T265 the circuit changed the
  password and then threw "Headers are read-only" as it tried to write the cookie, and the page crashed.

  The page itself stays interactive, so each field's Show button works. The form is the browser's own post, which the
  circuit leaves alone.
*@

<PageTitle>@(Refusals.Count > 0 ? "Error: Change password" : "Change password")</PageTitle>

<PageHeader Title="Change password" Subtitle="Update the password for the current account." />

@* What Change password did. It arrives with the page the endpoint sends the browser back to, so it takes the focus as
   the page loads (FocusOnLoad; DESIGN.md § Button system): an alert already on the page when it loads is not reliably
   announced, and the fields are empty again. *@
<ActionResult FocusOnLoad="@(IsUpdated || Refusals.Count > 0)">
  @if (Refusals.Count > 0)
  {
    <Alert Kind="danger" Id="@RefusalId">@string.Join(" ", Refusals)</Alert>
  }
  else if (IsUpdated)
  {
    <Alert Kind="success">Password updated.</Alert>
  }
</ActionResult>

<div class="form-container">
  @* data-submit-once (wombat.js): a second press while the post is on its way sends nothing. *@
  <form method="post" action="@ChangePasswordOutcome.SubmitPath" data-submit-once>
    <AntiforgeryToken />

    <div class="form-grid">
      <div class="form-group">
        <label for="current-password">Current password</label>
        <div class="password-wrapper">
          <input id="current-password" name="CurrentPassword" class="form-control" type="password"
                 autocomplete="current-password" required aria-describedby="@RefusalReference" />
          <PasswordToggleButton For="current-password" />
        </div>
      </div>

      <div class="form-group">
        <label for="new-password">New password</label>
        <div class="password-wrapper">
          <input id="new-password" name="NewPassword" class="form-control" type="password"
                 autocomplete="new-password" required aria-describedby="@RefusalReference" />
          <PasswordToggleButton For="new-password" />
        </div>
      </div>

      <div class="form-group">
        <label for="confirm-password">Confirm password</label>
        <div class="password-wrapper">
          <input id="confirm-password" name="ConfirmPassword" class="form-control" type="password"
                 autocomplete="new-password" required aria-describedby="@RefusalReference" />
          <PasswordToggleButton For="confirm-password" />
        </div>
      </div>
    </div>

    <FormActions>
      <a class="btn btn-outline" href="/account/profile">Cancel</a>
      <button type="submit" class="btn btn-primary">Change password</button>
    </FormActions>
  </form>
</div>

@code {
  /// <summary>The refusal's id, which each field names, so a refusal is read with the field it sends the user back to.</summary>
  public const string RefusalId = "change-password-error";

  /// <summary><see cref="ChangePasswordOutcome.Updated" /> once the endpoint has changed the password.</summary>
  [SupplyParameterFromQuery(Name = "status")]
  public string? Status { get; set; }

  /// <summary>The endpoint's refusal codes, when it refused.</summary>
  [SupplyParameterFromQuery(Name = "error")]
  public string[]? Error { get; set; }

  private IReadOnlyList<string> Refusals { get; set; } = [];

  private bool IsUpdated => string.Equals(Status, ChangePasswordOutcome.Updated, StringComparison.Ordinal);

  private string? RefusalReference => Refusals.Count > 0 ? RefusalId : null;

  protected override void OnParametersSet()
    => Refusals = ChangePasswordOutcome.Describe(Error, ErrorDescriber, IdentityOptions.Value.Password);
}

@page "/account/login"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@using Microsoft.Extensions.Options
@using Wombat.Application.Common.Options
@using Wombat.Web.Security
@inject IOptions<SsoOptions> SsoOptions

<PageTitle>Sign in · Wombat</PageTitle>

<div class="account-form-container shadow">
  <div class="account-brand">
    <img class="account-brand-mark" src="/brand/wombat-mark.svg" alt="" width="44" height="44" />
    <span class="account-brand-text">Wombat</span>
  </div>
  <h2>Sign in</h2>

  @* A refusal reloads this page with its code in the query, and the page says it in words of its own, never the query's
     text, so a crafted link cannot put words on the page (SignInOutcome, T285). An alert already there when the page
     loads is not reliably announced, and focus goes straight to the email, so both fields name it: it is read with the
     field (T193). *@
  @if (Refusal is not null)
  {
    <Alert Kind="danger" Id="@ErrorId">@Refusal</Alert>
  }

  <form method="post" action="/account/login/submit">
    <AntiforgeryToken />
    <div class="mb-3">
      <label for="login-email">Email</label>
      <input id="login-email" class="form-control" type="email" name="Email" autocomplete="username" required autofocus aria-describedby="@ErrorReference" />
    </div>
    <div class="mb-3 password-wrapper">
      <label for="login-password">Password</label>
      <input id="login-password" class="form-control" type="password" name="Password" autocomplete="current-password" required aria-describedby="@ErrorReference" />
      <PasswordToggleButton For="login-password" />
    </div>
    <div class="form-check mb-3">
      <input id="login-remember" class="form-check-input" type="checkbox" name="RememberMe" value="true" />
      <label for="login-remember">Remember me</label>
    </div>
    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
    <FormActions>
      <button type="submit" class="btn btn-primary">Sign in</button>
    </FormActions>
  </form>

  @if (SsoProviders.Count > 0)
  {
    <div class="sso-divider">
      <span>or</span>
    </div>

    <div class="sso-providers">
      @foreach (var provider in SsoProviders)
      {
        <a href="/account/sso-challenge/@provider.Key?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")"
           class="btn btn-outline sso-button">
          Sign in with @provider.DisplayName
        </a>
      }
    </div>
  }

  <p class="page-subtitle mt-3">Forgotten your password? <a href="/account/forgot-password">Reset it</a>.</p>
</div>

@code {
  [SupplyParameterFromQuery(Name = "returnUrl")]
  public string? ReturnUrl { get; set; }

  /// <summary>The code of the refusal that sent the browser here (<see cref="SignInOutcome" />), never its words.</summary>
  [SupplyParameterFromQuery(Name = "error")]
  public string? Error { get; set; }

  private const string ErrorId = "login-error";

  private string? Refusal => SignInOutcome.Describe(Error, institutionalSignInOffered: SsoProviders.Count > 0);

  private string? ErrorReference => Refusal is null ? null : ErrorId;

  private IReadOnlyList<SsoProviderOptions> SsoProviders => SsoOptions.Value.Providers;
}

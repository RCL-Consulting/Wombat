@page "/account/forgot-password"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@using Microsoft.Extensions.Options
@using Wombat.Application.Common.Options
@using Wombat.Web.Security
@inject IOptions<SsoOptions> SsoOptions

@*
  Forgotten password (T339, flow 02; R3-FG, R3-FG-390; Q2 A). Wombat sends no reset email: an administrator sets a new
  password and gives it to the person themselves. So the page says who to ask and what to do next, with no field. Worded
  for an account with an institution and one without (C4): "your institution" only inside a condition. The line about
  an institution's own sign-in shows only where the sign-in page offers one.
*@

<PageTitle>Forgotten password · Wombat</PageTitle>

<div class="account-form-container">
  <h1>Forgotten password</h1>
  <p>A Wombat administrator can set a new password for you.</p>
  <ol class="account-steps">
    <li>
      Ask your Wombat administrator for a new password: the one at your institution or, if your account belongs to no
      institution, the platform's administrator. They give it to you themselves; Wombat does not email it.
    </li>
    <li>Sign in with it.</li>
    <li>Choose your own password on My account, under Change password.</li>
  </ol>
  @if (SsoOptions.Value.Providers.Count > 0)
  {
    <p class="account-note">
      If your institution signs you in, use its button on the sign-in page. Your institution resets that password, not
      Wombat.
    </p>
  }
  <FormActions>
    <a class="btn btn-outline" href="@SignInOutcome.PagePath"><Icon Name="arrow-left" />Back to sign in</a>
  </FormActions>
</div>

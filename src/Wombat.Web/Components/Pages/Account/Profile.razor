@page "/account/profile"
@attribute [Authorize]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Profile</PageTitle>

<PageHeader Title="My account" Subtitle="Update your name and review your assigned roles." />

@* What Save profile did. It takes the focus once the save is done (T234; DESIGN.md § Button system). A refusal leaves
   the focus on the button: it is an alert, read at once. *@
<ActionResult @ref="_result">
  @if (!string.IsNullOrWhiteSpace(_actionError))
  {
    <Alert Kind="danger">@_actionError</Alert>
  }

  @if (!string.IsNullOrWhiteSpace(_statusMessage))
  {
    <Alert Kind="success">@_statusMessage</Alert>
  }
</ActionResult>

<StatePanel IsLoading="_loading" LoadError="@_loadError" IsEmpty="@(_model is null)" EmptyTitle="Profile unavailable" EmptyBody="The current account profile could not be loaded.">
  @if (_model is not null)
  {
    <div class="details-grid">
      <aside class="detail-card">
        <h3>Account summary</h3>
        <p><strong>Email:</strong> @_model.Email</p>
        <p><strong>Roles:</strong> @string.Join(", ", _model.Roles)</p>
        <div class="actions-cell">
          <a class="btn btn-outline btn-sm" href="/account/change-password">Change password</a>
        </div>
      </aside>

      <section class="detail-card">
        <h3>Profile details</h3>
        <EditForm EditContext="_editContext" FormName="account-profile">
          <DataAnnotationsValidator />
          <ValidationSummary class="validation-summary-errors" />

          <div class="form-grid">
            <FormField Label="Email" InputId="profile-email">
              <InputText id="profile-email" class="form-control" @bind-Value="_model.Email" disabled />
            </FormField>

            <FormField Label="First name" InputId="profile-first-name" Required="true">
              <InputText id="profile-first-name" class="form-control" @bind-Value="_model.FirstName" />
              <ValidationMessage For="() => _model.FirstName" />
            </FormField>

            <FormField Label="Last name" InputId="profile-last-name" Required="true">
              <InputText id="profile-last-name" class="form-control" @bind-Value="_model.LastName" />
              <ValidationMessage For="() => _model.LastName" />
            </FormField>
          </div>

          <FormActions>
            @* Not disabled while its save runs (T234): it has the focus, and a browser drops the focus of a button it
               disables, to the page. A second press sends nothing. *@
            <button type="button" class="btn btn-primary" aria-disabled="@InFlight.AriaDisabled(_saving)" @onclick="SaveValidatedAsync">@(_saving ? "Saving..." : "Save profile")</button>
          </FormActions>
        </EditForm>
      </section>
    </div>
  }
</StatePanel>

@code {
  private ProfileFormModel? _model;
  private EditContext? _editContext;
  private bool _loading = true;
  private bool _saving;
  private ActionResult? _result;
  private string? _loadError;
  private string? _actionError;
  private string? _statusMessage;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var profile = await Sender.Send(new GetCurrentUserProfileQuery(await GetCurrentUserAsync()));

      _model = new ProfileFormModel
      {
        Email = profile.Email,
        FirstName = profile.FirstName,
        LastName = profile.LastName,
        Roles = profile.Roles
      };

      _editContext = new EditContext(_model);
    }
    catch (Exception exception)
    {
      _loadError = exception.Message;
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task SaveValidatedAsync()
  {
    if (_saving || _editContext is null || !_editContext.Validate())
    {
      return;
    }

    await SaveAsync();
  }

  private async Task SaveAsync()
  {
    if (_model is null)
    {
      return;
    }

    _saving = true;
    _actionError = null;
    _statusMessage = null;

    try
    {
      var profile = await Sender.Send(new UpdateCurrentUserProfileCommand(
        await GetCurrentUserAsync(),
        _model.FirstName,
        _model.LastName));

      _model.FirstName = profile.FirstName;
      _model.LastName = profile.LastName;
      _statusMessage = "Profile saved.";
      _result?.FocusAfterRender();
    }
    catch (Exception exception)
    {
      _actionError = exception.Message;
    }
    finally
    {
      _saving = false;
    }
  }

  // The signed-in user, whose own account this page shows and renames: the handlers read the id from it (T185).
  private async Task<System.Security.Claims.ClaimsPrincipal> GetCurrentUserAsync()
    => (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

  private sealed class ProfileFormModel
  {
    public string Email { get; set; } = string.Empty;

    [Required]
    [MaxLength(100)]
    public string FirstName { get; set; } = string.Empty;

    [Required]
    [MaxLength(100)]
    public string LastName { get; set; } = string.Empty;

    public IReadOnlyCollection<string> Roles { get; set; } = [];
  }
}

@page "/account/register"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@using Microsoft.Extensions.Options
@using Wombat.Web.Security
@inject IScopedSender Sender
@inject IJSRuntime JS
@inject IdentityErrorDescriber ErrorDescriber
@inject IOptions<IdentityOptions> IdentityOptions
@inject ILogger<Register> Logger

<PageTitle>Complete registration · Wombat</PageTitle>

<div class="account-form-container shadow">
  <h2>Complete registration</h2>

  @if (_loading)
  {
    <Skeleton Count="4" Height="2.75rem" />
  }
  else if (_unavailable is not null)
  {
    @* The invitation cannot be used, so there is no form: no token, or the preview refused it. *@
    <Alert Kind="danger">@_unavailable</Alert>
  }
  else if (_preview is not null)
  {
    <Alert Kind="info">Registering @_preview.Email as @_preview.TargetRole.</Alert>

    @* A refused registration reloads this page with a code for each refusal, and the page says each in words of its own,
       never the query's text (RegisterOutcome, T285). The form is offered only while the preview finds the invitation
       usable, and the preview refuses what no input can put right: an invitation revoked, used, expired or unknown, and an
       address no account can be created for, one an account already holds included. So a refusal under the form is the
       person's to put right. The first field takes the focus, and every field names the refusal, which an alert already
       there when the page loads is not reliably announced (T193). *@
    @if (_refusals.Count > 0)
    {
      <Alert Kind="danger" Id="@RefusalId">@string.Join(" ", _refusals)</Alert>
    }

    <form method="post" action="@RegisterOutcome.SubmitPath">
      <AntiforgeryToken />
      <div class="mb-3">
        <label for="register-email">Email</label>
        <input id="register-email" class="form-control" type="email" value="@_preview.Email" autocomplete="username" disabled />
      </div>

      <div class="mb-3">
        <label for="register-first-name">First name</label>
        <input id="register-first-name" class="form-control" type="text" name="FirstName" required maxlength="100"
               autofocus="@(_refusals.Count > 0)" aria-describedby="@RefusalReference" />
      </div>

      <div class="mb-3">
        <label for="register-last-name">Last name</label>
        <input id="register-last-name" class="form-control" type="text" name="LastName" required maxlength="100"
               aria-describedby="@RefusalReference" />
      </div>

      <div class="mb-3 password-wrapper">
        <label for="register-password">Password</label>
        <input id="register-password" class="form-control" type="password" name="Password" autocomplete="new-password" required
               aria-describedby="@RefusalReference" />
        <PasswordToggleButton For="register-password" />
      </div>

      <div class="mb-3 password-wrapper">
        <label for="register-confirm-password">Confirm password</label>
        <input id="register-confirm-password" class="form-control" type="password" name="ConfirmPassword" autocomplete="new-password" required
               aria-describedby="@RefusalReference" />
        <PasswordToggleButton For="register-confirm-password" />
      </div>

      <input type="hidden" name="Token" value="@_token" />
      <FormActions>
        <button type="submit" class="btn btn-primary">Register</button>
      </FormActions>
    </form>
  }
</div>

@code {
  /// <summary>The refusal's id, which each field names, so the refusal is read with the field that has the focus.</summary>
  public const string RefusalId = "register-error";

  [SupplyParameterFromQuery(Name = "token")]
  public string? Token { get; set; }

  /// <summary>The codes of the refusals that sent the browser back here (<see cref="RegisterOutcome" />), never their words.</summary>
  [SupplyParameterFromQuery(Name = "error")]
  public string[]? Error { get; set; }

  private InvitationPreviewDto? _preview;
  private string? _token;
  private string? _unavailable;
  private IReadOnlyList<string> _refusals = [];
  private bool _loading = true;
  private bool _urlCleaned;

  private string? RefusalReference => _refusals.Count > 0 ? RefusalId : null;

  protected override async Task OnParametersSetAsync()
  {
    _loading = true;
    _unavailable = null;
    _preview = null;
    _token = Token;
    _refusals = RegisterOutcome.Describe(Error, ErrorDescriber, IdentityOptions.Value.Password);

    if (string.IsNullOrWhiteSpace(_token))
    {
      _unavailable = RegisterOutcome.TokenMissingMessage;
      _loading = false;
      return;
    }

    try
    {
      _preview = await Sender.Send(new GetInvitationPreviewQuery(_token));
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      // A refused invitation (revoked, used, expired, not recognised) is said in the page's words; anything else is a
      // fault, logged, and never shown in its own (T285).
      if (!RegisterOutcome.IsRefusal(exception))
      {
        Logger.LogError(exception, "An invitation could not be previewed.");
      }

      _unavailable = string.Join(" ", RegisterOutcome.Describe(
        RegisterOutcome.CodesFor(exception), ErrorDescriber, IdentityOptions.Value.Password));
    }
    finally
    {
      _loading = false;
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_urlCleaned || string.IsNullOrWhiteSpace(_token))
    {
      return;
    }

    _urlCleaned = true;
    await JS.InvokeVoidAsync("wombat.clearInvitationTokenFromUrl");
  }
}

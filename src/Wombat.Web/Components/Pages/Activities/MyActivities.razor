@page "/activities/mine"
@attribute [Authorize]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My activities · Wombat</PageTitle>

<PageHeader Title="My activities" Subtitle="Activities created for the current user.">
  <Actions>
    <a class="btn btn-primary" href="/activities/new">Log an activity</a>
  </Actions>
</PageHeader>

@{ var rowNames = ActivityRowNames.For(_items, withSubject: false); }
<StatePanel IsLoading="_loading" LoadError="@_error" IsEmpty="@(!_loading && _items.Count == 0)" EmptyTitle="No activities yet" EmptyBody="Create the first activity from the activity catalogue.">
  <DataTable Items="_items">
    <HeaderRow>
      @* T137. The EPA and the encounter date are what tell one activity from its siblings: a released MSF campaign
         records one row per EPA, all of one type, one state and one date. The credit column is T106 item 14, so a
         registrar can see across the whole list which completions counted. *@
      <tr>
        <th>Type</th>
        <th>EPA</th>
        <th>Encounter date</th>
        <th>State</th>
        <th>Credited</th>
        <th><span class="visually-hidden">Actions</span></th>
      </tr>
    </HeaderRow>
    <Row Context="item">
      <tr>
        <td>@item.ActivityTypeName</td>
        <td><ActivityEpaLabel Code="@item.EpaCode" Title="@item.EpaTitle" InForce="@item.EpaInForce" /></td>
        <td><EncounterDateLabel ObservedOn="@item.ObservedOn" Declared="@item.ObservedOnDeclared" /></td>
        <td>@item.CurrentStateLabel</td>
        <td>@CreditOutcome.Label(item.CreditedItemCount)</td>
        <td>
          @* T239: named by its row, "View Mini-CEX, PAED-003, encounter date 2026-09-01". *@
          <div class="actions-cell">
            <a class="btn btn-outline btn-sm" href="@($"/activities/{item.Id}")" aria-label="@($"View {rowNames[item.Id]}")">View</a>
          </div>
        </td>
      </tr>
    </Row>
  </DataTable>
</StatePanel>

@code {
  private readonly List<ActivitySummaryDto> _items = [];
  private bool _loading = true;
  private string? _error;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        ?? throw new InvalidOperationException("The current user identifier is missing.");
      _items.AddRange(await Sender.Send(new Wombat.Application.Features.Activities.Queries.ListActivitiesBySubject.ListActivitiesBySubjectQuery(userId, authState.User)));
    }
    catch (Exception exception)
    {
      _error = exception.Message;
    }
    finally
    {
      _loading = false;
    }
  }
}

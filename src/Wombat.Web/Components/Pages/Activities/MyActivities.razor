@page "/activities/mine"
@attribute [Authorize]
@using Wombat.Application.Features.Activities.Queries.ListActivitiesBySubject
@using Wombat.Application.Features.Activities.Queries.ListNeedsYou
@using Wombat.Web.Components.Shared.Progress
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<MyActivities> Logger

<PageTitle>My activities · Wombat</PageTitle>

@* T342, flow 03 (R3-C-Mine): Needs you first when there is any, then every activity a page at a time. The subtitle is the
   list's order: ListActivitiesBySubjectQuery orders by the encounter date, newest first. *@
<PageHeader Title="My activities" Subtitle="Everything you have filed or logged, newest encounter first.">
  <Actions>
    <a class="btn btn-primary home-action" href="/activities/new">Log an activity</a>
  </Actions>
</PageHeader>

<StatePanel IsLoading="_loading"
            LoadError="@_error"
            OnRetry="LoadAsync"
            FocusAfterRetry="FocusContentAsync"
            IsEmpty="@(_page is { TotalCount: 0 } && _needsYou.Count == 0)"
            EmptyTitle="No activities yet"
            EmptyBody="Log an activity to ask an assessor to rate an encounter, or to log a teaching session.">
  <EmptyActions>
    <a class="btn btn-outline" href="/activities/new">Log an activity</a>
  </EmptyActions>
  <ChildContent>
    @if (_needsYou.Count > 0)
    {
      <section class="detail-card list-section" aria-labelledby="needs-you-heading">
        @* The count is a badge to the eye and words to a screen reader, "2 items", not a bare figure (A16). *@
        <h2 id="needs-you-heading" class="list-section-title" tabindex="-1" @ref="_needsYouHeading">
          Needs you <span class="badge @BadgeFor.State(BadgeState.Submitted)" aria-hidden="true">@_needsYou.Count</span><span class="visually-hidden">, @ActivityListWords.ItemCount(_needsYou.Count)</span>
        </h2>
        <p class="needs-you-rule">Your drafts, and work returned to you. A request you can still cancel is with its assessor, so it is not here: it is under All activities.</p>
        <NeedsYouList Items="_needsYou" Names="_names" />
      </section>
    }
    @if (_page is { TotalCount: > 0 } list)
    {
      <section class="list-section" aria-labelledby="all-activities-heading">
        <h2 id="all-activities-heading" class="list-section-title" tabindex="-1" @ref="_allHeading">All activities (@list.TotalCount)</h2>
        @* A8: stacked below 641px. The Activity cell's link and the State cell's badge say what they are; the other two
           cells are labelled by their column there (data-label), a label the screen reader, which has the header, skips. *@
        <DataTable Items="list.Items" Stack="true">
          <HeaderRow>
            <tr role="row">
              <th scope="col" role="columnheader">Activity</th>
              <th scope="col" role="columnheader">Who has it now</th>
              <th scope="col" role="columnheader">State</th>
              <th scope="col" role="columnheader">Credit</th>
            </tr>
          </HeaderRow>
          <Row Context="item">
            <tr role="row">
              <td role="cell">
                <ActivityLink Item="item" Name="@NameOf(item)" />
                @* T231: an EPA not in force now is marked, in the picker's own words. The name carries only its code. *@
                @if (item.EpaInForce == false && !string.IsNullOrWhiteSpace(item.EpaCode))
                {
                  <div class="muted text-sm">@item.EpaCode @EpaOptionLabel.NoLongerInUse</div>
                }
              </td>
              <td role="cell" data-label="Who has it now">@ActivityListWords.WhoHasIt(item)</td>
              <td role="cell"><span class="badge @BadgeFor.ActivityState(item.CurrentState, item.Holder?.Kind == ActivityHolderKind.Done)">@item.CurrentStateLabel</span></td>
              @* T106 item 14 (T108's three values): what each completion credited. Where it credited an EPA, the words are a
                 link to that EPA's page under My progress, named for where it lands (T355, C7; Q7); "—" (MSF) and "None"
                 stay text. So does a credit to an EPA whose page does not open, an item of no curriculum she now holds
                 (a version move, a removed item), which would land on "Page not found" (T355, build review G4). *@
              <td role="cell" data-label="Credit">
                @if (item is { CreditedItemCount: > 0, EpaPageOpens: true, EpaId: int epaId, EpaCode: { Length: > 0 } epaCode })
                {
                  var label = CreditOutcome.Label(item.CreditedItemCount);
                  <a class="credit-link" href="@ProgressLinks.Epa(epaId)" aria-label="@ProgressLinks.CreditTo(label, epaCode)">@label</a>
                }
                else
                {
                  @CreditOutcome.Label(item.CreditedItemCount)
                }
              </td>
            </tr>
          </Row>
        </DataTable>
        <PagerControls Page="list.Page" PageSize="list.PageSize" TotalCount="list.TotalCount" OnPageChanged="GoToPageAsync" OnPageSizeChanged="ChangePageSizeAsync" />
      </section>
    }
  </ChildContent>
</StatePanel>

@code {
  /// <summary>
  /// The load failure's words (R3-Spec § 1, Load error): never the exception's text, which for a database failure is EF's
  /// own (T272; the page printed it until T342).
  /// </summary>
  public const string LoadFailed = "Could not load your activities. Nothing has changed. Try again, or come back in a few minutes.";

  private IReadOnlyList<ActivitySummaryDto> _needsYou = [];
  private ActivityListPageDto? _page;
  private IReadOnlyDictionary<int, string> _names = new Dictionary<int, string>();
  private int _pageSize = ListActivitiesBySubjectQuery.DefaultPageSize;
  private bool _loading = true;
  private string? _error;
  private bool _focusAllAfterRender;
  private ElementReference _needsYouHeading;
  private ElementReference _allHeading;

  protected override Task OnInitializedAsync() => LoadAsync();

  /// <summary>Reads Needs you and the first page; Try again reads both again.</summary>
  private async Task LoadAsync()
  {
    _loading = true;
    _error = null;
    try
    {
      var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
      _needsYou = await Sender.Send(new ListNeedsYouQuery(user));
      await ReadPageAsync(user, 1);
    }
    catch (Exception exception)
    {
      Logger.LogError(exception, "My activities could not be read.");
      _error = LoadFailed;
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task ReadPageAsync(System.Security.Claims.ClaimsPrincipal user, int page)
  {
    var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
      ?? throw new InvalidOperationException("The current user identifier is missing.");
    _page = await Sender.Send(new ListActivitiesBySubjectQuery(userId, user, page, _pageSize));
    // One name per link over both lists, so an activity in Needs you reads the same in All activities (T280).
    _names = ActivityRowNames.Links(_needsYou.Concat(_page.Items));
  }

  private async Task GoToPageAsync(int page)
  {
    try
    {
      var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
      await ReadPageAsync(user, page);
      // The pager's button may now be disabled or gone from under the focus: the list's heading takes it, and says
      // which list it is.
      _focusAllAfterRender = true;
    }
    catch (Exception exception)
    {
      Logger.LogError(exception, "A page of My activities could not be read.");
      _error = LoadFailed;
    }
  }

  private Task ChangePageSizeAsync(int pageSize)
  {
    _pageSize = pageSize;
    return GoToPageAsync(1);
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusAllAfterRender && _page is { TotalCount: > 0 })
    {
      _focusAllAfterRender = false;
      await _allHeading.FocusAsync();
    }
  }

  /// <summary>After a Try again that read: the first list's heading.</summary>
  private async ValueTask FocusContentAsync()
  {
    if (_needsYou.Count > 0)
    {
      await _needsYouHeading.FocusAsync();
    }
    else if (_page is { TotalCount: > 0 })
    {
      await _allHeading.FocusAsync();
    }
  }

  private string? NameOf(ActivitySummaryDto item) => _names.TryGetValue(item.Id, out var name) ? name : null;
}

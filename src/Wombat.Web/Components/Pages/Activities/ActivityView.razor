@page "/activities/{ActivityId:int}"
@attribute [Authorize]
@using System.Security.Claims
@using Wombat.Application.Features.Activities.Commands.TransitionActivity
@using Wombat.Application.Features.Activities.Queries.GetActivityById
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Activity</PageTitle>

@if (_activity is not null)
{
  <PageHeader Title="@_activity.ActivityTypeName" Subtitle="@($"State: {_activity.CurrentState}")" />
}

@if (!string.IsNullOrWhiteSpace(_actionError))
{
  <Alert Kind="danger">@_actionError</Alert>
}

@if (CreditedNothing)
{
  @* T108. A completed activity that matched no curriculum item used to be indistinguishable from a
     credited one at every surface in the product. This is the one place a clinician is certain to
     look. It cannot fire on an activity type that credits nothing by design: the server only
     records a count at all when the pinned version declares a non-empty `counts_for`. *@
  <Alert Kind="warning">
    This activity is complete, but it counted towards no curriculum requirement. The EPA it was
    recorded against is most likely not part of this trainee's curriculum. The record is kept —
    please raise it with the programme administrator so it can be credited correctly.
  </Alert>
}

@if (CreditedAcrossScales)
{
  @* T109. The encounter counted towards the required volume, but the supervision level could not be
     compared: the rating is on one entrustment ladder and the curriculum requirement is on another,
     where the same number means a different amount of supervision. Refusing the comparison is the
     safe answer, and saying so is the honest one — an unexplained shortfall on the progress page is
     how a registrar reaches the end of a year believing a requirement was met. *@
  <Alert Kind="warning">
    This activity counted towards the required number of observations, but not towards the
    supervision level. The rating was recorded on a different entrustment scale from the one this
    trainee's curriculum requirement uses, so the two levels are not comparable. Please raise it with
    the programme administrator: the curriculum item's scale may need to be corrected.
  </Alert>
}

<StatePanel IsLoading="_loading" LoadError="@_loadError" IsEmpty="@(!_loading && _activity is null)" EmptyTitle="Activity unavailable" EmptyBody="The requested activity could not be loaded.">
  @if (_activity is not null)
  {
    <div class="details-grid">
      <aside class="detail-card">
        <h3>Summary</h3>
        <p><strong>Type:</strong> @_activity.ActivityTypeName</p>
        <p><strong>State:</strong> @_activity.CurrentState</p>
        <p><strong>Version:</strong> @_activity.SchemaVersion</p>
        <ActivityWorkflowActions Actions="_actions" OnTransitionRequested="HandleTransitionAsync" />
      </aside>

      <section class="detail-card">
        <h3>Activity details</h3>

        @if (_editable.Count == 0 || _actions.Count == 0)
        {
          @* Read-only when no field is writable by this actor in this state (a non-bound user, or a
             finished activity) AND when there is nothing to submit with. A transition is the only
             save channel there is, so offering inputs with no action available would let someone
             type a reflection and lose it on navigation. Restore the editable branch here if a
             standalone save command ever lands (T106 item 1). *@
          <ActivityDetail SchemaJson="@_activity.SchemaJson"
                          DataJson="@_activity.DataJson"
                          SubjectUserId="@_activity.SubjectUserId"
                          CreditRulesJson="@_activity.CreditRulesJson"
                          WbaToolKey="@_activity.WbaToolKey" />
        }
        else
        {
          <Alert Kind="info">
            You can fill in the fields that are enabled below. Your entries are submitted together
            with the action you choose — nothing is stored until then.
          </Alert>

          @* SubjectUserId, not the principal: the actor here is usually the assessor, and the EPAs
             that can be credited are the subject's (T108). *@
          <ActivityForm SchemaJson="@_activity.SchemaJson"
                        DataJson="@_workingDataJson"
                        SubjectUserId="@_activity.SubjectUserId"
                        CreditRulesJson="@_activity.CreditRulesJson"
                        WbaToolKey="@_activity.WbaToolKey"
                        EditableFieldKeys="_editable"
                        DataJsonChanged="OnDataChanged" />

          <FormActions>
            <button id="discard-changes" type="button" class="btn btn-outline" disabled="@(!_hasPendingChanges)" @onclick="DiscardChanges">
              Discard changes
            </button>
          </FormActions>
        }
      </section>
    </div>

    <section class="detail-card mt-3">
      <h3>History</h3>
      <DataTable TItem="ActivityTransitionDto" Items="_activity.Transitions" Caption="Workflow history">
        <HeaderRow>
          <tr>
            <th>Action</th>
            <th>State</th>
            <th>Actor</th>
            <th>When</th>
            <th>Credit</th>
            <th>Note</th>
          </tr>
        </HeaderRow>
        <Row Context="transition">
          <tr>
            <td>@transition.TransitionKey</td>
            <td>@($"{transition.FromState} → {transition.ToState}")</td>
            <td>@transition.ActorUserId</td>
            <td>@transition.OccurredOn.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>@CreditLabel(transition.CreditedItemCount)</td>
            <td>@(string.IsNullOrWhiteSpace(transition.Note) ? "—" : transition.Note)</td>
          </tr>
        </Row>
        <Empty>
          <div class="detail-card detail-card--empty-compact">No workflow actions have been recorded yet.</div>
        </Empty>
      </DataTable>
    </section>
  }
</StatePanel>

@code {
  [Parameter] public int ActivityId { get; set; }

  private ActivityDto? _activity;
  private IReadOnlyList<ActivityActionDto> _actions = [];

  // The field keys this actor may write right now, as the server resolved them (T070). Empty means
  // the page stays read-only. A set rather than the DTO's list because ActivityForm and
  // ActivityDataPatch both do a Contains per field.
  private IReadOnlySet<string> _editable = new HashSet<string>(StringComparer.Ordinal);

  // The form's working copy. It diverges from _activity.DataJson while the actor types and is
  // reconciled with the server on every successful load.
  private string _workingDataJson = "{}";
  private bool _hasPendingChanges;

  private bool _loading = true;
  private string? _loadError;
  private string? _actionError;

  /// <summary>
  /// True when a transition on this activity was evaluated for credit and credited nothing (T108).
  /// </summary>
  /// <remarks>
  /// <c>null</c> — credit was never evaluated — is not a warning: it is the permanent state of a
  /// reflective note, a journal club entry, a procedure log, and of every transition recorded before
  /// the outcome started being stamped. Only an explicit zero means "we looked, and nothing counted".
  /// </remarks>
  private bool CreditedNothing
    => _activity?.Transitions.Any(transition => transition.CreditedItemCount == 0) == true;

  /// <summary>
  /// True when a transition counted this activity's volume but refused its supervision level, because
  /// the rating and the curriculum requirement sit on different entrustment scales (T109).
  /// </summary>
  /// <remarks>
  /// Same three-valued contract as <c>CreditedItemCount</c>: <c>null</c> means credit was never
  /// evaluated and is not a warning. Only a positive count is.
  /// </remarks>
  private bool CreditedAcrossScales
    => _activity?.Transitions.Any(transition => transition.CreditScaleMismatchCount > 0) == true;

  private static string CreditLabel(int? creditedItemCount) => creditedItemCount switch
  {
    null => "—",
    0 => "None",
    1 => "1 item",
    _ => $"{creditedItemCount} items"
  };

  protected override async Task OnParametersSetAsync()
  {
    _loading = true;
    _loadError = null;
    _actionError = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await LoadAsync(authState.User);
    }
    catch (Exception exception)
    {
      _loadError = exception.Message;
    }
    finally
    {
      _loading = false;
    }
  }

  /// <summary>
  /// Loads the activity together with the two things that need a principal: the writable field set
  /// and the available transitions. Both are re-read after every transition, because the actions an
  /// actor may take and the fields they may write are properties of the state just moved to.
  /// </summary>
  /// <remarks>
  /// A null result means the activity does not exist OR this user may not read it (T101) — one
  /// answer for both, so that walking the id space discloses nothing. Render it as the empty state
  /// and do NOT surface a message that tells the two apart.
  /// </remarks>
  private async Task LoadAsync(ClaimsPrincipal user)
  {
    var detail = await Sender.Send(new GetActivityByIdQuery(ActivityId, user));

    if (detail is null)
    {
      _activity = null;
      _actions = [];
      _editable = new HashSet<string>(StringComparer.Ordinal);
      _workingDataJson = "{}";
      _hasPendingChanges = false;
      return;
    }

    _activity = detail.Activity;
    _actions = detail.AvailableActions;
    _editable = new HashSet<string>(detail.EditableFieldKeys, StringComparer.Ordinal);
    _workingDataJson = detail.Activity.DataJson;
    _hasPendingChanges = false;
  }

  private void OnDataChanged(string dataJson)
  {
    _workingDataJson = dataJson;

    // "Pending" means the diff the server would actually receive is non-empty — retyping a value
    // back to what is stored leaves nothing to submit.
    _hasPendingChanges = _activity is not null &&
      ActivityDataPatch.Build(_activity.DataJson, _workingDataJson, _editable) is not null;
  }

  private void DiscardChanges()
  {
    if (_activity is null)
    {
      return;
    }

    _workingDataJson = _activity.DataJson;
    _hasPendingChanges = false;
  }

  private async Task HandleTransitionAsync((string TransitionKey, string? Note) request)
  {
    if (_activity is null)
    {
      return;
    }

    _actionError = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
        ?? throw new InvalidOperationException("The current user identifier is missing.");

      // The edits ride the transition rather than being saved separately: one command, one
      // SaveChanges, so an assessor's rating and the move to `completed` are atomic and
      // CreditApplier — which runs after the merge, on a terminal target state — grades the value
      // the assessor just entered (T070).
      //
      // The patch names only the keys this actor owns and only those whose value actually changed.
      // That is what keeps ActivityService.MergeWritableKeys from rejecting the transition: it
      // throws on any patched key the actor does not own whose value differs from what is stored.
      var dataPatchJson = ActivityDataPatch.Build(_activity.DataJson, _workingDataJson, _editable);

      await Sender.Send(new TransitionActivityCommand(
        _activity.Id,
        request.TransitionKey,
        userId,
        authState.User,
        dataPatchJson,
        request.Note));

      await LoadAsync(authState.User);
    }
    catch (Exception exception)
    {
      // The working copy is deliberately left alone: a rejected transition (a missing required
      // field, say) must not discard what the actor typed.
      _actionError = exception.Message;
    }
  }
}

@page "/activities/{ActivityId:int}"
@attribute [Authorize]
@using System.Security.Claims
@using Wombat.Application.Features.Activities.Commands.TransitionActivity
@using Wombat.Application.Features.Activities.Queries.GetActivityById
@using Wombat.Application.Features.Activities.Services
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ActivityNotices Notices
@inject ILogger<ActivityView> Logger

<PageTitle>Activity</PageTitle>

@if (_activity is not null)
{
  @* The state by its label in the pinned workflow (T220), as the notices and refusals on this page name it (T189). *@
  <PageHeader Title="@_activity.ActivityTypeName" Subtitle="@($"State: {_activity.CurrentStateLabel}")" />
}

@if (_notice is not null)
{
  @* What became of an activity filed moments ago on /activities/new, handed over with the navigation (T127). It arrives
     with the page, already filled, and a status region that arrives filled is often not read; an alert is. A warning here
     is the submit's refusal, so it is an alert (T193). A success keeps the kind's polite status: the header says the new
     state as well. *@
  @* It arrives with the page, where an alert is not reliably announced, so a field a refused submit named points at it
     as well as being marked (T263; DESIGN.md § Alerts). *@
  <Alert Kind="@_notice.Kind" Role="@(_notice.Kind == "warning" ? "alert" : null)" Id="@NoticeAlertId">@_notice.Message</Alert>
}

@if (!string.IsNullOrWhiteSpace(_actionError))
{
  @* The fields a refused move names are marked in the form below, and each names this alert (T263). *@
  <Alert Kind="danger" Id="@ActionRefusalAlertId">@_actionError</Alert>
}

@if (CreditedNothing)
{
  @* T108. A completed activity that matched no curriculum item used to be indistinguishable from a
     credited one at every surface in the product. This is the one place a clinician is certain to
     look. It cannot fire on an activity type that credits nothing by design: the server only
     records a count at all when the pinned version declares a non-empty `counts_for`. *@
  <Alert Kind="warning" Role="">
    This activity is complete, but it counted towards no curriculum requirement. The EPA it was
    recorded against is most likely not part of this trainee's curriculum, or was not in use at the time.
    The record is kept. If it should have counted, raise it with the programme administrator.
  </Alert>
}

@if (CreditedAcrossScales)
{
  @* T109. The encounter counted towards the required volume, but the supervision level could not be
     compared: the rating is on one entrustment ladder and the curriculum requirement is on another,
     where the same number means a different amount of supervision. Refusing the comparison is the
     safe answer, and saying so is the honest one — an unexplained shortfall on the progress page is
     how a registrar reaches the end of a year believing a requirement was met. *@
  <Alert Kind="warning" Role="">
    This activity counted towards the required number of observations, but not towards the
    supervision level. The rating was recorded on a different entrustment scale from the one this
    trainee's curriculum requirement uses, so the two levels are not comparable. Please raise it with
    the programme administrator: the curriculum item's scale may need to be corrected.
  </Alert>
}

<StatePanel IsLoading="_loading" LoadError="@_loadError" IsEmpty="@(!_loading && _activity is null)" EmptyTitle="Activity unavailable" EmptyBody="The requested activity could not be loaded.">
  @if (_activity is not null)
  {
    <div class="details-grid">
      <aside class="detail-card">
        <h3>Summary</h3>
        <p><strong>Type:</strong> @_activity.ActivityTypeName</p>
        @* The stored encounter date, marked when nobody stated one (T161, D28). It is the date every list, the
           trajectory and the PDF place this activity on, so the page says what they say. *@
        <p id="activity-encounter-date"><strong>Encounter date:</strong> <EncounterDateLabel ObservedOn="@_activity.ObservedOn" Declared="@_activity.ObservedOnDeclared" /></p>
        <p id="activity-state"><strong>State:</strong> @_activity.CurrentStateLabel</p>
        <p><strong>Version:</strong> @_activity.SchemaVersion</p>
        <ActivityWorkflowActions Actions="_actions" Busy="_busy" OnTransitionRequested="HandleTransitionAsync" />
      </aside>

      <section class="detail-card">
        <h3>Activity details</h3>

        @if (_editable.Count == 0 || !_actions.Any(action => action.IsAvailable))
        {
          @* Read-only when no field is writable by this actor in this state (a non-bound user, or a
             finished activity) AND when there is nothing to submit with. A transition is the only
             save channel there is, so offering inputs with no action available would let someone
             type a reflection and lose it on navigation. An action shown disabled (T107) is nothing
             to submit with. Restore the editable branch here if a standalone save command ever lands
             (T106 item 1). *@
          <ActivityDetail SchemaJson="@_activity.SchemaJson"
                          DataJson="@_activity.DataJson"
                          SubjectUserId="@_activity.SubjectUserId"
                          CreditRulesJson="@_activity.CreditRulesJson"
                          WbaToolKey="@_activity.WbaToolKey"
                          ActivityInstitutionId="@_activity.InstitutionId"
                          RefusedFieldKeys="_refusedFieldKeys"
                          RefusalId="@_refusalAlertId" />
        }
        else
        {
          <Alert Kind="info">
            You can fill in the fields that are enabled below. Your entries are submitted together
            with the action you choose — nothing is stored until then.
          </Alert>

          @* SubjectUserId, not the principal: the actor here is usually the assessor, and the EPAs
             that can be credited are the subject's (T108). *@
          @* Keyed on a generation so a refused move remounts it with fresh option lists (T102): the person the
             server just refused may have fallen off the list since the page loaded. The working copy survives. *@
          <ActivityForm @key="_formGeneration"
                        SchemaJson="@_activity.SchemaJson"
                        DataJson="@_workingDataJson"
                        SubjectUserId="@_activity.SubjectUserId"
                        CreditRulesJson="@_activity.CreditRulesJson"
                        WbaToolKey="@_activity.WbaToolKey"
                        EditableFieldKeys="_editable"
                        IsExistingActivity="true"
                        ActivityInstitutionId="@_activity.InstitutionId"
                        StoredDataJson="@_activity.DataJson"
                        FiledOn="@_filedOn"
                        ProgrammeStartsOn="@_programmeStartsOn"
                        RefusedFieldKeys="_refusedFieldKeys"
                        RefusalId="@_refusalAlertId"
                        DataJsonChanged="OnDataChanged" />

          <FormActions>
            <button id="discard-changes" type="button" class="btn btn-outline" disabled="@(!_hasPendingChanges)" @onclick="DiscardChanges">
              Discard changes
            </button>
          </FormActions>
        }
      </section>
    </div>

    <section class="detail-card mt-3">
      <h3>History</h3>
      <DataTable TItem="ActivityTransitionDto" Items="_activity.Transitions" Caption="Workflow history">
        <HeaderRow>
          <tr>
            <th>Action</th>
            <th>State</th>
            <th>Actor</th>
            <th>When</th>
            <th>Credit</th>
            <th>Note</th>
          </tr>
        </HeaderRow>
        <Row Context="transition">
          <tr>
            @* Each move as its button named it and each state by its label, from the pinned workflow (T220). *@
            <td>@transition.TransitionLabel</td>
            <td>@($"{transition.FromStateLabel} → {transition.ToStateLabel}")</td>
            <td>@transition.ActorName</td>
            <td>
              @transition.OccurredOn.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
              @if (FilingLateness.Label(transition.DaysAfterEncounter) is { } lateFiling)
              {
                @* T160, D15: recorded on the filing's own row, never a refusal. *@
                <div class="text-sm">@lateFiling</div>
              }
            </td>
            <td>@CreditLabel(transition.CreditedItemCount)</td>
            <td>@(string.IsNullOrWhiteSpace(transition.Note) ? "—" : transition.Note)</td>
          </tr>
        </Row>
        <Empty>
          <div class="detail-card detail-card--empty-compact">No workflow actions have been recorded yet.</div>
        </Empty>
      </DataTable>
    </section>
  }
</StatePanel>

@code {
  [Parameter] public int ActivityId { get; set; }

  private ActivityDto? _activity;
  private IReadOnlyList<ActivityActionDto> _actions = [];

  // The field keys this actor may write right now, as the server resolved them (T070). Empty means
  // the page stays read-only. A set rather than the DTO's list because ActivityForm and
  // ActivityDataPatch both do a Contains per field.
  private IReadOnlySet<string> _editable = new HashSet<string>(StringComparer.Ordinal);

  // The form's working copy. It diverges from _activity.DataJson while the actor types and is
  // reconciled with the server on every successful load.
  private string _workingDataJson = "{}";
  private bool _hasPendingChanges;

  // Today, when this viewer's next move could file the activity, so its encounter date warns of a late filing (T160);
  // null otherwise. Re-read with the activity and its actions, since a move changes whether the next one is the filing.
  private DateOnly? _filedOn;

  // When the subject's programme started, which the server holds a crediting type's encounter date to (T192), and whose
  // it is. Read once per subject, and only once the page could be the filing, the one place the form uses it.
  private DateOnly? _programmeStartsOn;
  private string? _programmeStartSubjectId;

  private bool _loading = true;
  private string? _loadError;
  private string? _actionError;

  // Shown until the next load or the next action. Taken, so it is shown once: reloading the page does not repeat it.
  private ActivityNotice? _notice;

  public const string UnavailableActionMessage =
    "That action is not available here. Reload the page to see what you can do now.";

  /// <summary>The id of a refused move's alert, which each field the refusal names points at (T263).</summary>
  public const string ActionRefusalAlertId = "activity-action-refusal";

  /// <summary>The id of the notice handed over from <c>/activities/new</c>, which the fields a refused submit named point at.</summary>
  public const string NoticeAlertId = "activity-notice";

  // The fields the refusal on show named, and the id of the alert that shows it (T263): a refused move's, or the notice of
  // a submit refused straight after the create. Set with that alert and cleared with it, so the form marks a field only
  // while the alert naming it is on the page.
  private IReadOnlyList<string> _refusedFieldKeys = [];
  private string? _refusalAlertId;

  /// <summary>
  /// True when a transition on this activity was evaluated for credit and credited nothing (T108).
  /// </summary>
  /// <remarks>
  /// <c>null</c> — credit was never evaluated — is not a warning: it is the permanent state of a
  /// reflective note, a journal club entry, a procedure log, and of every transition recorded before
  /// the outcome started being stamped. Only an explicit zero means "we looked, and nothing counted".
  /// </remarks>
  private bool CreditedNothing
    => _activity?.Transitions.Any(transition => transition.CreditedItemCount == 0) == true;

  /// <summary>
  /// True when a transition counted this activity's volume but refused its supervision level, because
  /// the rating and the curriculum requirement sit on different entrustment scales (T109).
  /// </summary>
  /// <remarks>
  /// Same three-valued contract as <c>CreditedItemCount</c>: <c>null</c> means credit was never
  /// evaluated and is not a warning. Only a positive count is.
  /// </remarks>
  private bool CreditedAcrossScales
    => _activity?.Transitions.Any(transition => transition.CreditScaleMismatchCount > 0) == true;

  // One wording with the activity lists (T137).
  private static string CreditLabel(int? creditedItemCount) => CreditOutcome.Label(creditedItemCount);

  protected override async Task OnParametersSetAsync()
  {
    _loading = true;
    _loadError = null;
    _actionError = null;
    _notice = null;
    ShowRefusedFields([], null);

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await LoadAsync(authState.User);
    }
    catch (Exception exception)
    {
      _loadError = exception.Message;
    }
    finally
    {
      _loading = false;
    }

    // Taken whatever the load's outcome, so it cannot wait for a later visit; shown only above an activity that loaded.
    var notice = Notices.Take(ActivityId);
    _notice = _loadError is null && _activity is not null ? notice : null;

    if (_notice?.RefusedFieldKeys is { Count: > 0 } refused)
    {
      ShowRefusedFields(refused, NoticeAlertId);
    }
  }

  private void ShowRefusedFields(IReadOnlyList<string> fieldKeys, string? alertId)
  {
    _refusedFieldKeys = fieldKeys;
    _refusalAlertId = alertId;
  }

  /// <summary>
  /// Loads the activity together with the two things that need a principal: the writable field set
  /// and the available transitions. Both are re-read after every transition, because the actions an
  /// actor may take and the fields they may write are properties of the state just moved to.
  /// </summary>
  /// <remarks>
  /// A null result means the activity does not exist OR this user may not read it (T101) — one
  /// answer for both, so that walking the id space discloses nothing. Render it as the empty state
  /// and do NOT surface a message that tells the two apart.
  /// </remarks>
  private async Task LoadAsync(ClaimsPrincipal user)
  {
    var detail = await Sender.Send(new GetActivityByIdQuery(ActivityId, user));

    if (detail is null)
    {
      _activity = null;
      _actions = [];
      _editable = new HashSet<string>(StringComparer.Ordinal);
      _workingDataJson = "{}";
      _hasPendingChanges = false;
      _filedOn = null;
      return;
    }

    _activity = detail.Activity;
    _actions = detail.AvailableActions;
    _editable = new HashSet<string>(detail.EditableFieldKeys, StringComparer.Ordinal);
    _workingDataJson = detail.Activity.DataJson;
    _hasPendingChanges = false;
    _filedOn = FilingLateness.FiledOnFor(detail.Activity, detail.AvailableActions, user);

    if (_filedOn is not null &&
        !string.Equals(_programmeStartSubjectId, detail.Activity.SubjectUserId, StringComparison.Ordinal))
    {
      _programmeStartsOn = await FilingLateness.ProgrammeStartAsync(Sender, detail.Activity.SubjectUserId, user, Logger);
      _programmeStartSubjectId = detail.Activity.SubjectUserId;
    }
  }

  private void OnDataChanged(string dataJson)
  {
    _workingDataJson = dataJson;

    // "Pending" means the diff the server would actually receive is non-empty — retyping a value
    // back to what is stored leaves nothing to submit.
    _hasPendingChanges = _activity is not null &&
      ActivityDataPatch.Build(_activity.DataJson, _workingDataJson, _editable) is not null;
  }

  private void DiscardChanges()
  {
    if (_activity is null)
    {
      return;
    }

    _workingDataJson = _activity.DataJson;
    _hasPendingChanges = false;
  }

  private int _formGeneration;

  // One action at a time. A double-click used to send two transitions; since T102 each refusal also remounts the
  // form, and two of those at once would race their option loads.
  private bool _busy;

  private async Task HandleTransitionAsync((string TransitionKey, string? Note) request)
  {
    if (_activity is null || _busy)
    {
      return;
    }

    // Only an action the server listed as available is sent (T107). ActivityWorkflowActions gives a disabled one no
    // handler; this is the page refusing to be the second way in. Nothing is sent, but the actor is told, rather than
    // pressing a button that silently does nothing.
    if (!_actions.Any(action => action.IsAvailable &&
                                string.Equals(action.TransitionKey, request.TransitionKey, StringComparison.Ordinal)))
    {
      _actionError = UnavailableActionMessage;

      // That alert no longer says what the refused move did, so the fields it named are not left pointing at it. A
      // notice's stay marked: the notice is still shown.
      if (_refusalAlertId == ActionRefusalAlertId)
      {
        ShowRefusedFields([], null);
      }

      return;
    }

    _busy = true;
    _actionError = null;
    // The notice described the activity as it arrived. It must not sit above the outcome of this move.
    _notice = null;
    ShowRefusedFields([], null);

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
        ?? throw new InvalidOperationException("The current user identifier is missing.");

      // The edits ride the transition rather than being saved separately: one command, one
      // SaveChanges, so an assessor's rating and the move to `completed` are atomic and
      // CreditApplier — which runs after the merge, on a terminal target state — grades the value
      // the assessor just entered (T070).
      //
      // The patch names only the keys this actor owns and only those whose value actually changed.
      // That is what keeps ActivityService.MergeWritableKeys from rejecting the transition: it
      // throws on any patched key the actor does not own whose value differs from what is stored.
      var dataPatchJson = ActivityDataPatch.Build(_activity.DataJson, _workingDataJson, _editable);

      await Sender.Send(new TransitionActivityCommand(
        _activity.Id,
        request.TransitionKey,
        userId,
        authState.User,
        dataPatchJson,
        request.Note));

      await LoadAsync(authState.User);
    }
    catch (Exception exception)
    {
      // The working copy is deliberately left alone: a rejected transition (a missing required
      // field, say) must not discard what the actor typed. The remounted form marks the fields the refusal names (T263).
      _actionError = RefusalText.Of(exception);
      ShowRefusedFields(ActivityFieldsRefusedException.FieldKeysOf(exception), ActionRefusalAlertId);
      _formGeneration++;
    }
    finally
    {
      _busy = false;
    }
  }
}

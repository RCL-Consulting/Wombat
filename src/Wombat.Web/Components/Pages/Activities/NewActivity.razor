@page "/activities/new"
@attribute [Authorize]
@using System.Security.Claims
@using Wombat.Application.Features.Activities.Commands.CreateActivity
@using Wombat.Application.Features.Activities.Commands.TransitionActivity
@using Wombat.Application.Features.Activities.Queries.GetActivityById
@using Wombat.Application.Features.Activities.Services
@using Wombat.Domain.Activities
@using Wombat.Domain.Activities.Workflow
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWorkflowEvaluator WorkflowEvaluator
@inject IFieldPermissionEvaluator FieldPermissionEvaluator
@inject NavigationManager Navigation
@inject ActivityNotices Notices
@inject ILogger<NewActivity> Logger
@implements IDisposable

<PageTitle>Log an activity · Wombat</PageTitle>

<PageHeader Title="Log an activity" Subtitle="Create a draft or submit an activity from the published catalogue." />

@* Only a refused create is reported here. Once the activity exists the page leaves for it, and whatever happened next is
   said there (T127). The fields the refusal names are marked in the form below, and each names this alert (T263). *@
@if (!string.IsNullOrWhiteSpace(_error))
{
  <Alert Kind="danger" Id="@RefusalAlertId">@_error</Alert>
}

<div class="form-container">
  <div class="form-grid">
    <FormField Label="Activity type" InputId="activity-type" Required="true">
      @* Locked while an action runs: the outcome is judged against the type that was filed, not one picked since. *@
      <select id="activity-type" class="form-select" disabled="@_busy" @bind="_selectedActivityTypeId" @bind:after="LoadSelectedTypeAsync">
        <option value="0">Select…</option>
        @foreach (var item in _activityTypes)
        {
          <option value="@item.Id">@item.Name</option>
        }
      </select>
    </FormField>
  </div>
</div>

@if (_selectedEditor is not null)
{
  @* The creator IS the subject here — this page files an activity about the current user — so the
     EPA picker narrows to what would actually credit for them (T108), and to what this instrument may be
     filed against (T122): the write path refuses anything else. *@
  @* Keyed on a generation so a refused create remounts it with fresh option lists (T102). What is typed here is filed
     today, whether by the create or by the submit sent straight after it, so the encounter date warns of a late filing
     against today (T160, D15), on a type that can credit: the form reads that from the credit rules. A date before the
     author's programme started is refused on such a type, so the form says that instead (T192). *@
  <ActivityForm @key="_formGeneration"
                SchemaJson="@(_selectedEditor.PublishedSchemaJson ?? _selectedEditor.DraftSchemaJson)"
                DataJson="@_dataJson"
                SubjectUserId="@_currentUserId"
                CreditRulesJson="@(_selectedEditor.PublishedCreditRulesJson ?? _selectedEditor.DraftCreditRulesJson)"
                WbaToolKey="@_selectedEditor.WbaToolKey"
                EditableFieldKeys="_editableFieldKeys"
                FiledOn="@FilingLateness.Today()"
                ProgrammeStartsOn="@_programmeStartsOn"
                RefusedFieldKeys="_refusedFieldKeys"
                RefusalId="@RefusalAlertId"
                DataJsonChanged="OnDataChanged" />

  <FormActions>
    @* Where creating the activity files it (a type born in `requested`, or born terminal like procedure_log) there is
       no draft to keep: "Save draft" would send the request to the assessor, or file a finished log. Only Submit is
       offered, and the create checks the author's required fields as a submit would. *@
    @* While one runs the other is disabled, and the one pressed is not (T234): it has the focus, and a browser drops the
       focus of a button it disables, to the page, where a refused create, which keeps the page, would leave it. A second
       press sends nothing (CreateOrTransitionAsync). *@
    @if (!_createIsTheFiling)
    {
      <button type="button" class="btn btn-outline" disabled="@(_busy && _submitPressed)" aria-disabled="@InFlight.AriaDisabled(_busy && !_submitPressed)" @onclick="SaveDraftAsync">Save draft</button>
    }
    <button type="button" class="btn btn-primary" disabled="@(_busy && !_submitPressed)" aria-disabled="@InFlight.AriaDisabled(_busy && _submitPressed)" @onclick="SubmitAsync">Submit</button>
  </FormActions>
}

@code {
  /// <summary>The id of the refused create's alert, which each field the refusal names points at (T263).</summary>
  public const string RefusalAlertId = "activity-refusal";

  private readonly List<ActivityTypeListItemDto> _activityTypes = [];
  private ActivityTypeEditorDto? _selectedEditor;
  private int _selectedActivityTypeId;
  private string _dataJson = "{}";
  private int _formGeneration;

  // One action at a time: a double-click used to file two drafts, and since T102 two refusals at once would each remount
  // the form and race their option loads. Once a create has succeeded it stays set, because the page is leaving (T127).
  private bool _busy;

  // Which of the two buttons sent the action _busy stands for: that one stays enabled while it runs (T234).
  private bool _submitPressed;

  // Set when the page is torn down, by a click elsewhere while an action was still running. The action finishes, but the
  // page no longer navigates: taking the author back to the activity would undo the click they made.
  private bool _disposed;

  // True when no move out of the selected type's initial state that leads on is this author's, so the create files it
  // and there is no draft to save (T148). A prediction for the buttons only; see PredictCreateIsTheFiling.
  private bool _createIsTheFiling;

  // The subject of anything created here. Held rather than re-read per render because the EPA
  // picker's option list is keyed on it (T108).
  private string? _currentUserId;

  // When the subject's programme started, the bound the server holds a crediting type's encounter date to (T192). Read
  // once: it is the same subject whatever type is picked.
  private DateOnly? _programmeStartsOn;

  // The fields this creator owns on the selected type (T070). Null means "no per-field
  // restriction", which is both the pre-T070 behaviour and the fallback whenever the set cannot be
  // resolved — the server filters the submitted data either way.
  private IReadOnlySet<string>? _editableFieldKeys;
  private string? _error;

  // The fields the refused create named (T263), held with _error and cleared with it, so the form marks them while the
  // alert that names them is shown.
  private IReadOnlyList<string> _refusedFieldKeys = [];

  /// <summary>
  /// Optional deep link: <c>/activities/new?type=mini_cex</c> preselects that activity type.
  /// </summary>
  /// <remarks>
  /// This is an activity-type KEY, not an id, because a key is stable across databases and an id is
  /// not — a link that travels in an email or a dashboard button cannot carry an id. It is resolved
  /// against the list this page has already loaded, which is scope-filtered AND ladder-filtered, so a
  /// key the caller may not use simply is not there and the picker stays unset. Resolving it against
  /// the database instead would bypass both filters and turn a convenience link into an
  /// authorization statement, which it must never be. (T111)
  /// </remarks>
  [SupplyParameterFromQuery(Name = "type")]
  public string? TypeKey { get; set; }

  protected override async Task OnInitializedAsync()
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    _programmeStartsOn = await FilingLateness.ProgrammeStartAsync(Sender, _currentUserId, authState.User, Logger);
    // The creator IS the subject here, so the type picker narrows to tools whose rating ladder this
    // trainee's curriculum could actually credit — the same reasoning the EPA picker below already
    // applies to EPAs (T123 defect 3). Permissive wherever the subject cannot be resolved.
    _activityTypes.AddRange(await Sender.Send(
      new Wombat.Application.Features.Activities.Queries.ListActivityTypes.ListActivityTypesQuery(
        authState.User, _currentUserId)));

    await PreselectFromQueryAsync();
  }

  private async Task PreselectFromQueryAsync()
  {
    if (string.IsNullOrWhiteSpace(TypeKey))
    {
      return;
    }

    var match = _activityTypes.FirstOrDefault(
      item => string.Equals(item.Key, TypeKey.Trim(), StringComparison.OrdinalIgnoreCase));

    if (match is null)
    {
      // Not published, out of scope, on the wrong ladder, or simply renamed. Leave the picker unset;
      // the link is a convenience and a dead one is not an error worth showing.
      return;
    }

    _selectedActivityTypeId = match.Id;

    // Setting the bound field alone would select the <option> and render no form, because the schema
    // is loaded by @bind:after on the element's change event, which code does not raise.
    await LoadSelectedTypeAsync();
  }

  private async Task LoadSelectedTypeAsync()
  {
    _error = null;
    _refusedFieldKeys = [];

    if (_selectedActivityTypeId <= 0)
    {
      _selectedEditor = null;
      _editableFieldKeys = null;
      _createIsTheFiling = false;
      return;
    }

    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    // Only the type's definition: what the builder would let the caller change is not this page's to know (T300 review).
    _selectedEditor = await Sender.Send(new Wombat.Application.Features.Activities.Queries.GetActivityTypeEditor.GetActivityTypeEditorQuery(_selectedActivityTypeId, authState.User, ForBuilder: false));
    _dataJson = "{}";
    _editableFieldKeys = ResolveEditableFieldKeys(authState.User);
    _createIsTheFiling = PredictCreateIsTheFiling(authState.User);
  }

  private Task OnDataChanged(string dataJson)
  {
    _dataJson = dataJson;
    return Task.CompletedTask;
  }

  private async Task SaveDraftAsync()
  {
    await CreateOrTransitionAsync(submit: false);
  }

  private async Task SubmitAsync()
  {
    await CreateOrTransitionAsync(submit: true);
  }

  private async Task CreateOrTransitionAsync(bool submit)
  {
    if (_busy)
    {
      return;
    }

    if (_selectedActivityTypeId <= 0)
    {
      _error = "Select an activity type first.";
      return;
    }

    _busy = true;
    _submitPressed = submit;
    _error = null;
    _refusedFieldKeys = [];

    ClaimsPrincipal user;
    string userId;
    ActivityDto created;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      user = authState.User;
      userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value
        ?? throw new InvalidOperationException("The current user identifier is missing.");

      created = await Sender.Send(new CreateActivityCommand(
        _selectedActivityTypeId,
        userId,
        userId,
        _dataJson,
        user));
    }
    catch (Exception exception)
    {
      // Nothing was created, so the page stays, keeps what was typed, and says that nothing was saved (T127). The remount
      // refreshes the form's option lists, since the person just refused may have fallen off them (T102), and marks the
      // fields the refusal names (T263).
      _error = $"Nothing was saved. {AsSentence(RefusalText.Of(exception))}";
      _refusedFieldKeys = ActivityFieldsRefusedException.FieldKeysOf(exception);
      _formGeneration++;
      _busy = false;
      return;
    }

    // The activity exists from here on, and the page leaves for it whatever happens next. The filled form goes with it, so
    // the same encounter cannot be filed twice (T143). A refused submit is retried on the activity's own page, which sends
    // the edits as a patched transition, so nothing here can create again (T127). _busy stays set until the router
    // replaces this page, so a press in between does nothing.
    var notice = await FinishCreatedAsync(created, submit, user, userId);

    if (_disposed)
    {
      // The author went elsewhere while this ran. The activity is on their list, and the notice would have no page to
      // show on, so neither is left behind.
      return;
    }

    Notices.Post(created.Id, notice.Kind, notice.Message, notice.RefusedFieldKeys);

    // In the circuit (no forceLoad), or the notice is lost with the scope that holds it. Replacing this page's history
    // entry means Back from the activity does not return to an empty form, where typing the encounter again would file
    // it a second time.
    Navigation.NavigateTo($"/activities/{created.Id}", replace: true);
  }

  public void Dispose() => _disposed = true;

  // What became of an activity the create has just filed, after sending the move that submits it if Submit was pressed.
  // Judged against the workflow the activity is pinned to, which the create returns: that is the version the server
  // evaluates the move against. The state the activity is in is named by the label the server carried from that same
  // version (ActivityDto.CurrentStateLabel), never worked out here (T220).
  private async Task<ActivityNotice> FinishCreatedAsync(ActivityDto created, bool submit, ClaimsPrincipal user, string userId)
  {
    Workflow workflow;
    string? transitionKey;
    try
    {
      workflow = WorkflowParser.Parse(created.WorkflowJson);
      transitionKey = await ResolveSubmitMoveAsync(created, workflow, user);
    }
    catch (Exception exception)
    {
      // What failed is working out the next move, not the create, so nothing is claimed beyond what is certain. The
      // activity's page offers whatever moves it has.
      return new ActivityNotice(
        "warning",
        $"Saved, but the next step could not be worked out: {AsSentence(exception.Message)} Continue from this page.");
    }

    if (transitionKey is null)
    {
      // Nothing moves it on from here for this author, so the create was the filing. For a type born in `requested`
      // (the generic mini_cex, dops, cbd and acat) that is the submission itself, so no button may say it was not
      // submitted. Nor may either say "Submitted" when nothing moved (T148). The state's own name is true in every case:
      // the label the server carried from the pinned workflow, as every other page prints it (T220).
      return new ActivityNotice("success", $"Filed. It is now {created.CurrentStateLabel}.");
    }

    if (!submit)
    {
      return new ActivityNotice("success", "Draft saved. It has not been submitted.");
    }

    ActivityDto moved;
    try
    {
      moved = await Sender.Send(new TransitionActivityCommand(
        created.Id,
        transitionKey,
        userId,
        user,
        // No patch: CreateActivityCommand above already persisted this data, filtered to the
        // fields the creator owns (T070). Re-sending the raw form here would be rejected if a
        // field the creator does not own had been stripped at create — the echo would no longer
        // match what is stored and the write gate would fire. The form no longer offers those
        // fields (EditableFieldKeys above), so this is belt and braces.
        null,
        null));
    }
    catch (Exception exception)
    {
      // The submit's refusal. The usual one is a required field the author owns that is still empty. A move out of the
      // initial state that leads on was theirs to take, so the activity is waiting on them: a draft, whatever its state
      // is called. The fields it names go with it, so the draft's page marks the ones "below" means (T263); none, when it
      // names none, as for every other notice.
      return new ActivityNotice(
        "warning",
        $"Saved as a draft, but not submitted: {AsSentence(RefusalText.Of(exception))} Fix the fields below and submit again.",
        ActivityFieldsRefusedException.FieldKeysOf(exception) is { Count: > 0 } refused ? refused : null);
    }

    return new ActivityNotice("success", $"Submitted. It is now {moved.CurrentStateLabel}.");
  }

  // The move that submits what the author has just created: the first of the moves the server offers them on it that
  // leads on towards a terminal state (Workflow.TransitionsLeadingOn), in workflow order. The key is not always "submit"
  // (msf_cpsa's is "record"), so it is read rather than hard-coded.
  //
  // The server says which moves are the author's, as it does for the activity's own page, because only the server holds
  // the activity as it was built: the institution and speciality stamped on it, which `scope:` rules read, and its data
  // as filtered to what the author owns, which `field:` rules read.
  //
  // A withdrawal is never the submission. A type born in `requested` offers its author only `cancel`, into a dead end,
  // and sending that withdrew the encounter the moment it was filed (T148). A move that reaches credit only by coming
  // back through the initial state is a withdrawal too, such as a builder-made `cancelled` with a `reopen`, and so is a
  // self-transition. A move straight into a terminal state still counts. Returns null when no move is left: the create
  // was the filing.
  private async Task<string?> ResolveSubmitMoveAsync(ActivityDto created, Workflow workflow, ClaimsPrincipal user)
  {
    var detail = await Sender.Send(new GetActivityByIdQuery(created.Id, user))
      ?? throw new InvalidOperationException("The new activity could not be read back.");

    var offered = detail.AvailableActions
      .Select(action => action.TransitionKey)
      .ToHashSet(StringComparer.Ordinal);

    return workflow.TransitionsLeadingOn(created.CurrentState)
      .Select(transition => transition.Key)
      .FirstOrDefault(offered.Contains);
  }

  // Whether creating the selected type would file it for this author: no move out of its initial state that leads on is
  // theirs (the test the server's create applies, and ResolveSubmitMoveAsync after it). Decides only whether "Save draft"
  // is offered. It is judged against the activity as it would be built, which cannot know the scope the create will
  // stamp, so a `scope:institution` or `scope:speciality` rule reads false here: the page may offer less than the server
  // would allow, never more, as ResolveEditableFieldKeys does. Submit is always offered, and the move it sends is the
  // server's answer, not this one.
  private bool PredictCreateIsTheFiling(ClaimsPrincipal user)
  {
    var workflowJson = _selectedEditor?.PublishedWorkflowJson ?? _selectedEditor?.DraftWorkflowJson;
    var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    if (string.IsNullOrWhiteSpace(workflowJson) || string.IsNullOrWhiteSpace(userId))
    {
      return false;
    }

    try
    {
      var workflow = WorkflowParser.Parse(workflowJson);
      var candidate = BuildCandidate(workflow, userId);

      return !workflow.TransitionsLeadingOn(workflow.InitialState)
        .Any(transition => WorkflowEvaluator.Evaluate(workflow, candidate, transition.Key, user).Allowed);
    }
    catch (Exception)
    {
      // An unparseable workflow is ActivityForm's error to surface. Offer both buttons and let the server decide.
      return false;
    }
  }

  // A refusal is quoted mid-message, before more text, so it has to end as a sentence does. Most server refusals already
  // do ("Presenting problem: A value is required."); a few do not.
  private static string AsSentence(string message)
  {
    var trimmed = message.Trim();
    return trimmed.Length == 0 || trimmed[^1] is '.' or '!' or '?' ? trimmed : trimmed + ".";
  }

  // T070 step 8: lock the fields this creator does not own, so a trainee filing a CPSA WBA gets the
  // Request section and sees Entrustment/Feedback disabled instead of filling in a rating the server
  // then silently strips (CreateDraftAsync filters the submitted data to the same set).
  //
  // This is the cheap slice the task recommends: the schema and workflow are the ones this page has
  // already loaded for the renderer, and the evaluator is the same one the server uses, called the
  // same way — ignoreStateGate: true, because procedure_log and journal_club declare a terminal
  // initial state and would otherwise be uncreatable.
  //
  // It is resolved once per selected type, against an empty form, rather than re-evaluated as the
  // creator types. The only rule whose answer could change mid-form is `field:` — a creator naming
  // themselves in assessor_user_id would unlock the assessor's own sections — and that is precisely
  // the self-assessment the platform should not be inviting (T070 open decision 3). Where the two
  // differ, the UI is the stricter; the create-time filter is the gate either way.
  private IReadOnlySet<string>? ResolveEditableFieldKeys(ClaimsPrincipal user)
  {
    var schemaJson = _selectedEditor?.PublishedSchemaJson ?? _selectedEditor?.DraftSchemaJson;
    var workflowJson = _selectedEditor?.PublishedWorkflowJson ?? _selectedEditor?.DraftWorkflowJson;
    var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    // No identity means no subject/creator rule can match, and an empty set would lock the entire
    // creation form rather than part of it. Fall back to no restriction and let the server filter.
    if (string.IsNullOrWhiteSpace(schemaJson) ||
        string.IsNullOrWhiteSpace(workflowJson) ||
        string.IsNullOrWhiteSpace(userId))
    {
      return null;
    }

    try
    {
      var workflow = WorkflowParser.Parse(workflowJson);

      return FieldPermissionEvaluator.GetWritableFieldKeys(
        FormSchemaParser.Parse(schemaJson),
        workflow,
        BuildCandidate(workflow, userId),
        user,
        ignoreStateGate: true);
    }
    catch (Exception)
    {
      // An unparseable schema or workflow is ActivityForm's error to surface, not this method's.
      return null;
    }
  }

  // The activity that would be created if the form were submitted now. The type's Scope is carried over from the editor
  // DTO so a `scope:global` rule reads as it will server-side. The institution and speciality the create will stamp on
  // the activity are not known here (T101 moved every other `scope:` rule onto them), so those rules read false: the
  // predictions made with this candidate err towards offering less.
  private Activity BuildCandidate(Workflow workflow, string userId)
    => new()
    {
      ActivityType = new ActivityType
      {
        Scope = _selectedEditor?.Scope ?? ActivityScope.Global,
        ScopeId = _selectedEditor?.ScopeId
      },
      CurrentState = workflow.InitialState,
      SubjectUserId = userId,
      CreatedByUserId = userId,
      DataJson = _dataJson
    };
}

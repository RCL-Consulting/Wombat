@page "/account/data-rights"
@attribute [Authorize]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Data rights</PageTitle>

<PageHeader Title="Your data rights" Subtitle="Request access to your data, correct it, export it, manage processing preferences, or request erasure." />

@* What an action did. It takes the focus once the action is done (T234; DESIGN.md § Button system): a status arriving
   on its own is often not read, and a withdrawn request's Withdraw is gone. A refusal leaves the focus where it was: it
   is an alert, read at once. *@
<ActionResult @ref="_result">
  @if (!string.IsNullOrWhiteSpace(_errorMessage))
  {
    <Alert Kind="danger">@_errorMessage</Alert>
  }

  @if (!string.IsNullOrWhiteSpace(_statusMessage))
  {
    <Alert Kind="success">@_statusMessage</Alert>
  }
</ActionResult>

<div class="details-grid">
  <section class="detail-card">
    <h3>Processing preferences</h3>
    <p class="text-muted text-sm">
      You may opt out of processing that is not required for your training programme.
      You cannot object to processing required for programme operation, assessment records, or regulatory compliance.
    </p>

    <StatePanel IsLoading="_loadingFlags" IsEmpty="false">
      <div class="form-grid">
        <FormField Label="Optional processing" InputId="data-rights-optional-processing">
          <div class="form-check">
            <input id="data-rights-optional-processing" type="checkbox" class="form-check-input" @bind="_optOutOfOptionalProcessing" />
            <label for="data-rights-optional-processing">Opt out of optional processing (e.g. analytics)</label>
          </div>
        </FormField>
        @* T240. The opt-out stops three periodic reminders, not only the one called a digest, so the box says which. *@
        <FormField Label="Digest emails" InputId="data-rights-digest-emails" HelpText="@DigestEmailsHelp">
          <div class="form-check">
            <input id="data-rights-digest-emails" type="checkbox" class="form-check-input" @bind="_optOutOfDigestEmails"
                   aria-describedby="@FieldHelp.Id("data-rights-digest-emails")" />
            <label for="data-rights-digest-emails">Opt out of digest emails</label>
          </div>
        </FormField>
      </div>
      <FormActions>
        @* Neither this nor Submit request is disabled while its own action runs (T234): the one pressed has the focus,
           and a browser drops the focus of a button it disables, to the page. A second press sends nothing, and
           aria-disabled says so. Each is disabled while the other, or a withdrawal, runs. *@
        <button type="button" class="btn btn-primary" disabled="@(_submitting || _withdrawingId is not null)"
                aria-disabled="@InFlight.AriaDisabled(_savingFlags)" @onclick="SaveFlagsAsync">
          @(_savingFlags ? "Saving..." : "Save preferences")
        </button>
      </FormActions>
    </StatePanel>
  </section>

  <section class="detail-card">
    <h3>Submit a request</h3>
    <p class="text-muted text-sm">
      Under data protection law, you have the right to access, export, correct, or request erasure of your personal data.
    </p>

    <div class="form-grid">
      <FormField Label="Request type" InputId="dr-type" Required="true">
        <select id="dr-type" class="form-control" @bind="_newRequestType">
          <option value="@DataRightsRequestType.Access">Access — download everything we hold about you</option>
          <option value="@DataRightsRequestType.Export">Export — machine-readable data export</option>
          <option value="@DataRightsRequestType.Rectification">Rectification — correct inaccurate data</option>
          <option value="@DataRightsRequestType.Erasure">Erasure — request deletion of your data</option>
        </select>
      </FormField>

      <FormField Label="Reason" InputId="dr-reason" Required="true">
        <textarea id="dr-reason" class="form-control" rows="3" @bind="_newRequestReason" placeholder="Describe what you need and why..."></textarea>
      </FormField>
    </div>

    <FormActions>
      <button type="button" class="btn btn-primary" disabled="@(_savingFlags || _withdrawingId is not null)"
              aria-disabled="@InFlight.AriaDisabled(_submitting)" @onclick="SubmitRequestAsync">
        @(_submitting ? "Submitting..." : "Submit request")
      </button>
    </FormActions>
  </section>
</div>

<h3>Your requests</h3>

<StatePanel IsLoading="_loadingRequests" IsEmpty="@(_requests is not null && _requests.Count == 0)" EmptyTitle="No requests" EmptyBody="You have not submitted any data rights requests yet.">
  @if (_requests is not null && _requests.Count > 0)
  {
    <DataTable TItem="DataRightsRequestSummaryDto" Items="_requests" Caption="Your data rights requests">
      <HeaderRow>
        <tr>
          <th>Date</th>
          <th>Type</th>
          <th>Status</th>
          <th><span class="visually-hidden">Actions</span></th>
        </tr>
      </HeaderRow>
      <Row Context="req">
        <tr>
          <td><code>@req.RequestedOn.ToString("yyyy-MM-dd HH:mm")</code></td>
          <td>@req.Type</td>
          <td><span class="badge @BadgeFor.DataRightsRequest(req.Status)">@req.Status</span></td>
          <td>
            @if (req.Status is DataRightsRequestStatus.Submitted or DataRightsRequestStatus.UnderReview)
            {
              @* The one pressed stays enabled while it runs, and a second press sends nothing (T234 review). *@
              @* T239: each action is named by its request, its type and when it was made. *@
              <button type="button" class="btn btn-outline btn-sm" aria-label="@($"Withdraw the {req.Type} request made {Made(req)}")"
                      disabled="@(_savingFlags || _submitting || (_withdrawingId is not null && _withdrawingId != req.Id))"
                      aria-disabled="@InFlight.AriaDisabled(_withdrawingId == req.Id)"
                      @onclick="() => WithdrawAsync(req.Id)">Withdraw</button>
            }
            @if (req.Status == DataRightsRequestStatus.Completed &&
                 req.Type is DataRightsRequestType.Access or DataRightsRequestType.Export)
            {
              <a class="btn btn-outline btn-sm" href="/account/data-rights/download/@req.Id"
                 aria-label="@($"Download the export of the {req.Type} request made {Made(req)}")">Download</a>
            }
          </td>
        </tr>
      </Row>
    </DataTable>
  }
</StatePanel>

@code {
  /// <summary>When a request was made, as its Date column says it (T239).</summary>
  private static string Made(DataRightsRequestSummaryDto request)
    => request.RequestedOn.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);

  private IReadOnlyList<DataRightsRequestSummaryDto>? _requests;
  private bool _loadingRequests = true;
  private bool _loadingFlags = true;
  private bool _savingFlags;
  private bool _submitting;

  /// <summary>The request whose withdrawal has been sent and has not answered, or null. (T234 review)</summary>
  private Guid? _withdrawingId;

  private ActionResult? _result;

  /// <summary>A save, a submit or a withdrawal has been sent and has not answered, so nothing else may be sent. (T234)</summary>
  private bool Busy => _savingFlags || _submitting || _withdrawingId is not null;
  private string? _errorMessage;
  private string? _statusMessage;

  private bool _optOutOfOptionalProcessing;
  private bool _optOutOfDigestEmails;

  /// <summary>
  /// What the opt-out stops: the three jobs that ask <c>ReminderRecipientPolicy</c> (T151, T240), and what it does not.
  /// </summary>
  private const string DigestEmailsHelp =
    "Stops three regular reminders: the weekly coordinator digest, the reminder of drafts left untouched for 14 days, " +
    "and the reminder of activities that have waited more than 5 days for you to assess. Email about one particular " +
    "thing is still sent, such as a request to assess, an invitation to give feedback, or a committee or entrustment " +
    "decision.";

  private DataRightsRequestType _newRequestType = DataRightsRequestType.Access;
  private string _newRequestReason = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    var principal = authState.User;

    try
    {
      var flags = await Sender.Send(
        new Wombat.Application.Features.DataRights.Queries.GetObjectionFlagsQuery(principal));
      _optOutOfOptionalProcessing = flags.OptOutOfOptionalProcessing;
      _optOutOfDigestEmails = flags.OptOutOfDigestEmails;
    }
    catch (Exception ex)
    {
      _errorMessage = ex.Message;
    }
    finally
    {
      _loadingFlags = false;
    }

    try
    {
      _requests = await Sender.Send(
        new Wombat.Application.Features.DataRights.Queries.GetMyDataRightsRequestsQuery(principal));
    }
    catch (Exception ex)
    {
      _errorMessage = ex.Message;
    }
    finally
    {
      _loadingRequests = false;
    }
  }

  private async Task SaveFlagsAsync()
  {
    if (Busy)
    {
      return;
    }

    _savingFlags = true;
    _errorMessage = null;
    _statusMessage = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await Sender.Send(new Wombat.Application.Features.DataRights.Commands.UpdateObjectionFlagsCommand(
        _optOutOfOptionalProcessing,
        _optOutOfDigestEmails,
        authState.User));
      _statusMessage = "Processing preferences saved.";
      _result?.FocusAfterRender();
    }
    catch (Exception ex)
    {
      _errorMessage = ex.Message;
    }
    finally
    {
      _savingFlags = false;
    }
  }

  private async Task SubmitRequestAsync()
  {
    if (Busy)
    {
      return;
    }

    if (string.IsNullOrWhiteSpace(_newRequestReason))
    {
      _errorMessage = "Please provide a reason for your request.";
      return;
    }

    _submitting = true;
    _errorMessage = null;
    _statusMessage = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await Sender.Send(new Wombat.Application.Features.DataRights.Commands.SubmitDataRightsRequestCommand(
        _newRequestType,
        _newRequestReason,
        authState.User));

      _statusMessage = "Request submitted. You will be notified when it is reviewed.";
      _newRequestReason = string.Empty;

      // Reload requests
      _requests = await Sender.Send(
        new Wombat.Application.Features.DataRights.Queries.GetMyDataRightsRequestsQuery(authState.User));
      _result?.FocusAfterRender();
    }
    catch (Exception ex)
    {
      _errorMessage = ex.Message;
    }
    finally
    {
      _submitting = false;
    }
  }

  private async Task WithdrawAsync(Guid requestId)
  {
    if (Busy)
    {
      return;
    }

    _withdrawingId = requestId;
    _errorMessage = null;
    _statusMessage = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await Sender.Send(new Wombat.Application.Features.DataRights.Commands.WithdrawDataRightsRequestCommand(
        requestId, authState.User));

      _statusMessage = "Request withdrawn.";
      _requests = await Sender.Send(
        new Wombat.Application.Features.DataRights.Queries.GetMyDataRightsRequestsQuery(authState.User));
      _result?.FocusAfterRender();
    }
    catch (Exception ex)
    {
      _errorMessage = ex.Message;
    }
    finally
    {
      _withdrawingId = null;
    }
  }
}

@page "/msf/campaigns/new"
@page "/msf/campaigns/{CampaignId:int}"
@using System.Globalization
@using System.Security.Claims
@using Wombat.Application.Features.Activities.Services
@attribute [Authorize(Roles = "Coordinator,Administrator")]
@inject IScopedSender Sender
@inject IActivityReferenceDataService ReferenceData
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>MSF Campaign</PageTitle>

<PageHeader Title="MSF campaign" Subtitle="Create a campaign, add respondents, then open the anonymous response window." />

@* Someone who holds Trainee runs no campaign, whatever role brought them here (MsfCampaignRules.RunsNoCampaigns, T224);
   nor does a Coordinator at no institution (MsfCampaignRules.RunsCampaigns, T248). Standing content, in the words the
   create and template commands refuse them in: neither the create form nor the Quick template card is shown to them
   (T248), and a campaign's page answers them with its "Campaign unavailable" card, which alone would not say why. *@
@if (_runsCampaigns is false)
{
  <Alert Id="msf-runs-no-campaigns" Kind="warning" Role="">@_runsNoCampaignsReason</Alert>
}

@* What an action did. Given the focus whenever the button that acted is gone (T217): after an open or a withdraw, and
   after an invitee add refused because the campaign left its draft elsewhere. The focus would otherwise fall to the
   page, as on the campaign list (T206 review). *@
<div @ref="_result" class="action-result" tabindex="-1">
  @if (!string.IsNullOrWhiteSpace(_status))
  {
    <Alert Kind="success" Role="status">@_status</Alert>
  }

  @if (!string.IsNullOrWhiteSpace(_error))
  {
    <Alert Kind="danger" Role="alert">@_error</Alert>
  }
</div>

<div class="details-grid">
  @* The Quick template card only where a campaign is being created (T225): a template is chosen at create, and a
     campaign that exists already has its questionnaire. Until T225 it sat beside every campaign's own card. Only for
     someone who runs campaigns (T248): creating a template is running campaigns, and the command refuses anyone else in
     the standing alert's words (MsfCampaignRules.EnsureRunsCampaigns). Until T248 the card stayed for someone who holds
     Trainee, since a template is about no trainee, and the command took no caller to refuse. *@
  @if (!CampaignId.HasValue && _runsCampaigns is true)
  {
    <section class="detail-card">
      <h3>Quick template</h3>
      <EditForm Model="_template" OnValidSubmit="CreateTemplateAsync" FormName="msf-template">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary-errors" />
        <div class="form-grid">
          @* T164, D35: learner feedback is a template of its own kind. Only learners answer it, and its release records
             learner-feedback evidence, not multi-source feedback. *@
          <FormField Label="Kind" InputId="msf-template-kind" Required="true"
                     HelpText="Learner feedback is answered only by people the trainee taught, and is recorded as learner feedback, not as multi-source feedback.">
            <InputSelect id="msf-template-kind" class="form-select" aria-describedby="@FieldHelp.Id("msf-template-kind")" @bind-Value="_template.Kind" @bind-Value:after="OnTemplateKindChanged">
              <option value="@MsfTemplateKind.Msf">@MsfEvidenceKinds.Describe(MsfTemplateKind.Msf)</option>
              <option value="@MsfTemplateKind.LearnerFeedback">@MsfEvidenceKinds.Describe(MsfTemplateKind.LearnerFeedback)</option>
            </InputSelect>
          </FormField>
          <FormField Label="Template name" InputId="msf-template-name" Required="true">
            <InputText id="msf-template-name" class="form-control" @bind-Value="_template.Name" />
          </FormField>
          <FormField Label="Scale question" InputId="msf-template-scale" Required="true">
            <InputText id="msf-template-scale" class="form-control" @bind-Value="_template.ScalePrompt" />
          </FormField>
          <FormField Label="Comment question" InputId="msf-template-comment" Required="true">
            <InputText id="msf-template-comment" class="form-control" @bind-Value="_template.CommentPrompt" />
          </FormField>
        </div>
        <FormActions>
          <button type="submit" class="btn btn-outline">Add template</button>
        </FormActions>
      </EditForm>
    </section>
  }

  @if (CampaignId.HasValue || _runsCampaigns is true)
  {
    <section class="detail-card">
      <h3>@(CampaignId.HasValue ? "Campaign details" : "Create campaign")</h3>
      @if (!CampaignId.HasValue)
      {
        <EditForm Model="_campaign" OnValidSubmit="CreateCampaignAsync" FormName="msf-campaign">
          <DataAnnotationsValidator />
          <ValidationSummary class="validation-summary-errors" />
          <div class="form-grid">
            <FormField Label="Trainee" InputId="msf-subject" Required="true">
              <InputSelect id="msf-subject" class="form-select" @bind-Value="_campaign.SubjectUserId" @bind-Value:after="LoadEpaOptionsAsync">
                <option value="">Select trainee</option>
                @foreach (var trainee in _trainees)
                {
                  <option value="@trainee.UserId">@TraineeLabel(trainee)</option>
                }
              </InputSelect>
            </FormField>
            <FormField Label="Template" InputId="msf-template-id" Required="true">
              <InputSelect id="msf-template-id" class="form-select" @bind-Value="_campaign.TemplateId" @bind-Value:after="OnCampaignTemplateChangedAsync">
                <option value="">Select template</option>
                @foreach (var template in _templates)
                {
                  <option value="@template.Id">@TemplateLabel(template)</option>
                }
              </InputSelect>
            </FormField>
            <FormField Label="Opens on" InputId="msf-opens" Required="true">
              <InputDate id="msf-opens" class="form-control" @bind-Value="_campaign.OpensOn" />
            </FormField>
            <FormField Label="Closes on" InputId="msf-closes" Required="true">
              <InputDate id="msf-closes" class="form-control" @bind-Value="_campaign.ClosesOn" />
            </FormField>
            <FormField Label="Minimum responses" InputId="msf-min-responses" Required="true">
              <InputNumber id="msf-min-responses" class="form-control" @bind-Value="_campaign.MinimumResponses" />
            </FormField>
            <FormField Label="Minimum category responses" InputId="msf-min-category" Required="true">
              <InputNumber id="msf-min-category" class="form-control" @bind-Value="_campaign.MinimumCategoryResponses" />
            </FormField>
            <FormField Label="Minimum reporting categories" InputId="msf-min-category-count" Required="true"
                       HelpText="@MinimumCategoriesHelp">
              <InputNumber id="msf-min-category-count" class="form-control" aria-describedby="@FieldHelp.Id("msf-min-category-count")" @bind-Value="_campaign.MinimumRespondentCategories" disabled="@IsLearnerFeedback" />
            </FormField>
            @* A group of checkboxes has no single control for a <label for> to name, so it is a fieldset whose legend
               names the group (DESIGN.md § Form system, T147). *@
            <fieldset class="full-width" aria-describedby="msf-epas-help">
              <legend>
                Evidence for these EPAs
                <span aria-hidden="true">*</span>
                <span class="visually-hidden">required</span>
              </legend>
              <p id="msf-epas-help" class="muted">@EpasHelp</p>
              @if (string.IsNullOrWhiteSpace(_campaign.SubjectUserId))
              {
                <p class="page-subtitle">Select a trainee first.</p>
              }
              else if (_epaOptions.Count == 0)
              {
                <p class="page-subtitle">@NoEpasText</p>
              }
              else
              {
                <div class="check-grid">
                  @foreach (var epa in _epaOptions)
                  {
                    <div class="form-check">
                      <input
                        id="@($"msf-epa-{epa.Value}")"
                        class="form-check-input"
                        type="checkbox"
                        checked="@_campaign.EpaIds.Contains(ParseEpaId(epa.Value))"
                        @onchange="args => ToggleEpa(epa.Value, args.Value is bool isChecked && isChecked)" />
                      <label for="@($"msf-epa-{epa.Value}")">@epa.Label</label>
                    </div>
                  }
                </div>
              }
            </fieldset>
          </div>
          <FormActions>
            <button type="submit" class="btn btn-primary">Create campaign</button>
          </FormActions>
        </EditForm>
      }
      else
      {
        @* The campaign as it is now, and only what its state allows (T217). Until T217 this card showed the draft's invitee
           form and its Open button in every state, so a campaign just opened still offered Open, and no state showed who
           had been invited. *@
        <StatePanel IsLoading="_setupLoading" IsEmpty="@(_setup is null)" SkeletonCount="3"
                    EmptyTitle="Campaign unavailable" EmptyBody="The selected campaign could not be loaded.">
          @if (_setup is { } setup)
          {
            <dl class="details-list">
              <div><dt>Trainee</dt><dd>@(setup.SubjectName ?? "Not recorded")</dd></div>
              <div><dt>Template</dt><dd>@setup.TemplateName (@MsfEvidenceKinds.Describe(setup.Kind))</dd></div>
              <div>
                <dt>State</dt>
                <dd><span id="msf-campaign-state" class="badge @MsfCampaignText.StateBadge(setup.State)">@MsfCampaignText.State(setup.State)</span></dd>
              </div>
              <div><dt>Response window</dt><dd>@setup.OpensOn.ToString("yyyy-MM-dd") to @setup.ClosesOn.ToString("yyyy-MM-dd")</dd></div>
            </dl>
            <p id="msf-campaign-state-note">@StateNote(setup)</p>

            @* Counted by respondent group, never a row per invitee (MsfCampaignSetupDto.Invitees, T217): the coordinator
               knows which row is whom, so a "responded" mark on one row would name the author of the comment that has
               just appeared on the report. A draft has no responses, so it has no Responded column. *@
            <h4 id="msf-invitees-heading">Invitees</h4>
            @if (setup.Invitees.Count == 0)
            {
              <p id="msf-invitees-none" class="muted">@(setup.State == MsfCampaignState.Draft ? "Nobody has been invited yet." : "Nobody was invited.")</p>
            }
            else
            {
              @* Says what the page does, and no more (T217 review): it cannot promise that no answer is traceable, since a
                 campaign may set its category threshold at one, and then its report shows a one-person group's answers. *@
              <p id="msf-invitees-note" class="muted">Counted by respondent group. This page never lists who was invited or which of them responded.</p>
              <div class="table-container shadow">
                <table class="clinic-table" aria-labelledby="msf-invitees-heading" aria-describedby="msf-invitees-note">
                  <thead>
                    <tr>
                      <th scope="col">Respondent group</th>
                      <th scope="col">Invited</th>
                      @if (ShowsResponses(setup))
                      {
                        <th scope="col">Responded</th>
                      }
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (var group in setup.Invitees)
                    {
                      <tr>
                        <th scope="row">@MsfRespondentCategories.Describe(group.Category)</th>
                        <td>@group.Invited</td>
                        @if (ShowsResponses(setup))
                        {
                          <td>@group.Responded</td>
                        }
                      </tr>
                    }
                  </tbody>
                  @if (setup.Invitees.Count > 1)
                  {
                    <tfoot>
                      <tr>
                        <th scope="row">All groups</th>
                        <td>@setup.Invitees.Sum(group => group.Invited)</td>
                        @if (ShowsResponses(setup))
                        {
                          <td>@setup.Invitees.Sum(group => group.Responded)</td>
                        }
                      </tr>
                    </tfoot>
                  }
                </table>
              </div>
            }

            @if (setup.State == MsfCampaignState.Draft)
            {
              <h4>Add an invitee</h4>
              <EditForm Model="_invitee" OnValidSubmit="AddInviteeAsync" FormName="msf-invitee">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary-errors" />
                <div class="form-grid">
                  <FormField Label="Respondent email" InputId="msf-respondent-email" Required="true">
                    <InputText @ref="_emailInput" id="msf-respondent-email" class="form-control" @bind-Value="_invitee.Email" />
                  </FormField>
                  @* Only the categories this campaign's questionnaire accepts, which the invite command holds it to (T164),
                     each by its label (T191, T217). *@
                  <FormField Label="Category" InputId="msf-respondent-category" Required="true">
                    <InputSelect id="msf-respondent-category" class="form-select" @bind-Value="_invitee.Category">
                      @foreach (var category in AcceptedCategories)
                      {
                        <option value="@category">@MsfRespondentCategories.Describe(category)</option>
                      }
                    </InputSelect>
                  </FormField>
                  @if (_invitee.Category == MsfRespondentCategory.Learner)
                  {
                    <FormField Label="Teaching context" InputId="msf-teaching-context" Required="true"
                               HelpText="Where this learner was taught, for example a ward round or a student tutorial. Describe the session, never a person. Type it the same way for each learner of one group: the report counts how many distinct contexts responded. Only this campaign's report names them; the trainee and the committee see the count.">
                      <InputText id="msf-teaching-context" class="form-control" maxlength="200" aria-describedby="@FieldHelp.Id("msf-teaching-context")" @bind-Value="_invitee.TeachingContext" />
                    </FormField>
                  }
                </div>
                @* Disabled while an open or a withdraw is in flight (T202, T217). An invitee added mid-open would be left out
                   of the mailing yet stored on a campaign that is now open. That covers this tab; an invitee added from
                   another tab is refused, or refuses the open, at the save (T206). Not disabled by its own add: it may hold
                   the focus, which a refusal on a draft leaves where it was (T217); a second press while the add runs sends
                   nothing (AddInviteeAsync, T228 review). *@
                <FormActions>
                  <button type="submit" class="btn btn-outline" disabled="@(_opening || _withdrawing)">Add invitee</button>
                </FormActions>
              </EditForm>
            }

            @* What the state allows, and nothing else (T217): a draft opens or is withdrawn; an open campaign is withdrawn
               here or closed on its report, where its responses are; one under review is released on its report; a
               released campaign's report is there to read; a withdrawn campaign offers nothing. Withdraw is offered where
               the campaign list offers it (T206). *@
            @if (setup.State != MsfCampaignState.Withdrawn)
            {
              <FormActions>
                @if (CanWithdraw(setup))
                {
                  <button id="msf-withdraw-campaign" type="button" class="btn btn-outline" disabled="@Busy" @onclick="AskWithdrawAsync">Withdraw campaign</button>
                }
                @if (setup.State == MsfCampaignState.Draft && !HasInvitees(setup))
                {
                  @* T107's pattern (T225): shown, not hidden, with its reason below the row, which it names. No click
                     handler at all: pressing it could only be refused. Until T225 it was enabled, and the refusal came
                     only after the press. *@
                  <button id="msf-open-campaign" type="button" class="btn btn-primary" disabled aria-describedby="msf-open-reason">Open campaign</button>
                }
                else if (setup.State == MsfCampaignState.Draft)
                {
                  @* A second open would mail every respondent a second link (T202), so a click while one is in flight sends
                     nothing (OpenCampaignAsync). Disabled while a withdraw or an add is in flight, but not while its own
                     open runs (T225 review): it has the focus then, and a browser drops the focus of a button it disables,
                     to the page, where a refused open that leaves the button would leave it. *@
                  <button id="msf-open-campaign" type="button" class="btn btn-primary" disabled="@(_withdrawing || _adding)" @onclick="OpenCampaignAsync">
                    @(_opening ? "Opening campaign…" : "Open campaign")
                  </button>
                }
                else if (MsfCampaignText.ReportLinkLabel(setup.State) is { } reportLink)
                {
                  <a id="msf-campaign-report" class="btn btn-primary" href="@($"/msf/reports/{setup.CampaignId}")">@reportLink</a>
                }
              </FormActions>
              @if (setup.State == MsfCampaignState.Draft && !HasInvitees(setup))
              {
                <ul class="workflow-action-reasons">
                  <li id="msf-open-reason"><strong>Open campaign:</strong> @MsfCampaignText.OpenNeedsInvitees</li>
                </ul>
              }
            }
          }
        </StatePanel>
      }
    </section>
  }
</div>

@if (CampaignId.HasValue)
{
  @* A destructive action opens a ConfirmDialog first (DESIGN.md § Button system), worded as the campaign list's (T206). *@
  <ConfirmDialog @ref="_confirmWithdraw"
                 Title="@MsfCampaignText.WithdrawTitle"
                 Body="@WithdrawBody"
                 ConfirmLabel="@MsfCampaignText.WithdrawConfirmLabel"
                 DangerAction="true"
                 OnConfirm="WithdrawAsync" />
}

@code {
  [Parameter] public int? CampaignId { get; set; }

  private readonly List<MsfTemplateDto> _templates = [];
  private readonly List<TraineeProfileDto> _trainees = [];
  private readonly List<ActivityCatalogueOption> _epaOptions = [];

  /// <summary>
  /// The campaign being edited: whose it is, its questionnaire's kind, its state, whom it may invite (T164) and how many
  /// have been invited and have responded in each group (T217). Null on create, and for a campaign this caller does not
  /// run.
  /// </summary>
  private MsfCampaignSetupDto? _setup;

  /// <summary>The campaign has not been read yet: on the first visit, or after moving to another campaign's page.</summary>
  private bool _setupLoading = true;
  private string? _status;
  private string? _error;

  /// <summary>An open has been sent and has not yet answered. (T202)</summary>
  private bool _opening;

  /// <summary>A withdraw has been sent and has not yet answered. (T217)</summary>
  private bool _withdrawing;

  /// <summary>An invitee add has been sent and has not yet answered. (T228 review)</summary>
  private bool _adding;

  private ConfirmDialog? _confirmWithdraw;
  private ElementReference _result;

  /// <summary>
  /// An action has answered and the button that sent it is gone, so its result takes the focus after the next render.
  /// (T217)
  /// </summary>
  private bool _focusResult;

  /// <summary>The region holding an action's result, which takes the focus once it has answered. For its tests.</summary>
  internal ElementReference ResultRegion => _result;

  private InputText? _emailInput;
  private bool _focusEmail;

  internal ElementReference? EmailInput => _emailInput?.Element;

  /// <summary>An open, a withdraw or an invitee add is in flight, so nothing else may be sent. (T202, T217, T228 review)</summary>
  private bool Busy => _opening || _withdrawing || _adding;

  private TemplateFormModel _template = new();
  private CampaignFormModel _campaign = new();
  private InviteeFormModel _invitee = new();

  /// <summary>
  /// Whether the caller runs any campaign (<see cref="MsfCampaignRules.RunsCampaigns" />, T248): an Administrator, or a
  /// Coordinator at an institution, who does not hold Trainee (T224). Null until the caller is known, so neither form is
  /// shown to someone who is about to be told they cannot use it.
  /// </summary>
  private bool? _runsCampaigns;

  /// <summary>
  /// Why the caller runs no campaign, in the words the create and template commands refuse them in: holding Trainee
  /// (<see cref="MsfCampaignRules.TraineeRunsNoCampaigns" />), or else their roles
  /// (<see cref="MsfCampaignRules.RunsCampaignsRoles" />).
  /// </summary>
  private string _runsNoCampaignsReason = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    var principal = await GetPrincipalAsync();
    _runsCampaigns = MsfCampaignRules.RunsCampaigns(principal);
    _runsNoCampaignsReason = MsfCampaignRules.RunsNoCampaigns(principal)
      ? MsfCampaignRules.TraineeRunsNoCampaigns
      : MsfCampaignRules.RunsCampaignsRoles;
  }

  /// <remarks>
  /// The templates and the trainees are read only where a campaign is being created: a campaign's own page has neither
  /// the Quick template card nor the create form that lists them (T225, T248 review). Nor does the create page of someone
  /// who runs no campaign (T248).
  /// </remarks>
  protected override async Task OnParametersSetAsync()
  {
    if (!CampaignId.HasValue && _runsCampaigns is true)
    {
      await LoadTemplatesAsync();
      await LoadTraineesAsync();
    }

    await LoadSetupAsync();
  }

  /// <summary>
  /// The edited campaign as it is now: its state and invitee counts (T217), and its kind and accepted categories, so the
  /// invitee form offers only whom the invite command accepts (T164). Null for a campaign this caller does not run, as
  /// the report page answers; the commands refuse those.
  /// </summary>
  /// <remarks>
  /// Read again after every action on the page, whatever it answered: a refusal is likeliest because the campaign changed
  /// elsewhere (opened, withdrawn or closed), and the page should show what it is now. The campaign already shown stays
  /// in view while it is read again; only a first read, or another campaign's, shows the skeleton.
  /// </remarks>
  private async Task LoadSetupAsync()
  {
    if (!CampaignId.HasValue)
    {
      _setup = null;
      _setupLoading = false;
      return;
    }

    if (_setup?.CampaignId != CampaignId.Value)
    {
      _setup = null;
      _setupLoading = true;
    }

    try
    {
      _setup = await Sender.Send(new GetMsfCampaignSetupQuery(CampaignId.Value, await GetPrincipalAsync()));
      if (_setup is { AcceptedCategories.Count: > 0 } && !_setup.AcceptedCategories.Contains(_invitee.Category))
      {
        _invitee.Category = _setup.AcceptedCategories[0];
      }
    }
    catch (Exception exception)
    {
      // An action's refusal is kept over the failed read that follows it (T217 review): it says why the action was not
      // taken, and the card already says that the campaign could not be loaded.
      _setup = null;
      _error ??= exception.Message;
    }
    finally
    {
      _setupLoading = false;
    }
  }

  /// <summary>Whether the campaign has been opened, so that its responses are counted beside its invitees. (T217)</summary>
  private static bool ShowsResponses(MsfCampaignSetupDto setup) => setup.State != MsfCampaignState.Draft;

  /// <summary>A draft or an open campaign, the two the campaign list offers Withdraw on (T206).</summary>
  private static bool CanWithdraw(MsfCampaignSetupDto setup)
    => setup.State is MsfCampaignState.Draft or MsfCampaignState.Open;

  /// <summary>What the state means and what comes next, in one sentence built in C#. (T217)</summary>
  private string StateNote(MsfCampaignSetupDto setup)
  {
    var closesOn = setup.ClosesOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    return setup.State switch
    {
      MsfCampaignState.Draft => InviteesIntro,
      MsfCampaignState.Open =>
        $"Open. Each respondent has been emailed a link, which gives {closesOn} as their last day to respond. The " +
        "campaign closes by itself once that day has passed; to close it sooner, use Close campaign on its report.",
      MsfCampaignState.Closed or MsfCampaignState.UnderReview =>
        "Closed to responses, and every respondent's email address has been removed. Review the responses on its " +
        "report, and release it to the trainee there.",
      MsfCampaignState.Released => "The report has been released to the trainee.",
      _ =>
        "Withdrawn. It takes no responses, any link sent no longer works, and every respondent's email address has " +
        "been removed. It will never be released to the trainee."
    };
  }

  /// <summary>
  /// Whether anybody has been invited, so that the draft can be opened: the open handler refuses a campaign with no
  /// invitation (T225). The same test the "Nobody has been invited yet." line makes.
  /// </summary>
  private static bool HasInvitees(MsfCampaignSetupDto setup) => setup.Invitees.Count > 0;

  /// <summary>The campaign as the withdraw dialog and its result name it, as the campaign list does (T206).</summary>
  private static string Described(MsfCampaignSetupDto setup)
    => MsfCampaignText.Describe(setup.SubjectName ?? "the trainee", setup.TemplateName, setup.ClosesOn);

  private string WithdrawBody => _setup is null ? string.Empty : MsfCampaignText.WithdrawBody(Described(_setup));

  /// <summary>
  /// The categories the invitee picker offers: the edited campaign's, or, until it has loaded, every category a
  /// multi-source feedback campaign accepts.
  /// </summary>
  private IReadOnlyList<MsfRespondentCategory> AcceptedCategories
    => _setup?.AcceptedCategories
       ?? Enum.GetValues<MsfRespondentCategory>().Where(category => category != MsfRespondentCategory.Learner).ToArray();

  /// <summary>The template chosen on the create form, or null.</summary>
  private MsfTemplateDto? SelectedTemplate
    => _templates.FirstOrDefault(template => template.Id == _campaign.TemplateId);

  /// <summary>Whether the create form's chosen template is learner feedback (T164).</summary>
  private bool IsLearnerFeedback => SelectedTemplate?.Kind == MsfTemplateKind.LearnerFeedback;

  private string MinimumCategoriesHelp => IsLearnerFeedback
    ? "Learner feedback has one respondent group, learners, so it is always one."
    : "How many respondent groups must clear the threshold above before the report can be released. Two is the College's answer: eight peer doctors alone are not multi-source feedback.";

  private string EpasHelp => IsLearnerFeedback
    ? "Learner feedback is evidence only for an EPA whose College list names it (on v11.1, PAED-015). Each one selected here becomes a separate learner-feedback record on the trainee's portfolio when the report is released."
    : "One campaign covers many EPAs and runs once a semester. Each one selected here becomes a separate evidence record on the trainee's portfolio when the report is released.";

  private string NoEpasText => IsLearnerFeedback
    ? "No EPA on this trainee's curriculum names learner feedback as an instrument, so a learner-feedback campaign cannot be recorded as evidence for anything."
    : "This trainee's curriculum lists no EPAs, so a campaign cannot be recorded as evidence for anything.";

  private string InviteesIntro => _setup?.Kind == MsfTemplateKind.LearnerFeedback
    ? "Add the learners the trainee taught, each with where they were taught, then open the campaign to send anonymous response links."
    : "Add invitees, then open the campaign to send anonymous response links.";

  private static string TemplateLabel(MsfTemplateDto template)
    => template.Kind == MsfTemplateKind.LearnerFeedback
      ? $"{template.Name} ({MsfEvidenceKinds.Describe(template.Kind)})"
      : template.Name;

  /// <summary>
  /// A new template choice can change which EPAs the campaign may cover, and learner feedback has one respondent group,
  /// so both follow the template. So does the response minimum while it is still the other kind's default: eight is
  /// multi-source feedback's, and a learner-feedback campaign left at it could not be released with fewer than eight
  /// learners. A minimum the coordinator typed is kept. (T164)
  /// </summary>
  private async Task OnCampaignTemplateChangedAsync()
  {
    var kind = SelectedTemplate?.Kind ?? MsfTemplateKind.Msf;
    if (kind != _campaignKind)
    {
      if (_campaign.MinimumResponses == CampaignFormModel.DefaultMinimumResponsesFor(_campaignKind))
      {
        _campaign.MinimumResponses = CampaignFormModel.DefaultMinimumResponsesFor(kind);
      }

      _campaignKind = kind;
    }

    _campaign.MinimumRespondentCategories = IsLearnerFeedback ? 1 : CampaignFormModel.DefaultMinimumRespondentCategories;
    await LoadEpaOptionsAsync();
  }

  /// <summary>The kind of the template the create form's defaults were last set for.</summary>
  private MsfTemplateKind _campaignKind = MsfTemplateKind.Msf;

  /// <summary>
  /// Swaps the quick template's wording for the other kind's, unless the coordinator has already changed it. Learner
  /// feedback has no College questionnaire yet, so its wording is labelled interim. (T164)
  /// </summary>
  private void OnTemplateKindChanged()
  {
    var other = _template.Kind == MsfTemplateKind.LearnerFeedback ? MsfTemplateKind.Msf : MsfTemplateKind.LearnerFeedback;
    var from = TemplateFormModel.DefaultsFor(other);
    var to = TemplateFormModel.DefaultsFor(_template.Kind);

    if (_template.Name == from.Name)
    {
      _template.Name = to.Name;
    }

    if (_template.ScalePrompt == from.ScalePrompt)
    {
      _template.ScalePrompt = to.ScalePrompt;
    }

    if (_template.CommentPrompt == from.CommentPrompt)
    {
      _template.CommentPrompt = to.CommentPrompt;
    }
  }

  private async Task LoadTemplatesAsync()
  {
    _templates.Clear();
    _templates.AddRange(await Sender.Send(new ListMsfTemplatesQuery()));
  }

  /// <summary>
  /// The trainees the create accepts (<see cref="ListMsfCampaignSubjectsQuery" />, T238): the current trainees at the
  /// caller's institution, or everywhere for an Administrator, less the ones
  /// <see cref="MsfCampaignRules.IsKeptFromCampaignsAbout" /> keeps the caller from (T224): never the caller themselves.
  /// Read only on the create page of someone who runs campaigns (T248): nobody is read for anyone else, or on a campaign's
  /// own page, which has no create form. The EPA picker reads only a trainee offered here.
  /// </summary>
  /// <remarks>
  /// The query leaves out whom the exclusions keep out already; the page asks them again because they read nothing, so
  /// the caller is never offered whatever the list holds. Until T238 the list was every trainee profile at the caller's
  /// institution, so it offered graduates, trainees who had withdrawn and a trainee who now trains elsewhere, whom the
  /// create refused.
  /// </remarks>
  private async Task LoadTraineesAsync()
  {
    _trainees.Clear();
    var principal = await GetPrincipalAsync();
    _trainees.AddRange((await Sender.Send(new ListMsfCampaignSubjectsQuery(principal)))
      .Where(trainee => !MsfCampaignRules.IsKeptFromCampaignsAbout(principal, trainee.UserId)));
  }

  /// <summary>
  /// The EPAs this trainee's own curriculum lists. Deliberately the strict list, with no fallback to the
  /// coordinator's own scope: release re-applies exactly this predicate, so an EPA offered here that
  /// release would silently drop would be a picker that lies.
  /// </summary>
  /// <remarks>
  /// Only for a trainee the picker offered. The select's value arrives from the browser, and the reference
  /// service answers any id it is given, so a value edited in the page would otherwise read another institution's
  /// trainee's curriculum, and confirm that the id names someone. (T113)
  /// </remarks>
  private async Task LoadEpaOptionsAsync()
  {
    _epaOptions.Clear();
    _campaign.EpaIds.Clear();

    if (string.IsNullOrWhiteSpace(_campaign.SubjectUserId) ||
        !_trainees.Any(trainee => string.Equals(trainee.UserId, _campaign.SubjectUserId, StringComparison.Ordinal)))
    {
      return;
    }

    try
    {
      // With the template's instrument, so learner feedback is offered only the EPAs whose list names it: the same
      // question the create command and the release ask (MsfCampaignRules.CoverableEpaIdsAsync, T164).
      var kind = SelectedTemplate?.Kind ?? MsfTemplateKind.Msf;
      _epaOptions.AddRange(await ReferenceData.GetSubjectCurriculumEpaOptionsAsync(
        _campaign.SubjectUserId, MsfEvidenceKinds.CoverageToolKeyFor(kind)));
    }
    catch (Exception exception)
    {
      _error = exception.Message;
    }
  }

  private void ToggleEpa(string value, bool isChecked)
  {
    var epaId = ParseEpaId(value);
    if (epaId <= 0)
    {
      return;
    }

    if (isChecked)
    {
      if (!_campaign.EpaIds.Contains(epaId))
      {
        _campaign.EpaIds.Add(epaId);
      }
    }
    else
    {
      _campaign.EpaIds.Remove(epaId);
    }
  }

  private static int ParseEpaId(string value)
    => int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var epaId) ? epaId : 0;

  private static string TraineeLabel(TraineeProfileDto trainee)
  {
    var name = string.Join(" ", new[] { trainee.FirstName, trainee.LastName }.Where(part => !string.IsNullOrWhiteSpace(part)));
    return string.IsNullOrWhiteSpace(name) ? trainee.Email : $"{name} ({trainee.Email})";
  }

  private async Task CreateTemplateAsync()
  {
    _error = null;
    _status = null;

    try
    {
      await Sender.Send(new CreateMsfTemplateCommand(
        _template.Name,
        null,
        _template.AllowPatientResponses,
        [
          new CreateMsfTemplateQuestionItem(_template.ScalePrompt, MsfQuestionType.Scale, null, true),
          new CreateMsfTemplateQuestionItem(_template.CommentPrompt, MsfQuestionType.LongText, null, false)
        ],
        await GetPrincipalAsync(),
        _template.Kind));

      _template = new();
      await LoadTemplatesAsync();
      _status = "Template created.";
    }
    catch (Exception exception)
    {
      _error = exception.Message;
    }
  }

  private async Task CreateCampaignAsync()
  {
    _error = null;
    _status = null;

    try
    {
      var principal = await GetPrincipalAsync();
      var result = await Sender.Send(new CreateMsfCampaignCommand(
        _campaign.SubjectUserId,
        _campaign.TemplateId ?? 0,
        _campaign.OpensOn,
        _campaign.ClosesOn,
        _campaign.MinimumResponses,
        _campaign.MinimumCategoryResponses,
        _campaign.MinimumRespondentCategories,
        _campaign.EpaIds.ToArray(),
        GetUserId(principal),
        principal));

      NavigationManager.NavigateTo($"/msf/campaigns/{result.Id}");
    }
    catch (Exception exception)
    {
      _error = exception.Message;
    }
  }

  /// <remarks>
  /// Sent at most once at a time, as the open is (T202): the flag is set before the first await, so a second Enter or
  /// click that reaches the circuit while this add runs does nothing, and Open and Withdraw campaign wait for it too.
  /// Until the T228 review a double press sent the same address twice: the server now stores it once, but the page
  /// showed "Invitee added." beside the second add's "already invites" refusal, which was read last, with the address
  /// already cleared.
  /// </remarks>
  private async Task AddInviteeAsync()
  {
    if (!CampaignId.HasValue || Busy)
    {
      return;
    }

    _adding = true;
    _error = null;
    _status = null;

    try
    {
      await Sender.Send(new AddMsfInvitationCommand(
        CampaignId.Value,
        _invitee.Email,
        _invitee.Category,
        await GetPrincipalAsync(),
        _invitee.Category == MsfRespondentCategory.Learner ? _invitee.TeachingContext : null));

      // The next learner is usually from the same group, so the category and the context are kept for them. The model
      // is cleared in place: a new one would make EditForm rebuild its content, and the control that had the focus with
      // it, leaving the focus on the page body (F2 browser check).
      _invitee.Email = string.Empty;
      _status = "Invitee added.";
      _focusEmail = true;
    }
    catch (Exception exception)
    {
      _error = exception.Message;
    }

    try
    {
      // The counts include the invitee just added; after a refusal, the campaign may have been opened elsewhere (T217).
      await LoadSetupAsync();
    }
    finally
    {
      _adding = false;
    }

    // A campaign no longer a draft has no invitee form, so the submit button that had the focus is gone (T217 review).
    // On a draft the form stays. After an add the focus goes to the email, for the next invitee; after a refusal it
    // stays where it was, to correct this one.
    _focusResult = _setup is not { State: MsfCampaignState.Draft };
    _focusEmail &= !_focusResult;
  }

  /// <remarks>
  /// <para>
  /// Sent at most once at a time (T202). The flag is set before the first await, and a click that finds it set does
  /// nothing. Until the T225 review the button was also disabled while its open ran, which was never enough on its own
  /// (a second click can leave the browser before the render that disables it arrives) and dropped the focus to the page.
  /// Before T202 a double-click raced two opens, and every respondent was mailed two links, one of them dead.
  /// </para>
  /// <para>
  /// The campaign is read again before the flag is released (T217), so the page shows it open, with no Open button,
  /// the moment the open answers. Until T217 the page was never read again, and it went on offering Open. The result
  /// takes the focus whenever the campaign is no longer a draft, opened here or elsewhere, because the Open button that
  /// had it is gone. A refused open on a campaign still a draft leaves the button, and the focus on it, for the retry a
  /// failed send asks for (T184).
  /// </para>
  /// </remarks>
  private async Task OpenCampaignAsync()
  {
    if (!CampaignId.HasValue || Busy)
    {
      return;
    }

    _opening = true;
    _error = null;
    _status = null;

    try
    {
      await Sender.Send(new OpenMsfCampaignCommand(CampaignId.Value, await GetPrincipalAsync()));
      // It used to name the development sender, which only logs a mail, on every host: a coordinator whose host has a
      // mail server was told the links had gone to a log. (T184)
      _status = "Campaign opened, and each respondent has been emailed a link to respond.";
    }
    catch (Exception exception)
    {
      _error = exception.Message;
    }

    try
    {
      await LoadSetupAsync();
    }
    finally
    {
      // Released on a refusal too: a failed send asks the coordinator to open the campaign again (T184).
      _opening = false;
    }

    _focusResult = _setup is not { State: MsfCampaignState.Draft };
  }

  private async Task AskWithdrawAsync()
  {
    if (Busy || _setup is null)
    {
      return;
    }

    _status = null;
    _error = null;

    if (_confirmWithdraw is not null)
    {
      await _confirmWithdraw.ShowAsync();
    }
  }

  /// <remarks>
  /// Sent at most once at a time, as the open is (T202): the flag is set before the first await, so a second confirm that
  /// reaches the circuit before the re-render does nothing. The result takes the focus whatever it was, as on the
  /// campaign list (T206 review): a withdrawn campaign's Withdraw button is gone. (T217)
  /// </remarks>
  private async Task WithdrawAsync()
  {
    if (!CampaignId.HasValue || _setup is not { } campaign || Busy)
    {
      return;
    }

    _withdrawing = true;
    _status = null;
    _error = null;

    try
    {
      await Sender.Send(new WithdrawMsfCampaignCommand(CampaignId.Value, await GetPrincipalAsync()));
      _status = MsfCampaignText.Withdrawn(Described(campaign));
    }
    catch (Exception exception)
    {
      _error = exception.Message;
    }

    try
    {
      await LoadSetupAsync();
    }
    finally
    {
      _withdrawing = false;
    }

    _focusResult = true;
  }

  /// <remarks>
  /// After a withdraw, the focus moves once the browser has acknowledged the render that follows it. By then the dialog
  /// is closed: ConfirmDialog asks the browser to close it as soon as <see cref="WithdrawAsync" /> returns, and while a
  /// modal dialog is open nothing outside it can take the focus (T206 review).
  /// </remarks>
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusResult)
    {
      _focusResult = false;
      await _result.FocusAsync();
    }
    else if (_focusEmail && _emailInput?.Element is { } email)
    {
      _focusEmail = false;
      await email.FocusAsync();
    }
  }

  private sealed class TemplateFormModel
  {
    public MsfTemplateKind Kind { get; set; } = MsfTemplateKind.Msf;

    [Required]
    [MaxLength(200)]
    public string Name { get; set; } = DefaultsFor(MsfTemplateKind.Msf).Name;

    [Required]
    [MaxLength(1000)]
    public string ScalePrompt { get; set; } = DefaultsFor(MsfTemplateKind.Msf).ScalePrompt;

    [Required]
    [MaxLength(1000)]
    public string CommentPrompt { get; set; } = DefaultsFor(MsfTemplateKind.Msf).CommentPrompt;

    public bool AllowPatientResponses { get; set; }

    /// <summary>
    /// The wording a new template starts with. Learner feedback's is labelled interim: the College has supplied no
    /// questionnaire for it (T164).
    /// </summary>
    public static (string Name, string ScalePrompt, string CommentPrompt) DefaultsFor(MsfTemplateKind kind)
      => kind == MsfTemplateKind.LearnerFeedback
        ? ("Learner feedback (interim questionnaire)",
           "Rates the trainee's teaching overall.",
           "What should the trainee keep doing or change in their teaching?")
        : ("Default MSF",
           "Rates the trainee's overall professional performance.",
           "What should the trainee keep doing or improve?");
  }

  private sealed class CampaignFormModel
  {
    [Required]
    public string SubjectUserId { get; set; } = string.Empty;

    [Required]
    public int? TemplateId { get; set; }

    [Required]
    public DateOnly OpensOn { get; set; } = DateOnly.FromDateTime(DateTime.Today);

    [Required]
    public DateOnly ClosesOn { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(14));

    [Range(1, 100)]
    public int MinimumResponses { get; set; } = DefaultMinimumResponsesFor(MsfTemplateKind.Msf);

    /// <summary>
    /// The response minimum a campaign of this kind starts with: eight for multi-source feedback; for learner feedback,
    /// three, the default category threshold below, which its one group must clear to report anything (T164).
    /// </summary>
    public static int DefaultMinimumResponsesFor(MsfTemplateKind kind)
      => kind == MsfTemplateKind.LearnerFeedback ? 3 : 8;

    [Range(1, 100)]
    public int MinimumCategoryResponses { get; set; } = 3;

    /// <summary>College decision D11's two groups, for multi-source feedback; learner feedback has one (T164).</summary>
    public const int DefaultMinimumRespondentCategories = 2;

    [Range(1, 6)]
    public int MinimumRespondentCategories { get; set; } = DefaultMinimumRespondentCategories;

    [MinLength(1, ErrorMessage = "Select at least one EPA this campaign is evidence for.")]
    public List<int> EpaIds { get; } = [];
  }

  private sealed class InviteeFormModel
  {
    [Required]
    [EmailAddress]
    public string Email { get; set; } = string.Empty;

    [Required]
    public MsfRespondentCategory Category { get; set; } = MsfRespondentCategory.PeerDoctor;

    /// <summary>Where a learner was taught; sent only for a Learner (T164).</summary>
    [MaxLength(200)]
    public string? TeachingContext { get; set; }
  }

  private async Task<ClaimsPrincipal> GetPrincipalAsync()
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    return authState.User;
  }

  private static string GetUserId(ClaimsPrincipal principal)
    => principal.FindFirst(ClaimTypes.NameIdentifier)?.Value
      ?? throw new InvalidOperationException("The current user identifier is missing.");
}

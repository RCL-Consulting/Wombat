@page "/msf/campaigns/{CampaignId:int}"
@using System.Security.Claims
@attribute [Authorize(Roles = "Coordinator,Administrator")]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<CampaignEdit> Logger

<PageTitle>@Heading · Wombat</PageTitle>

@* T369 (flow 10, K1–K22): a campaign's page. The create form went to New MSF campaign (NewCampaign.razor); this page is
   the status card, a draft's addresses, and About this campaign, in the page column (.msf-page) that holds its dialogs. *@
<div class="msf-header">
  <PageHeader Title="@Heading" Subtitle="@Subtitle" />
</div>

<div class="msf-page">
  @* Someone who holds Trainee runs no campaign, whatever role brought them here (MsfCampaignRules.RunsNoCampaigns, T224);
     nor does a Coordinator at no institution (MsfCampaignRules.RunsCampaigns, T248). Standing content, in the words the
     commands refuse them in: the page answers them as unavailable, which alone would not say why. *@
  @if (_runsCampaigns is false)
  {
    <Alert Id="msf-runs-no-campaigns" Kind="warning" Role="">@_runsNoCampaignsReason</Alert>
  }

  @* What an action did, wherever the button that sent it is gone: an open, a withdraw, and a refusal of an action on a
     campaign that changed elsewhere (T217). It takes the focus once the action has answered (T234). *@
  <ActionResult @ref="_result" Id="msf-campaign-result">
    @if (_status is not null)
    {
      <Alert Kind="success" Role="status"><strong>@_status</strong> @_statusDetail</Alert>
    }
    @if (_refusal is not null)
    {
      <Alert Kind="danger" Role="alert"><strong>@_refusalLead</strong> @_refusal</Alert>
    }
  </ActionResult>

  @* T329: a failed read is a fixed sentence with Try again (K18), never the exception's text; loading shows the header
     at once and no action until the read is in (K17). *@
  <StatePanel IsLoading="_loading" LoadError="@_loadError" OnRetry="RetryAsync">
    <LoadingContent>
      <section class="detail-card detail-card--emphasis" aria-busy="true">
        <p class="visually-hidden" role="status">@MsfCampaignText.CampaignLoading</p>
        <Skeleton Count="3" Height="3rem" />
      </section>
      <section class="detail-card">
        <Skeleton Count="2" Height="3rem" />
      </section>
    </LoadingContent>
    <ChildContent>
      @if (_setup is not { } setup)
      {
        @* K16: no such campaign, or one this caller does not run, alike (T113). *@
        <div id="msf-campaign-unavailable" class="detail-card detail-card--empty">
          <div class="state-panel-copy">@MsfCampaignText.CampaignUnavailableBody</div>
          <div class="form-actions msf-centre">
            <a class="btn btn-outline" href="@MsfLinks.Campaigns">@MsfCampaignText.GoToCampaigns</a>
          </div>
        </div>
      }
      else
      {
        @StatusCard(setup)
        @if (setup.State == MsfCampaignState.Draft)
        {
          @Addresses(setup)
        }
        @About(setup)
      }
    </ChildContent>
  </StatePanel>

  @* A destructive action opens a ConfirmDialog first (DESIGN.md § Button system), worded as the campaign list's (T206),
     its safe button saying what it keeps (K10). Inside the page column, so its buttons stack at 390, the action on top
     (M10). *@
  <ConfirmDialog @ref="_confirmWithdraw"
                 Title="@MsfCampaignText.WithdrawTitle"
                 Body="@WithdrawBody"
                 ConfirmLabel="@MsfCampaignText.WithdrawConfirmLabel"
                 CancelLabel="@MsfCampaignText.KeepCampaignLabel"
                 DangerAction="true"
                 OnConfirm="WithdrawAsync" />

  @* One dialog for every draft invitee's Remove, naming the row it was opened from (DESIGN.md § Button system, T247). *@
  <ConfirmDialog @ref="_confirmRemove"
                 Title="@MsfCampaignText.RemoveInviteeTitle"
                 Body="@RemoveBody"
                 ConfirmLabel="@MsfCampaignText.RemoveInviteeConfirmLabel"
                 CancelLabel="@MsfCampaignText.KeepInviteeLabel"
                 DangerAction="true"
                 OnConfirm="RemoveAsync"
                 OnCancel="CancelRemove" />
</div>

@code {
  /// <summary>
  /// The status card (F7): the state's badge and sentence on its stripe, what it means, the invitees counted by
  /// respondent group (never a row per invitee once it has opened, T217), the Links part while open (T251), and the
  /// actions the state allows, each refusal beside the button that was pressed (K20–K22).
  /// </summary>
  private RenderFragment StatusCard(MsfCampaignSetupDto setup) => __builder =>
  {
    var invited = setup.Invitees.Sum(group => group.Invited);
    var responded = setup.Invitees.Sum(group => group.Responded);
    var note = MsfCampaignText.StatusNote(setup.State, setup.ClosesOn);
    <section id="msf-campaign-status" class="@StatusCardClass(setup.State)" aria-labelledby="msf-status-line">
      <div class="status-head">
        <span id="msf-campaign-state" class="badge @BadgeFor.MsfCampaign(setup.State)">@MsfCampaignText.State(setup.State)</span>
        <h2 id="msf-status-line" class="status-line">@MsfCampaignText.StatusLine(setup.State, responded, invited)</h2>
      </div>
      @* K14 (Q10): the release still records the evidence, but the trainee can no longer read it. Standing content. *@
      @if (setup.SubjectEndedOn is { } endedOn && setup.State is MsfCampaignState.Open or MsfCampaignState.Closed or MsfCampaignState.UnderReview)
      {
        <Alert Id="msf-programme-ended" Kind="warning" Role="">@MsfCampaignText.ProgrammeEnded(SubjectName(setup), endedOn)</Alert>
      }
      @if (note is not null)
      {
        <p class="status-note">@note</p>
      }
      @if (setup.Invitees.Count == 0)
      {
        <p id="msf-invitees-none" class="status-note">@(setup.State == MsfCampaignState.Draft ? MsfCampaignText.NobodyInvitedYet : MsfCampaignText.NobodyInvited)</p>
        @if (setup.State == MsfCampaignState.Draft)
        {
          <p class="field-help">@MsfCampaignText.DraftNeverLists</p>
        }
      }
      else if (setup.State == MsfCampaignState.Open)
      {
        <div class="status-split">
          <div>
            <h3 class="section-title section-title--h3">@MsfCampaignText.CountsHeading</h3>
            @Counts(setup)
          </div>
          @Links(setup)
        </div>
      }
      else
      {
        <div class="count-box">
          @if (setup.State != MsfCampaignState.Draft)
          {
            <h3 class="section-title section-title--h3">@MsfCampaignText.CountsHeading</h3>
          }
          @Counts(setup)
        </div>
      }
      @if (setup.State != MsfCampaignState.Withdrawn)
      {
        <div class="status-actions">
          @* A refusal heads the actions it answers, above the buttons, as the report's do (build review D7). *@
          @if (_openRefusal is not null)
          {
            <Alert Kind="danger" Role="alert"><strong>@MsfCampaignText.NotOpened</strong> @_openRefusal</Alert>
          }
          @if (_withdrawRefusal is not null)
          {
            <Alert Kind="danger" Role="alert"><strong>@MsfCampaignText.NotWithdrawn</strong> @_withdrawRefusal</Alert>
          }
          @if (setup.State == MsfCampaignState.Draft)
          {
            @if (OpenUnavailableReason(setup) is not null)
            {
              @* T107's pattern (T225, K1, K13): shown, unavailable, its reason beside it; no click handler, since
                 pressing it could only be refused. *@
              <button id="msf-open-campaign" type="button" class="btn btn-primary" aria-disabled="true"
                      aria-describedby="msf-open-reason"><Icon Name="mail" />Open campaign</button>
            }
            else
            {
              @* A second open would mail every respondent a second link (T202), so a press while one is in flight
                 sends nothing (OpenCampaignAsync). Never disabled (T234): it keeps the focus, which a refused open
                 leaves on it for the retry a failed send asks for (T184, K20). *@
              <button id="msf-open-campaign" type="button" class="btn btn-primary"
                      aria-disabled="@InFlight.AriaDisabled(_opening)" @onclick="OpenCampaignAsync">
                <Icon Name="mail" />@(_opening ? "Opening campaign…" : "Open campaign")
              </button>
            }
          }
          else if (MsfCampaignText.ReportLinkLabel(setup.State) is { } reportLink)
          {
            <a id="msf-campaign-report" class="btn btn-primary" href="@MsfLinks.Report(setup.CampaignId)">@reportLink</a>
          }
          @if (MsfCampaignRules.IsWithdrawable(setup.State))
          {
            @* Withdraw is where the campaign list offers it (T206): on every campaign not yet released. *@
            <button @ref="_withdrawButton" id="msf-withdraw-campaign" type="button" class="btn btn-outline"
                    @onclick="AskWithdrawAsync">@MsfCampaignText.WithdrawCampaignLabel</button>
          }
          @if (setup.State == MsfCampaignState.Draft)
          {
            @if (OpenUnavailableReason(setup) is { } reason)
            {
              <ul class="move-reasons">
                <li id="msf-open-reason"><strong>Open campaign:</strong> @reason</li>
              </ul>
            }
            else
            {
              <p id="msf-opening-emails" class="field-help">@MsfCampaignText.OpeningEmails(invited, setup.ClosesOn)</p>
            }
          }
        </div>
      }
    </section>
  };

  /// <summary>
  /// The invitees counted by respondent group (T217), unstacked at every width (S13), with "All groups" under them.
  /// Responded only once the campaign has opened (T270): a draft, and a draft withdrawn, have no responses to count.
  /// </summary>
  private RenderFragment Counts(MsfCampaignSetupDto setup) => __builder =>
  {
    var showsResponses = setup.HasOpened;
    <div class="table-container">
      <table id="msf-invitee-counts" class="clinic-table count-table">
        <caption><span class="anon-caption"><Icon Name="eye-off" /><span>@MsfCampaignText.CountsCaption(setup.State)</span></span></caption>
        <thead>
          <tr>
            <th scope="col">Respondent group</th>
            <th scope="col" class="num">Invited</th>
            @if (showsResponses)
            {
              <th scope="col" class="num">Responded</th>
            }
          </tr>
        </thead>
        <tbody>
          @foreach (var group in setup.Invitees)
          {
            <tr>
              <th scope="row">@MsfRespondentCategories.Describe(group.Category)</th>
              <td class="num">@group.Invited</td>
              @if (showsResponses)
              {
                <td class="num">@group.Responded</td>
              }
            </tr>
          }
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">@MsfCampaignText.AllGroups</th>
            <td class="num">@setup.Invitees.Sum(group => group.Invited)</td>
            @if (showsResponses)
            {
              <td class="num">@setup.Invitees.Sum(group => group.Responded)</td>
            }
          </tr>
        </tfoot>
      </table>
    </div>
  };

  /// <summary>
  /// What became of the links while the campaign is open (T251): counts, never whose (T217). Resend sits in the warning
  /// it acts on; its result, done or refused, comes under it (K8, K22), and the hour rule says what "not delivered" means.
  /// Nothing is drawn when every link was sent and nothing was resent.
  /// </summary>
  private RenderFragment Links(MsfCampaignSetupDto setup) => __builder =>
  {
    var resendShown = _resendStatus is not null || _resendRefusal is not null;
    if (setup.LinksNotDelivered == 0 && setup.LinksBeingSent == 0 && !resendShown)
    {
      return;
    }

    <div id="msf-links" class="links-part">
      <h3 class="section-title section-title--h3">@MsfCampaignText.LinksHeading</h3>
      @if (setup.LinksNotDelivered > 0)
      {
        @* Standing content, so the warning has no role: it is there on every visit until the links are sent again. *@
        <Alert Id="msf-links-not-delivered" Kind="warning" Role="">
          <div class="alert-row">
            <span class="alert-row-text">@MsfCampaignText.LinksNotDelivered(setup.LinksNotDelivered)</span>
            @* Not disabled by its own resend (T234): it has the focus, and a second press sends nothing. *@
            <button id="msf-resend-links" type="button" class="btn btn-outline btn-sm"
                    aria-disabled="@InFlight.AriaDisabled(_resending)" @onclick="ResendLinksAsync">
              <Icon Name="mail" />@(_resending ? "Resending links…" : MsfCampaignText.ResendLinksLabel(setup.LinksNotDelivered))
            </button>
          </div>
        </Alert>
      }
      <ActionResult @ref="_linksResult" Id="msf-links-result">
        @if (_resendStatus is not null)
        {
          <Alert Kind="success" Role="status"><strong>@_resendStatus</strong></Alert>
        }
        @if (_resendRefusal is not null)
        {
          <Alert Kind="danger" Role="alert"><strong>@MsfCampaignText.NotResent</strong> @_resendRefusal</Alert>
        }
      </ActionResult>
      @if (setup.LinksBeingSent > 0)
      {
        <Alert Id="msf-links-being-sent" Kind="info">@MsfCampaignText.LinksBeingSent(setup.LinksBeingSent)</Alert>
      }
      @if (setup.LinksNotDelivered > 0 || resendShown)
      {
        <p class="field-help">@MsfCampaignText.LinksHourRule</p>
      }
    </div>
  };

  /// <summary>
  /// A draft's addresses, for Remove (T247): the add form, then the list, an address over its group in each item with
  /// Remove beside it (T270: no table to scroll at 390). Only on a draft, whose invitees hold no working link and have
  /// given no response, so a row here says nothing about anyone's answers (MsfCampaignSetupDto.DraftInvitees).
  /// </summary>
  private RenderFragment Addresses(MsfCampaignSetupDto setup) => __builder =>
  {
    var current = setup.SubjectIsCurrent;
    var learner = setup.Kind == MsfTemplateKind.LearnerFeedback;
    <section id="msf-addresses" class="detail-card msf-stack-card" aria-labelledby="msf-addresses-heading">
      <div>
        <h2 id="msf-addresses-heading" class="section-title">@MsfCampaignText.AddressesHeading</h2>
        <p class="field-help">@MsfCampaignText.AddressesNote</p>
      </div>
      @* novalidate (S4): the email field is type="email", and the page, not the browser, refuses it in its words. *@
      <EditForm Model="_invitee" OnSubmit="AddInviteeAsync" FormName="msf-invitee" class="add-form"
                aria-labelledby="msf-add-heading" novalidate>
        <h3 id="msf-add-heading" class="section-title section-title--h3">@MsfCampaignText.AddInviteeHeading</h3>
        <p class="field-help">@MsfCampaignText.RequiredMarkLine</p>
        @if (_addStatus is not null)
        {
          <Alert Id="msf-add-result" Kind="success" Role="status">@_addStatus</Alert>
        }
        <div class="add-invitee">
          <div class="form-group">
            <label for="msf-respondent-email">Respondent email<span class="required-mark" aria-hidden="true"> *</span></label>
            @* K13: natively disabled while the trainee is not current, since nothing can be sent. *@
            <input @ref="_emailInput" id="msf-respondent-email" type="email" maxlength="320"
                   class="@(_emailError is null ? "form-control" : "form-control input-validation-error")"
                   aria-required="true" aria-invalid="@(_emailError is null ? null : "true")"
                   aria-describedby="@(_emailError is not null ? "msf-respondent-email-error" : _addStatus is not null ? "msf-add-result" : null)"
                   disabled="@(!current)" @bind="_invitee.Email" />
            @if (_emailError is not null)
            {
              <p id="msf-respondent-email-error" class="validation-message">@_emailError</p>
            }
          </div>
          @if (learner)
          {
            <div class="form-group">
              <label for="msf-teaching-context">Teaching context<span class="required-mark" aria-hidden="true"> *</span></label>
              <input @ref="_contextInput" id="msf-teaching-context" maxlength="200"
                     class="@(_contextError is null ? "form-control" : "form-control input-validation-error")"
                     aria-required="true" aria-invalid="@(_contextError is null ? null : "true")"
                     aria-describedby="@(_contextError is null ? "msf-teaching-context-help" : "msf-teaching-context-help msf-teaching-context-error")"
                     disabled="@(!current)" @bind="_invitee.TeachingContext" />
              @if (_contextError is not null)
              {
                <p id="msf-teaching-context-error" class="validation-message">@_contextError</p>
              }
            </div>
          }
          else
          {
            @* Only the respondent groups this campaign's questionnaire accepts, which the invite command holds it to
               (T164), each by its label (T191), in the enum's order, Peer doctor chosen (M2). No mark: it always holds
               a value. *@
            <div class="form-group">
              <label for="msf-respondent-category">Respondent group</label>
              <select id="msf-respondent-category" class="form-select" disabled="@(!current)" @bind="_invitee.Category">
                @foreach (var category in setup.AcceptedCategories)
                {
                  <option value="@category">@MsfRespondentCategories.Describe(category)</option>
                }
              </select>
            </div>
          }
          @if (current)
          {
            @* Not disabled while it runs (T234, T228 review): it may hold the focus, and a second press while the add
               runs sends nothing (AddInviteeAsync). *@
            <button id="msf-add-invitee" type="submit" class="btn btn-outline" aria-disabled="@InFlight.AriaDisabled(_adding)">Add invitee</button>
          }
          else
          {
            <button id="msf-add-invitee" type="button" class="btn btn-outline" aria-disabled="true"
                    aria-describedby="msf-add-reason">Add invitee</button>
          }
        </div>
        @if (learner)
        {
          <p id="msf-teaching-context-help" class="field-help">@MsfCampaignText.LearnerInviteesNote</p>
        }
        @if (!current)
        {
          <ul class="move-reasons">
            <li id="msf-add-reason"><strong>Add invitee:</strong> @MsfCampaignText.AddNeedsCurrentTrainee(SubjectName(setup))</li>
          </ul>
        }
      </EditForm>
      @* A remove's result, done or refused, above the rows it changed (K4); it takes the focus, since the row's button is
         gone after a remove. *@
      <ActionResult @ref="_rowsResult" Id="msf-addresses-result">
        @if (_removeStatus is not null)
        {
          <Alert Kind="success" Role="status">@_removeStatus</Alert>
        }
        @if (_removeRefusal is not null)
        {
          <Alert Kind="danger" Role="alert"><strong>@MsfCampaignText.NotRemoved</strong> @_removeRefusal</Alert>
        }
      </ActionResult>
      <h3 id="msf-address-count" class="section-title section-title--h3">@MsfCampaignText.AddressCount(setup.DraftInvitees.Count)</h3>
      @if (setup.DraftInvitees.Count == 0)
      {
        <p class="field-help">@MsfCampaignText.NoAddressYet</p>
      }
      else
      {
        <ul id="msf-draft-invitees" class="invitee-rows" aria-labelledby="msf-address-count">
          @foreach (var invitee in setup.DraftInvitees)
          {
            var at = invitee.Email.IndexOf('@');
            <li class="invitee-row">
              <span class="invitee-address">@if (at > 0){@(invitee.Email[..(at + 1)])<wbr />@(invitee.Email[(at + 1)..])}else{@invitee.Email}<span class="invitee-group">@(invitee.Category == MsfRespondentCategory.Learner ? MsfCampaignText.LearnerLine(invitee.TeachingContext) : MsfRespondentCategories.Describe(invitee.Category))</span></span>
              @* The accessible name starts with the visible label's word and names the row (DESIGN.md § Button system,
                 T206); the dialog says what removing does (T247). *@
              <button type="button" class="btn btn-outline btn-sm" aria-label="@MsfCampaignText.RowActionName(MsfCampaignText.RemoveRowLabel, DescribeInvitee(invitee))"
                      @onclick="() => AskRemoveAsync(invitee)">@MsfCampaignText.RemoveRowLabel</button>
            </li>
          }
        </ul>
      }
    </section>
  };

  /// <summary>
  /// About this campaign: whose it is (with their training year while current), the questionnaire, the thresholds, when
  /// it closed, and the EPAs it is evidence for (T369; it replaced the campaign card's details list).
  /// </summary>
  private RenderFragment About(MsfCampaignSetupDto setup) => __builder =>
  {
    <section id="msf-about" class="detail-card" aria-labelledby="msf-about-heading">
      <h2 id="msf-about-heading" class="section-title">@MsfCampaignText.AboutHeading</h2>
      <dl class="msf-facts">
        <div><dt>Trainee</dt><dd>@MsfCampaignText.AboutTrainee(SubjectName(setup), setup.SubjectIsCurrent ? setup.TrainingYear : null)</dd></div>
        <div><dt>Template</dt><dd>@setup.TemplateName (@MsfEvidenceKinds.Describe(setup.Kind))</dd></div>
        <div>
          <dt>Thresholds</dt>
          <dd>
            @MsfCampaignText.AboutThresholds(setup.MinimumResponses, setup.MinimumCategoryResponses, setup.MinimumRespondentCategories)
            @if (setup.Kind == MsfTemplateKind.LearnerFeedback)
            {
              @(" ")<span class="field-help msf-block">@MsfCampaignText.LearnerGroupsFixed</span>
            }
          </dd>
        </div>
        @if (setup.ClosedOn is { } closedOn)
        {
          <div><dt>Closed to responses</dt><dd>@MsfCampaignText.AboutClosed(closedOn)</dd></div>
        }
        <div class="msf-facts-wide">
          <dt>Evidence</dt>
          <dd>
            @MsfCampaignText.AboutEvidence(setup.CoveredEpas.Select(epa => epa.Code).ToList())
            @if (setup.CoveredEpas.Count > 0)
            {
              <ul class="epa-lines">
                @foreach (var epa in setup.CoveredEpas)
                {
                  <li>@MsfCampaignText.EpaLine(epa.Code, epa.Title)</li>
                }
              </ul>
            }
          </dd>
        </div>
      </dl>
    </section>
  };
}

@code {
  [Parameter] public int CampaignId { get; set; }

  /// <summary>
  /// The campaign: whose it is, its questionnaire's kind, its state, whom it may invite (T164), how many have been invited
  /// and have responded in each group (T217), and About's facts (T369). Null for a campaign this caller does not run.
  /// </summary>
  private MsfCampaignSetupDto? _setup;

  private bool _loading = true;
  private string? _loadError;

  // An action's result where its button is gone, and the refusals beside the buttons that stay.
  private string? _status;

  /// <summary>What a withdraw did, after its bold lead, as the list words it (L4; build review D11).</summary>
  private string? _statusDetail;
  private string? _refusal;
  private string _refusalLead = string.Empty;
  private string? _openRefusal;
  private string? _withdrawRefusal;
  private string? _resendStatus;
  private string? _resendRefusal;
  private string? _removeStatus;
  private string? _removeRefusal;
  private string? _addStatus;
  private string? _emailError;
  private string? _contextError;

  /// <summary>An open has been sent and has not yet answered. (T202)</summary>
  private bool _opening;

  /// <summary>A withdraw has been sent and has not yet answered. (T217)</summary>
  private bool _withdrawing;

  /// <summary>An invitee add has been sent and has not yet answered. (T228 review)</summary>
  private bool _adding;

  /// <summary>An invitee remove has been sent and has not yet answered. (T247)</summary>
  private bool _removing;

  /// <summary>A resend of the links not delivered has been sent and has not yet answered. (T251)</summary>
  private bool _resending;

  /// <summary>The draft invitee the remove dialog was opened for, until it is confirmed or cancelled. (T247)</summary>
  private MsfDraftInviteeDto? _pendingRemove;

  private ConfirmDialog? _confirmWithdraw;
  private ConfirmDialog? _confirmRemove;
  private ActionResult? _result;
  private ActionResult? _rowsResult;
  private ActionResult? _linksResult;
  private ElementReference _emailInput;
  private ElementReference _contextInput;
  private ElementReference _withdrawButton;

  /// <summary>Where the focus goes after the next render, once an action has answered.</summary>
  private Func<ValueTask>? _focusAfterRender;

  /// <summary>The page's result region, which takes the focus where the pressed button is gone. For its tests.</summary>
  internal ElementReference ResultRegion => _result?.Element ?? default;

  /// <summary>The addresses' result region, above the rows (K4). For its tests.</summary>
  internal ElementReference RowsResultRegion => _rowsResult?.Element ?? default;

  /// <summary>The Links part's result region (K8). For its tests.</summary>
  internal ElementReference LinksResultRegion => _linksResult?.Element ?? default;

  internal ElementReference EmailInput => _emailInput;

  internal ElementReference ContextInput => _contextInput;

  internal ElementReference WithdrawButton => _withdrawButton;

  /// <summary>
  /// An open, a withdraw, an invitee add, an invitee remove or a resend is in flight, so nothing else is sent. (T202,
  /// T217, T228 review, T247, T251)
  /// </summary>
  private bool Busy => _opening || _withdrawing || _adding || _removing || _resending;

  private InviteeFormModel _invitee = new();

  /// <summary>
  /// Whether the caller runs any campaign (<see cref="MsfCampaignRules.RunsCampaigns" />, T248). Null until the caller is
  /// known.
  /// </summary>
  private bool? _runsCampaigns;

  private string _runsNoCampaignsReason = string.Empty;

  /// <summary>
  /// The heading and the tab (T369): "MSF campaign" while the campaign is read or could not be, "Campaign unavailable"
  /// when there is none this caller runs (K16), and "MSF campaign for {name}" once read.
  /// </summary>
  private string Heading
    => _loading || _loadError is not null
      ? MsfCampaignText.CampaignLoadingTitle
      : _setup is { } setup ? MsfCampaignText.CampaignTitle(SubjectName(setup)) : MsfCampaignText.CampaignUnavailableTitle;

  private string? Subtitle
    => _loading || _loadError is not null || _setup is not { } setup
      ? null
      : MsfCampaignText.CampaignSubtitle(setup.TemplateName, MsfEvidenceKinds.Describe(setup.Kind), setup.OpensOn, setup.ClosesOn);

  protected override async Task OnInitializedAsync()
  {
    var principal = await GetPrincipalAsync();
    _runsCampaigns = MsfCampaignRules.RunsCampaigns(principal);
    _runsNoCampaignsReason = MsfCampaignRules.RunsNoCampaigns(principal)
      ? MsfCampaignRules.TraineeRunsNoCampaigns
      : MsfCampaignRules.RunsCampaignsRoles;
  }

  protected override async Task OnParametersSetAsync()
  {
    if (_setup?.CampaignId != CampaignId)
    {
      _setup = null;
      _loading = true;
    }

    await LoadSetupAsync();
    _loading = false;
  }

  /// <summary>
  /// The campaign as it is now, or null for one this caller does not run, as the report page answers; the commands
  /// refuse those. Read again after every action on the page, whatever it answered: a refusal is likeliest because the
  /// campaign changed elsewhere (opened, withdrawn or closed), and the page should show what it is now. A failed read is
  /// the load error, its failure in the log (T329).
  /// </summary>
  private async Task LoadSetupAsync()
  {
    try
    {
      _setup = await Sender.Send(new GetMsfCampaignSetupQuery(CampaignId, await GetPrincipalAsync()));
      _loadError = null;
      if (_setup is { AcceptedCategories.Count: > 0 } && !_setup.AcceptedCategories.Contains(_invitee.Category))
      {
        _invitee.Category = _setup.AcceptedCategories[0];
      }
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogError(exception, "MSF campaign {CampaignId} could not be read.", CampaignId);
      _setup = null;
      _loadError = MsfCampaignText.CampaignLoadFailed;
    }
  }

  private async Task RetryAsync()
  {
    _loading = true;
    StateHasChanged();
    await LoadSetupAsync();
    _loading = false;
  }

  /// <summary>The trainee by name, or "the trainee" when they have none on record.</summary>
  private static string SubjectName(MsfCampaignSetupDto setup) => setup.SubjectName ?? "the trainee";

  /// <summary>The status card's stripe (F7): the coordinator's move on a draft and under review; Open, someone else's.</summary>
  private static string StatusCardClass(MsfCampaignState state)
    => state switch
    {
      MsfCampaignState.Open => "detail-card activity-status--others status-card",
      MsfCampaignState.Released => "detail-card activity-status--done status-card",
      MsfCampaignState.Withdrawn => "detail-card activity-status--declined status-card",
      _ => "detail-card detail-card--emphasis status-card"
    };

  /// <summary>
  /// Why a draft's Open campaign is unavailable, or null when it can be pressed: a trainee who is not current first (K13;
  /// the rule open applies, T284), then a draft that invites nobody (K1, T225).
  /// </summary>
  private static string? OpenUnavailableReason(MsfCampaignSetupDto setup)
    => !setup.SubjectIsCurrent
      ? MsfCampaignText.OpenNeedsCurrentTrainee(SubjectName(setup))
      : setup.Invitees.Count == 0 ? MsfCampaignText.OpenNeedsInvitees : null;

  /// <summary>A draft invitee as the Remove button, the dialog and the result name them. (T247)</summary>
  private static string DescribeInvitee(MsfDraftInviteeDto invitee)
    => MsfCampaignText.DescribeInvitee(invitee.Email, MsfRespondentCategories.Describe(invitee.Category));

  private string RemoveBody
    => _pendingRemove is null ? string.Empty : MsfCampaignText.RemoveInviteeBody(DescribeInvitee(_pendingRemove));

  /// <summary>The campaign as the withdraw dialog and its result name it, as the campaign list does (T206).</summary>
  private static string Described(MsfCampaignSetupDto setup)
    => MsfCampaignText.Describe(SubjectName(setup), setup.TemplateName, setup.ClosesOn);

  private string WithdrawBody => _setup is null ? string.Empty : MsfCampaignText.WithdrawBody(Described(_setup), _setup.State);

  private void ClearResults()
  {
    _status = null;
    _statusDetail = null;
    _refusal = null;
    _openRefusal = null;
    _withdrawRefusal = null;
    _resendStatus = null;
    _resendRefusal = null;
    _removeStatus = null;
    _removeRefusal = null;
    _addStatus = null;
    _emailError = null;
    _contextError = null;
  }

  /// <summary>A refusal in its own words, or the fixed sentence for any other failure, which goes to the log (T329).</summary>
  private string RefusalWords(Exception exception, string action)
  {
    if (MsfCampaignText.RefusalOf(exception) is { } refusal)
    {
      return refusal;
    }

    Logger.LogError(exception, "MSF campaign {CampaignId}: {Action} failed.", CampaignId, action);
    return MsfCampaignText.ActionFailed;
  }

  /// <summary>The page's result region takes the focus with a refusal whose button is gone.</summary>
  private void RefuseAtTheTop(string lead, string refusal)
  {
    _refusalLead = lead;
    _refusal = refusal;
    _focusAfterRender = () => _result!.Element.FocusAsync();
  }

  /// <remarks>
  /// Checked first, in the page's words (K5b, K5c; T324), and refused under the field with the address kept and the focus
  /// in it. Sent at most once at a time, as the open is (T202): the flag is set before the first await, so a second Enter
  /// that reaches the circuit while this add runs does nothing, and Open, Withdraw and Remove wait for it too. Added, the
  /// result is "Invitee added." alone (F11), the group and the context kept for the next one, the address cleared and
  /// focused. A refusal on a campaign still a draft is under the field, the focus back in it (K5); one that finds the
  /// form gone (the campaign opened elsewhere) is at the top, focused.
  /// </remarks>
  private async Task AddInviteeAsync()
  {
    if (Busy || _setup is not { State: MsfCampaignState.Draft, SubjectIsCurrent: true } setup)
    {
      return;
    }

    ClearResults();
    var learner = setup.Kind == MsfTemplateKind.LearnerFeedback;
    var category = learner ? MsfRespondentCategory.Learner : _invitee.Category;
    _emailError = string.IsNullOrWhiteSpace(_invitee.Email)
      ? MsfRespondentAddress.Missing
      : MsfRespondentAddress.IsWellFormed(_invitee.Email) ? null : MsfRespondentAddress.Malformed;
    _contextError = learner && string.IsNullOrWhiteSpace(_invitee.TeachingContext) ? MsfCampaignText.TeachingContextMessage : null;
    if (_emailError is not null || _contextError is not null)
    {
      // The first field refused takes the focus: the address, else the teaching context (build review D6).
      _focusAfterRender = _emailError is not null ? () => _emailInput.FocusAsync() : () => _contextInput.FocusAsync();
      return;
    }

    _adding = true;
    var added = false;
    try
    {
      await Sender.Send(new AddMsfInvitationCommand(
        CampaignId, _invitee.Email.Trim(), category, await GetPrincipalAsync(), learner ? _invitee.TeachingContext : null));

      // The next one is usually from the same group, so the group and the context are kept. Cleared in place: a new
      // model would rebuild the form, and the control that had the focus with it (F2 browser check).
      _invitee.Email = string.Empty;
      _addStatus = MsfCampaignText.InviteeAdded;
      added = true;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      _emailError = RefusalWords(exception, "an invitee add");
    }

    try
    {
      await LoadSetupAsync();
    }
    finally
    {
      _adding = false;
    }

    if (_setup is { State: MsfCampaignState.Draft })
    {
      _focusAfterRender = () => _emailInput.FocusAsync();
    }
    else if (!added && _emailError is { } refusal)
    {
      _emailError = null;
      RefuseAtTheTop(MsfCampaignText.NotAdded, refusal);
    }
  }

  /// <remarks>
  /// <para>
  /// Sent at most once at a time (T202): the flag is set before the first await, and a press that finds it set does
  /// nothing. Before T202 a double-click raced two opens, and every respondent was mailed two links, one of them dead.
  /// </para>
  /// <para>
  /// Read again before the flag is released (T217), so the page shows it open, with no Open button, the moment the open
  /// answers; the result takes the focus at the top, since the button is gone. A refused open on a campaign still a draft
  /// shows its refusal beside the button and leaves the focus on it, for the retry a failed send asks for (T184, K20).
  /// </para>
  /// </remarks>
  private async Task OpenCampaignAsync()
  {
    if (Busy || _setup is null)
    {
      return;
    }

    _opening = true;
    ClearResults();
    string? refusal = null;

    try
    {
      await Sender.Send(new OpenMsfCampaignCommand(CampaignId, await GetPrincipalAsync()));
      // The open cannot say the links arrived: the mail leaves after it (T251).
      _status = MsfCampaignText.CampaignOpened;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      refusal = RefusalWords(exception, "an open");
    }

    try
    {
      await LoadSetupAsync();
    }
    finally
    {
      _opening = false;
    }

    if (refusal is null)
    {
      _focusAfterRender = () => _result!.Element.FocusAsync();
    }
    else if (_setup is { State: MsfCampaignState.Draft })
    {
      // The button that had the focus is still there, for the retry: the focus stays on it.
      _openRefusal = refusal;
    }
    else
    {
      RefuseAtTheTop(MsfCampaignText.NotOpened, refusal);
    }
  }

  /// <remarks>
  /// Sent at most once at a time, as the open is (T202). The campaign is read again whatever the answer, so the count is
  /// what it is now. Done, the result takes the focus in the Links part (K8); refused with Resend still there, the refusal
  /// is under the warning and the focus stays on Resend (K22); refused with no Resend left (every link sent again
  /// elsewhere, or the campaign closed), the refusal takes the focus. (T251, T234)
  /// </remarks>
  private async Task ResendLinksAsync()
  {
    if (Busy || _setup is null)
    {
      return;
    }

    _resending = true;
    ClearResults();
    string? refusal = null;

    try
    {
      var count = await Sender.Send(new ResendMsfLinksCommand(CampaignId, await GetPrincipalAsync()));
      _resendStatus = MsfCampaignText.LinksResent(count);
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      refusal = RefusalWords(exception, "a resend");
    }

    try
    {
      await LoadSetupAsync();
    }
    finally
    {
      _resending = false;
    }

    if (_setup is not { State: MsfCampaignState.Open })
    {
      _resendStatus = null;
      if (refusal is not null)
      {
        RefuseAtTheTop(MsfCampaignText.NotResent, refusal);
      }

      return;
    }

    // A refusal that leaves Resend leaves the focus on it, for the retry; otherwise the result takes it.
    _resendRefusal = refusal;
    _focusAfterRender = refusal is not null && _setup.LinksNotDelivered > 0
      ? null
      : () => _linksResult!.Element.FocusAsync();
  }

  private async Task AskWithdrawAsync()
  {
    if (Busy || _setup is null)
    {
      return;
    }

    ClearResults();
    if (_confirmWithdraw is not null)
    {
      await _confirmWithdraw.ShowAsync();
    }
  }

  /// <remarks>
  /// Sent at most once at a time, as the open is (T202). Withdrawn, the result takes the focus at the top, since the
  /// button is gone (T206 review). Refused while the campaign can still be withdrawn, the refusal is beside the button and
  /// the focus goes back to it (K21) once the dialog has closed: a closing dialog returns the focus to nothing.
  /// </remarks>
  private async Task WithdrawAsync()
  {
    if (_setup is not { } campaign || Busy)
    {
      return;
    }

    _withdrawing = true;
    ClearResults();
    string? refusal = null;

    try
    {
      // The state the dialog was worded by: a campaign closed since is refused, not withdrawn in words it was not asked
      // in (T199 review).
      await Sender.Send(new WithdrawMsfCampaignCommand(CampaignId, campaign.State, await GetPrincipalAsync()));
      _status = MsfCampaignText.WithdrawnLead(Described(campaign));
      _statusDetail = MsfCampaignText.WithdrawnDetail(campaign.State);
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      refusal = RefusalWords(exception, "a withdraw");
    }

    try
    {
      await LoadSetupAsync();
    }
    finally
    {
      _withdrawing = false;
    }

    if (refusal is null)
    {
      _focusAfterRender = () => _result!.Element.FocusAsync();
    }
    else if (_setup is { } now && MsfCampaignRules.IsWithdrawable(now.State))
    {
      _withdrawRefusal = refusal;
      _focusAfterRender = () => _withdrawButton.FocusAsync();
    }
    else
    {
      RefuseAtTheTop(MsfCampaignText.NotWithdrawn, refusal);
    }
  }

  private async Task AskRemoveAsync(MsfDraftInviteeDto invitee)
  {
    if (Busy)
    {
      return;
    }

    _pendingRemove = invitee;
    ClearResults();

    if (_confirmRemove is not null)
    {
      await _confirmRemove.ShowAsync();
    }
  }

  private void CancelRemove() => _pendingRemove = null;

  /// <remarks>
  /// Sent at most once at a time, as the withdraw is (T217). The campaign is read again whatever the answer, so its
  /// counts and its list lose the invitee at once. The result, done or refused, is above the rows and takes the focus
  /// (K4): the row's Remove is gone after a remove, and the dialog has closed. On a campaign opened elsewhere the list is
  /// gone, so the refusal is at the top (T247).
  /// </remarks>
  private async Task RemoveAsync()
  {
    if (_pendingRemove is not { } invitee || Busy)
    {
      return;
    }

    _removing = true;
    ClearResults();
    string? refusal = null;

    try
    {
      await Sender.Send(new RemoveMsfInvitationCommand(CampaignId, invitee.InvitationId, await GetPrincipalAsync()));
      _removeStatus = MsfCampaignText.InviteeRemoved(DescribeInvitee(invitee));
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      refusal = RefusalWords(exception, "an invitee remove");
    }

    try
    {
      await LoadSetupAsync();
    }
    finally
    {
      _pendingRemove = null;
      _removing = false;
    }

    if (_setup is { State: MsfCampaignState.Draft })
    {
      _removeRefusal = refusal;
      _focusAfterRender = () => _rowsResult!.Element.FocusAsync();
    }
    else if (refusal is not null)
    {
      _removeStatus = null;
      RefuseAtTheTop(MsfCampaignText.NotRemoved, refusal);
    }
  }

  /// <remarks>
  /// The focus moves once the browser has the render that shows the result. After a dialog's action that is also after
  /// the dialog has closed: ConfirmDialog closes it as soon as the action returns, and while a modal dialog is open
  /// nothing outside it can take the focus (T206 review).
  /// </remarks>
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusAfterRender is { } focus)
    {
      _focusAfterRender = null;
      await focus();
    }
  }

  private sealed class InviteeFormModel
  {
    public string Email { get; set; } = string.Empty;

    public MsfRespondentCategory Category { get; set; } = MsfRespondentCategory.PeerDoctor;

    /// <summary>Where a learner was taught; sent only for a Learner (T164).</summary>
    public string? TeachingContext { get; set; }
  }

  private async Task<ClaimsPrincipal> GetPrincipalAsync()
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    return authState.User;
  }
}

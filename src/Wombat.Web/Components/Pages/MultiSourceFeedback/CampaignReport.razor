@page "/msf/reports/{CampaignId:int}"
@using System.Security.Claims
@using Wombat.Application.Features.Activities.Services
@attribute [Authorize(Roles = "Coordinator,Administrator")]
@inject IScopedSender Sender
@inject IActivityReferenceDataService ReferenceData
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>MSF Report</PageTitle>

<PageHeader Title="MSF report" Subtitle="Review aggregate results and release them to the trainee." />

@* What Close campaign or Release to trainee did, as on the campaign page (T217, T225). Given the focus whenever the
   button that acted is gone: a closed campaign has no Close campaign, a released one no Release to trainee. The focus
   would otherwise fall to the page. Until T225 an action's refusal was also the panel's load error, so a refused close
   hid the whole report and showed its refusal twice. *@
<div @ref="_result" class="action-result" tabindex="-1">
  @if (!string.IsNullOrWhiteSpace(_status))
  {
    <Alert Kind="success" Role="status">@_status</Alert>
  }

  @if (!string.IsNullOrWhiteSpace(_actionError))
  {
    <Alert Kind="danger" Role="alert">@_actionError</Alert>
  }
</div>

<StatePanel IsLoading="_loading" LoadError="@_loadError" IsEmpty="@(!_loading && _report is null)" EmptyTitle="Report unavailable" EmptyBody="The selected report could not be loaded.">
  @if (_report is not null)
  {
    <div class="details-grid">
      <section class="detail-card">
        <h3>Summary</h3>
        <p><strong>Template:</strong> @_report.TemplateName</p>
        <p><strong>Kind:</strong> @MsfEvidenceKinds.Describe(_report.Kind)</p>
        <p><strong>State:</strong> @MsfCampaignText.State(_report.State)</p>
        <p><strong>Total responses:</strong> @_report.TotalResponses</p>
        <p><strong>Minimum responses:</strong> @_report.MinimumResponses</p>
        <p><strong>Minimum category responses:</strong> @_report.MinimumCategoryResponses</p>
        <p><strong>Reporting categories:</strong> @_report.SurvivingCategoryCount of @_report.MinimumRespondentCategories required</p>
        @if (_report.TeachingContextCount is int contextCount)
        {
          @* T164: EPA 15 asks for feedback across at least two teaching contexts. Reported, never enforced: how the
             College counts two contexts is its open question (EPA-PROGRAMME § 3F question 9). Named only here, for
             whoever runs the campaign: the trainee, the portfolio and the committee snapshot are given the count. *@
          <p><strong>Teaching contexts that responded:</strong> @TeachingContextsText(contextCount, _report.TeachingContextsResponded)</p>
          <p class="muted">EPA 15 asks for feedback from learners in at least two teaching contexts before entrustment. This count is for the committee to weigh; it does not hold the release. The trainee and the committee are told how many contexts responded, never their names.</p>
        }
      </section>

      <section class="detail-card">
        <h3>Evidence for</h3>
        @if (_report.CoveredEpas.Count == 0)
        {
          <Alert Kind="warning" Role="">This campaign names no EPA, so releasing it will record no evidence on the trainee's portfolio.</Alert>
        }
        else
        {
          <ul>
            @foreach (var epa in _report.CoveredEpas)
            {
              <li>
                @epa.Code — @epa.Title
                @if (_report.State == MsfCampaignState.Released && !epa.Recorded)
                {
                  <text> — not recorded</text>
                }
              </li>
            }
          </ul>
          @if (_report.EvidenceRecordedOn is DateTime recordedOn)
          {
            <p><strong>Recorded on the portfolio:</strong> @recordedOn.ToString("yyyy-MM-dd HH:mm") UTC</p>
          }
          else
          {
            <p class="page-subtitle">One evidence record per EPA is written to the trainee's portfolio when the report is released.</p>
          }
        }
      </section>

      <section class="detail-card">
        <h3>Coordinator actions</h3>
        @if (!CanBeActedOn(_report))
        {
          @* T246 review: a campaign that can no longer be closed or released shows its narrative and level as stored,
             never in fields. A tab that typed a narrative, then found the campaign released or withdrawn elsewhere when
             its close or release was refused, kept that text in an editable box beside "State: Released", with nothing
             to send it with, where the narrative the trainee was given belonged. *@
          <p><strong>Narrative:</strong> @(string.IsNullOrWhiteSpace(_report.CoordinatorNarrative) ? "Not given" : _report.CoordinatorNarrative)</p>
          @if (_levelOptions.Count > 0)
          {
            <p><strong>Supervision level this feedback supports:</strong> @LevelText(_report.ReviewerEntrustmentLevel)</p>
          }
        }
        else
        {
          @if (_report.State == MsfCampaignState.UnderReview && !_report.ReadyForRelease)
          {
            @* T199 review: a campaign that cannot be released is the one a coordinator withdraws, never to be released,
               and Withdraw is on its campaign page (as on the list), so the warning says where. Whoever sees this form
               may withdraw it: release and withdraw ask the same caller rule. *@
            <Alert Kind="warning" Role="">@BlockedReason(_report) If it should never be released, <a id="msf-withdraw-elsewhere" href="@($"/msf/campaigns/{CampaignId}")">withdraw it on its campaign page</a>.</Alert>
          }
          <EditForm Model="_review" OnValidSubmit="ReleaseAsync" FormName="msf-release">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary-errors" />
            <FormField Label="Narrative" InputId="msf-narrative">
              <InputTextArea id="msf-narrative" class="form-control" @bind-Value="_review.Narrative" />
            </FormField>
            @if (_levelOptions.Count > 0)
            {
              <FormField Label="Supervision level this feedback supports" InputId="msf-level"
                         HelpText="Optional, and blank is a perfectly good answer. Your own judgement as the releasing clinician, informed by the aggregate below - never an average of respondent scores.">
                <InputSelect id="msf-level" class="form-select" aria-describedby="@FieldHelp.Id("msf-level")" @bind-Value="_review.EntrustmentLevel">
                  <option value="">Not stated</option>
                  @foreach (var rung in _levelOptions)
                  {
                    <option value="@rung.Value">@rung.Label</option>
                  }
                </InputSelect>
              </FormField>
            }
            @* Neither is disabled while it runs (T225 review, as Add invitee since T228): the button pressed has the focus,
               and a browser drops the focus of a button it disables, to the page, where a refusal that leaves the button
               would leave it. The page refuses a second press instead (_acting). *@
            <FormActions>
              @if (_report.State == MsfCampaignState.Open)
              {
                <button id="msf-close-campaign" type="button" class="btn btn-outline" @onclick="CloseAsync">Close campaign</button>
              }
              @if (_report.State == MsfCampaignState.UnderReview)
              {
                <button id="msf-release-campaign" type="submit" class="btn btn-primary" disabled="@(!_report.ReadyForRelease)">Release to trainee</button>
              }
            </FormActions>
          </EditForm>
        }
      </section>
    </div>

    @foreach (var category in _report.Categories)
    {
      <section class="detail-card">
        @* By the group's label, never its key (T225): "Peer doctor", not "PeerDoctor". *@
        <h3>@MsfRespondentCategories.Describe(category.Category)</h3>
        @if (category.IsSuppressed)
        {
          <Alert Kind="warning" Role="">Insufficient responses in this category. Results are suppressed.</Alert>
        }
        else
        {
          @foreach (var question in category.Questions)
          {
            <div class="mb-3">
              <strong>@question.Prompt</strong>
              @if (question.Type == MsfQuestionType.Scale && question.Scale is not null)
              {
                <p>Average: @question.Scale.Average.ToString("0.00") from @question.Scale.ResponseCount responses.</p>
              }
              else
              {
                <ul>
                  @foreach (var comment in question.Comments)
                  {
                    <li>@comment</li>
                  }
                </ul>
              }
            </div>
          }
        }
      </section>
    }
  }
</StatePanel>

@code {
  [Parameter] public int CampaignId { get; set; }

  /// <summary>
  /// The rungs of the ladder <c>msf_cpsa</c> rates on, as the College prints them. Never a free number
  /// box: on the CPSA ladder order 5 is rung "4" (T100), so a reviewer who means "4" and types 4 would
  /// have stored rung "3b" and the portfolio would have printed that back at them. (T121)
  /// </summary>
  private readonly List<ActivityCatalogueOption> _levelOptions = [];

  private MsfCampaignAggregateReportDto? _report;
  private ReviewFormModel _review = new();
  private bool _loading = true;
  private string? _status;

  /// <summary>
  /// Why the report could not be read at all, on arriving or after an action that was taken. The panel shows it in place
  /// of the report.
  /// </summary>
  private string? _loadError;

  /// <summary>Why Close campaign or Release to trainee was refused. Shown above the report, which stays. (T225)</summary>
  private string? _actionError;

  /// <summary>
  /// A close or a release has been sent and has not yet answered, so neither may be sent again (T225). The buttons stay
  /// enabled meanwhile, so the one pressed keeps the focus (T225 review); this flag is what refuses a second press.
  /// </summary>
  private bool _acting;

  private ElementReference _result;

  /// <summary>An action has answered and its button is gone, so its result takes the focus after the next render.</summary>
  private bool _focusResult;

  /// <summary>The region holding an action's result, which takes the focus once it has answered. For its tests.</summary>
  internal ElementReference ResultRegion => _result;

  protected override async Task OnParametersSetAsync()
  {
    await LoadAsync();

    if (_report is { IsSubjectsCopy: true })
    {
      SendTheSubjectToTheirOwnCopy();
      return;
    }

    await LoadLevelOptionsAsync();
  }

  /// <summary>
  /// The trainee the campaign is about reads their released report on their own page, <c>/msf/my-reports/{id}</c>,
  /// never here: this is the coordinator's page, with its actions card and every group's card, suppressed ones
  /// included. A trainee who also coordinates (or an Administrator who is the subject) is admitted to this page by
  /// role, and the handler admits them to the released report (<c>MsfCampaignRules.CanReadReportAsync</c>), so this
  /// page is where the two would otherwise meet. Their copy is not shown for the moment the navigation takes: the page
  /// keeps its skeleton (<c>_loading</c>, which alone hides the report), and the copy is dropped besides, so nothing on
  /// the page can read it. It replaces this address in the history, so Back does not return here only to be sent on
  /// again. That is the circuit, where the page renders once more after this returns. A page load runs this in the
  /// prerender instead, where the navigation is the server's 302 (<c>BlazorDisableThrowNavigationException</c>, so
  /// nothing throws) and the prerender renders nothing after it: the redirect's body is the page as it stood before the
  /// report was read, its skeleton, with or without the two lines above (<c>MsfReportPageFlowTests</c>). (T269)
  /// </summary>
  private void SendTheSubjectToTheirOwnCopy()
  {
    _report = null;
    _loading = true;
    Navigation.NavigateTo($"/msf/my-reports/{CampaignId}", replace: true);
  }

  /// <summary>
  /// The rungs of the type this campaign's release writes (<see cref="MsfEvidenceKinds.ActivityTypeKeyFor" />).
  /// <c>learner_feedback_cpsa</c> rates nothing, so a learner-feedback release offers no level, and its command refuses
  /// one (T164).
  /// </summary>
  private async Task LoadLevelOptionsAsync()
  {
    _levelOptions.Clear();
    if (_report is null)
    {
      return;
    }

    try
    {
      _levelOptions.AddRange(await ReferenceData.GetRatedLevelOptionsForActivityTypeAsync(
        MsfEvidenceKinds.ActivityTypeKeyFor(_report.Kind)));
    }
    catch (Exception exception)
    {
      _loadError = exception.Message;
    }
  }

  /// <summary>
  /// Whether this page can still close or release the campaign: only an open one closes (T246), and only one under
  /// review is released. Anything else shows its narrative and level as stored (T246 review).
  /// </summary>
  private static bool CanBeActedOn(MsfCampaignAggregateReportDto report)
    => report.State is MsfCampaignState.Open or MsfCampaignState.UnderReview;

  /// <summary>The stored level by its rung's label, as the form's select offers it, never its order (T100, T121).</summary>
  private string LevelText(int? level)
    => level is not int order
      ? "Not stated"
      : _levelOptions.FirstOrDefault(option => option.Value == order.ToString(System.Globalization.CultureInfo.InvariantCulture))?.Label
        ?? order.ToString(System.Globalization.CultureInfo.InvariantCulture);

  private static string TeachingContextsText(int count, IReadOnlyList<string>? names)
    => names is { Count: > 0 } ? $"{count} ({string.Join(", ", names)})" : $"{count}";

  /// <summary>
  /// Which of the two release gates is closed. Both are computed in one place — the aggregation
  /// service — so this only has to phrase what that already decided.
  /// </summary>
  private static string BlockedReason(MsfCampaignAggregateReportDto report)
    => report.TotalResponses < report.MinimumResponses
      ? $"Release needs {report.MinimumResponses} responses; {report.TotalResponses} have come back."
      : $"Release needs {report.MinimumRespondentCategories} respondent groups to report; " +
        $"{report.SurvivingCategoryCount} cleared the {report.MinimumCategoryResponses}-response threshold. " +
        (report.Kind == MsfTemplateKind.LearnerFeedback
          ? "Below the threshold, the learners' answers are suppressed to keep them anonymous."
          : "Feedback that survives from too few groups is not multi-source feedback.");

  private async Task LoadAsync()
  {
    _loading = true;
    _loadError = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

      // Null for a campaign that does not exist and for one about a trainee the caller does not run campaigns
      // for, alike (T113); the panel renders both as "Report unavailable".
      _report = await Sender.Send(new GetCampaignAggregateReportQuery(CampaignId, authState.User));
      _review.Narrative = _report?.CoordinatorNarrative;
      _review.EntrustmentLevel = _report?.ReviewerEntrustmentLevel;
    }
    catch (Exception exception)
    {
      _loadError = exception.Message;
    }
    finally
    {
      _loading = false;
    }
  }

  /// <summary>
  /// The report as it is now, read again after an action, refused or not (T225, as the campaign page does since T217): a
  /// refusal is likeliest because the campaign changed elsewhere, and the page should show what it is now. The report
  /// already shown stays in view while it is read, and the narrative and level typed are kept while the campaign can still
  /// be closed or released. Once it cannot, the card shows them as stored instead (T246 review).
  /// </summary>
  /// <remarks>
  /// An action's refusal is kept over a failed read that follows it: it says why the action was not taken, and the panel
  /// then says the report is unavailable. After an action that was taken, a failed read is the panel's load error, as it
  /// is on arriving: it is not a refusal, so it is not shown as one beside the action's result (T225 review).
  /// </remarks>
  private async Task ReadReportAsync()
  {
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _report = await Sender.Send(new GetCampaignAggregateReportQuery(CampaignId, authState.User));
    }
    catch (Exception exception)
    {
      _report = null;
      if (_actionError is null)
      {
        _loadError = exception.Message;
      }
    }
  }

  /// <remarks>
  /// Sent at most once at a time, as the campaign page's open is (T202): the flag is set before the first await, so a
  /// second click while this close runs sends nothing. The button is not disabled meanwhile, so a refusal on a campaign
  /// still open leaves the focus on it, for the retry (T225 review). After a refusal the report is read again, so the
  /// refusal (<see cref="CloseMsfCampaignCommandHandler.CampaignChanged" />) names no other page (T225).
  /// <para>
  /// A report loaded while the campaign was open still offers Close after another tab or the auto-close job has closed
  /// it. The campaign refuses that close (<c>MsfCampaign.OnlyOpenCanBeClosed</c>), and its close date stands
  /// (T246); the report read again shows it under review, as the campaign page shows a refused open (T217). Close is then
  /// gone, so the refusal takes the focus.
  /// </para>
  /// </remarks>
  private async Task CloseAsync()
  {
    if (_acting)
    {
      return;
    }

    _acting = true;
    _status = null;
    _actionError = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _report = await Sender.Send(new CloseMsfCampaignCommand(CampaignId, authState.User));
      _status = "Campaign closed and anonymised for review.";
    }
    catch (Exception exception)
    {
      _actionError = RefusalText.Of(exception);
      await ReadReportAsync();
    }
    finally
    {
      _acting = false;
    }

    // Close campaign is offered only on an open campaign, so it is gone unless the close was refused on one still open.
    _focusResult = _report is not { State: MsfCampaignState.Open };
  }

  private async Task ReleaseAsync()
  {
    if (_acting)
    {
      return;
    }

    _acting = true;
    _status = null;
    _actionError = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var principal = authState.User;

      // No "coordinator" fallback. Since T121 this id becomes CreatedByUserId on the evidence
      // activities the release writes, and `creator` is an actor rule — a literal placeholder would
      // become a user id on a clinical record and a rule that matches nobody.
      var userId = principal.FindFirst(ClaimTypes.NameIdentifier)?.Value
        ?? throw new InvalidOperationException("The current user identifier is missing.");

      await Sender.Send(new ReleaseMsfCampaignCommand(CampaignId, userId, _review.Narrative, _review.EntrustmentLevel, principal));
      _status = "Report released to the trainee.";
    }
    catch (Exception exception)
    {
      _actionError = RefusalText.Of(exception);
    }

    try
    {
      await ReadReportAsync();
    }
    finally
    {
      _acting = false;
    }

    // Release to trainee is offered only on a campaign under review, so it is gone once released, here or elsewhere, and
    // it is disabled on one no longer ready for release; either way the focus it had is lost (T225 review).
    _focusResult = _report is not { State: MsfCampaignState.UnderReview, ReadyForRelease: true };
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusResult)
    {
      _focusResult = false;
      await _result.FocusAsync();
    }
  }

  private sealed class ReviewFormModel
  {
    [MaxLength(4000)]
    public string? Narrative { get; set; }

    [Range(1, 20)]
    public int? EntrustmentLevel { get; set; }
  }
}

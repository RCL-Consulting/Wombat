@page "/msf/my-reports"
@attribute [Authorize(Roles = "Trainee,Coordinator,Administrator")]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<MyMsfReports> Logger
@inject IJSRuntime JS

@* Coordinator is admitted (T269) because the coordinator's report page sends a campaign's subject to their own copy,
   whatever role brought them there, and every role that page admits must be admitted here and on MyMsfReport, or the
   subject would be sent to a refusal. A Coordinator who no longer holds Trainee still reads their own released reports:
   the handlers admit the subject whatever their roles (MsfCampaignRules.CanReadReportAsync,
   TraineeScopeResolver.MayReadAsync). A coordinator who is nobody's subject finds an empty list. The nav offers the page
   to Trainee alone.

   MSF reports (T369, flow 10, lane T; boards R3-M1, M2, M5–M7, M11; round 3 F3, S8; T270, T280, T323, T325, T329). The
   list only: each report opens on a page of its own, MyMsfReport (/msf/my-reports/{id}, S6).

   - "Your released reports": a hand-written table with both stack classes (stacked at 900px and below, as M2 draws it at
     768 and 390), captioned, the report its row's header (the template over its kind), Released in SAST, View named for
     its row (RowNames.Distinct, T239). No Responses column (F3): her query carries no count.
   - ?unavailable=true is where MyMsfReport sends an id that is not one of her released reports (not hers, not released,
     unknown): one info alert above her list, focused (M5, M11, T270). A failed read is never that alert (M10).
   - Loading: the header at once, the section's heading, a status line and row skeletons. A failure is fixed words with
     Try again, never the exception's text (T329), the failure to the log. None: today's words. *@

<PageTitle>MSF reports · Wombat</PageTitle>

<PageHeader Title="MSF reports" Subtitle="@MyMsfReportText.ListSubtitle" />

@* Present from the first render, so its words are announced when they come. *@
<p class="visually-hidden" role="status">@(_loading ? MyMsfReportText.ListLoading : null)</p>

<div class="msf-page">
  @if (Unavailable)
  {
    <ActionResult Id="msf-report-unavailable" FocusOnLoad="true">
      <Alert Kind="info">@MyMsfReportText.NotFound</Alert>
    </ActionResult>
  }

  <StatePanel IsLoading="_loading" LoadError="@_loadError" OnRetry="RetryAsync" FocusAfterRetry="FocusHeadingAsync"
              IsEmpty="@(!_loading && _reports.Count == 0)" EmptyTitle="@MyMsfReportText.EmptyTitle"
              EmptyBody="@MyMsfReportText.EmptyBody">
    <LoadingContent>
      <section class="list-section" aria-busy="true">
        <h2 class="list-section-title">@MyMsfReportText.ReportsHeading</h2>
        <div aria-hidden="true">
          <Skeleton Count="2" Height="3rem" />
        </div>
      </section>
    </LoadingContent>
    <ChildContent>
      @{ var rowNames = RowNames.Distinct(_reports, report => report.CampaignId, MyMsfReportText.RowName,
                                          report => $" at {MyMsfReportText.Released(report.ReleasedOn)}"); }
      <section class="list-section msf-measure" aria-labelledby="msf-reports-heading">
        <h2 id="msf-reports-heading" class="list-section-title">@MyMsfReportText.ReportsHeading</h2>
        <div class="table-container shadow">
          <table class="clinic-table clinic-table--stack clinic-table--stack-wide" role="table">
            <caption>@MyMsfReportText.ReportsCaption</caption>
            <thead role="rowgroup">
              <tr role="row">
                <th scope="col" role="columnheader">Report</th>
                <th scope="col" role="columnheader">Released</th>
                <th scope="col" role="columnheader"><span class="visually-hidden">Actions</span></th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              @foreach (var report in _reports)
              {
                <tr role="row" @key="report.CampaignId" id="@($"msf-my-report-row-{report.CampaignId}")">
                  <th scope="row" role="rowheader" class="trainee-cell">
                    @report.TemplateName
                    <span class="kind-line">@MsfEvidenceKinds.Describe(report.Kind)</span>
                  </th>
                  <td role="cell" data-label="Released" class="nowrap">@MyMsfReportText.Released(report.ReleasedOn)</td>
                  <td role="cell">
                    <div class="actions-cell">
                      <a class="btn btn-outline btn-sm" href="@MsfLinks.MyReport(report.CampaignId)"
                         aria-label="@($"View {rowNames[report.CampaignId]}")">View</a>
                    </div>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </section>
    </ChildContent>
  </StatePanel>
</div>

@code {
  /// <summary>
  /// Set by her report's page when the id it was given is not one of her released reports (M11): the list says so once,
  /// above itself, and takes the focus.
  /// </summary>
  [SupplyParameterFromQuery(Name = "unavailable")]
  public bool Unavailable { get; set; }

  private readonly List<MsfReleasedReportDto> _reports = [];
  private bool _loading = true;
  private string? _loadError;

  protected override Task OnInitializedAsync() => LoadAsync();

  private async Task LoadAsync()
  {
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        ?? throw new InvalidOperationException("The current user identifier is missing.");

      _reports.Clear();
      _reports.AddRange(await Sender.Send(new ListMsfCampaignsForTraineeQuery(userId, authState.User)));
      _loadError = null;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      // T329: fixed words, never the exception's text; the failure to the log.
      Logger.LogError(exception, "The trainee's MSF reports could not be loaded.");
      _loadError = MyMsfReportText.ListFailed;
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task RetryAsync()
  {
    _loading = true;
    _loadError = null;
    StateHasChanged();
    await LoadAsync();
  }

  private ValueTask FocusHeadingAsync() => PageFocus.FocusHeadingAsync(JS);
}

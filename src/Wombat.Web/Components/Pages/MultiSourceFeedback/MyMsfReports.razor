@page "/msf/my-reports"
@page "/msf/my-reports/{CampaignId:int}"
@attribute [Authorize(Roles = "Trainee,Coordinator,Administrator")]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

@* Coordinator is admitted (T269) because the coordinator's report page sends a campaign's subject here, whatever role
   brought them there, and every role that page admits must be admitted here, or the subject would be sent to a refusal.
   A Coordinator who no longer holds Trainee still reads their own released reports: the handlers admit the subject
   whatever their roles (MsfCampaignRules.CanReadReportAsync, TraineeScopeResolver.MayReadAsync). A coordinator who is
   nobody's subject finds an empty list, and a report about anyone else is refused below, as an Administrator's is. The
   nav offers the page to Trainee alone. *@

<PageTitle>MSF reports · Wombat</PageTitle>

<PageHeader Title="MSF reports" Subtitle="Released aggregate feedback only. Individual responses are never shown." />

@if (!string.IsNullOrWhiteSpace(_error))
{
  <Alert Kind="danger">@_error</Alert>
}

<div class="details-grid">
  <section class="detail-card">
    <h3>Released reports</h3>
    <StatePanel IsLoading="_loading" LoadError="@_error" IsEmpty="@(!_loading && _reports.Count == 0)" EmptyTitle="No released reports" EmptyBody="Released multi-source feedback will appear here.">
      <DataTable Items="_reports">
        <HeaderRow>
          <tr>
            <th>Template</th>
            <th>Released</th>
            <th>Responses</th>
            <th><span class="visually-hidden">Actions</span></th>
          </tr>
        </HeaderRow>
        <Row Context="item">
          <tr>
            <td>@item.TemplateName<br /><span class="muted">@MsfEvidenceKinds.Describe(item.Kind)</span></td>
            <td>@item.ReleasedOn?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>@item.ResponseCount</td>
            <td>
              <div class="actions-cell">
                @* T239: named by the report, its template and when it was released. *@
                <a class="btn btn-outline btn-sm" href="@($"/msf/my-reports/{item.Id}")"
                   aria-label="@($"View the {item.TemplateName} report, released {item.ReleasedOn?.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)}")">View</a>
              </div>
            </td>
          </tr>
        </Row>
      </DataTable>
    </StatePanel>
  </section>

  @if (_report is not null)
  {
    <section class="detail-card">
      <h3>Selected report</h3>
      <p><strong>Template:</strong> @_report.TemplateName (@MsfEvidenceKinds.Describe(_report.Kind))</p>
      @* T164: the count, never the names. A context is a finer breakdown than the group the suppression threshold
         protects, and a name beside a handful of answers can say which learner wrote which. *@
      @if (_report.TeachingContextCount is int contextCount)
      {
        <p><strong>Teaching contexts that responded:</strong> @contextCount</p>
      }
      <p><strong>Narrative:</strong> @_report.CoordinatorNarrative</p>
      @foreach (var category in _report.Categories.Where(category => !category.IsSuppressed))
      {
        <div class="mb-3">
          @* By the group's label, never its key (T225). *@
          <strong>@MsfRespondentCategories.Describe(category.Category)</strong>
          @foreach (var question in category.Questions)
          {
            @if (question.Type == MsfQuestionType.Scale && question.Scale is not null)
            {
              <p>@question.Prompt: @question.Scale.Average.ToString("0.00")</p>
            }
            else if (question.Comments.Count > 0)
            {
              <p>@question.Prompt</p>
              <ul>
                @foreach (var comment in question.Comments)
                {
                  <li>@comment</li>
                }
              </ul>
            }
          }
        </div>
      }
    </section>
  }
</div>

@code {
  [Parameter] public int? CampaignId { get; set; }

  private readonly List<MsfCampaignSummaryDto> _reports = [];
  private MsfCampaignAggregateReportDto? _report;
  private bool _loading = true;
  private string? _error;

  protected override async Task OnParametersSetAsync()
  {
    _loading = true;
    _error = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        ?? throw new InvalidOperationException("The current user identifier is missing.");

      _reports.Clear();
      _reports.AddRange(await Sender.Send(new ListMsfCampaignsForTraineeQuery(userId, authState.User)));

      if (CampaignId.HasValue)
      {
        // The handler decides who may read it and returns null otherwise (T113): the subject, once released.
        // The check below is not that gate; it keeps an Administrator or a Coordinator, who may read reports about
        // others, on a page that is about their OWN reports. Whether a copy is the caller's own is the handler's
        // answer (IsSubjectsCopy, T269), the one that also leaves the teaching contexts unnamed, so this page never
        // shows a copy that names them (T164).
        _report = await Sender.Send(new GetCampaignAggregateReportQuery(CampaignId.Value, authState.User));
        if (_report is not { State: MsfCampaignState.Released, IsSubjectsCopy: true })
        {
          _report = null;
          throw new InvalidOperationException("The selected report is not available to the current trainee.");
        }
      }
      else
      {
        _report = null;
      }
    }
    catch (Exception exception)
    {
      _error = exception.Message;
    }
    finally
    {
      _loading = false;
    }
  }
}

@page "/placeholder/{Feature}"
@inject NavigationManager Navigation

@if (Headings.TryGetValue(Feature, out var heading))
{
  <PageTitle>@heading</PageTitle>

  <PageHeader Title="@heading" Subtitle="This page is not built yet." />

  <div class="detail-card detail-card--empty">
    <div class="state-panel-title">Coming soon</div>
    <div class="state-panel-copy">The menu links here so that your role's navigation is complete. The page itself is still to be built.</div>
  </div>
}

@code {
  [Parameter] public string Feature { get; set; } = string.Empty;

  /// <summary>
  /// The features the nav still links to a placeholder, by the heading each shows. Nothing else: once a feature has a
  /// real page the nav links there and its entry goes, so no placeholder stands in for a page that exists (T178).
  /// <c>NavMenuAuthorizationTests</c> fails on an entry the nav does not link, and on a placeholder link with no entry.
  /// </summary>
  public static readonly IReadOnlyDictionary<string, string> Headings = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
  {
    ["recent-activities"] = "Recent Activities",
    ["stalled-activities"] = "Stalled Activities",
    ["programme-trainees"] = "Programme Trainees",
    ["star-review-queue"] = "STAR Review Queue",
    ["system"] = "System"
  };

  /// <summary>
  /// Any other feature is Page not found, with status 404: a retired stub such as <c>/placeholder/activities</c> is not
  /// a "Coming soon" for a page that exists, and a mistyped one is not a promise (T178).
  /// </summary>
  protected override void OnParametersSet()
  {
    if (!Headings.ContainsKey(Feature))
    {
      Navigation.NotFound();
    }
  }
}

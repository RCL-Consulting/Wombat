@using System.Security.Claims
@using MediatR
@using Wombat.Application.Features.Dashboards.SubSpecialityAdmin
@attribute [Authorize(Roles = "SubSpecialityAdmin")]
@rendermode InteractiveServer
@inherits RoleDashboard<SubSpecialityAdminDashboardSummaryDto>

<DashboardFrame IsLoading="IsLoading" Failed="Failed" OnRetry="LoadAsync">
  @* The programme's backlog awaiting a reviewer, read from each activity's pinned workflow (T297). No link: the inbox
     lists only what the caller can move, not this backlog, and no page lists the backlog yet. *@
  <DashboardCard Title="Pending reviews" Icon="inbox" Emphasis="true" IsLoading="IsLoading">
    @if (Summary is { } summary)
    {
      <div class="dashboard-metric">
        <span class="dashboard-metric-value">@summary.PendingReviewCount</span>
        <span class="dashboard-metric-label">@(summary.PendingReviewCount == 1 ? "activity awaiting review" : "activities awaiting review")</span>
      </div>
    }
  </DashboardCard>

  <DashboardCard Title="Trainees in programme" Icon="users" IsLoading="IsLoading">
    @if (Summary is { } summary)
    {
      <div class="dashboard-metric">
        <span class="dashboard-metric-value">@summary.ActiveTraineeCount</span>
        <span class="dashboard-metric-label">active / @summary.InactiveTraineeCount inactive</span>
      </div>
    }
  </DashboardCard>

  @* Its title names the semester once the summary has come; until then, the card's own name (T335: a title the frame
     draws before the read, which read the summary eagerly). *@
  <DashboardCard Title="@CoverageTitle(Summary?.CurriculumCoverage.CurrentSemesterName)" Icon="book" Span="2" IsLoading="IsLoading">
    @if (Summary is { } summary)
    {
      <EpaTargetCoverageList Coverage="@summary.CurriculumCoverage" />
    }
  </DashboardCard>
</DashboardFrame>

@code {
  protected override IRequest<SubSpecialityAdminDashboardSummaryDto> QueryFor(ClaimsPrincipal user)
    => new GetSubSpecialityAdminDashboardSummaryQuery(user);

  private static string CoverageTitle(string? semester)
    => semester is null ? "Curriculum coverage" : $"Curriculum coverage — {semester}";
}

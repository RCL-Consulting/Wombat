@using Wombat.Application.Features.Dashboards.SubSpecialityAdmin
@attribute [Authorize(Roles = "SubSpecialityAdmin")]
@rendermode InteractiveServer
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<StatePanel IsLoading="_loading" LoadError="@_error">
  @if (_vm is not null)
  {
    <div class="dashboard-grid">
      <DashboardCard Title="Pending reviews" Icon="inbox" Emphasis="true">
        <div class="dashboard-metric">
          <span class="dashboard-metric-value">@_vm.PendingReviewCount</span>
          <span class="dashboard-metric-label">activities in review</span>
        </div>
        <div class="dashboard-card-footer">
          <a href="/activities/inbox" class="btn btn-sm btn-primary">Review queue &rarr;</a>
        </div>
      </DashboardCard>

      <DashboardCard Title="Trainees in programme" Icon="users">
        <div class="dashboard-metric">
          <span class="dashboard-metric-value">@_vm.ActiveTraineeCount</span>
          <span class="dashboard-metric-label">active / @_vm.InactiveTraineeCount inactive</span>
        </div>
      </DashboardCard>

      <DashboardCard Title="@($"Curriculum coverage — {_vm.CurriculumCoverage.CurrentSemesterName}")" Icon="book" Span="2">
        <EpaTargetCoverageList Coverage="@_vm.CurriculumCoverage" />
      </DashboardCard>
    </div>
  }
</StatePanel>

@code {
  private SubSpecialityAdminDashboardSummaryDto? _vm;
  private bool _loading = true;
  private string? _error;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _vm = await Sender.Send(new GetSubSpecialityAdminDashboardSummaryQuery(authState.User));
    }
    catch (Exception ex)
    {
      _error = ex.Message;
    }
    finally
    {
      _loading = false;
    }
  }
}

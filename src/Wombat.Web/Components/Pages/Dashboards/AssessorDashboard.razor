@using System.Security.Claims
@using MediatR
@using Wombat.Application.Features.Dashboards.Assessor
@attribute [Authorize(Roles = "Assessor")]
@rendermode InteractiveServer
@inherits RoleDashboard<AssessorDashboardSummaryDto>

@*
  The Assessor's Home (T350, flow 04; R3-C-Home; DESIGN.md § Dashboard page, R1): two cards, each the Activity inbox's own
  read (T297), so a card and the section it opens cannot disagree.
  - "Waiting for you": the inbox's first five rows (WaitingList), in its order and its words, the count in words as the
    title's badge and none when nothing waits (note 13), the rule line with the due days read from AssessorDueDays (E1),
    "20 more wait in the Activity inbox." past five (E5), and "Open Activity inbox". Its stripe is the warning one when any
    row is overdue, in place of the emphasis one (nit T15).
  - "Recent decisions": the five newest, each linked by its full name with "from <registrar>", its decision's badge and
    its day, and "All your decisions" to the inbox's second section.
  Until T350 the first card was "Waiting for your rating", ten rows each its type and its trainee, with Overdue in place
  of the state's badge; the second listed type and trainee only.
*@
<DashboardFrame IsLoading="IsLoading" Failed="Failed" OnRetry="LoadAsync">
  <DashboardCard Title="Waiting for you" Icon="inbox" HeadingId="card-waiting" Span="2" IsLoading="IsLoading"
                 Emphasis="true" Warning="@(Summary?.Waiting.OverdueCount > 0)"
                 BadgeWords="@(Summary is { Waiting.Count: > 0 } counted ? WaitingWords.Count(counted.Waiting) : null)">
    @if (Summary is { } summary)
    {
      if (summary.Waiting.Count == 0)
      {
        <p class="card-empty">Nothing is waiting for you.</p>
      }
      else
      {
        <p class="needs-you-rule">@WaitingWords.RuleLine(summary.Waiting.DueDays)</p>
        <WaitingList Items="@summary.Waiting.Items.Take(Listed).ToList()" Names="LinkNames" />
        @if (summary.Waiting.Count > Listed)
        {
          <p class="waiting-more">@WaitingWords.More(summary.Waiting.Count - Listed)</p>
        }
      }
      <div class="dashboard-card-footer">
        <a href="/activities/inbox" class="btn btn-sm btn-outline">Open Activity inbox</a>
      </div>
    }
  </DashboardCard>

  <DashboardCard Title="Recent decisions" Icon="history" HeadingId="card-decisions" IsLoading="IsLoading">
    @if (Summary is { } summary)
    {
      if (summary.Decisions.Items.Count == 0)
      {
        <p class="card-empty">No decisions yet.</p>
      }
      else
      {
        <ul class="decided-list">
          @foreach (var item in summary.Decisions.Items)
          {
            <li @key="item.Id" class="decided-row">
              <ActivityLink Item="item" FromSubject="true" Name="@NameOf(item)" />
              @* Green when the pinned workflow is finished, whatever its last state is called (D44), red when declined
                 (BadgeFor, T266); its words are the state's label (T220). The day is South African (note 8). *@
              <span class="decided-meta">
                <span class="badge @BadgeFor.ActivityState(item.CurrentState, item.IsFinished)">@item.CurrentStateLabel</span>
                @if (item.DecidedOn is { } decidedOn)
                {
                  <span class="decided-date">@ActivityListWords.DateOf(decidedOn)</span>
                }
              </span>
            </li>
          }
        </ul>
        <div class="dashboard-card-footer">
          <a href="/activities/inbox#decided-h" class="btn btn-sm btn-outline">All your decisions</a>
        </div>
      }
    }
  </DashboardCard>
</DashboardFrame>

@code {
  /// <summary>How many waiting rows the card lists; the inbox holds them all (R1).</summary>
  public const int Listed = 5;

  protected override IRequest<AssessorDashboardSummaryDto> QueryFor(ClaimsPrincipal user)
    => new GetAssessorDashboardSummaryQuery(user);

  // One naming over both cards, and over every waiting row, not only the five shown, so a link reads as the inbox names
  // it (C11). Named as the page draws, from the summary it draws.
  private IReadOnlyDictionary<int, string> LinkNames => Summary is { } summary
    ? AssessorRowNames.For(summary.Waiting.Items, summary.Decisions.Items)
    : new Dictionary<int, string>();

  private string? NameOf(ActivitySummaryDto item) => LinkNames.TryGetValue(item.Id, out var name) ? name : null;
}

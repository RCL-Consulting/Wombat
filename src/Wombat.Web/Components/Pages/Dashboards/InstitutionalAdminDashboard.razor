@using System.Security.Claims
@using MediatR
@using Wombat.Application.Features.Dashboards.InstitutionalAdmin
@attribute [Authorize(Roles = "InstitutionalAdmin")]
@rendermode InteractiveServer
@inherits RoleDashboard<InstitutionalAdminDashboardSummaryDto>

<DashboardFrame IsLoading="IsLoading" Failed="Failed" OnRetry="LoadAsync">
  <DashboardCard Title="Users" Icon="users" Emphasis="true" IsLoading="IsLoading">
    @if (Summary is { } summary)
    {
      if (summary.UsersByRole.Count == 0)
      {
        <p class="muted">No users found.</p>
      }
      else
      {
        <ul class="list-unstyled">
          @foreach (var item in summary.UsersByRole)
          {
            <li class="list-row">
              <span>@item.Role</span>
              <span class="dashboard-metric-value" style="font-size:1rem">@item.Count</span>
            </li>
          }
        </ul>
      }
    }
  </DashboardCard>

  <DashboardCard Title="Specialities &amp; sub-specialities" Icon="book" IsLoading="IsLoading">
    @if (Summary is { } summary)
    {
      <div class="dashboard-metric">
        <span class="dashboard-metric-value">@summary.SpecialityCount</span>
        <span class="dashboard-metric-label">specialities</span>
      </div>
      <div class="dashboard-metric" style="margin-top:var(--space-sm)">
        <span class="dashboard-metric-value">@summary.SubSpecialityCount</span>
        <span class="dashboard-metric-label">sub-specialities</span>
      </div>
    }
  </DashboardCard>

  @* Not Institutions, whose list admits only an Administrator, and not Specialities, the College's national catalogue
     (T091): an institution takes part in a speciality by adopting its curriculum (T261). Inviting a person is Home's
     header action (T335, flow 01). *@
  <DashboardCard Title="Quick links" Icon="settings" IsLoading="IsLoading">
    <div class="actions-cell">
      <a href="/admin/users" class="btn btn-outline">Users</a>
      <a href="/admin/invitations" class="btn btn-outline">Invitations</a>
      <a href="/admin/adoptions" class="btn btn-outline">Curriculum adoptions</a>
      <a href="/admin/entrustment-decisions" class="btn btn-outline">Entrustment decisions</a>
    </div>
  </DashboardCard>
</DashboardFrame>

@code {
  protected override IRequest<InstitutionalAdminDashboardSummaryDto> QueryFor(ClaimsPrincipal user)
    => new GetInstitutionalAdminDashboardSummaryQuery(user);
}

@using System.Security.Claims
@using MediatR
@using Wombat.Application.Features.Dashboards.Administrator
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@inherits RoleDashboard<AdministratorDashboardSummaryDto>

@* Two cards (R2-Shell-Admin). Job status is in System health only. Until T335 a Maintenance card repeated four nav links;
   the one it held that the nav does not, Curriculum progress, is linked from Curricula, the page that owns it (S20). *@
<DashboardFrame IsLoading="IsLoading" Failed="Failed" OnRetry="LoadAsync">
  <DashboardCard Title="System health" Icon="settings" Span="2" IsLoading="IsLoading">
    @if (Summary is { } summary)
    {
      <ul class="list-unstyled">
        <li class="list-row">
          <span><span class="status-dot @(summary.DatabaseHealthy ? "ok" : "err")"></span>Database connection</span>
        </li>
        <li class="list-row">
          <span><span class="status-dot warn"></span>Email queue <span class="muted">(T012)</span></span>
        </li>
        <li class="list-row">
          <span><span class="status-dot warn"></span>Last nightly job <span class="muted">(T024)</span></span>
        </li>
      </ul>
    }
  </DashboardCard>

  <DashboardCard Title="Users across institutions" Icon="users" Emphasis="true" IsLoading="IsLoading">
    @if (Summary is { } summary)
    {
      <div class="dashboard-metric">
        <span class="dashboard-metric-value">@summary.TotalUserCount</span>
        <span class="dashboard-metric-label">registered users</span>
      </div>
    }
  </DashboardCard>
</DashboardFrame>

@code {
  protected override IRequest<AdministratorDashboardSummaryDto> QueryFor(ClaimsPrincipal user)
    => new GetAdministratorDashboardSummaryQuery(user);
}

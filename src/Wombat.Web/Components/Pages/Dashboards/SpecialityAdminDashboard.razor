@using System.Security.Claims
@using MediatR
@using Wombat.Application.Features.Dashboards.SpecialityAdmin
@using Wombat.Web.Components.Shared.Programme
@attribute [Authorize(Roles = "SpecialityAdmin")]
@rendermode InteractiveServer
@inherits RoleDashboard<SpecialityAdminDashboardSummaryDto>

@*
  The Speciality admin's Home (T358, flow 06; Q1, Q3, Q5, Q10; R2-Home a1–a7): three cards, each spanning three, read as
  Speciality admin in the speciality's scope at the admin's institution (E4), one read behind the frame.
  - "Waiting for assessors" (#card-waiting-assessors): the page's first five (AssessorsWaitingCard).
  - "Registrars" (#card-registrars): Programme trainees' first five (RegistrarsCard).
  - "Targets by EPA" (#card-epa-targets): each EPA's "n of m registrars met" (EpaTargetCoverageList). No foot.
  "Pending reviews", "Trainees in programme" (with its "inactive") and "Curriculum coverage" are gone (Q3, Q10).
*@
<DashboardFrame IsLoading="IsLoading" Failed="Failed" OnRetry="LoadAsync">
  <AssessorsWaitingCard Waiting="@Summary?.Waiting" IsLoading="IsLoading" Span="3" />

  <RegistrarsCard Card="@Summary?.Registrars" IsLoading="IsLoading" />

  <DashboardCard Title="@TargetsByEpaWords.Title" Icon="book" HeadingId="card-epa-targets" Span="3" IsLoading="IsLoading">
    @if (Summary is { } summary)
    {
      <EpaTargetCoverageList Coverage="@summary.Coverage" />
    }
  </DashboardCard>
</DashboardFrame>

@code {
  protected override IRequest<SpecialityAdminDashboardSummaryDto> QueryFor(ClaimsPrincipal user)
    => new GetSpecialityAdminDashboardSummaryQuery(user);
}

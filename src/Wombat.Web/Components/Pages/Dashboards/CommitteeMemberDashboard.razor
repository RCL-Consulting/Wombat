@using System.Security.Claims
@using MediatR
@using Wombat.Application.Features.Dashboards.CommitteeMember
@using Wombat.Web.Components.Shared.Programme
@attribute [Authorize(Roles = "CommitteeMember")]
@rendermode InteractiveServer
@inherits RoleDashboard<CommitteeMemberDashboardSummaryDto>

@*
  The Committee member's Home (T358, flow 06; Q1, Q5; R2-Home c1–c11): two cards, each spanning three, read as Committee
  member in the institution's scope (E4), one read behind the frame.
  - "Registrars" (#card-registrars): Programme trainees' first five, each name a link to the registrar's page.
  - "Targets by EPA" (#card-epa-targets): each EPA's "n of m registrars met", its name a link to Programme trainees
    filtered Short on it. No foot: its list is Programme trainees, which the Registrars card opens.
  Until T358 they were "Targets this period" (names and "semester 1/5" with no link) and "Targets met by EPA".
*@
<DashboardFrame IsLoading="IsLoading" Failed="Failed" OnRetry="LoadAsync">
  <RegistrarsCard Card="@Summary?.Registrars" IsLoading="IsLoading" />

  <DashboardCard Title="@TargetsByEpaWords.Title" Icon="book" HeadingId="card-epa-targets" Span="3" IsLoading="IsLoading">
    @if (Summary is { } summary)
    {
      <EpaTargetCoverageList Coverage="@summary.Coverage" />
    }
  </DashboardCard>
</DashboardFrame>

@code {
  protected override IRequest<CommitteeMemberDashboardSummaryDto> QueryFor(ClaimsPrincipal user)
    => new GetCommitteeMemberDashboardSummaryQuery(user);
}

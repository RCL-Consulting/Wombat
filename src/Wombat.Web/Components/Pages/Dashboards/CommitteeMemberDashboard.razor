@using System.Security.Claims
@using MediatR
@using Wombat.Application.Features.Dashboards.CommitteeMember
@using Wombat.Application.Features.Curricula.Quota
@attribute [Authorize(Roles = "CommitteeMember")]
@rendermode InteractiveServer
@inherits RoleDashboard<CommitteeMemberDashboardSummaryDto>

<DashboardFrame IsLoading="IsLoading" Failed="Failed" OnRetry="LoadAsync">
  <DashboardCard Title="Targets this period" Icon="users" Emphasis="true" IsLoading="IsLoading">
    @if (Summary is { } summary)
    {
      <p class="progress-row-meta">@summary.CurrentSemesterName · @summary.CurrentSemesterMonths@(summary.ExemptTraineeCount > 0 ? $" · {summary.ExemptTraineeCount} exempt" : string.Empty)</p>
      if (summary.TraineeTargets.Count == 0)
      {
        <p class="muted">No trainees have targets this period.</p>
      }
      else
      {
        <ul class="list-unstyled">
          @foreach (var trainee in summary.TraineeTargets)
          {
            <li class="progress-row-head">
              <span>@trainee.TraineeName</span>
              <span class="muted">@TargetsText(trainee)</span>
            </li>
          }
        </ul>
      }
    }
  </DashboardCard>

  <DashboardCard Title="Targets met by EPA" Icon="book" Span="2" IsLoading="IsLoading">
    @if (Summary is { } summary)
    {
      <EpaTargetCoverageList Coverage="@(new CurriculumCoverage(DateOnly.MinValue, summary.CurrentSemesterName, summary.CurrentSemesterMonths, [], summary.EpaTargets, summary.ExemptTraineeCount))" />
    }
  </DashboardCard>
</DashboardFrame>

@code {
  protected override IRequest<CommitteeMemberDashboardSummaryDto> QueryFor(ClaimsPrincipal user)
    => new GetCommitteeMemberDashboardSummaryQuery(user);

  // Fewest met first (the query orders them). Semester and yearly targets are shown apart, because the
  // yearly ones are met "as opportunities arise" and would otherwise drag every trainee down all year.
  private static string TargetsText(TraineeTargetsItem trainee)
  {
    var parts = new List<string>();
    if (trainee.SemesterTargetsApplying > 0)
    {
      parts.Add($"semester {trainee.SemesterTargetsMet}/{trainee.SemesterTargetsApplying}");
    }

    if (trainee.YearTargetsApplying > 0)
    {
      parts.Add($"yearly {trainee.YearTargetsMet}/{trainee.YearTargetsApplying}");
    }

    return string.Join(" · ", parts);
  }
}

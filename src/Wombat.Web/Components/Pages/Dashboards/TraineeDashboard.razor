@using System.Security.Claims
@using MediatR
@using Wombat.Application.Features.Dashboards.Trainee
@using Wombat.Application.Features.Curricula.Quota
@attribute [Authorize(Roles = "Trainee,PendingTrainee")]
@rendermode InteractiveServer
@inherits RoleDashboard<TraineeDashboardSummaryDto>

<DashboardFrame IsLoading="IsLoading" Failed="Failed" OnRetry="LoadAsync">
  @if (Pending)
  {
    <DashboardCard Title="Awaiting admission" Icon="info" Emphasis="true" Span="3" IsLoading="IsLoading">
      <p>You are registered and waiting to be admitted to a curriculum by your programme administrator.</p>
      <div class="dashboard-card-footer">
        @* The account page, "My account": the pending trainee's name and the roles they hold. It admits every signed-in
           user (T261). Not "Complete your profile": the name came with the registration or the SSO sign-in, so nothing
           is left to complete. *@
        <a href="/account/profile" class="btn btn-sm btn-outline">Review your account &rarr;</a>
      </div>
    </DashboardCard>
  }
  else
  {
    @* No Actions card: its Log an activity and Request an assessment both opened /activities/new, which Home's header
       now offers as "Log an activity" (T335, flow 01; A-Spec § e). *@
    <DashboardCard Title="Curriculum targets" Icon="book" Href="/portfolio/progress" Emphasis="true" Span="2" IsLoading="IsLoading">
      @if (Summary is { } summary)
      {
        if (summary.CurriculumTargets is null)
        {
          <p class="muted">No curriculum assigned yet. Once you are admitted, your targets for each period appear here.</p>
        }
        else if (summary.CurriculumTargets.Ended is { } ended)
        {
          @* T252: a withdrawn trainee keeps the Trainee role and lands here. Their programme is over, so no target is owed;
             the card says so and points to the record, rather than reading "No curriculum assigned yet". *@
          <p class="muted">@EndedLine(ended) Your progress in each period is kept on My progress, read-only.</p>
        }
        else if (summary.CurriculumTargets is not { Items.Count: > 0 } targets)
        {
          @* Admitted, but no item is in force: every EPA on the curriculum is inactive (T158), or it has none yet. *@
          <p class="muted">No EPA on your curriculum is in use at the moment, so no target applies to you.</p>
        }
        else
        {
          <p class="progress-row-meta">@targets.CurrentSemesterName · @targets.CurrentSemesterMonths</p>
          <div class="dashboard-metric-row">
            @if (targets.HasSemesterItems)
            {
              <div class="dashboard-metric">
                <span class="dashboard-metric-value">@(targets.SemesterTargetsApplying > 0 ? $"{targets.SemesterTargetsMet} / {targets.SemesterTargetsApplying}" : "—")</span>
                <span class="dashboard-metric-label">@(targets.SemesterTargetsApplying > 0 ? "semester targets met" : "no semester target applies yet")</span>
              </div>
            }
            @if (targets.HasYearItems)
            {
              <div class="dashboard-metric">
                <span class="dashboard-metric-value">@(targets.YearTargetsApplying > 0 ? $"{targets.YearTargetsMet} / {targets.YearTargetsApplying}" : "—")</span>
                <span class="dashboard-metric-label">@(targets.YearTargetsApplying > 0 ? $"yearly targets met ({targets.AsOf.Year})" : "no yearly target applies yet")</span>
              </div>
            }
          </div>
          if (targets.ProgrammeNotStarted)
          {
            <p class="progress-row-meta">Your programme starts on @QuotaText.LongDate(targets.ProgrammeStartDate).</p>
          }
          else if (targets.SemesterTargetsStart is not null || targets.YearTargetsStart is not null)
          {
            <p class="progress-row-meta">
              You started part-way through a period.@(targets.SemesterTargetsStart is { } semesterStart ? $" Semester targets begin with {semesterStart.Name}." : string.Empty)@(targets.YearTargetsStart is { } yearStart ? $" Yearly targets begin with {yearStart.Name}." : string.Empty)
            </p>
          }
          foreach (var item in targets.Items
                      .Where(entry => entry.Current.Applies && !entry.Current.IsMet)
                      .OrderByDescending(entry => entry.Current.Shortfall)
                      .ThenBy(entry => entry.EpaCode, StringComparer.Ordinal)
                      .Take(5))
          {
            <div class="progress-row">
              <div class="progress-row-head">
                <span>@item.EpaCode — @item.EpaTitle</span>
                <span class="muted">@item.Current.Count of @item.Current.Target @(item.IsPerSemester ? "this semester" : $"in {item.Current.Start.Year}")</span>
              </div>
              <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="@item.Current.Target" aria-valuenow="@Math.Min(item.Current.Count, item.Current.Target)"
                   aria-label="@($"{item.EpaCode}: {item.Current.Count} of {item.Current.Target} {(item.IsPerSemester ? "this semester" : $"in {item.Current.Start.Year}")}")">
                <div class="progress-bar-fill" style="width:@item.Current.PercentOfTarget%"></div>
              </div>
            </div>
          }
        }
      }
    </DashboardCard>

    <DashboardCard Title="Activity inbox" Icon="inbox" Href="/activities/inbox" IsLoading="IsLoading">
      @if (Summary is { } summary)
      {
        if (summary.Inbox.Count == 0)
        {
          <p class="muted">No pending items.</p>
        }
        else
        {
          <ul class="list-unstyled">
            @foreach (var item in summary.Inbox)
            {
              <li class="list-row">
                @* Another trainee's row, for a trainee who also assesses, says whose it is, as the Assessor's card does (T250,
                   T297 review); the caller's own names nobody. *@
                @if (item.SubjectName is { } subjectName)
                {
                  <span><a href="/activities/@item.ActivityId" aria-label="@($"{item.ActivityTypeName} for {subjectName}")">@item.ActivityTypeName</a> &mdash; @subjectName</span>
                }
                else
                {
                  <a href="/activities/@item.ActivityId">@item.ActivityTypeName</a>
                }
                @* The badge's colour is the state's key, mapped onto a badge app.css defines (BadgeFor, T266); its words are
                   the state's label (T220). The inbox holds no finished work, so none of these is done. *@
                <span class="badge @BadgeFor.ActivityState(item.CurrentState, isFinished: false)">@item.CurrentStateLabel</span>
              </li>
            }
          </ul>
        }
        <div class="dashboard-card-footer">
          <a href="/activities/inbox" class="btn btn-sm btn-outline">Open inbox &rarr;</a>
        </div>
      }
    </DashboardCard>

    <DashboardCard Title="Recent activities" Icon="file-text" IsLoading="IsLoading">
      @if (Summary is { } summary)
      {
        if (summary.RecentActivities.Count == 0)
        {
          <p class="muted">No activities yet.</p>
        }
        else
        {
          <ul class="list-unstyled">
            @foreach (var item in summary.RecentActivities)
            {
              <li class="list-row">
                <a href="/activities/@item.ActivityId">@item.ActivityTypeName</a>
                @* Green when the pinned workflow is finished, whatever its last state is called (D44, T266 review). *@
                <span class="badge @BadgeFor.ActivityState(item.CurrentState, item.IsFinished)">@item.CurrentStateLabel</span>
              </li>
            }
          </ul>
        }
        <div class="dashboard-card-footer">
          <a href="/activities/mine" class="btn btn-sm btn-outline">All activities &rarr;</a>
        </div>
      }
    </DashboardCard>

    <DashboardCard Title="Upcoming deadlines" Icon="calendar" IsLoading="IsLoading">
      @if (Summary is { } summary)
      {
        if (summary.UpcomingDeadlines.Count == 0)
        {
          <p class="muted">No deadlines in the next 14 days.</p>
        }
        else
        {
          <ul class="list-unstyled">
            @foreach (var item in summary.UpcomingDeadlines)
            {
              <li class="list-row">
                <a href="/activities/@item.ActivityId">@item.ActivityTypeName</a>
                <span class="muted">@item.DueDate.ToString("d MMM")</span>
              </li>
            }
          </ul>
        }
      }
    </DashboardCard>

    <DashboardCard Title="My authorisations" Icon="award" Href="/portfolio/authorisations" IsLoading="IsLoading">
      <p class="muted">Statements of Awarded Responsibility (STAR) granted by committee review.</p>
      <div class="dashboard-card-footer">
        <a href="/portfolio/authorisations" class="btn btn-sm btn-outline">View authorisations &rarr;</a>
      </div>
    </DashboardCard>
  }
</DashboardFrame>

@code {
  /// <summary>The acting role, as Routes cascades it: it says which frame to draw before the read has returned.</summary>
  [CascadingParameter] public ActingRole? Acting { get; set; }

  /// <summary>
  /// A pending trainee's one card, or a trainee's six. Once the summary has come it says (the handler's reading: Pending
  /// trainee without Trainee); until then the acting role does, so the frame drawn while the read runs is the one it lands
  /// on.
  /// </summary>
  private bool Pending => Summary?.IsPendingTrainee
    ?? string.Equals(Acting?.Role, WombatRoles.PendingTrainee, StringComparison.Ordinal);

  protected override IRequest<TraineeDashboardSummaryDto> QueryFor(ClaimsPrincipal user)
    => new GetTraineeDashboardSummaryQuery(user);

  /// <summary>How the programme ended, in the words of the progress page's notice (T252, <see cref="QuotaText.ProgrammeEnded" />).</summary>
  private static string EndedLine(ProgrammeEndDto ended)
    => $"{QuotaText.ProgrammeEnded(ended)}, so no target applies to you any more.";
}

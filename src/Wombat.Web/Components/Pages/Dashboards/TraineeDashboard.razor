@using Wombat.Application.Features.Dashboards.Trainee
@using Wombat.Application.Features.Curricula.Quota
@attribute [Authorize(Roles = "Trainee,PendingTrainee")]
@rendermode InteractiveServer
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<StatePanel IsLoading="_loading" LoadError="@_error">
  @if (_vm is not null && _vm.IsPendingTrainee)
  {
    <div class="dashboard-grid">
      <DashboardCard Title="Awaiting admission" Icon="info" Emphasis="true" Span="3">
        <p>You are registered and waiting to be admitted to a curriculum by your programme administrator.</p>
        <div class="dashboard-card-footer">
          <a href="/account/manage" class="btn btn-sm btn-outline">Complete your profile &rarr;</a>
        </div>
      </DashboardCard>
    </div>
  }
  else if (_vm is not null)
  {
    <div class="dashboard-grid">
      <DashboardCard Title="Curriculum targets" Icon="book" Href="/portfolio/progress" Emphasis="true" Span="2">
        @if (_vm.CurriculumTargets is not { Items.Count: > 0 } targets)
        {
          <p class="muted">No curriculum assigned yet. Once you are admitted, your targets for each period appear here.</p>
        }
        else
        {
          <p class="progress-row-meta">@targets.CurrentSemesterName · @targets.CurrentSemesterMonths</p>
          <div style="display:flex;gap:var(--space-xl);margin:var(--space-sm) 0">
            @if (targets.HasSemesterItems)
            {
              <div class="dashboard-metric">
                <span class="dashboard-metric-value">@(targets.SemesterTargetsApplying > 0 ? $"{targets.SemesterTargetsMet} / {targets.SemesterTargetsApplying}" : "—")</span>
                <span class="dashboard-metric-label">@(targets.SemesterTargetsApplying > 0 ? "semester targets met" : "no semester target applies yet")</span>
              </div>
            }
            @if (targets.HasYearItems)
            {
              <div class="dashboard-metric">
                <span class="dashboard-metric-value">@(targets.YearTargetsApplying > 0 ? $"{targets.YearTargetsMet} / {targets.YearTargetsApplying}" : "—")</span>
                <span class="dashboard-metric-label">@(targets.YearTargetsApplying > 0 ? $"yearly targets met ({targets.AsOf.Year})" : "no yearly target applies yet")</span>
              </div>
            }
          </div>
          @if (targets.ProgrammeNotStarted)
          {
            <p class="progress-row-meta">Your programme starts on @QuotaText.LongDate(targets.ProgrammeStartDate).</p>
          }
          else if (targets.SemesterTargetsStart is not null || targets.YearTargetsStart is not null)
          {
            <p class="progress-row-meta">
              You started part-way through a period.@(targets.SemesterTargetsStart is { } semesterStart ? $" Semester targets begin with {semesterStart.Name}." : string.Empty)@(targets.YearTargetsStart is { } yearStart ? $" Yearly targets begin with {yearStart.Name}." : string.Empty)
            </p>
          }
          @foreach (var item in targets.Items
                      .Where(entry => entry.Current.Applies && !entry.Current.IsMet)
                      .OrderByDescending(entry => entry.Current.Shortfall)
                      .ThenBy(entry => entry.EpaCode, StringComparer.Ordinal)
                      .Take(5))
          {
            <div class="progress-row">
              <div class="progress-row-head">
                <span>@item.EpaCode — @item.EpaTitle</span>
                <span class="muted">@item.Current.Count of @item.Current.Target @(item.IsPerSemester ? "this semester" : $"in {item.Current.Start.Year}")</span>
              </div>
              <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="@item.Current.Target" aria-valuenow="@Math.Min(item.Current.Count, item.Current.Target)"
                   aria-label="@($"{item.EpaCode}: {item.Current.Count} of {item.Current.Target} {(item.IsPerSemester ? "this semester" : $"in {item.Current.Start.Year}")}")">
                <div class="progress-bar-fill" style="width:@item.Current.PercentOfTarget%"></div>
              </div>
            </div>
          }
        }
      </DashboardCard>

      <DashboardCard Title="Activity inbox" Icon="inbox" Href="/activities/inbox">
        @if (_vm.Inbox.Count == 0)
        {
          <p class="muted">No pending items.</p>
        }
        else
        {
          <ul class="list-unstyled">
            @foreach (var item in _vm.Inbox)
            {
              <li style="display:flex;justify-content:space-between;padding:var(--space-xs) 0">
                <a href="/activities/@item.ActivityId">@item.ActivityTypeName</a>
                <span class="badge badge-@item.CurrentState">@item.CurrentState</span>
              </li>
            }
          </ul>
        }
        <div class="dashboard-card-footer">
          <a href="/activities/inbox" class="btn btn-sm btn-outline">Open inbox &rarr;</a>
        </div>
      </DashboardCard>

      <DashboardCard Title="Recent activities" Icon="file-text">
        @if (_vm.RecentActivities.Count == 0)
        {
          <p class="muted">No activities yet.</p>
        }
        else
        {
          <ul class="list-unstyled">
            @foreach (var item in _vm.RecentActivities)
            {
              <li style="display:flex;justify-content:space-between;padding:var(--space-xs) 0">
                <a href="/activities/@item.ActivityId">@item.ActivityTypeName</a>
                <span class="badge badge-@item.CurrentState">@item.CurrentState</span>
              </li>
            }
          </ul>
        }
        <div class="dashboard-card-footer">
          <a href="/activities/mine" class="btn btn-sm btn-outline">All activities &rarr;</a>
        </div>
      </DashboardCard>

      <DashboardCard Title="Upcoming deadlines" Icon="calendar">
        @if (_vm.UpcomingDeadlines.Count == 0)
        {
          <p class="muted">No deadlines in the next 14 days.</p>
        }
        else
        {
          <ul class="list-unstyled">
            @foreach (var item in _vm.UpcomingDeadlines)
            {
              <li style="display:flex;justify-content:space-between;padding:var(--space-xs) 0">
                <a href="/activities/@item.ActivityId">@item.ActivityTypeName</a>
                <span class="muted">@item.DueDate.ToString("d MMM")</span>
              </li>
            }
          </ul>
        }
      </DashboardCard>

      <DashboardCard Title="My authorisations" Icon="award" Href="/portfolio/authorisations">
        <p class="muted">Statements of Awarded Responsibility (STAR) granted by committee review.</p>
        <div class="dashboard-card-footer">
          <a href="/portfolio/authorisations" class="btn btn-sm btn-outline">View authorisations &rarr;</a>
        </div>
      </DashboardCard>

      <DashboardCard Title="Actions" Icon="plus">
        <div style="display:flex;gap:var(--space-sm);flex-wrap:wrap">
          <a href="/activities/new" class="btn btn-primary">Log an activity</a>
          <a href="/activities/new" class="btn btn-outline">Request an assessment</a>
        </div>
      </DashboardCard>
    </div>
  }
</StatePanel>

@code {
  private TraineeDashboardSummaryDto? _vm;
  private bool _loading = true;
  private string? _error;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _vm = await Sender.Send(new GetTraineeDashboardSummaryQuery(authState.User));
    }
    catch (Exception ex)
    {
      _error = ex.Message;
    }
    finally
    {
      _loading = false;
    }
  }
}

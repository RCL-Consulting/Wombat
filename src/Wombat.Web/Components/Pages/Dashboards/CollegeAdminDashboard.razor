@attribute [Authorize(Roles = "CollegeAdmin")]
@using Wombat.Web.Components.Pages.Admin.Institutions

@* A CollegeAdmin authors the national catalogue (T091): the College's specialities, its EPAs, its curricula and its
   activity types. Until T261 Home had no case for the role, so a CollegeAdmin saw the trainee's dashboard: "No curriculum
   assigned yet", and links to pages that refuse a CollegeAdmin. It reads nothing, so it has no query and no StatePanel.
   T394 (flow 16, Q12, Q17; R2-A01): the card says what the College keeps and that a version reaches an institution once it is
   opened; its four links are the CollegeAdmin's nav row bar Entrustment scales, which the College admin only reads (D57), and they sit
   in the card's footer, where the system's 44px phone rule reaches them (36px before, as A.7.10-1 showed). *@
<div class="dashboard-grid">
  <DashboardCard Title="@CollegeTreeWords.HomeCardTitle" Icon="book" Emphasis="true" Span="2" HeadingId="home-card-catalogue">
    <p class="muted">@CollegeTreeWords.HomeCardBody</p>
    <div class="dashboard-card-footer">
      <a href="@CatalogueLinks.Specialities" class="btn btn-outline">Specialities</a>
      <a href="@CatalogueLinks.Epas" class="btn btn-outline">EPAs</a>
      <a href="@CatalogueLinks.Curricula" class="btn btn-outline">Curricula</a>
      <a href="/admin/activity-types" class="btn btn-outline">Activity types</a>
    </div>
  </DashboardCard>
</div>

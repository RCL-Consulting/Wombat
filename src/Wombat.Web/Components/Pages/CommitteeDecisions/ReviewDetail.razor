@page "/committee/reviews/{ReviewId:int}"
@attribute [Authorize(Roles = "CommitteeMember,Coordinator,Administrator,InstitutionalAdmin,SpecialityAdmin,SubSpecialityAdmin")]
@using System.Security.Claims
@using Microsoft.Extensions.DependencyInjection
@using Wombat.Application.Features.Curricula.Quota
@using Wombat.Application.Features.Programme
@using Wombat.Web.Components.Pages.CommitteeDecisions.Review
@using Wombat.Web.Components.Shared.Programme
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<ReviewDetail> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider

@*
  A committee review, sat (T361, flow 07; round 3's boards, R2-Spec; DESIGN.md § Committee agenda, § The chair's controls,
  § Detail page, § Stacking). "The agenda is the page": one column, its h1 the trainee and the period (the title rule),
  the sitting bar under it, the agenda as the page's spine with one line open at a time, and the decision under the agenda
  until it is recorded, then above it. No deferral anywhere (D53): every line left unstaged reads "Not decided at this
  sitting" with the decision's one sentence. No live following (T362): a reader keeps up by Refresh.

  This page is a host. What it draws is in Review/: SittingBar, AgendaTable with its open line (AgendaLineForm or
  EvidenceReader), the foot form, DecisionForm, and ReviewWords, every sentence it ships. It holds the state those share:
  the review and its sibling reads, the drafts the chair has typed (E9), the one result on the page and where it sits
  (round 3 item 15: beside its control, taking the focus), and the dialogs (ConfirmDialog, "Not yet" or "Keep it" safe).

  The review is read again after every action, done or refused (T260), and on Refresh; each sibling read fails apart in
  its own sentence (T329, round 3 item 11). Never an exception's text on the page: it goes to the log.
*@

<PageTitle>@Heading · Wombat</PageTitle>

<PageHeader Title="@Heading" SubtitleContent="@Subtitle" CurrentCrumb="@(_notFound ? "Not found" : null)"
            Icon="@(_notFound ? "search" : null)" />

@* Always present, filled while the review is read: a live region added with its words in it is often not read. *@
<p class="visually-hidden" role="status">@(_loading ? ReviewWords.Loading : null)</p>

<StatePanel IsLoading="_loading" LoadError="@_loadError" OnRetry="RetryAsync" FocusAfterRetry="FocusHeadingAsync">
  <LoadingContent>
    @* Board 8: the header at once, a skeleton and no action until loaded; reduced motion keeps still blocks. *@
    <div class="review-page" aria-busy="true">
      <p class="muted" aria-hidden="true">@ReviewWords.Loading</p>
      <div class="dashboard-card-skeleton" aria-hidden="true"><div class="skeleton"></div><div class="skeleton"></div></div>
      <div class="detail-card" aria-hidden="true"><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></div>
    </div>
  </LoadingContent>
  <ChildContent>
    @if (_notFound || _review is null)
    {
      @* Flow 01's not found with this page's sentence (board 8): an id out of reach reads as one that names nothing (T194). *@
      <div class="system-panel">
        <p>@ReviewWords.NotFound</p>
        <div class="actions-cell">
          <a class="btn btn-primary" href="@NavItems.CommitteeReviews.Href">@ReviewWords.BackToReviews</a>
        </div>
      </div>
    }
    else
    {
      var review = _review;
      var decided = review.State is not (CommitteeReviewState.Scheduled or CommitteeReviewState.InProgress);
      <div class="review-page">
        <SittingBar View="@Bar" AsOf="@AsOf" Busy="@(_inFlight is not null)" Refreshing="@(_inFlight == RefreshAction)"
                    OnStart="OpenStartAsync" OnGoToDecision="GoToDecisionAsync" OnRatify="OpenRatifyAsync"
                    OnClose="OpenCloseAsync" OnRefresh="RefreshAsync" Focus="FocusByIdAsync" />
        @ResultAt(BarPlace)

        @NotesSection

        @if (review.IsFormative)
        {
          @SnapshotSection
          @StandingSection
          @MsfCoverageSection
          @TrajectorySection
        }
        else
        {
          @if (decided)
          {
            @DecisionSection
          }
          <AgendaTable Review="review" Agenda="_agenda" Pending="_pending"
                       ChairStages="@ChairStages" ChairActsOnDecided="@(ChairMayAct && review.State == CommitteeReviewState.Decided)"
                       OpenEpaId="_openEpaId" DraftEpaIds="_drafts.Keys" OpenContent="OpenLine"
                       Result="@(_resultPlace is null ? null : ResultRegion)" ResultAtTop="@(_resultPlace == AgendaPlace)"
                       ResultEpaId="@ResultLine" Foot="@(ChairStages ? FootForm : null)"
                       AgendaError="_agendaFailed" PendingError="_pendingFailed" Busy="@(_inFlight is not null)"
                       OnStage="OpenLineFor" OnRemove="OpenRemoveAsync" />
          @if (!decided)
          {
            @DecisionSection
          }
          @StandingSection
          @MsfCoverageSection
          @SnapshotSection
          @TrajectorySection
          @AppealsSection
        }
      </div>

      @Dialogs
    }
  </ChildContent>
</StatePanel>

@code {
  [Parameter] public int ReviewId { get; set; }

  /// <summary>The acting role, as App resolved it and Routes cascades it; the claims' when nothing cascades it.</summary>
  [CascadingParameter] public ActingRole? Acting { get; set; }

  private const string RefreshAction = "refresh";
  private const string StartAction = "start";
  private const string CloseAction = "close";
  private const string RatifyAction = "ratify";
  private const string RecordAction = "record";
  private const string ResolveAction = "resolve";
  private const string RemoveAction = "remove";

  private static string StageAction(int key) => $"stage:{key}";

  // Where the page's one result sits (round 3 item 15): beside the control it answers.
  private const string BarPlace = "bar";
  private const string AgendaPlace = "agenda";
  private const string DecisionPlace = "decision";
  private const string AppealsPlace = "appeals";
  private const string FootPlace = "foot";

  private static string LinePlace(int epaId) => $"line:{epaId}";

  private static string FormPlace(int key) => $"form:{key}";

  private bool _loading = true;
  private string? _loadError;
  private bool _notFound;
  private ClaimsPrincipal _user = new();

  private CommitteeReviewDetailDto? _review;
  private CommitteeAgendaDto? _agenda;
  private bool _agendaFailed;
  private IReadOnlyList<PendingEntrustmentDecisionDto> _pending = [];
  private bool _pendingFailed;
  private SamplingConcentrationReportDto? _samplingReport;
  private MsfCampaignsOutsideSnapshotDto _msfOutsideSnapshot = MsfCampaignsOutsideSnapshotDto.None;
  private IReadOnlyList<EpaTrajectoryDto> _trajectories = [];
  private bool _trajectoriesFailed;
  private IReadOnlyList<StarEpaOptionDto> _starEpas = [];
  private IReadOnlyList<EntrustmentScaleDto> _scales = [];
  private EntrustmentStandingDto? _standing;
  private string? _standingError;
  private MsfCoverageDto? _msfCoverage;
  private string? _msfCoverageError;

  // When the review was last read, and what the last Refresh found (21; E7).
  private DateTime _readAt;
  private string? _refreshChange;

  // What the chair has typed: the decision, each line's draft (E9), and the foot form's.
  private DecisionDraft _decision = new();
  private readonly Dictionary<int, LineDraft> _drafts = [];
  private LineDraft _foot = new();
  private int? _openEpaId;
  private CommitteeEvidenceDto? _reading;

  // The action sent and not yet answered (T234): one at a time.
  private string? _inFlight;

  // The page's one result: where it sits, its kind and its words; and whether it takes the focus after the next render.
  private string? _resultPlace;
  private string _resultKind = "success";
  private string? _resultText;
  private ActionResult? _result;
  private bool _focusResult;

  // An element to focus by id after the next render: the opened line's level, the reader's heading, a Read, a Stage.
  private string? _focusId;

  private ConfirmDialog? _startDialog;
  private ConfirmDialog? _removeDialog;
  private ConfirmDialog? _recordDialog;
  private ConfirmDialog? _ratifyDialog;
  private ConfirmDialog? _closeDialog;
  private StartPreviewDto? _startPreview;
  private PendingEntrustmentDecisionDto? _removing;

  private AppealResolutionModel _appeal = new();
  private InputSelect<CommitteeAppealOutcome?>? _appealOutcomeSelect;
  private bool _focusAppealOutcome;
  private const string AppealOutcomeMessageId = "appeal-outcome-message";

  // The clock the host registers, else the system's: "today" on the South African calendar (T325).
  private TimeProvider Clock => ServiceProvider.GetService<TimeProvider>() ?? TimeProvider.System;

  private DateOnly Today => QuotaCalendar.Today(Clock);

  /// <summary>The h1, the tab's stem and the crumb (the title rule): "Committee review" while it is read.</summary>
  private string Heading => _loading || _loadError is not null ? ReviewWords.LoadingHeading
    : _notFound || _review is null ? ReviewWords.NotFoundHeading
    : ReviewWords.Heading(_review);

  /// <summary>
  /// The subtitle, and "Lerato Molefe's progress" under it (round 3 item 19): for the four roles flow 06's registrar page
  /// admits (ProgrammeReadAs), while the trainee trains at the panel's institution (TraineeProfileId).
  /// </summary>
  private RenderFragment? Subtitle => _loading || _loadError is not null || _notFound || _review is null
    ? null
    : __builder =>
    {
      var review = _review;
      <span>@ReviewWords.Subtitle(review)</span>
      @if (ProgressHref is { } href)
      {
        <a class="review-progress-link" href="@href">@ReviewWords.ProgressLink(review.TraineeName ?? string.Empty)</a>
      }
    };

  private string? ProgressHref
    => _review is { TraineeProfileId: int profileId, TraineeName: not null, TraineeElsewhere: null } &&
       ProgrammeReadAs.RoleFor(Acting ?? ActingRoleResolver.Resolve(_user), ProgrammeScope.RosterRoles) is not null
      ? ProgrammeLinks.Trainee(profileId)
      : null;

  private bool ChairMayAct => _review is not null && ReviewSitting.ChairMayAct(_review);

  /// <summary>The chair may stage: the chair, while the review is in progress (T213).</summary>
  private bool ChairStages => ChairMayAct && _review?.State == CommitteeReviewState.InProgress && _review.IsFormative == false;

  private int Present => 1 + (_review?.PanelMembers ?? [])
    .Count(member => member.MaySit && member.Role != DecisionPanelMemberRole.Chair && _decision.PresentUserIds.Contains(member.UserId));

  private SittingBarView Bar => ReviewSitting.Bar(_review!, _agenda, _pending, Present);

  private string AsOf => ReviewWords.AsOf(_readAt, Today, _refreshChange);

  private int? ResultLine
    => _resultPlace is { } place && place.StartsWith("line:", StringComparison.Ordinal) &&
       int.TryParse(place.AsSpan(5), out var epaId)
      ? epaId
      : null;

  // ─── Reading ─────────────────────────────────────────────────────────────────

  protected override async Task OnParametersSetAsync()
  {
    _loading = true;
    _loadError = null;
    _notFound = false;
    ClearResult();
    await LoadOrFailAsync();

    // Opened at a snapshot line (the activity page's way back): the line is drawn only now, so take the focus there.
    if (_review is not null && ReviewLinks.SnapshotLineIn(Navigation.Uri) is { } line)
    {
      _focusId = line;
    }
  }

  private async Task LoadOrFailAsync()
  {
    try
    {
      _user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
      await ReadReviewAsync();
      await ReadSectionsAsync(everything: true);
    }
    catch (UnauthorizedAccessException)
    {
      // T194: an unknown id and one out of reach get the same one refusal, so the page is not found either way.
      _notFound = true;
      _review = null;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      // Never the exception's text (T329): a fixed sentence, the failure to the log.
      Logger.LogError(exception, "Committee review {ReviewId} could not be loaded.", ReviewId);
      _loadError = ReviewWords.LoadFailed;
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task RetryAsync()
  {
    _loading = true;
    _loadError = null;
    StateHasChanged();
    await LoadOrFailAsync();
  }

  private ValueTask FocusHeadingAsync() => PageFocus.FocusHeadingAsync(JS);

  /// <summary>The review, with its agenda, read through the review's ladder.</summary>
  private async Task ReadReviewAsync()
  {
    _review = await Sender.Send(new GetCommitteeReviewByIdQuery(ReviewId, _user));
    _agenda = _review.Agenda;
    _agendaFailed = false;
    _readAt = Clock.GetUtcNow().UtcDateTime;
  }

  /// <summary>
  /// The review's sibling reads, each apart (round 3 item 11): a failure is its own section's sentence, never the page's.
  /// <paramref name="everything" /> adds what no action changes: the trajectories, the MSF coverage, the staging lists.
  /// </summary>
  private async Task ReadSectionsAsync(bool everything)
  {
    if (_review is null)
    {
      return;
    }

    var review = _review;

    try
    {
      _pending = await Sender.Send(new ListPendingEntrustmentDecisionsForReviewQuery(ReviewId, _user));
      _pendingFailed = false;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogWarning(exception, "Committee review {ReviewId}'s staged decisions could not be read.", ReviewId);
      _pendingFailed = true;
    }

    _samplingReport = await TryAsync(() => Sender.Send(new GetSamplingConcentrationWarningsQuery(ReviewId, _user)), "sampling report", _samplingReport);
    _msfOutsideSnapshot = await TryAsync(() => Sender.Send(new CountMsfCampaignsOutsideSnapshotQuery(ReviewId, _user)), "MSF count", _msfOutsideSnapshot)
                          ?? MsfCampaignsOutsideSnapshotDto.None;

    // Ratifying issues the staged decisions, which is exactly what the standing reads (T166).
    try
    {
      _standing = await Sender.Send(new GetEntrustmentStandingForTraineeQuery(
        review.TraineeUserId, _user, review.ReviewPeriodTo < Today ? review.ReviewPeriodTo : null));
      _standingError = null;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogWarning(exception, "Committee review {ReviewId}'s standing could not be read.", ReviewId);
      _standing = null;
      _standingError = ReviewWords.StandingFailed;
    }

    if (!everything)
    {
      return;
    }

    try
    {
      // The review's window (T355, D2): a rating outside it is not charted here.
      _trajectories = await Sender.Send(new GetEpaTrajectoryForTraineeQuery(
        review.TraineeUserId, _user, review.ReviewPeriodFrom, review.ReviewPeriodTo));
      _trajectoriesFailed = false;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogWarning(exception, "Committee review {ReviewId}'s trajectories could not be read.", ReviewId);
      _trajectories = [];
      _trajectoriesFailed = true;
    }

    try
    {
      _msfCoverage = await Sender.Send(new GetMsfCoverageForTraineeQuery(
        review.TraineeUserId, _user, review.ReviewPeriodFrom, review.ReviewPeriodTo));
      _msfCoverageError = null;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogWarning(exception, "Committee review {ReviewId}'s MSF coverage could not be read.", ReviewId);
      _msfCoverage = null;
      _msfCoverageError = ReviewWords.MsfCoverageFailed;
    }

    // The trainee's curriculum and the ladders, which the staging forms offer (StarCurriculum, T167): only to the chair.
    if (ChairMayAct && review.State == CommitteeReviewState.InProgress)
    {
      _starEpas = await TryAsync(() => Sender.Send(new ListStarEpaOptionsForReviewQuery(ReviewId, _user)), "curriculum", _starEpas) ?? [];
      if (_scales.Count == 0)
      {
        _scales = await TryAsync(() => Sender.Send(new GetEntrustmentScalesListQuery()), "scales", _scales) ?? [];
      }
    }
  }

  private async Task<T?> TryAsync<T>(Func<Task<T>> read, string what, T? fallback)
  {
    try
    {
      return await read();
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogWarning(exception, "Committee review {ReviewId}'s {What} could not be read.", ReviewId, what);
      return fallback;
    }
  }

  /// <summary>
  /// What an action changed, read again (T260), done or refused. The review through its query, which names everyone;
  /// where that fails, the command's answer named from the copy the page holds (T142) and the agenda apart.
  /// </summary>
  private async Task ReadAgainAsync(CommitteeReviewDetailDto? answer)
  {
    var before = _review;
    try
    {
      await ReadReviewAsync();
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogWarning(exception, "Committee review {ReviewId} could not be read again after an action.", ReviewId);
      if (answer is not null)
      {
        _review = answer.WithNamesFrom(before) with
        {
          TraineeProfileId = before?.TraineeProfileId,
          TrainingYear = before?.TrainingYear
        };
      }

      try
      {
        _agenda = await Sender.Send(new GetCommitteeAgendaQuery(ReviewId, _user));
        _agendaFailed = false;
      }
      catch (Exception agendaException) when (agendaException is not OperationCanceledException)
      {
        Logger.LogWarning(agendaException, "Committee review {ReviewId}'s agenda could not be read again.", ReviewId);
        _agendaFailed = true;
      }
    }

    await ReadSectionsAsync(everything: before?.State != _review?.State);
  }

  /// <summary>
  /// Refresh (21; round-3-check): the review read again in place, scroll and focus kept on Refresh, and the status says
  /// what changed: "As of 14:31 SAST. Now Decided.", "… Now 4 staged.", or "… No change.".
  /// </summary>
  private async Task RefreshAsync()
  {
    if (_inFlight is not null || _review is null)
    {
      return;
    }

    _inFlight = RefreshAction;
    var state = _review.State;
    var stateLabel = _review.StateLabel;
    var staged = ReviewSitting.StagedCount(_agenda, _pending);
    try
    {
      await ReadReviewAsync();
      await ReadSectionsAsync(everything: _review.State != state);
      var nowStaged = ReviewSitting.StagedCount(_agenda, _pending);
      _refreshChange = ReviewWords.RefreshChange(
        _review.StateLabel != stateLabel ? _review.StateLabel : null,
        _review.State == CommitteeReviewState.InProgress && nowStaged != staged ? nowStaged : null);
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogWarning(exception, "Committee review {ReviewId} could not be refreshed.", ReviewId);
      _refreshChange = ReviewWords.RefreshFailed;
    }
    finally
    {
      _inFlight = null;
    }
  }

  // ─── Results and focus ───────────────────────────────────────────────────────

  private void ClearResult()
  {
    _resultPlace = null;
    _resultText = null;
    _resultKind = "success";
  }

  private void ShowResult(string place, string kind, string text)
  {
    _resultPlace = place;
    _resultKind = kind;
    _resultText = text;
    _focusResult = true;
  }

  /// <summary>The page's one result region (T234), drawn where <see cref="_resultPlace" /> says.</summary>
  private RenderFragment ResultRegion => __builder =>
  {
    <ActionResult @ref="_result" Id="review-result">
      <Alert Kind="@_resultKind">@_resultText</Alert>
    </ActionResult>
  };

  private RenderFragment? ResultAt(string place) => _resultPlace == place ? ResultRegion : null;

  private ValueTask FocusByIdAsync(string id) => PageFocus.FocusByIdAsync(JS, id);

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusResult && _result is not null && _resultPlace is not null)
    {
      _focusResult = false;
      await _result.Element.FocusAsync();
    }
    else if (_focusId is { } id)
    {
      _focusId = null;
      try
      {
        await FocusByIdAsync(id);
      }
      catch (JSException)
      {
        // Focus is a convenience; what it would have shown is on the page either way.
      }
    }

    if (_focusAppealOutcome)
    {
      _focusAppealOutcome = false;
      if (_appealOutcomeSelect?.Element is { } outcome)
      {
        await outcome.FocusAsync();
      }
    }
  }

  /// <summary>
  /// Sends one of the review's commands, unless an action runs (T234), then reads the review again, done or refused
  /// (T260); the result sits beside the control and takes the focus.
  /// </summary>
  private async Task<bool> ExecuteAsync(
    string name,
    Func<ClaimsPrincipal, Task<CommitteeReviewDetailDto>> action,
    string donePlace,
    string done,
    string refusedPlace,
    Func<string, string>? refusal = null)
  {
    if (_inFlight is not null)
    {
      return false;
    }

    _inFlight = name;
    ClearResult();
    try
    {
      CommitteeReviewDetailDto answer;
      try
      {
        answer = await action(_user);
      }
      catch (Exception exception) when (exception is not OperationCanceledException)
      {
        var text = RefusalText.Of(exception);
        await ReadAgainAsync(null);
        ShowResult(refusedPlace, "danger", refusal is null ? text : refusal(text));
        return false;
      }

      await ReadAgainAsync(answer);
      ShowResult(donePlace, "success", done);
      return true;
    }
    finally
    {
      _inFlight = null;
    }
  }

  // ─── The bar's acts ──────────────────────────────────────────────────────────

  /// <summary>
  /// Start review… (round 3 item 11): what Start would freeze, counted by the code Start runs, then the dialog. A preview
  /// that cannot be read leaves the window alone in the dialog; Start itself refuses a review that moved meanwhile.
  /// </summary>
  private async Task OpenStartAsync()
  {
    _startPreview = await TryAsync(() => Sender.Send(new GetStartPreviewQuery(ReviewId, _user)), "start preview", (StartPreviewDto?)null);
    StateHasChanged();
    await ShowAsync(_startDialog);
  }

  private Task StartAsync()
    => ExecuteAsync(
      StartAction,
      user => Sender.Send(new StartCommitteeReviewCommand(ReviewId, user)),
      _review?.IsFormative == true ? BarPlace : AgendaPlace,
      ReviewWords.Started,
      BarPlace);

  private async Task GoToDecisionAsync() => await FocusByIdAsync("decision-heading");

  private async Task OpenRatifyAsync() => await ShowAsync(_ratifyDialog);

  private Task RatifyAsync()
    => ExecuteAsync(
      RatifyAction,
      user => Sender.Send(new RatifyCommitteeDecisionCommand(ReviewId, user)),
      BarPlace,
      ReviewWords.Ratified,
      BarPlace);

  private async Task OpenCloseAsync() => await ShowAsync(_closeDialog);

  private Task CloseAsync()
    => ExecuteAsync(
      CloseAction,
      user => Sender.Send(new CloseFormativeReviewCommand(ReviewId, user)),
      BarPlace,
      ReviewWords.Closed,
      BarPlace);

  private static async Task ShowAsync(ConfirmDialog? dialog)
  {
    if (dialog is not null)
    {
      await dialog.ShowAsync();
    }
  }

  // ─── The agenda's lines (E9; C2, C3) ────────────────────────────────────────

  private LineDraft NewDraft(int epaId) => new() { EpaId = epaId, IssuedOn = Today };

  private static string Prefix(int key) => $"stage-{key}";

  /// <summary>Stage on a line: opens it, keeping any other line's typed form as its draft (E9); the focus to its level.</summary>
  private void OpenLineFor(CommitteeAgendaLineDto line)
  {
    if (_openEpaId != line.EpaId)
    {
      _reading = null;
      _openEpaId = line.EpaId;
      if (!_drafts.ContainsKey(line.EpaId))
      {
        _drafts[line.EpaId] = NewDraft(line.EpaId);
      }

      ClearResult();
    }

    _focusId = $"{Prefix(line.EpaId)}-level";
  }

  /// <summary>Cancel: discards the draft and closes the line; the focus back on its Stage.</summary>
  private void CancelLine(int epaId)
  {
    _drafts.Remove(epaId);
    if (_openEpaId == epaId)
    {
      _openEpaId = null;
      _reading = null;
    }

    ClearResult();
    _focusId = AgendaTable.StageId(epaId);
  }

  /// <summary>Read (C3): the activity as it is now takes the form's place; its heading takes the focus.</summary>
  private void Read(CommitteeEvidenceDto line)
  {
    if (_openEpaId is not int epaId)
    {
      return;
    }

    _reading = line;
    _focusId = EvidenceReader.HeadingIdFor(Prefix(epaId));
  }

  /// <summary>Back from the reader: the form as typed, the focus on the Read that was pressed.</summary>
  private void BackFromReader()
  {
    if (_openEpaId is not int epaId || _reading is null)
    {
      return;
    }

    _focusId = AgendaLineForm.ReadId(Prefix(epaId), _reading.Id);
    _reading = null;
  }

  /// <summary>"Rating chart for PAED-001": the focus to its chart's heading (C2).</summary>
  private async Task JumpToChartAsync(int epaId) => await FocusByIdAsync($"trajectory-{epaId}-h");

  /// <summary>The open line's form, or Read's reader in its place.</summary>
  private RenderFragment<CommitteeAgendaLineDto> OpenLine => line => __builder =>
  {
    var prefix = Prefix(line.EpaId);
    if (_reading is { } reading)
    {
      <EvidenceReader Line="reading" EpaCode="@line.EpaCode" IdPrefix="@prefix" OnBack="BackFromReader" />
    }
    else if (_drafts.TryGetValue(line.EpaId, out var draft))
    {
      <AgendaLineForm Draft="draft" IdPrefix="@prefix" Heading="@ReviewWords.StageHeading(line.EpaCode)"
                      StarEpas="_starEpas" Scales="_scales" EvidenceItems="_review!.EvidenceItems"
                      Standing="StandingLine" HasChart="HasChart" OffersRead="true"
                      Result="@ResultAt(FormPlace(line.EpaId))"
                      OnRead="Read" OnChartJump="JumpToChartAsync"
                      OnStage="() => StageAsync(draft, foot: false)" OnCancel="() => CancelLine(line.EpaId)"
                      Busy="@(_inFlight is not null)" Running="@(_inFlight == StageAction(line.EpaId))" Focus="FocusByIdAsync" />
    }
  };

  /// <summary>"Stage a decision on an EPA not on this agenda", at the agenda's foot: an EPA select, no Read.</summary>
  private RenderFragment FootForm => __builder =>
  {
    <div class="agenda-foot" id="agenda-foot">
      @if (_starEpas.Count == 0)
      {
        <p class="muted">@ReviewWords.NoCurriculumEpa</p>
      }
      else
      {
        <AgendaLineForm Draft="_foot" IdPrefix="@Prefix(0)" ChoosesEpa="true" Heading="@ReviewWords.FootHeading"
                        StarEpas="_starEpas" Scales="_scales" EvidenceItems="_review!.EvidenceItems"
                        Standing="StandingLine" HasChart="HasChart" OnChartJump="JumpToChartAsync"
                        Result="@(_resultPlace is FootPlace ? ResultRegion : ResultAt(FormPlace(0)))"
                        OnStage="() => StageAsync(_foot, foot: true)"
                        Busy="@(_inFlight is not null)" Running="@(_inFlight == StageAction(0))" Focus="FocusByIdAsync" />
      }
    </div>
  };

  /// <summary>
  /// The open line's standing in one line (round 3 items 11, 26): the year's target and the STAR, the ratings in the
  /// review window, the MSF. A part that failed is replaced by "Standing could not be loaded." once, in its place.
  /// </summary>
  private string? StandingLine(int epaId)
  {
    var parts = new List<string>();
    var said = false;

    void Failed()
    {
      if (!said)
      {
        parts.Add(ReviewWords.StandingFailed);
        said = true;
      }
    }

    if (_standingError is not null)
    {
      Failed();
    }
    else if (_standing?.Epas.FirstOrDefault(epa => epa.EpaId == epaId) is { } standing)
    {
      parts.Add(ReviewWords.TargetAndStar(_standing.TargetYear, standing.YearTargetLabel, standing.Decision?.LevelLabel));
    }

    if (_trajectoriesFailed)
    {
      Failed();
    }
    else
    {
      parts.Add(ReviewWords.RatingsInWindow(_trajectories.FirstOrDefault(trajectory => trajectory.EpaId == epaId)?.Points.Count ?? 0));
    }

    if (_msfCoverageError is not null)
    {
      Failed();
    }
    else if (_msfCoverage is not null)
    {
      parts.Add(ReviewWords.Msf(_msfCoverage.Epas.FirstOrDefault(epa => epa.EpaId == epaId)?.Periods.Any(period => period.IsCovered) == true));
    }

    return parts.Count == 0 ? null : string.Join(" · ", parts);
  }

  private bool HasChart(int epaId) => _trajectories.Any(trajectory => trajectory.EpaId == epaId && trajectory.Points.Count > 0);

  /// <summary>
  /// Stage pending decision (round 3 items 16, 30; 4.17–4.20): what the form can tell is refused at its top before
  /// anything is sent, each field marked; then the command. Staged, the line closes to Staged with the result under it;
  /// refused, the refusal at the form's top, everything typed kept.
  /// </summary>
  private async Task StageAsync(LineDraft draft, bool foot)
  {
    var key = foot ? 0 : draft.EpaId;
    if (_inFlight is not null)
    {
      return;
    }

    draft.ClearRefusal();
    ClearResult();
    if (foot && draft.EpaId == 0)
    {
      draft.FieldRefusals[LineDraft.Fields.Epa] = ReviewWords.ChooseAnEpa;
    }

    if (draft.AuthorisedLevelId == 0)
    {
      draft.FieldRefusals[LineDraft.Fields.Level] = ReviewWords.ChooseALevel;
    }

    if (draft.ExpiresOn is DateOnly expires && expires <= draft.IssuedOn)
    {
      draft.FieldRefusals[LineDraft.Fields.Expires] = ReviewWords.ExpiryRefusal;
    }

    if (string.IsNullOrWhiteSpace(draft.Rationale))
    {
      draft.FieldRefusals[LineDraft.Fields.Rationale] = ReviewWords.GiveDecisionRationale;
    }

    if (draft.FieldRefusals.Count > 0)
    {
      draft.Refusal = string.Join(" ", draft.FieldRefusals.Values);
      ShowResult(FormPlace(key), "danger", ReviewWords.NotStaged(draft.Refusal));
      return;
    }

    _inFlight = StageAction(key);
    try
    {
      try
      {
        await Sender.Send(new StagePendingEntrustmentDecisionCommand(
          ReviewId, null, draft.EpaId, draft.AuthorisedLevelId, draft.IssuedOn, draft.ExpiresOn, draft.Rationale,
          draft.EvidenceItemIds.ToArray(), _user));
      }
      catch (Exception exception) when (exception is not OperationCanceledException)
      {
        var refusal = RefusalText.Of(exception);
        draft.Refusal = refusal;
        if (refusal.Contains(ReviewWords.ExpiryRefusal, StringComparison.Ordinal))
        {
          draft.FieldRefusals[LineDraft.Fields.Expires] = ReviewWords.ExpiryRefusal;
        }

        await ReadAgainAsync(null);
        ShowResult(FormPlace(key), "danger", ReviewWords.NotStaged(refusal));
        return;
      }

      var epaId = draft.EpaId;
      if (foot)
      {
        _foot = new LineDraft();
      }
      else
      {
        _drafts.Remove(epaId);
        if (_openEpaId == epaId)
        {
          _openEpaId = null;
          _reading = null;
        }
      }

      await ReadAgainAsync(null);
      ShowResult(_agenda?.Lines.Any(line => line.EpaId == epaId) == true ? LinePlace(epaId) : FootPlace, "success", ReviewWords.StagedResult);
    }
    finally
    {
      _inFlight = null;
    }
  }

  /// <summary>Remove… (17, 22): the dialog names the EPA and what is discarded; "Keep it" is safe.</summary>
  private async Task OpenRemoveAsync(PendingEntrustmentDecisionDto pending)
  {
    _removing = pending;
    StateHasChanged();
    await ShowAsync(_removeDialog);
  }

  private async Task RemoveAsync()
  {
    if (_removing is not { } pending || _inFlight is not null)
    {
      return;
    }

    _inFlight = RemoveAction;
    ClearResult();
    try
    {
      try
      {
        await Sender.Send(new RemovePendingEntrustmentDecisionCommand(ReviewId, pending.Id, _user));
      }
      catch (Exception exception) when (exception is not OperationCanceledException)
      {
        var refusal = RefusalText.Of(exception);
        await ReadAgainAsync(null);
        ShowResult(LinePlace(pending.EpaId), "danger", refusal);
        return;
      }

      await ReadAgainAsync(null);
      ShowResult(_agenda?.Lines.Any(line => line.EpaId == pending.EpaId) == true ? LinePlace(pending.EpaId) : AgendaPlace,
        "success", ReviewWords.RemovedResult);
    }
    finally
    {
      _inFlight = null;
    }
  }

  // ─── The decision (T324; E1, E4) ─────────────────────────────────────────────

  /// <summary>
  /// Record decision… pressed while available: refused before any dialog where the form can tell (T324), the summary at
  /// the form's top taking the focus and each field marked; else the dialog.
  /// </summary>
  private async Task OpenRecordAsync()
  {
    _decision.ClearRefusal();
    ClearResult();
    if (_review?.DecidesProgression == true && _decision.Category is null)
    {
      _decision.FieldRefusals[DecisionDraft.Fields.Category] = ReviewWords.ChooseCategory;
    }

    if (string.IsNullOrWhiteSpace(_decision.Rationale))
    {
      _decision.FieldRefusals[DecisionDraft.Fields.Rationale] = ReviewWords.GiveRationale;
    }

    if (_decision.FieldRefusals.Count > 0)
    {
      var refusals = new List<string>();
      if (_decision.FieldRefusals.ContainsKey(DecisionDraft.Fields.Category))
      {
        refusals.Add(CommitteeReview.ProgressionNeedsACategory);
      }

      if (_decision.FieldRefusals.ContainsKey(DecisionDraft.Fields.Rationale))
      {
        refusals.Add(ReviewWords.GiveRationale);
      }

      _decision.Refusal = ReviewWords.NotRecorded(refusals);
      ShowResult(DecisionPlace, "danger", _decision.Refusal);
      return;
    }

    StateHasChanged();
    await ShowAsync(_recordDialog);
  }

  private IReadOnlyList<string> PresentLabels()
    => (_review?.PanelMembers ?? [])
      .Where(member => member.MaySit &&
                       (member.Role == DecisionPanelMemberRole.Chair || _decision.PresentUserIds.Contains(member.UserId)))
      .Select(member => member.Label)
      .ToArray();

  private IReadOnlyList<string> PresentUserIds()
    => (_review?.PanelMembers ?? [])
      .Where(member => member.MaySit &&
                       (member.Role == DecisionPanelMemberRole.Chair || _decision.PresentUserIds.Contains(member.UserId)))
      .Select(member => member.UserId)
      .ToArray();

  private async Task RecordAsync()
  {
    var recorded = await ExecuteAsync(
      RecordAction,
      user => Sender.Send(new RecordCommitteeDecisionCommand(
        ReviewId,
        // T131 slice 5: an entrustment-only review's decision records no category.
        _review?.DecidesProgression == false ? null : _decision.Category,
        _decision.Rationale,
        _decision.Conditions,
        // T361, D53, E1: the one sentence about the EPAs not decided.
        string.IsNullOrWhiteSpace(_decision.UndecidedNote) ? null : _decision.UndecidedNote.Trim(),
        PresentUserIds(),
        user)),
      DecisionPlace,
      ReviewWords.Recorded,
      DecisionPlace,
      ReviewWords.NotRecorded);

    if (recorded)
    {
      _decision = new DecisionDraft();
    }
  }

  // ─── The appeal (T213, T307) ─────────────────────────────────────────────────

  private async Task ResolveAppealAsync()
  {
    if (_appeal.Outcome is not { } outcome)
    {
      return;
    }

    var remitted = outcome == CommitteeAppealOutcome.Remitted;
    var resolved = await ExecuteAsync(
      ResolveAction,
      user => Sender.Send(new ResolveAppealCommand(
        ReviewId,
        outcome,
        remitted && _review?.DecidesProgression == true ? _appeal.RemittedCategory : null,
        remitted ? _appeal.RemittedRationale : null,
        remitted ? _appeal.RemittedConditions : null,
        remitted ? PresentForAppeal() : null,
        user)),
      AppealsPlace,
      ReviewWords.AppealResolved,
      AppealsPlace);

    if (resolved)
    {
      _appeal = new AppealResolutionModel();
    }
  }

  // The chair and whoever resolves the appeal always sat (CommitteeReview.ResolveAppeal), ticked and locked (T165).
  private IReadOnlyList<string> PresentForAppeal()
  {
    var caller = _user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    return (_review?.PanelMembers ?? [])
      .Where(member => member.MaySit)
      .Where(member => member.Role == DecisionPanelMemberRole.Chair ||
                       string.Equals(member.UserId, caller, StringComparison.Ordinal) ||
                       _appeal.PresentUserIds.Contains(member.UserId))
      .Select(member => member.UserId)
      .ToArray();
  }

  private void FocusAppealOutcome() => _focusAppealOutcome = true;

  /// <summary>Who resolves the appeal, to a reader not offered the form (T213, T237).</summary>
  private string AppealBodyNote
  {
    get
    {
      var body = _review?.AppealBody ?? [];
      var chair = body.FirstOrDefault(member => member.Role == DecisionPanelMemberRole.Chair);
      var externals = body.Where(member => member.Role == DecisionPanelMemberRole.External).Select(member => member.DisplayName).ToArray();
      if (chair is null && externals.Length == 0)
      {
        return "Only the appeal body, the panel's chair or an external member, can resolve the appeal, and none of them " +
               "can act now. A panel administrator must seat a chair who can.";
      }

      var parts = new List<string>();
      if (chair is not null)
      {
        parts.Add($"the panel's chair, {chair.DisplayName},");
      }

      if (externals.Length > 0)
      {
        parts.Add($"{(chair is null ? "the panel's" : "its")} external member{(externals.Length == 1 ? string.Empty : "s")}, " +
                  CommitteeAgendaText.Codes(externals));
      }

      return $"Only the appeal body can resolve the appeal: {CommitteeAgendaText.Codes(parts).TrimEnd(',')}.";
    }
  }

  // ─── Sections ────────────────────────────────────────────────────────────────

  /// <summary>
  /// "Before the committee decides" (round 3 items 13, 31): the sampling check, not dismissible, and what makes it
  /// incomplete (T135); an EPA whose STAR was revoked mid-review, for the chair to stage (T235). Shown when it has
  /// something to say.
  /// </summary>
  private RenderFragment NotesSection => __builder =>
  {
    var review = _review!;
    var report = _samplingReport;
    var noLongerDecided = _agenda?.NoLongerDecided ?? [];
    var incomplete = report is { EvidenceComplete: false };
    var warns = report is { AnyWarning: true };
    if (incomplete || warns || noLongerDecided.Count > 0)
    {
      <section class="detail-card" id="notes" aria-labelledby="notes-heading">
        <h2 id="notes-heading" class="review-section-title">@ReviewWords.NotesHeading</h2>
        @if (incomplete)
        {
          var withheld = report!.WithheldRatedActivities;
          var unreadable = report.UnreadableRatedActivities;
          var missing = withheld + unreadable;
          @* T135: an incomplete report is not a quiet one; not dismissible, each cause its own sentence. *@
          <Alert Kind="danger" Role="">
            <h3>Sampling figures are incomplete</h3>
            @if (withheld > 0)
            {
              <p>
                @ReviewWords.Count(withheld, "rated observation", "rated observations") in this review window
                @(withheld == 1 ? "is" : "are") outside what this account may read: evidence held by another institution,
                or recorded before the trainee transferred. Ask a panel member with the full record before relying on the
                sampling check.
              </p>
            }
            @if (unreadable > 0)
            {
              <p>
                @ReviewWords.Count(unreadable, "rated observation", "rated observations") in this review window could not
                be read: the EPA, the rating or the assessor is missing or malformed.
              </p>
            }
            <p>
              The concentration check on this page ran without @(missing == 1 ? "that observation" : "those observations").
              Treat the absence of a concentration warning as unknown rather than clean.
            </p>
          </Alert>
        }
        @if (warns)
        {
          <h3 id="sampling-heading">@ReviewWords.SamplingHeading</h3>
          <ul class="list-unstyled review-notes-list" aria-labelledby="sampling-heading">
            @foreach (var epa in report!.PerEpa)
            {
              <li>@ReviewWords.SamplingLine(epa)</li>
            }
          </ul>
          @if (report.UnattributedRatedActivities > 0)
          {
            <p class="muted">@ReviewWords.NotCounted(report.UnattributedRatedActivities)</p>
          }
        }
        @if (CommitteeAgendaText.NoLongerDecidedNote(noLongerDecided.Select(epa => epa.EpaCode).ToArray()) is { } note)
        {
          @* T235: stands until the chair acts, so no role. Stage chooses the EPA in the foot form. *@
          <Alert Kind="warning" Role="" Id="agenda-no-longer-decided">
            <p>@note</p>
            @if (ChairStages)
            {
              <div class="actions-cell">
                @foreach (var epa in noLongerDecided)
                {
                  <button type="button" class="btn btn-outline btn-sm" @onclick="() => StageOnFoot(epa.EpaId)">Stage @epa.EpaCode</button>
                }
              </div>
            }
          </Alert>
        }
      </section>
    }
  };


@page "/committee/reviews/{ReviewId:int}"
@attribute [Authorize(Roles = "CommitteeMember,Coordinator,Administrator,InstitutionalAdmin,SpecialityAdmin,SubSpecialityAdmin")]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Wombat.Application.Features.Curricula.Quota

<PageTitle>Committee Review</PageTitle>

<PageHeader Title="Committee review" Subtitle="Evidence bundle, decision record, ratification, and appeals in one place." />

@if (!string.IsNullOrWhiteSpace(_status))
{
  <Alert Kind="success">@_status</Alert>
}

@if (!string.IsNullOrWhiteSpace(_error))
{
  <Alert Kind="danger">@_error</Alert>
}

@* An incomplete report is not a quiet one: without this banner, "some of this trainee's evidence
   is outside what you may read" would render exactly like "we checked the sampling and it is
   clean", on a page where the next click decides whether someone progresses. Not dismissible for
   the same reason. Two different things make it incomplete, and each gets its own sentence, because
   the cause differs: a withheld row is one this account may not read, an unreadable one nobody can. (T135) *@
@if (_samplingReport is { EvidenceComplete: false })
{
  var withheld = _samplingReport.WithheldRatedActivities;
  var unreadable = _samplingReport.UnreadableRatedActivities;
  var missing = withheld + unreadable;
  <Alert Kind="danger">
    <div>
      <h3>Sampling figures are incomplete</h3>
      @if (withheld > 0)
      {
        <p>
          @withheld rated observation@(withheld == 1 ? string.Empty : "s")
          in this review window @(withheld == 1 ? "is" : "are") outside what your account may read —
          evidence held by another institution, or recorded before this trainee transferred. Ask a panel
          member with the full record before you rely on the sampling check.
        </p>
      }
      @if (unreadable > 0)
      {
        <p>
          @unreadable rated observation@(unreadable == 1 ? string.Empty : "s")
          in this review window could not be read: the EPA, the rating or the assessor is missing or malformed.
        </p>
      }
      <p>
        The concentration check on this page ran without @(missing == 1 ? "it" : "them").
        Treat the absence of a concentration warning as unknown rather than clean.
      </p>
    </div>
  </Alert>
}

@if (_samplingReport is { AnyWarning: true })
{
  var unattributed = _samplingReport.UnattributedRatedActivities;
  <Alert Kind="warning" Dismissible="true">
    <div>
      <h3>Sampling concentration warnings</h3>
      <p class="muted">
        @_samplingReport.TotalRatedActivities rated observation@(_samplingReport.TotalRatedActivities == 1 ? string.Empty : "s")
        from @_samplingReport.DistinctAssessorCount distinct assessor@(_samplingReport.DistinctAssessorCount == 1 ? string.Empty : "s")
        @(_samplingReport.EvidenceComplete ? "in the review window" : "that could be counted in the review window").
        Acknowledge in the decision rationale if these warnings are relevant.
      </p>
      @if (unattributed > 0)
      {
        <p class="muted">
          Not counted: @unattributed record@(unattributed == 1 ? string.Empty : "s") in the review window
          with no rating by a named assessor — the form names nobody for the rating (multi-source feedback,
          for one), or the rating or the assessor was left blank where the form allows it. The figures above
          count only ratings a named assessor gave.
        </p>
      }
      <ul class="list-unstyled">
        @foreach (var epa in _samplingReport.PerEpa)
        {
          <li>
            <strong>@epa.EpaCode — @epa.EpaTitle</strong>
            <span>@epa.RatingCount rating@(epa.RatingCount == 1 ? string.Empty : "s") · @epa.DistinctAssessorCount assessor@(epa.DistinctAssessorCount == 1 ? string.Empty : "s") · @epa.DistinctSourceCount source@(epa.DistinctSourceCount == 1 ? string.Empty : "s")</span>
            <ul class="list-unstyled">
              @if (epa.OneAssessorOverHalf)
              {
                <li>One assessor contributed @epa.DominantAssessorCount of @epa.RatingCount ratings (&gt; 50%).</li>
              }
              @if (epa.SingleSource)
              {
                <li>All ratings came from a single source of evidence.</li>
              }
              @if (epa.FewerThanThreeAssessors)
              {
                <li>Fewer than three distinct assessors across this EPA's evidence.</li>
              }
            </ul>
          </li>
        }
      </ul>
    </div>
  </Alert>
}

@if (_review is not null)
{
  <div class="details-grid">
    <section class="detail-card">
      <h3>Review</h3>
      <dl class="details-list">
        <div><dt>Trainee</dt><dd>@_review.TraineeName</dd></div>
        <div><dt>Panel</dt><dd>@_review.PanelName</dd></div>
        <div><dt>Period</dt><dd>@_review.ReviewPeriodFrom.ToString("yyyy-MM-dd") to @_review.ReviewPeriodTo.ToString("yyyy-MM-dd")</dd></div>
        <div><dt>Type</dt><dd>@(_review.ReviewType == CommitteeReviewType.PreGraduation ? "Pre-graduation review" : "Annual progression review")</dd></div>
        <div><dt>Mode</dt><dd>@(_review.IsFormative ? "Formative (interim check-in, no binding decision)" : "Summative")</dd></div>
        <div><dt>State</dt><dd>@_review.State</dd></div>
      </dl>
      <FormActions>
        @if (_review.State == CommitteeReviewState.Scheduled)
        {
          @* Said at the button as well as beside the list: the Evidence snapshot card can be three cards below this
             one on a narrow screen, and this is the click that decides it. (T173) *@
          var awaitingAtStart = _msfOutsideSnapshot.AwaitingRelease;
          if (awaitingAtStart > 0)
          {
            <span id="start-review-msf-note" class="muted">
              Starting now leaves out @awaitingAtStart feedback campaign@(awaitingAtStart == 1 ? string.Empty : "s")
              that closed in this window and @(awaitingAtStart == 1 ? "is" : "are") not yet released.
            </span>
          }
          <button type="button" class="btn btn-primary" aria-describedby="@(awaitingAtStart > 0 ? "start-review-msf-note" : null)"
                  @onclick="StartAsync">Start review</button>
        }
        @if (_review.State == CommitteeReviewState.InProgress && _review.IsFormative)
        {
          <button type="button" class="btn btn-primary" @onclick="CloseFormativeAsync">Close review</button>
        }
        @if (_review.State == CommitteeReviewState.Decided)
        {
          if (_review.QuorumShortfall is null)
          {
            <button type="button" class="btn btn-primary" @onclick="RatifyAsync">Ratify</button>
          }
          else
          {
            @* T165. Shown, not hidden, so the chair learns why (T107's pattern). No click handler: the server refuses a
               decision whose recorded attendance falls short of the quorum. *@
            <button type="button" class="btn btn-primary" disabled aria-describedby="ratify-reason">Ratify</button>
          }
        }
      </FormActions>
      @if (_review.State == CommitteeReviewState.Decided && _review.QuorumShortfall is { } shortfall)
      {
        <ul class="workflow-action-reasons">
          <li id="ratify-reason"><strong>Ratify:</strong> @shortfall</li>
        </ul>
      }
    </section>

    @if (!_review.IsFormative)
    {
      <section class="detail-card">
        <h3>Decision</h3>
        @* T165. Not a refusal: in a small programme the chair can be the only assessor who saw the trainee, and the panel
           should weigh that, not be stopped by it. Read from the frozen snapshot, so it says what the panel weighed. *@
        @if (_review.ChairRatedEveryLine is { } chairAssessor)
        {
          <Alert Kind="warning">
            <div>
              <h4>The chair rated all of this evidence</h4>
              <p>
                Every rated record in the evidence snapshot was rated by @chairAssessor.DisplayName, who chairs this panel.
                A committee decision is never a single assessor's: say in the rationale how the other members weighed it.
              </p>
            </div>
          </Alert>
        }
        <EditForm Model="_decision" OnValidSubmit="RecordDecisionAsync" FormName="committee-decision">
          <DataAnnotationsValidator />
          <ValidationSummary class="validation-summary-errors" />
          <div class="form-grid">
            <FormField Label="Category" InputId="decision-category" Required="true">
              <InputSelect id="decision-category" class="form-select" @bind-Value="_decision.Category">
                @foreach (var category in Enum.GetValues<CommitteeDecisionCategory>())
                {
                  <option value="@category">@category</option>
                }
              </InputSelect>
            </FormField>
            <FormField Label="Rationale" InputId="decision-rationale" Required="true">
              <InputTextArea id="decision-rationale" class="form-control" @bind-Value="_decision.Rationale" />
            </FormField>
            <FormField Label="Conditions" InputId="decision-conditions">
              <InputTextArea id="decision-conditions" class="form-control" @bind-Value="_decision.Conditions" />
            </FormField>
            @if (_review.State == CommitteeReviewState.InProgress)
            {
              @* T165. Who sat: a group of checkboxes, so a fieldset whose legend names it (DESIGN.md § Form system). The
                 chair is ticked and cannot be unticked, because the chair records the decision and must be present. *@
              @PresentFieldset("decision-present", _decision.PresentUserIds, lockedUserId: null)
            }
          </div>
          <FormActions>
            @if (_review.State == CommitteeReviewState.InProgress)
            {
              @* The staged STARs below are part of this decision and are fixed with it (T165): said at the button, the
                 click that fixes them. *@
              <span id="record-decision-note" class="muted">
                Recording fixes the entrustment decisions staged below: they cannot be changed afterwards.
              </span>
              if (_review.PanelShortfall is null)
              {
                <button type="submit" class="btn btn-primary" aria-describedby="record-decision-note">Record decision</button>
              }
              else
              {
                @* T107's pattern: shown, not hidden, with the reason, which the server would otherwise give only after the
                   chair had written the rationale. *@
                <button type="button" class="btn btn-primary" disabled aria-describedby="record-reason">Record decision</button>
              }
            }
          </FormActions>
          @if (_review.State == CommitteeReviewState.InProgress && _review.PanelShortfall is { } panelShortfall)
          {
            <ul class="workflow-action-reasons">
              <li id="record-reason"><strong>Record decision:</strong> @panelShortfall</li>
            </ul>
          }
        </EditForm>

        @if (_review.Decisions.Count > 0)
        {
          var replaced = _review.Decisions
            .Select(decision => decision.SupersedesDecisionId)
            .OfType<int>()
            .ToHashSet();
          <div class="stack-list">
            @foreach (var decision in _review.Decisions)
            {
              @* T165. Each decision says who took it: a decision an appeal remitted was taken by whoever sat for the
                 appeal, not by the review's first sitting. *@
              <article class="detail-card detail-card--compact" id="decision-@decision.Id">
                <h4>@decision.Category</h4>
                @if (replaced.Contains(decision.Id))
                {
                  <p class="muted">Replaced on appeal by the decision above.</p>
                }
                <p>@decision.Rationale</p>
                @if (!string.IsNullOrWhiteSpace(decision.Conditions))
                {
                  <p><strong>Conditions:</strong> @decision.Conditions</p>
                }
                @if (decision.Attendees.Count > 0)
                {
                  <p><strong>Present:</strong> @string.Join(", ", decision.Attendees.Select(attendee => attendee.Label))</p>
                }
                else
                {
                  <p class="muted">Nobody was recorded as present for this decision.</p>
                }
              </article>
            }
          </div>
        }
      </section>

      @StandingSection
      @MsfCoverageSection

      <section class="detail-card">
        <h3>Pending entrustment decisions</h3>
        <p class="muted">
          Decisions staged here are issued atomically when the committee review is ratified.
          They become formal Statements of Awarded Responsibility (STAR) at that point.
        </p>
        @if (_review.State == CommitteeReviewState.Decided)
        {
          @* T165. The staged set is part of the decision the panel recorded, so it is fixed: said here, where the form
             used to be. *@
          <p class="muted">
            Fixed when the committee's decision was recorded: ratifying issues exactly these. Only a decision that no
            longer fits the trainee's curriculum can still be removed.
          </p>
        }

        @if (_review.State == CommitteeReviewState.InProgress)
        {
          @* The EPAs are the trainee's curriculum, and each EPA's levels are the rungs of its item's ladder: the same
             list StagePendingEntrustmentDecision enforces (StarCurriculum, T167). Before T167 this listed the EPAs in
             the chair's scope, so a STAR could be staged on an EPA the trainee's programme does not contain. *@
          @if (_starEpas.Count == 0)
          {
            <p class="muted">This trainee's curriculum lists no EPA, so no entrustment decision can be staged.</p>
          }
          <EditForm Model="_pending" OnValidSubmit="StagePendingAsync" FormName="pending-entrustment">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary-errors" />
            <div class="form-grid">
              <FormField Label="EPA" InputId="pending-epa" Required="true" HelpText="The EPAs on the trainee's curriculum.">
                <InputSelect id="pending-epa" class="form-select" @bind-Value="_pending.EpaId" @bind-Value:after="OnStarEpaChanged">
                  <option value="0">Select an EPA…</option>
                  @foreach (var epa in _starEpas)
                  {
                    <option value="@epa.EpaId">@epa.Code — @epa.Title</option>
                  }
                </InputSelect>
              </FormField>
              <FormField Label="Authorised level" InputId="pending-level" Required="true" HelpText="@LevelHelpText">
                <InputSelect id="pending-level" class="form-select" @bind-Value="_pending.AuthorisedLevelId">
                  <option value="0">@(SelectedStarEpa is null ? "Select an EPA first…" : "Select a level…")</option>
                  @foreach (var scale in LevelScales)
                  {
                    <optgroup label="@scale.Name">
                      @foreach (var level in scale.Levels)
                      {
                        <option value="@level.Id">@level.Label</option>
                      }
                    </optgroup>
                  }
                </InputSelect>
              </FormField>
              <FormField Label="Issued on" InputId="pending-issued" Required="true">
                <InputDate id="pending-issued" class="form-control" @bind-Value="_pending.IssuedOn" />
              </FormField>
              <FormField Label="Expires on" InputId="pending-expires">
                <InputDate id="pending-expires" class="form-control" @bind-Value="_pending.ExpiresOn" />
              </FormField>
              <FormField Label="Rationale" InputId="pending-rationale" Required="true">
                <InputTextArea id="pending-rationale" class="form-control" @bind-Value="_pending.Rationale" />
              </FormField>

              @* D38 (T131): a decision names the lines of the frozen snapshot it rests on, at least one. The lines offered
                 are the ones StagePendingEntrustmentDecision accepts (CanGroundADecision: never a supervisor report),
                 grouped as the snapshot card below groups them, with the chosen EPA's lines first as a hint. A line
                 about any EPA may be named; that none is about this one, or that only one is named, is said, not
                 refused. *@
              @{ var picker = EvidenceSnapshotGroups.BuildPicker(_review.EvidenceItems, _pending.EpaId); }
              <fieldset class="full-width" aria-describedby="pending-evidence-help">
                <legend>Evidence it rests on</legend>
                <p id="pending-evidence-help" class="muted">
                  Tick the lines of the evidence snapshot this decision rests on.@(SelectedStarEpa is null
                    ? string.Empty
                    : $" {SelectedStarEpa.Code}'s lines are listed first.")
                </p>
                @if (picker.IsEmpty)
                {
                  <p class="muted">
                    The evidence snapshot holds no line a decision can rest on, so no entrustment decision can be staged
                    at this review.
                  </p>
                }
                @foreach (var group in picker.ByEpa)
                {
                  <fieldset class="form-group">
                    <legend>@group.EpaCode@(string.IsNullOrWhiteSpace(group.EpaTitle) ? string.Empty : $" — {group.EpaTitle}")</legend>
                    <div class="check-grid">
                      @foreach (var line in group.Instruments.SelectMany(instrument => instrument.Lines))
                      {
                        @EvidenceCheckbox(line, EvidenceSnapshotGroups.PickerDetail(line))
                      }
                    </div>
                  </fieldset>
                }
                @if (picker.AcrossEpas.Count > 0)
                {
                  <fieldset class="form-group">
                    <legend>Not about a single EPA</legend>
                    <div class="check-grid">
                      @foreach (var line in picker.AcrossEpas)
                      {
                        @EvidenceCheckbox(line, line.SourceState)
                      }
                    </div>
                  </fieldset>
                }
                @if (picker.FrozenBeforeLinesNamedTheirEpa.Count > 0)
                {
                  <fieldset class="form-group">
                    <legend>Frozen before lines named their EPA</legend>
                    <div class="check-grid">
                      @foreach (var line in picker.FrozenBeforeLinesNamedTheirEpa)
                      {
                        @EvidenceCheckbox(line, null)
                      }
                    </div>
                  </fieldset>
                }
                @* Always present, filled only when a hint applies: a screen reader announces a change to a region it
                   already knows. *@
                <div id="pending-evidence-hints" role="status">
                  @foreach (var hint in EvidenceHints)
                  {
                    <p class="field-warning">@hint</p>
                  }
                </div>
              </fieldset>
            </div>
            <FormActions>
              <button type="submit" class="btn btn-primary" disabled="@(!EvidenceNamed)"
                      aria-describedby="@(EvidenceNamed ? null : "pending-evidence-reason")">Stage pending decision</button>
            </FormActions>
            @if (!EvidenceNamed)
            {
              <ul class="workflow-action-reasons">
                <li id="pending-evidence-reason"><strong>Stage pending decision:</strong> @StagedEvidence.NoneNamed</li>
              </ul>
            }
          </EditForm>
        }

        @if (_pendingDecisions.Count == 0)
        {
          <p>No pending entrustment decisions have been staged for this review.</p>
        }
        else
        {
          <ul class="list-unstyled">
            @foreach (var pending in _pendingDecisions)
            {
              <li>
                <strong>@pending.EpaCode — @pending.EpaTitle</strong>
                <span>@pending.AuthorisedLevelLabel · issued @pending.IssuedOn.ToString("yyyy-MM-dd")@(pending.ExpiresOn.HasValue ? $" · expires {pending.ExpiresOn:yyyy-MM-dd}" : string.Empty)</span>
                <p>@pending.Rationale</p>
                @{ var restsOn = EvidenceLabels(pending.EvidenceItemIds); }
                <p class="muted">
                  @if (restsOn.Count == 0)
                  {
                    @:Names no evidence, so the review cannot be ratified with it. Remove it and stage it again.
                  }
                  else
                  {
                    @($"Rests on {restsOn.Count} item{(restsOn.Count == 1 ? string.Empty : "s")} of the snapshot: {string.Join("; ", restsOn)}.")
                  }
                </p>
                @if (pending.NoLongerFits is { } noLongerFits)
                {
                  <p class="muted"><strong>No longer fits:</strong> @noLongerFits</p>
                }
                @if (_review.State == CommitteeReviewState.InProgress ||
                     (_review.State == CommitteeReviewState.Decided && pending.NoLongerFits is not null))
                {
                  <button type="button" class="btn btn-link" @onclick="() => RemovePendingAsync(pending.Id)">Remove</button>
                }
              </li>
            }
          </ul>
        }
      </section>
    }

    <section class="detail-card" aria-labelledby="evidence-snapshot-heading">
      <h3 id="evidence-snapshot-heading">Evidence snapshot</h3>
      @* Live, and not evidence: counts read on every load, beside the frozen list rather than in it. A campaign
         enters the snapshot only once released (T138), so one that closed in this window and is still under review
         at Start reaches no review's evidence, and releasing it later does not put it back; the panel is told it
         exists, and nothing else about it. Before Start that is a reason to wait; after, a gap to weigh. (T173) *@
      @if (_msfOutsideSnapshot.Total > 0)
      {
        var awaiting = _msfOutsideSnapshot.AwaitingRelease;
        var releasedLate = _msfOutsideSnapshot.ReleasedAfterStart;
        <Alert Kind="info">
          @if (awaiting > 0)
          {
            @* "Feedback campaign": the count includes learner-feedback campaigns, which run on the same aggregate (T164). *@
            <p>@awaiting feedback @(awaiting == 1 ? "campaign that closed in this window is" : "campaigns that closed in this window are") not yet released.</p>
          }
          @if (releasedLate > 0)
          {
            <p>@releasedLate feedback @(releasedLate == 1 ? "campaign that closed in this window was" : "campaigns that closed in this window were") released after this review started.</p>
          }
          @if (_review.State == CommitteeReviewState.Scheduled)
          {
            <p>A campaign is evidence only once released. Starting the review now leaves @(awaiting == 1 ? "it" : "them") out of the snapshot.</p>
          }
          else
          {
            <p>The snapshot holds only the campaigns released before the review started, so @(_msfOutsideSnapshot.Total == 1 ? "it is" : "they are") not in it.</p>
          }
        </Alert>
      }
      @* Empty means two different things. Before Start nothing has been frozen; after it the window
         genuinely held nothing, and telling a panel that starting would capture a bundle, on a review
         already started, sends it looking for a button that is gone. (T138) *@
      @if (_review.EvidenceItems.Count == 0 && _review.State == CommitteeReviewState.Scheduled)
      {
        <p>No evidence has been frozen yet. Starting the review captures the current bundle.</p>
      }
      else if (_review.EvidenceItems.Count == 0)
      {
        <p>The review window held no evidence when this review started.</p>
      }
      else
      {
        @* Grouped by EPA, then by instrument, so a panel reads what each EPA rests on without opening every
           activity. Every state is listed and labelled: a run of declines is evidence too (T135). Each line is
           what was frozen at Start, not the activity as it stands now. (T167) *@
        var snapshot = EvidenceSnapshotGroups.Build(_review.EvidenceItems);
        <p class="muted">Frozen when the review started, grouped by EPA and then by instrument. Every state is listed.</p>
        <div class="stack-list">
          @foreach (var group in snapshot.ByEpa)
          {
            var headingId = $"evidence-epa-{group.EpaId}";
            <article class="detail-card detail-card--compact" aria-labelledby="@headingId">
              <h4 id="@headingId">@group.EpaCode@(string.IsNullOrWhiteSpace(group.EpaTitle) ? string.Empty : $" — {group.EpaTitle}")</h4>
              <div class="table-container">
                <table class="clinic-table">
                  <caption>@group.LineCount record@(group.LineCount == 1 ? string.Empty : "s") from @group.Instruments.Count instrument@(group.Instruments.Count == 1 ? string.Empty : "s")</caption>
                  <thead>
                    <tr>
                      <th scope="col">Instrument</th>
                      <th scope="col">Record</th>
                      <th scope="col">Rating</th>
                      <th scope="col">Encounter</th>
                      <th scope="col">State</th>
                    </tr>
                  </thead>
                  @foreach (var instrument in group.Instruments)
                  {
                    <tbody>
                      @for (var index = 0; index < instrument.Lines.Count; index++)
                      {
                        var line = instrument.Lines[index];
                        <tr>
                          @if (index == 0)
                          {
                            <th scope="rowgroup" rowspan="@instrument.Lines.Count">@instrument.InstrumentName</th>
                          }
                          <td><a href="/activities/@line.ActivityId">@line.SourceLabel</a></td>
                          <td>@EvidenceSnapshotGroups.RatingText(line)</td>
                          <td>
                            @if (line.ObservedOn is DateOnly observedOn)
                            {
                              <EncounterDateLabel ObservedOn="observedOn" Declared="@(line.ObservedOnDeclared == true)" />
                            }
                          </td>
                          <td>@line.SourceState</td>
                        </tr>
                      }
                    </tbody>
                  }
                </table>
              </div>
            </article>
          }

          @if (snapshot.AcrossEpas.Count > 0)
          {
            <article class="detail-card detail-card--compact" aria-labelledby="evidence-across-epas">
              <h4 id="evidence-across-epas">Not about a single EPA</h4>
              @* Each sentence only when it is true of this list. A review frozen before T167 has no EPA cards: its
                 campaign's per-EPA records are among the old lines in the card below, not "under each EPA above". *@
              @if (snapshot.AcrossEpasHoldsACampaignReport)
              {
                <p class="muted">@(snapshot.FrozenBeforeLinesNamedTheirEpa.Count == 0
                  ? "A feedback campaign's report (multi-source or learner feedback) covers several EPAs; its per-EPA records are listed under each EPA above."
                  : "A feedback campaign's report (multi-source or learner feedback) covers several EPAs; its per-EPA records are among the lines below, " +
                    "frozen before lines named their EPA.")</p>
              }
              @if (snapshot.AcrossEpasHoldsAnActivity)
              {
                <p class="muted">An activity here names no EPA.</p>
              }
              <ul class="list-unstyled">
                @foreach (var item in snapshot.AcrossEpas)
                {
                  <li><strong>@item.SourceLabel</strong> <span>@item.Summary</span></li>
                }
              </ul>
            </article>
          }

          @if (snapshot.FrozenBeforeLinesNamedTheirEpa.Count > 0)
          {
            <article class="detail-card detail-card--compact" aria-labelledby="evidence-frozen-before">
              <h4 id="evidence-frozen-before">Frozen before lines named their EPA</h4>
              <p class="muted">
                This review started before each line recorded its EPA, instrument, rating and encounter date, so these
                are listed as they were frozen.
              </p>
              <ul class="list-unstyled">
                @foreach (var item in snapshot.FrozenBeforeLinesNamedTheirEpa)
                {
                  <li><strong>@item.SourceLabel</strong> <span>@item.Summary</span></li>
                }
              </ul>
            </article>
          }
        </div>
      }
    </section>

    @if (_review.IsFormative)
    {
      @StandingSection
      @MsfCoverageSection
    }

    <section class="detail-card">
      <h3>Rating trajectory by EPA</h3>
      @if (_trajectories.Count == 0)
      {
        <p class="muted">No rating by a named assessor to chart for this trainee.</p>
      }
      else
      {
        <div class="stack-list">
          @foreach (var trajectory in _trajectories)
          {
            <article class="detail-card detail-card--compact">
              <h4>@trajectory.EpaCode — @trajectory.EpaTitle</h4>
              <p class="muted">@trajectory.Points.Count observation@(trajectory.Points.Count == 1 ? string.Empty : "s")</p>
              <TrajectoryChart Points="@TrajectoryChart.PointsOf(trajectory)"
                               Rungs="@BuildRungs(trajectory)"
                               AriaLabel="@($"Rating trajectory for {trajectory.EpaCode}")" />
            </article>
          }
        </div>
      }
    </section>

    @if (!_review.IsFormative)
    {
      <section class="detail-card">
        <h3>Appeals</h3>
        <EditForm Model="_appeal" OnValidSubmit="ResolveAppealAsync" FormName="committee-appeal-resolution">
          <DataAnnotationsValidator />
          <ValidationSummary class="validation-summary-errors" />
          <div class="form-grid">
            <FormField Label="Outcome" InputId="appeal-outcome" Required="true">
              <InputSelect id="appeal-outcome" class="form-select" @bind-Value="_appeal.Outcome">
                @foreach (var outcome in Enum.GetValues<CommitteeAppealOutcome>())
                {
                  <option value="@outcome">@outcome</option>
                }
              </InputSelect>
            </FormField>
            @if (_appeal.Outcome == CommitteeAppealOutcome.Remitted)
            {
              <FormField Label="Replacement category" InputId="appeal-category" Required="true">
                <InputSelect id="appeal-category" class="form-select" @bind-Value="_appeal.RemittedCategory">
                  @foreach (var category in Enum.GetValues<CommitteeDecisionCategory>())
                  {
                    <option value="@category">@category</option>
                  }
                </InputSelect>
              </FormField>
              <FormField Label="Replacement rationale" InputId="appeal-rationale" Required="true">
                <InputTextArea id="appeal-rationale" class="form-control" @bind-Value="_appeal.RemittedRationale" />
              </FormField>
              @* T165. The replacement is a committee decision, so it records who sat for it, held to the same quorum. The
                 chair and whoever resolves are ticked and locked: both must have sat. *@
              @PresentFieldset("remit-present", _appeal.PresentUserIds, lockedUserId: _currentUserId)
            }
          </div>
          <FormActions>
            @if (_review.State == CommitteeReviewState.UnderAppeal)
            {
              if (_appeal.Outcome == CommitteeAppealOutcome.Remitted && _review.PanelShortfall is not null)
              {
                <button type="button" class="btn btn-primary" disabled aria-describedby="remit-reason">Resolve appeal</button>
              }
              else
              {
                <button type="submit" class="btn btn-primary">Resolve appeal</button>
              }
            }
          </FormActions>
          @if (_review.State == CommitteeReviewState.UnderAppeal &&
               _appeal.Outcome == CommitteeAppealOutcome.Remitted &&
               _review.PanelShortfall is { } remitShortfall)
          {
            <ul class="workflow-action-reasons">
              <li id="remit-reason"><strong>Resolve appeal:</strong> @remitShortfall</li>
            </ul>
          }
        </EditForm>

        @if (_review.Appeals.Count > 0)
        {
          <ul class="list-unstyled">
            @foreach (var appeal in _review.Appeals)
            {
              <li><strong>@appeal.LodgedOn.ToString("yyyy-MM-dd")</strong> @appeal.Reason (@(appeal.Outcome?.ToString() ?? "Open"))</li>
            }
          </ul>
        }
      </section>
    }
  </div>
}

@code {
  [Parameter] public int ReviewId { get; set; }

  private CommitteeReviewDetailDto? _review;
  private string? _status;
  private string? _error;
  private DecisionFormModel _decision = new();
  private AppealResolutionModel _appeal = new();
  private PendingDecisionFormModel _pending = new();
  private IReadOnlyList<PendingEntrustmentDecisionDto> _pendingDecisions = Array.Empty<PendingEntrustmentDecisionDto>();
  private IReadOnlyList<StarEpaOptionDto> _starEpas = Array.Empty<StarEpaOptionDto>();
  private IReadOnlyList<EntrustmentScaleDto> _scales = Array.Empty<EntrustmentScaleDto>();
  private SamplingConcentrationReportDto? _samplingReport;
  private MsfCampaignsOutsideSnapshotDto _msfOutsideSnapshot = MsfCampaignsOutsideSnapshotDto.None;
  private IReadOnlyList<EpaTrajectoryDto> _trajectories = Array.Empty<EpaTrajectoryDto>();
  private EntrustmentStandingDto? _standing;
  private string? _standingError;
  private MsfCoverageDto? _msfCoverage;
  private string? _msfCoverageError;
  private string? _currentUserId;

  protected override async Task OnParametersSetAsync()
  {
    await LoadAsync();
  }

  private async Task LoadAsync()
  {
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
      _review = await Sender.Send(new GetCommitteeReviewByIdQuery(ReviewId, authState.User));
      _pendingDecisions = await Sender.Send(new ListPendingEntrustmentDecisionsForReviewQuery(ReviewId, authState.User));
      _samplingReport = await Sender.Send(new GetSamplingConcentrationWarningsQuery(ReviewId, authState.User));
      _msfOutsideSnapshot = await Sender.Send(new CountMsfCampaignsOutsideSnapshotQuery(ReviewId, authState.User));
      _trajectories = await Sender.Send(new GetEpaTrajectoryForTraineeQuery(_review.TraineeUserId, authState.User));
      // T167: the trainee's curriculum, each EPA with the ladder its level must be on. The same list the stage
      // handler enforces, so the picker cannot offer what the gate refuses.
      _starEpas = await Sender.Send(new ListStarEpaOptionsForReviewQuery(ReviewId, authState.User));
      if (_scales.Count == 0)
      {
        _scales = await Sender.Send(new GetEntrustmentScalesListQuery());
      }
    }
    catch (Exception exception)
    {
      _error = exception.Message;
    }

    await LoadStandingAsync();
    await LoadMsfCoverageAsync();
  }

  /// <summary>
  /// Per EPA and per semester of the review period, whether a released MSF campaign covering the EPA closed in it
  /// (T168). Loaded apart, like the standing: it is advisory, and a failure says so in its own card. Read live, for the
  /// whole period: no action on this page changes it, so it is not read again after one.
  /// </summary>
  private async Task LoadMsfCoverageAsync()
  {
    if (_review is null)
    {
      return;
    }

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _msfCoverage = await Sender.Send(new GetMsfCoverageForTraineeQuery(
        _review.TraineeUserId,
        authState.User,
        _review.ReviewPeriodFrom,
        _review.ReviewPeriodTo));
      _msfCoverageError = null;
    }
    catch (Exception exception)
    {
      _msfCoverage = null;
      _msfCoverageError = exception.Message;
    }
  }

  /// <summary>
  /// The trainee's standing against Annexure A (T166). Loaded apart from the review: it is advisory, and a failure here
  /// must not take the review, and the actions on it, down with it. It says so in its own card instead.
  /// </summary>
  private async Task LoadStandingAsync()
  {
    if (_review is null)
    {
      return;
    }

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _standing = await Sender.Send(new GetEntrustmentStandingForTraineeQuery(
        _review.TraineeUserId,
        authState.User,
        StandingReadFor(_review.ReviewPeriodTo, QuotaCalendar.Today())));
      _standingError = null;
    }
    catch (Exception exception)
    {
      _standing = null;
      _standingError = exception.Message;
    }
  }

  private async Task StartAsync()
  {
    await ExecuteAsync(user => Sender.Send(new StartCommitteeReviewCommand(ReviewId, user)), "Review started.");
  }

  private async Task RecordDecisionAsync()
  {
    await ExecuteAsync(
      user => Sender.Send(new RecordCommitteeDecisionCommand(
        ReviewId, _decision.Category, _decision.Rationale, _decision.Conditions,
        PresentUserIds(_decision.PresentUserIds, lockedUserId: null), user)),
      "Decision recorded.");
  }

  // T165. Who is sent as present: the members who may sit, in the panel's order, of whom the chair (and, at an appeal,
  // whoever resolves it) always is, ticked and locked on the form and sent whatever was clicked, and the rest as ticked.
  private IReadOnlyList<string> PresentUserIds(HashSet<string> ticked, string? lockedUserId)
    => _review is null
      ? []
      : _review.PanelMembers
        .Where(member => member.MaySit)
        .Where(member => IsLockedPresent(member, lockedUserId) || ticked.Contains(member.UserId))
        .Select(member => member.UserId)
        .ToArray();

  private static bool IsLockedPresent(CommitteePersonDto member, string? lockedUserId)
    => member.Role == DecisionPanelMemberRole.Chair ||
       (lockedUserId is not null && string.Equals(member.UserId, lockedUserId, StringComparison.Ordinal));

  private static void TogglePresent(HashSet<string> ticked, string userId, bool present)
  {
    if (present)
    {
      ticked.Add(userId);
    }
    else
    {
      ticked.Remove(userId);
    }
  }

  /// <summary>
  /// Who sat, as a group of checkboxes: a fieldset whose legend names it, one checkbox per panel member who may sit
  /// (<c>PanelSeat</c>), each with its own id under <paramref name="idPrefix" /> (DESIGN.md § Form system). Nobody who
  /// may not sit is offered, so the form cannot send someone the server refuses. (T165)
  /// </summary>
  private RenderFragment PresentFieldset(string idPrefix, HashSet<string> ticked, string? lockedUserId) => __builder =>
  {
    var seated = _review?.PanelMembers.Where(member => member.MaySit).ToArray() ?? [];
    <fieldset class="full-width" aria-describedby="@($"{idPrefix}-help")">
      <legend>
        Present
        <span aria-hidden="true">*</span>
        <span class="visually-hidden">required</span>
      </legend>
      <p id="@($"{idPrefix}-help")" class="muted">
        Tick every panel member at this sitting. @CommitteeReviewDetailDto.QuorumRule
      </p>
      <div class="check-grid">
        @for (var index = 0; index < seated.Length; index++)
        {
          var member = seated[index];
          // By position, not by user id: an id is any string, and an id attribute must not hold a space.
          var inputId = $"{idPrefix}-{index}";
          <div class="form-check">
            @if (IsLockedPresent(member, lockedUserId))
            {
              <input id="@inputId" class="form-check-input" type="checkbox" checked disabled />
            }
            else
            {
              <input id="@inputId" class="form-check-input" type="checkbox"
                     checked="@ticked.Contains(member.UserId)"
                     @onchange="args => TogglePresent(ticked, member.UserId, args.Value is bool isChecked && isChecked)" />
            }
            <label for="@inputId">@member.Label</label>
          </div>
        }
      </div>
    </fieldset>
  };

  private async Task RatifyAsync()
  {
    await ExecuteAsync(user => Sender.Send(new RatifyCommitteeDecisionCommand(ReviewId, user)), "Decision ratified.");
  }

  private async Task CloseFormativeAsync()
  {
    await ExecuteAsync(user => Sender.Send(new CloseFormativeReviewCommand(ReviewId, user)), "Formative review closed.");
  }

  private async Task ResolveAppealAsync()
  {
    await ExecuteAsync(
      user => Sender.Send(new ResolveAppealCommand(
        ReviewId,
        _appeal.Outcome,
        _appeal.RemittedCategory,
        _appeal.RemittedRationale,
        _appeal.RemittedConditions,
        // T165: a remitted appeal's replacement records who sat for it; the other outcomes take no decision.
        _appeal.Outcome == CommitteeAppealOutcome.Remitted ? PresentUserIds(_appeal.PresentUserIds, _currentUserId) : null,
        user)),
      "Appeal resolved.");
  }

  private async Task StagePendingAsync()
  {
    _error = null;
    _status = null;

    // The button is disabled until an item is ticked; this covers a submit by the Enter key. The handler refuses too.
    if (!EvidenceNamed)
    {
      _error = StagedEvidence.NoneNamed;
      return;
    }

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await Sender.Send(new StagePendingEntrustmentDecisionCommand(
        ReviewId,
        null,
        _pending.EpaId,
        _pending.AuthorisedLevelId,
        _pending.IssuedOn,
        _pending.ExpiresOn,
        _pending.Rationale,
        NamedEvidenceIds(),
        authState.User));
      _pending = new PendingDecisionFormModel();
      _pendingDecisions = await Sender.Send(new ListPendingEntrustmentDecisionsForReviewQuery(ReviewId, authState.User));
      _status = "Pending entrustment decision staged.";
    }
    catch (Exception exception)
    {
      _error = exception.Message;
    }
  }

  private StarEpaOptionDto? SelectedStarEpa => _starEpas.FirstOrDefault(option => option.EpaId == _pending.EpaId);

  // The rungs of the selected EPA's ladder: its curriculum item's pinned scale, else the programme's scale, else every
  // scale (StarCurriculum). Nothing until an EPA is chosen, because the ladder is the EPA's.
  private IEnumerable<EntrustmentScaleDto> LevelScales => SelectedStarEpa switch
  {
    null => Array.Empty<EntrustmentScaleDto>(),
    { ScaleId: int scaleId } => _scales.Where(scale => scale.Id == scaleId),
    _ => _scales
  };

  private string LevelHelpText => SelectedStarEpa switch
  {
    null => "The rungs of the chosen EPA's ladder.",
    { ScaleName: { } name } => $"Rungs of {name}, the ladder this EPA is assessed on.",
    _ => "This EPA is on no ladder, so any scale's rung may be chosen."
  };

  // A level chosen for one EPA is not a rung of another's ladder; clear it rather than submit a level the picker no
  // longer shows.
  private void OnStarEpaChanged()
  {
    if (!LevelScales.SelectMany(scale => scale.Levels).Any(level => level.Id == _pending.AuthorisedLevelId))
    {
      _pending.AuthorisedLevelId = 0;
    }
  }

  // ---- The evidence a staged decision rests on (D38, T131) ----------------------------------------------------------

  // The ticked lines, as the review holds them. Only lines the handler accepts can be ticked, since only they are listed;
  // the filter is repeated so that nothing else is ever sent.
  private IReadOnlyList<CommitteeEvidenceDto> NamedEvidenceLines()
    => _review is null
      ? Array.Empty<CommitteeEvidenceDto>()
      : _review.EvidenceItems
        .Where(line => line.CanGroundADecision && _pending.EvidenceItemIds.Contains(line.Id))
        .ToArray();

  private int[] NamedEvidenceIds() => NamedEvidenceLines().Select(line => line.Id).ToArray();

  private bool EvidenceNamed => NamedEvidenceLines().Count > 0;

  internal const string NoFinishedItemHint =
    "None of the named items was finished when the review started (each shows the state it was in), so the decision " +
    "would rest on no completed assessment.";

  // Said, never enforced: D38 as adopted asks for one item, about any EPA (the design's Decision 8, question O1).
  private IReadOnlyList<string> EvidenceHints
  {
    get
    {
      var named = NamedEvidenceLines();
      if (named.Count == 0)
      {
        return Array.Empty<string>();
      }

      var hints = new List<string>();
      if (named.Count == 1)
      {
        hints.Add("Only one item is named. The College's rule is that an entrustment decision is never taken from a single form.");
      }

      if (SelectedStarEpa is { } epa && named.All(line => line.EpaId != epa.EpaId))
      {
        hints.Add($"None of the named items is about {epa.Code}.");
      }

      // A requested form nobody filled in, a draft, a declined or cancelled request: every state is in the snapshot on
      // purpose (T138), and D38 as adopted lets any line ground a decision, so this is said, not refused. Only lines
      // known to be unfinished count; a line frozen before T131 records neither. (T131 review)
      if (named.All(line => line.SourceFinished == false))
      {
        hints.Add(NoFinishedItemHint);
      }

      return hints;
    }
  }

  private void ToggleEvidence(int evidenceId, bool isChecked)
  {
    if (isChecked)
    {
      _pending.EvidenceItemIds.Add(evidenceId);
    }
    else
    {
      _pending.EvidenceItemIds.Remove(evidenceId);
    }
  }

  // What a staged decision rests on, by the snapshot's own labels.
  private IReadOnlyList<string> EvidenceLabels(IReadOnlyList<int> evidenceItemIds)
    => evidenceItemIds
      .Select(id => _review?.EvidenceItems.FirstOrDefault(line => line.Id == id)?.SourceLabel ?? $"item #{id}")
      .ToArray();

  private RenderFragment EvidenceCheckbox(CommitteeEvidenceDto line, string? detail) =>
    @<div class="form-check">
      <input id="@($"pending-evidence-{line.Id}")" class="form-check-input" type="checkbox"
             checked="@_pending.EvidenceItemIds.Contains(line.Id)"
             @onchange="args => ToggleEvidence(line.Id, args.Value is bool isChecked && isChecked)" />
      <label for="@($"pending-evidence-{line.Id}")">
        @line.SourceLabel
        @if (!string.IsNullOrWhiteSpace(detail))
        {
          <span class="muted">· @detail</span>
        }
      </label>
    </div>;

  private async Task RemovePendingAsync(int pendingId)
  {
    _error = null;
    _status = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await Sender.Send(new RemovePendingEntrustmentDecisionCommand(ReviewId, pendingId, authState.User));
      _pendingDecisions = await Sender.Send(new ListPendingEntrustmentDecisionsForReviewQuery(ReviewId, authState.User));
      _status = "Pending entrustment decision removed.";
    }
    catch (Exception exception)
    {
      _error = exception.Message;
    }
  }

  /// <summary>
  /// The day the standing's training year is read for: the review period's last day once it has passed, else today
  /// (null). A review judges a period, and is often held after it ends; read for today, a trainee whose year has just
  /// turned would be held to next year's targets at the review of this one. Only the year moves: the decisions a review
  /// issues postdate its period, so they are read as they stand. (T166)
  /// </summary>
  private static DateOnly? StandingReadFor(DateOnly reviewPeriodTo, DateOnly today)
    => reviewPeriodTo < today ? reviewPeriodTo : null;

  /// <summary>
  /// Full width, after the first pair of cards: the Decision card on a summative review, the Evidence snapshot on a
  /// formative one, so neither leaves an empty cell beside the Review card. (T166)
  /// </summary>
  private RenderFragment StandingSection => __builder =>
  {
    <section class="detail-card full-width">
      <h3>Entrustment against Annexure A</h3>
      <EntrustmentStandingPanel Standing="@_standing" LoadError="@_standingError" ReviewPeriodTo="@_review?.ReviewPeriodTo" />
    </section>
  };

  /// <summary>
  /// Full width, directly after the standing wherever that sits, so the pair of cards below it stays a pair. (T168)
  /// </summary>
  private RenderFragment MsfCoverageSection => __builder =>
  {
    <section class="detail-card full-width" aria-labelledby="msf-coverage-heading">
      <h3 id="msf-coverage-heading">Multi-source feedback by EPA</h3>
      <MsfCoveragePanel Coverage="@_msfCoverage" LoadError="@_msfCoverageError"
                        ReviewPeriodFrom="@_review?.ReviewPeriodFrom" ReviewPeriodTo="@_review?.ReviewPeriodTo"
                        ReviewState="@_review?.State" />
    </section>
  };

  // The axis comes from the ladder the trainee's curriculum item is pinned to, resolved server-side.
  // Empty when nothing is pinned, which draws the numeric axis this chart drew before T123.
  private static IReadOnlyList<TrajectoryChart.Rung> BuildRungs(EpaTrajectoryDto trajectory)
    => trajectory.Rungs
      .Select(rung => new TrajectoryChart.Rung(rung.Order, rung.Label))
      .ToArray();

  private async Task ExecuteAsync(Func<System.Security.Claims.ClaimsPrincipal, Task<CommitteeReviewDetailDto>> action, string status)
  {
    _error = null;
    _status = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var updated = await action(authState.User);

      // The command's answer is the review as it now stands, but it is built by the mapper the commands share, which
      // names nobody. A review's trainee never changes, so the name the page loaded with carries over, and so do the
      // panel's names, which cover everyone a decision can record as present (T165). Reading the review back instead
      // would be a second round trip that can fail after the action has already succeeded. (T142)
      _review = updated.WithNamesFrom(_review);
      _status = status;

    }
    catch (Exception exception)
    {
      _error = exception.Message;
      return;
    }

    // The MSF notice is live, and an action can change what it must say. Start above all: it freezes the snapshot the
    // counts are measured against, and a campaign released since the page loaded is now in it (T173). Refreshed outside
    // the action's try: the action has succeeded, and a failed count must not show that success beside an error (T142).
    // The notice keeps its last value instead.
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _msfOutsideSnapshot = await Sender.Send(new CountMsfCampaignsOutsideSnapshotQuery(ReviewId, authState.User));
    }
    catch (Exception)
    {
      // Deliberately silent: the notice is advisory, and the page already says what the action did.
    }

    // Ratifying issues the staged STAR decisions, which is exactly what the standing reads, so it is read again after
    // every action. A failure lands in the standing card, not beside the action's success.
    await LoadStandingAsync();
  }

  private sealed class DecisionFormModel
  {
    [Required]
    public CommitteeDecisionCategory Category { get; set; } = CommitteeDecisionCategory.SatisfactoryProgress;

    [Required]
    public string Rationale { get; set; } = string.Empty;

    public string? Conditions { get; set; }

    /// <summary>The members ticked as present, other than the chair, who always is (T165).</summary>
    public HashSet<string> PresentUserIds { get; } = new(StringComparer.Ordinal);
  }

  private sealed class AppealResolutionModel
  {
    [Required]
    public CommitteeAppealOutcome Outcome { get; set; } = CommitteeAppealOutcome.Dismissed;

    public CommitteeDecisionCategory? RemittedCategory { get; set; }
    public string? RemittedRationale { get; set; }
    public string? RemittedConditions { get; set; }

    /// <summary>The members ticked as present for a remitted replacement, other than those always present (T165).</summary>
    public HashSet<string> PresentUserIds { get; } = new(StringComparer.Ordinal);
  }

  private sealed class PendingDecisionFormModel
  {
    [Range(1, int.MaxValue, ErrorMessage = "Select an EPA.")]
    public int EpaId { get; set; }

    [Range(1, int.MaxValue, ErrorMessage = "Select an entrustment level.")]
    public int AuthorisedLevelId { get; set; }

    [Required]
    public DateOnly IssuedOn { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);

    public DateOnly? ExpiresOn { get; set; }

    [Required]
    public string Rationale { get; set; } = string.Empty;

    // The ids of the ticked snapshot lines (D38, T131).
    public HashSet<int> EvidenceItemIds { get; } = new();
  }
}

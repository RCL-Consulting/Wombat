  /// <summary>
  /// The frozen snapshot (Q6; round 3 items 23, 30): by EPA, then instrument A–Z. Each line's item goes to flow 03's page
  /// with the review's way back (ReviewLinks), and carries the id that way back lands on.
  /// </summary>
  private RenderFragment SnapshotSection => __builder =>
  {
    var review = _review!;
    <section class="detail-card" id="evidence-snapshot" aria-labelledby="evidence-snapshot-heading">
      <h2 id="evidence-snapshot-heading" class="review-section-title">@ReviewWords.SnapshotHeading</h2>
      @* T173: live, and not evidence: a campaign closed in the window and not yet released reaches no snapshot. *@
      @if (_msfOutsideSnapshot.Total > 0)
      {
        var awaiting = _msfOutsideSnapshot.AwaitingRelease;
        var releasedLate = _msfOutsideSnapshot.ReleasedAfterStart;
        <Alert Kind="info">
          @if (awaiting > 0)
          {
            <p>@awaiting feedback @(awaiting == 1 ? "campaign that closed in this window is" : "campaigns that closed in this window are") not yet released.</p>
          }
          @if (releasedLate > 0)
          {
            <p>@releasedLate feedback @(releasedLate == 1 ? "campaign that closed in this window was" : "campaigns that closed in this window were") released after this review started.</p>
          }
          @if (review.State == CommitteeReviewState.Scheduled)
          {
            <p>A campaign is evidence only once released. Starting the review now leaves @(awaiting == 1 ? "that campaign" : "those campaigns") out of the snapshot.</p>
          }
          else
          {
            <p>The snapshot holds only the campaigns released before the review started, so @(_msfOutsideSnapshot.Total == 1 ? "that campaign is" : "those campaigns are") not in it.</p>
          }
        </Alert>
      }
      @if (review.EvidenceItems.Count == 0)
      {
        <p>@(review.State == CommitteeReviewState.Scheduled ? ReviewWords.NothingFrozenYet
              : review.StartedOn is null ? ReviewWords.NothingFrozenWithdrawn
              : ReviewWords.WindowHeldNothing)</p>
      }
      else
      {
        var snapshot = EvidenceSnapshotGroups.Build(review.EvidenceItems);
        <p class="muted">@ReviewWords.FrozenOn(review.StartedOn is DateTime started ? ActivityMoments.Date(started) : string.Empty, review.EvidenceItems.Count)</p>
        @foreach (var group in snapshot.ByEpa)
        {
          var headingId = $"evidence-epa-{group.EpaId}";
          <h3 id="@headingId" class="snapshot-group-heading">@group.EpaCode@(string.IsNullOrWhiteSpace(group.EpaTitle) ? string.Empty : $" — {group.EpaTitle}")</h3>
          <div class="table-container">
            <table class="clinic-table clinic-table--stack" role="table" aria-labelledby="@headingId">
              <thead role="rowgroup">
                <tr role="row">
                  <th scope="col" role="columnheader">Item</th>
                  <th scope="col" role="columnheader">Assessor</th>
                  <th scope="col" role="columnheader">Rating</th>
                  <th scope="col" role="columnheader">Encounter</th>
                  <th scope="col" role="columnheader">State</th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                @foreach (var line in group.Instruments.SelectMany(instrument => instrument.Lines))
                {
                  <tr role="row" id="@ReviewLinks.SnapshotLineId(line.Id)">
                    <th scope="row" role="rowheader">
                      @if (line.ActivityId is int activityId)
                      {
                        <a href="@ReviewLinks.ActivityFromReview(activityId, review.Id, line.Id)">@line.SourceLabel</a>
                      }
                      else
                      {
                        @line.SourceLabel
                      }
                    </th>
                    <td role="cell" data-label="Assessor">@line.AssessorName</td>
                    <td role="cell" data-label="Rating">@EvidenceSnapshotGroups.RatingText(line)</td>
                    <td role="cell" data-label="Encounter">
                      @if (line.ObservedOn is DateOnly observedOn)
                      {
                        <EncounterDateLabel ObservedOn="observedOn" Declared="@(line.ObservedOnDeclared == true)" />
                      }
                    </td>
                    <td role="cell" data-label="State">@line.SourceStateLabel</td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
        @if (snapshot.AcrossEpas.Count > 0)
        {
          <h3 id="evidence-across-epas" class="snapshot-group-heading">@ReviewWords.AcrossEpasHeading</h3>
          @if (snapshot.AcrossEpasHoldsACampaignReport)
          {
            <p class="muted">@(snapshot.FrozenBeforeLinesNamedTheirEpa.Count == 0
              ? "A feedback campaign's report (multi-source or learner feedback) covers several EPAs; its per-EPA records are listed under each EPA above."
              : "A feedback campaign's report (multi-source or learner feedback) covers several EPAs; its per-EPA records are among the lines below, frozen before lines named their EPA.")</p>
          }
          @if (snapshot.AcrossEpasHoldsAnActivity)
          {
            <p class="muted">An activity here names no EPA.</p>
          }
          <ul class="list-unstyled" aria-labelledby="evidence-across-epas">
            @foreach (var item in snapshot.AcrossEpas)
            {
              <li id="@ReviewLinks.SnapshotLineId(item.Id)">
                @if (item.ActivityId is int activityId)
                {
                  <a href="@ReviewLinks.ActivityFromReview(activityId, review.Id, item.Id)">@item.SourceLabel</a>
                }
                else
                {
                  <strong>@item.SourceLabel</strong>
                }
                <span>@($" · {item.Summary}")</span>
              </li>
            }
          </ul>
        }
        @if (snapshot.FrozenBeforeLinesNamedTheirEpa.Count > 0)
        {
          <h3 id="evidence-frozen-before" class="snapshot-group-heading">@ReviewWords.FrozenBeforeHeading</h3>
          <p class="muted">
            This review started before each line recorded its EPA, instrument, rating and encounter date, so these are listed
            as they were frozen.
          </p>
          <ul class="list-unstyled" aria-labelledby="evidence-frozen-before">
            @foreach (var item in snapshot.FrozenBeforeLinesNamedTheirEpa)
            {
              <li id="@ReviewLinks.SnapshotLineId(item.Id)"><strong>@item.SourceLabel</strong> <span>@item.Summary</span></li>
            }
          </ul>
        }
      }
    </section>
  };


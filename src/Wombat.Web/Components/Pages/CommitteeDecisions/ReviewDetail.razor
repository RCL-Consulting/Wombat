  private RenderFragment AppealsSection => __builder =>
  {
    var review = _review!;
    <section class="detail-card review-appeals" id="appeals" aria-labelledby="appeals-heading">
      <h2 id="appeals-heading" class="review-section-title">@ReviewWords.AppealsHeading</h2>
      @ResultAt(AppealsPlace)
      @if (review.CallerResolvesAppeals && review.State == CommitteeReviewState.UnderAppeal)
      {
        <EditForm Model="_appeal" OnValidSubmit="ResolveAppealAsync" OnInvalidSubmit="FocusAppealOutcome" FormName="committee-appeal-resolution">
          <DataAnnotationsValidator />
          <div class="form-grid">
            <FormField Label="Outcome" InputId="appeal-outcome" Required="true" HelpText="@CommitteeDecisionWording.AppealOutcomeHelp">
              <ChildContent>
                <InputSelect id="appeal-outcome" class="form-select"
                             aria-describedby="@FieldHelp.DescribedBy("appeal-outcome", CommitteeDecisionWording.AppealOutcomeHelp, AppealOutcomeMessageId)"
                             @bind-Value="_appeal.Outcome" @ref="_appealOutcomeSelect">
                  <option value="">Select an outcome…</option>
                  @foreach (var outcome in Enum.GetValues<CommitteeAppealOutcome>())
                  {
                    <option value="@outcome">@CommitteeDecisionWording.AppealOutcomeLabel(outcome)</option>
                  }
                </InputSelect>
              </ChildContent>
              <ValidationContent>
                <div id="@AppealOutcomeMessageId">
                  <ValidationMessage For="() => _appeal.Outcome" />
                </div>
              </ValidationContent>
            </FormField>
            @if (_appeal.Outcome == CommitteeAppealOutcome.Remitted)
            {
              if (review.DecidesProgression)
              {
                <FormField Label="Replacement category" InputId="appeal-category" Required="true">
                  <InputSelect id="appeal-category" class="form-select" @bind-Value="_appeal.RemittedCategory">
                    <option value="">Select a category…</option>
                    @foreach (var category in Enum.GetValues<CommitteeDecisionCategory>())
                    {
                      <option value="@category">@CommitteeDecisionWording.CategoryLabel(category)</option>
                    }
                  </InputSelect>
                </FormField>
              }
              else
              {
                <p id="remit-entrustment-only-note" class="full-width muted">@CommitteeDecisionWording.EntrustmentOnlyRemitForThePanel</p>
              }
              <FormField Label="Replacement rationale" InputId="appeal-rationale" Required="true">
                <InputTextArea id="appeal-rationale" class="form-control" @bind-Value="_appeal.RemittedRationale" />
              </FormField>
              <FormField Label="Replacement conditions" InputId="appeal-conditions">
                <InputTextArea id="appeal-conditions" class="form-control" @bind-Value="_appeal.RemittedConditions" />
              </FormField>
              @RemitPresent
            }
          </div>
          <FormActions>
            @if (_appeal.Outcome == CommitteeAppealOutcome.Remitted && review.PanelShortfall is not null)
            {
              <button type="button" class="btn btn-primary is-unavailable" aria-disabled="true" aria-describedby="remit-reason">Resolve appeal</button>
            }
            else
            {
              <button type="submit" class="btn btn-primary" disabled="@(_inFlight is not null && _inFlight != ResolveAction)"
                      aria-disabled="@InFlight.AriaDisabled(_inFlight == ResolveAction)">Resolve appeal</button>
            }
          </FormActions>
          @if (_appeal.Outcome == CommitteeAppealOutcome.Remitted && review.PanelShortfall is { } remitShortfall)
          {
            <ul class="workflow-action-reasons">
              <li id="remit-reason"><strong>Resolve appeal:</strong> @remitShortfall</li>
            </ul>
          }
        </EditForm>
      }
      else if (review.State == CommitteeReviewState.UnderAppeal)
      {
        <p id="appeal-body-note" class="muted">@AppealBodyNote</p>
      }

      @if (review.Appeals.Count == 0)
      {
        <p class="muted">@ReviewWords.NoAppeal</p>
      }
      else
      {
        <ul class="list-unstyled">
          @foreach (var appeal in review.Appeals)
          {
            <li><strong>@ActivityMoments.Date(appeal.LodgedOn)</strong> @appeal.Reason (@(appeal.Outcome is { } resolvedAs ? CommitteeDecisionWording.AppealOutcomeName(resolvedAs) : "Open"))</li>
          }
        </ul>
      }
    </section>
  };

  /// <summary>Who sat for a remitted replacement: the chair and the resolver locked (T165).</summary>
  private RenderFragment RemitPresent => __builder =>
  {
    var caller = _user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var seated = _review?.PanelMembers.Where(member => member.MaySit).ToArray() ?? [];
    <fieldset class="form-group full-width" aria-describedby="remit-present-help">
      <legend>
        Present
        <span aria-hidden="true">*</span>
        <span class="visually-hidden">required</span>
      </legend>
      <p id="remit-present-help" class="page-subtitle">@ReviewWords.PresentHelp</p>
      <div class="check-grid">
        @for (var index = 0; index < seated.Length; index++)
        {
          var member = seated[index];
          var inputId = $"remit-present-{index}";
          var locked = member.Role == DecisionPanelMemberRole.Chair || string.Equals(member.UserId, caller, StringComparison.Ordinal);
          <div class="form-check">
            @if (locked)
            {
              <input id="@inputId" class="form-check-input" type="checkbox" checked disabled />
            }
            else
            {
              <input id="@inputId" class="form-check-input" type="checkbox" checked="@_appeal.PresentUserIds.Contains(member.UserId)"
                     @onchange="args => TickRemit(member.UserId, args.Value is true)" />
            }
            <label for="@inputId">@member.Label</label>
          </div>
        }
      </div>
    </fieldset>
  };

  private void TickRemit(string userId, bool present)
  {
    if (present)
    {
      _appeal.PresentUserIds.Add(userId);
    }
    else
    {
      _appeal.PresentUserIds.Remove(userId);
    }
  }

  // ─── The dialogs (round 3 items 11, 22; E1) ──────────────────────────────────

  private RenderFragment Dialogs => __builder =>
  {
    var review = _review!;
    var staged = _pending;
    <ConfirmDialog @ref="_startDialog" Title="@ReviewWords.StartTitle(review)" CancelLabel="@ReviewWords.NotYet"
                   ConfirmLabel="@ReviewWords.StartConfirm" OnConfirm="StartAsync">
      <BodyContent>
        <p>@ReviewWords.StartBody(_startPreview, review.ReviewPeriodFrom, review.ReviewPeriodTo)</p>
        @if (ReviewWords.CampaignsLeftOut(_startPreview?.CampaignsLeftOut ?? 0) is { } leftOut)
        {
          <p>@leftOut</p>
        }
      </BodyContent>
    </ConfirmDialog>

    <ConfirmDialog @ref="_removeDialog"
                   Title="@(_removing is null ? "Remove the staged decision?" : $"{ReviewWords.RemoveName(_removing.EpaCode)}?")"
                   Body="@(_removing is null ? string.Empty : ReviewWords.RemoveBody(_removing, RemovedLineIsDue(_removing)))"
                   CancelLabel="@ReviewWords.KeepIt" ConfirmLabel="@ReviewWords.RemoveConfirm" DangerAction="true"
                   OnConfirm="RemoveAsync" />

    @if (!review.IsFormative)
    {
      <ConfirmDialog @ref="_recordDialog" Title="@ReviewWords.RecordTitle(review.DecidesProgression ? _decision.Category : null, review.TraineeName)"
                     CancelLabel="@ReviewWords.NotYet" ConfirmLabel="@ReviewWords.RecordConfirm" OnConfirm="RecordAsync">
        <BodyContent>
          <p>@ReviewWords.Fixes(staged)</p>
          @if (ReviewWords.RecordsNotDecided(ReviewSitting.NotStagedCodes(_agenda, _pending)) is { } notDecided)
          {
            <p>@notDecided</p>
          }
          <p>@ReviewWords.PresentList(PresentLabels())</p>
          <p>@ReviewWords.RecordAfterwards</p>
        </BodyContent>
      </ConfirmDialog>

      <ConfirmDialog @ref="_ratifyDialog" Title="@ReviewWords.RatifyTitle(staged.Count, review.TraineeName)"
                     CancelLabel="@ReviewWords.NotYet" ConfirmLabel="@ReviewWords.RatifyConfirm(staged.Count)" OnConfirm="RatifyAsync">
        <BodyContent>
          @if (staged.Count > 0)
          {
            <ul class="dialog-list">
              @foreach (var pending in staged)
              {
                <li>@ReviewWords.Issues(pending)</li>
              }
            </ul>
          }
          @if (ReviewWords.NotDecidedAtRatify(ReviewSitting.NotDecidedCodes(_agenda)) is { } notDecided)
          {
            <p>@notDecided</p>
          }
          <p>@ReviewWords.RatifyFinal</p>
        </BodyContent>
      </ConfirmDialog>
    }
    else
    {
      <ConfirmDialog @ref="_closeDialog" Title="@ReviewWords.CloseTitle(review.TraineeName)" Body="@ReviewWords.CloseBody"
                     CancelLabel="@ReviewWords.NotYet" ConfirmLabel="@ReviewWords.CloseConfirm" OnConfirm="CloseAsync" />
    }
  };

  /// <summary>Whether a removed decision's line is due here again: a line the agenda planned, not one the chair added.</summary>
  private bool RemovedLineIsDue(PendingEntrustmentDecisionDto pending)
    => _agenda?.Lines.FirstOrDefault(line => line.EpaId == pending.EpaId) is { } line &&
       line.Origin != CommitteeAgendaLineOrigin.Chair && line.IsClosing &&
       _review?.State == CommitteeReviewState.InProgress;

  private sealed class AppealResolutionModel
  {
    /// <summary>Null until the resolver chooses one (T307).</summary>
    [Required(ErrorMessage = "Choose an outcome.")]
    public CommitteeAppealOutcome? Outcome { get; set; }

    public CommitteeDecisionCategory? RemittedCategory { get; set; }
    public string? RemittedRationale { get; set; }
    public string? RemittedConditions { get; set; }

    /// <summary>The members ticked as present for a remitted replacement, other than those always present (T165).</summary>
    public HashSet<string> PresentUserIds { get; } = new(StringComparer.Ordinal);
  }
}

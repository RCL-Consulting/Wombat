@page "/committee/panels"
@attribute [Authorize(Roles = "CommitteeMember,Coordinator,Administrator,InstitutionalAdmin,SpecialityAdmin,SubSpecialityAdmin")]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Decision panels · Wombat</PageTitle>

<PageHeader Title="Decision panels" Subtitle="Reusable committees for progression reviews.">
  <Actions>
    @* T256: offered only when creating a panel would be accepted, by the rule the create handler demands
       (GetDecisionPanelFormOptionsQuery): never to someone who holds Trainee, a committee member or a coordinator. *@
    @if (_formOptions is { MayCreateAny: true })
    {
      <a class="btn btn-primary" href="/committee/panels/new">New panel</a>
    }
  </Actions>
</PageHeader>

<div class="stack-list">
  @* T256. Standing page content, there on every visit: an info Alert, which carries no role. *@
  @if (_formOptions?.TraineeNote is { } traineeNote)
  {
    <Alert Kind="info" Id="panels-trainee-note">@traineeNote</Alert>
  }
  <StatePanel IsLoading="_loading" LoadError="@_error" IsEmpty="@(!_loading && _items.Count == 0)" EmptyTitle="No decision panels"
              EmptyBody="@EmptyBody">
    @* T239: each Edit is named by its panel, and by what it decides for, then its scope, where two panels share a name;
       panels alike in all three (a name is not unique) are numbered. A caller who may manage no panel on the list (a
       committee member) is not shown the actions column at all: it was a column of blank cells (T239 review). *@
    @{
      var rowNames = RowNames.Distinct(
        _items, row => row.Id, row => row.Name, row => $" ({row.DecisionBodyName ?? "General panel"})", row => $", {row.Scope}");
      var anyManaged = _items.Any(item => item.CallerMayManage);
    }
    <DataTable Items="_items">
      <HeaderRow>
        <tr>
          <th>Name</th>
          <th>Scope</th>
          <th>Decides for</th>
          <th>Members</th>
          @if (anyManaged)
          {
            <th><span class="visually-hidden">Actions</span></th>
          }
        </tr>
      </HeaderRow>
      <Row Context="item">
        <tr>
          <td>@item.Name</td>
          <td>@item.Scope</td>
          <td>@(item.DecisionBodyName ?? "General panel")</td>
          <td>@item.MemberCount</td>
          @if (anyManaged)
          {
            <td>
              <div class="actions-cell">
                @* T256: Edit only where the panel form would open, by the rule its read and panel update demand. *@
                @if (item.CallerMayManage)
                {
                  <a class="btn btn-outline btn-sm" href="@($"/committee/panels/{item.Id}")" aria-label="@($"Edit {rowNames[item.Id]}")">Edit</a>
                }
              </div>
            </td>
          }
        </tr>
      </Row>
    </DataTable>
  </StatePanel>

  @* Who decides each EPA at the institution (T131 slice 3): GetCommitteeRoutingQuery, which asks the one routing rule of
     every panel there. It loads in its own try, so a failure shows here and never replaces the list above. *@
  <section class="detail-card" aria-labelledby="routing-title">
    <h3 id="routing-title">Who decides each EPA</h3>

    @if (_isAdministrator)
    {
      <div class="form-grid">
        <FormField Label="Institution" InputId="routing-institution">
          <select id="routing-institution" class="form-select" value="@_routingInstitutionId" @onchange="OnRoutingInstitutionChangedAsync">
            <option value="">Select institution</option>
            @foreach (var institution in _institutions)
            {
              <option value="@institution.Id">@institution.Name</option>
            }
          </select>
        </FormField>
      </div>
    }

    @if (_routingLoading)
    {
      <Skeleton Count="2" Height="2rem" />
    }
    else if (!string.IsNullOrWhiteSpace(_routingError))
    {
      <Alert Kind="danger">@_routingError</Alert>
    }
    else if (_routing is null)
    {
      <p class="muted">
        @(_isAdministrator
          ? "Choose an institution to see which panel decides each EPA there."
          : "There is no committee routing to show for your institution.")
      </p>
    }
    else if (_routing.Programmes.Count == 0)
    {
      <p class="muted">No programme is adopted or followed at @_routing.InstitutionName yet.</p>
    }
    else
    {
      <p class="muted">
        Which panel takes each EPA's entrustment decision for a trainee of each programme at @_routing.InstitutionName.
        An EPA the College gives to a named committee (EPAs 4 and 5 to the neonatal CCC) goes to a panel sitting as it,
        one covering the trainee's speciality before an institution-wide one, and to the general panels while none does.
      </p>

      @foreach (var programme in _routing.Programmes)
      {
        var headingId = $"routing-programme-{programme.CurriculumId}";
        <h4 id="@headingId">@programme.CurriculumName @programme.CurriculumVersion</h4>
        <div class="table-container">
          <table class="clinic-table clinic-table--compact" aria-labelledby="@headingId">
            <thead>
              <tr>
                <th scope="col">EPAs</th>
                <th scope="col">Decided by</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var route in RoutesOf(programme))
              {
                <tr>
                  <th scope="row">@route.Codes</th>
                  <td>
                    @if (route.Panels.Count == 0)
                    {
                      <span class="muted">No panel at this institution covers this programme.</span>
                    }
                    else
                    {
                      @(string.Join(", ", route.Panels.Select(panel => panel.Name)))
                    }
                    @if (route.BodyName is not null && !route.FallsBackToGeneral)
                    {
                      <div class="muted">Sits as the @route.BodyName.</div>
                    }
                    @* The fallback names the panels above, so it is said only when there are some: with none, the line above
                       already says nobody decides. "Covering this programme": a panel sitting as the body may exist for
                       another speciality, and "no panel sits as it" would then be untrue. *@
                    @if (route.FallsBackToGeneral && route.Panels.Count > 0)
                    {
                      <div class="muted">@FallbackLine(route)</div>
                    }
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    }
  </section>
</div>

@code {
  private readonly List<DecisionPanelSummaryDto> _items = [];
  private bool _loading = true;
  private string? _error;
  private DecisionPanelFormOptionsDto? _formOptions;

  // T256: someone not offered New panel is not told to create one. A global Administrator belongs to no institution and
  // lists every panel, so their empty list is the system's, not "your institution's".
  private string EmptyBody
    => _formOptions is { MayCreateAny: true } ? "Create a panel before scheduling reviews."
      : _isAdministrator ? "No decision panel has been created yet."
      : "No decision panel runs at your institution yet.";

  private bool _isAdministrator;
  private IReadOnlyList<InstitutionDto> _institutions = [];
  private int? _routingInstitutionId;
  private CommitteeRoutingDto? _routing;
  private bool _routingLoading;
  private string? _routingError;

  protected override async Task OnInitializedAsync()
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    _isAdministrator = authState.User.IsInRole(WombatRoles.Administrator);

    // Whether New panel is offered, and why not to someone who holds Trainee (T256). In its own try: a failure offers no
    // New panel and never replaces the list.
    try
    {
      _formOptions = await Sender.Send(new GetDecisionPanelFormOptionsQuery(authState.User));
    }
    catch (Exception)
    {
      _formOptions = null;
    }

    try
    {
      _items.AddRange(await Sender.Send(new ListDecisionPanelsQuery(authState.User)));
    }
    catch (Exception exception)
    {
      _error = RefusalText.Of(exception);
    }
    finally
    {
      _loading = false;
    }

    if (_isAdministrator)
    {
      // An Administrator belongs to no institution, so the card waits for one to be chosen.
      try
      {
        _institutions = await Sender.Send(new GetInstitutionsListQuery(authState.User));
      }
      catch (Exception exception)
      {
        _routingError = RefusalText.Of(exception);
      }
    }
    else
    {
      await LoadRoutingAsync(null);
    }
  }

  private async Task OnRoutingInstitutionChangedAsync(ChangeEventArgs e)
  {
    _routingInstitutionId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
    _routing = null;
    _routingError = null;

    if (_routingInstitutionId is int chosen)
    {
      await LoadRoutingAsync(chosen);
    }
  }

  private async Task LoadRoutingAsync(int? institutionId)
  {
    _routingLoading = true;
    _routingError = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _routing = await Sender.Send(new GetCommitteeRoutingQuery(institutionId, authState.User));
    }
    catch (Exception exception)
    {
      _routingError = RefusalText.Of(exception);
    }
    finally
    {
      _routingLoading = false;
    }
  }

  /// <summary>One row per distinct answer: the EPAs that go to the same panels for the same reason share a row.</summary>
  private static IReadOnlyList<RouteRow> RoutesOf(CommitteeRoutingProgrammeDto programme)
    => programme.Lines
      .GroupBy(line => (
        line.DecisionBodyKey,
        line.FallsBackToGeneral,
        Panels: string.Join(",", line.Panels.Select(panel => panel.Id))))
      .Select(group => new RouteRow(
        string.Join(", ", group.Select(line => line.EpaCode)),
        group.First().Panels,
        group.First().DecisionBodyName,
        group.Key.FallsBackToGeneral))
      .OrderBy(row => row.BodyName is null ? 1 : 0)
      .ThenBy(row => row.Codes, StringComparer.Ordinal)
      .ToArray();

  /// <summary>
  /// Where an EPA the College gives to a named committee goes when no panel covering the programme sits as it: to the
  /// general panels listed on its row, one or several.
  /// </summary>
  private static string FallbackLine(RouteRow route)
    => $"No panel covering this programme sits as the {route.BodyName ?? "College committee"}, so " +
       (route.Panels.Count == 1 ? "the general panel decides." : "the general panels decide.");

  private sealed record RouteRow(
    string Codes,
    IReadOnlyList<CommitteeRoutedPanelDto> Panels,
    string? BodyName,
    bool FallsBackToGeneral);
}

@page "/committee/my-reviews"
@attribute [Authorize(Roles = "Trainee,Administrator")]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<MyReviews> Logger
@inject IJSRuntime JS
@using Wombat.Web.Components.Pages.CommitteeDecisions.Review

@*
  My committee reviews (T366, flow 09; boards R3-1-*; round 3 F1, M1, S8; T329). The list only: each review opens on her
  review's page (/committee/my-reviews/{id}), where the decisions, the appeal and the agenda are.

  - Newest first: scheduled date, then review number, both descending (F1, ListReviewsForTraineeQuery).
  - A hand-written table with both stack classes, stacking at 900px and below (S8), captioned, scope on its headers.
  - State a badge (ReviewSitting.StateBadge: Ratified and Closed green, Under appeal amber); View a link to her review's
    page, named by the review (ReviewRowNames, T239; the type added where two rows share a name, M1).
  - Loading: the header at once, a status line and row skeletons; no View until the read is in. A failure is fixed words
    with Try again, never the exception's text (T329), the failure to the log. None yet: today's words.
*@

<PageTitle>My committee reviews · Wombat</PageTitle>

<PageHeader Title="My committee reviews" Subtitle="@MyReviewWords.ListSubtitle" />

@* Present from the first render, so its words are announced when they come. *@
<p class="visually-hidden" role="status">@(_loading ? MyReviewWords.ListLoading : null)</p>

@* The list's own class carries its phone rule: View is 44px below 641px (T366 step 8). *@
<div class="my-reviews-list">
<StatePanel IsLoading="_loading" LoadError="@_loadError" OnRetry="RetryAsync" FocusAfterRetry="FocusHeadingAsync"
            IsEmpty="@(!_loading && _reviews.Count == 0)" EmptyTitle="@MyReviewWords.EmptyTitle" EmptyBody="@MyReviewWords.EmptyBody">
  <LoadingContent>
    <div aria-hidden="true">
      <Skeleton Count="3" Height="3rem" />
    </div>
  </LoadingContent>
  <ChildContent>
    @{ var rowNames = ReviewRowNames.For(_reviews, withTrainee: false); }
    <div class="table-container shadow">
      <table class="clinic-table clinic-table--stack clinic-table--stack-wide" role="table">
        <caption>@MyReviewWords.ListCaption</caption>
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col" role="columnheader">Panel</th>
            <th scope="col" role="columnheader">Period</th>
            <th scope="col" role="columnheader">Type</th>
            <th scope="col" role="columnheader">State</th>
            <th scope="col" role="columnheader">Decision</th>
            <th scope="col" role="columnheader"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          @foreach (var item in _reviews)
          {
            <tr role="row" @key="item.Id" id="@($"my-review-row-{item.Id}")">
              <td role="cell" data-label="Panel">@item.PanelName</td>
              @* T212: the period the review sat for, then its evidence window (flow 08's .period-window, C8); the row's
                 header (T366, D11), as the trainee is the register's. *@
              <th scope="row" role="rowheader">
                @item.PeriodLabel
                <span class="period-window">@PeriodWindow(item)</span>
              </th>
              <td role="cell" data-label="Type">@CommitteeDecisionWording.ReviewTypeShortLabel(item.ReviewType, item.IsFormative)</td>
              <td role="cell" data-label="State"><span class="badge @ReviewSitting.StateBadge(item.State)">@item.StateLabel</span></td>
              @* T131 slice 5: an entrustment-only review's decision has no category, and is not "Pending" for that. *@
              <td role="cell" data-label="Decision">@CommitteeDecisionWording.OutcomeLabel(item)</td>
              <td role="cell">
                @* T239, M1: named by the review it opens; the visible word is inside the name. *@
                <div class="actions-cell">
                  <a class="btn btn-outline btn-sm" href="@ReviewLinks.MyReview(item.Id)"
                     aria-label="@($"View {rowNames[item.Id]}")">View</a>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </ChildContent>
</StatePanel>
</div>

@code {
  private readonly List<CommitteeReviewListItemDto> _reviews = [];
  private bool _loading = true;
  private string? _loadError;

  protected override Task OnInitializedAsync() => LoadAsync();

  private async Task LoadAsync()
  {
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        ?? throw new InvalidOperationException("The current user identifier is missing.");

      _reviews.Clear();
      _reviews.AddRange(await Sender.Send(new ListReviewsForTraineeQuery(userId, authState.User)));
      _loadError = null;
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      // T329: fixed words, never the exception's text; the failure to the log.
      Logger.LogError(exception, "The trainee's committee reviews could not be loaded.");
      _loadError = MyReviewWords.ListFailed;
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task RetryAsync()
  {
    _loading = true;
    _loadError = null;
    StateHasChanged();
    await LoadAsync();
  }

  private ValueTask FocusHeadingAsync() => PageFocus.FocusHeadingAsync(JS);

  /// <summary>The evidence window, each date unbroken: "2026-01-01 to 2026-12-31".</summary>
  private static RenderFragment PeriodWindow(CommitteeReviewListItemDto item) => __builder =>
  {
    <span>@item.ReviewPeriodFrom.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</span>
    @(" to ")
    <span>@item.ReviewPeriodTo.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</span>
  };
}

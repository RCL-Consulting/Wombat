@page "/committee/reviews"
@attribute [Authorize(Roles = "Coordinator,Administrator,InstitutionalAdmin,SpecialityAdmin,SubSpecialityAdmin,CommitteeMember")]
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<ReviewsSchedule> Logger

<PageTitle>Committee reviews · Wombat</PageTitle>

@*
  Committee reviews (T364, flow 08; round 3's boards R2-5). The list alone: scheduling is a page of its own at
  /committee/reviews/new (Q1), which the header's "Schedule a review" opens for the five schedulers, in the page's own
  words (S7). Until T364 the form opened above this list.
  - No Mode column (C8): a formative check-in says so in Type, "Formative check-in".
  - Period over its window (.period-window), each date unbroken.
  - Stacked at 900px and below (.clinic-table--stack-wide, M8), captioned (C10).
  - Scheduled is one grey badge here and on Decisions due (StateBadge's tints, S7).
  - Loading and the load error (C11, T338): the header at once, then the skeleton, then the list or "Could not load"
    with Try again, never an exception's text.
*@
<div class="committee-calendar">
  @* Schedule a review is offered only to a caller the scheduling command would admit at all, as the query says
     (GetCommitteeReviewsAccessQuery, T216): not to a committee member, and not to anyone who also holds Trainee; and only
     once that is read (C11). *@
  <PageHeader Title="Committee reviews" Subtitle="@Subtitle">
    <Actions>
      @if (MaySchedule)
      {
        <a class="btn btn-primary" href="@ReviewLinks.ScheduleNew"><Icon Name="plus" />Schedule a review</a>
      }
    </Actions>
  </PageHeader>

  @* Present from the first render, so its words are announced when they come (flow 04's C11). *@
  <p class="visually-hidden" role="status">@(_loading ? ScheduleWords.ListLoading : null)</p>

  @{ var rowNames = ReviewRowNames.For(_reviews, withTrainee: true); }
  <StatePanel IsLoading="_loading"
              LoadError="@_loadError"
              OnRetry="LoadAsync"
              IsEmpty="@(!_loading && _reviews.Count == 0)"
              EmptyTitle="@EmptyTitle"
              EmptyBody="@EmptyBody"
              EmptyActions="@EmptyActions">
    @* F6: the rule a semester-2 period follows, once above the list. *@
    <p class="needs-you-rule">@ScheduleWords.Semester2WindowNote</p>
    <div class="table-container shadow">
      <table class="clinic-table clinic-table--stack clinic-table--stack-wide" role="table">
        <caption>@ScheduleWords.ListCaption(_reviews)</caption>
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col" role="columnheader">Trainee</th>
            <th scope="col" role="columnheader">Panel</th>
            <th scope="col" role="columnheader">Period</th>
            <th scope="col" role="columnheader">Type</th>
            <th scope="col" role="columnheader">State</th>
            <th scope="col" role="columnheader">Decision</th>
            <th scope="col" role="columnheader"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          @foreach (var item in _reviews)
          {
            <tr role="row" @key="item.Id">
              @* The trainee as stored: a name, or an erased trainee's pseudonym (T142, flow 14). *@
              <th scope="row" role="rowheader">@item.TraineeName</th>
              <td role="cell" data-label="Panel">@item.PanelName</td>
              <td role="cell" data-label="Period">
                @item.PeriodLabel
                <span class="period-window"><span>@Iso(item.ReviewPeriodFrom)</span> to <span>@Iso(item.ReviewPeriodTo)</span></span>
              </td>
              @* A formative check-in decides nothing whatever its stored type, so its Type says so (T361, review R1; T309
                 item 2), in the words the review page uses (T364, C8). *@
              <td role="cell" data-label="Type">@CommitteeDecisionWording.ReviewTypeShortLabel(item.ReviewType, item.IsFormative)</td>
              <td role="cell"><span class="badge @Review.ReviewSitting.StateBadge(item.State)">@item.StateLabel</span></td>
              <td role="cell" data-label="Decision">
                @if (item.IsFormative && item.State != CommitteeReviewState.Withdrawn)
                {
                  @* A check-in records no decision: "—", read as "None" (S7). A withdrawn review says so, formative or
                     not (T258 review): OutcomeLabel asks for it first. *@
                  <span aria-hidden="true">—</span><span class="visually-hidden">None</span>
                }
                else
                {
                  @CommitteeDecisionWording.OutcomeLabel(item)
                }
              </td>
              <td role="cell">
                @* T239: named by the review it opens, "Open the 2026 S2 review of Thandi Nkosi before General CCC". *@
                <div class="actions-cell">
                  <a class="btn btn-outline btn-sm" href="@ReviewLinks.Review(item.Id)" aria-label="@($"Open {rowNames[item.Id]}")">Open</a>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </StatePanel>
</div>

@code {
  private readonly List<CommitteeReviewListItemDto> _reviews = [];
  private bool _loading = true;
  private string? _loadError;
  private CommitteeReviewsAccessDto? _access;

  protected override async Task OnInitializedAsync() => await LoadAsync();

  private async Task LoadAsync()
  {
    _loading = true;
    _loadError = null;
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _access = await Sender.Send(new GetCommitteeReviewsAccessQuery(authState.User));

      var reviews = await Sender.Send(new ListReviewsForPanelQuery(authState.User));
      _reviews.Clear();
      _reviews.AddRange(reviews);
    }
    catch (Exception exception)
    {
      // T338: fixed words, the failure to the log.
      Logger.LogError(exception, "Committee reviews could not be read.");
      _loadError = ScheduleWords.ListLoadFailure;
    }
    finally
    {
      _loading = false;
    }
  }

  /// <summary>Whether the scheduling command would admit this caller at all; false until the page knows (T216, C11).</summary>
  private bool MaySchedule => _access?.MaySchedule == true;

  private string Subtitle => _access is { MaySchedule: false }
    ? "Open existing committee reviews."
    : "Schedule progression reviews and open existing ones.";

  // The list is always empty for someone who holds Trainee (T185's rung, T216), so its empty card says why, in the
  // query's words, and where their own reviews are.
  private string EmptyTitle => _access?.TraineeNote is not null ? "No reviews to show" : "No reviews yet";

  // The list holds only the reviews this caller may open (ListReviewsForPanelQuery, T218), so an empty one says which
  // reviews appear here, never that none exists: other trainees' reviews may, out of the caller's reach.
  private string EmptyBody => _access switch
  {
    { TraineeNote: { } note } => note,
    { MaySchedule: false } => "The reviews of the panels you sit on appear here once they are scheduled.",
    // Not which reviews those are: a coordinator's follow the panel's institution, a speciality administrator's the
    // trainee's programme, an Administrator's are every one (T218 review).
    _ => "The reviews you can open appear here once they are scheduled. Use Schedule a review to put a trainee before " +
         "a panel."
  };

  private RenderFragment? EmptyActions => _access?.TraineeNote is null ? null : MyReviewsLink;

  private RenderFragment MyReviewsLink => __builder =>
  {
    <a class="btn btn-outline" href="/committee/my-reviews">Open My committee reviews</a>
  };

  private static string Iso(DateOnly date) => date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}

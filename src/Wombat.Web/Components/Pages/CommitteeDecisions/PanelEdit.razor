@page "/committee/panels/new"
@page "/committee/panels/{PanelId:int}"
@attribute [Authorize(Roles = "Administrator,InstitutionalAdmin,SpecialityAdmin,SubSpecialityAdmin")]
@inject IScopedSender Sender
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Decision Panel</PageTitle>

<PageHeader Title="Decision panel" Subtitle="Panels hold the named members who can review, ratify, and resolve appeals.">
  <Actions>
    <a class="btn btn-outline btn-sm" href="/committee/panels">Back to panels</a>
  </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(_status))
{
  <Alert Kind="success">@_status</Alert>
}

@if (!string.IsNullOrWhiteSpace(_error))
{
  <Alert Kind="danger">@_error</Alert>
}

<StatePanel IsLoading="_loading" IsEmpty="false" EmptyTitle="" EmptyBody="" LoadError="@_loadError">
  @if (_unseatable > 0)
  {
    @* T165. A member who can no longer sit (erased, deactivated, moved, or no longer a committee member) is not offered,
       so saving takes them off; said before the save, not after it. *@
    <Alert Kind="warning" Role="">
      @_unseatable member@(_unseatable == 1 ? " of this panel is" : "s of this panel are") no longer an active committee
      member at its institution, so @(_unseatable == 1 ? "is" : "are") not listed below. Saving takes
      @(_unseatable == 1 ? "that member" : "them") off the panel.
    </Alert>
  }
  <div class="details-grid">
    @if (PanelId.HasValue)
    {
      @* Which College committee the panel sits as (T131). Its own form and command: only an InstitutionalAdmin or an
         Administrator may change it, and a SpecialityAdmin who manages this panel's members sees it read-only. *@
      <aside class="detail-card" aria-labelledby="panel-body-title">
        <h3 id="panel-body-title">Decides for</h3>
        @if (_mayChooseBody)
        {
          <EditForm Model="_bodyModel" OnValidSubmit="SaveBodyAsync" FormName="committee-panel-body">
            <div class="form-grid">
              <FormField Label="College committee" InputId="panel-body" HelpText="@BodyHelpText">
                <InputSelect id="panel-body" class="form-select" aria-describedby="@FieldHelp.Id("panel-body")" @bind-Value="_bodyModel.DecisionBodyKey">
                  <option value="">General panel</option>
                  @foreach (var body in _bodies)
                  {
                    <option value="@body.Key">@body.Name</option>
                  }
                </InputSelect>
              </FormField>
            </div>
            @if (!string.IsNullOrWhiteSpace(_bodyError))
            {
              <Alert Kind="danger">@_bodyError</Alert>
            }
            <FormActions>
              <button type="submit" class="btn btn-primary" disabled="@_savingBody">@(_savingBody ? "Saving..." : "Save committee")</button>
            </FormActions>
          </EditForm>
        }
        else
        {
          <dl class="details-list">
            <div>
              <dt>College committee</dt>
              <dd>@(_bodyName ?? "General panel")</dd>
            </div>
          </dl>
          <p class="muted">Only an institutional administrator can change which College committee a panel sits as.</p>
        }
      </aside>
    }
    <section class="detail-card">
      <h3>@(PanelId.HasValue ? "Update members" : "Create panel")</h3>
      <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="committee-panel">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary-errors" />
        <div class="form-grid">
          @if (!PanelId.HasValue)
          {
            <FormField Label="Panel name" InputId="panel-name" Required="true">
              <InputText id="panel-name" class="form-control" @bind-Value="_model.Name" />
            </FormField>
            <FormField Label="Scope" InputId="panel-scope" Required="true">
              <InputSelect id="panel-scope" class="form-select" @bind-Value="_model.Scope">
                @* Only the scopes the caller may create: a Speciality or SubSpecialityAdmin manages Speciality-scoped
                   panels only, and used to be offered the institution-wide scope only to be refused it (T194). *@
                @foreach (var scope in Enum.GetValues<DecisionPanelScope>().Where(MayCreate))
                {
                  <option value="@scope">@scope</option>
                }
              </InputSelect>
            </FormField>

            @* Every panel runs at one institution (T182). Anyone but an Administrator creates panels at their own, so the
               picker is theirs only for an institution-wide panel; an Administrator names it for every scope. *@
            @if (_model.Scope == DecisionPanelScope.Institution || _isAdministrator)
            {
              <FormField Label="Institution" InputId="panel-institution" Required="true">
                <InputSelect id="panel-institution" class="form-select" @bind-Value="_model.InstitutionId"
                             @bind-Value:after="OnInstitutionChangedAsync">
                  <option value="">Select institution</option>
                  @foreach (var institution in _institutions)
                  {
                    <option value="@institution.Id">@institution.Name</option>
                  }
                </InputSelect>
              </FormField>
            }
            @if (_model.Scope == DecisionPanelScope.Speciality)
            {
              <FormField Label="Speciality" InputId="panel-speciality" Required="true"
                         HelpText="@SpecialityHelpText">
                <InputSelect id="panel-speciality" class="form-select" aria-describedby="@FieldHelp.DescribedBy("panel-speciality", SpecialityHelpText)" @bind-Value="_model.SpecialityId">
                  <option value="">Select speciality</option>
                  @foreach (var speciality in _specialities)
                  {
                    @* Specialities are national now (T091); College prefix lands with the Phase 5 rework. *@
                    <option value="@speciality.Id">@speciality.Name</option>
                  }
                </InputSelect>
              </FormField>
            }
            @if (_mayChooseBody)
            {
              <FormField Label="Decides for" InputId="panel-body" HelpText="@BodyHelpText">
                <InputSelect id="panel-body" class="form-select" aria-describedby="@FieldHelp.Id("panel-body")" @bind-Value="_model.DecisionBodyKey">
                  <option value="">General panel</option>
                  @foreach (var body in _bodies)
                  {
                    <option value="@body.Key">@body.Name</option>
                  }
                </InputSelect>
              </FormField>
            }
          }

          <FormField Label="Chair" InputId="panel-chair" Required="true" HelpText="@ChairHelpText">
            <InputSelect id="panel-chair" class="form-select" aria-describedby="@FieldHelp.DescribedBy("panel-chair", ChairHelpText)" @bind-Value="_model.ChairUserId">
              <option value="">Select chair</option>
              @foreach (var candidate in _candidates)
              {
                <option value="@candidate.UserId">@FormatCandidate(candidate)</option>
              }
            </InputSelect>
          </FormField>

          <FormField Label="Members" InputId="panel-members" FullWidth="true" HelpText="@MembersHelpText">
            <select id="panel-members" class="form-select" multiple size="6" aria-describedby="@FieldHelp.Id("panel-members")" @onchange="OnMembersChanged">
              @foreach (var candidate in _candidates.Where(candidate => candidate.UserId != _model.ChairUserId))
              {
                var isSelected = _model.MemberUserIds.Contains(candidate.UserId);
                <option value="@candidate.UserId" selected="@isSelected">@FormatCandidate(candidate)</option>
              }
            </select>
          </FormField>

          <FormField Label="External members" InputId="panel-external" FullWidth="true" HelpText="@ExternalsHelpText">
            <select id="panel-external" class="form-select" multiple size="6" aria-describedby="@FieldHelp.Id("panel-external")" @onchange="OnExternalsChanged">
              @foreach (var candidate in _candidates.Where(candidate => candidate.UserId != _model.ChairUserId && !_model.MemberUserIds.Contains(candidate.UserId)))
              {
                var isSelected = _model.ExternalUserIds.Contains(candidate.UserId);
                <option value="@candidate.UserId" selected="@isSelected">@FormatCandidate(candidate)</option>
              }
            </select>
          </FormField>
        </div>
        <FormActions>
          <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Saving..." : "Save panel")</button>
        </FormActions>
      </EditForm>
    </section>
  </div>
</StatePanel>

@code {
  [Parameter] public int? PanelId { get; set; }

  private string? _status;
  private string? _error;
  private string? _loadError;
  private bool _loading = true;
  private bool _saving;
  private bool _isAdministrator;
  private bool _mayChooseBody;
  private bool _savingBody;
  private string? _bodyError;
  private string? _bodyName;
  private PanelFormModel _model = new();
  private BodyFormModel _bodyModel = new();
  private IReadOnlyList<DecisionBodyDto> _bodies = [];
  private IReadOnlyList<InstitutionDto> _institutions = [];
  private IReadOnlyList<SpecialityDto> _specialities = [];
  private IReadOnlyList<PanelMemberCandidateDto> _candidates = [];
  private int _unseatable;

  protected override async Task OnParametersSetAsync()
  {
    await LoadAsync();
  }

  private async Task LoadAsync()
  {
    _loading = true;
    _loadError = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _isAdministrator = authState.User.IsInRole(WombatRoles.Administrator);
      _mayChooseBody = _isAdministrator || authState.User.IsInRole(WombatRoles.InstitutionalAdmin);
      if (!_mayChooseBody)
      {
        // The institution-wide scope is not theirs to create (T194), so the form starts on the one it offers.
        _model.Scope = DecisionPanelScope.Speciality;
      }
      _institutions = await Sender.Send(new GetInstitutionsListQuery(authState.User));
      _specialities = await Sender.Send(new GetSpecialitiesListQuery(authState.User));
      if (_mayChooseBody)
      {
        _bodies = await Sender.Send(new GetDecisionBodiesQuery());
      }

      if (PanelId.HasValue)
      {
        var panel = await Sender.Send(new GetDecisionPanelByIdQuery(PanelId.Value, authState.User));
        if (panel is null)
        {
          _loadError = "The decision panel could not be found.";
          return;
        }
        _model = new PanelFormModel
        {
          Name = panel.Name,
          Scope = panel.Scope,
          InstitutionId = panel.InstitutionId,
          SpecialityId = panel.SpecialityId,
          ChairUserId = panel.Members.FirstOrDefault(member => member.Role == DecisionPanelMemberRole.Chair)?.UserId ?? string.Empty,
          MemberUserIds = panel.Members.Where(member => member.Role == DecisionPanelMemberRole.Member).Select(member => member.UserId).ToHashSet(StringComparer.Ordinal),
          ExternalUserIds = panel.Members.Where(member => member.Role == DecisionPanelMemberRole.External).Select(member => member.UserId).ToHashSet(StringComparer.Ordinal),
          DecisionBodyKey = panel.DecisionBodyKey
        };
        _bodyModel = new BodyFormModel { DecisionBodyKey = panel.DecisionBodyKey };
        _bodyName = panel.DecisionBodyName;
      }

      // T165: the people this panel may seat, by the rule its save enforces, for the panel's institution.
      await LoadCandidatesAsync(authState.User);
    }
    catch (Exception exception)
    {
      _loadError = RefusalText.Of(exception);
    }
    finally
    {
      _loading = false;
    }
  }

  private const string BodyHelpText =
    "A panel sitting as a College committee decides the EPAs the College gives that committee (the neonatal CCC " +
    "decides EPAs 4 and 5), and nothing else. Where no panel sits as it, the general panels decide them. It cannot " +
    "change while a review before the panel is scheduled, in progress or awaiting ratification.";

  private const string MembersHelpText =
    "Hold Ctrl (Windows) / Cmd (Mac) to select multiple. The chair is excluded automatically. A panel needs at least " +
    "one member or external member besides the chair: no committee decision is one person's. Only active committee " +
    "members at the panel's institution are listed.";

  private const string ExternalsHelpText =
    "External examiners selected from the CommitteeMember pool. Cross-institution externals are not yet supported.";

  /// <summary>Whether the caller may create a panel of this scope: the institution-wide one is an institution's.</summary>
  private bool MayCreate(DecisionPanelScope scope)
    => scope != DecisionPanelScope.Institution || _mayChooseBody;

  private async Task SaveBodyAsync()
  {
    if (!PanelId.HasValue)
    {
      return;
    }

    _savingBody = true;
    _bodyError = null;
    _status = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var result = await Sender.Send(new SetDecisionPanelBodyCommand(PanelId.Value, _bodyModel.DecisionBodyKey, authState.User));
      _bodyModel = new BodyFormModel { DecisionBodyKey = result.DecisionBodyKey };
      _bodyName = result.DecisionBodyName;
      _status = result.DecisionBodyName is null
        ? "The panel is a general panel."
        : $"The panel sits as the {result.DecisionBodyName}.";
    }
    catch (Exception exception)
    {
      _bodyError = RefusalText.Of(exception);
    }
    finally
    {
      _savingBody = false;
    }
  }

  private static string FormatCandidate(PanelMemberCandidateDto candidate)
    => $"{candidate.FirstName} {candidate.LastName} ({candidate.Email})";

  private string? SpecialityHelpText => _isAdministrator ? null : "The panel runs at your institution.";

  private string? ChairHelpText
    => _isAdministrator && !PanelId.HasValue && _model.InstitutionId is null
      ? "Choose the institution first: a panel seats committee members from its own institution."
      : null;

  /// <summary>
  /// The people this panel may seat (<c>PanelSeat</c>, T165), for the panel's institution: an Administrator's choice on a
  /// new panel, the stored one on an existing panel, and anyone else's own. Anyone selected who is not among them is taken
  /// out of the selection and counted, so the form never sends a member the save refuses.
  /// </summary>
  private async Task LoadCandidatesAsync(System.Security.Claims.ClaimsPrincipal user)
  {
    _candidates = await Sender.Send(new ListPanelMemberCandidatesQuery(user, _model.InstitutionId));

    var seatable = _candidates.Select(candidate => candidate.UserId).ToHashSet(StringComparer.Ordinal);
    var before = (string.IsNullOrWhiteSpace(_model.ChairUserId) ? 0 : 1) + _model.MemberUserIds.Count + _model.ExternalUserIds.Count;

    if (!seatable.Contains(_model.ChairUserId))
    {
      _model.ChairUserId = string.Empty;
    }

    _model.MemberUserIds.IntersectWith(seatable);
    _model.ExternalUserIds.IntersectWith(seatable);

    var after = (string.IsNullOrWhiteSpace(_model.ChairUserId) ? 0 : 1) + _model.MemberUserIds.Count + _model.ExternalUserIds.Count;
    _unseatable = PanelId.HasValue ? before - after : 0;
  }

  private async Task OnInstitutionChangedAsync()
  {
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      await LoadCandidatesAsync(authState.User);
    }
    catch (Exception exception)
    {
      _error = RefusalText.Of(exception);
    }
  }

  private void OnMembersChanged(ChangeEventArgs e)
  {
    _model.MemberUserIds = ToHashSet(e.Value);
    // Externals must not overlap members.
    _model.ExternalUserIds.ExceptWith(_model.MemberUserIds);
  }

  private void OnExternalsChanged(ChangeEventArgs e)
  {
    _model.ExternalUserIds = ToHashSet(e.Value);
  }

  private static HashSet<string> ToHashSet(object? value)
  {
    if (value is string[] array)
    {
      return new HashSet<string>(array, StringComparer.Ordinal);
    }
    if (value is IEnumerable<object> objects)
    {
      return new HashSet<string>(objects.Select(item => item?.ToString() ?? string.Empty).Where(item => !string.IsNullOrEmpty(item)), StringComparer.Ordinal);
    }
    return new HashSet<string>(StringComparer.Ordinal);
  }

  private async Task SaveAsync()
  {
    _saving = true;
    _error = null;
    _status = null;

    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var members = BuildMembers();

      if (PanelId.HasValue)
      {
        await Sender.Send(new UpdateDecisionPanelCommand(PanelId.Value, members, authState.User));
        _status = "Panel members updated.";
      }
      else
      {
        var result = await Sender.Send(new CreateDecisionPanelCommand(
          _model.Name,
          _model.Scope,
          _model.InstitutionId,
          _model.SpecialityId,
          members,
          authState.User,
          _mayChooseBody ? _model.DecisionBodyKey : null));

        NavigationManager.NavigateTo($"/committee/panels/{result.Id}", forceLoad: true);
      }
    }
    catch (Exception exception)
    {
      _error = RefusalText.Of(exception);
    }
    finally
    {
      _saving = false;
    }
  }

  private IReadOnlyList<DecisionPanelMemberInput> BuildMembers()
  {
    var members = new List<DecisionPanelMemberInput>();

    if (!string.IsNullOrWhiteSpace(_model.ChairUserId))
    {
      members.Add(new DecisionPanelMemberInput(_model.ChairUserId.Trim(), DecisionPanelMemberRole.Chair));
    }

    members.AddRange(_model.MemberUserIds.Select(userId => new DecisionPanelMemberInput(userId, DecisionPanelMemberRole.Member)));
    members.AddRange(_model.ExternalUserIds.Select(userId => new DecisionPanelMemberInput(userId, DecisionPanelMemberRole.External)));
    return members;
  }

  private sealed class PanelFormModel
  {
    [Required]
    [MaxLength(200)]
    public string Name { get; set; } = string.Empty;

    [Required]
    public DecisionPanelScope Scope { get; set; } = DecisionPanelScope.Speciality;

    public int? InstitutionId { get; set; }
    public int? SpecialityId { get; set; }

    [Required]
    public string ChairUserId { get; set; } = string.Empty;

    public HashSet<string> MemberUserIds { get; set; } = new(StringComparer.Ordinal);
    public HashSet<string> ExternalUserIds { get; set; } = new(StringComparer.Ordinal);

    /// <summary>The College committee a new panel sits as; blank for a general panel.</summary>
    public string? DecisionBodyKey { get; set; }
  }

  private sealed class BodyFormModel
  {
    /// <summary>The College committee the panel sits as; blank for a general panel.</summary>
    public string? DecisionBodyKey { get; set; }
  }
}

@page "/portfolio/export"
@attribute [Authorize]
@using Wombat.Application.Features.Reporting
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<ExportPortfolio> Logger
@inject IJSRuntime JS

@*
  The person's own export (T379, flow 13, lane E; R3-E01–E03, E07, E08, E11–E13, E16, E19). A Trainee's menu item, and a
  record holder's personal link (Q2, build-contracts § 0), so it lights itself and draws no trail (F4, S1: one
  aria-current, the menu's). h1 and tab "Export portfolio" (Q17), "your" in the subtitle and the result.

  GetExportSubjectQuery reads first; the page draws no form until it answers (loading, its failure with Try again). Null
  is the Unavailable page (Q19, F6: a caller with no trainee profile has nothing to export), drawn as Page not found is to
  the shell, so nothing is lit (S2). The staff route, /portfolio/export/{TraineeUserId}, is ExportTraineePortfolio (S2).
*@

@* Literal, so the menu item's label is held to its tab (NavMenuAuthorizationTests); the h1 says the same words: "Export portfolio" (Q17), or "Portfolio unavailable" (Q19). *@
@if (!Unavailable)
{
  <PageTitle>Export portfolio · Wombat</PageTitle>
}
else
{
  <PageTitle>Portfolio unavailable · Wombat</PageTitle>
}

<PageHeader Title="@(Unavailable ? "Portfolio unavailable" : "Export portfolio")" Subtitle="@Subtitle" Page="@(Unavailable ? typeof(NotFound) : null)" />

@* Always present, filled while the subject is read: a live region added with its words in it is often not read. *@
<p class="visually-hidden" role="status">@(_loading ? ExportWords.Loading : null)</p>

<StatePanel IsLoading="_loading" LoadError="@_loadError" OnRetry="RetryAsync" FocusAfterRetry="FocusHeadingAsync">
  <LoadingContent>
    <ExportSkeleton />
  </LoadingContent>
  <ChildContent>
    @if (_subject is null)
    {
      <ExportUnavailable />
    }
    else
    {
      <ExportPortfolioForm Subject="_subject" Own="true" OnRefused="RefusedAsync" />
    }
  </ChildContent>
</StatePanel>

@code {
  private bool _loading = true;
  private string? _loadError;
  private ExportSubjectDto? _subject;

  private bool Unavailable => !_loading && _loadError is null && _subject is null;

  private string? Subtitle => Unavailable ? null : ExportWords.OwnSubtitle;

  protected override async Task OnInitializedAsync() => await LoadAsync();

  private async Task LoadAsync()
  {
    _loading = true;
    _loadError = null;
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      _subject = await Sender.Send(new GetExportSubjectQuery(null, authState.User));
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      // Never the exception's text on the page: it goes to the log (T329, R3-E15).
      Logger.LogError(exception, "The own portfolio export's subject could not be read.");
      _loadError = ExportWords.LoadError;
    }
    finally
    {
      _loading = false;
    }
  }

  private Task RetryAsync() => LoadAsync();

  private ValueTask FocusHeadingAsync() => PageFocus.FocusHeadingAsync(JS);

  private async Task RefusedAsync()
  {
    _subject = null;
    await PageFocus.FocusHeadingAsync(JS);
  }
}

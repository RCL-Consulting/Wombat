@page "/portfolio/authorisations"
@attribute [Authorize(Roles = "Trainee")]
@rendermode InteractiveServer
@using Wombat.Application.Features.Curricula.Quota
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject IServiceProvider ServiceProvider
@inject ILogger<MyAuthorisations> Logger

<PageTitle>My authorisations · Wombat</PageTitle>

@*
  My authorisations (T366, flow 09, boards R3-5; F2, F4, M7, S1, S2, S3, S9, S13; T367): the trainee's STARs.

  - "In force": one card a STAR, by EPA code, in an equal-column grid (.star-grid: one column at 390, as many as fit at
    768 and 1280), each with its level, Issued, Expires ("No expiry"; "Expires in 20 days" on the South African calendar,
    S3), its rationale and "Download certificate", named for its EPA (F4). None in force keeps the heading and says so (S2).
  - "No longer in force": a captioned table that stacks at 900px (S8), Revoked and Expired, each with Since and Why in
    the reviser's name and words (T367, Q8), and "Download" named "Download certificate for PAED-002 (revoked)" (F4).
    Hidden when empty (C18). No STAR at all is the empty card.
  - A download runs on its button ("Generating…", aria-disabled; the others disabled); refused or failed, its result is
    under its button with the focus, in fixed words (C19, T272), never an exception's text. Done, the browser's download
    says what it did, and the focus stays on the button.
*@
<div class="my-authorisations">
  <PageHeader Title="My authorisations" Subtitle="The Statements of Awarded Responsibility (STAR) the committee has issued you, and their certificates." />

  @* Present from the first render, so its words are announced when they come (flow 04's C11). *@
  <p class="visually-hidden" role="status">@(_loading ? LoadingWords : null)</p>

  <StatePanel IsLoading="@_loading"
              LoadError="@_loadError"
              OnRetry="LoadAsync"
              IsEmpty="@(_decisions is { Count: 0 })"
              EmptyTitle="No active authorisations yet"
              EmptyBody="When a committee review ratifies a decision authorising you to perform an EPA, it will appear here. You can then download a STAR certificate for your records.">
    <LoadingContent>
      @* No Download until the read is in (C25). *@
      <div aria-hidden="true">
        <Skeleton Count="2" Height="14rem" />
      </div>
    </LoadingContent>
    <ChildContent>
      <section class="stars-section" aria-labelledby="stars-in-force">
        <h2 class="list-section-title" id="stars-in-force">In force</h2>
        @if (InForce.Count == 0)
        {
          <p class="muted">@NoneInForce</p>
        }
        else
        {
          <div class="star-grid">
            @foreach (var decision in InForce)
            {
              <article class="detail-card star-card" @key="decision.Id">
                @* Deactivating an EPA leaves its STARs standing; the heading says the EPA is no longer in use (T255). *@
                <h3><EpaLabel Code="@decision.EpaCode" Title="@decision.EpaTitle" InForce="@decision.EpaInForce" /></h3>
                <dl class="detail-list">
                  <dt>Authorised level</dt>
                  <dd>@decision.AuthorisedLevelLabel</dd>
                  <dt>Issued</dt>
                  <dd>@StarWords.Iso(decision.IssuedOn)</dd>
                  <dt>Expires</dt>
                  <dd>
                    @if (decision.ExpiresOn is { } expiresOn)
                    {
                      @StarWords.Iso(expiresOn)
                      @if (StarWords.ExpiresIn(expiresOn, Today) is { } expiring)
                      {
                        @(" ")<span class="badge @BadgeFor.State(BadgeState.Accepted)">@expiring</span>
                      }
                    }
                    else
                    {
                      @StarWords.NoExpiry
                    }
                  </dd>
                </dl>
                <p class="star-rationale">@decision.Rationale</p>
                <div class="form-actions">
                  @DownloadButton(decision, StarWords.DownloadCard(decision.EpaCode), "Download certificate", "btn btn-primary")
                  @DownloadResult(decision)
                </div>
              </article>
            }
          </div>
        }
      </section>

      @if (NoLongerInForce.Count > 0)
      {
        <section class="stars-section" aria-labelledby="stars-ended">
          <h2 class="list-section-title" id="stars-ended">No longer in force</h2>
          <div class="table-container shadow">
            <table class="clinic-table clinic-table--stack clinic-table--stack-wide" role="table">
              <caption>STARs that are no longer in force: revoked, or past their expiry</caption>
              <thead role="rowgroup">
                <tr role="row">
                  <th scope="col" role="columnheader">EPA</th>
                  <th scope="col" role="columnheader">Level</th>
                  <th scope="col" role="columnheader">Status</th>
                  <th scope="col" role="columnheader" class="col-fit">Since</th>
                  <th scope="col" role="columnheader">Why</th>
                  <th scope="col" role="columnheader"><span class="visually-hidden">Actions</span></th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                @foreach (var decision in NoLongerInForce)
                {
                  <tr role="row" @key="decision.Id">
                    <th scope="row" role="rowheader">@EpaOf(decision)</th>
                    <td role="cell" data-label="Level">@decision.AuthorisedLevelLabel</td>
                    <td role="cell" data-label="Status"><span class="badge @BadgeFor.EntrustmentDecision(decision.Status)">@decision.Status</span></td>
                    <td role="cell" class="col-fit" data-label="Since">@(StarWords.Since(decision) is { } since ? StarWords.Iso(since) : "—")</td>
                    <td role="cell" data-label="Why">@StarWords.Why(decision)</td>
                    <td role="cell">
                      <div class="actions-cell">
                        @DownloadButton(decision, StarWords.DownloadEnded(decision), "Download", "btn btn-outline btn-sm")
                      </div>
                      @DownloadResult(decision)
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </section>
      }
    </ChildContent>
  </StatePanel>
</div>

@code {
  /// <summary>The status line while the page is read (C25).</summary>
  public const string LoadingWords = "Loading your authorisations.";

  /// <summary>A failed read (T329): fixed words, the failure logged.</summary>
  public const string LoadFailed = "Could not load your authorisations. Nothing has changed. Try again, or come back in a few minutes.";

  /// <summary>"In force" with nothing in it, when some STAR is no longer in force (S2).</summary>
  public const string NoneInForce =
    "No STAR is in force now. When a committee review ratifies a decision authorising you to perform an EPA, it will appear here.";

  private IReadOnlyList<EntrustmentDecisionDto>? _decisions;
  private bool _loading = true;
  private string? _loadError;

  // The certificate being generated: its button says so and the others wait (T234).
  private int? _downloadingId;

  // The last download's refusal or failure, under its own button (C19).
  private int? _resultId;
  private bool _resultFailed;
  private ActionResult? _result;

  private TimeProvider Clock => ServiceProvider.GetService<TimeProvider>() ?? TimeProvider.System;

  // "Expires in N days" counts on the South African calendar (S3, T325).
  private DateOnly Today => QuotaCalendar.Today(Clock);

  private IReadOnlyList<EntrustmentDecisionDto> InForce
    => _decisions?.Where(decision => decision.Status == EntrustmentDecisionStatus.Active).ToArray() ?? [];

  private IReadOnlyList<EntrustmentDecisionDto> NoLongerInForce
    => _decisions?.Where(decision => decision.Status != EntrustmentDecisionStatus.Active).ToArray() ?? [];

  /// <summary>
  /// A certificate's download. While it runs, the button pressed keeps the focus and says "Generating…", aria-disabled,
  /// and every other is disabled (T234); its name keeps its EPA (C19). At rest its visible words are inside its name (F4).
  /// </summary>
  private RenderFragment DownloadButton(EntrustmentDecisionDto decision, string name, string label, string classes)
  {
    var running = _downloadingId == decision.Id;
    return @<button type="button" id="@DownloadId(decision.Id)" class="@classes" @onclick="() => DownloadAsync(decision.Id)"
                    disabled="@(_downloadingId is not null && !running)"
                    aria-disabled="@InFlight.AriaDisabled(running)"
                    aria-label="@(running ? $"{name}, generating" : name)">
      @if (running)
      {
        @StarWords.Generating
      }
      else
      {
        <Icon Name="download" />@label
      }
    </button>;
  }

  /// <summary>The STAR's EPA, marked when it is no longer in use (T255): the row's header in No longer in force.</summary>
  private static RenderFragment EpaOf(EntrustmentDecisionDto decision)
    => @<EpaLabel Code="@decision.EpaCode" Title="@decision.EpaTitle" InForce="@decision.EpaInForce" />;

  /// <summary>The download's refusal or failure, under its button, which takes the focus (C19, T272).</summary>
  private RenderFragment DownloadResult(EntrustmentDecisionDto decision)
    => @<text>
      @if (_resultId == decision.Id)
      {
        <div class="download-result">
          <ActionResult @ref="_result">
            @if (_resultFailed)
            {
              <Alert Kind="danger">
                <div class="alert-row">
                  <span class="alert-row-text">@StarWords.CertificateFailed</span>
                  <button type="button" class="btn btn-outline btn-sm" @onclick="() => DownloadAsync(decision.Id, retry: true)">
                    <Icon Name="refresh-cw" />
                    Try again
                  </button>
                </div>
              </Alert>
            }
            else
            {
              <Alert Kind="danger">@StarWords.CertificateNotFound</Alert>
            }
          </ActionResult>
        </div>
      }
    </text>;

  protected override Task OnInitializedAsync() => LoadAsync();

  private async Task LoadAsync()
  {
    _loading = true;
    _loadError = null;
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        ?? throw new InvalidOperationException("Current user identifier missing.");
      _decisions = await Sender.Send(new GetDecisionsForTraineeQuery(userId, authState.User));
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogError(exception, "My authorisations could not be read.");
      _loadError = LoadFailed;
    }
    finally
    {
      _loading = false;
    }
  }

  /// <summary>A download button's id: Try again, which goes with its alert, hands the focus to it (T366, D1).</summary>
  private static string DownloadId(int decisionId) => $"download-{decisionId}";

  private async Task DownloadAsync(int decisionId, bool retry = false)
  {
    if (_downloadingId is not null)
    {
      return;
    }

    if (retry)
    {
      // Try again is removed with its alert by this press; the focus moves to the STAR's Download, never to the page.
      _focusDownloadId = decisionId;
    }

    _resultId = null;
    _downloadingId = decisionId;
    try
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var certificate = await Sender.Send(new DownloadEntrustmentCertificateCommand(decisionId, authState.User));
      if (certificate is null)
      {
        ShowResult(decisionId, failed: false);
        return;
      }

      await JS.InvokeVoidAsync("wombatFileDownload", certificate.FileName, certificate.PdfBytes);
    }
    catch (Exception exception) when (exception is not OperationCanceledException)
    {
      Logger.LogError(exception, "The certificate of entrustment decision {DecisionId} could not be made.", decisionId);
      ShowResult(decisionId, failed: true);
    }
    finally
    {
      _downloadingId = null;
    }
  }

  private void ShowResult(int decisionId, bool failed)
  {
    _resultId = decisionId;
    _resultFailed = failed;
    _focusResult = true;
  }

  // The result region is drawn by the render that shows it, so it is asked to take the focus once it exists.
  private bool _focusResult;

  // Try again's STAR, whose Download takes the focus once the alert has gone (T366, D1).
  private int? _focusDownloadId;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusDownloadId is { } downloadId)
    {
      _focusDownloadId = null;
      await PageFocus.FocusByIdAsync(JS, DownloadId(downloadId));
    }

    if (_focusResult && _result is not null)
    {
      _focusResult = false;
      await _result.Element.FocusAsync();
    }
  }
}

@page "/portfolio/verify"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject IScopedSender Sender
@inject ILogger<VerifyExport> Logger

@*
  Whoever holds a portfolio PDF checks here whether Wombat produced it, signed in or not. Static HTML for every visitor,
  with a plain GET form ([ExcludeFromInteractiveRouting], App.razor): Verify loads /portfolio/verify?hash=..., and the
  check is made as the page renders, so it needs no circuit, which a visitor who has not signed in never has (T181).
  Until T265 Verify was a circuit button, and signed out it did nothing; only a link that carried the hash checked it.

  Verify sends check=1 beside the hash, so the page can tell a press from a link. After a press the result takes the
  focus as the page loads (ActionResult's FocusOnLoad; DESIGN.md § Button system); a check made on arrival from a link
  leaves the focus alone. A check that fails is said on the page, not left to the error page (T265).
*@

<PageTitle>Verify portfolio export · Wombat</PageTitle>

<PageHeader Title="Verify portfolio export" Subtitle="Check whether a PDF was produced by this system." />

<div class="form-container">
  <form method="get" action="/portfolio/verify">
    <div class="form-grid">
      <FormField Label="Content hash (SHA-256)" InputId="contentHash" FullWidth="true">
        <input type="text" id="contentHash" name="hash" class="form-control" value="@Hash" required autocomplete="off"
               spellcheck="false" placeholder="Enter the hash from the PDF footer" />
      </FormField>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary" name="@PressedParameter" value="1">Verify</button>
    </div>
  </form>
</div>

@* What Verify found, under the form. *@
<ActionResult FocusOnLoad="@Pressed">
  @if (_fault)
  {
    <div style="margin-top: var(--space-lg);">
      <Alert Kind="danger">The export could not be checked just now. Please try again in a few minutes.</Alert>
    </div>
  }
  else if (_blank)
  {
    <div style="margin-top: var(--space-lg);">
      <Alert Kind="danger">Enter the content hash to check.</Alert>
    </div>
  }
  else if (_searched)
  {
    @if (_result is not null)
    {
      <section class="detail-card" style="margin-top: var(--space-lg);">
        <h3>Export verified</h3>
        <p>This PDF was generated by Wombat on <strong>@_result.ExportedOn.ToString("yyyy-MM-dd HH:mm") UTC</strong>.</p>
        <p>Trainee ID: <strong>@_result.TraineeUserId</strong></p>
        <p>Exported by: <strong>@_result.ExportedByUserId</strong></p>
        @if (_result.FilterFromDate.HasValue || _result.FilterToDate.HasValue)
        {
          <p>Filter: @FormatDateRange(_result.FilterFromDate, _result.FilterToDate)</p>
        }
        <p>File: <strong>@_result.FileName</strong></p>
      </section>
    }
    else
    {
      <div style="margin-top: var(--space-lg);">
        <Alert Kind="warning">No matching export found. This hash does not correspond to any PDF generated by this system.</Alert>
      </div>
    }
  }
</ActionResult>

@code {
  /// <summary>The query parameter Verify sends, and only Verify: its presence says the page is the answer to a press.</summary>
  public const string PressedParameter = "check";

  [SupplyParameterFromQuery(Name = "hash")] public string? Hash { get; set; }

  [SupplyParameterFromQuery(Name = PressedParameter)] public string? Check { get; set; }

  private Wombat.Application.Features.Reporting.PortfolioExportRecordDto? _result;
  private bool _searched;
  private bool _blank;
  private bool _fault;

  private bool Pressed => !string.IsNullOrEmpty(Check);

  protected override async Task OnInitializedAsync()
  {
    if (string.IsNullOrWhiteSpace(Hash))
    {
      // The field is required, so a browser sends no empty hash, but spaces pass that check: a press with nothing to
      // check is refused. A visit with no hash, pressed for by nobody, is the form alone.
      _blank = Pressed;
      return;
    }

    try
    {
      _result = await Sender.Send(new Wombat.Application.Features.Reporting.VerifyExportQuery(Hash.Trim()));
      _searched = true;
    }
    catch (Exception exception)
    {
      // A fault, not an answer: the visitor is told the check could not be made, and the log says why.
      Logger.LogError(exception, "The portfolio export check failed.");
      _fault = true;
    }
  }

  private static string FormatDateRange(DateOnly? from, DateOnly? to)
  {
    if (from.HasValue && to.HasValue) return $"{from.Value:yyyy-MM-dd} to {to.Value:yyyy-MM-dd}";
    if (from.HasValue) return $"From {from.Value:yyyy-MM-dd}";
    if (to.HasValue) return $"Up to {to.Value:yyyy-MM-dd}";
    return string.Empty;
  }
}

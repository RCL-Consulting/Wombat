@page "/portfolio/verify"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using Wombat.Application.Features.Reporting
@inject IScopedSender Sender
@inject ILogger<VerifyExport> Logger

@*
  Whoever holds a portfolio PDF checks here whether Wombat produced it, signed in or not. Static HTML for every visitor,
  with a plain GET form ([ExcludeFromInteractiveRouting], App.razor): Verify loads /portfolio/verify?hash=..., and the
  check is made as the page renders, so it needs no circuit, which a visitor who has not signed in never has (T181).
  Until T265 Verify was a circuit button, and signed out it did nothing; only a link that carried the hash checked it.

  Verify sends check=1 beside the hash, so the page can tell a press from a link. After a press the answer takes the
  focus as the page loads (ActionResult's FocusOnLoad; DESIGN.md § Button system), or, for what is not a hash, the field
  does (autofocus, N4); a check made on arrival from a link leaves the focus alone (V10). A check that fails is said on
  the page, not left to the error page (T265), and its cause goes to the log.

  T379 (flow 13, R3-V01–V10): the answer sits above the form in .verify-page, one Alert with its first sentence bold and,
  for a verified file, the details list in it (F9, S20, S21); what cannot be a hash is refused under the field, named
  first by it (N15), from the query's typed reason (S10). Times are SAST (T325); no h3 and no inline style (T280).
*@

<PageTitle>Verify portfolio export · Wombat</PageTitle>

<PageHeader Title="Verify portfolio export" Subtitle="@VerifyExportWords.Subtitle" />

<div class="verify-page">
  @if (_fault || (_answer is not null && _answer.Refusal is null))
  {
    <ActionResult FocusOnLoad="@Pressed">
      @if (_fault)
      {
        <Alert Kind="danger"><strong>@VerifyExportWords.Failed</strong> @VerifyExportWords.FailedRest</Alert>
      }
      else if (_answer!.Export is { } export)
      {
        <Alert Kind="success">
          <p><strong>@VerifyExportWords.Verified</strong> @VerifyExportWords.VerifiedRest</p>
          <dl class="detail-list">
            <dt>First generated</dt>
            <dd>@VerifyExportWords.When(export.FirstExportedOn)</dd>
            <dt>Exported</dt>
            <dd>@VerifyExportWords.Exported(export)</dd>
            <dt>Trainee</dt>
            <dd class="hash-value">@export.TraineeUserId</dd>
            <dt>First exported by</dt>
            <dd class="hash-value">@export.FirstExportedByUserId</dd>
            @if (export.FilterFromDate.HasValue || export.FilterToDate.HasValue)
            {
              <dt>Filter</dt>
              <dd>@VerifyExportWords.Filter(export.FilterFromDate, export.FilterToDate)</dd>
            }
            <dt>File</dt>
            <dd>@export.FileName</dd>
          </dl>
          <p class="verify-ids-note">@VerifyExportWords.IdsNote</p>
        </Alert>
      }
      else
      {
        <Alert Kind="danger"><strong>@VerifyExportWords.NotFound</strong> @VerifyExportWords.NotFoundRest</Alert>
      }
    </ActionResult>
  }

  <form class="form-container" method="get" action="/portfolio/verify">
    <div class="form-group">
      <label for="@InputId">
        @VerifyExportWords.FieldLabel
        <span aria-hidden="true">*</span>
        <span class="visually-hidden">required</span>
      </label>
      <input type="text" id="@InputId" name="hash" class="@InputClass" value="@Hash" required autocomplete="off"
             spellcheck="false" aria-describedby="@DescribedBy" aria-invalid="@(_refusal is null ? null : "true")"
             autofocus="@(_refusal is not null && Pressed)" />
      @if (_refusal is not null)
      {
        <div class="validation-message" id="@RefusalId">@_refusal</div>
      }
      <p class="field-help" id="@HelpId">@VerifyExportWords.FieldHelp</p>
      <ul class="cmd-list" id="@CommandsId">
        <li>Windows: <code>certutil -hashfile &lt;file&gt; SHA256</code>, or in PowerShell <code>Get-FileHash &lt;file&gt;</code></li>
        <li>macOS: <code>shasum -a 256 &lt;file&gt;</code></li>
        <li>Linux: <code>sha256sum &lt;file&gt;</code></li>
      </ul>
    </div>

    <FormActions>
      <button type="submit" class="btn btn-primary" name="@PressedParameter" value="1"><Icon Name="shield-check" />Verify</button>
    </FormActions>
  </form>
</div>

@code {
  /// <summary>The query parameter Verify sends, and only Verify: its presence says the page is the answer to a press.</summary>
  public const string PressedParameter = "check";

  /// <summary>The field, and what names it (N15): the refusal first, then the help, then the command list.</summary>
  public const string InputId = "hash";
  public const string RefusalId = "hash-e";
  public const string HelpId = "hash-h";
  public const string CommandsId = "hash-cmds";

  [SupplyParameterFromQuery(Name = "hash")] public string? Hash { get; set; }

  [SupplyParameterFromQuery(Name = PressedParameter)] public string? Check { get; set; }

  private VerifyExportAnswer? _answer;
  private string? _refusal;
  private bool _fault;

  private bool Pressed => !string.IsNullOrEmpty(Check);

  private string DescribedBy => _refusal is null ? $"{HelpId} {CommandsId}" : $"{RefusalId} {HelpId} {CommandsId}";

  private string InputClass => _refusal is null ? "form-control hash-value" : "form-control hash-value input-validation-error";

  protected override async Task OnInitializedAsync()
  {
    if (string.IsNullOrWhiteSpace(Hash))
    {
      // The field is required, so a browser sends no empty hash, but spaces pass that check: a press with nothing to
      // check is refused under the field (V05). A visit with no hash, pressed for by nobody, is the form alone.
      _refusal = Pressed ? VerifyExportWords.Blank : null;
      return;
    }

    try
    {
      // The query reads the hash as typed: it drops the whitespace and the case itself (S10, V03, V09).
      _answer = await Sender.Send(new VerifyExportQuery(Hash));
      _refusal = _answer.Refusal is null ? null : VerifyExportWords.Refusal(_answer);
    }
    catch (Exception exception)
    {
      // A fault, not an answer: the visitor is told the check could not be made, and the log says why.
      Logger.LogError(exception, "The portfolio export check failed.");
      _fault = true;
    }
  }
}

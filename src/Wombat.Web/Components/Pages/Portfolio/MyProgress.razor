@page "/portfolio/progress"
@* T252: the Trainee role, or a trainee profile held. Completion removes the role, and a graduate still reads their own
   record here, as their portfolio export prints it. *@
@attribute [Authorize(Policy = "TraineeOrFormerTrainee")]
@rendermode InteractiveServer
@using Wombat.Application.Features.Curricula.Quota
@using Wombat.Web.Components.Shared.Progress
@using Microsoft.Extensions.DependencyInjection
@inject IScopedSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<MyProgress> Logger
@inject IServiceProvider ServiceProvider

<PageTitle>My progress · Wombat</PageTitle>

@* T355, flow 05 (R3-C-Progress; Q1, R3): This period, then the EPA index ("Your EPAs", a page per EPA under it), then the
   standing panel whole. The trajectories are on the EPA pages, not here (Q5). *@
<PageHeader Title="My progress" Subtitle="@Subtitle" />

@* C8: on the page from the first render, empty once the read has answered, so its words are announced when they come. *@
<p class="visually-hidden" role="status">@(_loading ? LoadingWords : null)</p>

<StatePanel IsLoading="_loading"
            LoadError="@_error"
            OnRetry="LoadAsync"
            FocusAfterRetry="FocusContentAsync">
  @if (_summary is null)
  {
    @* The reader returns null when there is no trainee profile at all. Focusable by script only: a Try again answered by
       it focuses it (T350 build review, D4). *@
    <div class="detail-card detail-card--empty" tabindex="-1" @ref="_emptyCard">
      <div class="state-panel-title">No curriculum items assigned yet.</div>
      <div class="state-panel-copy">Once you are admitted to a curriculum, your EPAs will appear here.</div>
    </div>
  }
  else if (_summary.Ended is { } programmeEnd)
  {
    <EndedRecord @ref="_endedRecord" Summary="_summary" Ended="programmeEnd" MsfCoverage="_msfCoverage" MsfFailed="_msfFailed" />
    @StandingSection(_summary)
  }
  else if (_summary.Items.Count == 0)
  {
    @* Admitted, but no item is in force: every EPA on the curriculum is paused (T158, D48), or it has none yet. *@
    <div class="detail-card detail-card--empty" tabindex="-1" @ref="_emptyCard">
      <div class="state-panel-title">No EPA on your curriculum is in use at the moment, so no target applies to you.</div>
    </div>

    @if (_summary.Paused.Count > 0)
    {
      <section class="index-section" aria-labelledby="index-h">
        <h2 id="index-h">Your EPAs</h2>
        <EpaProgressTable Summary="_summary" />
      </section>
    }
  }
  else
  {
    @RunningView(_summary)
  }
</StatePanel>

@code {
  /// <summary>What the status says while the page reads (T355, C8; R3-Spec § 1, Loading).</summary>
  public const string LoadingWords = "Loading My progress.";

  /// <summary>
  /// The page's load failure (R3-Spec § 1, Load error): never the exception's text, which goes to the log (T329, T272).
  /// </summary>
  public const string LoadFailed = "Could not load your progress. Nothing has changed. Try again, or come back in a few minutes.";

  /// <summary>
  /// The MSF read's own failure, a line in This period with no button (R3-Spec § 1, Section error): the counts it sits
  /// beside are a different read, and stand.
  /// </summary>
  public const string MsfLoadFailed = EndedRecord.MsfLoadFailed;

  private TraineeCurriculumProgressSummaryDto? _summary;
  private EntrustmentStandingDto? _standing;
  private bool _standingFailed;
  private bool _standingLoading;
  private MsfCoverageDto? _msfCoverage;
  private bool _msfFailed;
  private bool _loading = true;
  private string? _error;

  private ElementReference _periodHeading;
  private ElementReference _standingHeading;
  private EndedRecord? _endedRecord;
  private ElementReference _emptyCard;

  private bool HasSemesterItems => _summary?.HasSemesterItems == true;
  private bool HasYearItems => _summary?.HasYearItems == true;

  /// <summary>
  /// The last day of an ended programme, which the standing's training year and the MSF coverage are read to, as the
  /// targets are (T252). Null while the programme runs, and for one whose end was never recorded: both then read today.
  /// </summary>
  private DateOnly? EndedOn => _summary?.Ended?.EndedOn;

  /// <summary>
  /// "Training year 4 · Semester 2, 2026" (2.40); the semester alone with no curriculum (R3-P-no-curriculum); an ended
  /// programme keeps flow 13's subtitle, less the trajectories, which are on the EPA pages now (R5). None while loading.
  /// </summary>
  private string? Subtitle => _loading || _error is not null
    ? null
    : _summary is null
      ? QuotaText.SemesterName(Wombat.Domain.Curricula.AcademicPeriod.Containing(QuotaCalendar.Today(Clock)))
      : _summary.Ended is null
        ? ProgressWords.Subtitle(_summary)
        : "Your record of the programme you ended: what your curriculum held you to in each period.";

  // The clock the host registers (Infrastructure's TimeProvider), else the system's: only the no-curriculum subtitle reads
  // it, since every figure's "today" is the reader's (T325).
  private TimeProvider Clock => ServiceProvider.GetService<TimeProvider>() ?? TimeProvider.System;

  /// <summary>The training year the index's STAR column is judged against: the standing's, else the summary's.</summary>
  private int? VerdictYear => _standing?.TargetYear ?? _summary?.TraineeStage;

  protected override Task OnInitializedAsync() => LoadAsync();

  /// <summary>
  /// Reads the page: the counts, which are the page, then the standing and the MSF coverage, each a section of it whose
  /// failure says so there rather than replacing the counts the trainee came for (T166, T168). Try again reads all three.
  /// </summary>
  private async Task LoadAsync()
  {
    _loading = true;
    _error = null;
    System.Security.Claims.ClaimsPrincipal user;
    string userId;
    try
    {
      user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
      userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        ?? throw new InvalidOperationException("Current user identifier missing.");
      _summary = await Sender.Send(new GetCurriculumProgressForTraineeQuery(userId, user));
    }
    catch (Exception exception)
    {
      Logger.LogError(exception, "My progress could not be read.");
      _error = LoadFailed;
      _loading = false;
      return;
    }

    await ReadStandingAsync(user, userId);

    // T168: this semester's coverage for This period, and each period's for an ended programme's cards. An ended
    // programme's cards show the semester it ended in and the one before, as a running one's show this semester (T252).
    try
    {
      _msfCoverage = await Sender.Send(new GetMsfCoverageForTraineeQuery(userId, user, To: EndedOn));
      _msfFailed = false;
    }
    catch (Exception exception)
    {
      Logger.LogError(exception, "My progress could not read the MSF coverage.");
      _msfCoverage = null;
      _msfFailed = true;
    }

    _loading = false;
  }

  private async Task ReadStandingAsync(System.Security.Claims.ClaimsPrincipal user, string userId)
  {
    try
    {
      // An ended programme is judged against the training year it ended in (T252), not the one its start date would put
      // the trainee in today.
      _standing = await Sender.Send(new GetEntrustmentStandingForTraineeQuery(userId, user, EndedOn));
      _standingFailed = false;
    }
    catch (Exception exception)
    {
      Logger.LogError(exception, "My progress could not read the entrustment standing.");
      _standing = null;
      _standingFailed = true;
    }
  }

  /// <summary>The standing's own Try again (C8): reads the standing alone; the panel moves the focus once it answers.</summary>
  private async Task RetryStandingAsync()
  {
    _standingLoading = true;
    try
    {
      var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
      var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        ?? throw new InvalidOperationException("Current user identifier missing.");
      await ReadStandingAsync(user, userId);
    }
    catch (Exception exception)
    {
      Logger.LogError(exception, "My progress could not read the entrustment standing.");
      _standingFailed = true;
    }
    finally
    {
      _standingLoading = false;
    }
  }

  /// <summary>After the page's Try again: This period's heading (Spec § 5), else the region that stands in for it.</summary>
  private async ValueTask FocusContentAsync()
  {
    if (_summary is null || (_summary.Ended is null && _summary.Items.Count == 0))
    {
      await _emptyCard.FocusAsync();
    }
    else if (_summary.Ended is not null)
    {
      await _endedRecord!.FocusHeadingAsync();
    }
    else
    {
      await _periodHeading.FocusAsync();
    }
  }

  /// <summary>After the standing's Try again answered: its heading, "Entrustment against Annexure A" (C8).</summary>
  private ValueTask FocusStandingAsync() => _standingHeading.FocusAsync();

  /// <summary>The panel's EPA names link to each EPA's page (R4; T355, C1).</summary>
  private static string? EpaPage(EpaStandingDto epa) => ProgressLinks.Epa(epa.EpaId);

  /// <summary>
  /// A running programme (R3-C-Progress): the Alerts that apply (December, part-way, not started; C2, C3), This period,
  /// the EPA index, and the standing panel whole (round 1, correction 1).
  /// </summary>
  private RenderFragment RunningView(TraineeCurriculumProgressSummaryDto summary) => __builder =>
  {
    @if (ProgressWords.DecemberNotice(summary) is { } december)
    {
      @* Its first sentence is the news (R3-P-december): the year has ended. *@
      var cut = december.IndexOf(". ", StringComparison.Ordinal) + 1;
      <Alert Kind="info"><strong>@december[..cut]</strong> @december[(cut + 1)..]</Alert>
    }

    @if (ProgressWords.StartNotice(summary) is { } start)
    {
      <Alert Kind="info">@start</Alert>
    }

    <section class="detail-card period-card" aria-labelledby="period-h">
      <h2 class="dashboard-card-title" id="period-h" tabindex="-1" @ref="_periodHeading">This period</h2>
      <div class="dashboard-metric-row">
        @if (HasSemesterItems)
        {
          var semester = ProgressWords.SemesterFigure(summary);
          <div class="dashboard-metric">
            <span class="dashboard-metric-value">@semester.Value</span>
            <span class="dashboard-metric-label">@semester.Label</span>
          </div>
        }
        @if (HasYearItems)
        {
          var year = ProgressWords.YearFigure(summary);
          <div class="dashboard-metric">
            <span class="dashboard-metric-value">@year.Value</span>
            <span class="dashboard-metric-label">@year.Label</span>
          </div>
        }
      </div>
      <p class="period-ends">@ProgressWords.EndsLine(summary)</p>
      <div class="period-lines">
        @if (summary.TraineeStage is { } stage)
        {
          <p>@ProgressWords.TrainingYearLine(stage)</p>
        }
        @* T168, D8, D9: covered means a released campaign COVERING the EPA closed in the semester; MSF counts towards no
           target, so it is a line of its own, never a count against one. *@
        @if (_msfFailed)
        {
          <p class="section-error"><span class="period-line-term">Multi-source feedback:</span> @MsfLoadFailed</p>
        }
        else if (_msfCoverage is { Epas.Count: > 0 } coverage)
        {
          <p><span class="period-line-term">Multi-source feedback:</span> @MsfCoverageText.ThisSemesterLine(coverage)</p>
        }
      </div>
    </section>

    <section class="index-section" aria-labelledby="index-h">
      <h2 id="index-h">Your EPAs</h2>
      <EpaProgressTable Summary="summary" Standing="_standing" StandingFailed="_standingFailed" TrainingYear="VerdictYear" />
    </section>

    @StandingSection(summary)
  };

  /// <summary>
  /// T166: the committee's STAR decisions against Annexure A's target for this training year, and the exit rule: the same
  /// panel the committee review page shows, in the trainee's own words, with its own error and Try again under its
  /// heading (C8), its EPA names linking to each EPA's page (R4).
  /// </summary>
  private RenderFragment StandingSection(TraineeCurriculumProgressSummaryDto summary) => __builder =>
  {
    @if (_standing is not null || _standingFailed || _standingLoading)
    {
      <section class="standing-panel" aria-labelledby="standing-h">
        <h2 id="standing-h" tabindex="-1" @ref="_standingHeading">Entrustment against Annexure A</h2>
        <EntrustmentStandingPanel Standing="@_standing"
                                  LoadError="@(_standingFailed ? EntrustmentStandingPanel.SelfLoadFailed : null)"
                                  IsLoading="_standingLoading"
                                  OnRetry="RetryStandingAsync"
                                  FocusAfterRetry="FocusStandingAsync"
                                  Self="true"
                                  ProgrammeEnd="@summary.Ended"
                                  EpaHref="EpaPage" />
      </section>
    }
  };
}

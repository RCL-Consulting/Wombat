@page "/"
@using Wombat.Web.Navigation
@inject TimeProvider Clock

<PageTitle>Home · Wombat</PageTitle>

@*
  Home's frame (T335, flow 01; R2-Landing-*, R2-Shell-*, R2-Phone-Folded; DESIGN.md § Dashboard page): headed "Home", the
  acting role and the semester under it, the role's one header action, and the acting role's dashboard, whose cards
  belong to later flows. Who is signed in is the top bar's to say, and switching role is the sidebar's.
*@
<AuthorizeView Context="homeAuth">
  <Authorized Context="state">
    @{
      var acting = Acting ?? ActingRoleResolver.Resolve(state.User);
      var role = acting.Role;
    }

    <PageHeader Title="Home" Subtitle="@HomeFrame.Subtitle(role, _today)" Actions="@HeaderAction(HomeFrame.ActionFor(role))" />

    @switch (role)
    {
      case WombatRoles.Administrator:
        <Wombat.Web.Components.Pages.Dashboards.AdministratorDashboard />
        break;
      @* Every role has its own case: one that fell through to the trainee's dashboard was offered pages that refuse it
         (T261, the CollegeAdmin). DashboardLinkAuthorizationTests renders this page for every role. *@
      case WombatRoles.CollegeAdmin:
        <Wombat.Web.Components.Pages.Dashboards.CollegeAdminDashboard />
        break;
      case WombatRoles.InstitutionalAdmin:
        <Wombat.Web.Components.Pages.Dashboards.InstitutionalAdminDashboard />
        break;
      case WombatRoles.SpecialityAdmin:
        <Wombat.Web.Components.Pages.Dashboards.SpecialityAdminDashboard />
        break;
      case WombatRoles.SubSpecialityAdmin:
        <Wombat.Web.Components.Pages.Dashboards.SubSpecialityAdminDashboard />
        break;
      case WombatRoles.CommitteeMember:
        <Wombat.Web.Components.Pages.Dashboards.CommitteeMemberDashboard />
        break;
      case WombatRoles.Coordinator:
        <Wombat.Web.Components.Pages.Dashboards.CoordinatorDashboard />
        break;
      case WombatRoles.Assessor:
        <Wombat.Web.Components.Pages.Dashboards.AssessorDashboard />
        break;
      case WombatRoles.PendingTrainee:
      case WombatRoles.Trainee:
        <Wombat.Web.Components.Pages.Dashboards.TraineeDashboard />
        break;
      default:
        @* A signed-in user who holds no role. A graduate keeps their training record, read-only, and holds no role for the
           programme they finished (T252): their Home points to it (A-Spec § e: "her record, not No role assigned"). Anyone
           else with no role (an administrator removed the last one, which RemoveRoleFromUser allows) is offered nothing,
           since no page is theirs to open (the T261 review). *@
        <div class="dashboard-grid">
          @if (HoldsTrainingRecord(state.User))
          {
            <DashboardCard Title="Your training record" Icon="book" Emphasis="true" Span="3">
              <p>You hold no role at the moment. Your training record is kept, read-only: your progress in each period, and your portfolio to export.</p>
              <div class="dashboard-card-footer">
                <a href="/portfolio/progress" class="btn btn-sm btn-outline">Open My progress &rarr;</a>
              </div>
            </DashboardCard>
          }
          else
          {
            <DashboardCard Title="No role assigned" Icon="info" Emphasis="true" Span="3">
              <p>Your account holds no role at the moment, so there is nothing to show you here. An administrator can give you one.</p>
            </DashboardCard>
          }
        </div>
        break;
    }
  </Authorized>
  <NotAuthorized Context="anonymousHome">
    <RedirectToLogin />
  </NotAuthorized>
</AuthorizeView>

@code {
  private DateOnly _today;

  /// <summary>
  /// The acting role, as App resolved it and Routes cascades it (T335, flow 01): the role whose dashboard Home shows. Its
  /// stored choice while the person holds it, else the first role they hold in DashboardPriority.Order, else none. Never a
  /// role they do not hold. Resolved from the principal, by the same resolver, where nothing cascades it (a test's render).
  /// </summary>
  [CascadingParameter] public ActingRole? Acting { get; set; }

  // Today on the South African calendar, for the subtitle's semester (HomeFrame.Subtitle).
  protected override void OnInitialized() => _today = Wombat.Application.Features.Curricula.Quota.QuotaCalendar.Today(Clock);

  /// <summary>The role's one header action, a primary button; none for a role that has none (HomeFrame.ActionFor).</summary>
  private static RenderFragment? HeaderAction(HomeAction? action) => action is null
    ? null
    : @<a class="btn btn-primary home-action" href="@action.Href"><Icon Name="@action.Icon" />@action.Label</a>;

  /// <summary>Whether the person keeps a training record, as the progress page's policy reads it (TraineeOrFormerTrainee).</summary>
  private static bool HoldsTrainingRecord(System.Security.Claims.ClaimsPrincipal user)
    => user.HasClaim(claim => claim.Type == Wombat.Application.Common.Security.WombatClaimTypes.TraineeRecord);
}

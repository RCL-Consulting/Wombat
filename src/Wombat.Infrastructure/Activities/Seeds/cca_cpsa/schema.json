{
  "version": 1,
  "observation_date_field": "observed_on",
  "rated_level_field": "overall_level",
  "evidence_epa_field": "epa_id",
  "sections": [
    {
      "key": "request",
      "title": "Request",
      "fields": [
        {
          "key": "epa_id",
          "type": "epa",
          "label": "EPA",
          "required": true
        },
        {
          "key": "assessor_user_id",
          "type": "user",
          "label": "Assessor",
          "required": true,
          "help_text": "The supervisor who reviewed the documentation with you. They complete this assessment."
        },
        {
          "key": "observed_on",
          "type": "date",
          "label": "Date of the review",
          "required": true,
          "help_text": "When you and your assessor reviewed the documentation, not when this form is completed."
        },
        {
          "key": "case_reference",
          "type": "text",
          "label": "Case",
          "required": true,
          "help_text": "A reference you and your assessor will recognise, such as a bed and date. No patient names or record numbers."
        },
        {
          "key": "documents_reviewed",
          "type": "multichoice",
          "label": "Documentation reviewed",
          "required": true,
          "options": [
            { "value": "admission_notes", "label": "Admission notes" },
            { "value": "progress_notes", "label": "Progress notes" },
            { "value": "referral_letters", "label": "Referral letters" },
            { "value": "discharge_summary", "label": "Discharge summary" },
            { "value": "prescriptions", "label": "Prescriptions" }
          ]
        },
        {
          "key": "setting",
          "type": "choice",
          "label": "Setting",
          "required": true,
          "options": [
            { "value": "ward", "label": "Ward" },
            { "value": "outpatient_clinic", "label": "Outpatient clinic" },
            { "value": "emergency_unit", "label": "Emergency unit" },
            { "value": "neonatal_unit", "label": "Neonatal unit" },
            { "value": "picu", "label": "PICU" },
            { "value": "community", "label": "Community" }
          ]
        },
        {
          "key": "reasoning_discussed",
          "type": "longtext",
          "label": "Reasoning and management plan discussed",
          "required": true
        }
      ]
    },
    {
      "key": "assessment",
      "title": "Entrustment",
      "editable_by": "field:assessor_user_id",
      "fields": [
        {
          "key": "overall_level",
          "type": "scale",
          "label": "Supervision required for this case",
          "scale_key": "seed:cpsa:scale:v11.1",
          "validation": {
            "min": 1,
            "max": 6
          },
          "help_text": "The supervision this activity actually required on this occasion - not a judgement of the trainee's worth.",
          "required": true
        }
      ]
    },
    {
      "key": "feedback",
      "title": "Feedback",
      "editable_by": "field:assessor_user_id",
      "fields": [
        {
          "key": "strengths",
          "type": "longtext",
          "label": "What was done well",
          "required": true
        },
        {
          "key": "improvements",
          "type": "longtext",
          "label": "Areas for development",
          "required": true
        },
        {
          "key": "plan",
          "type": "longtext",
          "label": "Agreed plan",
          "required": true
        }
      ]
    }
  ]
}
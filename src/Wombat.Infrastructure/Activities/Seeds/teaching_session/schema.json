{
  "version": 1,
  "observation_date_field": "observed_on",
  "sections": [
    {
      "key": "session",
      "title": "Teaching session",
      "fields": [
        { "key": "topic", "type": "text", "label": "Topic", "required": true },
        { "key": "observed_on", "type": "date", "label": "Date delivered", "help_text": "When the encounter happened, not when this form is completed.", "required": true },
        { "key": "audience_type", "type": "choice", "label": "Audience", "required": true, "options": [{ "value": "students", "label": "Students" }, { "value": "interns", "label": "Interns" }, { "value": "registrars", "label": "Registrars" }, { "value": "multidisciplinary_team", "label": "Multidisciplinary team" }, { "value": "public", "label": "Public" }] },
        { "key": "audience_count", "type": "number", "label": "Audience count", "required": true, "validation": { "min": 1 } },
        { "key": "duration_minutes", "type": "number", "label": "Duration in minutes", "required": true, "validation": { "min": 1 } },
        { "key": "format", "type": "choice", "label": "Format", "required": true, "options": [{ "value": "bedside", "label": "Bedside" }, { "value": "seminar", "label": "Seminar" }, { "value": "simulation", "label": "Simulation" }, { "value": "lecture", "label": "Lecture" }, { "value": "small_group", "label": "Small group" }] },
        { "key": "self_evaluation", "type": "longtext", "label": "Self-evaluation", "required": true },
        { "key": "feedback_received", "type": "longtext", "label": "Feedback received" }
      ]
    }
  ]
}

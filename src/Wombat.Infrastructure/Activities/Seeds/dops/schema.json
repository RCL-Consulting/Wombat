{
  "version": 1,
  "observation_date_field": "observed_on",
  "rated_level_field": "overall",
  "evidence_epa_field": "epa_id",
  "sections": [
    {
      "key": "request",
      "title": "Request",
      "fields": [
        { "key": "epa_id", "type": "epa", "label": "EPA", "required": true },
        { "key": "assessor_user_id", "type": "user", "label": "Assessor user id", "help_text": "Use the target assessor's user id for now.", "required": true },
        { "key": "observed_on", "type": "date", "label": "Date observed", "help_text": "When the encounter happened, not when this form is completed.", "required": true },
        { "key": "procedure_key", "type": "choice", "label": "Procedure", "required": true, "catalogue": "procedure_catalogue" },
        { "key": "indications", "type": "longtext", "label": "Indications", "required": true },
        { "key": "complexity", "type": "choice", "label": "Procedure complexity", "required": true, "options": [{ "value": "low", "label": "Low" }, { "value": "moderate", "label": "Moderate" }, { "value": "high", "label": "High" }] }
      ]
    },
    {
      "key": "assessment",
      "title": "Assessment",
      "editable_by": "field:assessor_user_id",
      "fields": [
        { "key": "preparation", "type": "scale", "label": "Preparation", "options": ["1", "2", "3", "4", "5"], "scale_key": "seed:demo:scale:o-r" },
        { "key": "consent", "type": "scale", "label": "Consent and explanation", "options": ["1", "2", "3", "4", "5"], "scale_key": "seed:demo:scale:o-r" },
        { "key": "technique", "type": "scale", "label": "Technical performance", "options": ["1", "2", "3", "4", "5"], "scale_key": "seed:demo:scale:o-r" },
        { "key": "asepsis", "type": "scale", "label": "Aseptic practice", "options": ["1", "2", "3", "4", "5"], "scale_key": "seed:demo:scale:o-r" },
        { "key": "post_procedure", "type": "scale", "label": "Post-procedure management", "options": ["1", "2", "3", "4", "5"], "scale_key": "seed:demo:scale:o-r" },
        { "key": "overall", "type": "scale", "label": "Overall performance", "required": true, "options": ["1", "2", "3", "4", "5"], "scale_key": "seed:demo:scale:o-r" }
      ]
    },
    {
      "key": "feedback",
      "title": "Feedback",
      "editable_by": "field:assessor_user_id",
      "fields": [
        { "key": "strengths", "type": "longtext", "label": "Strengths", "required": true },
        { "key": "improvements", "type": "longtext", "label": "Areas for improvement", "required": true },
        { "key": "plan", "type": "longtext", "label": "Agreed plan", "required": true }
      ]
    }
  ]
}

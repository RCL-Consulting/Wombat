{
  "version": 1,
  "sections": [
    {
      "key": "request",
      "title": "Request",
      "fields": [
        {
          "key": "epa_id",
          "type": "epa",
          "label": "EPA",
          "required": true
        },
        {
          "key": "assessor_user_id",
          "type": "user",
          "label": "Assessor",
          "required": true,
          "help_text": "The supervisor who observed you. They complete this assessment."
        },
        {
          "key": "observed_on",
          "type": "date",
          "label": "Date observed",
          "required": true,
          "help_text": "When the encounter happened, not when this form is completed."
        },
        {
          "key": "activity_observed",
          "type": "choice",
          "label": "Activity observed",
          "required": true,
          "options": [
            "ward_round",
            "handover",
            "family_meeting",
            "resuscitation",
            "teaching_session",
            "multidisciplinary_meeting"
          ]
        },
        {
          "key": "context",
          "type": "text",
          "label": "Context",
          "required": true
        }
      ]
    },
    {
      "key": "assessment",
      "title": "Entrustment",
      "fields": [
        {
          "key": "overall_level",
          "type": "scale",
          "label": "Supervision required for this activity",
          "scale_key": "CPSA Paediatric Entrustment Scale v11.1",
          "validation": {
            "min": 1,
            "max": 6
          },
          "help_text": "The supervision this activity actually required on this occasion - not a judgement of the trainee's worth."
        }
      ]
    },
    {
      "key": "feedback",
      "title": "Feedback",
      "fields": [
        {
          "key": "strengths",
          "type": "longtext",
          "label": "What was done well"
        },
        {
          "key": "improvements",
          "type": "longtext",
          "label": "Areas for development"
        },
        {
          "key": "plan",
          "type": "longtext",
          "label": "Agreed plan"
        }
      ]
    }
  ]
}
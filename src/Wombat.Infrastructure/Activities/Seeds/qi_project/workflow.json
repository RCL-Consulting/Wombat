{
  "version": 1,
  "initial_state": "draft",
  "states": [
    { "key": "draft", "label": "Draft" },
    { "key": "submitted", "label": "Submitted" },
    { "key": "reviewed", "label": "Reviewed", "terminal": true }
  ],
  "transitions": [
    { "key": "submit", "from": "draft", "to": "submitted", "actor": "subject", "validation": "all" },
    { "key": "review", "from": "submitted", "to": "reviewed", "actor": "role:SpecialityAdmin+scope:speciality", "validation": "all" }
  ]
}

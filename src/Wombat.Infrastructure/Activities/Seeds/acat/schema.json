{
  "version": 1,
  "observation_date_field": "observed_on",
  "rated_level_field": "overall",
  "sections": [
    {
      "key": "request",
      "title": "Request",
      "fields": [
        { "key": "epa_id", "type": "epa", "label": "EPA", "required": true },
        { "key": "assessor_user_id", "type": "user", "label": "Assessor user id", "help_text": "Use the target assessor's user id for now.", "required": true },
        { "key": "observed_on", "type": "date", "label": "Date observed", "help_text": "When the encounter happened, not when this form is completed.", "required": true },
        { "key": "acute_presentation", "type": "text", "label": "Acute presentation", "required": true }
      ]
    },
    {
      "key": "assessment",
      "title": "Assessment",
      "editable_by": "field:assessor_user_id",
      "fields": [
        { "key": "initial_assessment", "type": "scale", "label": "Initial assessment", "options": ["1", "2", "3", "4", "5"], "scale_key": "or_scale" },
        { "key": "investigation", "type": "scale", "label": "Investigation planning", "options": ["1", "2", "3", "4", "5"], "scale_key": "or_scale" },
        { "key": "management", "type": "scale", "label": "Management", "options": ["1", "2", "3", "4", "5"], "scale_key": "or_scale" },
        { "key": "handover", "type": "scale", "label": "Handover", "options": ["1", "2", "3", "4", "5"], "scale_key": "or_scale" },
        { "key": "team_leadership", "type": "scale", "label": "Team leadership", "options": ["1", "2", "3", "4", "5"], "scale_key": "or_scale" },
        { "key": "overall", "type": "scale", "label": "Overall performance", "options": ["1", "2", "3", "4", "5"], "scale_key": "or_scale" }
      ]
    },
    {
      "key": "feedback",
      "title": "Feedback",
      "editable_by": "field:assessor_user_id",
      "fields": [
        { "key": "feedback", "type": "longtext", "label": "Feedback" },
        { "key": "next_steps", "type": "longtext", "label": "Next steps" }
      ]
    }
  ]
}

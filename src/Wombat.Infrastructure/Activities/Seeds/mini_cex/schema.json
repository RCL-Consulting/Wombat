{
  "version": 1,
  "observation_date_field": "observed_on",
  "rated_level_field": "overall",
  "evidence_epa_field": "epa_id",
  "sections": [
    {
      "key": "request",
      "title": "Request",
      "fields": [
        { "key": "epa_id", "type": "epa", "label": "EPA", "required": true },
        { "key": "assessor_user_id", "type": "user", "label": "Assessor user id", "help_text": "Use the target assessor's user id for now.", "required": true },
        { "key": "observed_on", "type": "date", "label": "Date observed", "help_text": "When the encounter happened, not when this form is completed.", "required": true },
        { "key": "setting", "type": "choice", "label": "Clinical setting", "required": true, "options": [{ "value": "ward", "label": "Ward" }, { "value": "clinic", "label": "Clinic" }, { "value": "emergency_unit", "label": "Emergency unit" }, { "value": "call_review", "label": "Call review" }] },
        { "key": "presenting_complaint", "type": "text", "label": "Presenting complaint", "required": true },
        { "key": "complexity", "type": "choice", "label": "Case complexity", "required": true, "options": [{ "value": "low", "label": "Low" }, { "value": "moderate", "label": "Moderate" }, { "value": "high", "label": "High" }] }
      ]
    },
    {
      "key": "assessment",
      "title": "Assessment",
      "editable_by": "field:assessor_user_id",
      "fields": [
        { "key": "history", "type": "scale", "label": "History taking", "options": ["1", "2", "3", "4", "5"], "scale_key": "O-R Scale" },
        { "key": "exam", "type": "scale", "label": "Examination", "options": ["1", "2", "3", "4", "5"], "scale_key": "O-R Scale" },
        { "key": "reasoning", "type": "scale", "label": "Clinical reasoning", "options": ["1", "2", "3", "4", "5"], "scale_key": "O-R Scale" },
        { "key": "communication", "type": "scale", "label": "Communication", "options": ["1", "2", "3", "4", "5"], "scale_key": "O-R Scale" },
        { "key": "professionalism", "type": "scale", "label": "Professionalism", "options": ["1", "2", "3", "4", "5"], "scale_key": "O-R Scale" },
        { "key": "overall", "type": "scale", "label": "Overall performance", "required": true, "options": ["1", "2", "3", "4", "5"], "scale_key": "O-R Scale" }
      ]
    },
    {
      "key": "feedback",
      "title": "Feedback",
      "editable_by": "field:assessor_user_id",
      "fields": [
        { "key": "strengths", "type": "longtext", "label": "Strengths", "required": true },
        { "key": "improvements", "type": "longtext", "label": "Areas for improvement", "required": true },
        { "key": "plan", "type": "longtext", "label": "Agreed plan", "required": true }
      ]
    }
  ]
}

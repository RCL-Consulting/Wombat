{
  "version": 1,
  "observation_date_field": "observed_on",
  "sections": [
    {
      "key": "request",
      "title": "Request",
      "fields": [
        { "key": "epa_id", "type": "epa", "label": "EPA", "required": true },
        { "key": "assessor_user_id", "type": "user", "label": "Assessor user id", "help_text": "Use the target assessor's user id for now.", "required": true },
        { "key": "observed_on", "type": "date", "label": "Date observed", "help_text": "When the encounter happened, not when this form is completed.", "required": true },
        { "key": "setting", "type": "choice", "label": "Clinical setting", "required": true, "options": ["ward", "clinic", "emergency_unit", "call_review"] },
        { "key": "presenting_complaint", "type": "text", "label": "Presenting complaint", "required": true },
        { "key": "complexity", "type": "choice", "label": "Case complexity", "required": true, "options": ["low", "moderate", "high"] }
      ]
    },
    {
      "key": "assessment",
      "title": "Assessment",
      "editable_by": "field:assessor_user_id",
      "fields": [
        { "key": "history", "type": "scale", "label": "History taking", "options": ["1", "2", "3", "4", "5"], "scale_key": "or_scale" },
        { "key": "exam", "type": "scale", "label": "Examination", "options": ["1", "2", "3", "4", "5"], "scale_key": "or_scale" },
        { "key": "reasoning", "type": "scale", "label": "Clinical reasoning", "options": ["1", "2", "3", "4", "5"], "scale_key": "or_scale" },
        { "key": "communication", "type": "scale", "label": "Communication", "options": ["1", "2", "3", "4", "5"], "scale_key": "or_scale" },
        { "key": "professionalism", "type": "scale", "label": "Professionalism", "options": ["1", "2", "3", "4", "5"], "scale_key": "or_scale" },
        { "key": "overall", "type": "scale", "label": "Overall performance", "options": ["1", "2", "3", "4", "5"], "scale_key": "or_scale" }
      ]
    },
    {
      "key": "feedback",
      "title": "Feedback",
      "editable_by": "field:assessor_user_id",
      "fields": [
        { "key": "strengths", "type": "longtext", "label": "Strengths" },
        { "key": "improvements", "type": "longtext", "label": "Areas for improvement" },
        { "key": "plan", "type": "longtext", "label": "Agreed plan" }
      ]
    }
  ]
}

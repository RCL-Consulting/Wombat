{
  "version": 1,
  "observation_date_field": "observed_on",
  "rated_level_field": "overall_level",
  "evidence_epa_field": "epa_id",
  "sections": [
    {
      "key": "request",
      "title": "Request",
      "fields": [
        {
          "key": "epa_id",
          "type": "epa",
          "label": "EPA",
          "required": true
        },
        {
          "key": "assessor_user_id",
          "type": "user",
          "label": "Assessor",
          "required": true,
          "help_text": "The supervisor who observed you. They complete this assessment."
        },
        {
          "key": "observed_on",
          "type": "date",
          "label": "Date observed",
          "required": true,
          "help_text": "When the encounter happened, not when this form is completed."
        },
        {
          "key": "procedure",
          "type": "text",
          "label": "Procedure",
          "required": true
        },
        {
          "key": "setting",
          "type": "choice",
          "label": "Clinical setting",
          "required": true,
          "options": [
            { "value": "ward", "label": "Ward" },
            { "value": "emergency_unit", "label": "Emergency unit" },
            { "value": "neonatal_unit", "label": "Neonatal unit" },
            { "value": "picu", "label": "PICU" },
            { "value": "theatre", "label": "Theatre" },
            { "value": "outpatient_clinic", "label": "Outpatient clinic" }
          ]
        },
        {
          "key": "complexity",
          "type": "choice",
          "label": "Procedure complexity",
          "required": true,
          "options": [
            { "value": "low", "label": "Low" },
            { "value": "moderate", "label": "Moderate" },
            { "value": "high", "label": "High" }
          ]
        }
      ]
    },
    {
      "key": "assessment",
      "title": "Entrustment",
      "editable_by": "field:assessor_user_id",
      "fields": [
        {
          "key": "overall_level",
          "type": "scale",
          "label": "Supervision required for this procedure",
          "scale_key": "seed:cpsa:scale:v11.1",
          "validation": {
            "min": 1,
            "max": 6
          },
          "help_text": "The supervision this activity actually required on this occasion - not a judgement of the trainee's worth.",
          "required": true
        }
      ]
    },
    {
      "key": "feedback",
      "title": "Feedback",
      "editable_by": "field:assessor_user_id",
      "fields": [
        {
          "key": "strengths",
          "type": "longtext",
          "label": "What was done well",
          "required": true
        },
        {
          "key": "improvements",
          "type": "longtext",
          "label": "Areas for development",
          "required": true
        },
        {
          "key": "plan",
          "type": "longtext",
          "label": "Agreed plan",
          "required": true
        }
      ]
    }
  ]
}
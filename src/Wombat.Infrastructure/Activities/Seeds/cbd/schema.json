{
  "version": 1,
  "observation_date_field": "observed_on",
  "rated_level_field": "overall",
  "sections": [
    {
      "key": "request",
      "title": "Request",
      "fields": [
        { "key": "epa_id", "type": "epa", "label": "EPA", "required": true },
        { "key": "assessor_user_id", "type": "user", "label": "Assessor user id", "help_text": "Use the target assessor's user id for now.", "required": true },
        { "key": "observed_on", "type": "date", "label": "Date observed", "help_text": "When the encounter happened, not when this form is completed.", "required": true },
        { "key": "case_summary", "type": "longtext", "label": "Case summary", "required": true }
      ]
    },
    {
      "key": "discussion",
      "title": "Discussion",
      "editable_by": "field:assessor_user_id",
      "fields": [
        { "key": "record_review", "type": "scale", "label": "Medical record review", "options": ["1", "2", "3", "4", "5"], "scale_key": "O-R Scale" },
        { "key": "reasoning", "type": "scale", "label": "Clinical reasoning", "options": ["1", "2", "3", "4", "5"], "scale_key": "O-R Scale" },
        { "key": "management", "type": "scale", "label": "Management planning", "options": ["1", "2", "3", "4", "5"], "scale_key": "O-R Scale" },
        { "key": "ethics", "type": "scale", "label": "Professional and ethical judgment", "options": ["1", "2", "3", "4", "5"], "scale_key": "O-R Scale" },
        { "key": "overall", "type": "scale", "label": "Overall performance", "options": ["1", "2", "3", "4", "5"], "scale_key": "O-R Scale" }
      ]
    },
    {
      "key": "feedback",
      "title": "Feedback",
      "editable_by": "field:assessor_user_id",
      "fields": [
        { "key": "feedback", "type": "longtext", "label": "Feedback" },
        { "key": "action_plan", "type": "longtext", "label": "Action plan" }
      ]
    }
  ]
}
